CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_Rera_Count_Promoter_Documents`(    
 p_Application_id bigint  
 )
begin   
Declare v_TotalCnt Int;
declare v_getProfileType int; 
declare v_getprofieCount int;
declare v_getchkDocCount Int; 

set v_getProfileType=0;   
  
  
SELECT COUNT(*) INTO v_TotalCnt FROM tbl_RERA_Promoter_Documents where Promoter_ID=p_Application_id and IsActive=1 and IsDraft in (0,4,5);  
if v_TotalCnt<>0
then
SELECT COUNT(*) INTO v_getchkDocCount FROM tbl_RERA_Promoter_Documents where Promoter_ID=p_Application_id and IsActive=1;--  and IsDraft=0;  
end if;


select COUNT(*) into v_getprofieCount from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1;
if v_getprofieCount<>0
then 
	select flag into v_getProfileType from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1; 
end if;
  
   
  
if  (v_TotalCnt <> 0)  
then 
	if v_getProfileType=1
	then
		-- IND
		if v_getchkDocCount>2
		then
			 update tbl_RERA_Promoter_Documents set IsDraft=1   
				where Promoter_ID=p_Application_id  and IsActive=1 and IsDraft in (0,4,5);  
		end if;
	end if;

	if v_getProfileType=2
	then
		-- OTHER THAN IND
		if v_getchkDocCount>4
		then
			 update tbl_RERA_Promoter_Documents set IsDraft=1   
				where Promoter_ID=p_Application_id  and IsActive=1 and IsDraft in (0,4,5);  
		end if;
	end if;
end if; 
    
  
end ;;
