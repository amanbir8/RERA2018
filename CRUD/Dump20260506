	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),
	out p_valreturn int
)
BEGIN  
-- BEGIN TRY  
-- BEGIN TRANSACTION 
declare v_checkAppno int; 
declare v_checkAppnocount int;
declare v_checkTrackCount int;
declare v_getAggregateEvent varchar(300);
declare v_getAssignedTo varchar(300);
 

select count(Related_NoticesSectionFiveNine_ID) into v_checkAppno from tbl_rera_complaint_sectionfivenine_eventaction 
where Related_NoticesSectionFiveNine_ID=p_Related_NoticesSectionFiveNine_ID and IsActive=1; 

select count(NoticesSectionFiveNine_ID) into v_checkAppnocount from tbl_rera_webapplication_noticessectionlockcodefivenine 
where NoticesSectionFiveNine_ID=p_Related_NoticesSectionFiveNine_ID and IsActive=1;

select count(DeskAction_Code) into v_checkTrackCount from tbl_rera_master_complaint_misc_deskactionndetails 
where DeskAction_Code=p_EventAction_Type and DeskAction_Relationship='RoleTrack' and IsActive=1;

-- p_AssignedTo variable for UserRole who identified event action
-- select DeskAction_Aggregate into v_getAggregateEvent from tbl_rera_master_complaint_misc_deskactionndetails 
-- where DeskAction_Code=p_EventAction_Type and DeskAction_SubApplicableFor=p_AssignedTo and IsActive=1;

if  (v_checkAppnocount <> 0)  
then  

	if (v_checkAppno <> 0 and v_checkAppnocount <> 0) then
		-- Log History
		update tbl_rera_complaint_sectionfivenine_eventaction set IsActive=2
		where Related_NoticesSectionFiveNine_ID=p_Related_NoticesSectionFiveNine_ID and IsActive=1;
	end if; 

	if (v_checkTrackCount <> 0) then
		-- Track Movement 
        -- 7801(IT cell), 7802(PA/PS), 7803(Mem/Auth), 7804(LA) -- 7807(Closed), 7808(WebPortal), 7803(Filing)
		update tbl_rera_webapplication_noticessectionlockcodefivenine 
		set DeskAction_IdentifiedCode=p_EventAction_Type,
        D_column=p_EventAction_Type,
		DeskAction_IdentifiedAggregateName=p_EventAction_Aggregate, -- v_getAggregateEvent, 
		DeskAction_IdentifiedBy=p_EventAction_IdentifiedBy, 
		DeskAction_IdentifiedOn=NOW()
		where NoticesSectionFiveNine_ID=p_Related_NoticesSectionFiveNine_ID and IsActive=1;
    else
		-- Action Events (Other File Events)
        update tbl_rera_webapplication_noticessectionlockcodefivenine 
        set D_column=p_EventAction_Type,
		DeskAction_IdentifiedAggregateName=p_EventAction_Aggregate, -- v_getAggregateEvent, 
		DeskAction_IdentifiedBy=p_EventAction_IdentifiedBy, 
		DeskAction_IdentifiedOn=NOW()
		where NoticesSectionFiveNine_ID=p_Related_NoticesSectionFiveNine_ID and IsActive=1;
    end if;

	-- Event Insert
	INSERT INTO tbl_rera_complaint_sectionfivenine_eventaction
	(           
		`SectionFiveNine_EventAction_ID`,
		`EventAction_Type`,
		`EventAction_IdentifiedBy`,
		`EventAction_IdentifiedOn`,
		`Related_NoticesSectionFiveNine_ID`,
		`Related_NoticeFile_NumberDetails`,
		`EventAction_Description`,
		`EventAction_Aggregate`,
		`EventAction_Relationship`,
		`AssignedTo`,
		`Target_ResolutionDate`,
		`Target_ResolutionSummary`,
		`Actual_ResolutionDate`,
		`ProgressStatus`,
		`Remarks_IfAny`,
		`IsActive`,
		`IsDraft`,
		`CreatedBy`,
		`CreatedOn`,
		`ModifyBy`,
		`ModifyOn` 
	)
	VALUES
	(
		p_SectionFiveNine_EventAction_ID,
		p_EventAction_Type,
		p_EventAction_IdentifiedBy,
		NOW(),
		p_Related_NoticesSectionFiveNine_ID,
		p_Related_NoticeFile_NumberDetails,
		p_EventAction_Description,
		p_EventAction_Aggregate, -- v_getAggregateEvent, -- p_EventAction_Aggregate,
		p_EventAction_Relationship,
		p_AssignedTo,
		p_Target_ResolutionDate,
		p_Target_ResolutionSummary,
		p_Actual_ResolutionDate,
		p_ProgressStatus,
		p_Remarks_IfAny,
		1,
		0,
		p_CreatedBy,
		NOW(),
		p_ModifyBy,
		NOW()
	);
    
	set p_valreturn= 0;
	-- return @Application_id
else
	set p_valreturn= 1;
end if;    

