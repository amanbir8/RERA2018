CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formn_bifurcation_documents`(
	p_ComplaintFormN_ID bigint,
	p_ComplaintFormN_DiaryNumber varchar(50),
	p_ComplaintType_MN varchar(50),
    p_BifurcateFormN_ID bigint,
    p_BifurcateType_MN varchar(50),
	p_Flag int,
    p_UserName varchar(50),
    out p_valoutput bigint
)
BEGIN
	DECLARE flag_bifurcate_IsError INTEGER DEFAULT 0;
	DECLARE flag_curbifurcate INTEGER DEFAULT 0;     
    DECLARE v_ret_bifurcatevalue bigint DEFAULT 0;
    DECLARE v_get_ListEnclDocument_ID bigint;
    DECLARE v_put_ListEnclDocument_ID bigint;
  
	declare vProfile_ID bigint(20) DEFAULT 0;
	declare vUser_ID varchar(50) DEFAULT '';
	declare vComplaintType_MN varchar(50) DEFAULT 'FormTypeN';
	declare vComplaintDoc_InfoCode int(11) DEFAULT 0;
	declare vComplaintDoc_InfoName varchar(90) DEFAULT '';
	declare vComplaintDoc_ReferenceNumber varchar(90) DEFAULT '';
	declare vComplaintDoc_IssueDate datetime(3) DEFAULT '0001-01-01 00:00:00.000';
	declare vComplaintDoc_FileSize varchar(50) DEFAULT '0';
	declare vComplaintDoc_FileFormat varchar(50) DEFAULT '';
	declare vComplaintDoc_FilePath varchar(250) DEFAULT '';
	declare vComplaintDoc_FileName varchar(250) DEFAULT '';
	declare vComplaintDoc_IsGroup int(11) DEFAULT 0;
	declare vDoc_SerialNumber varchar(50) DEFAULT '0';
	declare vDoc_PageStartNumber int(11) DEFAULT 0;
	declare vDoc_PageEndNumber int(11) DEFAULT 0;
	declare vRemarks_IfAny varchar(250) DEFAULT '';
	declare vA_column varchar(50) DEFAULT '';
	declare vB_column varchar(50) DEFAULT '';
	declare vC_column varchar(50) DEFAULT '';
	declare vIsActive int(11) DEFAULT 0;
	declare vIsDraft int(11) DEFAULT 0;
	declare vIsLock int(11) DEFAULT 0;
	declare vIsPublicView int(11) DEFAULT 0;
	declare vCreatedBy varchar(50) DEFAULT 'sysadmin';
	declare vCreatedOn datetime(3) DEFAULT '0001-01-01 00:00:00.000';


        
	-- declare cursor
	DEClARE curBifurcateFormNdoc 
		CURSOR FOR 
			SELECT Profile_ID,User_ID,ComplaintType_MN,ComplaintDoc_InfoCode,ComplaintDoc_InfoName,ComplaintDoc_ReferenceNumber,
				ComplaintDoc_IssueDate,ComplaintDoc_FileSize,ComplaintDoc_FileFormat,ComplaintDoc_FilePath,ComplaintDoc_FileName,
                ComplaintDoc_IsGroup,Doc_SerialNumber,Doc_PageStartNumber,Doc_PageEndNumber,Remarks_IfAny,
                A_column,B_column,C_column,IsActive,IsDraft,IsLock,IsPublicView,CreatedBy,CreatedOn
            FROM tbl_rera_complaint_formn_listenclosuresdocuments WHERE ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID AND IsActive=1;
            
	-- declare NOT FOUND handler
	DECLARE CONTINUE HANDLER FOR NOT FOUND SET flag_curbifurcate = 1;
	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET flag_bifurcate_IsError = 1;
           
	OPEN curBifurcateFormNdoc;

	getFormNdoc: LOOP
		FETCH curBifurcateFormNdoc INTO vProfile_ID,vUser_ID,vComplaintType_MN,vComplaintDoc_InfoCode,vComplaintDoc_InfoName,vComplaintDoc_ReferenceNumber,
				vComplaintDoc_IssueDate,vComplaintDoc_FileSize,vComplaintDoc_FileFormat,vComplaintDoc_FilePath,vComplaintDoc_FileName,
                vComplaintDoc_IsGroup,vDoc_SerialNumber,vDoc_PageStartNumber,vDoc_PageEndNumber,vRemarks_IfAny,
                vA_column,vB_column,vC_column,vIsActive,vIsDraft,vIsLock,vIsPublicView,vCreatedBy,vCreatedOn;
                
		IF flag_curbifurcate = 1 THEN 
			LEAVE getFormNdoc;
		END IF;
                       
        -- Application ID
		select max(ListEnclDocument_ID) into v_get_ListEnclDocument_ID from tbl_rera_complaint_formn_listenclosuresdocuments;    
		IF (v_get_ListEnclDocument_ID IS NULL) then        
		  set v_put_ListEnclDocument_ID=1; 
		ELSE         
		  set v_put_ListEnclDocument_ID=v_get_ListEnclDocument_ID+1;
		end if;
               
		-- build bifurcate list and insert
		insert into tbl_rera_complaint_formn_listenclosuresdocuments
        (  
			-- `ListEnclDocument_IndexID`,
			`ListEnclDocument_ID`,
			`ComplainantApplicant_RelatedComplaint_ID`,
			`ComplainantApplicant_RelatedComplaint_Code`,
			`Profile_ID`,
			`User_ID`,
			`ComplaintType_MN`,
			`ComplaintDoc_InfoCode`,
			`ComplaintDoc_InfoName`,
			`ComplaintDoc_ReferenceNumber`,
			`ComplaintDoc_IssueDate`,
			`ComplaintDoc_FileSize`,
			`ComplaintDoc_FileFormat`,
			`ComplaintDoc_FilePath`,
			`ComplaintDoc_FileName`,
			`ComplaintDoc_IsGroup`,
			`Doc_SerialNumber`,
			`Doc_PageStartNumber`,
			`Doc_PageEndNumber`,
			`Remarks_IfAny`,
			`A_column`,
			`B_column`,
			`C_column`,
			`IsActive`,
			`IsDraft`,
			`IsLock`,
			`IsPublicView`,
			`CreatedBy`,
			`CreatedOn`,
			`ModifyBy`,
			`ModifyOn`
		)
        values
        (
			-- `ListEnclDocument_IndexID`,
			v_put_ListEnclDocument_ID, -- `ListEnclDocument_ID`,
			p_BifurcateFormN_ID,
            p_BifurcateFormN_ID,
			vProfile_ID,
            vUser_ID,
            vComplaintType_MN,
            vComplaintDoc_InfoCode,
            vComplaintDoc_InfoName,
            vComplaintDoc_ReferenceNumber,
			vComplaintDoc_IssueDate,
            vComplaintDoc_FileSize,
            vComplaintDoc_FileFormat,
            vComplaintDoc_FilePath,
            vComplaintDoc_FileName,
			vComplaintDoc_IsGroup,
            vDoc_SerialNumber,
            vDoc_PageStartNumber,
            vDoc_PageEndNumber,
            vRemarks_IfAny,
			vA_column,
            vB_column,
            vC_column,
            vIsActive,
            vIsDraft,
            vIsLock,
            vIsPublicView,
            vCreatedBy,
            vCreatedOn,
            p_UserName,
            Now()
        );
        
        
	END LOOP getFormNdoc;
	CLOSE curBifurcateFormNdoc;
    
	SET v_ret_bifurcatevalue = 1;
    
	IF flag_bifurcate_IsError = 1 THEN 
	 	SET v_ret_bifurcatevalue = 0;
	END IF;

SET p_valoutput = v_ret_bifurcatevalue;

END ;;
