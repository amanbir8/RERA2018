	'SysAdmin' as CreatedBy,
	'0001-01-01 00:00:00' as CreatedOn,
	'SysAdmin' as ModifyBy,
	'0001-01-01 00:00:00' as ModifyOn,

	'NA' as RoleAccessFlag,
	p_ApplicationModeFlag as IsApplicationModeFlag,
	p_UserCode as InputEntry_Option
	FROM
	(select
	m.Related_Promoter_ID,
	m.Related_Project_ID,
	n.User_ID as Related_User_ID,
	55 as Related_Reference_ID, -- table code WorkFile

	n.RERAnumberRegistration as RERAnumberRegistration,
	n.RERAnumberIssueDate as RERAnumberIssueDate,
	n.RERAnumberRegUptoDate as RERAnumberRegUptoDate,

