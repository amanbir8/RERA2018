	p_Related_RenewalAgent_SequenceID int,
	p_Related_RenewalAgent_Year int,
	p_Flag int,
	p_UserNam varchar(150) 
)
begin 

declare v_RecordCount Int; 
declare v_GetIsDraft Int;
declare v_GetIsLock Int;
declare v_returnflagValue Int;

 
SELECT COUNT(*) INTO v_RecordCount FROM tbl_rera_agent_renewal_regdiarynumber 
WHERE Agent_ID=p_Related_Agent_ID
  and AgentRenewal_ID=p_Related_RenewalAgent_ID
  and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
  and AgentRenewal_Year=p_Related_RenewalAgent_Year; 
    
    
if (v_RecordCount>0) then
	select IsDraft, IsLock into v_GetIsDraft, v_GetIsLock from tbl_rera_agent_renewal_regdiarynumber 
    where Agent_ID=p_Related_Agent_ID
	and AgentRenewal_ID=p_Related_RenewalAgent_ID
	and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
	and AgentRenewal_Year=p_Related_RenewalAgent_Year
    and IsActive=1;
else
	set v_GetIsDraft=0;
    set v_GetIsLock=0;
end if;


if (v_GetIsDraft>0 and v_GetIsLock>0) then
	set v_returnflagValue=1;
else
	set v_returnflagValue=0;
end if;
        
Select v_returnflagValue AS mainCount;   

end ;;
