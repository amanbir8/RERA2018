	p_ComplaintFormM_ID bigint(20),
    p_UserRole varchar(50),
    p_UserName varchar(50),
    p_Flag int
)
begin

declare varLastRecord_BenchID bigint(20) default 0;
declare varLastRecord_PriorityID int(11) default 0;
declare varMaxPriorityLevel int(11) default 0;
declare varCntBench int(11) default 0;

declare output_PreHearingBench_ID bigint(20) default 0;
declare output_PreHearingBenchName varchar(150) default 'NA';


 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
	  
START TRANSACTION;

select CaseAssignement_BenchID into varLastRecord_BenchID from tbl_rera_ecourt_complaint_formm_institutiondetail 
where isactive=1 
order by InstitutionFormM_ID desc 
limit 1;

select PriorityLevel into varLastRecord_PriorityID from tbl_rera_master_complaint_benchjudgemap
where PreHearingType='FormM' and PreHearingBench_ID=varLastRecord_BenchID
and IsActive=1 and IsLock=1 and IsExit=0
limit 1;

set varLastRecord_PriorityID=varLastRecord_PriorityID+1;

select max(PriorityLevel) into varMaxPriorityLevel from tbl_rera_master_complaint_benchjudgemap
where IsActive=1 and IsLock=1 and IsExit=0 and PreHearingType='FormM';

select count(*) into varCntBench from tbl_rera_master_complaint_benchjudgemap
where PreHearingType='FormM' and PriorityLevel=varLastRecord_PriorityID
and IsActive=1 and IsLock=1 and IsExit=0;

if (varCntBench>0 and varLastRecord_PriorityID<=varMaxPriorityLevel) then
	-- Next PriorityID
	select PreHearingBench_ID, PreHearingBenchName into output_PreHearingBench_ID, output_PreHearingBenchName
	from tbl_rera_master_complaint_benchjudgemap
	where PreHearingType='FormM' and PriorityLevel=varLastRecord_PriorityID
	and IsActive=1 and IsLock=1 and IsExit=0
	Limit 1;

else
	-- Reset to first PriorityID
	select PreHearingBench_ID, PreHearingBenchName into output_PreHearingBench_ID, output_PreHearingBenchName
	from tbl_rera_master_complaint_benchjudgemap
	where PreHearingType='FormM' and PriorityLevel=1
	and IsActive=1 and IsLock=1 and IsExit=0
	Limit 1;

end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

select output_PreHearingBench_ID  as PreHearingBench_ID, output_PreHearingBenchName as PreHearingBenchName;

end ;;
