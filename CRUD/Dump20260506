	end if;
	-- -------------------------------  
    
    -- ---------event insert  
	select COUNT(*) into v_checkExistingEventCount from tbl_rera_Project_ExtensionForm_EventAction 
	where Related_Project_ID=p_Project_ID and 
	Related_Promoter_ID=p_Promoter_ID and 
	IsActive=1;
  
	if v_checkExistingEventCount>0
	then
