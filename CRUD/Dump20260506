CREATE DEFINER=`sa`@`%` PROCEDURE `usp_checkfn_tbl_rera_complaint_formm_eventaction`(  
	p_ComplaintFormM_EventAction_ID bigint,
	p_EventAction_Type bigint,
	p_EventAction_IdentifiedBy varchar(50),  
	p_EventAction_IdentifiedOn datetime(3), 
	p_Related_Complaint_ID bigint,
	p_Related_RegDiaryNumber varchar(50),
	out p_valreturn int
)
BEGIN  

declare v_checkAppno int; 
declare v_getEventType bigint;
declare v_putCategoryCode int;
 
 
select count(Related_Complaint_ID) into v_checkAppno from tbl_rera_complaint_formm_eventaction 
where Related_Complaint_ID=p_Related_Complaint_ID and IsActive=1;  
 
set v_putCategoryCode= 0;

if  (v_checkAppno <> 0)  
then  
    
	select EventAction_Type into v_getEventType from tbl_rera_complaint_formm_eventaction 
	where Related_Complaint_ID=p_Related_Complaint_ID and IsActive=1;  

    -- Check DB InComplete Action
    if  (v_getEventType <> 330007)  
	then			
		set v_putCategoryCode= 1;
	else 
        -- Check New Apply Event Type As NoReplyWithin15Days
        if (p_EventAction_Type <> 330057)
		then			
			set v_putCategoryCode= 99;
		else    
			set v_putCategoryCode= 1;
        end if;
	end if;
			
set p_valreturn= v_putCategoryCode;
else
set p_valreturn= 1;
end if;    

 
END ;;
