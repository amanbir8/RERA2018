RE.Project_Name,
'--' as Project_Type,
'--' as Project_TypeSTR,
RM.Project_TotalArea,
RM.Project_TotalAreaSTR,
RE.Project_AddressLine1,
RE.Project_AddressLine2,
udfn_GetStateName(RE.Project_AddressStateCode) as Project_AddressStateCode,
udfn_GetDistrictName(RE.Project_AddressDistrictCode) as Project_AddressDistrictCode,
RE.Project_AddressPIN,
RE.Promoter_Name,
