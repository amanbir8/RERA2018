CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_Count_Profile`(
	p_Related_Promoter_ID bigint,
	p_Related_TypeOfPromoter_ID int,
	p_Related_JointPromoter_ID bigint,
	p_Related_JointPromoter_Type int,
	p_Flag int,
	p_UserNam varchar(150)    
)
begin   
  
declare v_countfile bigint; 
declare v_TypeProfile int; 
declare v_statusFlag int;
declare v_submitFlag int;
declare v_getIsLock int;

set v_TypeProfile=1; 
set v_statusFlag=0;
set v_submitFlag=0;

select count(*) into v_countfile from tbl_rera_copromoter_registrationdetails 
where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
and Related_Promoter_Application_ID=p_Related_Promoter_ID
and Isactive=1;

if (v_countfile <> 0) then 
	select CoPromoterType_Flag into v_TypeProfile from tbl_rera_copromoter_registrationdetails
	where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
	and Related_Promoter_Application_ID=p_Related_Promoter_ID
	and Isactive=1
    order by CoPromoter_IndexID desc 
    Limit 1;

	if (v_TypeProfile=1) then
		-- IND       
		select IsLock into v_getIsLock from tbl_rera_copromoter_registrationdetails
		where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
		and Related_Promoter_Application_ID=p_Related_Promoter_ID
		and Isactive=1
		order by CoPromoter_IndexID desc
		Limit 1;
                
	end if;

	if (v_TypeProfile=2) then
		-- OTHER THAN IND        
		select IsLock into v_getIsLock from tbl_rera_copromoter_registrationdetails
		where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
		and Related_Promoter_Application_ID=p_Related_Promoter_ID
		and Isactive=1
		order by CoPromoter_IndexID desc
		Limit 1;                

	end if;
    
	if (v_getIsLock=1) then
		set v_statusFlag=1;
		set v_submitFlag=1;
	else
		if (v_getIsLock=0) then
			set v_statusFlag=1;
			set v_submitFlag=2;
		end if;
	end if;
end if; 
  
-- //TypeProfile/statusFlag/submitFlag
Select v_TypeProfile AS TypeProfile, v_statusFlag as statusFlag, v_submitFlag as submitFlag; 
  
end ;;
DELIMITER ;
