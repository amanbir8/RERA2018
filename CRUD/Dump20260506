CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthorityDesk_ProjectExtnFormRegdDateDetails`(  
	p_Project_ID bigint,
	p_Promoter_ID bigint,
	p_UserID varchar(100)
)
begin 

declare v_ProjectDiaryNumber varchar(150);
declare v_RegistrationNumber varchar(150);
declare v_RegistrationIssueDate datetime(3);
declare v_RegistrationUptoDate datetime(3);
declare v_RegistrationExtnIssueDate datetime(3);
declare v_RegistrationExtnUptoDate datetime(3);
declare v_RegisteredFlag int;


select 
ProjectRegDiaryNumber_Name, RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate
into v_ProjectDiaryNumber, v_RegistrationNumber, v_RegistrationIssueDate, v_RegistrationUptoDate
from tbl_rera_ldr_project_reranumber_diarynumber 
where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID
and IsActive=1;

select
count(Project_ExtnRegd_DiaryNumber_IndexID) into v_RegisteredFlag
from tbl_rera_ldr_project_reranumber_extensionform
where RelatedProject_ID=p_Project_ID and RelatedPromoter_ID=p_Promoter_ID
and IsActive=1;

if (v_RegisteredFlag <> 0)
then
	select
	ExtnRegistrationIssueDate, ExtnRegistrationRegUptoDate into v_RegistrationExtnIssueDate, v_RegistrationExtnUptoDate
	from tbl_rera_ldr_project_reranumber_extensionform
	where RelatedProject_ID=p_Project_ID and RelatedPromoter_ID=p_Promoter_ID
	and IsActive=1;
else
	select distinct(FormE_DocIssueDate) into v_RegistrationExtnUptoDate
	from tbl_rera_project_applicationforextensionform 
	where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and isactive=1
	Limit 1;
end if;


if (v_RegisteredFlag <> 0)
then
	select
	v_ProjectDiaryNumber as registrationProjectDNumber,
	Project_DiaryNumber as registrationFormFiveDNumber,
	v_RegistrationNumber as registrationNumber,
	v_RegistrationIssueDate as registrationIssueDate,
	v_RegistrationUptoDate as registrationUptoDate,
	v_RegistrationExtnIssueDate as registrationExtnIssueDate,
	v_RegistrationExtnUptoDate as registrationExtnUptoDate,
	v_RegisteredFlag as registeredFlag
	from tbl_rera_project_extensionform_eventaction 
	where Related_Project_ID=p_Project_ID and Related_Promoter_ID=p_Promoter_ID
	and EventAction_Type=150017
	order by ProjectExtFormEventAction_ID desc Limit 1;
else
	select
	v_ProjectDiaryNumber as registrationProjectDNumber,
	Project_DiaryNumber as registrationFormFiveDNumber,
	v_RegistrationNumber as registrationNumber,
	v_RegistrationIssueDate as registrationIssueDate,
	v_RegistrationUptoDate as registrationUptoDate,
	EventAction_IdentifiedOn as registrationExtnIssueDate,
	v_RegistrationExtnUptoDate as registrationExtnUptoDate,
	v_RegisteredFlag as registeredFlag
	from tbl_rera_project_extensionform_eventaction 
	where Related_Project_ID=p_Project_ID and Related_Promoter_ID=p_Promoter_ID
	and EventAction_Type=150017
	order by ProjectExtFormEventAction_ID desc Limit 1;
end if;

end ;;
