	p_FormM_DocIndexID bigint,
	p_FormM_DocID bigint,
	p_FormM_ID bigint,
    p_FormM_Type varchar(90),
	p_LinkageFormM_IndexID bigint,
    p_LinkageFormM_ID bigint,
    p_IsTransferCase int(11),
    p_TransferTypeOption varchar(120)
)
begin  

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

if (p_IsTransferCase <> 1) then
	-- Normal Case (Input Form-M and Output Form-M)
	update tbl_rera_webapplication_orderjudgementbyauthority set IsActive=2
	where A_column=p_FormM_ID and B_column=p_FormM_Type
    and OrderJudgementByAuthority_IndexID=p_FormM_DocIndexID and OrderJudgementByAuthority_ID=p_FormM_DocID
	and IsActive=1;
end if;

if (p_IsTransferCase <> 0) then
	-- Normal or Transfer Case
	if (p_TransferTypeOption='TransferToAO') then
		-- Transfer Case (Input Form-M and Output Form-N)
		update tbl_rera_webapplication_orderjudgementbyao set IsActive=2
		where A_column=p_FormM_ID and B_column=p_FormM_Type
        and OrderJudgementByAO_IndexID=p_FormM_DocIndexID and OrderJudgementByAO_ID=p_FormM_DocID
		and IsActive=1;
	else
		-- Normal Case (Input Form-M and Output Form-M)
		update tbl_rera_webapplication_orderjudgementbyauthority set IsActive=2
		where A_column=p_FormM_ID and B_column=p_FormM_Type
        and OrderJudgementByAuthority_IndexID=p_FormM_DocIndexID and OrderJudgementByAuthority_ID=p_FormM_DocID
		and IsActive=1;
	end if;    
end if;

-- eCourt Linkage Reference DataSet
update tbl_rera_ecourt_complaint_formm_ordersjudgements set IsActive=2
where Related_Complaint_ID=p_FormM_ID and Related_ComplaintType_MN=p_FormM_Type
and OrderDesc_formM_eCourtIndexID=p_LinkageFormM_IndexID and OrderDesc_formM_eCourtID=p_LinkageFormM_ID
and IsActive=1;
    
IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
