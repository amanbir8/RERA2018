		  end if;
          
          select max(RequestOrderSequence) into v_ApplicationOrderSequencePUCnumber from tbl_rera_project_puc_regdiarynumber
          where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1;
