CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetExtensionProjectIndexForPromoterSideDuration`(p_Project_ID bigint, p_Promoter_ID bigint) RETURNS varchar(100) CHARSET utf8
BEGIN  
    DECLARE v_ret varchar(100); 
	DECLARE v_lastaction int;
    DECLARE v_dateoflastaction datetime(3);
    
Select count(*) into v_lastaction from tbl_rera_project_extensionform_eventaction 
where isactive=1 and 
Related_Project_ID=p_Project_ID and 
Related_Promoter_ID=p_Promoter_ID and 
EventAction_Type in (150007);


Select EventAction_IdentifiedOn into v_dateoflastaction from tbl_rera_project_extensionform_eventaction 
where isactive=1 and 
Related_Project_ID=p_Project_ID and 
Related_Promoter_ID=p_Promoter_ID;
    

SELECT
SUM(DATEDIFF(t2EventAction_IdentifiedOn,t1EventAction_IdentifiedOn)) -- totalDAYs
INTO v_ret
FROM 
(
	SELECT 
	t1.ProjectExtFormEventAction_ID as t1ProjectExtFormEventAction_ID,t1.EventAction_Type as t1EventAction_Type,t1.EventAction_IdentifiedOn as t1EventAction_IdentifiedOn, 
	t2.ProjectExtFormEventAction_ID as t2ProjectExtFormEventAction_ID,t2.EventAction_Type as t2EventAction_Type,
	CASE
		WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction<>0) THEN now()	
        WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction=0) THEN v_dateoflastaction	
		ELSE t2.EventAction_IdentifiedOn
	END as t2EventAction_IdentifiedOn
	FROM (
		SELECT ProjectExtFormEventAction_ID,EventAction_Type,Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum1 := @rownum1 + 1 AS id
		FROM tbl_rera_project_extensionform_eventaction alfabet  , (SELECT @rownum1 := 0) r
		WHERE alfabet.Related_Project_ID=p_Project_ID
		and alfabet.Related_Promoter_ID=p_Promoter_ID
		and alfabet.EventAction_Type in (150007,150004)
		ORDER BY alfabet.ProjectExtFormEventAction_ID ASC
	) AS t1
	LEFT OUTER JOIN ( 
		SELECT ProjectExtFormEventAction_ID,EventAction_Type,Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum2 := @rownum2 + 1 AS id
		FROM tbl_rera_project_extensionform_eventaction alfabet  , (SELECT @rownum2 := 0) r
		WHERE alfabet.Related_Project_ID=p_Project_ID
		and alfabet.Related_Promoter_ID=p_Promoter_ID
		and alfabet.EventAction_Type in (150007,150004)
		ORDER BY alfabet.ProjectExtFormEventAction_ID ASC
	) AS t2
	ON t1.id +1 = t2.id
) MZ
where MZ.t1EventAction_Type <> 150004;
     
	IF (v_ret IS NULL) THEN   
	SET v_ret = '0';
	END IF;
    
    RETURN v_ret; 
END ;;
