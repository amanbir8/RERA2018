CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_ProjectDocuments_ByID`(      
 p_Project_ID bigint    
 )
begin  
 
select 
  ProjectDoc_IndexID, 
  ProjectDoc_ID,
  Promoter_ID,
  Project_ID,
  ProjectDoc_InfoCode,
  ProjectDoc_InfoName,
  ProjectDoc_RelatedSectionName,
  ProjectDoc_ReferenceNumber,
  ProjectDoc_IssueDate,  
  
  ProjectDoc_FileSize,
  ProjectDoc_FileFormat,
  ProjectDoc_FilePath,
  ProjectDoc_FileName,
  
  ProjectDoc_IsGroup,
  Remarks_IfAny,
