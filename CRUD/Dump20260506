		`IsDraftSecMember`,
		`IsDraftMember`,
		`CreatedBy`,
		`CreatedOn`,
		`ModifyBy`,
		`ModifyOn`
		)        
		VALUES        
		(   
		v_GetExistingForDeskProjectRegDiaryNumber_ID, -- @PutProject_RegDiaryNumber_ID ,       
		v_GetExistingForDeskProjectRegDiaryNumber_Name, -- @PutProject_RegDiaryNumber_Name ,      
		v_GetExistingForDeskProjectRegDiaryNumber_NameYear, -- YEAR(GETDATE()),    
		p_UserID , 
		p_Promoter_ID ,        
		p_Project_ID,
		v_ExtFormPaymentDetailsCount,
		v_ExtFormRegistrationDetailsCount,       
		0, -- --IsRegistration,      
		0,-- CurrentEventcode  ,      
		0,--   EventCodeDetails_indexID   ,       
		p_Extra2   ,        
		p_Extra3   ,        
		p_Extra4   ,        
		p_Remarks_IfAny ,        
		1 ,        
		1 ,        
		p_IsDraftHelpDesk   ,        
		p_IsDraftEvaluation   ,        
		p_IsDraftSecMember   ,        
		p_IsDraftMember   ,        
		p_CreatedBy,        
		NOW(),                    
		p_ModifyBy,        
		NOW()         
		);
   else
		-- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
		INSERT INTO tbl_rera_ProjectExtensionForm_RegDiaryNumber        
		(        
		`ProjectExtForm_RegDiaryNumber_ID`,
		`ProjectExtForm_RegDiaryNumber_Name`,
		`ProjectExtForm_RegDiaryNumber_NameYear`,
		`UserID`,
		`Promoter_ID`,
		`Project_ID`,
		`PaymentDetailsCount`,
		`ProjectDocumentCount`,
		`IsRegistration`,
		`CurrentEventcode`,
		`EventCodeDetails_indexID`,
		`Extra2`,
		`Extra3`,
		`Extra4`,
		`Remarks_IfAny`,
		`IsActive`,
		`IsDraft`,
		`IsDraftHelpDesk`,
		`IsDraftEvaluation`,
		`IsDraftSecMember`,
		`IsDraftMember`,
		`CreatedBy`,
		`CreatedOn`,
		`ModifyBy`,
		`ModifyOn`      
		)        
		VALUES        
		(        
		v_PutProjectExtForm_RegDiaryNumber_ID ,       
		v_PutProjectExtForm_RegDiaryNumber_Name ,      
		YEAR(NOW()), 
		p_UserID , 
		p_Promoter_ID ,        
		p_Project_ID,        
		v_ExtFormPaymentDetailsCount,
		v_ExtFormRegistrationDetailsCount,  
		0, -- --IsRegistration,      
		0,-- CurrentEventcode  ,      
		0,--   EventCodeDetails_indexID   ,       
		p_Extra2   ,        
		p_Extra3   ,        
		p_Extra4   ,        
		p_Remarks_IfAny ,        
		1 ,        
		1 ,        
