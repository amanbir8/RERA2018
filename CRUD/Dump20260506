        end if;
        if (v_getCountats=v_extractCountats)
        then
			set v_putresultats=1;
        end if;
		if (v_getCountald=v_extractCountald)
        then
			set v_putresultald=1;
        end if;
        if (v_getCountloi=v_extractCountloi)
        then
			set v_putresultloi=1;
        end if;
        
		if (v_putresultclu<>0 and v_putresultltdc<>0 and v_putresultregcert<>0 and v_putresultats<>0 and v_putresultald<>0 and v_putresultloi<>0)
        then    
			if  (v_checkComplainant > 3)    
			then 

				select IsDocumentsComplete into v_checkComplaintDocFlag from tbl_rera_complaint_formm_details 
				where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;    
				  
				if  (v_checkComplaintDocFlag <> 0)    
