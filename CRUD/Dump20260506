WHERE a.isactive=1 
and a.ispaymentsuccesscomplete=1 
and a.Related_RenewalAgent_ID not in
(SELECT b.AgentRenewal_ID
FROM tbl_rera_agent_renewal_paymentgateway a, tbl_rera_agent_renewal_regdiarynumber b
WHERE a.Related_Agent_ID=b.Agent_ID 
and a.Related_RenewalAgent_ID=b.AgentRenewal_ID 
and a.Related_RelatedRenewalAgent_Year=b.AgentRenewal_Year 
and a.Related_RenewalOrderSequence=b.RenewalOrderSequence 
and a.isactive=1 
and b.isactive=1 
and a.ispaymentsuccesscomplete=1)
order by PG_Date desc;

END ;;
