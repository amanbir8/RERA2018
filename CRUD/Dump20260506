	p_UserManagerAuthority_ID bigint(20),    
	p_rolesId varchar(250),
	p_rolesName varchar(256),    
	p_usersId varchar(250),
	p_usersEmail varchar(256),
	p_usersEmailConfirmed int,
	p_usersPasswordHash varchar(500),
	p_usersSecurityStamp varchar(500),
	p_usersPhoneNumber varchar(250),
	p_usersPhoneNumberConfirmed int,
	p_usersTwoFactorEnabled int,
	p_usersLockoutEndDateUtc datetime,
	p_usersLockoutEnabled int,
