					p_PUC_ReferencePUC_Date,
					0,  -- PaymentDetailsCount,
					0,  -- ChangeRequestCount,
					1,  -- IsRegistration,
					0,  -- CurrentEventcode,
					0,  -- EventCodeDetails_indexID,
					v_ApplicationExistingOrderSequencePUCnumber,
					'', -- Extra1,
					'', -- Extra2,
					'', -- Extra3,
					'', -- Extra4,
					p_RemarksIfAny,
					1, -- IsActive,
					1, -- IsActiveProvider,
					1, -- IsDraft,
					0, -- IsDraftHelpDesk,
					0, -- IsDraftEvaluation,
					0, -- IsDraftSecMember,
					0, -- IsDraftMember,
					p_CreatedBy,
					NOW(), -- p_CreatedOn,
					p_ModifyBy,
					NOW() -- p_ModifyOn
				  );                  
			   end if;
          else          
            set v_getPUC_ApplicationID=v_ApplicationPUC_ID;
            
			-- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
			INSERT INTO tbl_rera_project_puc_regdiarynumber        
			  (  
				-- PUC_RegDiaryNumber_IndexID,
				PUC_RegDiaryNumber_ID,
				PUC_RegDiaryNumber_Name,
				PUC_RegDiaryNumber_NameYear,
				UserID,
				RelatedPromoter_ID,
				RelatedProject_ID,
				RelatedApplicationPUC_ID,
