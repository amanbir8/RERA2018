CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthorityDesk_ProjectRegistrationNumbers`(
	p_UserRole varchar(50),        
	p_RelatedProject_ID bigint,
	p_RelatedPromoter_ID bigint,
    p_RegistrationNumberOptions int,
    p_ProjectType_Input varchar(50),
    p_IssueDate_Input datetime(3),
    p_ValidUptoDate_Input datetime(3)         
)
begin        
   

declare v_Get_SubDivisionCodeName varchar(30);     
declare v_Get_DistrictCodeName varchar(30); 
declare v_Get_RegNumber_ID bigint;
declare v_Put_RegNumber_ID bigint;  
declare v_specialnumberCount Int;
declare v_Put_Prepared_SequenceNumber bigint;
declare v_Get_Prepared_SequenceNumber varchar(40);
declare v_Put_Prepared_ProjectType varchar(30);

declare v_Get_ProjectType_Name varchar(10); 
declare v_checkrno int;
declare v_Put_ExistedNumberFlag varchar(10); 
declare v_checktype int;
declare v_checktypeFlag varchar(10);

declare v_get_AllottedNumber_Value varchar(100);
declare v_get_IssueDate_Value datetime(3);
declare v_get_ValidUptoDate_Value datetime(3);

declare v_Get_PreparedSequenceName varchar(30);
declare v_Get_PreparedRegistrationNumber varchar(100);
declare v_Get_PreparedIssueDate datetime(3);
declare v_Get_PreparedValidUptoDate datetime(3);


DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;
 

-- (A) Get Project Type Code
IF (p_ProjectType_Input<>'PA') 
then         
    set v_Get_ProjectType_Name=p_ProjectType_Input;
else
	-- Get Auto Project Type Code
	set v_Get_ProjectType_Name='PR';
    
    select count(distinct ProjectType_Code) into v_checktype from tbl_rera_projecttype_registration 
    where ProjectTypeRelated_ProjectRegistration_ID=p_RelatedProject_ID and Isactive=1;
    
    IF (v_checktype>1)
	then
		set v_Get_ProjectType_Name='PM';
    else
		IF (v_checktype<>0) then		
			select distinct ProjectType_Code into v_checktypeFlag from tbl_rera_projecttype_registration 
			where ProjectTypeRelated_ProjectRegistration_ID=p_RelatedProject_ID and Isactive=1;
			
			IF (v_checktypeFlag='03') then
				set v_Get_ProjectType_Name='PR';
			end if;
			IF (v_checktypeFlag='01') then
				set v_Get_ProjectType_Name='PC';
			end if;
			IF (v_checktypeFlag='02') then
				set v_Get_ProjectType_Name='PI';
			end if;        
        end if;
    end if;    
end if;

-- (B) Get SubDivision Code and District Code
select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
from tbl_rera_master_subdivisiondetails  
where SubDivision_Code in (select Project_AddressSubDivisionCode from tbl_RERA_Project_Registration   
where ProjectRegistration_ID=p_RelatedProject_ID and Promoter_ID=p_RelatedPromoter_ID and IsActive=1)
and IsActive=1; 


-- (C) Get check count Existing RERA number
set v_Put_ExistedNumberFlag='NA';
select count(*) into v_checkrno from tbl_rera_ldr_project_reranumber_diarynumber 
where Project_ID=p_RelatedProject_ID and Promoter_ID=p_RelatedPromoter_ID and IsActive=1;


IF (v_checkrno<>0)
then
	set v_Put_ExistedNumberFlag='YS';
    set v_Get_Prepared_SequenceNumber='0';
    
	select RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate, Extra1, Extra2
    into v_get_AllottedNumber_Value, v_get_IssueDate_Value, v_get_ValidUptoDate_Value, v_Get_Prepared_SequenceNumber, v_Put_Prepared_ProjectType
    from tbl_rera_ldr_project_reranumber_diarynumber 
	where Project_ID=p_RelatedProject_ID and Promoter_ID=p_RelatedPromoter_ID and IsActive=1;

	set v_Get_PreparedRegistrationNumber=v_get_AllottedNumber_Value;
    set v_Get_PreparedIssueDate=v_get_IssueDate_Value;
	set v_Get_PreparedValidUptoDate=v_get_ValidUptoDate_Value;
    set v_Put_Prepared_SequenceNumber=CAST(v_Get_Prepared_SequenceNumber AS UNSIGNED);    
else
	-- Get Sequence Max ID 
	select max(CAST(Extra1 AS UNSIGNED)) into v_Get_RegNumber_ID 
	from tbl_rera_ldr_project_reranumber_diarynumber 
	where Extra3='NRL' and Extra2=v_Get_ProjectType_Name and IsActive=1;

	IF (v_Get_RegNumber_ID IS NULL)          
	then          
		set v_Put_RegNumber_ID=1;        
	else           
		set v_Put_RegNumber_ID=v_Get_RegNumber_ID+1;      
	end if; 

	-- Get verify with special numbers
	select count(*) into v_specialnumberCount from tbl_rera_project_registration_specialnumbers
	where SpecialNumber=v_Put_RegNumber_ID and IsActive=1 and IsAllotted in (0,1,2);

	IF (v_specialnumberCount<>0) 
	then         
		set v_Put_RegNumber_ID=v_Put_RegNumber_ID+1;      
	end if;
    
	-- Get Prefix for 4digit Sequence
	set v_Get_PreparedSequenceName=LPAD(v_Put_RegNumber_ID, 4, 0);
    set v_Put_Prepared_SequenceNumber=v_Put_RegNumber_ID;
    set v_Put_Prepared_ProjectType=v_Get_ProjectType_Name;

	set v_Get_PreparedRegistrationNumber=CONCAT('PBRERA', '-', CAST(v_Get_DistrictCodeName as CHAR(50)), CAST(v_Get_SubDivisionCodeName as CHAR(50)), '-', CAST(v_Get_ProjectType_Name as CHAR(50)), CAST(v_Get_PreparedSequenceName as CHAR(50)));
    set v_Get_PreparedIssueDate=p_IssueDate_Input;
	set v_Get_PreparedValidUptoDate=p_ValidUptoDate_Input;
end if;
 
if (p_RegistrationNumberOptions=51) 
then

	select 
	v_Put_Prepared_SequenceNumber as Prepared_SequenceNumber,
	v_Put_Prepared_ProjectType as Prepared_ProjectType,
	'NRL' as Prepared_NumberTypeFlag,
	v_Get_PreparedRegistrationNumber, 
	v_Get_PreparedIssueDate, 
	v_Get_PreparedValidUptoDate,
	0 as PriceValue, 
	v_Put_ExistedNumberFlag as NumberAlreadyExisted_Flag, 
	'NA' as ProjectName, 
	'NA' as ProjectRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column;
    
    -- union
    -- Select * from
    -- (select
	-- Extra1 as Prepared_SequenceNumber,
	-- Extra2 as Prepared_ProjectType,
	-- 'LTN' Prepared_NumberTypeFlag, 
	-- RERAnumberRegistration as v_Get_PreparedRegistrationNumber,
	-- RERAnumberIssueDate as v_Get_PreparedIssueDate,
	-- RERAnumberRegUptoDate as v_Get_PreparedValidUptoDate,
	-- 0 as PriceValue,
	-- 'LN' as NumberAlreadyExisted_Flag,
	-- ProjectName as ProjectName,
	-- ProjectRegDiaryNumber_Name as ProjectRegDiaryNumber_Name,
	-- '' as RemarksIfAny,
	-- '' as A_Column,
	-- '' as B_Column,
	-- '' as C_Column
	-- from tbl_rera_ldr_project_reranumber_diarynumber 
	-- where IsActive=1 and Extra2=v_Get_ProjectType_Name
	-- order by CreatedOn desc
	-- limit 0,1) LRN;

else

	select 
	v_Put_Prepared_SequenceNumber as Prepared_SequenceNumber,
	v_Put_Prepared_ProjectType as Prepared_ProjectType,
	'NRL' as Prepared_NumberTypeFlag,
	v_Get_PreparedRegistrationNumber, 
	v_Get_PreparedIssueDate, 
	v_Get_PreparedValidUptoDate,
	0 as PriceValue, 
	v_Put_ExistedNumberFlag as NumberAlreadyExisted_Flag, 
	'NA' as ProjectName, 
	'NA' as ProjectRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column

	union
	select 
	SpecialNumber as Prepared_SequenceNumber,
	v_Get_ProjectType_Name as Prepared_ProjectType,
	'SPL' as Prepared_NumberTypeFlag,
	CONCAT('PBRERA', '-', CAST(v_Get_DistrictCodeName as CHAR(50)), CAST(v_Get_SubDivisionCodeName as CHAR(50)), '-', CAST(Reference_ProjectType as CHAR(50)), CAST(LPAD(SpecialNumber, 4, 0) as CHAR(50))) as v_PreparedSpecialNumber,
	p_IssueDate_Input as v_PreparedIssueDate,
	p_ValidUptoDate_Input as v_PreparedValidUptoDate,
	PriceValue,
	'NA' as NumberAlreadyExisted_Flag, 
	'NA' as ProjectName, 
	'NA' as ProjectRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column
	from tbl_rera_project_registration_specialnumbers 
	where Reference_ProjectType=v_Get_ProjectType_Name
	and isactive=1 and IsAllotted in (0,2);
    
    -- union
    -- Select * from
    -- (select
