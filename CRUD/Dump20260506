    declare v_verifyProjectPUC_ID bigint;
    declare v_GetEventActionTypeID bigint;

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
 
	-- ------------------------- DiaryNumber ------------------------            
	select max(PUC_RegDiaryNumber_ID) into v_GetPUC_RegDiaryNumber_ID from tbl_rera_project_puc_regdiarynumber where PUC_RegDiaryNumber_NameYear=YEAR(NOW());        

