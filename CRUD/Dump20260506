			ModifyOn   
		)        
		VALUES        
		(   
			-- CoPromoter_RegDiaryNumber_IndexID,
			v_GetExistingJPrmRegDiaryNumber_ID,
            v_GetExistingJPrmRegDiaryNumber_Name,
            v_GetExistingJPrmRegDiaryNumber_NameYear,
            p_Related_JointPromoter_ID,
            p_Related_JointPromoter_Type,
			p_UserID,
            p_Related_Promoter_ID,
            0, -- ToBeProvided-duringMapping
            'NA',  -- ToBeProvided-duringMapping
            v_checkExistingReferencePromoterID,
            v_checkExistingReferenceDiaryNumberID,
            v_checkExistingReferenceDiaryNumberName,
            v_checkExistingReferenceDiaryNumberYear, 
            p_Registration_OtherMember_YN_Flag, -- OrgMemberCount
			p_Registration_OtherParentEntity_YN_Flag, -- ParentEntityCount
            v_getexperiencelitigationsCount, -- LitigationsCount
            0, -- DocumentsCount
            0, -- PaymentDetailsCount
			p_Registration_OtherExperience_YN_Flag, -- TrackRecordDetailsCount
			v_GetPromoterRegDiaryNumber_Name,  -- RelatedPromoterDNumber
            'NA', -- p_B_column -- RelatedProjectDNumber
			p_C_column,
			p_Remarks_IfAny,
			1, --  p_IsActive,
			1, --  p_IsDraft,
			1, --  p_IsLock,
            p_IsFlag,
			p_IsPublicView,
			p_IsConditional,
			p_IsDraftMember,
			-- 0, --  p_IsFlag,
			-- 1, --  p_IsPublicView,
			-- 0, --  p_IsConditional,
			-- 0, --  p_IsDraftMember,
			p_CreatedBy,
			NOW(), -- p_CreatedOn
            p_ModifyBy,
            NOW() -- p_ModifyOn
		);

		set v_PutJointPromoter_RegDiaryNumber_Name=v_GetExistingJPrmRegDiaryNumber_Name;

	else
		-- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
		INSERT INTO tbl_rera_copromoter_regdiarynumber        
		(        
			-- CoPromoter_RegDiaryNumber_IndexID,
			CoPromoter_RegDiaryNumber_ID,
			CoPromoter_RegDiaryNumber_Name,
