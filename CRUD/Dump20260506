CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formm_institution`(
    IN p_InstitutionFormM_IndexID BIGINT,
    IN p_InstitutionFormM_ID BIGINT,
    IN p_InstitutionFormM_Code VARCHAR(50),    
    IN p_Profile_ID BIGINT,
    IN p_User_ID VARCHAR(50),
    IN p_Related_ComplaintFormM_ID BIGINT,
    IN p_Related_ComplaintFormM_Code VARCHAR(50),
    IN p_Related_ComplaintDiaryNumber VARCHAR(50),
    IN p_ComplaintType_MN VARCHAR(50),
	IN p_Date_of_Filing DATETIME(3),
    IN p_IsSameDiaryNumberWithInstitutionNumber INT,
    IN p_Institution_Ref_ID BIGINT,
    IN p_Institution_Ref_Year INT,
    IN p_Institution_Ref_Number VARCHAR(50),
    IN p_Institution_Ref_Date DATETIME,
    IN p_IsManualAssignBench INT,
    IN p_CaseAssignement_BenchID BIGINT,
    IN p_CaseAssignement_BenchName VARCHAR(150),
    IN p_CaseAssignement_BenchDescription VARCHAR(150),
    IN p_CaseAssignement_BenchLocation VARCHAR(150),
    IN p_NatureOfComplaint_Statement VARCHAR(1000),
    IN p_NatureOfComplaint_Key1 VARCHAR(150),
    IN p_NatureOfComplaint_Key2 VARCHAR(150),
    IN p_NatureOfComplaint_Key3 VARCHAR(150),
    IN p_ReliefSought_Statement VARCHAR(1000),
    IN p_Dak_Number VARCHAR(50),
    IN p_Dak_Date DATETIME,
    IN p_IsComplaintHardcopySetYesNo INT,
    IN p_HardcopySetNumber INT,
    IN p_NumberOfComplainant INT,
    IN p_NumberOfRespondent INT,
    IN p_Remarks_IfAny VARCHAR(1500),
    IN p_A_column VARCHAR(50),
    IN p_B_column VARCHAR(50),
    IN p_C_column VARCHAR(50),
    IN p_D_column VARCHAR(50),
    IN p_E_column VARCHAR(50),
    IN p_F_column DATETIME,
    IN p_IsActive INT,
    IN p_IsDraft INT,
    IN p_IsLock INT,
    IN p_IsLockRefNumber INT,
    IN p_IsPublicView INT,
    IN p_CreatedBy VARCHAR(50),
    IN p_CreatedOn DATETIME,
    IN p_ModifyBy VARCHAR(50),
    IN p_ModifyOn DATETIME,
    OUT p_valoutput BIGINT
)
BEGIN
    DECLARE v_LastID BIGINT DEFAULT 0;
    DECLARE v_NewInstitutionID BIGINT;
    DECLARE v_Institution_Ref_ID BIGINT DEFAULT 0;
    DECLARE v_Institution_Ref_Year INT DEFAULT 0;
    DECLARE v_Institution_Ref_Number VARCHAR(50) DEFAULT '';
    DECLARE v_Profile_ID BIGINT DEFAULT 0;
    DECLARE v_User_ID VARCHAR(50) DEFAULT '';
    declare v_GetIsLockRefNumber INT DEFAULT 0;
    declare v_checkcntIsLockRefNumber INT DEFAULT 0;
	declare v_GetComplaint_Institution_Ref_Number varchar(50);         
	declare v_PutComplaint_Institution_Ref_Number varchar(50);         
	declare v_GetComplaint_Institution_Ref_ID bigint;  
	declare v_PutComplaint_Institution_Ref_ID bigint; 
    
-- Update Case
declare val_Related_Profile_ID BIGINT;
declare val_Related_User_ID VARCHAR(50);
declare val_Related_ComplaintFormM_ID BIGINT;
declare val_Related_ComplaintFormM_Code VARCHAR(50);
declare val_Related_ComplaintDiaryNumber VARCHAR(50);
declare val_ComplaintType_MN VARCHAR(50);
declare val_Date_of_Filing DATETIME(3);
declare val_IsSameDiaryNumberWithInstitutionNumber INT;
declare val_Institution_Ref_ID BIGINT;
declare val_Institution_Ref_Year INT;
declare val_Institution_Ref_Number VARCHAR(50);
declare val_Institution_Ref_Date DATETIME(3);
declare val_IsManualAssignBench INT;
declare val_CaseAssignement_BenchID BIGINT;
declare val_CaseAssignement_BenchName VARCHAR(150);
declare val_CaseAssignement_BenchDescription VARCHAR(150);
declare val_CaseAssignement_BenchLocation VARCHAR(150);
declare val_NatureOfComplaint_Statement VARCHAR(1000);
declare val_NatureOfComplaint_Key1 VARCHAR(150);
declare val_NatureOfComplaint_Key2 VARCHAR(150);
declare val_NatureOfComplaint_Key3 VARCHAR(150);
declare val_ReliefSought_Statement VARCHAR(1000);
declare val_Remarks_IfAny VARCHAR(1500);
declare val_IsActive INT;
declare val_IsDraft INT;
declare val_IsLock INT;
declare val_IsLockRefNumber INT;
declare val_IsPublicView INT;
declare val_CreatedBy VARCHAR(50);
declare val_CreatedOn  DATETIME;
declare val_ModifyBy VARCHAR(50);
declare val_ModifyOn  DATETIME;

    
    
  DECLARE `_rollback` BOOL DEFAULT 0;
  DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
   
	select IsLockRefNumber into v_GetIsLockRefNumber from tbl_rera_ecourt_complaint_formm_institutiondetail 
    where Related_ComplaintFormM_ID=p_Related_ComplaintFormM_ID and IsActive=1; 
    
    select count(IsLockRefNumber) into v_checkcntIsLockRefNumber from tbl_rera_ecourt_complaint_formm_institutiondetail 
    where Related_ComplaintFormM_ID=p_Related_ComplaintFormM_ID and IsActive=1;

IF (v_GetIsLockRefNumber=0 and v_checkcntIsLockRefNumber=0) THEN
	-- Case: New SAVE FULL (ASSIGN and DAK)

    SELECT GREATEST(IFNULL(MAX(InstitutionFormM_ID), 0), 1000) + 1
    INTO v_NewInstitutionID 
    FROM tbl_rera_ecourt_complaint_formm_institutiondetail;
    
    -- Case-I: When SAME DiaryNumber
    IF (p_IsSameDiaryNumberWithInstitutionNumber=1) THEN
    
        SELECT ComplaintRegDiaryNumber_ID, ComplaintRegDiaryNumber_Name, ComplaintRegDiaryNumber_NameYear, Profile_ID, User_ID 
		INTO v_Institution_Ref_ID, v_Institution_Ref_Number, v_Institution_Ref_Year, v_Profile_ID, v_User_ID
		FROM tbl_rera_complaint_formm_regdiarynumber 
		WHERE FormM_RelatedComplaint_ID=p_Related_ComplaintFormM_ID and IsActive=1 limit 1;    
    END IF;
    -- Case-II: When Assign New Number
    IF (p_IsSameDiaryNumberWithInstitutionNumber=0) THEN
    
		SELECT Profile_ID, User_ID INTO v_Profile_ID, v_User_ID FROM tbl_rera_complaint_formm_regdiarynumber 
		WHERE FormM_RelatedComplaint_ID=p_Related_ComplaintFormM_ID and IsActive=1 limit 1; 
            
		select max(Institution_Ref_ID) into v_GetComplaint_Institution_Ref_ID 
		from tbl_rera_ecourt_complaint_formm_institutiondetail where IsSameDiaryNumberWithInstitutionNumber=0 and ComplaintRegDiaryNumber_NameYear=YEAR(NOW());        

		if (v_GetComplaint_Institution_Ref_ID IS NULL) then          
			set v_PutComplaint_Institution_Ref_ID=1;      
			set v_PutComplaint_Institution_Ref_Number=CONCAT('ICMNo', CAST(LPAD(v_PutComplaint_Institution_Ref_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50))); 
		else           
			set v_PutComplaint_Institution_Ref_ID=v_GetComplaint_RegDiaryNumber_ID+1;      
			set v_PutComplaint_Institution_Ref_Number=CONCAT('ICMNo', CAST(LPAD(v_PutComplaint_Institution_Ref_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
		end if;
        
        SET v_Institution_Ref_ID=v_PutComplaint_Institution_Ref_ID;
        SET v_Institution_Ref_Number=v_PutComplaint_Institution_Ref_Number;
        SET v_Institution_Ref_Year=YEAR(NOW());
    END IF;
    
   
	INSERT INTO tbl_rera_ecourt_complaint_formm_institutiondetail (
		-- InstitutionFormM_IndexID,
		InstitutionFormM_ID,
		InstitutionFormM_Code,
		Related_Profile_ID,
