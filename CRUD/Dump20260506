	from tbl_rera_project_promoter_eventaction m, tbl_rera_ldr_project_reranumber_diarynumber n
	where m.Related_Project_ID=n.Project_ID
	and m.Related_Promoter_ID=n.Promoter_ID
	and n.IsActive=1
	and m.IsActive=1
    and n.RERAnumberRegistration like concat('%',p_Input_RegistrationID,'%')
	) t
	order by t.PromoterEventAction_ID asc
	limit 750;
else
	if (p_ApplicationModeFlag=22) then
    -- Project Diary Number (22)
  
		SELECT
		0 as PrjSuperLockUnlock_RegDNProvider_IndexID,
