then
	select ComplaintRegDiaryNumber_IndexID, ComplaintRegDiaryNumber_ID, ComplaintRegDiaryNumber_NameYear, Profile_ID, CONCAT('GCNo', CAST(LPAD(ComplaintRegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(ComplaintRegDiaryNumber_NameYear as CHAR(50))), ComplaintRegDiaryNumber_Name
