CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Agent_Count_RegDiaryNumber`( 
 p_Application_id bigint
 )
begin 
declare v_mainCount int;

declare v_profie varchar(10);
declare v_othermemdetail varchar(10);
declare v_documentupload varchar(10);
declare v_PaymentDetails varchar(10);
declare v_OtherStateUTRERADetails varchar(10);
declare v_CheckOtherStateUTRERADetails varchar(10);

declare v_getprofieCount int;
declare v_getothermemdetailCount int;
declare v_getdocumentuploadCount int;
declare v_getOtherStateUTRERACount int;
declare v_getPaymentCount int;
declare v_getAgentType int;

set v_profie='N';
set v_othermemdetail='N';
set v_documentupload='N';
set v_OtherStateUTRERADetails='N';
set v_PaymentDetails='N';
set v_CheckOtherStateUTRERADetails='N';
set v_getAgentType=0;
set v_mainCount=0;
 
select COUNT(*) into v_getprofieCount from tbl_Rera_Agent_Profile where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getothermemdetailCount from tbl_Rera_Agent_OtherMemberDetail where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getdocumentuploadCount from tbl_RERA_Agent_Documents where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);

select COUNT(*) into v_getOtherStateUTRERACount from tbl_RERA_Agent_OtherStateUT_regRERAdetails where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);

select COUNT(*) into v_getPaymentCount from tbl_RERA_Agent_Payment where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);


if v_getprofieCount<>0
then
 set v_profie='Y'; 
 
select Agent_Type into v_getAgentType from tbl_Rera_Agent_Profile where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
 
select
 CASE    
  WHEN IsOtherStateUT_RERAregistration IS NULL THEN 'N'   
  WHEN IsOtherStateUT_RERAregistration='N' THEN 'N'    
  WHEN IsOtherStateUT_RERAregistration='NA' THEN 'N' 
  WHEN IsOtherStateUT_RERAregistration='No' THEN 'N'  
  WHEN IsOtherStateUT_RERAregistration='Yes' THEN 'Y'  
  WHEN IsOtherStateUT_RERAregistration='Y' THEN 'Y'   
END into v_CheckOtherStateUTRERADetails 
 from tbl_Rera_Agent_Profile where Agent_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
 
end if;
if v_getothermemdetailCount<>0
then
 set v_othermemdetail='Y'; 
end if;
if (v_getdocumentuploadCount<>0 and v_getdocumentuploadCount>4)
then
 set v_documentupload='Y'; 
end if;
if v_getOtherStateUTRERACount<>0
then
 set v_OtherStateUTRERADetails='Y'; 
end if;
if v_getPaymentCount<>0
then
 set v_PaymentDetails='Y'; 
end if;



if v_getAgentType=1
then
    -- Individual Agent
    if v_CheckOtherStateUTRERADetails='Y'
    then
		-- Yes Other RERA
		if v_profie='Y' AND v_documentupload='Y' AND v_OtherStateUTRERADetails='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	else
	    -- No Other RERA
		if v_profie='Y' AND v_documentupload='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	end if;
else 
	-- Other Than Individual Agent
	if v_CheckOtherStateUTRERADetails='Y'
    then
		-- Yes Other RERA
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y' AND v_OtherStateUTRERADetails='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	else
	    -- No Other RERA
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	end if;
end if;




Select v_mainCount AS mainCount;

 
-- --select  COUNT(*) from [tbl_Rera_Agent_Profile] where Agent_ID=5011 and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_Rera_Agent_OtherMemberDetail where Agent_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Agent_Documents where Agent_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Agent_OtherStateUT_regRERAdetails where Agent_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Agent_Payment where Agent_ID=@Application_ID and IsActive=1 and IsDraft=1

-- --select  * from [tbl_Rera_Agent_Profile] where   IsActive=1 and IsDraft=1
-- --select * from tbl_Rera_Agent_OtherMemberDetail where   IsActive=1 and IsDraft=1
-- --select  * from tbl_RERA_Agent_Documents where  IsActive=1 and IsDraft=1
-- --select  * from tbl_RERA_Agent_OtherStateUT_regRERAdetails where   IsActive=1 and IsDraft=1
-- --select  * from tbl_RERA_Agent_Payment where   IsActive=1 and IsDraft=1

end ;;
