declare val_Remarks_IfAny VARCHAR(1500);
declare val_IsActive INT;
declare val_IsDraft INT;
declare val_IsLock INT;
declare val_IsLockRefNumber INT;
declare val_IsPublicView INT;
declare val_CreatedBy VARCHAR(50);
declare val_CreatedOn  DATETIME;
declare val_ModifyBy VARCHAR(50);
declare val_ModifyOn  DATETIME;

    
    
  DECLARE `_rollback` BOOL DEFAULT 0;
  DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
   
	select IsLockRefNumber into v_GetIsLockRefNumber from tbl_rera_ecourt_complaint_formn_institutiondetail 
    where Related_ComplaintFormN_ID=p_Related_ComplaintFormN_ID and IsActive=1; 
    
    select count(IsLockRefNumber) into v_checkcntIsLockRefNumber from tbl_rera_ecourt_complaint_formn_institutiondetail 
    where Related_ComplaintFormN_ID=p_Related_ComplaintFormN_ID and IsActive=1;

IF (v_GetIsLockRefNumber=0 and v_checkcntIsLockRefNumber=0) THEN
	-- Case: New SAVE FULL (ASSIGN and DAK)

    SELECT GREATEST(IFNULL(MAX(InstitutionFormN_ID), 0), 1000) + 1
    INTO v_NewInstitutionID 
    FROM tbl_rera_ecourt_complaint_formn_institutiondetail;
    
    -- Case-I: When SAME DiaryNumber
    IF (p_IsSameDiaryNumberWithInstitutionNumber=1) THEN
    
        SELECT ComplaintRegDiaryNumber_ID, ComplaintRegDiaryNumber_Name, ComplaintRegDiaryNumber_NameYear, Profile_ID, User_ID 
		INTO v_Institution_Ref_ID, v_Institution_Ref_Number, v_Institution_Ref_Year, v_Profile_ID, v_User_ID
		FROM tbl_rera_complaint_formn_regdiarynumber 
		WHERE FormN_RelatedComplaint_ID=p_Related_ComplaintFormN_ID and IsActive=1 limit 1;    
    END IF;
    -- Case-II: When Assign New Number
    IF (p_IsSameDiaryNumberWithInstitutionNumber=0) THEN
    
		SELECT Profile_ID, User_ID INTO v_Profile_ID, v_User_ID FROM tbl_rera_complaint_formn_regdiarynumber 
		WHERE FormN_RelatedComplaint_ID=p_Related_ComplaintFormN_ID and IsActive=1 limit 1; 
            
		select max(Institution_Ref_ID) into v_GetComplaint_Institution_Ref_ID 
		from tbl_rera_ecourt_complaint_formn_institutiondetail where IsSameDiaryNumberWithInstitutionNumber=0 and ComplaintRegDiaryNumber_NameYear=YEAR(NOW());        

		if (v_GetComplaint_Institution_Ref_ID IS NULL) then          
			set v_PutComplaint_Institution_Ref_ID=1;      
			set v_PutComplaint_Institution_Ref_Number=CONCAT('ICNNo', CAST(LPAD(v_PutComplaint_Institution_Ref_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50))); 
		else           
			set v_PutComplaint_Institution_Ref_ID=v_GetComplaint_RegDiaryNumber_ID+1;      
			set v_PutComplaint_Institution_Ref_Number=CONCAT('ICNNo', CAST(LPAD(v_PutComplaint_Institution_Ref_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
		end if;
        
        SET v_Institution_Ref_ID=v_PutComplaint_Institution_Ref_ID;
        SET v_Institution_Ref_Number=v_PutComplaint_Institution_Ref_Number;
        SET v_Institution_Ref_Year=YEAR(NOW());
    END IF;
    
   
	INSERT INTO tbl_rera_ecourt_complaint_formn_institutiondetail (
		-- InstitutionFormN_IndexID,
		InstitutionFormN_ID,
		InstitutionFormN_Code,
		Related_Profile_ID,
		Related_User_ID,
		Related_ComplaintFormN_ID,
		Related_ComplaintFormN_Code,
		Related_ComplaintDiaryNumber,
		ComplaintType_MN,
		Date_of_Filing,
		IsSameDiaryNumberWithInstitutionNumber,
		Institution_Ref_ID,
		Institution_Ref_Year,
		Institution_Ref_Number,
		Institution_Ref_Date,
		IsManualAssignBench,
		CaseAssignement_BenchID,
		CaseAssignement_BenchName,
		CaseAssignement_BenchDescription,
		CaseAssignement_BenchLocation,
		NatureOfComplaint_Statement,
		NatureOfComplaint_Key1,
		NatureOfComplaint_Key2,
		NatureOfComplaint_Key3,
		ReliefSought_Statement,
		Dak_Number,
		Dak_Date,
		IsComplaintHardcopySetYesNo,
		HardcopySetNumber,
		NumberOfComplainant,
		NumberOfRespondent,
		Remarks_IfAny,
		A_column,
		B_column,
		C_column,
		D_column,
		E_column,
		F_column,
		IsActive,
		IsDraft,
		IsLock,
		IsLockRefNumber,
		IsPublicView,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	)
    VALUES (
		-- p_InstitutionFormN_IndexID,
		v_NewInstitutionID, -- p_InstitutionFormN_ID,
		p_InstitutionFormN_Code,    
		v_Profile_ID, -- p_Profile_ID,
		v_User_ID, -- p_User_ID,
		p_Related_ComplaintFormN_ID,
		p_Related_ComplaintFormN_Code,
		p_Related_ComplaintDiaryNumber,
		p_ComplaintType_MN,
		p_Date_of_Filing,
		p_IsSameDiaryNumberWithInstitutionNumber,
        v_Institution_Ref_ID, -- p_Institution_Ref_ID,
		v_Institution_Ref_Year, -- p_Institution_Ref_Year,
		v_Institution_Ref_Number, -- p_Institution_Ref_Number,
		p_Institution_Ref_Date,
		p_IsManualAssignBench,
		p_CaseAssignement_BenchID,
		p_CaseAssignement_BenchName,
		p_CaseAssignement_BenchDescription,
		p_CaseAssignement_BenchLocation,
		p_NatureOfComplaint_Statement,
		p_NatureOfComplaint_Key1,
		p_NatureOfComplaint_Key2,
		p_NatureOfComplaint_Key3,
		p_ReliefSought_Statement,
		p_Dak_Number,
		p_Dak_Date,
		p_IsComplaintHardcopySetYesNo,
		p_HardcopySetNumber,
		p_NumberOfComplainant,
		p_NumberOfRespondent,
		p_Remarks_IfAny,
		p_A_column,
		p_B_column,
		p_C_column,
		p_D_column,
		p_E_column,
		p_F_column,
		1, -- p_IsActive,
		0, -- p_IsDraft,
		0, -- p_IsLock,
		0, -- p_IsLockRefNumber,
		1, -- p_IsPublicView,
		p_CreatedBy,
		p_CreatedOn,
		p_ModifyBy,
		p_ModifyOn
    );
ELSEIF (v_GetIsLockRefNumber=1 and v_checkcntIsLockRefNumber<=5) THEN
	-- Case: exist SAVE DAK ONLY
    
    -- UPDATE CODE
	-- extract exist record
    select 
		Related_Profile_ID,
		Related_User_ID,
		Related_ComplaintFormN_ID,
		Related_ComplaintFormN_Code,
		Related_ComplaintDiaryNumber,
		ComplaintType_MN,
		Date_of_Filing,
		IsSameDiaryNumberWithInstitutionNumber,
		Institution_Ref_ID,
		Institution_Ref_Year,
		Institution_Ref_Number,
		Institution_Ref_Date,
		IsManualAssignBench,
		CaseAssignement_BenchID,
		CaseAssignement_BenchName,
		CaseAssignement_BenchDescription,
		CaseAssignement_BenchLocation,
		NatureOfComplaint_Statement,
		NatureOfComplaint_Key1,
		NatureOfComplaint_Key2,
		NatureOfComplaint_Key3,
		ReliefSought_Statement,
		Remarks_IfAny,
		IsActive,
		IsDraft,
		IsLock,
		IsLockRefNumber,
		IsPublicView,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	into
    	val_Related_Profile_ID,
		val_Related_User_ID,
		val_Related_ComplaintFormN_ID,
		val_Related_ComplaintFormN_Code,
		val_Related_ComplaintDiaryNumber,
		val_ComplaintType_MN,
		val_Date_of_Filing,
		val_IsSameDiaryNumberWithInstitutionNumber,
		val_Institution_Ref_ID,
		val_Institution_Ref_Year,
		val_Institution_Ref_Number,
		val_Institution_Ref_Date,
		val_IsManualAssignBench,
		val_CaseAssignement_BenchID,
		val_CaseAssignement_BenchName,
		val_CaseAssignement_BenchDescription,
		val_CaseAssignement_BenchLocation,
		val_NatureOfComplaint_Statement,
		val_NatureOfComplaint_Key1,
		val_NatureOfComplaint_Key2,
		val_NatureOfComplaint_Key3,
		val_ReliefSought_Statement,
		val_Remarks_IfAny ,
		val_IsActive,
		val_IsDraft,
		val_IsLock,
		val_IsLockRefNumber,
		val_IsPublicView,
		val_CreatedBy,
		val_CreatedOn,
		val_ModifyBy,
		val_ModifyOn
    from tbl_rera_ecourt_complaint_formn_institutiondetail 
    where Related_ComplaintFormN_ID=p_Related_ComplaintFormN_ID 
    and InstitutionFormN_ID=p_InstitutionFormN_ID
    and IsActive=1
    order by InstitutionFormN_IndexID desc
    Limit 1;
    
    
	-- Mark old record as inactive
	update tbl_rera_ecourt_complaint_formn_institutiondetail set IsActive=2
	where Related_ComplaintFormN_ID=p_Related_ComplaintFormN_ID
		and InstitutionFormN_ID=p_InstitutionFormN_ID
        and IsActive=1;
        
	-- Insert Record
    -- Insert new record (versioned)
	INSERT INTO tbl_rera_ecourt_complaint_formn_institutiondetail (
		-- InstitutionFormN_IndexID,
		InstitutionFormN_ID,
		InstitutionFormN_Code,
		Related_Profile_ID,
