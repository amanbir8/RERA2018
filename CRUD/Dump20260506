        SET v_Institution_Ref_Number=v_Exist_Institution_Ref_Number;
        SET v_Institution_Ref_Year=v_Exist_Institution_Ref_Year;
    END IF;
    
    
    -- UPDATE CODE
	-- Mark old record as inactive
	update tbl_rera_ecourt_complaint_formn_institutiondetail set IsActive=2
	where Related_ComplaintFormN_ID=p_Related_ComplaintFormN_ID
        and InstitutionFormN_ID=p_InstitutionFormN_ID
        and IsActive=1;
    
	-- Insert new record (versioned)
    	INSERT INTO tbl_rera_ecourt_complaint_formn_institutiondetail (
		-- InstitutionFormN_IndexID,
