CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthorityDesk_QuarterlyUpdatesProjectDetails`(    
  p_UserRole varchar(50)  
)
begin  


SELECT 
	XM.QUpdateProject_RegDiaryNumber_IndexID,
	XM.QUpdateProject_RegDiaryNumber_ID,
	XM.QUpdateProject_RegDiaryNumber_Name,
	XM.QUpdateProject_RegDiaryNumber_NameYear,
	XM.QUpdateProject_Year,
	XM.QUpdateProject_QuarterName,
	XM.UserID,
	XM.PromoterID,
	XM.ProjectID,
	XM.InventoryCount,
	XM.ParkingDetailsCount,
	XM.GeoTaggingPhotographCount,
	XM.InternalFacilitiesCount,
	XM.ExternalFacilitiesCount,
	XM.ApprovalsCount,
	XM.RERAnumber as RERAregistrationnumber,
	XM.RERAnumberIssueDate as RERAnumberIssueDate,
	XM.RERAnumberVlaidUptoDate as RERAnumberValidUptoDate,
	XM.Extra2,
	XM.Extra3,
	XM.Extra4,
	'' as Remarks_IfAny,
	XM.IsActive,
	XM.IsDraft,
	XM.IsDraftHelpDesk,
	XM.IsDraftEvaluation,
	XM.IsDraftSecMember,
	XM.IsDraftMember,
	XM.IsActiveProvider,
	XM.IsLock,
	XM.CreatedBy,
	XM.CreatedOn,
	XM.ModifyBy,
	XM.ModifyOn,
    
	XN.PromoterRegDiaryNumber_Name as ProjectRegDiaryNumber_Name,
	udfn_GetQuarterlyUpdateProjectApplicationDate(XM.ProjectID, XM.QUpdateProject_Year, XM.QUpdateProject_QuarterName) as QUpdatesApplication_Date,
	XM.QUpdateProject_Year as setQuarterValue_Year,
	CASE    
	WHEN XM.QUpdateProject_QuarterName = 'FirstQTR' THEN "QTR-I (January-March)"
	WHEN XM.QUpdateProject_QuarterName = 'SecondQTR' THEN "QTR-II (April-June)"
	WHEN XM.QUpdateProject_QuarterName = 'ThirdQTR' THEN "QTR-III (July-September)"
	WHEN XM.QUpdateProject_QuarterName = 'FourthQTR' THEN "QTR-IV (October-December)"
	ELSE "NA"
	END setQuarterValue_Name,
	udfn_GetProjectName(XM.ProjectID) as Project_Name,
	udfn_GetPromoterName(XM.PromoterID) as Promoter_Name,
	udfn_GetProjectAddressDistrictName(XM.ProjectID) as Project_AddressDistrictName,

	XM.EventAction_Type,
	XM.EventAction_Aggregate as EventAction_TypeName,
	XM.EventAction_IdentifiedOn,
	XM.EventAction_Aggregate,
	XM.Target_ResolutionDate,
	XM.Remarks_IfAny as EventRemarks_IfAny,
	XM.EventAction_Summary,

	'' as A_column,
	0 as B_column,
	'0001-01-01 00:00:00' as C_column,
	'0001-01-01 00:00:00' as D_column
FROM 
tbl_rera_project_regdiarynumber XN 
RIGHT OUTER JOIN
(
SELECT   
	 a.QUpdateProject_RegDiaryNumber_IndexID,
	 a.QUpdateProject_RegDiaryNumber_ID,
	 a.QUpdateProject_RegDiaryNumber_Name,
	 a.QUpdateProject_RegDiaryNumber_NameYear,
	 a.QUpdateProject_Year,
	 a.QUpdateProject_QuarterName,
	 a.UserID,
	 a.PromoterID,
	 a.ProjectID,
	 a.InventoryCount,
	 a.ParkingDetailsCount,
	 a.GeoTaggingPhotographCount,
	 a.InternalFacilitiesCount,
	 a.ExternalFacilitiesCount,
	 a.ApprovalsCount,
	 a.RERAnumber,
	 a.RERAnumberIssueDate,
	 a.RERAnumberVlaidUptoDate,
	 a.Extra2,
	 a.Extra3,
	 a.Extra4,
	 -- a.Remarks_IfAny,
	 a.IsActive,
	 a.IsDraft,
	 a.IsDraftHelpDesk,
	 a.IsDraftEvaluation,
	 a.IsDraftSecMember,
	 a.IsDraftMember,
	 a.IsActiveProvider,
	 a.IsLock,
	 a.CreatedBy,
	 a.CreatedOn,
	 a.ModifyBy,
	 a.ModifyOn,
	 b.QUpdateProjectEventAction_ID,
	 b.EventAction_Type,
	 b.EventAction_IdentifiedBy,
	 b.EventAction_IdentifiedOn,
	 b.Related_Promoter_ID,
	 b.Related_Project_ID,
	 b.Related_QUpdateProject_Year,
	 b.Related_QUpdateProject_QuarterName,
	 b.DiaryNumber_Promoter,
	 b.DiaryNumber_Project,
	 b.DiaryNumber_QUpdateProject,
	 b.EventAction_Summary,
	 b.EventAction_Description,
	 b.EventAction_Category,
	 b.EventAction_Aggregate,
	 b.EventAction_Relationship,
	 b.AssignedTo,
	 b.Target_ResolutionDate,
	 b.Target_ResolutionSummary,
	 b.Actual_ResolutionDate,
	 b.IsBefore_TargetResolution,
	 b.ProgressStatus,
	 b.Remarks_IfAny
	 -- b.IsActive,
	 -- b.IsDraft,
	 -- b.IsActiveProvider,
	 -- b.IsLock,
	 -- b.CreatedBy,
	 -- b.CreatedOn,
	 -- b.ModifyBy,
	 -- b.ModifyOn         
	FROM tbl_rera_project_quarterlyupdate_regdiarynumber a, tbl_rera_project_quarterlyupdate_eventaction b
	where a.QUpdateProject_RegDiaryNumber_Name=b.DiaryNumber_QUpdateProject
	and a.ProjectID=b.Related_Project_ID
	-- and a.QUpdateProject_Year=b.Related_QUpdateProject_Year
	-- and a.QUpdateProject_QuarterName=b.Related_QUpdateProject_QuarterName
	and b.IsActive=1
	and a.IsActive=1
	and b.IsActiveProvider=1
	and b.EventAction_Type in (160001,160004,160007,160020,160011,160012,160013,160014,160015)
	) XM        
ON
XN.isactive=1
and XM.PromoterID=XN.Promoter_ID
and XM.ProjectID=XN.Project_ID
order by XM.EventAction_IdentifiedOn desc
Limit 1550; 
  
end ;;
