	a.RERAnumberIssueDate as Project_Diarydated_RERAdated_PUCdated,
	a.RERAnumberRegUptoDate as Project_RegistrationValidUptoDate,

	c.EventAction_Type as A_Column,
	c.EventAction_Aggregate as B_Column,
	'NA' as C_Column,

