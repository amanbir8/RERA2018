declare vgetFlagPUC_OpenClosed varchar(50);
declare vgetFlagPUC_ApprovedNotApproved varchar(50);

declare vputFlagCategory int;
declare vput_RegistrationNumber varchar(150);
declare vput_RefProjectID bigint;
declare vput_RefPromoterID bigint;
declare vput_RefPUC_ID bigint;

set vgetextnregduptodate='0001-01-01 00:00:00.000';
set vcheckcnt=0;
set vgetextndiarynumber='';

set vput_RefProjectID=0;
set vput_RefPromoterID=0;
set vput_RefPUC_ID=0;

