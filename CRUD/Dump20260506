CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_RERA_Project_RegDiaryNumber`(         
	p_Promoter_ID bigint ,             
	p_UserID varchar(50) ,        
	p_Project_ID bigint ,        
		 
	p_Extra2 varchar(200) ,        
	p_Extra3 varchar(200) ,        
	p_Extra4 varchar(200) ,        
	p_Remarks_IfAny varchar(250) ,        
	-- IsActive int ,        
	p_IsDraft int ,        

	p_IsDraftHelpDesk int ,        
	p_IsDraftEvaluation int ,        
	p_IsDraftSecMember int ,        
	p_IsDraftMember int ,        
	p_CreatedBy varchar(50) ,        
	-- CreatedOn datetime ,        
	p_ModifyBy varchar(50) ,        
	-- ModifyOn datetime ,        
	out p_Return_Project_RegDiaryNumber_Name varchar(50)          
)
begin        
             
	Declare v_mainCount Int;       
	Declare v_Total Int;      
	Declare v_Total_PROMOTER Int;   
	declare v_GET_Subdivision_Name varchar(10);     
	declare v_GET_Project_RegDiaryNumber_Name varchar(10);         
	declare v_PutProject_RegDiaryNumber_Name varchar(50);         
	declare v_GetProject_RegDiaryNumber_ID bigint;  
	declare v_PutProject_RegDiaryNumber_ID bigint;  
	declare v_checkrno int;  

	declare v_GetExistingForDeskProjectRegDiaryNumber_Name varchar(50);
	declare v_GetExistingForDeskProjectRegDiaryNumber_NameYear varchar(50); 
	declare v_GetExistingForDeskProjectRegDiaryNumber_ID varchar(50);  
 
	declare v_LandDetailsCount int;        
	declare v_KhasraAreaDetailsCount int;        
	declare v_LitigationsCount int;        
	declare v_ApprovalDetailsCount int;        
	declare v_PaymentDetailsCount int;        
	declare v_SpecialBankAccountDetailsCount int;        
	declare v_ProjectDocumentCount int;

	declare v_checkExistingProjectDiaryNumberCount int;
	declare v_checkExistingEventCount int;
    declare v_checkReminderSchedulerEmailsCount int;
    declare v_checkReminderSchedulerSMSgatewayCount int;
 

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;
 
	-- ------------------------- Application_id ------------------------            
	select max(Project_RegDiaryNumber_ID) into v_GetProject_RegDiaryNumber_ID from tbl_RERA_Project_RegDiaryNumber where PromoterRegDiaryNumber_NameYear=YEAR(NOW());        
	-- ----------------Get subdivision name from project id-----------  
	SELECT  District_RERAcode INTO v_GET_Subdivision_Name  FROM tbl_rera_master_subdivisiondetails  
	where SubDivision_Code in (select Project_AddressSubDivisionCode from tbl_RERA_Project_Registration where ProjectRegistration_ID= p_Project_ID and IsActive=1)
    and IsActive=1
    Limit 1;
            
	IF (v_GetProject_RegDiaryNumber_ID IS NULL)          
	then          
		set v_PutProject_RegDiaryNumber_ID=1;      
		set v_PutProject_RegDiaryNumber_Name=CONCAT('PRJ', CAST(YEAR(NOW()) as CHAR(50)), CAST(v_GET_Subdivision_Name as CHAR(50)), CAST(LPAD(v_PutProject_RegDiaryNumber_ID, 4, '0') as CHAR(50)));         
	ELSE           
		SET v_PutProject_RegDiaryNumber_ID=v_GetProject_RegDiaryNumber_ID+1;      
		set v_PutProject_RegDiaryNumber_Name=CONCAT('PRJ', CAST(YEAR(NOW()) as CHAR(50)), CAST(v_GET_Subdivision_Name as CHAR(50)), CAST(LPAD(v_PutProject_RegDiaryNumber_ID, 4, '0') as CHAR(50)));
	end if;      
        
       
select COUNT(*) into v_LandDetailsCount from tbl_RERA_Project_LandDetails where ProjectLandRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
select COUNT(*) into v_KhasraAreaDetailsCount from tbl_RERA_Project_KhasraAreaDetails where ProjectKhasraAreaRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
select COUNT(*) into v_LitigationsCount from tbl_RERA_Project_Litigations where LitigationsRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
        
select COUNT(*) into v_ApprovalDetailsCount from tbl_RERA_Project_ApprovalDetails where ProjectApprovalRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
select COUNT(*) into v_PaymentDetailsCount from tbl_RERA_Project_Payment where ProjectPaymentRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
        
select COUNT(*) into v_SpecialBankAccountDetailsCount from tbl_RERA_Project_SpecialBankAccountDetails where SpecialBankAccountRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
select COUNT(*) into v_ProjectDocumentCount from tbl_RERA_Project_Documents where Project_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
     
	-- ---STARTS--------check diary number in project quater table if not exits then no Diary Number implemented--------    
	-- SELECT *  FROM [DBRERA].[dbo].[tbl_RERA_Project_Quater_RegDiaryNumber] where Project_ID=10008    
	SELECT  COUNT(*) INTO v_Total  FROM  tbl_RERA_Project_Quater_RegDiaryNumber  where Project_ID=p_Project_ID and IsActive=1 and IsDraft=1;      
	SELECT  COUNT(*) INTO v_Total_PROMOTER  FROM  tbl_RERA_Promoter_RegDiaryNumber  where Promoter_ID=p_Promoter_ID and IsActive=1 and IsDraft=1;      
       
	if v_Total>0 and v_Total_PROMOTER>0     
	then      
		set  v_mainCount=1;      
	else    
		set  v_mainCount=0;      
	end if;     
-- ---------------if no diary number in quater table then set projet diary number to 0 else project Diary Number implemented------------------------------------------------------------------------------------------         
if v_mainCount=0    
then     
	set v_GetProject_RegDiaryNumber_ID=0;    
	set v_PutProject_RegDiaryNumber_Name=0;    
else    
	  
      -- -------Check Count Existing Project Diary Number----------
		  
	  select COUNT(*) into v_checkExistingProjectDiaryNumberCount from  tbl_RERA_Project_RegDiaryNumber 
	  where Project_ID=p_Project_ID and 
	  Promoter_ID=p_Promoter_ID and 
	  IsActive=1; 
		  
      if v_checkExistingProjectDiaryNumberCount>0
	  then
		  -- ------------Update Previous Record (LOCK)-----------
		  update tbl_RERA_Project_RegDiaryNumber set IsDraft=1 
		  where Project_ID=p_Project_ID and 
		  Promoter_ID=p_Promoter_ID and 
		  IsActive=1;
		  
		  
		  select PromoterRegDiaryNumber_Name,
				PromoterRegDiaryNumber_NameYear,
				Project_RegDiaryNumber_ID into v_GetExistingForDeskProjectRegDiaryNumber_Name, v_GetExistingForDeskProjectRegDiaryNumber_NameYear, v_GetExistingForDeskProjectRegDiaryNumber_ID
		  from  tbl_RERA_Project_RegDiaryNumber 
			  where Project_ID=p_Project_ID and 
			  Promoter_ID=p_Promoter_ID and 
			  IsActive=1; 
			  
			  
		  update tbl_RERA_Project_RegDiaryNumber set IsActive=2
		  where Project_ID=p_Project_ID and 
		  Promoter_ID=p_Promoter_ID and 
		  PromoterRegDiaryNumber_Name=v_GetExistingForDeskProjectRegDiaryNumber_Name and
		  IsActive=1;	  
		  
		  
     
		  -- ------- Generate New Diary Number (Application Modification)---------- 
		  INSERT INTO tbl_RERA_Project_RegDiaryNumber        
			   (        
			Project_RegDiaryNumber_ID ,       
			PromoterRegDiaryNumber_Name ,      
			PromoterRegDiaryNumber_NameYear ,       
			Promoter_ID ,        
			Project_ID,        
			UserID ,        
			LandDetailsCount,        
			KhasraAreaDetailsCount,        
			LitigationsCount,        
			ApprovalDetailsCount,        
			PaymentDetailsCount,        
			SpecialBankAccountDetailsCount,        
			ProjectDocumentCount,        
			IsRegistration,       
			CurrentEventcode  ,      
			EventCodeDetails_indexID   ,      
			Extra2,        
			Extra3,        
			Extra4,        
			  
			Remarks_IfAny ,        
			IsActive ,        
			IsDraft ,        
			IsDraftHelpDesk ,        
			IsDraftEvaluation ,        
			IsDraftSecMember ,        
			IsDraftMember ,        
			CreatedBy ,        
			CreatedOn  ,        
			ModifyBy ,        
			ModifyOn         
		  )        
		  VALUES        
		  (   
			v_GetExistingForDeskProjectRegDiaryNumber_ID, -- @PutProject_RegDiaryNumber_ID ,       
			v_GetExistingForDeskProjectRegDiaryNumber_Name, -- @PutProject_RegDiaryNumber_Name ,      
			v_GetExistingForDeskProjectRegDiaryNumber_NameYear, -- YEAR(GETDATE()),       
			p_Promoter_ID ,        
			p_Project_ID,        
			p_UserID ,        
			 
			v_LandDetailsCount ,        
			v_KhasraAreaDetailsCount ,        
			v_LitigationsCount ,        
			v_ApprovalDetailsCount ,        
			v_PaymentDetailsCount ,        
			v_SpecialBankAccountDetailsCount ,        
			v_ProjectDocumentCount ,        
			0, -- --IsRegistration,      
			0,-- CurrentEventcode  ,      
			0,--   EventCodeDetails_indexID   ,       
			p_Extra2   ,        
			p_Extra3   ,        
			p_Extra4   ,        
			p_Remarks_IfAny ,        
			1 ,        
			1 ,        
			p_IsDraftHelpDesk   ,        
			p_IsDraftEvaluation   ,        
			p_IsDraftSecMember   ,        
			p_IsDraftMember   ,        
			p_CreatedBy,        
			NOW(),                    
			p_ModifyBy,        
			NOW()         
		  );
      
      else
		   -- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
		  INSERT INTO tbl_RERA_Project_RegDiaryNumber        
			   (        
			Project_RegDiaryNumber_ID ,       
			PromoterRegDiaryNumber_Name ,      
			PromoterRegDiaryNumber_NameYear ,       
			Promoter_ID ,        
			Project_ID,        
			UserID ,        
			LandDetailsCount,        
			KhasraAreaDetailsCount,        
			LitigationsCount,        
			ApprovalDetailsCount,        
			PaymentDetailsCount,        
			SpecialBankAccountDetailsCount,        
			ProjectDocumentCount,        
			IsRegistration,       
			CurrentEventcode  ,      
			EventCodeDetails_indexID   ,      
			Extra2,        
			Extra3,        
			Extra4,        
			  
			Remarks_IfAny ,        
			IsActive ,        
			IsDraft ,        
			IsDraftHelpDesk ,        
			IsDraftEvaluation ,        
			IsDraftSecMember ,        
			IsDraftMember ,        
			CreatedBy ,        
			CreatedOn  ,        
			ModifyBy ,        
			ModifyOn         
		  )        
			VALUES        
			   (        
			v_PutProject_RegDiaryNumber_ID ,       
			v_PutProject_RegDiaryNumber_Name ,      
			YEAR(NOW()),       
			p_Promoter_ID ,        
			p_Project_ID,        
			p_UserID ,        
			 
			v_LandDetailsCount ,        
			v_KhasraAreaDetailsCount ,        
			v_LitigationsCount ,        
			v_ApprovalDetailsCount ,        
			v_PaymentDetailsCount ,        
			v_SpecialBankAccountDetailsCount ,        
			v_ProjectDocumentCount ,        
			0, -- --IsRegistration,      
			0,-- CurrentEventcode  ,      
			0,--   EventCodeDetails_indexID   ,       
			p_Extra2   ,        
			p_Extra3   ,        
			p_Extra4   ,        
			p_Remarks_IfAny ,        
			1 ,        
			1 ,        
			p_IsDraftHelpDesk   ,        
			p_IsDraftEvaluation   ,        
			p_IsDraftSecMember   ,        
			p_IsDraftMember   ,        
			p_CreatedBy,        
			NOW(),                    
			p_ModifyBy,        
			NOW()         
			 );
     end if;
     -- -------------------------------       
        
	-- ---------event insert 

	select COUNT(*) into v_checkExistingEventCount from  tbl_RERA_Project_Promoter_EventAction 
	where Related_Project_ID=p_Project_ID and 
	Related_Promoter_ID=p_Promoter_ID and 
	IsActive=1;
	  
	if v_checkExistingEventCount>0
	then
	-- -----------------------
	update tbl_RERA_Project_Promoter_EventAction set IsActive=2 
	where Related_Project_ID=p_Project_ID and 
	Related_Promoter_ID=p_Promoter_ID and 
	IsActive=1;
	  
	  
	  INSERT INTO tbl_RERA_Project_Promoter_EventAction  
		(
		EventAction_Type  
		,EventAction_IdentifiedBy  
		,EventAction_IdentifiedOn  
		,Related_Promoter_ID  
		,Related_Project_ID  
		,Promoter_DiaryNumber  
		,Project_DiaryNumber  
		,EventAction_Summary  
		,EventAction_Description  
		,EventAction_Category  
		,EventAction_Aggregate  
		,EventAction_Relationship  
		,AssignedTo  
		,Target_ResolutionDate  
		,Target_ResolutionSummary  
		,Actual_ResolutionDate  
		,IsBefore_TargetResolution  
		,ProgressStatus  
		,Remarks_IfAny  
		,IsActive  
		,IsDraft  
		,CreatedBy  
		,CreatedOn  
		,ModifyBy  
		,ModifyOn
		)  
		VALUES 
		(   
		110004 ,  
		'999' ,  
		NOW(),    
		p_Promoter_ID  ,  
		p_Project_ID,  
		'999' ,  
		v_GetExistingForDeskProjectRegDiaryNumber_Name, -- @PutProject_RegDiaryNumber_Name,  
		'Application Re-Submission(Modified Application)' ,  
		'Application submiited by Promoter with RERA' ,  
		'Actor Anonymous' ,  
		'Application Re-Submitted with Modification' ,  
		'Role Promoter' ,  
		'HelpDesk Level I' ,  
		NOW(),    
		'999' ,  
		NOW(),    
		1 ,  
		'In Process' ,  
		'Application Re-Submission(Modified Application)' ,  
		1 ,  
		0 ,  
		'sysadmin' ,  
		NOW(),    
		'sysadmin' ,  
		NOW()  
        );  
  
	  set v_PutProject_RegDiaryNumber_Name=v_GetExistingForDeskProjectRegDiaryNumber_Name;
  
	else
  
	  INSERT INTO tbl_RERA_Project_Promoter_EventAction  
		(
		EventAction_Type  
		,EventAction_IdentifiedBy  
		,EventAction_IdentifiedOn  
		,Related_Promoter_ID  
		,Related_Project_ID  
		,Promoter_DiaryNumber  
		,Project_DiaryNumber  
		,EventAction_Summary  
		,EventAction_Description  
		,EventAction_Category  
		,EventAction_Aggregate  
		,EventAction_Relationship  
		,AssignedTo  
		,Target_ResolutionDate  
		,Target_ResolutionSummary  
		,Actual_ResolutionDate  
		,IsBefore_TargetResolution  
		,ProgressStatus  
		,Remarks_IfAny  
		,IsActive  
		,IsDraft  
		,CreatedBy  
		,CreatedOn  
		,ModifyBy  
		,ModifyOn
		)  
		 VALUES  
		(   
		110001 ,  
		'999' ,  
		NOW(),    
		p_Promoter_ID  ,  
		p_Project_ID,  
		'999' ,  
		v_PutProject_RegDiaryNumber_Name,  
		'Project Application Submission(New Application)' ,  
		'Application submiited by Promoter with RERA' ,  
		'Actor Anonymous' ,  
		'Application Submitted' ,  
		'Role Promoter' ,  
		'HelpDesk Level I' ,  
		NOW(),    
		'999' ,  
		NOW(),    
		1 ,  
		'In Process' ,  
		'' ,  
		1 ,  
		0 ,  
		'sysadmin' ,  
		NOW(),    
		'sysadmin' ,  
		NOW()  
		); 
 
	end if; 
 
 
	-- START---------Reminder Scheduler RESET insert
	if v_checkExistingProjectDiaryNumberCount>0
	then		 
		-- -- Emails Reset
		select COUNT(*) into v_checkReminderSchedulerEmailsCount from tbl_rera_project_reminderscheduler_emails 
		where Project_ID=p_Project_ID and 
		Promoter_ID=p_Promoter_ID and 
		IsActive=1;

		if v_checkReminderSchedulerEmailsCount>0
		then
			update tbl_rera_project_reminderscheduler_emails 
            set IsActive=2, D_Column=NOW() 
			where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1
            and ProjectReminder_IndexID <> 0;
		end if;

		-- -- SMS Reset
		select COUNT(*) into v_checkReminderSchedulerSMSgatewayCount from tbl_rera_project_reminderscheduler_smsgateway 
		where Project_ID=p_Project_ID and 
		Promoter_ID=p_Promoter_ID and 
		IsActive=1;

		if v_checkReminderSchedulerSMSgatewayCount>0
		then
			update tbl_rera_project_reminderscheduler_smsgateway 
            set IsActive=2, D_Column=NOW() 
			where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1
            and ProjectReminderSMS_IndexID <> 0;
		end if;		
	end if; 
	-- END-----------------------
 
end if;   
       
-- ---ENDS--------check diary number in project quater table if not exits then no Diary Number implemented-------- 

  -- End------------------------  
    
     -- select @PutProject_RegDiaryNumber_Name as PutProject_QuaterRegDiaryNumber_Name        

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;  
      
    
set p_Return_Project_RegDiaryNumber_Name= v_PutProject_RegDiaryNumber_Name; 
    
