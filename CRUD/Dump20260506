CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_Count_TrackRecordLitigations`(
	p_Related_Promoter_ID bigint,
	p_Related_TypeOfPromoter_ID int,
	p_Related_JointPromoter_ID bigint,
	p_Related_JointPromoter_Type int,
	p_Flag int,
	p_UserNam varchar(150)
)
begin   
  
declare v_countfile int;
declare v_TypeExperienceYN int; 
declare v_TypeLitigationsYN int;  
declare v_statusFlag int;
declare v_submitFlag int;
declare v_getIsLock int;

set v_TypeExperienceYN=0; 
set v_TypeLitigationsYN=0; 
set v_statusFlag=0;
set v_submitFlag=0;
  
select count(*) into v_countfile from tbl_rera_copromoter_registrationdetails 
where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
and Related_Promoter_Application_ID=p_Related_Promoter_ID
and Isactive=1;

if (v_countfile<>0) then

	select (case when IsExperience='Y' then 1 else 0 end), (case when IsLitigation_RelatedProject='Y' then 1 else 0 end) into v_TypeExperienceYN, v_TypeLitigationsYN from tbl_rera_copromoter_registrationdetails
	where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
	and Related_Promoter_Application_ID=p_Related_Promoter_ID
	and Isactive=1
    order by CoPromoter_IndexID desc 
    Limit 1;
    
    -- Start ALGO--
    select IsLock into v_getIsLock FROM tbl_rera_copromoter_trackrecord_litigations
	where Related_Promoter_ID=p_Related_Promoter_ID and Related_PromoterType=p_Related_TypeOfPromoter_ID
    and Related_JointPromoter_ID=p_Related_JointPromoter_ID -- and Related_JointPromoterType=p_Related_JointPromoter_Type
	and Isactive=1 and IsLock in (0,1)
	order by JointPromoter_Litigations_IndexID desc 
    Limit 1;

	if (v_getIsLock=1) then
		set v_statusFlag=1;
		set v_submitFlag=1;
	else
		if (v_getIsLock=0) then
			set v_statusFlag=1;
			set v_submitFlag=2;
		end if;
	end if;
    -- End ALGO-- 
end if;

-- //TypeProfile/statusFlag/submitFlag
Select v_TypeExperienceYN AS TypeExperienceYN, v_TypeLitigationsYN as TypeLitigationsYN, v_statusFlag as statusFlag, v_submitFlag as submitFlag; 
  
end ;;
