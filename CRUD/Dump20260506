            VALUES        
			  ( 
				-- PUC_RegDiaryNumber_IndexID,
                v_PutPUC_RegDiaryNumber_ID, -- PUC_RegDiaryNumber_ID
                v_PutPUC_RegDiaryNumber_Name, -- PUC_RegDiaryNumber_Name
				YEAR(NOW()), -- PUC_RegDiaryNumber_NameYear,
				p_User_ID,				
                p_RelatedPromoter_ID,
				p_RelatedProject_ID,
                v_ApplicationPUC_ID,
                p_PUC_RequestCategoryName,
                p_PUC_RequestCategoryID,
                p_RERAnumberRegistration,
                p_PUC_ReferencePUC_Name,
                YEAR(p_PUC_ReferencePUC_Date), -- p_PUC_ReferencePUC_Year,
                p_PUC_ReferencePUC_Date,
                0,  -- PaymentDetailsCount,
				0,  -- ChangeRequestCount,
				1,  -- IsRegistration,
				0,  -- CurrentEventcode,
