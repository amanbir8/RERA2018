    PaymentType as epayNAME
	FROM tbl_rera_master_paymenttypebycode
	where IsActive=1
	UNION
	SELECT -- PaymentType_IndexID,PaymentType_Code,PaymentType,IsActive
    PaymentType_Code as epayID,
    PaymentType as epayNAME
	FROM tbl_rera_master_paymenttype
	where isactive=1
	and PaymentType_Code in (1, 4)
	Order by epayNAME desc;
