then

-- UNIT Level-I START
SELECT
	m.*,
	-- Advance-Search-Details (Revoke Registration)
	n.RERAnumberRegistration as revRERAnumberRegistration,
	n.LatestRenewalRegistrationIssueDate as revRERAnumberIssueDate,
	n.LatestRenewalRegistrationUptoDate as revRERAnumberRegUptoDate,
	0 as revIsRenewalRegistration,
	n.LatestRenewalRegistrationNumber as revRERAnumberRenewalRegUptoDate,

	'2015-01-01 00:00:00' as AgentApplicationDate,
	'2015-01-01 00:00:00' as AgentRenewalApplicationDate,

    CASE
		WHEN n.Agent_Type = 1 THEN n.AgentName
		WHEN n.Agent_Type = 2 THEN n.OrganizationName
		ELSE 'NA'
	END as revAgentName,
	n.AgentBussinessPlaceDistrict as revAgentAddressDistrict,
	n.RevokesRegDiaryNumber_Name as revDName,
	n.Agent_Type as revAgentType,
	n.Revoke_InfoDetails as revRevoke_InfoDetails,
	n.Revoke_ReferenceName as revRevoke_ReferenceName,
	n.Revoke_ReferenceDate as revRevoke_ReferenceDate,
	n.Revoke_Category as revRevoke_Category,
	n.Revoke_ReciptType as revRevoke_ReciptType,
	n.Revoke_Reasons as revRevoke_Reasons,
	n.AgentRegDiaryNumber_Name as revAgent_DiaryNumber,
	n.LatestAgentRenewalRegDiaryNumber_Name as revRenewalAgent_DiaryNumber,
	n.RevokesRegDiaryNumber_Name as revRevoke_DiaryNumber,

	-- Manage-Registration-Params
	0 AS IsRegistration_Lapsed,	
	0 as IsRegistration_Withdrawn,
	0 as IsRegistration_Cancelled,
	1 as IsRegistration_Revoked,
	'Revoked Registration' as IsRegistration_Condition,
	'' as IsRegistration_Flag
FROM
(select 
	-- RealEstate-Agent
	u.Agent_RERAnumber_DiaryNumber_IndexID,
	u.Agent_RERAnumber_DiaryNumber_ID,
	u.AgentRegDiaryNumber_Name,
	u.AgentRegDiaryNumber_NameYear,
	u.UserID,
	u.Agent_ID,

	u.OtherMemDetailsCount,
	u.DocumentuploadsCount,
	u.UTotherStateRERACount,
	u.PaymentsCount,
	u.AgentDocumentCount,
	u.Remarks_IfAny,
	u.CurrentEventcode,
	u.EventCodeDetails_indexID,
	u.tbl_RegDiaryNumber_indexID,
	u.Project_ID,
	u.Project_Name,
	u.Promoter_ID,
	u.Promoter_Name,
	u.IsAlreadyRegistration,
	u.ExistingRegistration,
	u.Agent_Type,
	u.Agent_FirstName,
	u.Agent_MiddleName,
	u.Agent_LastName,
	u.Organization_Name,
	u.BComm_AddressStateCode,
	u.BComm_AddressDistrictCode,
	u.EmailAddress,
	u.MobileNumber,

	u.RERAnumberRegistration,
	u.RERAnumberIssueDate,
	-- u.RERAnumberRegUptoDate,
	CASE
		WHEN v.EventAction_Type=290012 THEN v.RenewalAgentRegistrationRegUptoDate
		WHEN v.EventAction_Type is null THEN u.RERAnumberRegUptoDate
		ELSE 'NA'
	END as RERAnumberRegUptoDate,

	u.Extra2,
	u.Extra3,
	u.Extra4,
	u.IsActive,
	u.IsDraft,
	u.IsDraftHelpDesk,
	u.IsDraftEvaluation,
	u.IsDraftSecMember,
	u.IsDraftMember,
	u.IsPublicView,
	u.CreatedBy,
	u.CreatedOn,
	u.ModifyBy,
	u.ModifyOn,

	u.Agent_Name,
	u.Agent_AddressDistrictName,
	u.Agent_RERAregistrationNumber,

	u.EventAction_Type,
	u.EventAction_TypeName,
	u.EventAction_IdentifiedOn,
	u.EventAction_Aggregate,
	u.Target_ResolutionDate,
	u.EventRemarks_IfAny,
	u.EventAction_Summary,

	u.AgentRERAcert_FilePath,
	u.AgentRERAcert_FileName,
	u.AgentRERAcert_ReferenceNumber,
	u.AgentRERAcert_IssueDate,

	-- Renewal-of-Registration-AGENT
	IFNULL(v.AgentRegRenewal_DiaryNumber_IndexID, 0) as RenewalAgentDiaryNumber_IndexID,
	IFNULL(v.AgentRegRenewal_DiaryNumber_ID, 0) as RenewalAgentDiaryNumber_ID,
	v.RelatedRenewalAgentRegDiaryNumber_Name as RenewalAgentDiaryNumber_Name,
	IFNULL(v.RelatedRenewalAgentRegDiaryNumber_NameYear, 0) as RenewalAgentDiaryNumber_NameYear,

	IFNULL(v.RelatedRenewalAgent_ID, 0) as Related_RenewalAgent_ID,
	IFNULL(v.RelatedRenewalAgent_Year, 0) as Related_RenewalAgent_Year,
	IFNULL(v.RenewalOrderSequence, 0) as Related_RenewalAgent_SequenceID,
	v.UserID as Related_UserID,
	IFNULL(v.RelatedAgent_ID, 0) as Related_Agent_ID,
	IFNULL(v.Agent_Type, 0) as Related_AgentType_ID,

	v.RelatedAgentDiaryNumber_Name as Related_Agent_DiaryNumber,
	v.RERAnumberRegistration as Related_RERAnumberRegistration,
	v.RERAnumberIssueDate as Related_LastRegistrationIssueDate,
	v.RERAnumberRegUptoDate as Related_LastRegistrationRegUptoDate,

	v.OtherMemDetailsCount as m_othermemdetailCount,
	v.DocumentuploadsCount as m_documentuploadCount,
	v.UTotherStateRERACount as m_UTOtherStateRERACount,
	v.PaymentsCount as m_PaymentCount,
	v.AgentDocumentCount as m_AgentDocumentCount,

	v.Remarks_IfAny as m_Remarks_IfAny,
	v.CurrentEventcode as m_CurrentEventcode,
	v.EventCodeDetails_indexID as m_EventCodeDetails_indexID,

	v.IsActive as m_IsActive,
	v.IsActiveProvider as m_IsActiveProvider,
	v.IsDraft as m_IsDraft,
	v.IsLock as m_IsLock,
	v.IsDraftHelpDesk as m_IsDraftHelpDesk,
	v.IsDraftEvaluation as m_IsDraftEvaluation,
	v.IsDraftSecMember as m_IsDraftSecMember,
	v.IsDraftMember as m_IsDraftMember,
	v.IsConditionAnnexureIssued as m_IsConditional,

	v.CreatedBy as m_CreatedBy,
	v.CreatedOn as m_CreatedOn, -- Application Created Date
	v.ModifyBy as m_ModifyBy,
	v.ModifyOn as m_ModifyOn,

	v.Extra1 as m_Extra1,
	v.Extra2 as m_Extra2,
	v.Extra3 as m_Extra3,

	CASE
		WHEN v.Agent_Type = 1 THEN Concat(v.Agent_FirstName, space(1), v.Agent_LastName)
		WHEN v.Agent_Type = 2 THEN v.Organization_Name
		ELSE 'NA'
	END as RenewalAgent_Name,
	udfn_GetAgentByRenewal_AddressDistrictName(v.RelatedAgent_ID, v.RelatedRenewalAgent_ID) as RenewalAgent_AddressDistrictName,
	v.RenewalAgentRegistrationNumber as RenewalAgent_RERAregistrationNumber,
	'2015-01-01 00:00:00' as Application_Date,

	v.RenewalAgentRegistrationNumber as RERA_Registration_Number, -- RERAnumberRegistration
	v.RenewalAgentRegistrationIssueDate as RERA_Number_IssueDate, -- RERAnumberIssueDate
	v.RenewalAgentRegistrationRegUptoDate as RERA_Number_RegistrationUptoDate, -- RERAnumberRegUptoDate

	'' as RenewalAgent_RERAcert_FilePath,
	'' as RenewalAgent_RERAcert_FileName,
	'NA' as RenewalAgent_RERAcert_ReferenceNumber,
	NOW() as RenewalAgent_RERAcert_IssueDate

from
(select a.*,  
  
udfn_GetAgentName(a.Agent_ID) as Agent_Name,
'' as Agent_AddressDistrictName,  
'--' as Agent_RERAregistrationNumber,  
  
c.EventAction_Type,  
c.EventAction_Type as EventAction_TypeName,  
c.EventAction_IdentifiedOn,  
c.EventAction_Aggregate,  
c.Target_ResolutionDate,  
c.Remarks_IfAny as EventRemarks_IfAny,  
c.EventAction_Summary ,

'' as AgentRERAcert_FilePath,
'' as AgentRERAcert_FileName,
'' as AgentRERAcert_ReferenceNumber,
NOW() as AgentRERAcert_IssueDate
  
from tbl_rera_ldr_agent_reranumber_diarynumber a, tbl_RERA_AuthDesk_Agent_EventAction c   
where a.AgentRegDiaryNumber_Name=c.Agent_DiaryNumber  
and a.Agent_ID=c.Related_Agent_ID  
and c.IsActive=1  
and a.IsActive=1
and a.IsPublicView=1 
and c.EventAction_Type in (220012)
) u,

(select a.*,  

c.EventAction_Type,  
c.EventAction_Type as EventAction_TypeName,  
c.EventAction_IdentifiedOn,  
c.EventAction_Aggregate,  
c.Target_ResolutionDate,  
c.Remarks_IfAny as EventRemarks_IfAny,  
c.EventAction_Summary
  
from tbl_rera_ldr_agent_reranumber_renewalregistration a, tbl_rera_authdesk_agent_renewal_eventaction c   
where a.RelatedRenewalAgentRegDiaryNumber_Name=c.RelatedAgent_RenewalDiaryNumber  
and a.RelatedAgent_ID=c.Related_Agent_ID 
and a.RelatedRenewalAgent_ID=Related_RenewalAgent_ID
and a.RenewalOrderSequence=Related_RenewalAgent_SequenceID
and c.IsActive=1  
and a.IsActive=1
and a.IsPublicView=1 
and a.IsActiveProvider=1
and c.EventAction_Type in (290012)
) v
WHERE v.RelatedAgent_ID=u.Agent_ID
and u.IsActive=1
and u.IsPublicView=1
) m, 

(select a.*,  
c.EventAction_Type,  
c.EventAction_Type as EventAction_TypeName,  
c.EventAction_IdentifiedOn,  
c.EventAction_Aggregate,  
c.Target_ResolutionDate,  
c.Remarks_IfAny as EventRemarks_IfAny,  
c.EventAction_Summary
  
from tbl_rera_ldr_agent_reranumber_revokedetails a, tbl_rera_authdesk_agent_revoke_eventaction c   
where a.RevokesRegDiaryNumber_Name=c.Revoke_DiaryNumber  
and a.Agent_ID=c.Related_Agent_ID 
and c.IsActive=1  
and a.IsActive=1
and a.IsPublicView=1 
and a.Revoke_Category='Revoked Registration'
and c.EventAction_Type in (870021)
) n
WHERE m.Related_Agent_ID=n.Agent_ID
and 
(
m.Related_RERAnumberRegistration like p_AgentRERAnumber
-- m.Agent_Type = 1
-- m.BComm_AddressDistrictCode = p_DistrictCode and
-- YEAR(m.Related_LastRegistrationIssueDate) = p_RegistrationIssueYear
)
order by EventAction_IdentifiedOn desc;
-- UNIT Level-I END

end if;


-- Section TWO
if (p_FlagDistrict = 0 and p_FlagYear <> 0)
then

-- UNIT Level-I START
SELECT
	m.*,
	-- Advance-Search-Details (Revoke Registration)
	n.RERAnumberRegistration as revRERAnumberRegistration,
