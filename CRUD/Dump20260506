		,Target_ResolutionSummary  
		,Actual_ResolutionDate  
		,IsBefore_TargetResolution  
		,ProgressStatus  
		,Remarks_IfAny  
		,IsActive  
		,IsDraft  
		,CreatedBy  
		,CreatedOn  
		,ModifyBy  
		,ModifyOn
        )  
		VALUES
		(   
		150004 ,  
		'999' ,  
		NOW(),    
		p_Promoter_ID  ,  
		p_Project_ID,  
		'999' ,  
		v_GetExistingForDeskProjectRegDiaryNumber_Name, -- @PutProject_RegDiaryNumber_Name,  
		'Form-E Re-Submitted (Modified Application)' ,  
		'Form-E submiited by Promoter with RERA' ,  
		'Actor Anonymous' ,  
		'Form-E Re-Submitted with Modification' ,  
		'Role Promoter' ,  
		'HelpDesk Level I' ,  
		NOW(),    
		'999' ,  
		NOW(),    
		1 ,  
		'In Process' ,  
		'Form-E Re-Submitted (Modified Application)' ,  
		1 ,  
		0 ,  
		'sysadmin' ,  
		NOW(),    
		'sysadmin' ,  
		NOW()  
		);
		set v_PutProjectExtForm_RegDiaryNumber_Name=v_GetExistingForDeskProjectRegDiaryNumber_Name;
	else
		INSERT INTO tbl_rera_Project_ExtensionForm_EventAction  
		(EventAction_Type  
		,EventAction_IdentifiedBy  
		,EventAction_IdentifiedOn  
		,Related_Promoter_ID  
		,Related_Project_ID  
		,Promoter_DiaryNumber  
		,Project_DiaryNumber  
