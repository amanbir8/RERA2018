CREATE DEFINER=`sa`@`%` PROCEDURE `Display_RERA_ProjectQUpdate_Count_ApprovalDetails`(
	p_QUpdateProjectID bigint,
	p_QUpdateYear int(11),
	p_QUpdateName varchar(100)
)
begin
Declare v_TotalCnt Int; 
Declare v_checkisdraftdistinctcnt Int; 
Declare v_checkisdraftzerocnt Int; 
Declare v_checkisdraftrecordcnt Int;
Declare v_checkisdraftquarterlyrecordcnt Int; 
Declare v_checkrecordcnt Int;
Declare v_checkaccessprovider Int; 
Declare v_checkaccessprovidercnt Int; 
Declare v_checkInternalForOptionalcnt Int;
set v_TotalCnt=6;

 -- 1 Pending
 -- 2 Complete
 -- 3 Confirmed
 -- 4 Closed
 -- 5 Optional
 -- 6 No_Record_Found

SELECT count(*) INTO v_checkrecordcnt FROM tbl_rera_project_quarterlyupdate_approvaldetails
where Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and IsActive=1 
and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName;

SELECT count(distinct(IsDraft)) INTO v_checkisdraftdistinctcnt FROM tbl_rera_project_quarterlyupdate_approvaldetails
where Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and IsActive=1
and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName;

SELECT count(IsDraft) INTO v_checkisdraftzerocnt FROM tbl_rera_project_quarterlyupdate_approvaldetails
where Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and IsActive=1 and IsDraft in (0,4)
and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName;

SELECT count(IsDraft) INTO v_checkisdraftquarterlyrecordcnt FROM tbl_rera_project_quarterlyupdate_approvaldetails
where Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and IsActive=1
and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName;
 
SELECT count(IsLock), IFNULL(IsLock, 0) INTO v_checkaccessprovidercnt, v_checkaccessprovider FROM tbl_rera_project_quarterlyupdate_regdiarynumberprovider
where QUpdateProject_Year=p_QUpdateYear and QUpdateProject_QuarterName=p_QUpdateName and IsActive=1;

SELECT count(IsDraft) INTO v_checkInternalForOptionalcnt FROM tbl_rera_project_quarterlyupdate_internalfacilities
where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_QUpdateProjectID and IsActive=1
and QUpdateInfraFacilities_Year=p_QUpdateYear and QUpdateInfraFacilities_QuarterName=p_QUpdateName;

if v_checkaccessprovider > 0 then
	-- Closed
	set v_TotalCnt=4;
else
	if v_checkrecordcnt > 0 then
		if v_checkisdraftquarterlyrecordcnt > 1 then

			if v_checkisdraftdistinctcnt > 1 then
				if v_checkisdraftzerocnt > 0 then
					-- Complete
					set v_TotalCnt=2;
				else
					-- Confirmed
					set v_TotalCnt=3;
				end if;
			else
				SELECT IsDraft INTO v_TotalCnt FROM tbl_rera_project_quarterlyupdate_approvaldetails
				where Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and IsActive=1
				and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName
				order by QUpdateProjectApproval_IndexID desc
				limit 1;
						
				if v_TotalCnt > 1 then
					if v_TotalCnt > 4 then
						-- Confirmed
						set v_TotalCnt=3;
					else
						if v_TotalCnt > 3 then
							-- Complete
							set v_TotalCnt=2;
						end if;
					end if;
				else
					if v_TotalCnt > 0 then
						-- Confirmed
						set v_TotalCnt=3;
					else
						-- Complete
						set v_TotalCnt=2;
					end if;
				end if;
				
			end if;
		else
			
			if v_checkisdraftzerocnt > 0 then
				-- Complete
				set v_TotalCnt=2; 
			else
				-- Confirmed
				set v_TotalCnt=3; 
			end if;			
		end if;
	else
		if v_checkInternalForOptionalcnt > 0 then
			-- Optional
			set v_TotalCnt=5;
        end if;
	end if;
end if;


Select v_TotalCnt AS TotalCount;
end ;;
DELIMITER ;
/*!50003 SET sql_mode              = @saved_sql_mode */ ;
/*!50003 SET character_set_client  = @saved_cs_client */ ;
/*!50003 SET character_set_results = @saved_cs_results */ ;
