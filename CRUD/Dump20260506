CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetAgent_RefFirst_RegistrationIssueDate`(pAgent_ID bigint, pRERA_Number varchar(100), pFlag int) RETURNS datetime(3)
BEGIN  
    DECLARE v_ret datetime(3);
    DECLARE v_chkAgentOnlineCnt int;
    DECLARE v_chkAgentOfflineCnt int;
      
    SELECT count(*) into v_chkAgentOnlineCnt FROM tbl_rera_ldr_agent_reranumber_diarynumber
    WHERE Agent_ID=pAgent_ID and IsActive=1;
    
	IF (v_chkAgentOnlineCnt<>0) THEN 
		-- Online RERA Number
		SELECT RERAnumberIssueDate INTO v_ret FROM tbl_rera_ldr_agent_reranumber_diarynumber
		WHERE Agent_ID=pAgent_ID and IsActive=1 and IsPublicView=1
		LIMIT 1;        
	ELSE
		-- Offline RERA Number
		SELECT count(*) into v_chkAgentOfflineCnt FROM tbl_rera_ldr_agent_reranumber_diarynumber
		WHERE Agent_ID=pAgent_ID and IsActive=1;
    
		IF (v_chkAgentOfflineCnt<>0) THEN        
			SELECT OfflineAgents_RERAregistrationIssueDate INTO v_ret FROM tbl_rera_agent_offlineagents_pendinguploads
			WHERE A_column=pAgent_ID and IsActive=1 and IsPublicView=1
			LIMIT 1;       
		ELSE 
			SELECT OfflineAgents_RERAregistrationIssueDate INTO v_ret FROM tbl_rera_agent_offlineagents_pendinguploads
			WHERE OfflineAgents_RERAregistrationNumber=pRERA_Number and IsActive=1 and IsPublicView=1
			LIMIT 1;       
		END IF;
	END IF;
    
	IF (v_ret IS NULL) THEN   
		SET v_ret = '2018-04-13 00:00:00.000';
	END IF;
     
    RETURN v_ret; 
END ;;
