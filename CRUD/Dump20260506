	-- Partial Bifurcation Case    
    select ComplaintM_RelatedComplaint_ID, RelatedBifurcate_Complaint_ID into v_Get_BifurcateOLD_ID, v_Get_BifurcateNEW_ID
    from tbl_rera_complaint_formm_bifurcationdetails 
