BEGIN  
    DECLARE v_ret int(11);  
    DECLARE v_chkcount int(11);
    
    select count(B_column) into v_chkcount from
	(
		select distinct B_column from tbl_RERA_Project_BuildingTowerBlock_Construction where ProjectConstructionRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1
		union 
		select distinct B_column from tbl_RERA_Project_BuildingTowerBlock_Inventory where ProjectInventoryRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1
		union
		select distinct B_column from tbl_RERA_Project_ExternalInfrastructure_Facilities where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1
		union
		select distinct B_column from tbl_RERA_Project_InternalInfrastructure_Facilities where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1
		union
		select distinct B_column from tbl_RERA_Project_ParkingDetails where ProjectParkingRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1
		union
		select distinct B_column from tbl_RERA_Project_ProfessionalDetails where ProjectProfessionalRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 
		union
		select distinct B_column from tbl_RERA_Project_ConstructionStatusPhotographs where ProjectPhotographsRelated_Project_ID=p_Project_ID and IsActive=1
	) m;
    
     IF (v_chkcount=1) THEN
		SET v_ret=1;
