	p_Transfer_FromBenchName varchar(150),
	p_Transfer_ToBench varchar(90),
	p_Transfer_ToBenchName varchar(150),
	p_PublicViewStatus varchar(500),
	p_Remarks_IfAny varchar(1500),
	p_A_column varchar(50),
	p_B_column varchar(50),
