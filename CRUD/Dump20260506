-- Loop 2017 START
CASE 
	WHEN a.RERAnumberIssueDate < '2019-04-01 00:00:00.000' and a.RERAnumberIssueDate > '2018-12-31 00:00:00.000' THEN 'YES'
    WHEN (a.RERAnumberRegUptoDate < '2019-04-01 00:00:00.000' and a.RERAnumberRegUptoDate > '2018-12-31 00:00:00.000') THEN 'YES'
