					p_PUC_ReferencePUC_Date,
					0,  -- PaymentDetailsCount,
					0,  -- ChangeRequestCount,
					1,  -- IsRegistration,
					0,  -- CurrentEventcode,
					0,  -- EventCodeDetails_indexID,
					v_ApplicationOrderSequencePUCnumber,              
					'', -- Extra1,
					'', -- Extra2,
					'', -- Extra3,
					'', -- Extra4,
					p_RemarksIfAny,
					1, -- IsActive,
					1, -- IsActiveProvider,
					1, -- IsDraft,
					0, -- IsDraftHelpDesk,
					0, -- IsDraftEvaluation,
					0, -- IsDraftSecMember,
					0, -- IsDraftMember,
					p_CreatedBy,
					NOW(), -- p_CreatedOn,
					p_ModifyBy,
					NOW() -- p_ModifyOn
				  );          
              else
				  -- ------------Update Previous Record (LOCK)-----------		  
				  update tbl_rera_project_puc_regdiarynumber set IsDraft=1 
				  where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and PUC_RequestCategoryID=p_PUC_RequestCategoryID and IsActive=1;
	  
				  select PUC_RegDiaryNumber_ID, PUC_RegDiaryNumber_Name, PUC_RegDiaryNumber_NameYear, RelatedApplicationPUC_ID, RequestOrderSequence
				  into v_GetExistingForDeskPUCdiaryNumber_ID, v_GetExistingForDeskPUCdiaryNumber_Name, v_GetExistingForDeskPUCdiaryNumber_NameYear, v_GetExistingForDeskPUCapplication_ID, v_ApplicationExistingOrderSequencePUCnumber
				  from tbl_rera_project_puc_regdiarynumber 
				  where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and PUC_RequestCategoryID=p_PUC_RequestCategoryID and IsActive=1;  
			  
				  update tbl_rera_project_puc_regdiarynumber set IsActive=2
				  where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and PUC_RequestCategoryID=p_PUC_RequestCategoryID
				  and PUC_RegDiaryNumber_Name=v_GetExistingForDeskPUCdiaryNumber_Name and IsActive=1;
			  
				  set v_getPUC_ApplicationID=v_GetExistingForDeskPUCapplication_ID;
				  
				  -- ------- Generate New Diary Number (Application Modification)---------- 
				  INSERT INTO tbl_rera_project_puc_regdiarynumber        
				  (  
					-- PUC_RegDiaryNumber_IndexID,
					PUC_RegDiaryNumber_ID,
					PUC_RegDiaryNumber_Name,
					PUC_RegDiaryNumber_NameYear,
					UserID,
					RelatedPromoter_ID,
					RelatedProject_ID,
					RelatedApplicationPUC_ID,
					PUC_RequestCategoryName,
					PUC_RequestCategoryID,
					RERA_RegistrationNumber,
					PUC_ReferencePUC_Name,
					PUC_ReferencePUC_Year,
					PUC_ReferencePUC_Date,
					PaymentDetailsCount,
					ChangeRequestCount,
					IsRegistration,
					CurrentEventCcode,
					EventCodeDetails_indexID,
					RequestOrderSequence,
					Extra1,
					Extra2,
					Extra3,
					Extra4,
					Remarks_IfAny,
					IsActive,
					IsActiveProvider,
					IsDraft,
					IsDraftHelpDesk,
					IsDraftEvaluation,
					IsDraftSecMember,
					IsDraftMember,
					CreatedBy,
					CreatedOn,
					ModifyBy,
					ModifyOn
				  )        
				  VALUES        
				  ( 
					-- PUC_RegDiaryNumber_IndexID,
					v_GetExistingForDeskPUCdiaryNumber_ID, 
					v_GetExistingForDeskPUCdiaryNumber_Name, 
					v_GetExistingForDeskPUCdiaryNumber_NameYear,
					p_User_ID,				
					p_RelatedPromoter_ID,
					p_RelatedProject_ID,
					v_GetExistingForDeskPUCapplication_ID,
