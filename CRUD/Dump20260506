CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Project_RERAnumberRegistration_ForDesk`(      
 p_Project_ID bigint,
 p_Promoter_ID bigint
 )
begin 

declare v_reranumbercnt int;

declare v_PromoterRegDiaryNumber_ID bigint;
declare v_PromoterRegDiaryNumber_Name varchar(50);
declare v_PromoterRegDiaryNumber_NameYear  varchar(50);
declare v_PromoterRegDiaryNumber_tbl_IndexID bigint;
declare v_PromoterRegDiaryNumber_CreatedDate datetime(3);
  
declare v_ProjectQuarterlyRegDiaryNumber_ID bigint;
declare v_ProjectQuarterly_QuarterName  varchar(250);
declare v_ProjectQuarterly_QuarterYear bigint;
declare v_ProjectQuarterlyRegDiaryNumber_tbl_IndexID bigint;
declare v_ProjectQuarterly_CreatedDate datetime(3);

declare v_PromoterType int(11);
declare v_PromoterWebLink varchar(250);
declare v_PromoterAuthSignFormB varchar(250);


set v_reranumbercnt=0;

select count(*) into v_reranumbercnt from tbl_rera_ldr_project_reranumber_diarynumber 
where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1 
limit 1;
     
if v_reranumbercnt>0
then

select * from tbl_rera_ldr_project_reranumber_diarynumber    
 where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID  
 and IsActive=1
 order by Project_RERAnumber_DiaryNumber_IndexID asc;
 
else

-- Prmomter Diary Number Info
select 
PromoterRegDiaryNumber_ID, PromoterRegDiaryNumber_Name, PromoterRegDiaryNumber_NameYear, PromoterRegDiaryNumber_IndexID, CreatedOn    
into v_PromoterRegDiaryNumber_ID, v_PromoterRegDiaryNumber_Name, v_PromoterRegDiaryNumber_NameYear, v_PromoterRegDiaryNumber_tbl_IndexID, v_PromoterRegDiaryNumber_CreatedDate
from tbl_rera_promoter_regdiarynumber where Promoter_ID=p_Promoter_ID and IsActive=1 limit 1;

-- Promoter Info
select
Flag, WebLink_Promoter_website, First_Name
into v_PromoterType, v_PromoterWebLink, v_PromoterAuthSignFormB
from rera_tbl_promoter where Application_id=p_Promoter_ID and IsActive=1 limit 1;

-- Project Quarterly Diary Number Info
select
Project_QuaterRegDiaryNumber_ID, Quater, `Year`, Project_QuaterRegDiaryNumber_IndexID, CreatedOn
into v_ProjectQuarterlyRegDiaryNumber_ID, v_ProjectQuarterly_QuarterName, v_ProjectQuarterly_QuarterYear, v_ProjectQuarterlyRegDiaryNumber_tbl_IndexID, v_ProjectQuarterly_CreatedDate
from tbl_rera_project_quater_regdiarynumber where Project_ID=p_Project_ID 
and Promoter_ID=p_Promoter_ID and Quater like 'Registration Process' and IsActive=1 limit 1;



select
  0 as Project_RERAnumber_DiaryNumber_IndexID,
  0 as Project_RERAnumber_DiaryNumber_ID,
  
  b.Project_RegDiaryNumber_ID as ProjectRegDiaryNumber_ID,
  b.PromoterRegDiaryNumber_Name as ProjectRegDiaryNumber_Name,
  b.PromoterRegDiaryNumber_NameYear as ProjectRegDiaryNumber_NameYear,
  b.Project_RegDiaryNumber_IndexID as ProjectRegDiaryNumber_tbl_IndexID,
  b.CreatedOn as ProjectRegDiaryNumber_CreatedDate,
  
  b.Promoter_ID as Promoter_ID,
  b.Project_ID as Project_ID,
  b.UserID as User_ID,
  
  v_PromoterRegDiaryNumber_ID as PromoterRegDiaryNumber_ID,
  v_PromoterRegDiaryNumber_Name as PromoterRegDiaryNumber_Name,
  v_PromoterRegDiaryNumber_NameYear as PromoterRegDiaryNumber_NameYear,
  v_PromoterRegDiaryNumber_tbl_IndexID as PromoterRegDiaryNumber_tbl_IndexID,
  v_PromoterRegDiaryNumber_CreatedDate as PromoterRegDiaryNumber_CreatedDate,
  
  v_ProjectQuarterlyRegDiaryNumber_ID as ProjectQuarterlyRegDiaryNumber_ID,
  v_ProjectQuarterly_QuarterName as ProjectQuarterly_QuarterName,
  v_ProjectQuarterly_QuarterYear as ProjectQuarterly_QuarterYear,
  v_ProjectQuarterlyRegDiaryNumber_tbl_IndexID as ProjectQuarterlyRegDiaryNumber_tbl_IndexID,
  v_ProjectQuarterly_CreatedDate as ProjectQuarterly_CreatedDate,
  
  a.IsAlready_RERANumber as IsAlreadyRegistration,
  a.Existing_RERANumber as ExistingRegistration,
  
  v_PromoterType as PromoterType,
  udfn_GetPromoterName(b.Promoter_ID) as PromoterName,
  v_PromoterWebLink as PromoterWebLink,
  v_PromoterAuthSignFormB as PromoterAuthSignFormB,
  
  a.Project_Name as ProjectName,
  a.Project_AddressLine1 as ProjectAddressLine1,
  a.Project_AddressLine2 as ProjectAddressLine2,
  a.Project_AddressDistrictCode as ProjectAddressDistrict,
  a.Project_AddressStateCode as ProjectAddressState,
  a.Project_AddressSubDivisionCode as ProjectAddressSubDivision,
  a.Project_AddressPIN as ProjectAddressPIN,
  a.Project_PotentialZoneCode as ProjectPotentialZone,
  a.ProjectWebsite_WebLink as ProjectWebLink,
  
  Concat(Cast(a.AuthorizedPerson_FirstName as char(150)) , SPACE(1) , Cast(a.AuthorizedPerson_MiddleName as char(150))) as AuthorizedPerson_FirstName,
  a.AuthorizedPerson_LastName as AuthorizedPerson_LastName,
  a.AuthorizedPerson_AddressLine1 as AuthorizedPerson_AddressLine1,
  a.AuthorizedPerson_AddressLine2 as AuthorizedPerson_AddressLine2,
  a.AuthorizedPerson_AddressDistrictCode as AuthorizedPerson_District,
  a.AuthorizedPerson_AddressStateCode as AuthorizedPerson_State,
  a.AuthorizedPerson_AddressPIN as AuthorizedPerson_PIN,
  a.AuthorizedPerson_EmailAddress as AuthorizedPerson_Email,
  a.AuthorizedPerson_MobileNumber as AuthorizedPerson_Mobile,
  
  '' as RERAnumberRegistration,
  CURDATE() as RERAnumberIssueDate,
  CURDATE() as RERAnumberRegUptoDate,
  
  '' as RemarksIfAny,
  '' as Extra1,
  '' as Extra2,
  '' as Extra3,
  '' as Extra4,
  
  0 as IsActive,
  0 as IsDraft,
  0 as IsDraftHelpDesk,
  0 as IsDraftEvaluation,
  0 as IsDraftSecMember,
  0 as IsDraftMember,
  1 as IsPublicView,
  0 as IsCertificateIssued,
  0 as IsExtensionIssued,
  0 as IsWithdrawn,
  
  b.CreatedBy as CreatedBy,
  b.CreatedOn as CreatedOn,
  b.ModifyBy as ModifyBy,
  b.ModifyOn as ModifyOn
  
from tbl_rera_project_registration a, tbl_rera_project_regdiarynumber b
where a.ProjectRegistration_ID=b.Project_ID
and a.Promoter_ID=b.Promoter_ID
and a.IsActive=1 and b.IsActive=1 
and b.Project_ID=p_Project_ID;
 
end if; 
       
end ;;
