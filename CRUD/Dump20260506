CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Promoter_Count_RegDiaryNumber`( 
 p_Application_id bigint
 )
begin 
-- -----------------
declare v_mainCount int;

declare v_profie varchar(10);
declare v_othermemdetail varchar(10);
declare v_documentupload varchar(10);
declare v_LitigationDetails varchar(10);
declare v_TrackRecordDetails varchar(10);
declare v_ParentEntityDetails varchar(10);
declare v_JointPromoter varchar(10);
declare v_YesNo_registrationProjectLitigations varchar(10);

declare v_getprofieCount int;
declare v_getothermemdetailCount int;
declare v_getdocumentuploadCount int;
declare v_getTrackRecordCount int;
declare v_getLititgationCount int;
declare v_getParentEntityCount int; 
declare v_getJointPromoterCount int;
declare v_getJointPromoterProfileCount int;


declare v_getProfileType int; 
declare v_getTrackRecordType int;
declare v_getParentEntityType int; 

set v_getProfileType=0;
set v_mainCount=0;
set v_profie='N';
set v_othermemdetail='N';
set v_documentupload='N';
set v_TrackRecordDetails='N';
set v_LitigationDetails='N';
set v_ParentEntityDetails='N';
set v_JointPromoter='N';
-- --------------------
       
select COUNT(*) into v_getprofieCount from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getothermemdetailCount from Tbl_Rera_Promoter_OtherMemberDetails where Application_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getdocumentuploadCount from tbl_RERA_Promoter_Documents where Promoter_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getTrackRecordCount from tbl_RERA_Promoter_Experience_Completed_OnGoing where Application_ID=p_Application_id and IsActive=1 and Flag in (1,5,6);
select COUNT(*) into v_getLititgationCount from tbl_RERA_Promoter_Litigations where Promoter_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);
select COUNT(*) into v_getParentEntityCount from Tbl_Rera_Promoter_ParentEntity where Application_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6);

select COUNT(*) into v_getJointPromoterCount from tbl_rera_copromoter_regdiarynumber where LinkTo_Related_Promoter_ID=p_Application_id and IsActive=1 and IsDraft in (1,5,6) and IsLock=1;


if v_getprofieCount<>0
then
 set v_profie='Y'; 
	
    select flag, CASE WHEN Org_Reg_Certificate='Y' THEN 'Y' ELSE 'N' END as Org_Reg_Certificate 
    into v_getProfileType, v_JointPromoter
    from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1;
 
	select 
	CASE  
	  WHEN Experience IS NULL THEN '0' 
	  WHEN Experience='N' THEN '0'  
	  WHEN Experience='No' THEN '0'
	  WHEN Experience='Yes' THEN '1'
	  WHEN Experience='Y' THEN '1' 
	  ELSE Experience 
	END into v_getTrackRecordType 
	from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1;
	
	select 
	CASE  
	  WHEN Org_Parent_Entity IS NULL THEN '0' 
	  WHEN Org_Parent_Entity='N' THEN '0'  
	  WHEN Org_Parent_Entity='No' THEN '0'
	  WHEN Org_Parent_Entity='Yes' THEN '1'
	  WHEN Org_Parent_Entity='Y' THEN '1' 
	  ELSE Org_Parent_Entity 
	END into v_getParentEntityType 
	from Rera_Tbl_Promoter where Application_ID=p_Application_id and IsActive=1;
end if;
if v_getothermemdetailCount<>0
then
 set v_othermemdetail='Y'; 
end if;

if v_getdocumentuploadCount<>0
then 
	if v_getProfileType=1
	then
		-- IND
		if v_getdocumentuploadCount>3
		then
			set v_documentupload='Y';
		end if;
	end if;

	if v_getProfileType=2
	then
		-- OTHER THAN IND
		if v_getdocumentuploadCount>4
		then
			set v_documentupload='Y';
		end if;
	end if;
end if;

if v_getTrackRecordCount<>0
then
 set v_TrackRecordDetails='Y'; 
 select LitgToProject into v_YesNo_registrationProjectLitigations from tbl_RERA_Promoter_Experience_Completed_OnGoing where Application_ID=p_Application_id and IsActive=1 and LitgToProject='N' limit 1;
end if;
if v_getLititgationCount<>0
then
 set v_LitigationDetails='Y'; 
else
	if v_YesNo_registrationProjectLitigations='N'
	then
		set v_LitigationDetails='Y';
	end if;
end if;
if v_getParentEntityCount<>0
then
 set v_ParentEntityDetails='Y'; 
end if;


if v_getProfileType=1
then
-- IND
if v_getTrackRecordType=1
then
	-- HAS EXP AND LITIGATIONS
	if v_profie='Y' AND v_documentupload='Y' AND v_TrackRecordDetails='Y' AND v_LitigationDetails='Y'
	then
		set  v_mainCount=1;
	-- HAS EXP   AND   NO LITIGATIONS
	elseif v_profie='Y' AND v_documentupload='Y' AND v_TrackRecordDetails='Y' AND v_LitigationDetails='N'
	then
		set  v_mainCount=1;
	end if;
	
else
	-- NO  EXP   AND NO  LITIGATIONS
	if v_profie='Y' AND v_documentupload='Y'
	then
		set  v_mainCount=1;
	end if;
end if;
end if;


if v_getProfileType=2
then
-- OTHER THAN IND
if v_getTrackRecordType=1
then
	-- HAS EXP AND LITIGATIONS
	if v_getParentEntityType=1
	then
		-- HAS PARENT ENTITY
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y' AND v_TrackRecordDetails='Y' AND v_LitigationDetails='Y' AND v_ParentEntityDetails='Y'
		then
			set  v_mainCount=1;
		end if;
	else
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y' AND v_TrackRecordDetails='Y' AND v_LitigationDetails='Y'
		then
			set  v_mainCount=1;
		end if;
	end if;
else
	-- NOT EXP AND LITIGATIONS
	if v_getParentEntityType=1
	then
		-- HAS PARENT ENTITY
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y' AND v_ParentEntityDetails='Y'
		then
			set  v_mainCount=1;
		end if;
	else
		if v_profie='Y' AND v_othermemdetail='Y' AND v_documentupload='Y'
		then
			set  v_mainCount=1;
		end if;
	end if;
end if;

-- Joint-Promoter IF Any
if v_JointPromoter='Y' then
	if (v_getJointPromoterCount=0) then
		set v_mainCount=0;
    end if;
	
    if (v_getJointPromoterCount>0) then
		select count(*) into v_getJointPromoterProfileCount from tbl_rera_copromoter_registrationdetails where Related_Promoter_Application_ID=p_Application_id and IsActive=1;
		if (v_getJointPromoterProfileCount<>v_getJointPromoterCount) then
			set v_mainCount=0;
		end if;
    end if;
end if;



end if;









Select v_mainCount AS mainCount;

 
-- --select  COUNT(*) from Rera_Tbl_Promoter where Promoter_ID=5011 and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from Tbl_Rera_Promoter_OtherMemberDetails where Promoter_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Promoter_Documents where Promoter_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Promoter_Experience_Completed_OnGoing where Promoter_ID=@Application_ID and IsActive=1 and IsDraft=1
-- --select  COUNT(*) from tbl_RERA_Promoter_Litigations where Promoter_ID=@Application_ID and IsActive=1 and IsDraft=1
-- select  COUNT(*) from Tbl_Rera_Promoter_ParentEntity where Application_ID=@Application_ID and IsActive=1 and IsDraft=1

-- select  * from Rera_Tbl_Promoter where  Application_id=1085 and IsActive=1 and IsDraft=1

-- select  * from Rera_Tbl_Promoter where Org_Name= 'AMERICA' and Created_By=  'userpromoter' and IsActive=1 and IsDraft=1

-- select * from Tbl_Rera_Promoter_OtherMemberDetails where Application_ID=1085 and    IsActive=1 and IsDraft=1
-- select  * from tbl_RERA_Promoter_Documents where  Promoter_ID= 1085 and IsActive=1 and IsDraft=1
-- select  * from tbl_RERA_Promoter_Experience_Completed_OnGoing where  Application_ID=1085 and IsActive=1 and Flag=1
-- select  * from tbl_RERA_Promoter_Litigations where Promoter_ID= 1085 and IsActive=1 and IsDraft=1
-- select  * from Tbl_Rera_Promoter_ParentEntity where Application_ID=1085 and IsActive=1 and IsDraft=1

end ;;
