	and IsActive=1 and IsDraft in (1,5,6) and IsLock=1
    order by RenewalAgent_IndexID desc 
    Limit 1;
end if;


if v_getothermemdetailCount<>0 then
	set v_othermemdetail='Y'; 
end if;
if v_getdocumentuploadCount<>0 then
	set v_documentupload='Y'; 
end if;
if v_getOtherStateUTRERACount<>0 then
