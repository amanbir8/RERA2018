CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthorityDesk_AgentRenewalDueDetails`(    
  p_UserRole varchar(50),
  p_Fromdate datetime(3),
  p_Todate datetime(3),
  p_SearchTypeFlag varchar(50),
  p_SearchRangeFlag varchar(50),
  p_EventMonth int,
  p_EventYear int
)
begin  


-- fun (Set Default YY/MM when Greater Parms)
if (p_SearchTypeFlag='1') then
-- DUE or PENDING cases       
	if (p_SearchRangeFlag='1') then
	-- FromDate/ToDate
		if (p_Todate > now()) then
			-- '0001-01-01 00:00:00.000';
			set p_Todate=now();
		end if;
	else
	-- Month/Year
		if (p_EventYear >= YEAR(now())) then
			set p_EventYear=YEAR(now());
			
			if (p_EventMonth > MONTH(now())) then
				set p_EventMonth=0;
			end if;
		end if;		
	end if;
else
-- Upcoming 3M cases
    if (p_SearchRangeFlag='1') then
	-- FromDate/ToDate
		if (p_Todate < now()) then
			set p_Todate=now();
		end if;	
	end if;
end if;

-- Return Result
Select

'' as Agent_DiaryNumber,
'2017-05-23 00:00:00.000' as Agent_Diary_ApplicationDate,
0 as Agent_ID,
'' as Agent_TypeSTR,
'' as Agent_Organization_Name,
1 as Agent_Type,
'' as Agent_RERA_No,
'2017-05-23 00:00:00.000' as Agent_RERA_IssueDate,
'2017-05-23 00:00:00.000' as Agent_RERA_ValidDate,

'' as P_AddressLine1,
'' as P_AddressLine2,
'' as P_AddressStateCode,
'' as P_AddressDistrictCode,
'' as P_AddressPIN,

'' as RegOffice_AddressLine1,
'' as RegOffice_AddressLine2,
'' as RegOffice_AddressStateCode,
'' as RegOffice_AddressDistrictCode,
'' as RegOffice_AddressPIN,

'' as BusinessPlace_AddressLine1,
'' as BusinessPlace_AddressLine2,
'' as BusinessPlace_AddressStateCode,
'' as BusinessPlace_AddressDistrictCode,
'' as BusinessPlace_AddressPIN,

'' as BComm_AddressLine1,
'' as BComm_AddressLine2,
'' as BComm_AddressStateCode,
'' as BComm_AddressDistrictCode,
'' as BComm_AddressPIN,

'' as AuthorizedSignatory_Name,
'' as AuthorizedSignatory_MiddleName,
'' as AuthorizedSignatory_LastName,
0 as MobileNumber,
'' as EmailAddress,

1 as Merge_Mode,
'' as CreatedBy,
'2017-05-23 00:00:00.000' as CreatedOn,
'' as ModifyBy,
'2017-05-23 00:00:00.000' as ModifyOn,

'' as Application_SearchTypeFlag,
'' as Application_SearchRangeFlag,
'2017-05-23 00:00:00.000' as Application_FromDate,
'2017-05-23 00:00:00.000' as Application_ToDate,
