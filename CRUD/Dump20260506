CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formn_bifurcation_addcomplainant`(
	p_ComplaintFormN_ID bigint,
	p_ComplaintFormN_DiaryNumber varchar(50),
	p_ComplaintType_MN varchar(50),
    p_BifurcateFormN_ID bigint,
    p_BifurcateType_MN varchar(50),
	p_Flag int,
    p_UserName varchar(50),
    out p_valoutput bigint
)
BEGIN
	DECLARE flag_bifurcate_IsError INTEGER DEFAULT 0;
    DECLARE flag_set_tempbifurcate INTEGER DEFAULT 0;
    DECLARE flag_count_tempbifurcate INTEGER DEFAULT 0;
    DECLARE flag_bifurcate_retvalue varchar(50) DEFAULT 'False';
    DECLARE v_ret_bifurcatevalue bigint DEFAULT 0;
    
    
DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;


SELECT count(*) INTO flag_count_tempbifurcate FROM tbl_rera_complaint_formn_additioncomplainant_temp_bifurcation 
WHERE ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID AND IsDraft=1 AND IsActive=1;
IF (flag_count_tempbifurcate <> 0) THEN
	-- Empty Temp_Records
	delete from tbl_rera_complaint_formn_additioncomplainant_temp_bifurcation 
    where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and ComplainantorApplicant_IndexID<>0;

	SET flag_set_tempbifurcate = 101;
ELSE
	SET flag_set_tempbifurcate = 101;
END IF;

IF (flag_set_tempbifurcate = 101) THEN
	-- Insert Temp_Records for Bifurcation
 	Insert into tbl_rera_complaint_formn_additioncomplainant_temp_bifurcation select * from tbl_rera_complaint_formn_additioncomplainant 
    where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsDraft=1 and IsActive=1;
    
    -- Bifurcate function call for additional complainant
    select udfn_insert_formn_bifurcation_additioncomplainant(ComplainantorApplicant_IndexID, ComplainantorApplicant_ID, p_ComplaintFormN_ID, p_ComplaintType_MN, p_BifurcateFormN_ID, p_UserName) -- into flag_bifurcate_retvalue 
    from tbl_rera_complaint_formn_additioncomplainant_temp_bifurcation where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsDraft=1 and IsActive=1;

	-- Empty Temp_Records
	delete from tbl_rera_complaint_formn_additioncomplainant_temp_bifurcation 
    where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and ComplainantorApplicant_IndexID<>0;    
    
    SET v_ret_bifurcatevalue = 1;
ELSE
 	SET v_ret_bifurcatevalue = 0;
END IF;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

SET p_valoutput = v_ret_bifurcatevalue;

END ;;
DELIMITER ;
