	'0001-01-01 00:00:00.000' as Related_RERAnumberRegUptoDate,

	0 as RelatedAgentDiaryNumber_ID,
	'' as RelatedAgentDiaryNumber_Name,
	'' as RelatedAgentDiaryNumber_NameYear,

	n.RenewalAgentDiaryNumber_ID as RelatedRenewalAgentRegDiaryNumber_ID,
	n.RenewalAgentDiaryNumber_Name as RelatedRenewalAgentRegDiaryNumber_Name,
	n.RenewalAgentDiaryNumber_NameYear as RelatedRenewalAgentRegDiaryNumber_NameYear,

	n.UserID as UserID,

	n.othermemdetailCount as OtherMemDetailsCount,
	n.documentuploadCount as DocumentuploadsCount,
	n.UTOtherStateRERACount as UTotherStateRERACount,
	n.PaymentCount as PaymentsCount,
	n.AgentDocumentCount as AgentDocumentCount,

	n.CurrentEventcode as CurrentEventcode,
	n.EventCodeDetails_indexID as EventCodeDetails_indexID,
	n.RenewalAgentDiaryNumber_IndexID as tbl_RegDiaryNumber_indexID,

	0 as ReferenceProject_ID,
	'' as ReferenceProject_Name,
	0 as ReferencePromoter_ID,
	'' as ReferencePromoter_Name,

	m.IsAlready_RERANumber as IsAlreadyRegistration,
	m.Existing_RERANumber as ExistingRegistration,
	m.Agent_Type as Agent_Type,
	Concat(m.Agent_FirstName, space(1), m.Agent_MiddleName) as Agent_FirstName,
	m.Agent_LastName as Agent_LastName,
	m.Organization_Name as Organization_Name,

	m.BusinessPlace_AddressLine1 as BComm_AddressLine1,
	m.BusinessPlace_AddressLine2 as BComm_AddressLine2,
	m.BusinessPlace_AddressStateCode as BComm_AddressStateCode,
	m.BusinessPlace_AddressDistrictCode as BComm_AddressDistrictCode,
	m.BusinessPlace_AddressPIN as BComm_AddressPIN,
	'' as BComm_AddressStateName, 
	'' as BComm_AddressDistrictName,

	m.EmailAddress as EmailAddress,
	m.MobileNumber as MobileNumber,

	CASE
		WHEN m.Agent_Type=1 THEN Concat(m.Agent_FirstName, space(1), m.Agent_MiddleName)
		WHEN m.Agent_Type=2 THEN Concat(m.AuthorizedSignatory_FirstName, space(1), m.AuthorizedSignatory_MiddleName)
		ELSE 'NA'
	END as AuthorizedSignatory_FirstName,
	CASE
		WHEN m.Agent_Type=1 THEN m.Agent_LastName
		WHEN m.Agent_Type=2 THEN m.AuthorizedSignatory_LastName
		ELSE 'NA'
