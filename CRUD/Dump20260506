	set v_PutAgentStateTypeCode='OTH';
 end if;
 
 -- B
 IF (p_Extra2<>v_GetSequenceCode)
 then
	set p_Extra2=v_GetSequenceCode;
	set p_Extra3=v_PutAgentStateTypeCode;
	set p_Extra4='NRL';
 end if; 
 IF (p_Extra3<>v_PutAgentStateTypeCode)
 then
	set p_Extra2=v_GetSequenceCode;
	set p_Extra3=v_PutAgentStateTypeCode;
	set p_Extra4='NRL';
