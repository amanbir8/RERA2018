	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
	where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
	and a.Project_ID=c.Related_Project_ID and c.IsActive=1 and a.IsActive=1 
	and c.EventAction_Type in (110020, 110023)
	and c.Related_Project_ID=p_RegPrj_ProjectRegistration_ID


	UNION
		  
	-- Project Extension Approval Display
	select 
	0 as ProjectRegistrationActionOne_ID,
	'NA' as ProjectRegistrationActionTwo_ID,
	m.Related_Promoter_ID as Related_Promoter_ID,
	m.Related_Project_ID as Related_Project_ID,

	'NA' as PromoterName,
	'NA' as ProjectName,
	'NA' as Promoter_DiaryNumber,
	'NA' as Project_DiaryNumber,
	Now() as Project_ApplicationDate,
	Now() as ProjectLastModifiedOn,
