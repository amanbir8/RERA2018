CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_MIS_ProjectFileChecklistRecordsDetails_ExtnProjects`(  
	p_UserRole varchar(50),
    p_ApplicationCategoryFlag int,
    p_ActionDateTypeFlag int,
    p_InputEntry_FromDate datetime(3),
    p_InputEntry_ToDate  datetime(3),
	p_RangeInputFlag int,
    p_InputEntry_Month int,
    p_InputEntry_Year int
)
begin


DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

if (p_ActionDateTypeFlag = 91) then
-- Date Range Option (Application Date OR InComplete Date)
	if (p_RangeInputFlag = 1) then
	-- FromDate and ToDate
		if (p_ApplicationCategoryFlag = 21) then 
		-- Copy of Approved Layout Plan
			Select 
			QP.Project_RegDiaryNumber_IndexID, 
			QP.PromoterRegDiaryNumber_Name,
			QP.PromoterRegDiaryNumber_NameYear,
			QP.UserID,
			QP.Project_ID as Related_Project_ID,
			QP.Promoter_ID as Related_Promoter_ID,       
			QP.IsActive,
			QP.IsDraft,
			QP.IsDraftHelpDesk,
			QP.IsDraftEvaluation,
			QP.IsDraftSecMember,
			QP.IsDraftMember,
			QP.CreatedBy,
			'0001-01-01 00:00:00' as CreatedOn,
			QP.CreatedBy as ModifyBy,
			QP.ModifyOn, 
			QP.EventAction_Type,
			QP.EventAction_IdentifiedOn,
			QP.EventAction_Aggregate,
			DATEDIFF(Now(), QP.EventAction_IdentifiedOn) as EventAction_NoReplybyPromoter_Days,
			QP.Application_Date,
			udfn_GetPromoterName(QP.Promoter_ID) as Promoter_Name,
			QM.Project_Name,
			CASE
				WHEN QM.Project_Status = 'Complete' THEN 'New Project'
				WHEN QM.Project_Status = 'On-going' THEN 'On-going'
				ELSE 'Other'
			END as Project_Status,
			QM.ProjectStart_Date,
			QM.ProjectCompletion_ProposedDate,
			QM.ProjectCompletion_OriginalDate,
			QM.Project_AddressStateCode,
			QM.Project_AddressDistrictCode,
			QM.Project_AddressSubDivisionCode,
			'0' as varLandTitleSearchReport,
			'0' as varLatestCopyJamabandiCertificate,
			'0' as varLandEncumbrancesNECertificate,
			'0' as varCLUCertificate,
			'0' as varLicenseDevelopSocietyColonyFromCompetentAuthority,
			'0' as varRegistrationAsPromoter,
			'0' as varFinanceYesNo,
			udfn_GetProjectApprovedLayoutPlanDetails(QP.Project_ID, QP.Promoter_ID) as VariableValue,
			'0' as PercentageValue,
			QP.RERAnumberRegistration as RERAregistrationnumber,
			QP.RERAnumberIssueDate as Registration_IssueDate,
			QP.RERAnumberRegUptoDate as Registration_UptoDate,
			'' as A_column,
			0 as B_column,
			Now() as C_column,
			Now() as D_column,
			0 as IsApplicationTypeFlag,
			0 as IsApplicationStatisticsCategory,
			Now() as InputEntry_FromDate,
			Now() as InputEntry_ToDate,
			0 as IsRangeValueDateInputFlag,
			0 as EventMonth,
			0 as EventYear
			from
			(
			Select 
