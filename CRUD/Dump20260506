		end if;
        if (varSTRald = 'YALD')
		then
			set pSTRald=' Allotment Letter,';
		end if;
        if (varSTRloi = 'YLOI')
		then
			set pSTRloi=' LOI,';
		end if;
        
        set v_returnstatusstring=CONCAT(v_returnstatusstring, pSTRclu, pSTRltdc, pSTRregcert, pSTRats, pSTRald, pSTRloi, ' and other enclosures in support of the complaint.');

	end if;
else
	set v_putprojectstatus='unregisteredproject';
    set v_returnstatusstring='';
end if;

 
Select v_putprojectstatus as ComplaintProjectStatus,
v_returnstatusstring as ComplaintDocumentTrack,
'' as ColumnA;
 
end ;;
