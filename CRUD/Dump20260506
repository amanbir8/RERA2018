CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AdminDesk_NoticeFiveNine_HearingDetails`(  
	p_FlagID bigint,
    p_KeyID varchar(150),
    p_UserID varchar(150)
)
begin
   
	SELECT 
	`BenchHearingDate_IndexID`,
	`BenchHearingDate_ID`,
	`Related_ComplaintNoticesSectionFiveNine_ID`,
	`Related_ComplaintNoticesSectionFiveNine_Code`,
	`TypeOfComplaint`,
	`TypeOfHearing`,
	`TypeOfComplaintHearing`,
	`Bench_HearingDate`,
     CASE
		WHEN Bench_HearingTime is null THEN 'NA'
        WHEN Bench_HearingTime='00:00' THEN 'NA'
        WHEN Bench_HearingTime='0' THEN 'NA'
        WHEN Bench_HearingTime='' THEN 'NA'
		ELSE Bench_HearingTime
	 END as `Bench_HearingTime`,
	`HearingBench_ID`,
	`HearingBench_Name`,
	`HearingBench_FixedFor_ID`,
	`HearingBench_FixedFor_Name`,
	`HearingReplyDays`,
	`HearingBench_BussinesOnDate_ProceedingDate`,
	`HearingStatus`,
	`Remarks_IfAny`,
	`A_column`,
	`B_column`,
	`C_column`,
	 CASE
		WHEN D_column is null THEN '0001-01-01 00:00:00.000'
		ELSE D_column
	 END as `D_column`,
	`E_column`,
	`IsActive`,
	`IsDraft`,
	`IsLock`,
	`IsPublicView`,
	`CreatedBy`,
	`CreatedOn`,
	`ModifyBy`,
	`ModifyOn`
	FROM tbl_rera_complaint_sectionfivenine_prehearingdate 
	WHERE Related_ComplaintNoticesSectionFiveNine_ID=p_FlagID
    AND IsActive in (1,2)
    AND IsDraft=1
    AND IsLock=1
	ORDER BY BenchHearingDate_IndexID DESC;

end ;;
