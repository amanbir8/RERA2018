where Related_ComplaintorApplication_ID=p_ComplainantApplicant_RelatedComplaint_ID
and EventAction_Type=440063
and IsActive=1;

-- set v_checkExistingEventCount=1;
  
if v_checkExistingEventCount>0
then
  -- -----------------------
  update tbl_rera_complaint_formn_eventaction set IsActive=2 
  where Related_ComplaintorApplication_ID=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1;
  
  
  INSERT INTO tbl_rera_complaint_formn_eventaction  
    (
	  -- ComplaintFormN_EventAction_ID,
	  EventAction_Type,
	  EventAction_IdentifiedBy,
	  EventAction_IdentifiedOn,
	  Related_ComplaintorApplication_ID,
	  Related_RegDiaryNumber,
