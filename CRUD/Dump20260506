CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Agent_PrevRegistrationRecord_IndOTIProfile_ForDesk`(  
  p_Agent_ID bigint,
  p_AgentType_ID int,
  p_RenewalAgent_ID bigint,
  p_RenewalAgent_SequenceID int,
  p_RenewalAgent_YearID int,
  p_Agent_FlagCode varchar(20),
  p_UserRole varchar(120)
)
BEGIN 

IF (p_Agent_FlagCode='122') THEN
--  //122// Agent Renewal Case (Online)

	SELECT
	m.RenewalAgent_IndexID as RenewalAgent_IndexID,
	m.RenewalAgent_ID as RenewalAgent_ID,
	m.RenewalOrderSequence as RenewalOrderSequence,
	m.RelatedRenewalAgent_Year as RelatedRenewalAgent_Year,
	m.Related_Agent_ID as Related_Agent_ID,
	m.Related_AgentDiaryNumber_Name as Related_AgentDiaryNumber_Name,
	m.Related_Agent_Type as Related_Agent_Type,
	m.Related_UserID as Related_UserID,
    n.RERAnumberRegistration as Related_RERAnumberRegistration,
	n.RERAnumberIssueDate as Related_RERAnumberIssueDate,
	n.RERAnumberRegUptoDate as Related_RERAnumberRegUptoDate,
	
	p_Agent_FlagCode as Agent_Format_CODE,
	
	-- Ref Registration
	m.Related_RERAnumberRegistration as RERAregistration_Number,
	udfn_GetAgent_RERA_RegistrationIssueDate(m.Related_Agent_ID, m.RenewalAgent_ID, 0) as RERAregistration_IssueDate,
	udfn_GetAgent_RERA_RegistrationValidUptoDate(m.Related_Agent_ID, m.RenewalAgent_ID, 0) as RERAregistration_ExpiryDate,
	
	m.Related_AgentDiaryNumber_Name as Agent_Reference_DiaryNumber,
	'0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
	udfn_GetAgentNameByRenewal(m.Related_Agent_ID, m.RenewalAgent_ID) as Agent_Name,
	CASE when m.Related_Agent_Type=2 then 'Other Than Individual' else 'Individual' END as Agent_Type,
	
	-- Agent Information
	m.Mode_RegistrationNumber as Mode_RegistrationNumber,

	-- IND CASE
	m.Agent_FirstName,
	m.Agent_MiddleName,
	m.Agent_LastName,
	m.Father_FirstName,
	m.Father_MiddleName,
	m.Father_LastName,
	m.PAN_Number as Individual_PAN_Number,
	m.Aadhaar_Number as Individual_Aadhaar_Number,

	-- OTI CASE
	m.Organization_Name as Organization_Name,
	m.Organization_TypeCode as Organization_TypeCode,
	m.Organization_PAN_Number as Organization_PAN_Number,
	
	-- IND-Permanent Address OR OTI-Regd Address
	CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressLine1 else m.P_AddressLine1 end as RegOfficeOrPermanent_AddressLine1,
	CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressLine2 else m.P_AddressLine2 end as RegOfficeOrPermanent_AddressLine2,
	CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressStateCode else m.P_AddressStateCode end as RegOfficeOrPermanent_AddressStateCode,
	CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressDistrictCode else m.P_AddressDistrictCode end as RegOfficeOrPermanent_AddressDistrictCode,
	CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressPIN else m.P_AddressPIN end as RegOfficeOrPermanent_AddressPIN,
		
	-- Place of Bussiness Address
	m.BusinessPlace_AddressLine1,
	m.BusinessPlace_AddressLine2,
	m.BusinessPlace_AddressStateCode,
	m.BusinessPlace_AddressDistrictCode,
	m.BusinessPlace_AddressPIN,
	m.BusinessPlace_AddressSubDivisionCode as BusinessPlace_AddressSubDivisionName,
	
	-- Official Address OR Communication Address
	m.BComm_AddressLine1,
	m.BComm_AddressLine2,
	m.BComm_AddressStateCode,
	m.BComm_AddressDistrictCode,
	m.BComm_AddressPIN,
	
	-- OTI-Authorized Person    
	m.AuthorizedSignatory_FirstName,
	m.AuthorizedSignatory_MiddleName,
	m.AuthorizedSignatory_LastName,    
	m.PAN_Number,
	m.Aadhaar_Number,
	
	-- IND-agent-detail or OTI-Authorized Person-detail    
	m.MobileNumber,
	m.PhoneNumber_STD,
	m.PhoneNumber_Number,
	m.EmailAddress,
	
	-- OTHER	
	m.IsOtherOrganizationMembers,
	m.IsOtherStateUT_RERAregistration,

	m.IsActive,
	m.IsActiveProvider,
	m.IsDraft,
	m.IsLock,
	m.IsPublicView,
	m.IsConditional,

	m.CreatedOn,
	m.CreatedBy,
	m.ModifyOn,
	m.ModifyBy,
	
	-- Extra
	m.A_Column,
	m.B_Column,
	m.C_Column,    
	
	'' as BusinessPlace_AddressSubDivision,
	'' as P_AddressState,
	'' as P_AddressDist,
	'' as BusinessPlace_AddressState,
	'' as BusinessPlace_AddressDistrict,
	'' as BComm_AddressState,
	'' as BComm_AddressDistrict,
	'' as RegOffice_AddressState,
	'' as RegOffice_AddressDistrict

	FROM tbl_rera_agent_renewal_profile m, tbl_rera_ldr_agent_reranumber_diarynumber n
	WHERE m.Related_Agent_ID=n.Agent_ID
    and m.Related_Agent_Type=n.Agent_Type
    and m.Related_Agent_ID=p_Agent_ID
	and m.Related_Agent_Type=p_AgentType_ID
	and m.RenewalAgent_ID=p_RenewalAgent_ID
	and m.RenewalOrderSequence=p_RenewalAgent_SequenceID
	and m.RelatedRenewalAgent_Year=p_RenewalAgent_YearID
	and m.IsActive=1 and n.IsActive=1
	and m.IsDraft in (1,4,5,6)
	and m.IsLock in (0,1)
	Limit 1;

ELSE
	IF (p_Agent_FlagCode='111') THEN
	--  //111// Agent Renewal Case (Offline)

		SELECT
		m.RenewalAgent_IndexID as RenewalAgent_IndexID,
		m.RenewalAgent_ID as RenewalAgent_ID,
		m.RenewalOrderSequence as RenewalOrderSequence,
		m.RelatedRenewalAgent_Year as RelatedRenewalAgent_Year,
		m.Related_Agent_ID as Related_Agent_ID,
		m.Related_AgentDiaryNumber_Name as Related_AgentDiaryNumber_Name,
		m.Related_Agent_Type as Related_Agent_Type,
		m.Related_UserID as Related_UserID,
		n.OfflineAgents_RERAregistrationNumber as Related_RERAnumberRegistration,
		n.OfflineAgents_RERAregistrationIssueDate as Related_RERAnumberIssueDate,
		n.OfflineAgents_RERAregistrationValidUptoDate as Related_RERAnumberRegUptoDate,
		
		p_Agent_FlagCode as Agent_Format_CODE,
		
		-- Ref Registration
		m.Related_RERAnumberRegistration as RERAregistration_Number,
		udfn_GetAgent_RERA_RegistrationIssueDate(m.Related_Agent_ID, m.RenewalAgent_ID, 0) as RERAregistration_IssueDate,
		udfn_GetAgent_RERA_RegistrationValidUptoDate(m.Related_Agent_ID, m.RenewalAgent_ID, 0) as RERAregistration_ExpiryDate,
		
		m.Related_AgentDiaryNumber_Name as Agent_Reference_DiaryNumber,
		'0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
		udfn_GetAgentNameByRenewal(m.Related_Agent_ID, m.RenewalAgent_ID) as Agent_Name,
		CASE when m.Related_Agent_Type=2 then 'Other Than Individual' else 'Individual' END as Agent_Type,
		
		-- Agent Information
		m.Mode_RegistrationNumber as Mode_RegistrationNumber,

		-- IND CASE
		m.Agent_FirstName,
		m.Agent_MiddleName,
		m.Agent_LastName,
		m.Father_FirstName,
		m.Father_MiddleName,
		m.Father_LastName,
		m.PAN_Number as Individual_PAN_Number,
		m.Aadhaar_Number as Individual_Aadhaar_Number,

		-- OTI CASE
		m.Organization_Name as Organization_Name,
		m.Organization_TypeCode as Organization_TypeCode,
		m.Organization_PAN_Number as Organization_PAN_Number,
		
		-- IND-Permanent Address OR OTI-Regd Address
		CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressLine1 else m.P_AddressLine1 end as RegOfficeOrPermanent_AddressLine1,
		CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressLine2 else m.P_AddressLine2 end as RegOfficeOrPermanent_AddressLine2,
		CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressStateCode else m.P_AddressStateCode end as RegOfficeOrPermanent_AddressStateCode,
		CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressDistrictCode else m.P_AddressDistrictCode end as RegOfficeOrPermanent_AddressDistrictCode,
		CASE when m.Related_Agent_Type=2 then m.RegOffice_AddressPIN else m.P_AddressPIN end as RegOfficeOrPermanent_AddressPIN,
			
		-- Place of Bussiness Address
		m.BusinessPlace_AddressLine1,
		m.BusinessPlace_AddressLine2,
		m.BusinessPlace_AddressStateCode,
		m.BusinessPlace_AddressDistrictCode,
		m.BusinessPlace_AddressPIN,
		m.BusinessPlace_AddressSubDivisionCode as BusinessPlace_AddressSubDivisionName,
		
		-- Official Address OR Communication Address
		m.BComm_AddressLine1,
		m.BComm_AddressLine2,
		m.BComm_AddressStateCode,
		m.BComm_AddressDistrictCode,
		m.BComm_AddressPIN,
		
		-- OTI-Authorized Person    
		m.AuthorizedSignatory_FirstName,
		m.AuthorizedSignatory_MiddleName,
		m.AuthorizedSignatory_LastName,    
		m.PAN_Number,
		m.Aadhaar_Number,
		
		-- IND-agent-detail or OTI-Authorized Person-detail    
		m.MobileNumber,
		m.PhoneNumber_STD,
		m.PhoneNumber_Number,
		m.EmailAddress,
		
		-- OTHER	
		m.IsOtherOrganizationMembers,
		m.IsOtherStateUT_RERAregistration,

		m.IsActive,
		m.IsActiveProvider,
		m.IsDraft,
		m.IsLock,
		m.IsPublicView,
		m.IsConditional,

		m.CreatedOn,
		m.CreatedBy,
		m.ModifyOn,
		m.ModifyBy,
		
		-- Extra
		m.A_Column,
		m.B_Column,
		m.C_Column,    
		
		'' as BusinessPlace_AddressSubDivision,
		'' as P_AddressState,
		'' as P_AddressDist,
		'' as BusinessPlace_AddressState,
		'' as BusinessPlace_AddressDistrict,
		'' as BComm_AddressState,
		'' as BComm_AddressDistrict,
		'' as RegOffice_AddressState,
		'' as RegOffice_AddressDistrict

		FROM tbl_rera_agent_renewal_profile m, tbl_rera_agent_offlineagents_pendinguploads n
		WHERE m.Related_Agent_ID=n.A_column
        and m.Related_Agent_ID=p_Agent_ID
		and m.Related_Agent_Type=p_AgentType_ID
		and m.RenewalAgent_ID=p_RenewalAgent_ID
		and m.RenewalOrderSequence=p_RenewalAgent_SequenceID
		and m.RelatedRenewalAgent_Year=p_RenewalAgent_YearID
		and m.IsActive=1 and n.IsActive=1
		and m.IsDraft in (1,4,5,6)
		and m.IsLock in (0,1)
		Limit 1;

	ELSE
		IF (p_Agent_FlagCode='102') THEN
		--  //102// Agent Case (Online)
		
			SELECT
			m.ID as RenewalAgent_IndexID,
			p_RenewalAgent_ID as RenewalAgent_ID,
			p_RenewalAgent_SequenceID as RenewalOrderSequence,
			p_RenewalAgent_YearID as RelatedRenewalAgent_Year,
			m.Agent_ID as Related_Agent_ID,
			n.AgentRegDiaryNumber_Name as Related_AgentDiaryNumber_Name,
			m.Agent_Type as Related_Agent_Type,
			m.A_column as Related_UserID,
			n.RERAnumberRegistration as Related_RERAnumberRegistration,
			n.RERAnumberIssueDate as Related_RERAnumberIssueDate,
			n.RERAnumberRegUptoDate as Related_RERAnumberRegUptoDate,
			
			'102' as Agent_Format_CODE,
			
			-- Ref Registration
			n.RERAnumberRegistration as RERAregistration_Number,
            udfn_GetAgent_RERA_RegistrationIssueDate(m.Agent_ID, 0, 0) as RERAregistration_IssueDate,
			udfn_GetAgent_RERA_RegistrationValidUptoDate(m.Agent_ID, 0, 0) as RERAregistration_ExpiryDate,
			
			n.AgentRegDiaryNumber_Name as Agent_Reference_DiaryNumber,
			'0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
			udfn_GetAgentName(m.Agent_ID) as Agent_Name,
			CASE when m.Agent_Type=2 then 'Other Than Individual' else 'Individual' END as Agent_Type,
			
			-- Agent Information
			'Online Mode' as Mode_RegistrationNumber,

			-- IND CASE
			IFNULL(m.Agent_FirstName, 'NA') as Agent_FirstName,
			IFNULL(m.Agent_MiddleName, 'NA') as Agent_MiddleName,
			IFNULL(m.Agent_LastName, 'NA') as Agent_LastName,
			IFNULL(m.Father_FirstName, 'NA') as Father_FirstName,
			IFNULL(m.Father_MiddleName, 'NA') as Father_MiddleName,
			IFNULL(m.Father_LastName, 'NA') as Father_LastName,
			CASE when m.Agent_Type=2 then m.Occupation else m.PAN_Number END as Individual_PAN_Number,
			CASE when m.Agent_Type=2 then '0' else m.Aadhaar_Number END as Individual_Aadhaar_Number,

			-- OTI CASE
			IFNULL(m.Organization_Name, 'NA') as Organization_Name,
			m.Organization_TypeCode as Organization_TypeCode,
			CASE when m.Agent_Type=2 then m.Occupation else m.PAN_Number END as Organization_PAN_Number,
			
			-- IND-Permanent Address OR OTI-Regd Address
			CASE when m.Agent_Type=2 then m.RegOffice_AddressLine1 else m.P_AddressLine1 end as RegOfficeOrPermanent_AddressLine1,
			CASE when m.Agent_Type=2 then m.RegOffice_AddressLine2 else m.P_AddressLine2 end as RegOfficeOrPermanent_AddressLine2,
			CASE when m.Agent_Type=2 then m.RegOffice_AddressStateCode else m.P_AddressStateCode end as RegOfficeOrPermanent_AddressStateCode,
			CASE when m.Agent_Type=2 then m.RegOffice_AddressDistrictCode else m.P_AddressDistrictCode end as RegOfficeOrPermanent_AddressDistrictCode,
			CASE when m.Agent_Type=2 then m.RegOffice_AddressPIN else m.P_AddressPIN end as RegOfficeOrPermanent_AddressPIN,
				
			-- Place of Bussiness Address
			m.BusinessPlace_AddressLine1,
			m.BusinessPlace_AddressLine2,
			m.BusinessPlace_AddressStateCode,
			m.BusinessPlace_AddressDistrictCode,
			m.BusinessPlace_AddressPIN,
			IFNULL(m.B_column, '0') as BusinessPlace_AddressSubDivisionName,
			
			-- Official Address OR Communication Address
			m.BComm_AddressLine1,
			m.BComm_AddressLine2,
			m.BComm_AddressStateCode,
			m.BComm_AddressDistrictCode,
			m.BComm_AddressPIN,
			
			-- OTI-Authorized Person    
			m.AuthorizedSignatory_FirstName,
			m.AuthorizedSignatory_MiddleName,
			m.AuthorizedSignatory_LastName,    
			m.PAN_Number,
			m.Aadhaar_Number,
			
			-- IND-agent-detail or OTI-Authorized Person-detail    
			m.MobileNumber,
			m.PhoneNumber_STD,
			m.PhoneNumber_Number,
			m.EmailAddress,
			
			-- OTHER	
			m.IsOtherOrganizationMembers,
			m.IsOtherStateUT_RERAregistration,

			m.IsActive,
			0 as IsActiveProvider,
			m.IsDraft,
			1 as IsLock,
			1 as IsPublicView,
			0 as IsConditional,

			m.CreatedOn,
			m.CreatedBy,
			m.ModifyOn,
			m.ModifyBy,
			
			-- Extra
			'' as A_Column,
			'' as B_Column,
			'' as C_Column,    
			
			'' as BusinessPlace_AddressSubDivision,
			'' as P_AddressState,
			'' as P_AddressDist,
			'' as BusinessPlace_AddressState,
			'' as BusinessPlace_AddressDistrict,
			'' as BComm_AddressState,
			'' as BComm_AddressDistrict,
			'' as RegOffice_AddressState,
			'' as RegOffice_AddressDistrict

			FROM Tbl_Rera_Agent_Profile m, tbl_rera_ldr_agent_reranumber_diarynumber n 
			WHERE m.Agent_ID=n.Agent_ID
			and m.Agent_ID=p_Agent_ID
			and m.Agent_Type=p_AgentType_ID
			and m.IsActive=1 and n.IsActive=1
			and m.IsDraft in (1,4,5,6)
			Limit 1;
		
		ELSE
		--  //101// Agent Case (Offline) 

			SELECT
			OfflineAgents_ID as RenewalAgent_IndexID,
			p_RenewalAgent_ID as RenewalAgent_ID,
			p_RenewalAgent_SequenceID as RenewalOrderSequence,
			p_RenewalAgent_YearID as RelatedRenewalAgent_Year,
			p_Agent_ID as Related_Agent_ID,
			'NA' as Related_AgentDiaryNumber_Name,
			p_AgentType_ID as Related_Agent_Type,
			'NA' as Related_UserID,
			OfflineAgents_RERAregistrationNumber as Related_RERAnumberRegistration,
			OfflineAgents_RERAregistrationIssueDate as Related_RERAnumberIssueDate,
			OfflineAgents_RERAregistrationValidUptoDate as Related_RERAnumberRegUptoDate,
			
			p_Agent_FlagCode as Agent_Format_CODE,
			
			-- Ref Registration
			OfflineAgents_RERAregistrationNumber as RERAregistration_Number,
			-- '0001-01-01 00:00:00.000' as RERAregistration_IssueDate,
			-- '0001-01-01 00:00:00.000' as RERAregistration_ExpiryDate,
            -- udfn_GetAgent_RERA_RegistrationIssueDate(p_Agent_ID, 0, 0) as RERAregistration_IssueDate,
			-- udfn_GetAgent_RERA_RegistrationValidUptoDate(p_Agent_ID, 0, 0) as RERAregistration_ExpiryDate,
			OfflineAgents_RERAregistrationIssueDate as RERAregistration_IssueDate,
			OfflineAgents_RERAregistrationValidUptoDate as RERAregistration_ExpiryDate,
			
			 CASE when OfflineAgents_RemarksIfAny like 'FormJ%' then OfflineAgents_ReferenceNumber else Concat('Offline (', OfflineAgents_ReferenceNumber, ')') END as Agent_Reference_DiaryNumber,
			'0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
			OfflineAgents_AgentName_OrganizationName as Agent_Name,
			OfflineAgents_AgentType as Agent_Type,
			
			-- Agent Information
			'Offline Mode' as Mode_RegistrationNumber,

			-- IND CASE
			'' as Agent_FirstName,
			'' as Agent_MiddleName,
			'' as Agent_LastName,
			'' as Father_FirstName,
			'' as Father_MiddleName,
			'' as Father_LastName,
			'' as Individual_PAN_Number,
			0 as Individual_Aadhaar_Number,

			-- OTI CASE
			OfflineAgents_AgentName_OrganizationName as Organization_Name,
			'0' as Organization_TypeCode,
			'0' as Organization_PAN_Number,
			
			-- IND-Permanent Address OR OTI-Regd Address
			OfflineAgents_FatherNameWithPermanentAddress_RegisteredAddress as RegOfficeOrPermanent_AddressLine1,
			'' as RegOfficeOrPermanent_AddressLine2,
			'0' as RegOfficeOrPermanent_AddressStateCode,
			'0' as RegOfficeOrPermanent_AddressDistrictCode,
			'0' as RegOfficeOrPermanent_AddressPIN,
				
			-- Place of Bussiness Address
			OfflineAgents_PlaceOfBussinessAddress as BusinessPlace_AddressLine1,
			'' as BusinessPlace_AddressLine2,
			'0' as BusinessPlace_AddressStateCode,
			'0' as BusinessPlace_AddressDistrictCode,
			'0' as BusinessPlace_AddressPIN,
			OfflineAgents_BusinessPlaceDistrict as BusinessPlace_AddressSubDivisionName,
			
			-- Official Address OR Communication Address
			CASE when OfflineAgents_ContactDetails = '' then Concat('Not Avialable (Offline)') else OfflineAgents_ContactDetails END as BComm_AddressLine1,
			'' as BComm_AddressLine2,
			'0' as BComm_AddressStateCode,
			'0' as BComm_AddressDistrictCode,
			'0' as BComm_AddressPIN,
			
			-- OTI-Authorized Person    
			'' as AuthorizedSignatory_FirstName,
			'' as AuthorizedSignatory_MiddleName,
			'' as AuthorizedSignatory_LastName,    
			'0' as PAN_Number,
			'0' as Aadhaar_Number,
			
			-- IND-agent-detail or OTI-Authorized Person-detail    
			'0' as MobileNumber,
			'0' as PhoneNumber_STD,
			'0' as PhoneNumber_Number,
			'' as EmailAddress,
			
			-- OTHER	
			'NA' as IsOtherOrganizationMembers,
			'NA' as IsOtherStateUT_RERAregistration,

			IsActive,
			0 as IsActiveProvider,
			IsDraft,
			0 as IsLock,
			IsPublicView,
			IsCertificate as IsConditional,

			CreatedOn,
			CreatedBy,
			ModifyOn,
			ModifyBy,
			
			-- Extra
			A_column as A_Column,
			B_column as B_Column,
			C_column as C_Column,    
			
			'' as BusinessPlace_AddressSubDivision,
			'' as P_AddressState,
			'' as P_AddressDist,
			'' as BusinessPlace_AddressState,
			'' as BusinessPlace_AddressDistrict,
			'' as BComm_AddressState,
			'' as BComm_AddressDistrict,
			'' as RegOffice_AddressState,
			'' as RegOffice_AddressDistrict

			FROM tbl_rera_agent_offlineagents_pendinguploads 
			WHERE OfflineAgents_RERAregistrationNumber IN
			(select Related_RERAnumberRegistration FROM tbl_rera_agent_renewal_profile 
			WHERE Related_Agent_ID=p_Agent_ID
			and Related_Agent_Type=p_AgentType_ID
			and RenewalAgent_ID=p_RenewalAgent_ID
			and RenewalOrderSequence=p_RenewalAgent_SequenceID
			and RelatedRenewalAgent_Year=p_RenewalAgent_YearID
			and IsActive=1
			and IsDraft in (1,4,5,6)
			and IsLock in (0,1))
			Limit 1;

		END IF;
	END IF;
END IF;

END ;;
