CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthorityDesk_AgentRegistrationNumbers`(
	p_UserRole varchar(50),        
	p_RelatedAgent_ID bigint,
    p_RegistrationNumberOptions int,
    p_AgentStateType_Input varchar(50), -- CHD / HRY / HIM / OTH / PB-SAS/JAL/LDH/ASR
    p_IssueDate_Input datetime(3),
    p_ValidUptoDate_Input datetime(3)
)
begin        
   

declare v_Get_SubDivisionCodeName varchar(30);   
declare v_Get_DistrictCodeName varchar(30);
declare v_Get_RegNumber_ID bigint;
declare v_Put_RegNumber_ID bigint;
declare v_specialnumberCount Int;
declare v_Put_Prepared_SequenceNumber bigint;
declare v_Get_Prepared_SequenceNumber varchar(40);
declare v_Put_Prepared_AgentStateType varchar(30);

declare v_Get_AgentStateType_Name varchar(10);
declare v_checkrno int;
declare v_Put_ExistedNumberFlag varchar(10);
declare v_checktype int;
declare v_checktypeFlag varchar(10);

declare v_get_AllottedNumber_Value varchar(100);
declare v_get_IssueDate_Value datetime(3);
declare v_get_ValidUptoDate_Value datetime(3);

declare v_Get_PreparedSequenceName varchar(30);
declare v_Get_PreparedRegistrationNumber varchar(100);
declare v_Get_PreparedIssueDate datetime(3);
declare v_Get_PreparedValidUptoDate datetime(3);


DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;
 

-- (A) Get Agent State Type Code
IF (p_AgentStateType_Input<>'REA') 
then         
    set v_Get_AgentStateType_Name=p_AgentStateType_Input;
else
	-- Get Auto Agent State Type Code
	set v_Get_AgentStateType_Name='PUN';
    
    select count(AgentRegDiaryNumber_Name) into v_checktype from tbl_rera_agent_regdiarynumber
    where Agent_ID=p_RelatedAgent_ID and IsActive=1 and IsDraft=1;
        
    IF (v_checktype<>0)
	then	
		select distinct B_column into v_checktypeFlag from tbl_rera_agent_profile 
		where Agent_ID=p_RelatedAgent_ID and Isactive=1;
		
		IF (v_checktypeFlag='5001') then
			set v_Get_AgentStateType_Name='HRY';
		end if;
		IF (v_checktypeFlag='5002') then
			set v_Get_AgentStateType_Name='HIM';
		end if;
        IF (v_checktypeFlag='5003') then
			set v_Get_AgentStateType_Name='CHD';
		end if;
		IF (v_checktypeFlag='5004') then
			set v_Get_AgentStateType_Name='OTH';
		end if;
    end if;    
end if;

-- (B) Get SubDivision Code and District Code

IF (p_AgentStateType_Input<>'REA') 
then
	IF (p_AgentStateType_Input='PUN') then
		select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
		from tbl_rera_master_subdivisiondetails  
		where SubDivision_Code in (select CONVERT(B_column, UNSIGNED) from tbl_rera_agent_profile 
		where Agent_ID=p_RelatedAgent_ID and Isactive=1)
		and IsActive=1;
	end if;
	IF (p_AgentStateType_Input='HIM') then
		select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
		from tbl_rera_master_subdivisiondetails  
		where SubDivision_Code=5002
		and IsActive=1;
	end if;
	IF (p_AgentStateType_Input='HRY') then
		select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
		from tbl_rera_master_subdivisiondetails  
		where SubDivision_Code=5001
		and IsActive=1;
	end if;
	IF (p_AgentStateType_Input='CHD') then
		select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
		from tbl_rera_master_subdivisiondetails  
		where SubDivision_Code=5003
		and IsActive=1;
	end if;
    IF (p_AgentStateType_Input='OTH') then
		select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
		from tbl_rera_master_subdivisiondetails  
		where SubDivision_Code=5004
		and IsActive=1;
	end if;
else
    select District_RERAcode, SubDivision_RERAcode into v_Get_DistrictCodeName, v_Get_SubDivisionCodeName
	from tbl_rera_master_subdivisiondetails  
	where SubDivision_Code in (select CONVERT(B_column, UNSIGNED) from tbl_rera_agent_profile 
	where Agent_ID=p_RelatedAgent_ID and Isactive=1)
	and IsActive=1;
end if;


-- (C) Get check count Existing RERA number
set v_Put_ExistedNumberFlag='NA';
select count(*) into v_checkrno from tbl_rera_ldr_agent_reranumber_diarynumber 
where Agent_ID=p_RelatedAgent_ID and IsActive=1;


IF (v_checkrno<>0)
then
	set v_Put_ExistedNumberFlag='YS';
    set v_Get_Prepared_SequenceNumber='0';
    
	select RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate, Extra2, Extra3
    into v_get_AllottedNumber_Value, v_get_IssueDate_Value, v_get_ValidUptoDate_Value, v_Get_Prepared_SequenceNumber, v_Put_Prepared_AgentStateType
	from tbl_rera_ldr_agent_reranumber_diarynumber
	where Agent_ID=p_RelatedAgent_ID and IsActive=1;

	set v_Get_PreparedRegistrationNumber=v_get_AllottedNumber_Value;
    set v_Get_PreparedIssueDate=v_get_IssueDate_Value;
	set v_Get_PreparedValidUptoDate=v_get_ValidUptoDate_Value;
    set v_Put_Prepared_SequenceNumber=CAST(v_Get_Prepared_SequenceNumber AS UNSIGNED);    
else
	-- Get Sequence Max ID 
	select max(CAST(Extra2 AS UNSIGNED)) into v_Get_RegNumber_ID 
	from tbl_rera_ldr_agent_reranumber_diarynumber 
	where Extra4='NRL' and Extra3=v_Get_AgentStateType_Name and IsActive=1;

	IF (v_Get_RegNumber_ID IS NULL)          
	then          
		set v_Put_RegNumber_ID=1;        
	else           
		set v_Put_RegNumber_ID=v_Get_RegNumber_ID+1;      
	end if; 
    
    -- Get verify with special numbers
	select count(*) into v_specialnumberCount from tbl_rera_agent_registration_specialnumbers
	where SpecialNumber=v_Put_RegNumber_ID and IsActive=1 and IsAllotted in (0,1,2);

	IF (v_specialnumberCount<>0) 
	then         
		set v_Put_RegNumber_ID=v_Put_RegNumber_ID+1;      
	end if;
    
	-- Get Prefix for 4digit Sequence
	set v_Get_PreparedSequenceName=LPAD(v_Put_RegNumber_ID, 4, 0);
    set v_Put_Prepared_SequenceNumber=v_Put_RegNumber_ID;
    set v_Put_Prepared_AgentStateType=v_Get_AgentStateType_Name;

	set v_Get_PreparedRegistrationNumber=CONCAT('PBRERA', '-', CAST(v_Get_DistrictCodeName as CHAR(50)), CAST(v_Get_SubDivisionCodeName as CHAR(50)), '-REA', CAST(v_Get_PreparedSequenceName as CHAR(50)));
    set v_Get_PreparedIssueDate=p_IssueDate_Input;
	set v_Get_PreparedValidUptoDate=p_ValidUptoDate_Input;
end if;
 
if (p_RegistrationNumberOptions=51) 
then

	select 
	v_Put_Prepared_SequenceNumber as vPrepared_SequenceNumber,
	v_Put_Prepared_AgentStateType as vPrepared_AgentStateType,
	'NRL' as vPrepared_NumberTypeFlag,
	v_Get_PreparedRegistrationNumber as vPrepared_RegistrationNumber, 
	v_Get_PreparedIssueDate as vPrepared_IssueDate, 
	v_Get_PreparedValidUptoDate as vPrepared_ValidUptoDate,
	0 as vAmountPriceValue, 
	v_Put_ExistedNumberFlag as vNumberAlreadyExisted_Flag, 
	'NA' as RealEstateAgentName, 
	'NA' as RealEstateAgentRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column;
    
else

	select 
	v_Put_Prepared_SequenceNumber as vPrepared_SequenceNumber,
	v_Put_Prepared_AgentStateType as vPrepared_AgentStateType,
	'NRL' as vPrepared_NumberTypeFlag,
	v_Get_PreparedRegistrationNumber as vPrepared_RegistrationNumber, 
	v_Get_PreparedIssueDate as vPrepared_IssueDate, 
	v_Get_PreparedValidUptoDate as vPrepared_ValidUptoDate,
	0 as vAmountPriceValue, 
	v_Put_ExistedNumberFlag as vNumberAlreadyExisted_Flag, 
	'NA' as RealEstateAgentName, 
	'NA' as RealEstateAgentRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column

	union
	select 
	SpecialNumber as vPrepared_SequenceNumber,
	v_Get_AgentStateType_Name as vPrepared_AgentStateType,
	'SPL' as vPrepared_NumberTypeFlag,
	CONCAT('PBRERA', '-', CAST(v_Get_DistrictCodeName as CHAR(50)), CAST(v_Get_SubDivisionCodeName as CHAR(50)), '-REA', CAST(LPAD(SpecialNumber, 4, 0) as CHAR(50))) as vPrepared_RegistrationNumber,
	p_IssueDate_Input as vPrepared_IssueDate,
	p_ValidUptoDate_Input as vPrepared_ValidUptoDate,
	PriceValue as vAmountPriceValue,
	'NA' as vNumberAlreadyExisted_Flag, 
	'NA' as RealEstateAgentName, 
	'NA' as RealEstateAgentRegDiaryNumber_Name,
	'' as RemarksIfAny,
	'' as A_Column,
	'' as B_Column,
	'' as C_Column
	from tbl_rera_agent_registration_specialnumbers 
	where Reference_AgentStateType=v_Get_AgentStateType_Name
	and isactive=1 and IsAllotted in (0,2);

end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
