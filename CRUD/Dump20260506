CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicNotice_AuthorityNoticeDetails`(    
	p_Request_ID int,
	p_Request_Code varchar(90),
	p_User_ID varchar(90)
)
begin  

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;


if (p_Request_ID='1') then
	-- Public Notice

	SELECT
	CircularPublicNotice_IndexID,
	CircularPublicNotice_ID,
	CircularPublicNotice_LanguageFlag,
	Circular_Number,
	Circular_IssueDate,
	Circular_Category,
	Circular_Title,
	CulturePunjabi_Circular_Category,
	CulturePunjabi_Circular_Title,
	Circular_BaseUrl,
	Circular_FilePath,
	Circular_FileName,
	Circular_FileType,
	A_column,
	B_column,
	IsActive,
	IsPublicView,
	CreatedBy,
	CreatedOn,
	ModifyBy,
	ModifyOn,    
	p_Request_ID as RequestID,
	p_User_ID as UserID,
	p_Request_Code as RequestCode
	
	FROM tbl_rera_webapplication_circularpublicnotices
	WHERE IsActive=1 
	and IsPublicView=1
    and Circular_Category in ('Public Notice', 'Tender Notice')
	order by Circular_IssueDate desc;        

else
-- Circular/ Order/ Letter
	
	SELECT
	CircularPublicNotice_IndexID,
	CircularPublicNotice_ID,
	CircularPublicNotice_LanguageFlag,
	Circular_Number,
	Circular_IssueDate,
	Circular_Category,
	Circular_Title,
	CulturePunjabi_Circular_Category,
	CulturePunjabi_Circular_Title,
	Circular_BaseUrl,
	Circular_FilePath,
	Circular_FileName,
	Circular_FileType,
	A_column,
	B_column,
	IsActive,
	IsPublicView,
	CreatedBy,
	CreatedOn,
	ModifyBy,
	ModifyOn,    
	p_Request_ID as RequestID,
	p_User_ID as UserID,
	p_Request_Code as RequestCode
	
	FROM tbl_rera_webapplication_circularpublicnotices
	WHERE IsActive=1 
	and IsPublicView=1
    and Circular_Category in ('Circular', 'Order', 'Letter', 'Recruitment Notice')
	order by Circular_IssueDate desc;

end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;
  
end ;;
DELIMITER ;
