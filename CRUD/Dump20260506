		from  tbl_rera_ProjectExtensionForm_RegDiaryNumber 
        where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1; 
		  
		  
		update tbl_rera_ProjectExtensionForm_RegDiaryNumber set IsActive=2
		where Project_ID=p_Project_ID and 
		Promoter_ID=p_Promoter_ID and 
		ProjectExtForm_RegDiaryNumber_Name=v_GetExistingForDeskProjectRegDiaryNumber_Name and
		IsActive=1;	  
		  
		  
     
		-- ------- Generate New Diary Number (Application Modification)---------- 
		INSERT INTO tbl_rera_ProjectExtensionForm_RegDiaryNumber        
		(   
		`ProjectExtForm_RegDiaryNumber_ID`,
		`ProjectExtForm_RegDiaryNumber_Name`,
		`ProjectExtForm_RegDiaryNumber_NameYear`,
		`UserID`,
		`Promoter_ID`,
		`Project_ID`,
		`PaymentDetailsCount`,
