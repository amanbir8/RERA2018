udfn_GetQUP_Flag_DATE(a.Project_ID, 2020, 'FirstQTR') as `Submitted Date (2020-I)`,
CASE 
	WHEN a.RERAnumberIssueDate < '2020-07-01 00:00:00.000' and a.RERAnumberIssueDate > '2020-03-31 00:00:00.000' THEN 'YES'
