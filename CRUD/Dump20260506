CREATE DEFINER=`sa`@`%` FUNCTION `udf_complaint_report_strip_tags`($str text) RETURNS text CHARSET utf8
BEGIN
    DECLARE $start, $end INT DEFAULT 1;
    LOOP
        SET $start = LOCATE("<", $str, $start);
        IF (!$start) THEN RETURN $str; END IF;
        SET $end = LOCATE(">", $str, $start);
        IF (!$end) THEN SET $end = $start; END IF;
        SET $str = INSERT($str, $start, $end - $start + 1, "");
        SET $str = REPLACE($str, '&nbsp;', SPACE(1));
        SET $str = REPLACE($str, '&amp;', SPACE(1));
        SET $str = REPLACE($str, SPACE(2), SPACE(1));
        SET $str = REPLACE($str,'\r\n',SPACE(0));
        SET $str = REPLACE($str,'\n',SPACE(0));
        -- SET $str = REPLACE($str,',',SPACE(1));
    END LOOP;
END ;;
