	-- -------------------------------       
        
	-- ---------EVENT INSERT -------------
	select COUNT(*) into v_checkExistingEventCount from tbl_rera_project_puc_eventaction 
	where Related_Promoter_ID=p_RelatedPromoter_ID and Related_Project_ID=p_RelatedProject_ID 
	and RERA_RegistrationNumber=p_RERAnumberRegistration and RelatedApplicationPUC_ID=v_getPUC_ApplicationID and IsActive=1;

	if v_checkExistingEventCount>0
	then
		update tbl_rera_project_puc_eventaction set IsActive=2 
		where Related_Promoter_ID=p_RelatedPromoter_ID and Related_Project_ID=p_RelatedProject_ID
		and RERA_RegistrationNumber=p_RERAnumberRegistration and RelatedApplicationPUC_ID=v_getPUC_ApplicationID and IsActive=1;
  
  
		INSERT INTO tbl_rera_project_puc_eventaction  
		(
		  -- ProjectEventActionPUC_ID,
		  EventAction_Type,
		  EventAction_IdentifiedBy,
		  EventAction_IdentifiedOn,
		  Related_Promoter_ID,
		  Related_Project_ID,
		  RelatedApplicationPUC_ID,
		  Promoter_DiaryNumber,
		  Project_DiaryNumber,
		  PUC_DiaryNumber,
		  PUC_ReferencePUC_Name,
		  PUC_ReferencePUC_Date,
		  RERA_RegistrationNumber,
		  EventAction_Summary,
		  EventAction_Description,
		  EventAction_Category,
		  EventAction_Aggregate,
		  EventAction_Relationship,
		  AssignedTo,
		  Target_ResolutionDate,
		  Target_ResolutionSummary,
		  Actual_ResolutionDate,
		  IsBefore_TargetResolution,
		  ProgressStatus,
		  Remarks_IfAny,
		  IsActive,
		  IsDraft,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		)  
		VALUES  
		(  
          -- ProjectEventActionPUC_ID,
		  910004,  -- ReSubmitted Event Code
		  p_CreatedBy,  
		  NOW(), 
          p_RelatedPromoter_ID,
          p_RelatedProject_ID,
          v_getPUC_ApplicationID,          
          '',
          p_ProjectDiaryNumber,
          v_GetExistingForDeskPUCdiaryNumber_Name, -- PUC_DiaryNumber
          p_PUC_ReferencePUC_Name,
          p_PUC_ReferencePUC_Date,
          p_RERAnumberRegistration, 
		  'PUC Re-Submitted (Modified Application)',  
		  'Project PUC for Change Request' ,  
		  'System Administrator' ,  
		  'PUC Re-Submitted with Modification' ,  
		  'Role Admin' ,  
		  'HelpDesk Level I' ,  
		  NOW(),    
		  '999',  
		  NOW(), 
          0,
		  'In Process' ,  
		  'Re-Submitted PUC for Change Request',
		  1,  
		  0,  
		  p_CreatedBy,  
		  NOW(),    
		  p_ModifyBy, 
		  NOW()  
		);  
  
		set v_PutPUC_RegDiaryNumber_Name=v_GetExistingForDeskPUCdiaryNumber_Name;
    else
	    INSERT INTO tbl_rera_project_puc_eventaction  
		(
		  -- ProjectEventActionPUC_ID,
		  EventAction_Type,
		  EventAction_IdentifiedBy,
		  EventAction_IdentifiedOn,
		  Related_Promoter_ID,
		  Related_Project_ID,
		  RelatedApplicationPUC_ID,
		  Promoter_DiaryNumber,
		  Project_DiaryNumber,
		  PUC_DiaryNumber,
		  PUC_ReferencePUC_Name,
		  PUC_ReferencePUC_Date,
		  RERA_RegistrationNumber,
		  EventAction_Summary,
		  EventAction_Description,
		  EventAction_Category,
		  EventAction_Aggregate,
		  EventAction_Relationship,
		  AssignedTo,
		  Target_ResolutionDate,
		  Target_ResolutionSummary,
		  Actual_ResolutionDate,
		  IsBefore_TargetResolution,
		  ProgressStatus,
		  Remarks_IfAny,
		  IsActive,
		  IsDraft,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		) 
     VALUES  
     ( 
		-- ProjectEventActionPUC_ID,
		910001,  -- New Application By Admin (Intialization) Event Code
        p_CreatedBy,  
	    NOW(), 
