CREATE DEFINER=`sa`@`%` PROCEDURE `usp_pg_delete_tbl_rera_payment_epay_transactionchallan`(
	p_PaymentRegistration_IndexID bigint(20),
	p_PaymentRegistration_ID bigint(20),
	p_Payment_epayTxnID bigint(20),
	p_Payment_epayTxnNumber varchar(90),
	p_Payment_epayTxnYear int(11),
	p_Payment_epayChallanNumber varchar(90),
    p_Payment_epayBankNumber varchar(90),  
    p_Payment_epayChallanID bigint(20),
	p_IsTransaction int(11),
    p_IsChallan int(11),
	p_IsBankGateway int(11),
    p_IsVerified int(11),    
	p_TransactionDate datetime(3),
	p_ChallanDate datetime(3),
	p_BankGatewayDate datetime(3),	
    p_VerifiedDate datetime(3),    
	p_Payment_GroupID int(11),
    p_Payment_GroupName varchar(90),    
	p_PaymentForCode int(11),
    p_PaymentForName varchar(90),
	p_ReferenceChoiceCode varchar(90),
	p_ReferenceChoiceName varchar(90),
    p_ReferenceChoiceValue varchar(90),
    p_A_column varchar(90),
	p_B_column varchar(90),
    p_C_column varchar(90),
	p_CreatedBy varchar(50),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),	  
	out p_valreturn int
)
BEGIN    

 declare v_ChkTransactionCount int;
 declare v_ChkChallanCount int;
 declare v_ChkVerifiedTransactionCount int;
 declare v_ChkVerifiedChallanCount int;

 
  DECLARE `_rollback` BOOL DEFAULT 0;
  DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

  START TRANSACTION;
    
 select count(PaymentRegistration_ID) into v_ChkTransactionCount from tbl_rera_payment_epay_registration     
 where PaymentRegistration_ID=p_PaymentRegistration_ID and    
	Payment_epayTxnID=p_Payment_epayTxnID and IsActive=1;
   
if (v_ChkTransactionCount>0) then 
	-- Transaction Flag
	select count(*) into v_ChkVerifiedTransactionCount from tbl_rera_payment_epay_registration
	where PaymentRegistration_ID=p_PaymentRegistration_ID 
	and Payment_epayTxnID=p_Payment_epayTxnID
	and IsActive=1 and IsBankGateway=0 and IsVerified=0;
         
	 if (v_ChkVerifiedTransactionCount>0) then
		-- Transaction Flag updated
		update tbl_rera_payment_epay_registration set IsActive=2, VerifiedDate=NOW()
		where PaymentRegistration_ID=p_PaymentRegistration_ID 
		and Payment_epayTxnID=p_Payment_epayTxnID
		and IsActive=1 and IsBankGateway=0 and IsVerified=0;        
	 end if;
           
	 select count(Payment_ChallanNumber_ID) into v_ChkChallanCount from tbl_rera_payment_epay_challannumber     
	 where Related_PaymentRegistration_ID=p_PaymentRegistration_ID and    
		Related_Payment_epayTxnID=p_Payment_epayTxnID and
		Payment_ChallanNumber_ID=p_Payment_epayChallanID and IsActive=1;      
           
	-- Check Challan Number      
	if (v_ChkChallanCount>0) then
		-- ReSet Both Txn and Challan
        -- Challan Flag
		select count(*) into v_ChkVerifiedChallanCount from tbl_rera_payment_epay_challannumber
		where Related_PaymentRegistration_ID=p_PaymentRegistration_ID    
		and Related_Payment_epayTxnID=p_Payment_epayTxnID
		and Payment_ChallanNumber_ID=p_Payment_epayChallanID 
        and IsActive=1 and IsBankGateway=0 and IsVerified=0;
			 
		if (v_ChkVerifiedChallanCount>0) then
			-- Transaction Flag updated
			update tbl_rera_payment_epay_challannumber set IsActive=2, VerifiedDate=NOW(), IsDraftMember=2
			where Related_PaymentRegistration_ID=p_PaymentRegistration_ID    
			and Related_Payment_epayTxnID=p_Payment_epayTxnID
			and Payment_ChallanNumber_ID=p_Payment_epayChallanID 
			and IsActive=1 and IsBankGateway=0 and IsVerified=0;        
		end if;
    end if;

	set p_valreturn = 5;
else
	set p_valreturn = 0;
end if;

 IF `_rollback` THEN
 	ROLLBACK;
 ELSE
 	COMMIT;
 END IF;
 
-- IF @@ERROR<>0      
