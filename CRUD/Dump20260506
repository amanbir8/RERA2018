RM.EventRemarks_IfAny as RemarksIfAny,
RM.IsActive,
RM.IsDraft,
RM.CreatedBy,
RM.CreatedOn,
RM.ModifyBy,
RM.ModifyOn
from
(
select 
rq.Project_DiaryNumber,
rq.Project_Diary_ApplicationDate,
rq.Project_ID,
rq.Promoter_ID,
rq.Project_TotalArea,
rq.Project_TotalAreaSTR,
rq.Project_RegDiaryNumber_IndexID,
