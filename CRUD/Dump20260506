	p_IsTransferOrder int,
	p_TransferOrderStatusRemark varchar(250),
	p_IsActive int,
	p_IsDraft int,
	p_IsLock int,
	p_IsPublicView int,
	p_IsLatestActive int,
	p_IsTransferDisplay int,
	p_CreatedBy varchar(50),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),
	out p_valoutput bigint 
)
BEGIN    
    
 declare v_Get_CaseTransfer_ID bigint;  
 declare v_Put_CaseTransfer_ID bigint;  
 declare v_checkrno int;
 declare v_checkComplaintM_CaseTransfer int;
 declare v_flag_registeredproject varchar(90);
 
 declare v_Get_CaseTransfer_RegDiaryName varchar(90);         
 declare v_Put_CaseTransfer_RegDiaryName varchar(90);
 declare v_Put_TransferDisplay int;
 declare v_Put_FormMN_RelatedComplaintCode varchar(90);
 declare v_checkBasicRegdNumber int;
 declare v_Put_BasicComplaintRegDiaryNumber_Name varchar(90);
 
 declare v_checkExistingEventCount int;
 declare v_checkBifurcateCount int;
 
 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

 START TRANSACTION;
         
-- ------------------------- Application_id ------------------------        
select max(CaseTransfer_ID) into v_Get_CaseTransfer_ID from tbl_rera_complaint_formm_CaseTransferDetails where CaseTransfer_RegDiaryNumber_NameYear=YEAR(NOW());   

IF (v_Get_CaseTransfer_ID IS NULL)        
then        
	set v_Put_CaseTransfer_ID=1;          
ELSE         
	SET v_Put_CaseTransfer_ID=v_Get_CaseTransfer_ID +1;    
end if; 


select count(ComplaintRegDiaryNumber_ID) into v_checkBasicRegdNumber from tbl_rera_complaint_formm_regdiarynumber
where FormM_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1;

set v_Put_FormMN_RelatedComplaintCode='';
set v_Put_BasicComplaintRegDiaryNumber_Name='';
IF (v_checkBasicRegdNumber <> 0)
then
	select CONCAT('GCNo', CAST(LPAD(ComplaintRegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(ComplaintRegDiaryNumber_NameYear as CHAR(50))), ComplaintRegDiaryNumber_Name
	into v_Put_FormMN_RelatedComplaintCode, v_Put_BasicComplaintRegDiaryNumber_Name
	from tbl_rera_complaint_formm_regdiarynumber
	where FormM_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1;
    
    select D_column into v_flag_registeredproject from tbl_rera_complaint_formm_details where ComplaintFormM_Code=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1;
    if (v_flag_registeredproject='unregisteredproject')
    then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'UR');
    end if;
    
    select count(CaseBifurcate_ID) into v_checkBifurcateCount from tbl_rera_complaint_formm_bifurcationdetails where RelatedBifurcate_Complaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1 and IsDraft=1;
    if (v_checkBifurcateCount<>0)
    then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'BF');
    end if;
end if; 
 
