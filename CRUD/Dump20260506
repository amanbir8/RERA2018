	Now() as Project_ApplicationDate,
	Now() as ProjectLastModifiedOn,
	'NA' as Project_RegistrationNumber,
	Now() as Registration_IssueDate,
	Now() as Registration_ValidUptoDate,


	c.EventAction_IdentifiedOn as RegistrationActionDate,
