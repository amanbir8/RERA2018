 select max(AgentRegRenewal_DiaryNumber_ID) into v_GetAgentDiaryNumber_ID from tbl_rera_ldr_agent_reranumber_renewalregistration;
 IF (v_GetAgentDiaryNumber_ID IS NULL)    
 then    
   set v_PutAgentDiaryNumber_ID = 1001;   
 ELSE     
