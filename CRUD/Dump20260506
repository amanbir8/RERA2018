CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_ByAppId_Registration`(
	p_Promoter_ID bigint,
	p_TypeOfPromoter_ID int,
	p_RegistrationNumber varchar(120),
    p_Flag int,
    p_UserName varchar(120)
)
begin

SELECT
Z.JointPromoter_ID,
Z.JointPromoter_Type,
Concat(Z.JointPromoter_Name, space(1), '(', Z.JointPromoter_DiaryNumber, ')') as JointPromoter_DiaryNumber,
Z.JointPromoter_Name,
Z.Registration_Number,

Z.Related_Promoter_DiaryNumber,
Z.Related_Promoter_ID,
Z.Related_Promoter_Type,
Z.Related_Promoter_Name,

Z.Registration_OtherMember_YN_Flag,
Z.Registration_OtherParentEntity_YN_Flag,
Z.Registration_OtherExperience_YN_Flag,
Z.Registration_OtherLitigations_YN_Flag,

Z.A_Column,
Z.B_Column,
Z.C_Column,

Z.IsActive,
Z.IsDraft,
Z.IsLock,
Z.IsFlag,
Z.IsPublicView,
Z.IsConditional,
Z.IsDraftMember
FROM
(
select
CoPromoter_ApplicationID as JointPromoter_ID,
CoPromoterType_Flag as JointPromoter_Type,
'NA' as JointPromoter_DiaryNumber,
udfn_GetJointPromoterName(CoPromoter_ApplicationID, CoPromoterType_Flag) as JointPromoter_Name,
'NA' as Registration_Number,

'Profile Under Registration' as Related_Promoter_DiaryNumber,
Related_Promoter_Application_ID as Related_Promoter_ID,
0 as Related_Promoter_Type,
'' as Related_Promoter_Name,

(case when IsOrganizationMembers = 'Y' then "Y" else "N" end) as Registration_OtherMember_YN_Flag,
(case when IsOrganizationParent_Entity = 'Y' then "Y" else "N" end) as Registration_OtherParentEntity_YN_Flag,
(case when IsExperience = 'Y' then "Y" else "N" end) as Registration_OtherExperience_YN_Flag,
(case when IsLitigation_RelatedProject = 'Y' then "Y" else "N" end) as Registration_OtherLitigations_YN_Flag,

'' as A_Column,
'' as B_Column,
'' as C_Column,

IsActive,
IsDraft,
IsLock,
0 as IsFlag,
IsPublicView,
0 as IsConditional,
0 as IsDraftMember
from tbl_rera_copromoter_registrationdetails
where IsActive=1 
and CoPromoter_ApplicationID not in (select Related_CoPromoter_ApplicationID from tbl_rera_copromoter_regdiarynumber where LinkTo_Related_Promoter_ID=p_Promoter_ID and IsActive=1 and IsLock in (0,1))
and Related_Promoter_Application_ID=p_Promoter_ID

UNION

select
m.CoPromoter_ApplicationID as JointPromoter_ID,
m.CoPromoterType_Flag as JointPromoter_Type,
n.CoPromoter_RegDiaryNumber_Name as JointPromoter_DiaryNumber,
udfn_GetJointPromoterName(m.CoPromoter_ApplicationID, m.CoPromoterType_Flag) as JointPromoter_Name,
n.LinkTo_Related_RegistrationNumber as Registration_Number,

n.Extra1 as Related_Promoter_DiaryNumber,
m.Related_Promoter_Application_ID as Related_Promoter_ID,
0 as Related_Promoter_Type,
'' as Related_Promoter_Name,

(case when m.IsOrganizationMembers = 'Y' then "Y" else "N" end) as Registration_OtherMember_YN_Flag,
(case when m.IsOrganizationParent_Entity = 'Y' then "Y" else "N" end) as Registration_OtherParentEntity_YN_Flag,
(case when m.IsExperience = 'Y' then "Y" else "N" end) as Registration_OtherExperience_YN_Flag,
(case when m.IsLitigation_RelatedProject = 'Y' then "Y" else "N" end) as Registration_OtherLitigations_YN_Flag,

'' as A_Column,
'' as B_Column,
'' as C_Column,

m.IsActive,
m.IsDraft,
m.IsLock,
0 as IsFlag,
m.IsPublicView,
0 as IsConditional,
0 as IsDraftMember
from tbl_rera_copromoter_registrationdetails m,tbl_rera_copromoter_regdiarynumber n
where m.CoPromoter_ApplicationID=n.Related_CoPromoter_ApplicationID
and m.CoPromoterType_Flag=n.Related_CoPromoterType_Flag
and m.IsActive=1
and n.IsActive=1
-- and n.IsDraft=1
and n.IsLock in (0,1)
and m.Related_Promoter_Application_ID=p_Promoter_ID
) Z
order by Z.JointPromoter_ID asc;
    
end ;;
