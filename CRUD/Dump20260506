CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetProjectAllChecklistVerified_StatusValue_ByFID`(p_promoter_ID bigint, p_project_ID bigint, p_event_ID bigint, p_CLview_ID varchar(50), p_signin_user_ID varchar(50)) RETURNS varchar(200) CHARSET utf8
BEGIN 
    DECLARE v_ret varchar(200);  
    DECLARE v_chkcountvalue int;
    DECLARE v_chktotalcountvalue int;
	DECLARE v_chkYesCasecountvalue int;
    DECLARE v_chkvalue varchar(50);
    
    IF (p_event_ID=110006 OR p_event_ID=110034) THEN
        -- Case (Checklist Prepared Action)
        	
		SELECT count(*) INTO v_chkcountvalue FROM tbl_rera_project_promoter_checklistaction 
		WHERE Related_Promoter_ID=p_promoter_ID
		AND Related_Project_ID=p_project_ID 
		AND IsChecklistValueOk='N'
		AND IsActive=1;
		
		IF (v_chkcountvalue>0) THEN
			SET v_ret = '21'; -- RED
		ELSE    
			SELECT count(*) INTO v_chktotalcountvalue FROM tbl_rera_project_promoter_checklistaction 
			WHERE Related_Promoter_ID=p_promoter_ID
			AND Related_Project_ID=p_project_ID 
			AND IsActive=1;
			
			IF (v_chktotalcountvalue<56) THEN
				SET v_ret = '22'; -- PENDING      
			ELSE
				SET v_ret = '23'; -- COMPLETE
			END IF;        
		END IF;        
    ELSE
		-- Case (Other Action)
		SET v_ret = '0'; -- NA
    END IF;
	
    IF (v_ret IS NULL) THEN   
		SET v_ret = '0'; -- NA
	END IF;
    RETURN v_ret;     
END ;;
