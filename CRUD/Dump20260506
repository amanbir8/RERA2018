			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowB and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowC) then CONCAT(var_RangeRowB+1, " to ", var_RangeRowC)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowC and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowD) then CONCAT(var_RangeRowC+1, " to ", var_RangeRowD)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowD and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowE) then CONCAT(var_RangeRowD+1, " to ", var_RangeRowE)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowE and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowF) then CONCAT(var_RangeRowE+1, " to ", var_RangeRowF)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowF and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowG) then CONCAT(var_RangeRowF+1, " to ", var_RangeRowG)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowG and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowH) then CONCAT(var_RangeRowG+1, " to ", var_RangeRowH)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowH and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowI) then CONCAT(var_RangeRowH+1, " to ", var_RangeRowI)
			when (DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) > var_RangeRowI and DATEDIFF(MF.EventAction_IdentifiedOn, MG.ApplicationSubmitted_Date) <= var_RangeRowJ) then CONCAT(var_RangeRowI+1, " to ", var_RangeRowJ)
			else CONCAT(var_RangeRowJ+1, " and Above")
		end as DaysRangeLevel_Title,
        '' as A_column,
        0 as B_column,
        '0001-01-01 00:00:00' as C_column,
        '0001-01-01 00:00:00' as D_column,
		MONTH(MF.EventAction_IdentifiedOn) as EventMonth,
		YEAR(MF.EventAction_IdentifiedOn) as EventYear,
        0 as IsActive,
        0 as IsDraft,
        '' as CreatedBy,
        Now() as CreatedOn,
        '' as ModifyBy,
        Now() as ModifyOn
		from 
		(
		Select Project_DiaryNumber,
		Related_Project_ID,
		Related_Promoter_ID,
		EventAction_IdentifiedOn,
		EventAction_Type,
		EventAction_Aggregate
		from tbl_rera_project_extensionform_eventaction 
		) MF
		left outer join
		(
		Select Project_DiaryNumber,
		Related_Project_ID,
		Related_Promoter_ID,
		EventAction_IdentifiedOn as ApplicationSubmitted_Date 
		from tbl_rera_project_extensionform_eventaction 
		group by Related_Project_ID
		order by EventAction_IdentifiedOn asc
		) MG
		ON
		MF.Related_Project_ID=MG.Related_Project_ID
		and MF.Related_Promoter_ID=MG.Related_Promoter_ID
		) XW
		where XW.EventMonth=p_InputEntry_Month 
		and XW.EventYear=p_InputEntry_Year
		and XW.EventAction_Type=p_EventActionTypeFlag
        Limit 100;

	elseif (p_ApplicationModeFlag = 53) then 
	-- Project Completion
		Select
        0 as IndexCode,
        0 as Related_Project_ID,
		0 as Related_Promoter_ID,
		'' as Project_DiaryNumber, 
		'0001-01-01 00:00:00' as ApplicationSubmitted_Date,
        '' as Project_Name,
        0 as EventAction_Type,
		'' as EventAction_Aggregate,
		'0001-01-01 00:00:00' as EventAction_IdentifiedOn,
		'0' as DaysInNumber,
        '' as DaysRangeLevel_Title,
        '' as A_column,
        0 as B_column,
        '0001-01-01 00:00:00' as C_column,
        '0001-01-01 00:00:00' as D_column,
        0 as EventMonth,
		0 as EventYear,        
        0 as IsActive,
        0 as IsDraft,
        '' as CreatedBy,
        Now() as CreatedOn,
        '' as ModifyBy,
        Now() as ModifyOn
		from tbl_rera_project_extensionform_eventaction
		where isactive=45
        Limit 100;
        
   end if;
end if;

end ;;
