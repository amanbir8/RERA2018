CREATE DEFINER=`sa`@`%` PROCEDURE `usp_display_rera_CauseList_ByFilter`(
    IN p_Complainant_Name VARCHAR(250),
    IN p_Complaint_DNumber VARCHAR(250),
    IN p_Complaint_Flag INT,
    In p_ComplaintRefNumber_Flag int,
    IN p_UserRole VARCHAR(100),
    IN p_FromDate DATETIME,
    IN p_ToDate DATETIME,
    IN p_BenchID INT,
    IN p_PartyName VARCHAR(250),
    IN p_PartyName_Flag INT ,
    IN p_PartyType VARCHAR(50)
)
BEGIN
    DECLARE `_rollback` BOOL DEFAULT 0;
    DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

    START TRANSACTION;

	IF (p_ComplaintRefNumber_Flag <> 0) THEN
		-- Case-I - When With Reference Number
		-- FORM-M
		SELECT
			rhd.CauseList_IndexID, 
			rhd.CauseList_ID, 
			rhd.SerialOrderNumber,
            rhd.ComplaintFormM_ID as ComplaintApplicationNumberKey1,
            'CL_FormM' as ComplaintApplicationNumberKey2,
            '' as ComplaintApplicationNumberKey3,
            '' as ComplaintApplicationNumberKey4,
			rhd.PreHearingDate AS Cause_List_Date,
			rhd.Cause_List_Day,
			rhd.ComplaintApplicationNumber,    
			rhd.ComplainantName,
			rhd.RespondentName,
			rhd.Fixed_For_Name,
			rhd.FixedForCode,
			rhd.Bench_Name,
			rhd.Bench_Code,
			rhd.PreHearingBench_ID,
			rmcp.PreHearingBenchName,
			rhd.CauseList_BaseUrl,
			rhd.CauseList_FilePath,
			rhd.CauseList_FileName,
			rhd.CauseList_FileType,
			rhd.Related_CauseList_FileSize,
			rhd.IsActive,
			rhd.IsDraft,
			rhd.IsDraftMember,
			rhd.IsPublicView,
			rhd.CreatedBy,
			udfn_GetComplaintFormMApplicationDate(rhd.ComplaintFormM_ID) as CreatedOn, -- rhd.CreatedOn,
			rhd.ModifyBy,
			rhd.ModifyOn,
			rhd.RemarksIfAny,
			rhd.EventAction_Type,
			rhd.EventAction_TypeName,
			rhd.EventAction_IdentifiedOn,
			rhd.EventAction_Aggregate,
			rhd.EventRemarks_IfAny,
			rhd.EventAction_Summary
		FROM
		(
		select
			p.PreHearingDate_IndexID as CauseList_IndexID, 
			p.PreHearingDate_ID as CauseList_ID, 
			udfn_GetCauseListSeqOrder_ByID(p.PreHearingFixedForCode) as SerialOrderNumber,
