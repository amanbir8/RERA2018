CREATE DEFINER=`sa`@`%` PROCEDURE `usp_lockunlock_tbl_rera_agent_documentdetailsbyindex`( 
	p_Agent_ID bigint,
    p_AgentType_ID int,    
    p_ReferenceAgentIndexID bigint,
    p_AgentDocByIndexID bigint,
	p_IsDraftValue int,
	p_UserName varchar(100),
	p_UserID varchar(100),
	p_RelatedRemarksIfAny varchar(500),
	p_RelatedLockUnlockMsg varchar(250),
	p_A_Column varchar(100),
	p_B_Column varchar(100),
	out p_valIsDraftReturn int
)
BEGIN 

declare v_putIsDraftvalue int;
declare v_registerdiarynumberIsDraftvalue int;

   select IsDraft into v_putIsDraftvalue from tbl_rera_agent_documents 
   where Agent_ID=p_Agent_ID
   and AgentDoc_IndexID=p_AgentDocByIndexID
   and isactive=1
   limit 1;
   
set v_registerdiarynumberIsDraftvalue=0;
set v_putIsDraftvalue=0;

select IsDraftMember into v_registerdiarynumberIsDraftvalue from tbl_rera_agent_regdiarynumber 
where Agent_ID=p_Agent_ID
and IsActive=1;

if v_registerdiarynumberIsDraftvalue=0 then

	Insert into tbl_rera_ldr_agent_lockunlocklogdetails
	(
		-- `Agentlockunlocklog_IndexID`,
		`Related_Agent_ID`,
		`Related_AgentType_ID`,		
		`Related_AgentIsDraft`,
		`UserID`,
		`Remarks_IfAny`,
		`LockUnlockMsg_IfAny`,
		`A_Column`,
		`B_Column`,
		`IsActive`,
		`IsDraft`,
		`CreatedBy`,
		`CreatedOn`,
		`ModifyBy`,
		`ModifyOn`
	) 
	values( 
		-- Agentlockunlocklog_IndexID,
		p_Agent_ID,
		p_AgentType_ID,		
		p_IsDraftValue,
		p_UserID,
		p_RelatedRemarksIfAny,
		p_RelatedLockUnlockMsg,
		p_ReferenceAgentIndexID, -- p_A_Column,
		p_B_Column,
		1,
		0,
		p_UserName,
		NOW(),
		p_UserName,
		NOW()
	);
    
	if p_IsDraftValue = 1 then
	    -- Flag Update
		update tbl_rera_agent_documents set IsDraft=5	
		where Agent_ID=p_Agent_ID
        and AgentDoc_IndexID=p_AgentDocByIndexID
        -- and AgentDoc_ID=p_RenewalAgentIndexID
		and IsActive=1 and IsDraft=1;

		set v_putIsDraftvalue=5;	   
	end if;

	if p_IsDraftValue = 5 then
		-- Flag Update
		update tbl_rera_agent_documents set IsDraft=1	
		where Agent_ID=p_Agent_ID
        and AgentDoc_IndexID=p_AgentDocByIndexID
        -- and AgentDoc_ID=p_RenewalAgentIndexID
		and IsActive=1 and IsDraft=5;

	   set v_putIsDraftvalue=1;	   
	end if;

end if;

set p_valIsDraftReturn = v_putIsDraftvalue;
   
END ;;
