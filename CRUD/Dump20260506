CREATE DEFINER=`sa`@`%` FUNCTION `udfn_SmallNumberToWords`(p_Number INT) RETURNS varchar(200) CHARSET utf8
    DETERMINISTIC
BEGIN

    DECLARE v_Word VARCHAR(200);

    CASE p_Number
        WHEN 1 THEN SET v_Word = 'One';
        WHEN 2 THEN SET v_Word = 'Two';
        WHEN 3 THEN SET v_Word = 'Three';
        WHEN 4 THEN SET v_Word = 'Four';
        WHEN 5 THEN SET v_Word = 'Five';
        WHEN 6 THEN SET v_Word = 'Six';
        WHEN 7 THEN SET v_Word = 'Seven';
        WHEN 8 THEN SET v_Word = 'Eight';
        WHEN 9 THEN SET v_Word = 'Nine';
        WHEN 10 THEN SET v_Word = 'Ten';
        WHEN 11 THEN SET v_Word = 'Eleven';
        WHEN 12 THEN SET v_Word = 'Twelve';
        WHEN 13 THEN SET v_Word = 'Thirteen';
        WHEN 14 THEN SET v_Word = 'Fourteen';
        WHEN 15 THEN SET v_Word = 'Fifteen';
        WHEN 16 THEN SET v_Word = 'Sixteen';
        WHEN 17 THEN SET v_Word = 'Seventeen';
        WHEN 18 THEN SET v_Word = 'Eighteen';
        WHEN 19 THEN SET v_Word = 'Nineteen';
        WHEN 20 THEN SET v_Word = 'Twenty';
        WHEN 30 THEN SET v_Word = 'Thirty';
        WHEN 40 THEN SET v_Word = 'Forty';
        WHEN 50 THEN SET v_Word = 'Fifty';
        WHEN 60 THEN SET v_Word = 'Sixty';
        WHEN 70 THEN SET v_Word = 'Seventy';
        WHEN 80 THEN SET v_Word = 'Eighty';
        WHEN 90 THEN SET v_Word = 'Ninety';
        ELSE
            IF p_Number < 100 THEN
                SET v_Word = CONCAT(
                    udfn_SmallNumberToWords(FLOOR(p_Number/10)*10),
                    ' ',
                    udfn_SmallNumberToWords(p_Number % 10)
                );
            ELSE
                SET v_Word = '';
            END IF;
    END CASE;

    RETURN v_Word;

END ;;
