then          
  set v_PutProjectExtForm_RegDiaryNumber_ID=1;      
  set v_PutProjectExtForm_RegDiaryNumber_Name=CONCAT('FormE', CAST(YEAR(NOW()) as CHAR(50)), CAST(v_GET_Subdivision_Name as CHAR(50)), CAST(LPAD(v_PutProjectExtForm_RegDiaryNumber_ID, 4, '0') as CHAR(50)));
