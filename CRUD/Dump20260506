CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetQuarterlyUpdateSubmitOnTime`(p_QuarterName varchar(60), p_QuarterYear int, p_ApplicationDate datetime(3)) RETURNS varchar(500) CHARSET utf8
BEGIN  
    DECLARE v_ret varchar(500);
    
    DECLARE v_appDateM1 int;
    DECLARE v_appDateY1 int;
    DECLARE v_appDateM2 int;
    DECLARE v_appDateY2 int;
    
    
    if(p_QuarterName='FirstQTR') then
		set v_appDateM1=4;
        set v_appDateY1=p_QuarterYear;
    else 
		if(p_QuarterName='SecondQTR') then
			set v_appDateM1=7;
			set v_appDateY1=p_QuarterYear;
		else 
			if(p_QuarterName='ThirdQTR') then
				set v_appDateM1=10;
				set v_appDateY1=p_QuarterYear;
			else 
				if(p_QuarterName='FourthQTR') then
					set v_appDateM1=1;
					set v_appDateY1=p_QuarterYear+1;
                end if;
            end if;
		end if;
    end if;
    
    
    set v_appDateM2 = MONTH(p_ApplicationDate);
    set v_appDateY2 = YEAR(p_ApplicationDate);
    
    set v_ret='NA';
    
    IF (v_appDateY1=v_appDateY2) THEN
		IF (v_appDateM1=v_appDateM2) THEN
			set v_ret='Provided On-Time';
		END IF;
    END IF;
    
    RETURN v_ret; 
END ;;
