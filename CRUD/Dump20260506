	END IF;
	-- END-103       
END IF;
-- END-101 --

IF `_rollback` THEN
 	ROLLBACK;
ELSE
 	COMMIT;
END IF;  
      
set p_Return_JointPromoter_RegDiaryNumber_Name=v_PutJointPromoter_RegDiaryNumber_Name; 
  
