    select RERAnumberRegistration, Project_ID, Promoter_ID into vput_RegistrationNumber, vput_RefProjectID, vput_RefPromoterID
	from tbl_rera_ldr_project_reranumber_diarynumber where RERAnumberRegistration=p_RegistrationNumber and isactive=1
	Limit 1;
else 
	if (p_RequestFlag=16) then
		select RERAnumberRegistration, Project_ID, Promoter_ID into vput_RegistrationNumber, vput_RefProjectID, vput_RefPromoterID 
		from tbl_rera_ldr_project_reranumber_diarynumber where ProjectRegDiaryNumber_Name=p_ProjectDNumber and isactive=1
		Limit 1;
	else 
		if (p_RequestFlag=17) then			
            select RERA_RegistrationNumber, RelatedProject_ID, RelatedPromoter_ID into vput_RegistrationNumber, vput_RefProjectID, vput_RefPromoterID 
			from tbl_rera_project_puc_regdiarynumber where PUC_RegDiaryNumber_Name=p_PucDNumber and isactive=1
			Limit 1;
		else 
			if (p_RequestFlag=18) then
				select RERA_RegistrationNumber, RelatedProject_ID, RelatedPromoter_ID into vput_RegistrationNumber, vput_RefProjectID, vput_RefPromoterID
				from tbl_rera_project_puc_regdiarynumber 
                where PUC_ReferencePUC_Name=p_PUCnumber and PUC_ReferencePUC_Date=p_PUCdate and isactive=1
				Limit 1;
			else
				set vput_RegistrationNumber=p_RegistrationNumber;
			end if;
		end if;
	end if;
end if;

select count(*) into vcheckcnt from tbl_rera_ldr_project_reranumber_extensionform
where RERAnumberRegistration=vput_RegistrationNumber
and RelatedPromoter_ID=vput_RefPromoterID
and RelatedProject_ID=vput_RefProjectID
and isactive=1; 

if (vcheckcnt <> 0)
then
	set vcheckcnt=1;

	select RERAnumberRegistration, ExtnRegistrationRegUptoDate, RelatedExtnRegDiaryNumber_Name into vgetregdnumber, vgetextnregduptodate, vgetextndiarynumber
	from tbl_rera_ldr_project_reranumber_extensionform
	where RERAnumberRegistration=vput_RegistrationNumber
    and RelatedPromoter_ID=vput_RefPromoterID
	and RelatedProject_ID=vput_RefProjectID
	and isactive=1
	Limit 1; 
end if;


