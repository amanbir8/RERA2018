		-- Transfer To AO/ AUTH/ REGD/ OTH (CASE: diary number without Post-fix option)
        -- set v_Get_CaseTransfer_RegDiaryName=CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(60));
        -- set v_Get_CaseTransfer_RegDiaryName=CAST(p_CaseTransfer_RegDiaryNumber_Name as CHAR(120));
        set v_Get_CaseTransfer_RegDiaryName=CAST(v_Put_BasicComplaintRegDiaryNumber_Name as CHAR(120));
