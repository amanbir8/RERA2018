	from tbl_rera_complaint_formm_regdiarynumber
	where FormM_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
	
	select D_column into v_flag_registeredproject from tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;
	if (v_flag_registeredproject='unregisteredproject')
	then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'UR');
	end if;
	
	set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'BF');
end if;

SELECT count(ComplaintRegDiaryNumber_IndexID) INTO v_Get_ApplicationForm_Count FROM tbl_rera_complaint_formm_regdiarynumber
WHERE FormM_RelatedComplaint_ID=p_ComplaintFormM_ID;

IF (v_Get_ApplicationForm_Count>1) THEN

	SELECT CreatedOn INTO v_Get_ApplicationForm_Date FROM tbl_rera_complaint_formm_regdiarynumber 
	WHERE FormM_RelatedComplaint_ID=p_ComplaintFormM_ID ORDER BY ComplaintRegDiaryNumber_IndexID asc LIMIT 1; 
		
	IF (v_Get_ApplicationForm_Date IS NULL) THEN   
		SET v_Get_ApplicationForm_Date='2018-04-13 00:00:00.000';
	END IF;
    
    -- Clone Copy
	INSERT INTO tbl_rera_complaint_formm_regdiarynumber
	(    
	  -- ComplaintRegDiaryNumber_IndexID,
	  ComplaintRegDiaryNumber_ID,
	  ComplaintRegDiaryNumber_Name,
	  ComplaintRegDiaryNumber_NameYear,
