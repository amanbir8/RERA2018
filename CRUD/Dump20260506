            set IsActive=2, D_Column=NOW() 
			where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1
            and ExtnProjectReminderSMS_IndexID <> 0;
		end if;		
	end if; 
	-- END----------------------- 
    
end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;  
      
    
set p_Return_ProjectExtForm_RegDiaryNumber_Name=v_PutProjectExtForm_RegDiaryNumber_Name; 
    
     
