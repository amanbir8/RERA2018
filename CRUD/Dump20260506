CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_ExistingAgent_ByID`(  
  p_RERA_RegNumber varchar(50),
  p_StateName varchar(50),
  p_typeAgent int(11),
  p_ResetFlag int(11),
  p_UserID varchar(50)
)
begin  

declare v_chk_AgentRegNumberCount int; 
declare v_get_AgentType int;

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;

IF (p_StateName='Punjab') THEN

Select count(*) into v_chk_AgentRegNumberCount from tbl_Rera_Agent_ExisitingRera where RERA_RegNumber=p_RERA_RegNumber and IsActive=1;
if (v_chk_AgentRegNumberCount<>0) then
	set v_get_AgentType=0;
	Select Organization_TypeCode into v_get_AgentType from tbl_Rera_Agent_ExisitingRera where RERA_RegNumber=p_RERA_RegNumber and IsActive=1 limit 1;
	if (v_get_AgentType=p_typeAgent) then
		select 
		AgentExistingRERA_ID,
		RERA_RegNumber,
		'0001-01-01 00:00:00.000' as Date_of_Issue,
		Agent_FirstName,
		Agent_MiddleName,
		Agent_LastName,
		Organization_Name,
		'Success' as EnableStatus,
		'Y' as FlagStatus,
		'Valid RERA Number' as MessageStatus
		from tbl_Rera_Agent_ExisitingRera 
		where  RERA_RegNumber=p_RERA_RegNumber and IsActive=1;
	else
		Select 
		0 as AgentExistingRERA_ID,
		'NA' as RERA_RegNumber,
		'0001-01-01 00:00:00.000' as Date_of_Issue,
		'NA' as Agent_FirstName,
		'NA' as Agent_MiddleName,
		'NA' as Agent_LastName,
		'NA' as Organization_Name,
		'NA' as EnableStatus,
		'Y' as FlagStatus,
		'NA' as MessageStatus;
    end if;
else
	Select 
	0 as AgentExistingRERA_ID,
	'NA' as RERA_RegNumber,
	'0001-01-01 00:00:00.000' as Date_of_Issue,
	'NA' as Agent_FirstName,
	'NA' as Agent_MiddleName,
	'NA' as Agent_LastName,
	'NA' as Organization_Name,
	'NA' as EnableStatus,
	'N' as FlagStatus,
	'NA' as MessageStatus;
end if;

ELSE
	-- Other State Alert Message
	IF (p_ResetFlag=1) THEN
		-- Enable Entry
		Select 
		0 as AgentExistingRERA_ID,
		'NA' as RERA_RegNumber,
		'0001-01-01 00:00:00.000' as Date_of_Issue,
		'NA' as Agent_FirstName,
		'NA' as Agent_MiddleName,
		'NA' as Agent_LastName,
		'NA' as Organization_Name,
		'OtherState' as EnableStatus,
		'Y' as FlagStatus,
		'NA' as MessageStatus;
	ELSE
		-- Disable Entry
		Select 
		0 as AgentExistingRERA_ID,
		'NA' as RERA_RegNumber,
		'0001-01-01 00:00:00.000' as Date_of_Issue,
		'NA' as Agent_FirstName,
		'NA' as Agent_MiddleName,
		'NA' as Agent_LastName,
		'NA' as Organization_Name,
		'OtherState' as EnableStatus,
		'N' as FlagStatus,
		'NA' as MessageStatus;
	END IF;
END IF;


IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
