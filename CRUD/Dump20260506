CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_GeoLocationsRegProjects_BySearchParms`(
    p_UserRole varchar(50),
	p_DistrictCode varchar(150),
	p_ProjectType varchar(150),	
	p_FlagDistrict integer,
	p_FlagProjectType integer    
)
begin 

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION; 
  
if (p_FlagDistrict = 0) -- When All Districts
then
	IF (p_FlagProjectType = 2) THEN -- All (Type of Project)
		
        Select XY.*,
		PQ.ProposedProjectLand_StartPoint_Latitude,
		PQ.ProposedProjectLand_StartPoint_Longitude,
        true as Project_Value
		from
		(
        select a.ProjectRegDiaryNumber_Name as DiaryNumber,
        a.Promoter_ID,
        a.Project_ID,
        a.ProjectName,
        a.RERAnumberRegistration,
        a.RERAnumberIssueDate,
        a.RERAnumberRegUptoDate,
		a.Extra2,
		'' as Project_AddressDistrictName,  
		  
		c.EventAction_Type,
		c.EventAction_IdentifiedOn  
		  
		from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
		where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
		and a.Project_ID=c.Related_Project_ID  
		and c.IsActive=1  
		and a.IsActive=1 
		and c.EventAction_Type in (110020, 110023)
        and a.Project_ID not in (10490, 10182, 10462, 10351, 11263)
		) XY, tbl_rera_project_landdetails PQ
		where
		XY.Project_ID=PQ.ProjectLandRelated_ProjectRegistration_ID
		and PQ.IsActive=1
        and PQ.ProposedProjectLand_StartPoint_Latitude between 29.470013 and 32.463832
        and PQ.ProposedProjectLand_StartPoint_Longitude between 73.850027 and 76.908512
		order by EventAction_IdentifiedOn desc;
    
    END IF;
    
    IF (p_FlagProjectType = 1) THEN -- By Filter (Type of Project)
		
        Select XY.*,
		PQ.ProposedProjectLand_StartPoint_Latitude,
		PQ.ProposedProjectLand_StartPoint_Longitude,
        true as Project_Value
		from
		(
        select a.ProjectRegDiaryNumber_Name as DiaryNumber,
        a.Promoter_ID,
        a.Project_ID,
        a.ProjectName,
        a.RERAnumberRegistration,
        a.RERAnumberIssueDate,
        a.RERAnumberRegUptoDate,
		a.Extra2,
		'' as Project_AddressDistrictName,  
		  
		c.EventAction_Type,
		c.EventAction_IdentifiedOn  
		  
		from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
		where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
		and a.Project_ID=c.Related_Project_ID  
		and c.IsActive=1  
		and a.IsActive=1 
		and c.EventAction_Type in (110020, 110023)
        and a.Project_ID not in (10490, 10182, 10462, 10351, 11263)
        and a.Extra2=p_ProjectType
		) XY, tbl_rera_project_landdetails PQ
		where
		XY.Project_ID=PQ.ProjectLandRelated_ProjectRegistration_ID
		and PQ.IsActive=1
        and PQ.ProposedProjectLand_StartPoint_Latitude between 29.470013 and 32.463832
        and PQ.ProposedProjectLand_StartPoint_Longitude between 73.850027 and 76.908512
		order by EventAction_IdentifiedOn desc;
        
    END IF; 
end if;

if (p_FlagDistrict = 1) -- When Selected Districts
then
	IF (p_FlagProjectType = 2) THEN -- All (Type of Project)
		
        Select XY.*,
		PQ.ProposedProjectLand_StartPoint_Latitude,
		PQ.ProposedProjectLand_StartPoint_Longitude,
        true as Project_Value
		from
		(
        select a.ProjectRegDiaryNumber_Name as DiaryNumber,
        a.Promoter_ID,
        a.Project_ID,
        a.ProjectName,
        a.RERAnumberRegistration,
        a.RERAnumberIssueDate,
        a.RERAnumberRegUptoDate,
		a.Extra2,
		'' as Project_AddressDistrictName,  
		  
		c.EventAction_Type,
		c.EventAction_IdentifiedOn  
		  
		from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
		where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
		and a.Project_ID=c.Related_Project_ID  
		and c.IsActive=1  
		and a.IsActive=1 
		and c.EventAction_Type in (110020, 110023)
        and a.Project_ID not in (10490, 10182, 10462, 10351, 11263)
        and a.ProjectAddressDistrict=p_DistrictCode
		) XY, tbl_rera_project_landdetails PQ
		where
		XY.Project_ID=PQ.ProjectLandRelated_ProjectRegistration_ID
		and PQ.IsActive=1
        and PQ.ProposedProjectLand_StartPoint_Latitude between 29.470013 and 32.463832
        and PQ.ProposedProjectLand_StartPoint_Longitude between 73.850027 and 76.908512
		order by EventAction_IdentifiedOn desc;
    
    END IF;
    
    IF (p_FlagProjectType = 1) THEN -- By Filter (Type of Project)
		
        Select XY.*,
		PQ.ProposedProjectLand_StartPoint_Latitude,
		PQ.ProposedProjectLand_StartPoint_Longitude,
        true as Project_Value
		from
		(
        select a.ProjectRegDiaryNumber_Name as DiaryNumber,
        a.Promoter_ID,
        a.Project_ID,
        a.ProjectName,
        a.RERAnumberRegistration,
        a.RERAnumberIssueDate,
        a.RERAnumberRegUptoDate,
		a.Extra2,
		'' as Project_AddressDistrictName,  
		  
		c.EventAction_Type,
		c.EventAction_IdentifiedOn  
		  
		from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
		where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
		and a.Project_ID=c.Related_Project_ID  
		and c.IsActive=1  
		and a.IsActive=1 
		and c.EventAction_Type in (110020, 110023)
        and a.Project_ID not in (10490, 10182, 10462, 10351, 11263)
        and a.Extra2=p_ProjectType
        and a.ProjectAddressDistrict=p_DistrictCode
		) XY, tbl_rera_project_landdetails PQ
		where
		XY.Project_ID=PQ.ProjectLandRelated_ProjectRegistration_ID
		and PQ.IsActive=1
        and PQ.ProposedProjectLand_StartPoint_Latitude between 29.470013 and 32.463832
        and PQ.ProposedProjectLand_StartPoint_Longitude between 73.850027 and 76.908512
		order by EventAction_IdentifiedOn desc;
        
    END IF; 
end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;
  
end ;;
