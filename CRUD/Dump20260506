CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetComplaint_FormM_All_EmailAddressDetailsByID`(p_Complaint_ID bigint, p_CompRespType_Flag int) RETURNS varchar(4000) CHARSET utf8
BEGIN 
	-- p_Complaint_ID (VALUE)
    -- p_CompRespType_Flag (1/2/3)
    
    declare v_ret varchar(4000);
    declare v_getRespondentType varchar(50); 
    declare v_getRegistrationNumber varchar(100); 
    declare v_getFilterCode bigint; 
          
    IF (p_CompRespType_Flag=1) THEN
		-- Complainant Email Address    
		Select group_concat(Email SEPARATOR ', ') into v_ret from
		(
			select Email from users where Id in 
			(select User_ID from tbl_rera_complaint_formm_regdiarynumber where FormM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1) 
			and EmailConfirmed=1
			
			UNION

			SELECT EmailAddress as Email FROM tbl_rera_complaint_userprofile where UserID in 
			(select User_ID from tbl_rera_complaint_formm_regdiarynumber where FormM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1) 
			and IsActive=1

			UNION

			SELECT Complainant_EmailAddress as Email FROM tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_Complaint_ID and IsActive=1
			
			UNION

			SELECT AuthorizedRepresentativeCounsel_EmailAddress as Email FROM tbl_rera_complaint_formm_details 
			where ComplaintFormM_ID=p_Complaint_ID and IsActive=1

			UNION

			SELECT distinct ComplainantorApplicant_EmailAddress as Email FROM tbl_rera_complaint_formm_additioncomplainant 
			where ComplainantorApplicant_RelatedComplaint_ID=p_Complaint_ID and IsActive=1
			
			UNION
			
			select distinct AE_EmailAddress as Email from tbl_rera_complaint_formm_additionalemail where ComplaintFormM_ID=p_Complaint_ID
			and AE_Designation='Complainant' and IsActive=1 and IsPublicView=1
		) MX;    
    ELSE
		-- Respondent Email Address By Complainants and WebPortal
        IF (p_CompRespType_Flag=2) THEN
        
			SET v_getFilterCode=0;
			-- 'Promoter'/'Agent'/'Allottee'
			SELECT RelatesComplaint_ComplaintAgainstType, RelatesComplaint_ProjectAgent_RERA_RegNumber into v_getRespondentType, v_getRegistrationNumber FROM tbl_rera_complaint_formm_details 
			where ComplaintFormM_ID=p_Complaint_ID and IsActive=1;

			IF (v_getRespondentType='Promoter') THEN
				-- Respondent and Project Emails By WebPortal
                select Project_ID into v_getFilterCode from tbl_rera_ldr_project_reranumber_diarynumber where RERAnumberRegistration=v_getRegistrationNumber and isactive=1;
                
                
				Select group_concat(Email SEPARATOR ', ') into v_ret from
				(
					SELECT Respondent_EmailAddress as Email FROM tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_Complaint_ID and IsActive=1
					
					UNION

					SELECT distinct RespondentM_EmailAddress as Email FROM tbl_rera_complaint_formm_additionrespondent 
					where AdditionRespondentM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1
					
					UNION
					
					select distinct AE_EmailAddress as Email from tbl_rera_complaint_formm_additionalemail where ComplaintFormM_ID=p_Complaint_ID
					and AE_Designation='Respondant' and IsActive=1 and IsPublicView=1
                    
                    UNION                    

					SELECT AuthorizedPerson_EmailAddress as Email FROM tbl_rera_project_registration where ProjectRegistration_ID in 
					(select Project_ID from tbl_rera_project_regdiarynumber where Project_ID=v_getFilterCode and IsActive=1)
					and isactive=1

					UNION

					SELECT Email FROM rera_tbl_promoter where Application_id in 
					(select Promoter_ID from tbl_rera_project_regdiarynumber where Project_ID=v_getFilterCode and IsActive=1) 
					and isactive=1

					UNION

					SELECT Email FROM tbl_rera_promoter_othermemberdetails where Application_id in 
					(select Promoter_ID from tbl_rera_project_regdiarynumber where Project_ID=v_getFilterCode and IsActive=1) 
					and isactive=1
					
					UNION
					
					SELECT distinct AE_EmailAddress as Email FROM tbl_rera_project_additionalemail_project where Project_ID=v_getFilterCode and isactive=1 and IsPublicView=1
					
					UNION
					
					SELECT distinct AE_EmailAddress as Email FROM tbl_rera_project_additionalemail_promoter where Project_ID=v_getFilterCode and isactive=1 and IsPublicView=1
				) MX;
			ELSE 
				IF (v_getRespondentType='Agent') THEN
					-- Respondent and Agent Emails By WebPortal
                    select Agent_ID into v_getFilterCode from tbl_rera_ldr_agent_reranumber_diarynumber where RERAnumberRegistration=v_getRegistrationNumber and isactive=1;
                    
					Select group_concat(Email SEPARATOR ', ') into v_ret from
					(
						SELECT Respondent_EmailAddress as Email FROM tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_Complaint_ID and IsActive=1
						
						UNION

						SELECT distinct RespondentM_EmailAddress as Email FROM tbl_rera_complaint_formm_additionrespondent 
						where AdditionRespondentM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1
						
						UNION
						
						select distinct AE_EmailAddress as Email from tbl_rera_complaint_formm_additionalemail where ComplaintFormM_ID=p_Complaint_ID
						and AE_Designation='Respondant' and IsActive=1 and IsPublicView=1
                        
                        UNION
                        
						SELECT EmailAddress as Email FROM tbl_rera_agent_profile where Agent_ID in 
						(select Agent_ID from tbl_rera_agent_regdiarynumber where Agent_ID=v_getFilterCode and IsActive=1)
						and isactive=1

						UNION

						SELECT EmailAddress as Email FROM tbl_rera_agent_othermemberdetail where Agent_ID in 
						(select Agent_ID from tbl_rera_agent_regdiarynumber where Agent_ID=v_getFilterCode and IsActive=1) 
						and isactive=1
						
						UNION
						
						select distinct AE_EmailAddress as Email from tbl_rera_agent_additionalemail_realestateagent where Agent_ID=v_getFilterCode and IsActive=1 and IsPublicView=1
					) MX;
				ELSE
					-- Respondent Emails
					Select group_concat(Email SEPARATOR ', ') into v_ret from
					(
						SELECT Respondent_EmailAddress as Email FROM tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_Complaint_ID and IsActive=1
						
						UNION

						SELECT distinct RespondentM_EmailAddress as Email FROM tbl_rera_complaint_formm_additionrespondent 
						where AdditionRespondentM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1
						
						UNION
						
						select distinct AE_EmailAddress as Email from tbl_rera_complaint_formm_additionalemail where ComplaintFormM_ID=p_Complaint_ID
						and AE_Designation='Respondant' and IsActive=1 and IsPublicView=1
					) MX;
				END IF;
			END IF;        
        ELSE
			-- Respondent Emails By Complainants
			Select group_concat(Email SEPARATOR ', ') into v_ret from
			(
				SELECT Respondent_EmailAddress as Email FROM tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_Complaint_ID and IsActive=1
				
				UNION

				SELECT distinct RespondentM_EmailAddress as Email FROM tbl_rera_complaint_formm_additionrespondent 
				where AdditionRespondentM_RelatedComplaint_ID=p_Complaint_ID and IsActive=1
				
				UNION
				
				select distinct AE_EmailAddress as Email from tbl_rera_complaint_formm_additionalemail where ComplaintFormM_ID=p_Complaint_ID
				and AE_Designation='Respondant' and IsActive=1 and IsPublicView=1
			) MX;
        END IF;
    END IF;

	IF (v_ret IS NULL) THEN   
	SET v_ret = 'NA';
	END IF;
    
    RETURN v_ret; 
END ;;
DELIMITER ;
