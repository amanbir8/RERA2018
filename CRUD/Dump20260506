CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_AgentProfileOfflineRegistrations_ByParms`(  
  p_Agent_ID bigint,
  p_AgentType_ID int,
  p_RenewalAgent_ID bigint,
  p_RenewalAgent_SequenceID int,
  p_RenewalAgent_YearID int,
  p_AgentRERAnumber varchar(120),
  p_UserRole varchar(120)
)
BEGIN 

-- OFFLINE AGENT CASE

SELECT 
	OfflineAgents_IndexID as AgentRenewal_RefRegistration_regRERA_IndexID,
	OfflineAgents_ID as AgentRenewal_RefRegistration_regRERA_ID,
	p_RenewalAgent_ID as RenewalAgent_ID,
	p_RenewalAgent_SequenceID as RenewalOrderSequence,
	p_RenewalAgent_YearID as RelatedRenewalAgent_Year,
	p_Agent_ID as Related_Agent_ID,
	'OFFLINE' as Related_AgentDiaryNumber_Name,
	p_AgentType_ID as Related_Agent_Type,
	CreatedBy as Related_UserID,
	OfflineAgents_RERAregistrationNumber as Related_RERAnumberRegistration,
	101 as Related_Agent_RefRegistrations_RERA_ID,
	OfflineAgents_RERAregistrationNumber as RERAregistration_Number,
	OfflineAgents_RERAregistrationIssueDate as RERAregistration_IssueDate,
	OfflineAgents_RERAregistrationValidUptoDate as RERAregistration_ExpiryDate,
    CASE
		WHEN OfflineAgents_RemarksIfAny like 'FormJ%' THEN OfflineAgents_ReferenceNumber
        WHEN Length(OfflineAgents_ReferenceNumber)>4 THEN Concat('Offline (', OfflineAgents_ReferenceNumber, ')')
		ELSE 'Offline (NA)'
	END as Agent_Reference_DiaryNumber,
    '0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
    OfflineAgents_AgentName_OrganizationName as Agent_Name,    
    CASE
		WHEN (p_AgentType_ID<>0) THEN
		CASE
			WHEN p_AgentType_ID = 1 THEN 'Individual'
			WHEN p_AgentType_ID = 2 THEN 'Other Than Individual' 
            ELSE 'NA'
		END
	ELSE
		CASE
			WHEN Length(OfflineAgents_AgentType)>4 THEN OfflineAgents_AgentType
			ELSE 'NA'
		END
	END AS Agent_Type,
    -- CASE
	-- 	WHEN p_AgentType_ID = 1 THEN 'Individual'
	-- 	WHEN p_AgentType_ID = 2 THEN 'Other Than Individual'
	-- 	ELSE 'NA'
	-- END as Agent_Type,
	'' as ImageRERAcert_FileName,
	'' as ImageRERAcert_FilePath,
	OfflineAgents_RemarksIfAny as Remarks_IfAny,
	1 as IsActive,
	1 as IsActiveProvider,
	1 as IsDraft,
	1 as IsLock,
	1 as IsPublicView,
	0 as IsConditional,
	CreatedOn,
	CreatedBy,
	ModifyOn,
	ModifyBy,
    
    '' as PublicViewRERAcert_DiaryNumber,
    '' as PublicViewRERAcert_DocumentTitle,
    '' as PublicViewRERAcert_Category,
	'' as PublicViewRERAcert_ReferenceNumber,
	'0001-01-01 00:00:00.000' as PublicViewRERAcert_IssueDate,
    '' as PublicViewRERAcert_FilePath,
	'' as PublicViewRERAcert_FileName, 
    1 as PublicViewRERAcert_IsPublicView,
    '' as A_Column,
	'' as B_Column,    
    '0001-01-01 00:00:00.000' as PublicViewRERAcert_CreatedOn,
    '' as PublicViewRERAcert_CreatedBy,
    '0001-01-01 00:00:00.000' as PublicViewRERAcert_ModifyOn,
    '' as PublicViewRERAcert_ModifyBy
    
from tbl_rera_agent_offlineagents_pendinguploads 
where IsActive=1
and OfflineAgents_RERAregistrationNumber = p_AgentRERAnumber
-- and OfflineAgents_RERAregistrationNumber in (select Existing_RERANumber from tbl_rera_agent_profile 
-- where Agent_ID=p_Agent_ID and Agent_Type=p_AgentType_ID and isactive=1)
and CreatedBy <> 'J'

    
UNION

-- RENEWAL AGENT CASE

SELECT
	m.AgentRegRenewal_DiaryNumber_IndexID as AgentRenewal_RefRegistration_regRERA_IndexID,
	m.AgentRegRenewal_DiaryNumber_ID as AgentRenewal_RefRegistration_regRERA_ID,
	m.RelatedRenewalAgent_ID as RenewalAgent_ID,
	m.RenewalOrderSequence as RenewalOrderSequence,
	m.RelatedRenewalAgent_Year as RelatedRenewalAgent_Year,
	m.RelatedAgent_ID as Related_Agent_ID,
	m.RelatedAgentDiaryNumber_Name as Related_AgentDiaryNumber_Name,
	m.Agent_Type as Related_Agent_Type,
	m.UserID as Related_UserID,
	m.RenewalAgentRegistrationNumber as Related_RERAnumberRegistration,
	CASE
		WHEN m.RelatedAgentDiaryNumber_Name='OFFLINE' THEN 111		
		ELSE 122
	END as Related_Agent_RefRegistrations_RERA_ID,
	m.RenewalAgentRegistrationNumber as RERAregistration_Number,
	m.RenewalAgentRegistrationIssueDate as RERAregistration_IssueDate,
	m.RenewalAgentRegistrationRegUptoDate as RERAregistration_ExpiryDate,
    
    m.RelatedRenewalAgentRegDiaryNumber_Name as Agent_Reference_DiaryNumber,
    '0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
    udfn_GetAgentNameByRenewal(m.RelatedAgent_ID,m.RelatedRenewalAgent_ID) as Agent_Name,
    CASE
		WHEN m.Agent_Type = 1 THEN 'Individual'
		WHEN m.Agent_Type = 2 THEN 'Other Than Individual'
		ELSE 'UnKnown'
	END as Agent_Type,
	'' as ImageRERAcert_FileName,
	'' as ImageRERAcert_FilePath,
	m.Remarks_IfAny as Remarks_IfAny,
	m.IsActive as IsActive,
	m.IsActiveProvider as IsActiveProvider,
	m.IsDraft as IsDraft,
	m.IsLock as IsLock,
	m.IsPublicView as IsPublicView,
	m.IsConditionAnnexureIssued as IsConditional,
	m.CreatedOn,
	m.CreatedBy,
	m.ModifyOn,
	m.ModifyBy,


    n.RelatedRenewalAgentDiaryNumber_Name as PublicViewRERAcert_DiaryNumber,
    n.AgentRERAcert_InfoName as PublicViewRERAcert_DocumentTitle,
    '' as PublicViewRERAcert_Category,
	n.AgentRERAcert_ReferenceNumber as PublicViewRERAcert_ReferenceNumber,
	n.AgentRERAcert_IssueDate as PublicViewRERAcert_IssueDate,
    n.AgentRERAcert_FilePath as PublicViewRERAcert_FilePath,
	n.AgentRERAcert_FileName as PublicViewRERAcert_FileName, 
    n.IsPublicView as PublicViewRERAcert_IsPublicView,
    '' as A_Column,
	'' as B_Column,  
    n.CreatedOn as PublicViewRERAcert_CreatedOn,
    '' as PublicViewRERAcert_CreatedBy,
    n.ModifyOn as PublicViewRERAcert_ModifyOn,
    '' as PublicViewRERAcert_ModifyBy
    
FROM
(select 
	AgentRegRenewal_DiaryNumber_IndexID,
	AgentRegRenewal_DiaryNumber_ID,
	RelatedRenewalAgent_ID,
	RenewalOrderSequence,
	RelatedRenewalAgent_Year,
	RelatedAgent_ID,
	RelatedAgentDiaryNumber_Name,
	Agent_Type,
	UserID,
	RenewalAgentRegistrationNumber,
	RenewalAgentRegistrationIssueDate,
	RenewalAgentRegistrationRegUptoDate,    
    RelatedRenewalAgentRegDiaryNumber_Name,
	Remarks_IfAny,
	IsActive,
	IsActiveProvider,
	IsDraft,
	IsLock,
	IsPublicView,
	IsConditionAnnexureIssued,
	CreatedOn,
	CreatedBy,
	ModifyOn,
	ModifyBy
    
from tbl_rera_ldr_agent_reranumber_renewalregistration
where RelatedAgent_ID=p_Agent_ID 
-- and RelatedRenewalAgent_ID=p_RenewalAgent_ID
-- and RenewalOrderSequence=p_RenewalAgent_SequenceID
-- and RelatedRenewalAgent_Year=p_RenewalAgent_YearID
and Agent_Type=p_AgentType_ID
and IsActive=1
and IsDraft in (0,1,4,5,6)
-- and IsLock=1
and IsPublicView in (0,1)
) m
Left Outer Join
(select * from tbl_rera_ldr_agent_reracertificate_renewalregistration
where IsActive=1 
-- and IsDraft=1
and IsPublicView=1) n
On
m.RelatedAgent_ID=n.RelatedAgent_ID and
m.RelatedRenewalAgent_ID=n.RelatedRenewalAgent_ID and
m.RelatedRenewalAgent_Year=n.RelatedRenewalAgent_Year and
m.RenewalOrderSequence=n.RenewalOrderSequence and
m.RenewalAgentRegistrationNumber=n.RenewalRegistrationNumber

order by RERAregistration_IssueDate asc;

END ;;
