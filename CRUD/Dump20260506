)
BEGIN
    DECLARE v_checkInstitutionFormN int;
    DECLARE v_OldInstitutionID BIGINT;
    DECLARE v_OldCreatedOn DATETIME(3);
    DECLARE v_Institution_Ref_ID BIGINT DEFAULT 0;
    DECLARE v_Institution_Ref_Year INT DEFAULT 0;
    DECLARE v_Institution_Ref_Number VARCHAR(50) DEFAULT '';
