CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formn_institution`(
    IN p_InstitutionFormN_IndexID BIGINT,
    IN p_InstitutionFormN_ID BIGINT,
    IN p_InstitutionFormN_Code VARCHAR(50),    
    IN p_Profile_ID BIGINT,
    IN p_User_ID VARCHAR(50),
    IN p_Related_ComplaintFormN_ID BIGINT,
    IN p_Related_ComplaintFormN_Code VARCHAR(50),
    IN p_Related_ComplaintDiaryNumber VARCHAR(50),
    IN p_ComplaintType_MN VARCHAR(50),
	IN p_Date_of_Filing DATETIME(3),
    IN p_IsSameDiaryNumberWithInstitutionNumber INT,
    IN p_Institution_Ref_ID BIGINT,
    IN p_Institution_Ref_Year INT,
    IN p_Institution_Ref_Number VARCHAR(50),
    IN p_Institution_Ref_Date DATETIME,
    IN p_IsManualAssignBench INT,
    IN p_CaseAssignement_BenchID BIGINT,
    IN p_CaseAssignement_BenchName VARCHAR(150),
    IN p_CaseAssignement_BenchDescription VARCHAR(150),
    IN p_CaseAssignement_BenchLocation VARCHAR(150),
    IN p_NatureOfComplaint_Statement VARCHAR(1000),
    IN p_NatureOfComplaint_Key1 VARCHAR(150),
    IN p_NatureOfComplaint_Key2 VARCHAR(150),
    IN p_NatureOfComplaint_Key3 VARCHAR(150),
    IN p_ReliefSought_Statement VARCHAR(1000),
    IN p_Dak_Number VARCHAR(50),
    IN p_Dak_Date DATETIME,
    IN p_IsComplaintHardcopySetYesNo INT,
    IN p_HardcopySetNumber INT,
    IN p_NumberOfComplainant INT,
    IN p_NumberOfRespondent INT,
    IN p_Remarks_IfAny VARCHAR(1500),
    IN p_A_column VARCHAR(50),
    IN p_B_column VARCHAR(50),
    IN p_C_column VARCHAR(50),
    IN p_D_column VARCHAR(50),
    IN p_E_column VARCHAR(50),
    IN p_F_column DATETIME,
    IN p_IsActive INT,
    IN p_IsDraft INT,
    IN p_IsLock INT,
    IN p_IsLockRefNumber INT,
    IN p_IsPublicView INT,
    IN p_CreatedBy VARCHAR(50),
    IN p_CreatedOn DATETIME,
    IN p_ModifyBy VARCHAR(50),
    IN p_ModifyOn DATETIME,
    OUT p_valoutput BIGINT
)
BEGIN
    DECLARE v_LastID BIGINT DEFAULT 0;
    DECLARE v_NewInstitutionID BIGINT;
    DECLARE v_Institution_Ref_ID BIGINT DEFAULT 0;
    DECLARE v_Institution_Ref_Year INT DEFAULT 0;
    DECLARE v_Institution_Ref_Number VARCHAR(50) DEFAULT '';
    DECLARE v_Profile_ID BIGINT DEFAULT 0;
    DECLARE v_User_ID VARCHAR(50) DEFAULT '';
    declare v_GetIsLockRefNumber INT DEFAULT 0;
    declare v_checkcntIsLockRefNumber INT DEFAULT 0;
	declare v_GetComplaint_Institution_Ref_Number varchar(50);         
	declare v_PutComplaint_Institution_Ref_Number varchar(50);         
	declare v_GetComplaint_Institution_Ref_ID bigint;  
	declare v_PutComplaint_Institution_Ref_ID bigint; 
    
-- Update Case
declare val_Related_Profile_ID BIGINT;
declare val_Related_User_ID VARCHAR(50);
declare val_Related_ComplaintFormN_ID BIGINT;
declare val_Related_ComplaintFormN_Code VARCHAR(50);
declare val_Related_ComplaintDiaryNumber VARCHAR(50);
declare val_ComplaintType_MN VARCHAR(50);
declare val_Date_of_Filing DATETIME(3);
declare val_IsSameDiaryNumberWithInstitutionNumber INT;
