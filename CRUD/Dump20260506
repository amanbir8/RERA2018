if v_getPromoterType=2
then
if v_getAnnualReport='Y'
then
select * from tbl_RERA_Master_Promoter_Documents where PromoterDoc_ValidCode = 2 and PromoterDoc_ValidSubCode in (1,3) and IsActive=1 
order by PromoterDocMaster_InfoName asc;
else
select * from tbl_RERA_Master_Promoter_Documents where PromoterDoc_ValidCode = 2 and PromoterDoc_ValidSubCode in (1,2) and IsActive=1 
order by PromoterDocMaster_InfoName asc;
end if;
end if;

