CREATE DEFINER=`sa`@`%` PROCEDURE `Update_UserActivityLog`(	
    p_userid varchar(100),
    p_LogoutTime DATETIME
)
BEGIN


    DECLARE v_logid INT DEFAULT NULL;

    -- Get latest active (not logged out) record
    SELECT log_id INTO v_logid
    FROM log_user
    WHERE user_id = p_userid
   -- AND sign_outtime IS NULL
    ORDER BY log_id DESC
    LIMIT 1;

    -- Update only that record
    IF v_logid IS NOT NULL THEN
        UPDATE log_user
        SET sign_outtime = p_LogoutTime
        WHERE log_id = v_logid;
    END IF;

/*UPDATE log_user
SET sign_outtime = p_LogoutTime
WHERE user_id = p_userid
AND sign_outtime IS NULL
ORDER BY log_id DESC
LIMIT 1;*/

END ;;
