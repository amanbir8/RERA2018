		where AgentRenewal_ID=p_Related_RenewalAgent_ID and AgentRenewal_Year=p_Related_RenewalAgent_Year and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
		and Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number
		and IsActive=1; 

		update tbl_rera_agent_renewal_regdiarynumber set IsActive=2, IsActiveProvider=0
		where AgentRenewal_ID=p_Related_RenewalAgent_ID and AgentRenewal_Year=p_Related_RenewalAgent_Year and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
		and Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number
		and RenewalAgentDiaryNumber_Name=v_GetExistingRNAgentRegDiaryNumber_Name
		and IsActive=1;	  



		-- ------- Generate New Diary Number (Application Modification)---------- 
		INSERT INTO tbl_rera_agent_renewal_regdiarynumber        
		(        
			-- RenewalAgentDiaryNumber_IndexID,
			RenewalAgentDiaryNumber_ID,
			RenewalAgentDiaryNumber_Name,
			RenewalAgentDiaryNumber_NameYear,
			Agent_ID,
			AgentRenewal_ID,
			AgentRenewal_Year,
