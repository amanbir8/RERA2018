CREATE DEFINER=`sa`@`%` PROCEDURE `Display_RERA_CP_AgentRegistrationDetailsForRevoke_ByID`(      
 p_RegistrationNumber varchar(250),
 p_UserRole varchar(250)
)
begin
 
declare vcheckcnt int;
declare vgetrenewalagentid bigint(20);
declare vgetrenewalagentyear int(11);
declare vgetrenewalregdnumber varchar(150);
declare vgetrenewalregdissuedate datetime(3);
declare vgetrenewalregduptodate datetime(3);
declare vgetrenewaldiarynumber varchar(150);

set vgetrenewalregdissuedate='0001-01-01 00:00:00.000';
set vgetrenewalregduptodate='0001-01-01 00:00:00.000';
set vcheckcnt=0;
set vgetrenewaldiarynumber='';
set vgetrenewalregdnumber='';
set vgetrenewalagentyear=0;
set vgetrenewalagentid=0;

select count(*) into vcheckcnt from tbl_rera_ldr_agent_reranumber_renewalregistration
where RERAnumberRegistration=p_RegistrationNumber
and isactive=1; 

if (vcheckcnt <> 0)
then
 	set vcheckcnt=1;
    
 	select RelatedRenewalAgent_ID, RelatedRenewalAgent_Year, RenewalAgentRegistrationNumber, RenewalAgentRegistrationIssueDate, RenewalAgentRegistrationRegUptoDate, RelatedRenewalAgentRegDiaryNumber_Name 
    into vgetrenewalagentid, vgetrenewalagentyear, vgetrenewalregdnumber, vgetrenewalregdissuedate, vgetrenewalregduptodate, vgetrenewaldiarynumber
	from tbl_rera_ldr_agent_reranumber_renewalregistration
 	where RERAnumberRegistration=p_RegistrationNumber
 	and isactive=1
    and IsActiveProvider=1
    Limit 1; 
end if;

select
a.Agent_ID as prmAgent_ID,
b.Agent_Type as prmAgent_Type,
a.AgentRegDiaryNumber_Name as prmAgentRegDNumber_Name,
vgetrenewaldiarynumber as prmLatestRenewalRegDNumber_Name,
a.RERAnumberRegistration as prmRERAnumberRegistration,
a.RERAnumberIssueDate as prmRERAnumberIssueDate,
a.RERAnumberRegUptoDate as prmRERAnumberRegUptoDate,
vcheckcnt as prmIsRenewalRegistration,
vgetrenewalagentid as prmRenewalAgent_ID,
vgetrenewalagentyear as prmRenewalAgent_Year,
vgetrenewalregdnumber as prmLatestRenewalRegistrationNumber,
vgetrenewalregdissuedate as prmLatestRenewalRegistrationIssueDate,
vgetrenewalregduptodate as prmLatestRenewalRegistrationUptoDate,
concat(b.Agent_FirstName, space(1), b.Agent_MiddleName, space(1), b.Agent_LastName) as prmAgentName,
b.Organization_Name as prmOrganizationName,
CASE
    WHEN b.Agent_Type=1 THEN concat(b.Agent_FirstName, space(1), b.Agent_MiddleName, space(1), b.Agent_LastName)
    WHEN b.Agent_Type=2 THEN concat(b.AuthorizedSignatory_FirstName, space(1), b.AuthorizedSignatory_MiddleName, space(1), b.AuthorizedSignatory_LastName)
    ELSE 'NA'
END as prmAuthorizedPersonName,
CASE
    WHEN b.Agent_Type=1 THEN P_AddressDistrictCode
    WHEN b.Agent_Type=2 THEN RegOffice_AddressDistrictCode
    ELSE P_AddressDistrictCode
END as prmAgentRegisteredDistrict,
b.BusinessPlace_AddressDistrictCode as prmAgentBussinessPlaceDistrict
from tbl_rera_ldr_agent_reranumber_diarynumber a, tbl_rera_agent_profile b
where a.isactive=1
and b.isactive=1
and a.Agent_ID=b.Agent_ID
and a.RERAnumberRegistration=p_RegistrationNumber
Limit 1;  

end ;;
