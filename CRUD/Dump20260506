	p_RelatedProjectID bigint,
	p_RelatedPromoterID bigint,
	p_PaymentType bigint
 )
begin 

declare putProjectZoneCode int;
declare putNumberYearFormB int;
declare putTotalArea decimal(18,4);
declare putPlottedArea decimal(18,4);
declare putGroupHousingArea decimal(18,4);
declare putCommercialArea decimal(18,4);
declare putIndustrialArea decimal(18,4);
declare putCommonArea decimal(18,4);
declare putOtherCommonArea decimal(18,4);
declare putEWSArea decimal(18,4);

declare getCount int;


DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;


Select count(*) into getCount from tbl_RERA_Project_LandDetails
where ProjectLandRelated_ProjectRegistration_ID=p_RelatedProjectID
and IsActive=1;


if (getCount<>0) then

	set putProjectZoneCode=0;
    set putNumberYearFormB=0;
	set putTotalArea=0;
	set putPlottedArea=0;
	set putGroupHousingArea=0;
	set putCommercialArea=0;
	set putIndustrialArea=0;
	set putCommonArea=0;
	set putOtherCommonArea=0;
	set putEWSArea=0;

	select 
	ProposedLand_TobeDeveloped_Area_Total,
	ProposedLand_Area_ResidentialPlotted,
	ProposedLand_Area_ResidentialGroupHousing,
	ProposedLand_Area_Commercial,
	ProposedLand_Area_Industrial,
	ProposedLand_Area_A_column,
	ProposedLand_Area_B_column,
    ProposedLand_Area_C_column
	into
	putTotalArea,
	putPlottedArea,
	putGroupHousingArea,
	putCommercialArea,
	putIndustrialArea,
	putCommonArea,
	putOtherCommonArea,
    putEWSArea
	from tbl_RERA_Project_LandDetails
	where ProjectLandRelated_ProjectRegistration_ID=p_RelatedProjectID
	and IsActive=1;


	select Project_PotentialZoneCode, ceil((timestampdiff(MONTH, ProjectStart_Date, ProjectCompletion_OriginalDate)-1)/12)
    into putProjectZoneCode, putNumberYearFormB 
    from tbl_rera_project_registration
	where ProjectRegistration_ID=p_RelatedProjectID
	and Promoter_ID=p_RelatedPromoterID
	and IsActive=1;


	Select 
	p_RelatedProjectID as qRelatedProjectID,
	p_RelatedPromoterID as qRelatedPromoterID,
	p_PaymentType as qProjectPaymentType,
	putProjectZoneCode as qProjectZoneCode,
    putNumberYearFormB as qNumberYearFormB,
	putTotalArea as qLandTotalArea,
	putPlottedArea as qLandPlottedArea,
	putGroupHousingArea as qLandGroupHousingArea,
	putCommercialArea as qLandCommercialArea,
	putIndustrialArea as qLandIndustrialArea,
	putCommonArea as qLandCommonArea,
	putOtherCommonArea as qLandOtherCommonArea,
    putEWSArea as qLandEWSArea;

else

	Select 
	p_RelatedProjectID as qRelatedProjectID,
	p_RelatedPromoterID as qRelatedPromoterID,
	p_PaymentType as qProjectPaymentType,
	0 as qProjectZoneCode,
    0 as qNumberYearFormB,
	0 as qLandTotalArea,
	0 as qLandPlottedArea,
	0 as qLandGroupHousingArea,
	0 as qLandCommercialArea,
	0 as qLandIndustrialArea,
	0 as qLandCommonArea,
	0 as qLandOtherCommonArea,
    0 as qLandEWSArea;

end if;



IF `_rollback` THEN
ROLLBACK;
ELSE
COMMIT;
END IF;

