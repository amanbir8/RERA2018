 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;

set vgetextnregduptodate='0001-01-01 00:00:00.000';
set vcheckcnt=0;
set vgetextndiarynumber='';


select count(*) into vcheckcnt from tbl_rera_ldr_project_reranumber_extensionform
where RERAnumberRegistration like p_RequestRERAcode
and isactive=1; 


if (vcheckcnt <> 0)
then
	set vcheckcnt=1;

	select RERAnumberRegistration, ExtnRegistrationRegUptoDate, RelatedExtnRegDiaryNumber_Name into vgetregdnumber, vgetextnregduptodate, vgetextndiarynumber
	from tbl_rera_ldr_project_reranumber_extensionform
