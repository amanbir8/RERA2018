	p_userrolesRoleId varchar(250),    
	p_A_column varchar(250),
	p_B_column varchar(250),
	p_IsActive int,
	p_IsDraft int,
	p_CreatedBy varchar(150),
	p_CreatedOn datetime,
	p_ModifyBy varchar(150),
	p_ModifyOn datetime,
	out p_valreturn varchar(150)
)
BEGIN

declare v_chkUserNameCount int;  
declare v_chkUserNameLogCount int;

declare v_Get_AdditionalUserName_ID bigint;
declare v_Put_AdditionalUserName_ID bigint;
declare v_RetMessageNumber varchar(256);

-- HLD table USER PROFILE Details
declare var_Id varchar(128);
declare var_Email varchar(256);
declare var_EmailConfirmed tinyint(1);
declare var_PasswordHash longtext;
declare var_SecurityStamp longtext;
declare var_PhoneNumber longtext;
declare var_PhoneNumberConfirmed tinyint(1);
declare var_TwoFactorEnabled tinyint(1);
declare var_LockoutEndDateUtc datetime;
declare var_LockoutEnabled tinyint(1);
declare var_AccessFailedCount int(11);
declare var_UserName varchar(256);

declare var_userrolesUserId varchar(256);
declare var_userrolesRoleId varchar(256);

declare v_cntRegistrationNumber int;
declare v_cntRegistrationRoleCode int;

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;

-- START verify (Registration Number)
select count(Email) into v_cntRegistrationNumber 
from users where Id=p_usersId and UserName=p_usersUserName;

if (v_cntRegistrationNumber<>0) then

SELECT
	Id,
	Email,
	EmailConfirmed,
	PasswordHash,
	SecurityStamp,
	PhoneNumber,
	PhoneNumberConfirmed,
	TwoFactorEnabled,
	LockoutEndDateUtc,
	LockoutEnabled,
	AccessFailedCount,
	UserName
INTO
	var_Id,
	var_Email,
	var_EmailConfirmed,
	var_PasswordHash,
	var_SecurityStamp,
	var_PhoneNumber,
	var_PhoneNumberConfirmed,
	var_TwoFactorEnabled,
	var_LockoutEndDateUtc,
	var_LockoutEnabled,
	var_AccessFailedCount,
	var_UserName
FROM users 
WHERE Id=p_usersId 
AND UserName=p_usersUserName;


SELECT 
	UserId,
	RoleId
INTO
	var_userrolesUserId,
	var_userrolesRoleId
FROM userroles
WHERE UserId=p_usersId;

-- Application ID for History Logs (Email and Phone By UserName)
select max(UserManager_EmailPhoneNumber_ID) into v_Get_AdditionalUserName_ID from tbl_rera_hdcr_users_emailphonenumberdetails;
if (v_Get_AdditionalUserName_ID IS NULL)    
then    
  set v_Put_AdditionalUserName_ID=1001;   
else     
  set v_Put_AdditionalUserName_ID=v_Get_AdditionalUserName_ID+1;
end if;

-- History Logs (Email and Phone By UserName)
INSERT INTO tbl_rera_hdcr_users_emailphonenumberdetails  
(      
	-- UserManager_EmailPhoneNumber_IndexID,
	UserManager_EmailPhoneNumber_ID,
	PUC_Reference_Name,
	PUC_Reference_Date,
	PUC_RequestCategoryID,
	IsPublicView,
	IsApproved,
	Account_FormDate,
	Account_ToDate,
	Approved_AccountDate,
	Approved_AccountBy,       
	hdcr_Id,
	hdcr_Email,
	hdcr_EmailConfirmed,
	hdcr_PasswordHash,
	hdcr_SecurityStamp,
	hdcr_PhoneNumber,
	hdcr_PhoneNumberConfirmed,
	hdcr_TwoFactorEnabled,
	hdcr_LockoutEndDateUtc,
	hdcr_LockoutEnabled,
	hdcr_AccessFailedCount,
	hdcr_UserName,
	hdcr_userroles_UserId,
	hdcr_userroles_RoleId
)
VALUES  
(  
	-- p_UserManagerAuthority_IndexID,
	v_Put_AdditionalUserName_ID, -- p_UserManagerAuthority_ID,
	'', -- PUC_Reference_Name,
	NOW(), -- PUC_Reference_Date,
	0, -- PUC_RequestCategoryID,
	1, -- IsPublicView,
	1, -- IsApproved,
    var_LockoutEndDateUtc, -- Account_FormDate
    NOW(), -- Account_ToDate
    NOW(), -- Approved_AccountDate
    p_CreatedBy,
	var_Id,
	var_Email,
	var_EmailConfirmed,
	var_PasswordHash,
	var_SecurityStamp,
	var_PhoneNumber,
	var_PhoneNumberConfirmed,
	var_TwoFactorEnabled,
	var_LockoutEndDateUtc,
	var_LockoutEnabled,
	var_AccessFailedCount,
	var_UserName,
	var_userrolesUserId,
	var_userrolesRoleId
);

-- Update Existing UserProfile (Email and Phone Number)
UPDATE users 
SET Email=p_usersEmail, EmailConfirmed=p_usersEmailConfirmed, PhoneNumber=p_usersPhoneNumber, PhoneNumberConfirmed=p_usersPhoneNumberConfirmed, TwoFactorEnabled=p_usersTwoFactorEnabled                  
WHERE Id=p_usersId AND UserName=p_usersUserName;

set v_RetMessageNumber=v_Put_AdditionalUserName_ID;

-- END verify (Registration Number)
else
	set v_RetMessageNumber='Invalid User Profile';
end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

set p_valreturn=v_RetMessageNumber; 

END ;;
