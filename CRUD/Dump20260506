 p_UserRole varchar(250)
)
begin
 
declare vcheckcnt int;
declare vgetregdnumber varchar(150);
declare vgetextnregduptodate datetime(3);
declare vgetextndiarynumber varchar(150);

declare vcheckpucdiarycnt int;
declare vgetEventAction_Type bigint;
