CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_tbl_rera_project_CP_FileRearrangementPanel`(
	p_ProjectDoc_IndexID bigint(20),
	p_ProjectDoc_ID bigint(20),
	p_Promoter_ID bigint(20),
	p_Project_ID bigint(20),    
    p_User_ID varchar(150),
    p_User_Role varchar(150),
    
	p_ProjectDoc_InfoCode int,
	p_ProjectDoc_InfoName varchar(250),    
	p_ProjectDoc_RelatedSectionName varchar(250),
	p_ProjectDoc_ReferenceNumber varchar(250),
	p_ProjectDoc_IssueDate datetime,    
	p_ProjectDoc_FileSize varchar(250),
    p_ProjectDoc_FileFormat varchar(250),
    p_ProjectDoc_FilePath varchar(250),
    p_ProjectDoc_FileName varchar(250),
	p_ProjectDoc_IsGroup int,
    
	p_Remarks_IfAny varchar(500),    
    p_A_column varchar(250),
    p_B_column varchar(250),
    p_C_column varchar(250),
    p_D_column varchar(250),    
	p_IsActive int,
	p_IsDraft int,
	p_CreatedBy varchar(250),
	p_CreatedOn datetime,
	p_ModifyBy varchar(250),
    p_ModifyOn datetime,    
    
	p_Project_DiaryNumber varchar(250),
	p_RERA_RegistrationNumber varchar(100),
	p_RERAnumberIssueDate datetime,
	p_RERAnumberRegUptoDate datetime,
	p_ProjectName varchar(350),
	p_PromoterName varchar(350),
    p_ProjectAddressDistrict varchar(250),
	p_IsRERAregisteredProject int,    
	p_Extra01_column varchar(250),
	p_Extra02_column varchar(250),
    
	p_Application_SearchTypeFlag int,
	p_RERAnumberRegistration_Input varchar(100),
	p_ProjectDiaryNumber_Input varchar(100),
	p_IsUpdateModifyFlag_ProjectDocument int,
	p_ProjectDoc_InfoCode_Input int,
    p_ProjectDoc_InfoCode_ConfirmInput int,
    p_ProjectDoc_ReferenceNumber_Input varchar(250),
    p_Remarks_IfAny_Input varchar(500),
	out p_valreturn varchar(250)
)
BEGIN

declare val_ProjectDoc_IndexID bigint(20);
declare val_ProjectDoc_ID bigint(20);
declare val_Promoter_ID bigint(20);
declare val_Project_ID bigint(20);
declare val_ProjectDoc_InfoCode int(11);
declare val_ProjectDoc_InfoName varchar(90);
declare val_ProjectDoc_RelatedSectionName varchar(90);
declare val_ProjectDoc_ReferenceNumber varchar(90);
declare val_ProjectDoc_IssueDate datetime(3);
declare val_ProjectDoc_FileSize varchar(50);
declare val_ProjectDoc_FileFormat varchar(50);
declare val_ProjectDoc_FilePath varchar(250);
declare val_ProjectDoc_FileName varchar(250);
declare val_ProjectDoc_IsGroup int(11);
declare val_Remarks_IfAny varchar(300);
declare val_A_column varchar(500);
declare val_B_column varchar(50);
declare val_C_column varchar(50);
declare val_D_column varchar(50);
declare val_IsActive int(11);
declare val_IsDraft int(11);
declare val_CreatedBy varchar(50);
declare val_CreatedOn datetime(3);
declare val_ModifyBy varchar(50);
declare val_ModifyOn datetime(3);

declare var_count int(11);
declare var_message varchar(190);
declare v_Get_ProjectPUC_DocumentName_ID bigint(20);
declare v_Put_ProjectPUC_DocumentName_ID bigint(20);

declare v_ProjectDocMaster_InfoCode int(11); 
declare v_ProjectDocMaster_InfoName varchar(90); 
declare v_ProjectDocMaster_RelatedSectionName varchar(90);

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

set var_message='Error';

select count(ProjectDoc_InfoCode) into var_count from tbl_rera_project_documents
where IsActive=1 and IsDraft in (1,4,5,6)
and ProjectDoc_IndexID=p_ProjectDoc_IndexID
and ProjectDoc_ID=p_ProjectDoc_ID
and Promoter_ID=p_Promoter_ID
and Project_ID=p_Project_ID;

if (var_count <> 0) then
	-- extract record of documents
	select ProjectDoc_IndexID, ProjectDoc_ID, Promoter_ID, Project_ID, ProjectDoc_InfoCode, ProjectDoc_InfoName, ProjectDoc_RelatedSectionName, ProjectDoc_ReferenceNumber,
	  ProjectDoc_IssueDate, ProjectDoc_FileSize, ProjectDoc_FileFormat, ProjectDoc_FilePath, ProjectDoc_FileName, ProjectDoc_IsGroup, Remarks_IfAny,
	  A_column, B_column, C_column, D_column, IsActive, IsDraft, CreatedBy, CreatedOn, ModifyBy, ModifyOn
	into
	  val_ProjectDoc_IndexID, val_ProjectDoc_ID, val_Promoter_ID, val_Project_ID, val_ProjectDoc_InfoCode, val_ProjectDoc_InfoName, val_ProjectDoc_RelatedSectionName, val_ProjectDoc_ReferenceNumber,
	  val_ProjectDoc_IssueDate, val_ProjectDoc_FileSize, val_ProjectDoc_FileFormat, val_ProjectDoc_FilePath, val_ProjectDoc_FileName, val_ProjectDoc_IsGroup, val_Remarks_IfAny,
	  val_A_column, val_B_column, val_C_column, val_D_column, val_IsActive, val_IsDraft, val_CreatedBy, val_CreatedOn, val_ModifyBy, val_ModifyOn
	from tbl_rera_project_documents where IsActive=1 and IsDraft in (1,4,5,6)
	and ProjectDoc_IndexID=p_ProjectDoc_IndexID
	and ProjectDoc_ID=p_ProjectDoc_ID
	and Promoter_ID=p_Promoter_ID
	and Project_ID=p_Project_ID
	Limit 1;
    
    -- get master records
    set v_ProjectDocMaster_InfoCode=p_ProjectDoc_InfoCode_Input;
	set v_ProjectDocMaster_InfoName=val_ProjectDoc_InfoName;
	set v_ProjectDocMaster_RelatedSectionName=val_ProjectDoc_RelatedSectionName;
    
    SELECT ProjectDocMaster_InfoCode, ProjectDocMaster_InfoName, ProjectDocMaster_RelatedSectionName
    INTO v_ProjectDocMaster_InfoCode, v_ProjectDocMaster_InfoName, v_ProjectDocMaster_RelatedSectionName
    FROM tbl_rera_master_project_documents WHERE IsActive=1
    and ProjectDocMaster_InfoCode=p_ProjectDoc_InfoCode_Input
    Limit 1;
    
    -- Application IndexID
	select max(ProjectPUC_DocumentName_ID) into v_Get_ProjectPUC_DocumentName_ID from tbl_rera_hdcr_project_documentnamedetails;
	IF (v_Get_ProjectPUC_DocumentName_ID  IS NULL)        
	then        
		SET v_Put_ProjectPUC_DocumentName_ID=1001;          
	ELSE         
		SET v_Put_ProjectPUC_DocumentName_ID=v_Get_ProjectPUC_DocumentName_ID+1;    
	end if;
    
    -- insert history log
	Insert into tbl_rera_hdcr_project_documentnamedetails
	(    
		-- ProjectPUC_DocumentName_IndexID,
		ProjectPUC_DocumentName_ID,
		Related_Promoter_ID,
		Related_Project_ID,        
		RelatedApplicationPUC_ID,
		PUC_DiaryNumber,
		PUC_ReferencePUC_Name,
		PUC_ReferencePUC_Date,
		PUC_RequestCategoryID,
		RERAnumberRegistration,
		ProjectDiaryNumber,
		ProjectDoc_InfoCode_ChangeTo,
		ProjectDoc_InfoName_ChangeTo,
		Account_FormDate,
		Account_ToDate,        
		Approved_AccountDate,
		Approved_AccountBy,
		ACR_AccountDate,
		ACR_AccountBy,
        
		prj_ProjectDoc_IndexID,
		prj_ProjectDoc_ID,
		prj_Promoter_ID,
		prj_Project_ID,
		prj_ProjectDoc_InfoCode,
		prj_ProjectDoc_InfoName,
		prj_ProjectDoc_RelatedSectionName,
		prj_ProjectDoc_ReferenceNumber,
		prj_ProjectDoc_IssueDate,
		prj_ProjectDoc_FileSize,
		prj_ProjectDoc_FileFormat,
		prj_ProjectDoc_FilePath,
		prj_ProjectDoc_FileName,
		prj_ProjectDoc_IsGroup,
		prj_Remarks_IfAny,
		prj_A_column,
		prj_B_column,
		prj_C_column,
		prj_D_column,
		prj_IsActive,
		prj_IsDraft,
		prj_CreatedBy,
		prj_CreatedOn,
		prj_ModifyBy,
		prj_ModifyOn
	)    
	values    
	(    
		-- ProjectPUC_DocumentName_IndexID,
		v_Put_ProjectPUC_DocumentName_ID, -- ProjectPUC_DocumentName_ID,
        p_Promoter_ID,
        p_Project_ID,
        0, -- RelatedApplicationPUC_ID,
        '', -- PUC_DiaryNumber,
		'', -- PUC_ReferencePUC_Name,
		'0001-01-01 00:00:00.000', -- PUC_ReferencePUC_Date,
		0, -- PUC_RequestCategoryID,
        p_RERA_RegistrationNumber,
        p_Project_DiaryNumber,
        p_ProjectDoc_InfoCode_Input, -- ProjectDoc_InfoCode_ChangeTo,
        v_ProjectDocMaster_InfoName, -- ProjectDoc_InfoName_ChangeTo,
        val_ModifyOn, -- Account_FormDate,
		NOW(), -- Account_ToDate,        
		NOW(), -- Approved_AccountDate,
        p_CreatedBy, -- 'sysadmin', -- Approved_AccountBy,
        NOW(), -- ACR_AccountDate,
        p_User_ID, -- 'sysadmin', -- ACR_AccountBy,
        
        val_ProjectDoc_IndexID, 
        val_ProjectDoc_ID, 
        val_Promoter_ID, 
        val_Project_ID, 
        val_ProjectDoc_InfoCode, 
        val_ProjectDoc_InfoName, 
        val_ProjectDoc_RelatedSectionName, 
        val_ProjectDoc_ReferenceNumber,
		val_ProjectDoc_IssueDate, 
		val_ProjectDoc_FileSize, 
        val_ProjectDoc_FileFormat, 
        val_ProjectDoc_FilePath, 
        val_ProjectDoc_FileName, 
        val_ProjectDoc_IsGroup, 
        val_Remarks_IfAny,
		val_A_column, 
        val_B_column, 
        val_C_column, 
        val_D_column, 
        val_IsActive, 
        val_IsDraft, 
        val_CreatedBy, 
        val_CreatedOn, 
        val_ModifyBy, 
        val_ModifyOn
	);
    
    -- modify existed documents
	UPDATE tbl_rera_project_documents 
    SET ProjectDoc_InfoCode=p_ProjectDoc_InfoCode_Input, ProjectDoc_InfoName=v_ProjectDocMaster_InfoName, ProjectDoc_RelatedSectionName=v_ProjectDocMaster_RelatedSectionName, ProjectDoc_ReferenceNumber=p_ProjectDoc_ReferenceNumber_Input, ProjectDoc_IssueDate=NOW(), Remarks_IfAny=p_Remarks_IfAny_Input, C_column='FlagACR', ModifyBy=p_User_ID, ModifyOn=NOW()
    WHERE ProjectDoc_IndexID=p_ProjectDoc_IndexID
	and ProjectDoc_ID=p_ProjectDoc_ID
	and Promoter_ID=p_Promoter_ID
	and Project_ID=p_Project_ID 
    and ProjectDoc_InfoCode=p_ProjectDoc_InfoCode
    and IsActive=1 and IsDraft in (1,4,5,6);
        
    set var_message=concat('document ' , v_ProjectDocMaster_InfoName);
end if;


set p_valreturn=var_message; 

IF `_rollback` THEN
	set p_valreturn = 'Error';
	ROLLBACK;
ELSE
	COMMIT;
END IF;

END ;;
DELIMITER ;
