CREATE DEFINER=`sa`@`%` PROCEDURE `usp_zquery_rera_report_project_cost_unit_area`()
begin

-- 20250614 Author Karan Sir

SELECT
Y.*,
Z.*
FROM
(select m.*,n.A_column as ProjectCost from
(
select 
ProjectRegDiaryNumber_Name,
Promoter_ID,
Project_ID,
PromoterRegDiaryNumber_Name,
PromoterType,
PromoterName,
ProjectName,
RERAnumberRegistration,
RERAnumberIssueDate,
RERAnumberRegUptoDate,
AuthorizedPerson_Email,
