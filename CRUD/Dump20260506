udfn_GetQUP_Flag_DATE(a.Project_ID, 2019, 'FourthQTR') as `Submitted Date (2019-IV)`
-- Loop 2017 END
,
-- Loop 2018 START
CASE 
	WHEN a.RERAnumberIssueDate < '2020-04-01 00:00:00.000' and a.RERAnumberIssueDate > '2019-12-31 00:00:00.000' THEN 'YES'
    WHEN (a.RERAnumberRegUptoDate < '2020-04-01 00:00:00.000' and a.RERAnumberRegUptoDate > '2019-12-31 00:00:00.000') THEN 'YES'
