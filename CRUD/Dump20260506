--       ROLLBACK      
--      -- SET @MAXID=0    
--       RETURN          
--      END      
--    COMMIT TRANSACTION    
     
-- END TRY    
    
-- BEGIN CATCH    
-- SELECT @out_error_number=ERROR_NUMBER()    
-- END CATCH 
      
END ;;
