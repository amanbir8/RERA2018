CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_PromoterDetail_YN_ByID`(  
   p_Promoter_ID bigint,
   p_Promoter_Type int,
   p_UserID varchar(100),
   p_UserNam varchar(100)
)
begin 

declare v_getprofieCount Int;
declare v_getProfileType Int;
declare v_getJointPromoter varchar(20);
declare v_mainCount Int;

set v_getJointPromoter='N';
set v_mainCount=0;

select COUNT(*) into v_getprofieCount from Rera_Tbl_Promoter where Application_ID=p_Promoter_ID and IsActive=1;
if v_getprofieCount<>0
then  
	select flag, CASE WHEN Org_Reg_Certificate='Y' THEN 'Y' ELSE 'N' END as Org_Reg_Certificate 
    into v_getProfileType, v_getJointPromoter 
    from Rera_Tbl_Promoter where Application_ID=p_Promoter_ID and IsActive=1; 
end if;

-- Joint-Promoter IF Any
if v_getJointPromoter='Y' then
	set v_mainCount=1;
end if;

Select v_getJointPromoter AS JointPromoterYN, v_mainCount AS TotalCount;

end ;;
