		  0, -- p_IsTempTable,
		  p_CreatedBy,
		  NOW(), -- p_CreatedOn,
		  p_ModifyBy,
		  NOW() -- p_ModifyOn
		);
    END IF;
ELSE
	-- When Complaint_ID (Zero)
	select count(FactsCaseDocument_ID) into v_checkFactsCaseDocument_ID from tbl_rera_complaint_formm_document_factsofthecase
	where ComplainantApplicant_RelatedComplaintM_ID=p_ComplainantApplicant_RelatedComplaintM_ID
	and Profile_ID=p_Profile_ID and ComplaintType_MN='FormTypeM' 
	and FactsCaseDoc_InfoCode=p_FactsCaseDoc_InfoCode
	and IsActive=1;
    
    IF (v_checkFactsCaseDocument_ID<>0) THEN
		-- When Record Exist (ComplaintID Zero)

		-- Check Sequence Order
        set v_checkPageSequence=0;
        
		select Doc_PageStartNumber into v_checkPageSequence from tbl_rera_complaint_formm_document_factsofthecase
		where ComplainantApplicant_RelatedComplaintM_ID=p_ComplainantApplicant_RelatedComplaintM_ID
		and Profile_ID=p_Profile_ID and ComplaintType_MN='FormTypeM' 
		and FactsCaseDoc_InfoCode=p_FactsCaseDoc_InfoCode
		and IsActive=1;

		if (v_PageSequence is null) then
			SET v_PageSequence=1;
		else
			SET v_PageSequence=v_checkPageSequence+1;
		end if;

        -- Update PrevEntry flag
		update tbl_rera_complaint_formm_document_factsofthecase set IsActive=2
		where ComplainantApplicant_RelatedComplaintM_ID=p_ComplainantApplicant_RelatedComplaintM_ID
		and Profile_ID=p_Profile_ID and ComplaintType_MN='FormTypeM' 
		and FactsCaseDoc_InfoCode=p_FactsCaseDoc_InfoCode
		and IsActive=1;        
        
        INSERT INTO tbl_rera_complaint_formm_document_factsofthecase
		(
		  -- FactsCaseDocument_IndexID,
