	ComplaintType_MN,
	TransferTypeOption,
	TransferDate,
	Transfer_FromBench,
	Transfer_FromBenchName,
	Transfer_ToBench,
	Transfer_ToBenchName,
	PublicViewStatus,
	Remarks_IfAny,
	A_column,
	B_column,
	C_column,
	D_column,
	E_column,
	IsCaseTransferlockUnlockFlag,
	IsTransferOrder,
	TransferOrderStatusRemark,
	IsActive,
	IsDraft,
	IsLock,
	IsPublicView,
	IsLatestActive,
	IsTransferDisplay,
	CreatedBy,
	CreatedOn,
	ModifyBy,
	ModifyOn
)    
values    
(    
	-- p_CaseTransferN_IndexID,
	v_Put_CaseTransfer_ID, -- p_CaseTransferN_ID,
	v_Put_CaseTransfer_RegDiaryName, -- p_CaseTransferN_RegDiaryNumber_IndexName,
	YEAR(NOW()), -- p_CaseTransferN_RegDiaryNumber_NameYear,
	v_Get_CaseTransfer_RegDiaryName, -- p_CaseTransferN_RegDiaryNumber_Name,
	p_ComplainantApplicant_RelatedComplaint_ID,
	v_Put_BasicComplaintRegDiaryNumber_Name, -- p_ComplainantApplicant_RelatedComplaint_Code,
	p_ComplaintType_MN,
	p_TransferTypeOption,
	p_TransferDate,
	p_Transfer_FromBench,
	p_Transfer_FromBenchName,
	p_Transfer_ToBench,
	p_Transfer_ToBenchName,
	p_PublicViewStatus,
	p_Remarks_IfAny,
	p_A_column,
	p_B_column,
	p_C_column,
	p_D_column,
	p_E_column,
	1, -- p_IsCaseTransferlockUnlockFlag,
	p_IsTransferOrder,
	p_TransferOrderStatusRemark,
	1, -- p_IsActive,
	0, -- p_IsDraft,
	0, -- p_IsLock,
	p_IsPublicView,
	1, -- p_IsLatestActive,
	p_IsTransferDisplay,
	p_CreatedBy,
	NOW(), -- p_CreatedOn,
	p_ModifyBy,
	NOW() -- p_ModifyOn
);

set p_valoutput= v_Put_CaseTransfer_ID;

else

Insert into tbl_rera_complaint_formn_CaseTransferDetails
(    
	-- CaseTransferN_IndexID,
