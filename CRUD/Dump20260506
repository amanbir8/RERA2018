			set v_extractCountregcert=1;
		end if;
        if (v_checkCountats>0)
		then
			set v_extractCountats=1;
		end if;    
		if (v_checkCountald>0)
		then
			set v_extractCountald=1;
		end if;    
		if (v_checkCountloi>0)
		then
			set v_extractCountloi=1;
		end if;
        
        set v_putresultclu=0;
		set v_putresultltdc=0;
		set v_putresultregcert=0; 
        set v_putresultats=0;
		set v_putresultald=0;
