CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Agent_RefRegistrationsRERADetail_ForDesk`(  
  p_Agent_ID bigint,
  p_AgentType_ID int,
  p_Agent_Flag varchar(120),
  p_UserRole varchar(120)
)
BEGIN 

-- ONLINE REGISTERED AGENT CASE

select 
	Agent_RERAnumber_DiaryNumber_IndexID as Agent_RefRegistration_regRERA_IndexID,
	Agent_RERAnumber_DiaryNumber_ID as Agent_RefRegistration_regRERA_ID,
	0 as RenewalAgent_ID,
	0 as RenewalOrderSequence,
	0 as RelatedRenewalAgent_Year,
	Agent_ID as Related_Agent_ID,
	'' as Related_AgentDiaryNumber_Name,
	Agent_Type as Related_Agent_Type,
	UserID as Related_UserID,
	RERAnumberRegistration as Related_RERAnumberRegistration,
	102 as Related_Agent_RefRegistrations_RERA_ID,
	RERAnumberRegistration as RERAregistration_Number,
	RERAnumberIssueDate as RERAregistration_IssueDate,
	RERAnumberRegUptoDate as RERAregistration_ExpiryDate,
    AgentRegDiaryNumber_Name as Agent_Reference_DiaryNumber,
    '0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
    udfn_GetAgentName(Agent_ID) as Agent_Name,
    CASE
		WHEN Agent_Type = 1 THEN 'Individual'
		WHEN Agent_Type = 2 THEN 'Other Than Individual'
		ELSE 'UnKnown'
	END as Agent_Type,
	'' as ImageRERAcert_FileName,
	'' as ImageRERAcert_FilePath,
	'' as Remarks_IfAny,
	1 as IsActive,
	1 as IsActiveProvider,
	1 as IsDraft,
	1 as IsLock,
	1 as IsPublicView,
	0 as IsConditional,
	CreatedOn,
	CreatedBy,
	ModifyOn,
	ModifyBy
from tbl_rera_ldr_agent_reranumber_diarynumber
where Agent_ID=p_Agent_ID 
-- and Agent_Type=p_AgentType_ID
and IsActive=1
and IsPublicView in (0,1)
    
UNION

-- OFFLINE AGENT CASE

select 
	OfflineAgents_IndexID as Agent_RefRegistration_regRERA_IndexID,
	OfflineAgents_ID as Agent_RefRegistration_regRERA_ID,
	0 as RenewalAgent_ID,
	0 as RenewalOrderSequence,
	0 as RelatedRenewalAgent_Year,
	p_Agent_ID as Related_Agent_ID,
	'' as Related_AgentDiaryNumber_Name,
	p_AgentType_ID as Related_Agent_Type,
	CreatedBy as Related_UserID,
	OfflineAgents_RERAregistrationNumber as Related_RERAnumberRegistration,
	101 as Related_Agent_RefRegistrations_RERA_ID,
	OfflineAgents_RERAregistrationNumber as RERAregistration_Number,
	OfflineAgents_RERAregistrationIssueDate as RERAregistration_IssueDate,
	OfflineAgents_RERAregistrationValidUptoDate as RERAregistration_ExpiryDate,
	CASE
		WHEN OfflineAgents_RemarksIfAny like 'FormJ%' THEN OfflineAgents_ReferenceNumber
		ELSE Concat('Offline (', OfflineAgents_ReferenceNumber, ')')
	END as Agent_Reference_DiaryNumber,
    '0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
    OfflineAgents_AgentName_OrganizationName as Agent_Name,
    CASE
		WHEN p_AgentType_ID = 1 THEN 'Individual'
		WHEN p_AgentType_ID = 2 THEN 'Other Than Individual'
		ELSE 'UnKnown'
	END as Agent_Type,
	'' as ImageRERAcert_FileName,
	'' as ImageRERAcert_FilePath,
	OfflineAgents_RemarksIfAny as Remarks_IfAny,
	1 as IsActive,
	1 as IsActiveProvider,
	1 as IsDraft,
	1 as IsLock,
	1 as IsPublicView,
	0 as IsConditional,
	CreatedOn,
	CreatedBy,
	ModifyOn,
	ModifyBy
from tbl_rera_agent_offlineagents_pendinguploads 
where IsActive=1 
and OfflineAgents_RERAregistrationNumber in (select Existing_RERANumber from tbl_rera_agent_profile 
where Agent_ID=p_Agent_ID -- and Agent_Type=p_AgentType_ID 
and isactive=1)
and CreatedBy <> 'J' -- OfflineAgents_RemarksIfAny not like 'FormJ%'

UNION

-- RENEWAL AGENT CASE

select 
	AgentRegRenewal_DiaryNumber_IndexID as Agent_RefRegistration_regRERA_IndexID,
	AgentRegRenewal_DiaryNumber_ID as Agent_RefRegistration_regRERA_ID,
	RelatedRenewalAgent_ID as RenewalAgent_ID,
	RenewalOrderSequence as RenewalOrderSequence,
	RelatedRenewalAgent_Year as RelatedRenewalAgent_Year,
	RelatedAgent_ID as Related_Agent_ID,
	'' as Related_AgentDiaryNumber_Name,
	Agent_Type as Related_Agent_Type,
	UserID as Related_UserID,    
	RenewalAgentRegistrationNumber as Related_RERAnumberRegistration,
	CASE
		WHEN RelatedAgentDiaryNumber_Name='OFFLINE' THEN 111		
		ELSE 122
	END as Related_Agent_RefRegistrations_RERA_ID,
	RenewalAgentRegistrationNumber as RERAregistration_Number,
	RenewalAgentRegistrationIssueDate as RERAregistration_IssueDate,
	RenewalAgentRegistrationRegUptoDate as RERAregistration_ExpiryDate,
    
    RelatedRenewalAgentRegDiaryNumber_Name as Agent_Reference_DiaryNumber,
    '0001-01-01 00:00:00.000' as Agent_Reference_ApplicationDate,
    udfn_GetAgentNameByRenewal(RelatedAgent_ID,RelatedRenewalAgent_ID) as Agent_Name,
    CASE
		WHEN Agent_Type = 1 THEN 'Individual'
		WHEN Agent_Type = 2 THEN 'Other Than Individual'
		ELSE 'UnKnown'
	END as Agent_Type,
	'' as ImageRERAcert_FileName,
	'' as ImageRERAcert_FilePath,
	Remarks_IfAny as Remarks_IfAny,
	1 as IsActive,
	1 as IsActiveProvider,
	1 as IsDraft,
	1 as IsLock,
	1 as IsPublicView,
	0 as IsConditional,
	CreatedOn,
	CreatedBy,
	ModifyOn,
	ModifyBy
from tbl_rera_ldr_agent_reranumber_renewalregistration
where RelatedAgent_ID=p_Agent_ID 
-- and RelatedRenewalAgent_ID=p_RenewalAgent_ID
-- and RenewalOrderSequence=p_RenewalAgent_SequenceID
-- and RelatedRenewalAgent_Year=p_RenewalAgent_YearID
-- and Agent_Type=p_AgentType_ID
and IsActive=1
and IsDraft in (0,1,4,5,6)
and IsLock=1
and IsPublicView in (0,1);

END ;;
