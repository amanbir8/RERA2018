		NOW() as `CreatedOn`,
		`ModifyBy`, 
		NOW() as `ModifyOn`
	FROM tbl_rera_complaint_formM_regdiarynumber	
	where FormM_RelatedComplaint_ID=v_ComplaintId and IsActive=3 and IsDraft=1;
	-- order by ComplaintRegDiaryNumber_IndexID desc Limit 1;
   
   update tbl_rera_complaint_formm_regdiarynumber set IsActive=2 where FormM_RelatedComplaint_ID=v_ComplaintId and IsActive=3 and IsDraft=1; 
   
 end if;

