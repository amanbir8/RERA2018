	and RERA_RegistrationNumber=p_RERAnumberRegistration and RelatedApplicationPUC_ID=p_RelatedApplicationPUC_ID and IsActive=1;

	-- Closed PUC Event Workflow
	INSERT INTO tbl_rera_project_puc_eventaction  
	(
		-- ProjectEventActionPUC_ID,
