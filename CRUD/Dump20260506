CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_ePay_PDF_ChallanByID`(
    p_challanid varchar(100),
    p_challannumber varchar(100),
    p_flag int(11)
)
BEGIN

select
r.Payment_epayTxnNumber,
r.TransactionDate,
r.PaymentForName,
r.Project_Name,
r.Promoter_Name,
r.ProjectAddress_DistrictName,
r.Agent_Name,
r.Complaint_Number,
r.Complainant_Name,
r.ComplaintAgainst_Name,
r.RERAnumberRegistration,
r.PartyName,
r.PaymentReferenceName,
r.BenchName,
r.Payment_EmailAddress,
r.Payment_MobileNumber,
r.Payment_AmountWords, -- added on 31-03-2026

c.Payment_epayChallanNumber,
c.ChallanDate,

pg.PG_PayU_ID,
pg.PaymentSuccessDate,
pg.PG_Transaction_ID,
pg.PG_Status,
pg.PG_Bank_Name,
pg.PG_Bank_Reference_No,
pg.PG_Payment_Type,
pg.PG_Amount_INR

from tbl_rera_payment_epay_registration r, tbl_rera_payment_epay_challannumber c, tbl_rera_payment_epay_paymentgateway pg
 
WHERE
    c.Payment_ChallanNumber_ID = p_challanid
    AND c.Payment_epayChallanNumber=p_challannumber
    AND r.PaymentRegistration_ID = pg.Related_PaymentRegistration_ID
    AND r.PaymentRegistration_ID = c.Related_PaymentRegistration_ID
    AND r.IsActive = 1
    AND c.IsActive = 1
    AND pg.IsPaymentSuccessComplete = 1
    AND pg.IsActive = 1
    Order By c.ChallanDate desc;

END ;;
