		  end if;
          
          update tbl_rera_project_puc_regdiarynumber set IsActiveProvider=2
		  where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration;
          
          if v_checkExistingPUCdiarynumberCount>0
		  then          
              -- ------------Check Event Open/Close------------------          
              select count(EventAction_Type) into v_GetEventActionTypeID 
			  from tbl_rera_project_puc_eventaction A, tbl_rera_project_puc_regdiarynumber B 
              where B.RelatedPromoter_ID=A.Related_Promoter_ID
              and B.RelatedProject_ID=A.Related_Project_ID
              and B.RelatedApplicationPUC_ID=A.RelatedApplicationPUC_ID
              and B.RERA_RegistrationNumber=A.RERA_RegistrationNumber
              and A.IsActive=1 and B.IsActive=1
              and A.Related_Promoter_ID=p_RelatedPromoter_ID and A.Related_Project_ID=p_RelatedProject_ID and A.RERA_RegistrationNumber=p_RERAnumberRegistration 
              and B.PUC_RequestCategoryID=p_PUC_RequestCategoryID 
              and EventAction_Type in (910002);
          
              if v_GetEventActionTypeID>0
		      then 
				  set v_getPUC_ApplicationID=v_ApplicationPUC_ID;
            
				  -- ------- Generate New Diary Number (NEW APPLICATIONS when Previous PUC Closed)---------- 
				  INSERT INTO tbl_rera_project_puc_regdiarynumber        
					(  
					-- PUC_RegDiaryNumber_IndexID,
