CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_Rera_Count_Project_Document`(  
 p_Application_id bigint
 )
begin 

 declare v_TotalCnt Int; 
 declare v_getchkDocCount int;

 declare v_getProjectRegCount int;
 declare v_getKhasraAreaCount int;
 declare v_getProjectLandCount int;
 declare v_chkProjectLandStatusCount int;
 declare v_getDocValidCount int;
 
 declare v_getchkProjectDocCount int;
 declare v_getProjectDocValidCount int;
 
 declare v_getReraAgreementSale varchar(10);
 declare v_getMegaProject varchar(10);
 declare v_getProjectStatusOnGoing varchar(10);
 declare v_getProjectLandStatus varchar(10);
 declare v_getEncumbrancesType varchar(10);
 
set v_getProjectDocValidCount=17;
 

SELECT COUNT(*) INTO v_TotalCnt FROM tbl_RERA_Project_Documents 
where Project_ID=p_Application_id and IsActive=1  and IsDraft in (0,5,4);


select COUNT(*) into v_getchkDocCount FROM tbl_RERA_Project_Documents where Project_ID=p_Application_id and IsActive=1;  -- and IsDraft=0 


-- Document Track Filter Counter
select COUNT(*) into v_getProjectRegCount from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1;   
select COUNT(*) into v_getKhasraAreaCount from tbl_RERA_Project_KhasraAreaDetails where ProjectKhasraAreaRelated_ProjectRegistration_ID=p_Application_id and IsActive=1;   
select COUNT(*) into v_getProjectLandCount from tbl_RERA_Project_LandDetails where ProjectLandRelated_ProjectRegistration_ID=p_Application_id and IsActive=1;  



if v_getProjectRegCount<>0    
then    
select IsProForma_AOS_RERAformat_AnnexureA into v_getReraAgreementSale from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1;    
select IsProject_MegaProjectCategory into v_getMegaProject from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1;  

select
case 
when Project_Status='On-going' then 'Y'
when Project_Status='Complete' then 'N'
when Project_Status='New' then 'N'
end into v_getProjectStatusOnGoing
from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1; 
  
end if;    
    
if v_getKhasraAreaCount<>0    
then
	 -- Project Land Status (1-Y/N, 2-All)  
	 select COUNT(distinct B_column) into v_chkProjectLandStatusCount from tbl_RERA_Project_KhasraAreaDetails where ProjectKhasraAreaRelated_ProjectRegistration_ID=p_Application_id and IsActive=1;   
	 if v_chkProjectLandStatusCount=2  
	 then  
	  set v_getProjectLandStatus='A';  
	 end if;  
  
	 if v_chkProjectLandStatusCount=1  
	 then  
	  select distinct B_column into v_getProjectLandStatus from tbl_RERA_Project_KhasraAreaDetails where ProjectKhasraAreaRelated_ProjectRegistration_ID=p_Application_id and IsActive=1;   
	 end if;
end if;

if v_getProjectLandCount<>0    
then    
  select IsLandEncumbrances_IfAny into v_getEncumbrancesType from tbl_RERA_Project_LandDetails where ProjectLandRelated_ProjectRegistration_ID=p_Application_id and IsActive=1;    
 -- select @getProjectLandStatus=IsProjectLand_Status_OwnedByPromoter from [tbl_RERA_Project_LandDetails] where ProjectLandRelated_ProjectRegistration_ID=@Project_ID and IsActive=1    
end if; 


select Count(ProjectDoc_ValidCounterNumber) into v_getDocValidCount from tbl_rera_master_project_documents_trackfiltercounter
where DocFilter_ProjectStatus_OnGoing=v_getProjectStatusOnGoing and
DocFilter_AOS_AsFormat=v_getReraAgreementSale and
DocFilter_Encumbrances=v_getEncumbrancesType and
DocFilter_MegaProject=v_getMegaProject and
DocFilter_LandStatus_OwnByPromoter=v_getProjectLandStatus and
isactive=1;

if v_getDocValidCount<>0
then
	select ProjectDoc_ValidCounterNumber into v_getProjectDocValidCount from tbl_rera_master_project_documents_trackfiltercounter
	where DocFilter_ProjectStatus_OnGoing=v_getProjectStatusOnGoing and
	DocFilter_AOS_AsFormat=v_getReraAgreementSale and
	DocFilter_Encumbrances=v_getEncumbrancesType and
	DocFilter_MegaProject=v_getMegaProject and
	DocFilter_LandStatus_OwnByPromoter=v_getProjectLandStatus and
	isactive=1;
end if;
 

begin 
	if  (v_TotalCnt <> 0 and (v_getchkDocCount>v_getProjectDocValidCount or v_getchkDocCount=v_getProjectDocValidCount)) 
	then  
		update tbl_RERA_Project_Documents set IsDraft=1 where Project_ID=p_Application_id and IsActive=1 and IsDraft in (0,5,4);
	end if; 
 
 -- ---this is temporary,kindly comment after confirm of table
 -- select @@ERROR 
end;

end ;;
DELIMITER ;
