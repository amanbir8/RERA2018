CREATE DEFINER=`sa`@`%` FUNCTION `udfn_NumberToWords`(p_Number BIGINT) RETURNS varchar(500) CHARSET utf8
    DETERMINISTIC
BEGIN

    DECLARE v_Num BIGINT;
    DECLARE v_Result VARCHAR(500) DEFAULT '';
    DECLARE v_Unit INT;
    DECLARE v_Tens INT;

    SET v_Num = p_Number;

    IF v_Num = 0 THEN
        RETURN 'Zero';
    END IF;

-- Lakhs
IF v_Num >= 100000 THEN

    SET @temp = FLOOR(v_Num / 100000);

    IF @temp < 20 THEN
        SET v_Result = CONCAT(v_Result,
            CASE @temp
                WHEN 1 THEN 'One '
                WHEN 2 THEN 'Two '
                WHEN 3 THEN 'Three '
                WHEN 4 THEN 'Four '
                WHEN 5 THEN 'Five '
                WHEN 6 THEN 'Six '
                WHEN 7 THEN 'Seven '
                WHEN 8 THEN 'Eight '
                WHEN 9 THEN 'Nine '
                WHEN 10 THEN 'Ten '
                WHEN 11 THEN 'Eleven '
                WHEN 12 THEN 'Twelve '
                WHEN 13 THEN 'Thirteen '
                WHEN 14 THEN 'Fourteen '
                WHEN 15 THEN 'Fifteen '
                WHEN 16 THEN 'Sixteen '
                WHEN 17 THEN 'Seventeen '
                WHEN 18 THEN 'Eighteen '
                WHEN 19 THEN 'Nineteen '
            END);
    ELSE
        SET v_Result = CONCAT(v_Result,
            CASE FLOOR(@temp / 10)
                WHEN 2 THEN 'Twenty '
                WHEN 3 THEN 'Thirty '
                WHEN 4 THEN 'Forty '
                WHEN 5 THEN 'Fifty '
                WHEN 6 THEN 'Sixty '
                WHEN 7 THEN 'Seventy '
                WHEN 8 THEN 'Eighty '
                WHEN 9 THEN 'Ninety '
            END,
            CASE @temp % 10
                WHEN 1 THEN 'One '
                WHEN 2 THEN 'Two '
                WHEN 3 THEN 'Three '
                WHEN 4 THEN 'Four '
                WHEN 5 THEN 'Five '
                WHEN 6 THEN 'Six '
                WHEN 7 THEN 'Seven '
                WHEN 8 THEN 'Eight '
                WHEN 9 THEN 'Nine '
                ELSE ''
            END
        );
    END IF;

    SET v_Result = CONCAT(v_Result, 'Lakh ');
    SET v_Num = v_Num % 100000;

END IF;


   -- Thousands
IF v_Num >= 1000 THEN

    SET @temp = FLOOR(v_Num / 1000);

    IF @temp < 20 THEN
        SET v_Result = CONCAT(v_Result,
            CASE @temp
                WHEN 1 THEN 'One '
                WHEN 2 THEN 'Two '
                WHEN 3 THEN 'Three '
                WHEN 4 THEN 'Four '
                WHEN 5 THEN 'Five '
                WHEN 6 THEN 'Six '
                WHEN 7 THEN 'Seven '
                WHEN 8 THEN 'Eight '
                WHEN 9 THEN 'Nine '
                WHEN 10 THEN 'Ten '
                WHEN 11 THEN 'Eleven '
                WHEN 12 THEN 'Twelve '
                WHEN 13 THEN 'Thirteen '
                WHEN 14 THEN 'Fourteen '
                WHEN 15 THEN 'Fifteen '
                WHEN 16 THEN 'Sixteen '
                WHEN 17 THEN 'Seventeen '
                WHEN 18 THEN 'Eighteen '
                WHEN 19 THEN 'Nineteen '
            END);
    ELSE
        SET v_Result = CONCAT(v_Result,
            CASE FLOOR(@temp / 10)
                WHEN 2 THEN 'Twenty '
                WHEN 3 THEN 'Thirty '
                WHEN 4 THEN 'Forty '
                WHEN 5 THEN 'Fifty '
                WHEN 6 THEN 'Sixty '
                WHEN 7 THEN 'Seventy '
                WHEN 8 THEN 'Eighty '
                WHEN 9 THEN 'Ninety '
            END,
            CASE @temp % 10
                WHEN 1 THEN 'One '
                WHEN 2 THEN 'Two '
                WHEN 3 THEN 'Three '
                WHEN 4 THEN 'Four '
                WHEN 5 THEN 'Five '
                WHEN 6 THEN 'Six '
                WHEN 7 THEN 'Seven '
                WHEN 8 THEN 'Eight '
                WHEN 9 THEN 'Nine '
                ELSE ''
            END
        );
    END IF;

    SET v_Result = CONCAT(v_Result, 'Thousand ');
    SET v_Num = v_Num % 1000;

END IF;


    -- Hundreds
    IF v_Num >= 100 THEN
        SET v_Result = CONCAT(v_Result,
            CASE FLOOR(v_Num/100)
                WHEN 1 THEN 'One '
                WHEN 2 THEN 'Two '
                WHEN 3 THEN 'Three '
                WHEN 4 THEN 'Four '
                WHEN 5 THEN 'Five '
                WHEN 6 THEN 'Six '
                WHEN 7 THEN 'Seven '
                WHEN 8 THEN 'Eight '
                WHEN 9 THEN 'Nine '
                ELSE ''
            END,
        'Hundred ');
        SET v_Num = v_Num % 100;
    END IF;

    -- Tens & Units
    IF v_Num > 0 THEN

        IF v_Num < 20 THEN
            SET v_Result = CONCAT(v_Result,
                CASE v_Num
                    WHEN 1 THEN 'One'
                    WHEN 2 THEN 'Two'
                    WHEN 3 THEN 'Three'
                    WHEN 4 THEN 'Four'
                    WHEN 5 THEN 'Five'
                    WHEN 6 THEN 'Six'
                    WHEN 7 THEN 'Seven'
                    WHEN 8 THEN 'Eight'
                    WHEN 9 THEN 'Nine'
                    WHEN 10 THEN 'Ten'
                    WHEN 11 THEN 'Eleven'
                    WHEN 12 THEN 'Twelve'
                    WHEN 13 THEN 'Thirteen'
                    WHEN 14 THEN 'Fourteen'
                    WHEN 15 THEN 'Fifteen'
                    WHEN 16 THEN 'Sixteen'
                    WHEN 17 THEN 'Seventeen'
                    WHEN 18 THEN 'Eighteen'
                    WHEN 19 THEN 'Nineteen'
                END);
        ELSE
            SET v_Tens = FLOOR(v_Num / 10);
            SET v_Unit = v_Num % 10;

            SET v_Result = CONCAT(v_Result,
                CASE v_Tens
                    WHEN 2 THEN 'Twenty '
                    WHEN 3 THEN 'Thirty '
                    WHEN 4 THEN 'Forty '
                    WHEN 5 THEN 'Fifty '
                    WHEN 6 THEN 'Sixty '
                    WHEN 7 THEN 'Seventy '
                    WHEN 8 THEN 'Eighty '
                    WHEN 9 THEN 'Ninety '
                END);

            IF v_Unit > 0 THEN
                SET v_Result = CONCAT(v_Result,
                    CASE v_Unit
                        WHEN 1 THEN 'One'
                        WHEN 2 THEN 'Two'
                        WHEN 3 THEN 'Three'
                        WHEN 4 THEN 'Four'
                        WHEN 5 THEN 'Five'
                        WHEN 6 THEN 'Six'
                        WHEN 7 THEN 'Seven'
                        WHEN 8 THEN 'Eight'
                        WHEN 9 THEN 'Nine'
                    END);
            END IF;
        END IF;

    END IF;

    RETURN TRIM(v_Result);

END ;;
