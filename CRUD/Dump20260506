CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthDesk_Complaint_FormN_OrderCaseDetails_ByID`(  
	p_ComplaintFormN_ID bigint, 
	p_DiaryNumber varchar(100),
	p_UserRole varchar(100),
	p_UserName varchar(100)
)
begin
 
declare v_Complaint_FilingDate datetime(3);
declare v_Complaint_InstitutionDate datetime(3);

declare v_Hearing_Count int;
declare v_HearingDate datetime(3);
declare v_HearingBenchCode varchar(150);
declare v_HearingBenchName varchar(150);
declare v_Hearing_IndexID bigint;
declare v_Hearing_ID bigint;
declare v_HearingBenchStampDescription varchar(150);

declare v_TransferCase_Count int;
declare v_TransferCase_Flag int;
declare v_TransferCase_TypeOption varchar(150);
declare v_TransferCase_TypeOptionName varchar(150);
declare v_TransferCase_IndexID bigint;
declare v_TransferCase_ID bigint;
declare v_TransferCase_RegDiaryNumber varchar(150);

set v_Complaint_FilingDate='2018-04-13 00:00:00.000';
set v_Complaint_InstitutionDate='2018-04-13 00:00:00.000';

select udfn_GetComplaintFormNApplicationDate(p_ComplaintFormN_ID) into v_Complaint_FilingDate;
-- select udfn_GetComplaintFormN_InstitutionDate(p_ComplaintFormN_ID) into v_Complaint_InstitutionDate;
set v_Complaint_InstitutionDate=v_Complaint_FilingDate;

set v_HearingDate='2018-04-13 00:00:00.000';
set v_HearingBenchCode=0;
set v_HearingBenchName='NA';
set v_Hearing_IndexID=0; 
set v_Hearing_ID=0; 
set v_HearingBenchStampDescription='NA';

select count(ComplainantApplicant_RelatedComplaint_ID) into v_Hearing_Count
from tbl_rera_complaint_formn_prehearingdate where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive in (1,3);

if (v_Hearing_Count<>0) then
	select
	PreHearingDate, PreHearingBench, B_column, PreHearingDate_IndexID, PreHearingDate_ID, B_column
	into v_HearingDate, v_HearingBenchCode, v_HearingBenchName, v_Hearing_IndexID, v_Hearing_ID, v_HearingBenchStampDescription
	from tbl_rera_complaint_formn_prehearingdate 
	where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive in (1,3) 
	order by PreHearingDate_IndexID desc limit 1;
end if;

set v_TransferCase_Flag=0;
set v_TransferCase_TypeOption='NA';
set v_TransferCase_TypeOptionName='NA';
set v_TransferCase_IndexID=0;
set v_TransferCase_ID=0;
set v_TransferCase_RegDiaryNumber='NA';

select count(ComplainantApplicant_RelatedComplaint_ID) into v_TransferCase_Count
from tbl_rera_complaint_formn_casetransferdetails where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive in (1,3);

if (v_TransferCase_Count<>0) then
	set v_TransferCase_Flag=1;
	select
	TransferTypeOption,	CaseTransferN_IndexID, CaseTransferN_ID,  CaseTransferN_RegDiaryNumber_Name,
    CASE
    WHEN TransferTypeOption = 'TransferToAO' THEN 'Transfer To AO'
    WHEN TransferTypeOption = 'TransferToAUTH' THEN 'Transfer To Authority'
    WHEN TransferTypeOption = 'TransferToOTH' THEN 'Transfer To Other'
    ELSE 'NA'
    END as TransferTypeOptionName
	into v_TransferCase_TypeOption, v_TransferCase_IndexID, v_TransferCase_ID, v_TransferCase_RegDiaryNumber, v_TransferCase_TypeOptionName
	from tbl_rera_complaint_formn_casetransferdetails 
	where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive in (1,3) 
	order by CaseTransferN_IndexID desc limit 1;
end if;

select
	m.Profile_ID as pRelated_Profile_ID,
	m.User_ID as pRelated_User_ID,
	m.FormN_RelatedComplaint_ID as pRelated_Complaint_ID,
	m.ComplaintType_MN as pRelated_ComplaintType_MN,
	m.ComplaintRegDiaryNumber_Name as pRelated_ComplaintDiaryNumber,

	n.Complainant_Name as pComplainantName,
	n.AuthorizedRepresentativeCounsel_Name as pPresentComplainantAuthorityName,
	n.Respondent_Name as pRespondentName,
	'' as pPresentRespondentAuthorityName,

	v_HearingBenchName as pBench_Name,
	v_HearingBenchCode as pBench_Code,
	v_HearingBenchStampDescription as pBench_StampDescription,

	v_Complaint_FilingDate as pDate_of_Filing,
	v_Complaint_InstitutionDate as pDate_of_Institution,
	v_HearingDate as pDate_of_Hearing,
	Now() as pDate_of_Decision,

	v_TransferCase_Flag as pIsTransferCase,
	v_TransferCase_TypeOption as pTransferTypeOption,
    v_TransferCase_TypeOptionName as pTransferTypeOption_Name,
    v_TransferCase_RegDiaryNumber as pTransferCase_DiaryNumber,
	v_TransferCase_IndexID as pRelated_CaseTransferN_IndexID,
	v_TransferCase_ID as pRelated_CaseTransferN_ID,    
	v_Hearing_IndexID as pRelated_PreHearingDate_IndexID,
	v_Hearing_ID as pRelated_PreHearingDate_ID,    
	0 as pRelated_eCourt_CaseAllocationN_IndexID,
	0 as pRelated_eCourt_CaseAllocationN_ID,

	1 as pIsActive,
	1 as pIsLatestActive
from tbl_rera_complaint_formn_regdiarynumber m, tbl_rera_complaint_formn_details n
where m.FormN_RelatedComplaint_ID=n.ComplaintFormN_ID
and n.IsActive=1
and m.FormN_RelatedComplaint_ID=p_ComplaintFormN_ID
and m.IsActive=1;

end ;;
