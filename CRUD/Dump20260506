 where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_p_ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID and    
  ProjectInfrastructureFacilities_IndexID =p_p_ProjectInfrastructureFacilities_IndexID and    
