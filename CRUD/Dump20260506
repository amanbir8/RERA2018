then     
	set v_GetProjectExtForm_RegDiaryNumber_ID=0;    
	set v_PutProjectExtForm_RegDiaryNumber_Name=0;    
else    
	-- -------Check Count Existing Project Diary Number----------		  
	select COUNT(*) into v_checkExistingProjectExtFormDiaryNumberCount from  tbl_rera_ProjectExtensionForm_RegDiaryNumber 
