			and Isactive=1 Limit 1;
			IF (v_Get_RenewalSequenceMaxID<>v_Get_RenewalSequenceID) THEN
				set v_Put_RenewalSequenceID=v_Get_RenewalSequenceID;
			ELSE
				set v_Put_RenewalSequenceID=v_Get_RenewalSequenceMaxID;
			END IF;
		ELSE
			set v_Put_RenewalSequenceID=1;
		END IF;
    END IF;
    
	IF (v_GetRenewalAgent_RegDiaryNumber_ID IS NULL) THEN         
