 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

 START TRANSACTION;

SET v_ret_bifurcatevalue=0;
-- Validate ID 
IF (p_BifurcateFormM_ID<>0) THEN

select count(ComplaintRegDiaryNumber_ID) into v_get_validatecount from tbl_rera_complaint_formm_regdiarynumber where FormM_RelatedComplaint_ID=p_BifurcateFormM_ID and IsActive=1;
