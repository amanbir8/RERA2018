udfn_GetQUP_Flag_DATE(a.Project_ID, 2019, 'ThirdQTR') as `Submitted Date (2019-III)`,
CASE 
	WHEN a.RERAnumberIssueDate < '2020-01-01 00:00:00.000' and a.RERAnumberIssueDate > '2019-09-30 00:00:00.000' THEN 'YES'
    WHEN (a.RERAnumberRegUptoDate < '2020-01-01 00:00:00.000' and a.RERAnumberRegUptoDate > '2019-09-30 00:00:00.000') THEN 'YES'
    WHEN (a.RERAnumberRegUptoDate > '2020-01-01 00:00:00.000' and a.RERAnumberIssueDate < '2019-09-30 00:00:00.000') THEN 'YES'
	ELSE 'NA'
END as `Yr2019-IV`,
