CREATE DEFINER=`sa`@`%` PROCEDURE `usp_validate_tbl_rera_agent_registrationnumber`(
  p_Agent_ID bigint(20),
  p_Agent_Type int,
  p_User_ID varchar(50),
  p_Registration_Number varchar(50),
  p_Related_StateName varchar(50),
  out p_valreturn int(11)         
)
begin        
  
	declare v_chk_AgentProfileCount int; 
    declare v_Get_OfflineRegistrationNumberCount int; 
    declare v_Get_OnlineRegistrationNumberCount int; 
    declare v_Get_OnlineRegistrationNumberByIDCount int;
	declare v_Get_RegistrationNumber_Value varchar(100);
	declare v_Get_RegistrationNumber_YN varchar(20);
    declare retValue int;

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
 

set retValue=0;

-- For Punjab State Only
IF (p_Related_StateName='Punjab') THEN 

-- Check Agent (My-Profile)
select count(*) into v_chk_AgentProfileCount from tbl_rera_agent_profile where Agent_ID=p_Agent_ID and IsActive=1;
IF (v_chk_AgentProfileCount<>0) THEN
	
	select count(*) into v_Get_OnlineRegistrationNumberByIDCount from tbl_rera_ldr_agent_reranumber_diarynumber where Agent_ID=p_Agent_ID and IsActive=1;
	IF (v_Get_OnlineRegistrationNumberByIDCount<>0) THEN
		-- Registered (Already Online Case (Same UserID))
		set retValue=105;
	ELSE 
    	-- extract from my profile (RERA No and Flag(Y or N))
		select Existing_RERANumber, IsAlready_RERANumber 
		into v_Get_RegistrationNumber_Value, v_Get_RegistrationNumber_YN
		from tbl_rera_agent_profile 
		where Agent_ID=p_Agent_ID and IsActive=1
		Limit 1;  

		IF (v_Get_RegistrationNumber_YN='Y') THEN
			-- Registered (Exist Case wrt RERA Number)
			select count(*) into v_Get_OnlineRegistrationNumberCount from tbl_rera_ldr_agent_reranumber_diarynumber 
			where RERAnumberRegistration=v_Get_RegistrationNumber_Value 
			and IsActive=1;
			
			IF (v_Get_OnlineRegistrationNumberCount<>0) THEN
				-- Registered (Already Online Case (different UserID))
				set retValue=104;
			ELSE
				-- Registered (Not found (OFFLINE Case))				
				set retValue=103;   -- //OPEN 101/102/103// 
			END IF;
		ELSE
			-- Registered (Not found (OFFLINE Case))				
			set retValue=102;   -- //OPEN 101/102/103// 
		END IF;

	END IF;
