CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_QuarterlyUpdateProjectRecordsDetails`(    
  p_UserRole varchar(150),
  p_RelatedProject_ID bigint,
  p_RelatedPromoter_ID bigint,
  p_UserNam varchar(150)
)
begin  


SELECT 
	XM.QUpdateProject_RegDiaryNumber_IndexID,
	XM.QUpdateProject_RegDiaryNumber_ID,
	XM.QUpdateProject_RegDiaryNumber_Name,
	XM.QUpdateProject_RegDiaryNumber_NameYear,
	XM.QUpdateProject_Year,
	XM.QUpdateProject_QuarterName,
	XM.UserID,
	XM.PromoterID,
	XM.ProjectID,
	XM.InventoryCount,
	XM.ParkingDetailsCount,
	XM.GeoTaggingPhotographCount,
	XM.InternalFacilitiesCount,
	XM.ExternalFacilitiesCount,
	XM.ApprovalsCount,
	XM.RERAnumber as RERAregistrationnumber,
	XM.RERAnumberIssueDate as RERAnumberIssueDate,
	XM.RERAnumberVlaidUptoDate as RERAnumberValidUptoDate,
	XM.Extra2,
	XM.Extra3,
	XM.Extra4,
	'' as Remarks_IfAny,
	XM.IsActive,
	XM.IsDraft,
	XM.IsDraftHelpDesk,
	XM.IsDraftEvaluation,
	XM.IsDraftSecMember,
	XM.IsDraftMember,
	XM.IsActiveProvider,
	XM.IsLock,
	XM.CreatedBy,
	XM.CreatedOn,
	XM.ModifyBy,
	XM.ModifyOn,
    
	XN.PromoterRegDiaryNumber_Name as ProjectRegDiaryNumber_Name,
	udfn_GetQuarterlyUpdateProjectApplicationDate(XM.ProjectID, XM.QUpdateProject_Year, XM.QUpdateProject_QuarterName) as QUpdatesApplication_Date,
	XM.QUpdateProject_Year as setQuarterValue_Year,
	CASE    
	WHEN XM.QUpdateProject_QuarterName = 'FirstQTR' THEN "QTR-I (January-March)"
	WHEN XM.QUpdateProject_QuarterName = 'SecondQTR' THEN "QTR-II (April-June)"
	WHEN XM.QUpdateProject_QuarterName = 'ThirdQTR' THEN "QTR-III (July-September)"
	WHEN XM.QUpdateProject_QuarterName = 'FourthQTR' THEN "QTR-IV (October-December)"
	ELSE "NA"
	END setQuarterValue_Name,
	udfn_GetProjectName(XM.ProjectID) as Project_Name,
	udfn_GetPromoterName(XM.PromoterID) as Promoter_Name,
	udfn_GetProjectAddressDistrictName(XM.ProjectID) as Project_AddressDistrictName,

	XM.EventAction_Type,
	XM.EventAction_Aggregate as EventAction_TypeName,
	XM.EventAction_IdentifiedOn,
	XM.EventAction_Aggregate,
	XM.Target_ResolutionDate,
	XM.Remarks_IfAny as EventRemarks_IfAny,
	XM.EventAction_Summary,

	'' as A_column,
	0 as B_column,
	'0001-01-01 00:00:00' as C_column,
	'0001-01-01 00:00:00' as D_column
FROM 
tbl_rera_project_regdiarynumber XN 
RIGHT OUTER JOIN
(
SELECT   
	 a.QUpdateProject_RegDiaryNumber_IndexID,
	 a.QUpdateProject_RegDiaryNumber_ID,
	 a.QUpdateProject_RegDiaryNumber_Name,
	 a.QUpdateProject_RegDiaryNumber_NameYear,
	 a.QUpdateProject_Year,
	 a.QUpdateProject_QuarterName,
	 a.UserID,
	 a.PromoterID,
	 a.ProjectID,
	 a.InventoryCount,
	 a.ParkingDetailsCount,
	 a.GeoTaggingPhotographCount,
	 a.InternalFacilitiesCount,
	 a.ExternalFacilitiesCount,
	 a.ApprovalsCount,
	 a.RERAnumber,
	 a.RERAnumberIssueDate,
	 a.RERAnumberVlaidUptoDate,
	 a.Extra2,
	 a.Extra3,
	 a.Extra4,
	 -- a.Remarks_IfAny,
	 a.IsActive,
	 a.IsDraft,
	 a.IsDraftHelpDesk,
	 a.IsDraftEvaluation,
	 a.IsDraftSecMember,
	 a.IsDraftMember,
	 a.IsActiveProvider,
	 a.IsLock,
	 a.CreatedBy,
	 a.CreatedOn,
