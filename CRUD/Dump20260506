  p_ComplaintRegDiaryNumber_NameYear int(11),
  p_FormM_RelatedComplaint_ID bigint(20),
  p_FormM_RelatedComplaint_Code varchar(50),
  p_Profile_ID bigint(20),
  p_User_ID varchar(50),
  p_ComplaintType_MN varchar(50),
  p_IsComplaintComplete int(11),
  p_IsPaymentComplete int(11),
  p_PaymentTransactionID varchar(100),
  p_PaymentTransactionDate datetime(3),
  p_IsDocumentsComplete int(11),
  p_DocumentUploadCount int(11),
  p_IsVerificationComplete int(11),
  p_ComplaintVerificationDate datetime(3),
  p_CurrentEventcode bigint(20),
  p_EventCodeDetails_indexID bigint(20),
  p_Remarks_IfAny varchar(250),
  p_A_column varchar(50),
  p_B_column varchar(50),
  p_C_column varchar(50),
  p_IsActive int(11),
  p_IsDraft int(11),
  p_IsLock int(11),
  p_IsPublicView int(11),
  p_IsDraftHelpDesk int(11),
  p_IsDraftEvaluation int(11),
  p_IsDraftSecMember int(11),
  p_IsDraftMember int(11),
  p_CreatedBy varchar(50),
  p_CreatedOn datetime(3),
  p_ModifyBy varchar(50),
  p_ModifyOn datetime(3),
  out p_Return_ComplaintM_RegDiaryNumber_Name varchar(50)          
)
begin        
             
  Declare v_mainCount Int;
 declare v_GET_Project_RegDiaryNumber_Name varchar(10);         
 declare v_PutComplaint_RegDiaryNumber_Name varchar(50);         
  declare v_GetComplaint_RegDiaryNumber_ID bigint;  
  declare v_PutComplaint_RegDiaryNumber_ID bigint;  
  declare v_checkrno int;  
  
  declare v_GetExistingForDeskComplaintRegDiaryNumber_Name varchar(50);
  declare v_GetExistingForDeskComplaintRegDiaryNumber_NameYear varchar(50); 
  declare v_GetExistingForDeskComplaintRegDiaryNumber_ID varchar(50);  
  
  declare v_PutComplaint_PaymentRefNumber_PRN bigint;
 
declare v_FormMdetailsCount int; 
declare v_DocumentDetailsCount int;
declare v_PaymentDetailsCount int;
declare v_AddCompDetailsCount int;
declare v_AddRespDetailsCount int;
declare v_checkFactsCaseDocCount int;       

declare v_checkExistingComplaintDiaryNumberCount int;
declare v_checkExistingEventCount int;

declare v_FormMdetailsRegdProjectYN varchar(50);

declare v_checkExistingEventVerificationCount int;
declare v_GetVerificationWithFilingDate datetime(3);

declare v_checkReminderSchedulerEmailsCount int;
declare v_checkReminderSchedulerSMSgatewayCount int;
 

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
 
 -- ------------------------- Application_id ------------------------            
 select max(ComplaintRegDiaryNumber_ID) into v_GetComplaint_RegDiaryNumber_ID from tbl_rera_complaint_formm_regdiarynumber where ComplaintRegDiaryNumber_NameYear=YEAR(NOW());        

 IF (v_GetComplaint_RegDiaryNumber_ID IS NULL)          
 then          
	set v_PutComplaint_RegDiaryNumber_ID=1;      
    set v_PutComplaint_RegDiaryNumber_Name=CONCAT('GCNo', CAST(LPAD(v_PutComplaint_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50))); 
 ELSE           
    SET v_PutComplaint_RegDiaryNumber_ID=v_GetComplaint_RegDiaryNumber_ID+1;      
    set v_PutComplaint_RegDiaryNumber_Name=CONCAT('GCNo', CAST(LPAD(v_PutComplaint_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
 end if;      
        
select count(*) into v_FormMdetailsCount from tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;    
select COUNT(*) into v_DocumentDetailsCount from tbl_rera_complaint_formm_listenclosuresdocuments where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
select count(*) into v_PaymentDetailsCount from tbl_rera_complaint_formm_paymentgateway where PaymentComplaint_RelatedComplainant_ID=p_ComplaintFormM_ID and IsActive=1;
select count(*) into v_AddCompDetailsCount from tbl_rera_complaint_formm_additioncomplainant where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
select count(*) into v_AddRespDetailsCount from tbl_rera_complaint_formm_additionrespondent where AdditionRespondentM_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
select count(*) into v_checkFactsCaseDocCount from tbl_rera_complaint_formm_document_factsofthecase where ComplainantApplicant_RelatedComplaintM_ID=p_ComplaintFormM_ID and IsActive=1;

if (v_FormMdetailsCount > 0) then
	select D_column into v_FormMdetailsRegdProjectYN from tbl_rera_complaint_formm_details where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1; 
	if (v_FormMdetailsRegdProjectYN = 'unregisteredproject') then
		set v_PutComplaint_RegDiaryNumber_Name =CONCAT(CAST(v_PutComplaint_RegDiaryNumber_Name as CHAR(150)), 'UR');
	end if;
end if; 

set v_GetVerificationWithFilingDate=NOW();
select count(*) into v_checkExistingEventVerificationCount from tbl_rera_complaint_formm_eventaction where EventAction_Type=330001 and Related_Complaint_ID=p_ComplaintFormM_ID;
if v_checkExistingEventVerificationCount>0
then
	select EventAction_IdentifiedOn into v_GetVerificationWithFilingDate from tbl_rera_complaint_formm_eventaction 
	where Related_Complaint_ID=p_ComplaintFormM_ID
	and EventAction_Type=330001
	order by ComplaintFormM_EventAction_ID asc
	limit 1;
end if;
    
    
if v_FormMdetailsCount>0     
then 
     update tbl_rera_complaint_formm_details set IsDraft=1, IsLock=1,  
		IsDocumentsComplete=1,
		IsVerificationComplete=1,
		ComplaintVerificationDate=v_GetVerificationWithFilingDate -- NOW()
		where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;
end if;
if v_DocumentDetailsCount>0     
then 
     update tbl_rera_complaint_formm_listenclosuresdocuments set IsDraft=1, IsLock=1  where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
end if;
if v_PaymentDetailsCount>0     
then 
     update tbl_rera_complaint_formm_paymentgateway set IsDraft=1, IsLock=1 where PaymentComplaint_RelatedComplainant_ID=p_ComplaintFormM_ID and IsActive=1;
     
     select PaymentComplaint_ID into v_PutComplaint_PaymentRefNumber_PRN from tbl_rera_complaint_formm_paymentgateway 
     where PaymentComplaint_RelatedComplainant_ID=p_ComplaintFormM_ID and IsActive=1 order by PaymentComplaint_ID desc Limit 1;
end if;
if v_AddCompDetailsCount>0     
then 
     update tbl_rera_complaint_formm_additioncomplainant set IsDraft=1, IsLock=1 where ComplainantorApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
end if;
if v_AddRespDetailsCount>0     
then 
     update tbl_rera_complaint_formm_additionrespondent set IsDraft=1, IsLock=1 where AdditionRespondentM_RelatedComplaint_ID=p_ComplaintFormM_ID and IsActive=1;
end if;

if (v_checkFactsCaseDocCount>0) then 
     update tbl_rera_complaint_formm_document_factsofthecase set IsDraft=1, IsLock=1 where ComplainantApplicant_RelatedComplaintM_ID=p_ComplaintFormM_ID and IsActive=1;
end if;
  
     
 -- ---STARTS--------check diary number in project quater table if not exits then no Diary Number implemented--------         
   if v_FormMdetailsCount>0 and v_PaymentDetailsCount>0    
     then      
     set  v_mainCount=1;      
    else    
     set  v_mainCount=0;      
     end if;     
-- ---------------if no diary number in quater table then set projet diary number to 0 else project Diary Number implemented------------------------------------------------------------------------------------------         
   if v_mainCount=0    
