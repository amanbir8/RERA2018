where Project_ID=p_Application_id and IsActive=1;



-- FLAG SET 3=> Pending/ 0=> Complete and Confirm Record/ 1=> Complete and Already Confirm Record
if v_getchkDocCount>v_getProjectDocValidCount or v_getchkDocCount=v_getProjectDocValidCount -- 17
then
if v_checkrecordcnt > 0 then
    if v_checkisdraftrecordcnt > 1 then
