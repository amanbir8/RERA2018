	where DocFilter_ProjectStatus_OnGoing=v_getProjectStatusOnGoing and
	DocFilter_AOS_AsFormat=v_getReraAgreementSale and
	DocFilter_Encumbrances=v_getEncumbrancesType and
	DocFilter_MegaProject=v_getMegaProject and
	DocFilter_LandStatus_OwnByPromoter=v_getProjectLandStatus and
	isactive=1;
