CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetDifferenceDateAllSeries`(project_ID bigint(20), start_date datetime(3), end_date datetime(3)) RETURNS varchar(1000) CHARSET utf8
BEGIN  
    declare v_ret_start varchar(100);    
    declare v_ret_end varchar(100);
    declare v_ret_loop varchar(100);
    declare v_ret_diarynumber varchar(100) default '';
    declare v_ret varchar(1000);
    declare v_diarynumber_count int(11);
    declare v_diarynumber_year int(11);
    declare v_counter int(11) default 1;
    declare v_loop_range int(11);
    
    SELECT TIMESTAMPDIFF(year, start_date, end_date) AS DateDiff into v_loop_range;
	-- set @i = 1;
    
    SELECT YEAR(start_date) AS extracted_startyear into v_ret_start;
    SELECT YEAR(end_date) AS extracted_endyear into v_ret_end;
    
    
    -- SELECT DATE(ADDDATE(start_date, INTERVAL @i:=@i+1 year)) AS date into v_ret; -- '2012-02-10'
     
	SET v_ret = v_ret_start;
    SET v_diarynumber_year=YEAR(start_date);
    
	SELECT count(ProjectStatementofAccounts_DiaryNumber) into v_diarynumber_count FROM tbl_rera_project_statementofaccountsapplicationformfive 
	where ProjectStatementofAccountsRelated_ProjectID=project_ID and isactive=1 and YEAR(FinancialYear_EndingOnDate)=v_diarynumber_year limit 1;  
    
    IF (v_diarynumber_count <> 0) THEN        
		SELECT ProjectStatementofAccounts_DiaryNumber into v_ret_diarynumber FROM tbl_rera_project_statementofaccountsapplicationformfive 
		where ProjectStatementofAccountsRelated_ProjectID=project_ID and isactive=1 and YEAR(FinancialYear_EndingOnDate)=v_diarynumber_year limit 1;

		SET v_ret = CONCAT(v_ret, '-', v_ret_diarynumber); 
	ELSE 
		SET v_ret = CONCAT(v_ret, '-NA');
	END IF;
    
    
	WHILE v_counter <= v_loop_range DO
    
		SET v_diarynumber_year = v_diarynumber_year + 1;
		SELECT count(ProjectStatementofAccounts_DiaryNumber) into v_diarynumber_count FROM tbl_rera_project_statementofaccountsapplicationformfive 
		where ProjectStatementofAccountsRelated_ProjectID=project_ID and isactive=1 and YEAR(FinancialYear_EndingOnDate)=v_diarynumber_year  limit 1;
        
        IF (v_diarynumber_count <> 0) THEN
        
		 	SELECT ProjectStatementofAccounts_DiaryNumber into v_ret_diarynumber FROM tbl_rera_project_statementofaccountsapplicationformfive 
		 	where ProjectStatementofAccountsRelated_ProjectID=project_ID and isactive=1 and YEAR(FinancialYear_EndingOnDate)=v_diarynumber_year  limit 1;

		 	SET v_ret_loop = CAST(v_ret_start AS SIGNED) + v_counter;  
		 	SET v_ret = CONCAT(v_ret, ',', space(1), v_ret_loop, '-', v_ret_diarynumber);
        ELSE        
			SET v_ret_loop = CAST(v_ret_start AS SIGNED) + v_counter;        
			SET v_ret = CONCAT(v_ret, ',', space(1), v_ret_loop, '-NA');        
        END IF;
		-- Increment the counter
		SET v_counter = v_counter + 1;        
	END WHILE;     
     
	-- SET v_ret = CONCAT(v_ret_start, ',', space(1) ,v_ret_end, space(1) , @i);
    
	IF (v_ret IS NULL) THEN   
	SET v_ret = 'NA';
	END IF;
    
	RETURN v_ret;
    
END ;;
