	  from  tbl_RERA_Project_Quater_RegDiaryNumber 
	  where Promoter_ID=p_Promoter_ID and 
			Project_ID=p_Project_ID and
			IsActive=1; 
		  
		  
	  update tbl_RERA_Project_Quater_RegDiaryNumber set IsActive=2
	  where Promoter_ID=p_Promoter_ID and 
			Project_ID=p_Project_ID and
			Project_QuaterRegDiaryNumber_ID=v_GetExistingForDeskProjectQuarterRegDiaryNumber_ID and
			IsActive=1;


-- ------- Generate Existing Diary Number (Application Modification)----------

INSERT INTO tbl_RERA_Project_Quater_RegDiaryNumber
	(
