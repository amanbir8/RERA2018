	'0001-01-01 00:00:00' as Project_RegistrationValidUptoDate,

	m.EventAction_Type as A_Column,
	m.EventAction_Aggregate as B_Column,
	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	from tbl_rera_project_extensionform_eventaction m   
	where m.IsActive=1 
	and m.EventAction_Type in (150017)
	and m.Related_Project_ID=p_RegPrj_ProjectRegistration_ID;

else

	-- Project Approval Display
	select 
	0 as ProjectRegistrationActionOne_ID,
	'NA' as ProjectRegistrationActionTwo_ID,
	a.Related_Promoter_ID as Related_Promoter_ID,
	a.Related_Project_ID as Related_Project_ID,

	'NA' as PromoterName,
	'NA' as ProjectName,
	'NA' as Promoter_DiaryNumber,
	'NA' as Project_DiaryNumber,
	Now() as Project_ApplicationDate,
	Now() as ProjectLastModifiedOn,
	'NA' as Project_RegistrationNumber,
	Now() as Registration_IssueDate,
	Now() as Registration_ValidUptoDate,

	a.EventAction_IdentifiedOn as RegistrationActionDate,
	'Project Application Approved' as RegistrationActionTitle,
	a.EventAction_IdentifiedBy as IdentifiedBy,
	a.Project_DiaryNumber as Project_DiaryNumber_RERANumber_PUCNumber,
	udfn_GetProjectApplicationDate(a.Related_Project_ID, a.Related_Promoter_ID) as Project_Diarydated_RERAdated_PUCdated,
	'0001-01-01 00:00:00' as Project_RegistrationValidUptoDate,

	a.EventAction_Type as A_Column,
	a.EventAction_Aggregate as B_Column,
	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	 
	from tbl_rera_project_promoter_eventaction a
	where a.Related_Project_ID=p_RegPrj_ProjectRegistration_ID 
	and a.EventAction_Type=110017


	UNION

	-- Project RERA Registration Display
	select 
	0 as ProjectRegistrationActionOne_ID,
	'NA' as ProjectRegistrationActionTwo_ID,
	Promoter_ID as Related_Promoter_ID,
	Project_ID as Related_Project_ID,

	'NA' as PromoterName,
	'NA' as ProjectName,
	'NA' as Promoter_DiaryNumber,
	'NA' as Project_DiaryNumber,
	Now() as Project_ApplicationDate,
	Now() as ProjectLastModifiedOn,
	'NA' as Project_RegistrationNumber,
	Now() as Registration_IssueDate,
	Now() as Registration_ValidUptoDate,


	c.EventAction_IdentifiedOn as RegistrationActionDate,
	'Project Registration Number Allotted' as RegistrationActionTitle,
	c.EventAction_IdentifiedBy as IdentifiedBy,
	a.RERAnumberRegistration as Project_DiaryNumber_RERANumber_PUCNumber,
	a.RERAnumberIssueDate as Project_Diarydated_RERAdated_PUCdated,
	a.RERAnumberRegUptoDate as Project_RegistrationValidUptoDate,

	c.EventAction_Type as A_Column,
	c.EventAction_Aggregate as B_Column,
	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
	where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
	and a.Project_ID=c.Related_Project_ID and c.IsActive=1 and a.IsActive=1 
	and c.EventAction_Type in (110020, 110023)
	and c.Related_Project_ID=p_RegPrj_ProjectRegistration_ID

    UNION

    -- Project Extension Approval Display
	select 
	0 as ProjectRegistrationActionOne_ID,
	'NA' as ProjectRegistrationActionTwo_ID,
	m.Related_Promoter_ID as Related_Promoter_ID,
	m.Related_Project_ID as Related_Project_ID,

	'NA' as PromoterName,
	'NA' as ProjectName,
	'NA' as Promoter_DiaryNumber,
	'NA' as Project_DiaryNumber,
	Now() as Project_ApplicationDate,
	Now() as ProjectLastModifiedOn,
	'NA' as Project_RegistrationNumber,
	Now() as Registration_IssueDate,
	Now() as Registration_ValidUptoDate,


	m.EventAction_IdentifiedOn as RegistrationActionDate,
	'Application for Extension of Registration Approved' as RegistrationActionTitle,
	m.EventAction_IdentifiedBy as IdentifiedBy,
	m.Project_DiaryNumber as Project_DiaryNumber_RERANumber_PUCNumber,
	udfn_GetProjectExtensionApplicationDate(m.Related_Project_ID, m.Related_Promoter_ID) as Project_Diarydated_RERAdated_PUCdated,
	'0001-01-01 00:00:00' as Project_RegistrationValidUptoDate,

	m.EventAction_Type as A_Column,
	m.EventAction_Aggregate as B_Column,
	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	from tbl_rera_project_extensionform_eventaction m   
	where m.IsActive=1 
	and m.EventAction_Type in (150017)
	and m.Related_Project_ID=p_RegPrj_ProjectRegistration_ID; 

end if;



IF `_rollback` THEN
ROLLBACK;
ELSE
COMMIT;
END IF;

