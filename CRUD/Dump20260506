CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_Count_RegDiaryNumber`(
	p_Related_Promoter_ID bigint,
	p_Related_TypeOfPromoter_ID int,
	p_Related_JointPromoter_ID bigint,
	p_Related_JointPromoter_Type int,
	p_Flag int,
	p_UserNam varchar(150)
)
begin 

declare v_mainCount int;

declare v_profie varchar(10);
declare v_othertrackrecordlitigations varchar(10);
declare v_CheckOtherTrackRecord varchar(10);
declare v_CheckOtherLitigations varchar(10);

declare v_getprofieCount int;
declare v_gettrackrecordlitigationsCount int;
declare v_getJointPromoterType int;
declare v_getOtherExperienceFlag int;
declare v_getOtherLitigationFlag int;

set v_profie='N';
set v_othertrackrecordlitigations='N';
set v_CheckOtherTrackRecord='N';
set v_CheckOtherLitigations='N';
set v_getJointPromoterType=0;
set v_mainCount=0;
set v_getOtherExperienceFlag=0;
set v_getOtherLitigationFlag=0;

select COUNT(*) into v_getprofieCount from tbl_rera_copromoter_registrationdetails 
	where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
	and Related_Promoter_Application_ID=p_Related_Promoter_ID
    and IsActive=1 and IsDraft in (1,5,6) and IsLock=1;
select COUNT(*) into v_gettrackrecordlitigationsCount from tbl_rera_copromoter_trackrecord_litigations 
	where Related_Promoter_ID=p_Related_Promoter_ID and Related_PromoterType=p_Related_TypeOfPromoter_ID
	and Related_JointPromoter_ID=p_Related_JointPromoter_ID -- and Related_JointPromoterType=p_Related_JointPromoter_Type
    and IsActive=1 and IsDraft in (1,5,6) and IsLock=1;

if (v_getprofieCount<>0) then
	set v_profie='Y'; 
    
	select CoPromoterType_Flag, (case when IsExperience='Y' then 1 else 0 end), (case when IsLitigation_RelatedProject='Y' then 1 else 0 end) 
    into v_getJointPromoterType, v_getOtherExperienceFlag, v_getOtherLitigationFlag
    from tbl_rera_copromoter_registrationdetails
	where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and CoPromoterType_Flag=p_Related_JointPromoter_Type
	and Related_Promoter_Application_ID=p_Related_Promoter_ID
	and IsActive=1 and IsDraft in (1,5,6) and IsLock=1
    order by CoPromoter_IndexID desc 
    Limit 1;
end if;

if v_gettrackrecordlitigationsCount<>0 then
	set v_othertrackrecordlitigations='Y'; 
end if;

if v_getOtherExperienceFlag<>0 then
	set v_CheckOtherTrackRecord='Y'; 
end if;
if v_getOtherLitigationFlag<>0 then
	set v_CheckOtherLitigations='Y'; 
end if;



if v_getJointPromoterType=1
then
    -- Individual Case
    if (v_CheckOtherLitigations='Y' AND v_CheckOtherTrackRecord='Y')
    then
		-- Yes Other Ltitgations
		if v_profie='Y' AND v_othertrackrecordlitigations='Y' 
		then
		set  v_mainCount=1;
		end if;
	else
	    -- No Other Ltitgations
		if v_profie='Y'
		then
		set  v_mainCount=1;
		end if;
	end if;
else 
	-- Other Than Individual Case
	if (v_CheckOtherLitigations='Y' AND v_CheckOtherTrackRecord='Y')
    then
		-- Yes Other Ltitgations
		if v_profie='Y' AND v_othertrackrecordlitigations='Y' 
		then
		set  v_mainCount=1;
		end if;
	else
	    -- No Other Ltitgations
		if v_profie='Y'
		then
		set  v_mainCount=1;
		end if;
	end if;
end if;
      
Select v_mainCount AS mainCount;

end ;;
DELIMITER ;
