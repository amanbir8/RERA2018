CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Project_RERAnumberCompletionPCC_ForDesk`(      
 p_Project_ID bigint,
 p_Promoter_ID bigint,
 p_PCC_DiaryNumber varchar(100)
)
begin 

declare v_reranumbercnt int;
declare v_reracompletionnumbercnt int;
 
declare v_ProjectRERAnumberRegistration varchar(150);
declare v_ProjectRERAnumberIssueDate datetime(3);
declare v_ProjectRERAnumberRegUptoDate datetime(3);


set v_reranumbercnt=0;
set v_reracompletionnumbercnt=0;


select count(*) into v_reranumbercnt from tbl_rera_ldr_project_reranumber_diarynumber 
where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1;

select count(*) into v_reracompletionnumbercnt from tbl_rera_ldr_project_reranumber_completioncertificate 
where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1;
     
if v_reranumbercnt>0 then	
	if v_reracompletionnumbercnt>0 then

		select * from tbl_rera_ldr_project_reranumber_completioncertificate    
		where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1
		order by PCC_IndexID asc;
 
	else
    
		-- Project RERA Registration Number Info		
        select RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate
        into v_ProjectRERAnumberRegistration, v_ProjectRERAnumberIssueDate, v_ProjectRERAnumberRegUptoDate
        from tbl_rera_ldr_project_reranumber_diarynumber where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1 limit 1;

		select
          0 as PCC_IndexID,
		  0 as PCC_ID,
		  a.ProjectDiaryNumber as ProjectRegDiaryNumber_Name,
		  b.Promoter_ID as Promoter_ID,
		  b.Project_ID as Project_ID,
		  b.UserID as User_ID,
		  v_ProjectRERAnumberRegistration as RERAnumberRegistration,
		  v_ProjectRERAnumberIssueDate as RERAnumberIssueDate,
		  v_ProjectRERAnumberRegUptoDate as RERAnumberRegUptoDate,
		  a.ProjectName as ProjectName,
		  a.PromoterName as PromoterName,
		  a.ProjectAddressDistrict as ProjectAddressDistrict,
		  '' as DName,
		  a.PCC_InfoDetails as PCC_InfoDetails,
		  a.PCC_ReferenceName as PCC_ReferenceName,
		  a.PCC_ReferenceDate as PCC_ReferenceDate,
		  a.PCC_IssueAuthority as PCC_CertificateStatus,
		  a.PCC_ReciptType as PCC_ReciptType,
		  '' as RemarksIfAny,
		  a.RERAnumberExtensionRegUptoDate as Extra1,
		  b.PCC_RegDiaryNumber_Name as Extra2,
		  '' as Extra3,
		  '' as Extra4,          
		  1 as IsActive,
		  0 as IsDraft,
		  0 as IsLock,
		  0 as IsDraftHelpDesk,
		  a.IsExtensionRegistration as IsDraftEvaluation,
		  0 as IsDraftSecMember,
		  0 as IsDraftMember,
		  1 as IsPublicView,                    
		  b.CreatedBy as CreatedBy,
		  b.CreatedOn as CreatedOn,
		  b.ModifyBy as ModifyBy,
		  b.ModifyOn as ModifyOn
        from tbl_rera_project_completiondetails a, tbl_rera_project_completioncertificate_regdiarynumber b
		where a.Promoter_ID=b.Promoter_ID
		and a.Project_ID=b.Project_ID
		and a.IsActive=1 and b.IsActive=1 
		and b.Project_ID=p_Project_ID;
        
	end if;	
end if;
    
end ;;
