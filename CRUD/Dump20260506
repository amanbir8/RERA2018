select IsProject_MegaProjectCategory into v_getMegaProject from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1;  

select
case 
when Project_Status='On-going' then 'Y'
when Project_Status='Complete' then 'N'
when Project_Status='New' then 'N'
end into v_getProjectStatusOnGoing
from tbl_RERA_Project_Registration where ProjectRegistration_ID=p_Application_id and IsActive=1; 
  
end if;    
    
if v_getKhasraAreaCount<>0    
then
	 -- Project Land Status (1-Y/N, 2-All)  
