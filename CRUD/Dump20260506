CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetUploadedDocument_FileSize`(p_filesize_value bigint) RETURNS varchar(200) CHARSET utf8
BEGIN  
    declare v_ret varchar(200);  
    declare v_filesize bigint;
	declare v_filedimension varchar(50);
     
    set v_filesize=0;
    
    if (p_filesize_value > 1048576) then
		set	v_filesize = ROUND(p_filesize_value * 100 / 1048576) / 100;
        set v_filedimension = 'MB';
	elseif (p_filesize_value > 1024) then
		set v_filesize = ROUND(p_filesize_value * 100 / 1024) / 100;
        set v_filedimension = 'KB';
    else
		set v_filesize = p_filesize_value;
        set v_filedimension = 'Bytes';
    end if;
    
	SET v_ret = CONCAT(v_filesize, space(1), v_filedimension);
	IF (v_ret IS NULL) THEN   
		SET v_ret = 'Unknown Value';
	END IF;
    RETURN v_ret;     

END ;;
DELIMITER ;
