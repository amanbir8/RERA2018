CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_Rera_Agent_AuthorityDesk_RERAnumberDiaryNumber`(  
	p_Agent_RERAnumber_DiaryNumber_IndexID bigint,
	p_Agent_RERAnumber_DiaryNumber_ID bigint,
	p_AgentRegDiaryNumber_Name varchar(250),
	p_AgentRegDiaryNumber_NameYear varchar(250),
	p_Agent_ID bigint,
	p_UserID varchar(250),
	p_Remarks_IfAny varchar(300),
	p_OtherMemDetailsCount int,
	p_DocumentuploadsCount int,
	p_UTotherStateRERACount int,
	p_PaymentsCount int,
	p_AgentDocumentCount int,
	p_CurrentEventcode bigint,
	p_EventCodeDetails_indexID bigint,
	p_tbl_RegDiaryNumber_indexID bigint,
	p_Project_ID bigint,
	p_Project_Name varchar(250),
	p_Promoter_ID bigint,
	p_Promoter_Name varchar(250),
	p_IsAlreadyRegistration varchar(50),
	p_ExistingRegistration varchar(250),
	p_Agent_Type int,
	p_Agent_FirstName varchar(250),
	p_Agent_MiddleName varchar(250),
	p_Agent_LastName varchar(250),
	p_Organization_Name varchar(250),
	p_BComm_AddressStateCode int,
	p_BComm_AddressDistrictCode int,
	p_EmailAddress varchar(250),
	p_MobileNumber bigint,
	p_RERAnumberRegistration varchar(250),
	p_RERAnumberIssueDate datetime(3),
	p_RERAnumberRegUptoDate datetime(3),
	p_Extra2 varchar(250),
	p_Extra3 varchar(250),
	p_Extra4 varchar(250),
	p_IsActive int,
	p_IsDraft int,           
	p_IsDraftHelpDesk int,
	p_IsDraftEvaluation int,
	p_IsDraftSecMember int,
	p_IsDraftMember int,
	p_IsPublicView int,
	p_CreatedBy  varchar(100),
	p_CreatedOn datetime(3),
	p_ModifyBy  varchar(100),
	p_ModifyOn datetime(3),
	out p_valreturn int 
)
BEGIN
  
 declare v_checkAgentRERAnumberDiaryNumber int ;  
 declare v_ChkDraftCount int;
 
 declare v_GetSequenceCode bigint;
 declare v_GetAgentStateTypeCode varchar(20);
 declare v_PutAgentStateTypeCode varchar(20);
 declare v_checkspecialnumber int;  
 
 select count(Agent_RERAnumber_DiaryNumber_ID) into v_checkAgentRERAnumberDiaryNumber from tbl_rera_ldr_agent_reranumber_diarynumber   
 where Agent_ID=p_Agent_ID 
 and Agent_RERAnumber_DiaryNumber_IndexID=p_Agent_RERAnumber_DiaryNumber_IndexID
 and IsActive=1;    
  
select count(*) into v_ChkDraftCount from tbl_rera_ldr_agent_reranumber_diarynumber   
 where Agent_ID=p_Agent_ID 
 and Agent_RERAnumber_DiaryNumber_IndexID=p_Agent_RERAnumber_DiaryNumber_IndexID
 and IsActive=1 and IsDraft=0;  
    
if (v_checkAgentRERAnumberDiaryNumber <> 0 and v_ChkDraftCount>0)
then    
 
 -- Registration Number and Special Number Logic
 -- A
 Select CONVERT(SUBSTRING(RTRIM(LTRIM(p_RERAnumberRegistration)), 17, 4), UNSIGNED) as GenNumber Into v_GetSequenceCode;
 Select SUBSTRING(RTRIM(LTRIM(p_RERAnumberRegistration)), 8, 3) as TypeNumber Into v_GetAgentStateTypeCode;
 
 set v_PutAgentStateTypeCode='PUN'; 
 IF (v_GetAgentStateTypeCode='CHD')
 then
	set v_PutAgentStateTypeCode='CHD';
 end if; 
 IF (v_GetAgentStateTypeCode='HRY')
 then
	set v_PutAgentStateTypeCode='HRY';
 end if; 
 IF (v_GetAgentStateTypeCode='HIM')
 then
	set v_PutAgentStateTypeCode='HIM';
 end if; 
 IF (v_GetAgentStateTypeCode='OTH')
 then
	set v_PutAgentStateTypeCode='OTH';
 end if;
 
 -- B
 IF (p_Extra2<>v_GetSequenceCode)
 then
	set p_Extra2=v_GetSequenceCode;
	set p_Extra3=v_PutAgentStateTypeCode;
	set p_Extra4='NRL';
 end if; 
 IF (p_Extra3<>v_PutAgentStateTypeCode)
 then
	set p_Extra2=v_GetSequenceCode;
	set p_Extra3=v_PutAgentStateTypeCode;
	set p_Extra4='NRL';
 end if;
 
