	p_IsDraftEvaluation int(11),
	p_IsDraftSecMember int(11),
	p_IsDraftMember int(11),
	p_IsActiveProvider int(11),
	p_IsLock int(11),
	p_CreatedBy varchar(50),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),
    out p_Return_QUProjectRegDiaryNumber_Name varchar(60)  
)
begin

	declare v_Get_QuarterlyYear varchar(10);
	declare v_Get_QuarterlyName varchar(10);
    declare v_PutProject_QUPRegDiaryNumber_Name varchar(50);
	declare v_GetProject_QUPRegDiaryNumber_ID bigint;  
	declare v_PutProject_QUPRegDiaryNumber_ID bigint;
    
	declare v_inventoryCount int;        
	declare v_parkingCount int;        
	declare v_statusphotographsCount int;        
	declare v_internalfacCount int;        
	declare v_externalfacCount int;        
	declare v_approvalsCount int;
    
	declare v_Totalregistered Int;
    declare v_TotalRERAcount Int;
    declare v_mainCount Int;  
    
	declare v_checkExistingQUPdiaryNumberCount int;
	declare v_GetExistingQUpdateRegDiaryNumber_Name varchar(50);
	declare v_GetExistingQUpdateRegDiaryNumber_NameYear varchar(50); 
	declare v_GetExistingQUpdateRegDiaryNumber_ID varchar(50);
    
    declare v_GetProject_RERAnumberRegistration varchar(100); 
    declare v_GetProject_RERAnumberIssueDate datetime(3); 
    declare v_GetProject_RERAnumberRegUptoDate datetime(3);
    
    declare v_checkExistingQUpdateEventCount int;
    declare v_checkExistingQUpdateEventProviderFlagCount int;
    declare v_Put_QuarterlyEventProviderFlag int;
	declare v_checkrno int;

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;
 
	-- ------------------------- Application_id ------------------------            
	select max(QUpdateProject_RegDiaryNumber_ID) into v_GetProject_QUPRegDiaryNumber_ID from tbl_rera_project_quarterlyupdate_regdiarynumber where QUpdateProject_RegDiaryNumber_NameYear=YEAR(NOW());
     
	Set v_Get_QuarterlyName='N';
	IF (p_QUpdateProject_QuarterName ='FirstQTR') then
		Set v_Get_QuarterlyName='F';
    end if;
	IF (p_QUpdateProject_QuarterName ='SecondQTR') then
		Set v_Get_QuarterlyName='S';
    end if;
	IF (p_QUpdateProject_QuarterName ='ThirdQTR') then
		Set v_Get_QuarterlyName='T';
    end if;
    IF (p_QUpdateProject_QuarterName ='FourthQTR') then
		Set v_Get_QuarterlyName='L';
    end if;
    
    
    if (p_QUpdateProject_Year IS NULL) then
		set v_Get_QuarterlyYear='0000';
    else
		set v_Get_QuarterlyYear=CAST(p_QUpdateProject_Year as CHAR(10));
    end if;
    
     
	IF (v_GetProject_QUPRegDiaryNumber_ID IS NULL)          
	then          
		set v_PutProject_QUPRegDiaryNumber_ID=1;      
		set v_PutProject_QUPRegDiaryNumber_Name=CONCAT('QUP', CAST(v_Get_QuarterlyYear as CHAR(50)), CAST(v_Get_QuarterlyName as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)), CAST(LPAD(v_PutProject_QUPRegDiaryNumber_ID, 4, '0') as CHAR(50)));         
	ELSE           
		SET v_PutProject_QUPRegDiaryNumber_ID=v_GetProject_QUPRegDiaryNumber_ID+1;      
		set v_PutProject_QUPRegDiaryNumber_Name=CONCAT('QUP', CAST(v_Get_QuarterlyYear as CHAR(50)), CAST(v_Get_QuarterlyName as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)), CAST(LPAD(v_PutProject_QUPRegDiaryNumber_ID, 4, '0') as CHAR(50)));
	end if;



select COUNT(*) into v_inventoryCount from tbl_rera_project_quarterlyupdate_inventory 
	where isactive=1 and Related_ProjectRegistration_ID=p_QUpdateProject_ID and QUpdateInventory_Year=p_QUpdateProject_Year and QUpdateInventory_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);
select COUNT(*) into v_parkingCount from tbl_rera_project_quarterlyupdate_parkingdetails 
	where isactive=1 and Related_ParkingProjectRegistration_ID=p_QUpdateProject_ID and QUpdateParking_Year=p_QUpdateProject_Year and QUpdateParking_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);
select COUNT(*) into v_statusphotographsCount from tbl_rera_project_quarterlyupdate_constructionstatusphotographs 
	where isactive=1 and ProjectPhotographsRelated_Project_ID=p_QUpdateProject_ID and QUpdatePhotographs_Year=p_QUpdateProject_Year and QUpdatePhotographs_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);
select COUNT(*) into v_internalfacCount from tbl_rera_project_quarterlyupdate_internalfacilities 
	where isactive=1 and ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_QUpdateProject_ID and QUpdateInfraFacilities_Year=p_QUpdateProject_Year and QUpdateInfraFacilities_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);
select COUNT(*) into v_externalfacCount from tbl_rera_project_quarterlyupdate_externalfacilities 
	where isactive=1 and ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_QUpdateProject_ID and QUpdateInfraExFacilities_Year=p_QUpdateProject_Year and QUpdateInfraExFacilities_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);
select COUNT(*) into v_approvalsCount from tbl_rera_project_quarterlyupdate_approvaldetails 
	where isactive=1 and Related_ApprovalProjectRegistration_ID=p_QUpdateProject_ID and QUpdateApproval_Year=p_QUpdateProject_Year and QUpdateApproval_QuarterName=p_QUpdateProject_QuarterName and IsDraft in (1,5,6);


SELECT COUNT(*) INTO v_Totalregistered FROM tbl_RERA_Project_RegDiaryNumber where Project_ID=p_QUpdateProject_ID and Promoter_ID=p_QUpdatePromoter_ID and IsActive=1 and IsDraft=1;
SELECT COUNT(*) INTO v_TotalRERAcount FROM tbl_rera_ldr_project_reranumber_diarynumber where Project_ID=p_QUpdateProject_ID and Promoter_ID=p_QUpdatePromoter_ID and IsActive=1 and IsPublicView=1;

if v_Totalregistered>0 and v_TotalRERAcount>0     
then      
	set  v_mainCount=1;      
else    
	set  v_mainCount=0;      
end if;


-- START-101 -- [if DiaryNumber and RERA Number exits in table then QUP Diary Number implemented else set Zero] --         
IF (v_mainCount=0)   
THEN
	set v_GetProject_QUPRegDiaryNumber_ID=0;    
	set v_PutProject_QUPRegDiaryNumber_Name='0';    
ELSE
      
      -- START-102 -- [Check Count Existing QUP Diary Number] --      
      SELECT COUNT(*) into v_checkExistingQUPdiaryNumberCount FROM tbl_rera_project_quarterlyupdate_regdiarynumber
      where ProjectID=p_QUpdateProject_ID and PromoterID=p_QUpdatePromoter_ID
      and QUpdateProject_Year=p_QUpdateProject_Year and QUpdateProject_QuarterName=p_QUpdateProject_QuarterName
      and IsActive=1;
      
      
      SELECT RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate 
	  INTO v_GetProject_RERAnumberRegistration, v_GetProject_RERAnumberIssueDate, v_GetProject_RERAnumberRegUptoDate
      FROM tbl_rera_ldr_project_reranumber_diarynumber 
      where Project_ID=p_QUpdateProject_ID and Promoter_ID=p_QUpdatePromoter_ID and IsActive=1;
      
      -- INSERT QUP DiaryNumber
      IF v_checkExistingQUPdiaryNumberCount>0 THEN
		  
          -- START-103 -- [Update Previous Record (LOCK)] --
		  update tbl_rera_project_quarterlyupdate_regdiarynumber set IsDraft=1, IsLock=1 
		  where ProjectID=p_QUpdateProject_ID and PromoterID=p_QUpdatePromoter_ID
		  and QUpdateProject_Year=p_QUpdateProject_Year and QUpdateProject_QuarterName=p_QUpdateProject_QuarterName 
		  and IsActive=1;
		  
		  -- extract existing code
		  select QUpdateProject_RegDiaryNumber_Name, QUpdateProject_RegDiaryNumber_NameYear, QUpdateProject_RegDiaryNumber_ID 
          INTO v_GetExistingQUpdateRegDiaryNumber_Name, v_GetExistingQUpdateRegDiaryNumber_NameYear, v_GetExistingQUpdateRegDiaryNumber_ID
		  from  tbl_rera_project_quarterlyupdate_regdiarynumber 
		  where ProjectID=p_QUpdateProject_ID and PromoterID=p_QUpdatePromoter_ID
		  and QUpdateProject_Year=p_QUpdateProject_Year and QUpdateProject_QuarterName=p_QUpdateProject_QuarterName 
		  and IsActive=1; 
			
		  update tbl_rera_project_quarterlyupdate_regdiarynumber set IsActive=2
		  where ProjectID=p_QUpdateProject_ID and PromoterID=p_QUpdatePromoter_ID
		  and QUpdateProject_Year=p_QUpdateProject_Year and QUpdateProject_QuarterName=p_QUpdateProject_QuarterName
		  and QUpdateProject_RegDiaryNumber_Name=v_GetExistingQUpdateRegDiaryNumber_Name
          and IsActive=1;	  
		  
		  
     
		  -- ------- Generate New Diary Number (Application Modification)---------- 
		  INSERT INTO tbl_rera_project_quarterlyupdate_regdiarynumber        
		  (        
			-- QUpdateProject_RegDiaryNumber_IndexID,
			QUpdateProject_RegDiaryNumber_ID,
			QUpdateProject_RegDiaryNumber_Name,
			QUpdateProject_RegDiaryNumber_NameYear,
			QUpdateProject_Year,
			QUpdateProject_QuarterName,
			UserID,
			PromoterID,
			ProjectID,              
			InventoryCount,
			ParkingDetailsCount,
			GeoTaggingPhotographCount,
			InternalFacilitiesCount,
			ExternalFacilitiesCount,
			ApprovalsCount,              
			RERAnumber,
			RERAnumberIssueDate,
			RERAnumberVlaidUptoDate,              
			Extra2,
			Extra3,
			Extra4,
			Remarks_IfAny,
			IsActive,
			IsDraft,
			IsDraftHelpDesk,
			IsDraftEvaluation,
			IsDraftSecMember,
			IsDraftMember,
			IsActiveProvider,
			IsLock,
			CreatedBy,
			CreatedOn,
			ModifyBy,
			ModifyOn
		  )        
		  VALUES        
		  (   
			v_GetExistingQUpdateRegDiaryNumber_ID,
			v_GetExistingQUpdateRegDiaryNumber_Name, 
			v_GetExistingQUpdateRegDiaryNumber_NameYear, 
			p_QUpdateProject_Year,
			p_QUpdateProject_QuarterName,
			p_QUpdateUserID,
			p_QUpdatePromoter_ID,
			p_QUpdateProject_ID,
			v_inventoryCount,      
			v_parkingCount,      
			v_statusphotographsCount,     
			v_internalfacCount,    
			v_externalfacCount,   
			v_approvalsCount,
			v_GetProject_RERAnumberRegistration, 
			v_GetProject_RERAnumberIssueDate, 
			v_GetProject_RERAnumberRegUptoDate,
			p_Extra2,
			p_Extra3,
			p_Extra4,
			p_Remarks_IfAny,
			1, --  p_IsActive,
			1, --  p_IsDraft,
			p_IsDraftHelpDesk,
			p_IsDraftEvaluation,
			p_IsDraftSecMember,
			p_IsDraftMember,
			p_IsActiveProvider,
			1, --  p_IsLock,                       
			p_CreatedBy,
			NOW(), -- p_CreatedOn,
			p_ModifyBy,
			NOW() -- p_ModifyOn
		  );
      
      else
		  -- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
		  INSERT INTO tbl_rera_project_quarterlyupdate_regdiarynumber        
		  (        
			-- QUpdateProject_RegDiaryNumber_IndexID,
			QUpdateProject_RegDiaryNumber_ID,
			QUpdateProject_RegDiaryNumber_Name,
			QUpdateProject_RegDiaryNumber_NameYear,
			QUpdateProject_Year,
			QUpdateProject_QuarterName,
			UserID,
			PromoterID,
			ProjectID,              
			InventoryCount,
			ParkingDetailsCount,
			GeoTaggingPhotographCount,
			InternalFacilitiesCount,
			ExternalFacilitiesCount,
			ApprovalsCount,              
			RERAnumber,
			RERAnumberIssueDate,
			RERAnumberVlaidUptoDate,              
			Extra2,
			Extra3,
			Extra4,
			Remarks_IfAny,
			IsActive,
			IsDraft,
			IsDraftHelpDesk,
			IsDraftEvaluation,
			IsDraftSecMember,
			IsDraftMember,
			IsActiveProvider,
			IsLock,
			CreatedBy,
			CreatedOn,
			ModifyBy,
			ModifyOn        
		  )        
		  VALUES        
		  ( 
            v_PutProject_QUPRegDiaryNumber_ID,
            v_PutProject_QUPRegDiaryNumber_Name,   
			YEAR(NOW()),       
			p_QUpdateProject_Year,
			p_QUpdateProject_QuarterName,
			p_QUpdateUserID,
			p_QUpdatePromoter_ID,
			p_QUpdateProject_ID,        
			v_inventoryCount,      
			v_parkingCount,      
			v_statusphotographsCount,     
			v_internalfacCount,    
			v_externalfacCount,   
			v_approvalsCount,
			v_GetProject_RERAnumberRegistration, 
			v_GetProject_RERAnumberIssueDate, 
			v_GetProject_RERAnumberRegUptoDate,
            p_Extra2,
			p_Extra3,
			p_Extra4,
			p_Remarks_IfAny,
			1, --  p_IsActive,
			1, --  p_IsDraft,
			p_IsDraftHelpDesk,
			p_IsDraftEvaluation,
			p_IsDraftSecMember,
			p_IsDraftMember,
			p_IsActiveProvider,
			1, --  p_IsLock,                       
			p_CreatedBy,
			NOW(), -- p_CreatedOn,
			p_ModifyBy,
			NOW() -- p_ModifyOn  
		  );
     END IF;
     -- END-103       
        
	
    -- START-104 -- [Event ActiveProvider Setter] --
    select COUNT(*) into v_checkExistingQUpdateEventProviderFlagCount from  tbl_rera_project_quarterlyupdate_eventaction 
	where Related_Project_ID=p_QUpdateProject_ID and Related_Promoter_ID=p_QUpdatePromoter_ID	
    and IsActive=1;
    
    IF (v_checkExistingQUpdateEventProviderFlagCount>0) THEN
    
        update tbl_rera_project_quarterlyupdate_eventaction set IsActiveProvider=0 
		where Related_Project_ID=p_QUpdateProject_ID and Related_Promoter_ID=p_QUpdatePromoter_ID		
		and IsActive=1;
		
		set v_Put_QuarterlyEventProviderFlag=1;
    ELSE
		set v_Put_QuarterlyEventProviderFlag=1;
    END IF;
    -- END-104   
    
    
    -- INSERT QUP Event Record
	select COUNT(*) into v_checkExistingQUpdateEventCount from  tbl_rera_project_quarterlyupdate_eventaction 
	where Related_Project_ID=p_QUpdateProject_ID and Related_Promoter_ID=p_QUpdatePromoter_ID
	and Related_QUpdateProject_Year=p_QUpdateProject_Year and Related_QUpdateProject_QuarterName=p_QUpdateProject_QuarterName
    and IsActive=1;
    
    -- START-105 -- [Event Addition] --
	IF (v_checkExistingQUpdateEventCount>0) THEN
	
		-- -----------------------
		update tbl_rera_project_quarterlyupdate_eventaction set IsActive=2 
		where Related_Project_ID=p_QUpdateProject_ID and Related_Promoter_ID=p_QUpdatePromoter_ID
		and Related_QUpdateProject_Year=p_QUpdateProject_Year and Related_QUpdateProject_QuarterName=p_QUpdateProject_QuarterName
		and IsActive=1;
	  
	  
	    INSERT INTO tbl_rera_project_quarterlyupdate_eventaction  
		(
			-- QUpdateProjectEventAction_ID,
			EventAction_Type,
			EventAction_IdentifiedBy,
			EventAction_IdentifiedOn,
			Related_Promoter_ID,
			Related_Project_ID,
			Related_QUpdateProject_Year,
			Related_QUpdateProject_QuarterName,
			DiaryNumber_Promoter,
			DiaryNumber_Project,
			DiaryNumber_QUpdateProject,
			EventAction_Summary,
			EventAction_Description,
			EventAction_Category,
			EventAction_Aggregate,
			EventAction_Relationship,
			AssignedTo,
			Target_ResolutionDate,
			Target_ResolutionSummary,
			Actual_ResolutionDate,
			IsBefore_TargetResolution,
			ProgressStatus,
			Remarks_IfAny,
			IsActive,
			IsDraft,
			IsActiveProvider,
			IsLock,
			CreatedBy,
			CreatedOn,
			ModifyBy,
			ModifyOn
		)  
		VALUES 
		(   
			160004,  
			'999',  
			NOW(),    
			p_QUpdatePromoter_ID,
			p_QUpdateProject_ID,
            p_QUpdateProject_Year,
			p_QUpdateProject_QuarterName,
            p_Extra2, -- ProjectDiaryNumber
            v_GetProject_RERAnumberRegistration, -- RERA Number
            v_GetExistingQUpdateRegDiaryNumber_Name, -- QUP DairyNumber 
			'Application Re-Submitted with Modification',  
			'Application submiited by Promoter with RERA',  
			'Actor Anonymous',  
			'Application Re-Submitted with Modification',  
			'Role Promoter',  
			'HelpDesk Level I',  
			NOW(),    
			'999' ,  
			NOW(),    
			1,  
			'Quarterly Updates' ,  
			'Application Re-Submitted (Modified Application)',  
			1, -- IsActive,
			0, -- IsDraft,
            v_Put_QuarterlyEventProviderFlag, -- IsActiveProvider,
            0, -- IsLock,
			'sysadmin',  
			NOW(),    
			'sysadmin',  
			NOW()  
        );  
  
	    set v_PutProject_QUPRegDiaryNumber_Name=v_GetExistingQUpdateRegDiaryNumber_Name;
  
	else
  
	    INSERT INTO tbl_rera_project_quarterlyupdate_eventaction  
		(
			-- QUpdateProjectEventAction_ID,
			EventAction_Type,
			EventAction_IdentifiedBy,
			EventAction_IdentifiedOn,
			Related_Promoter_ID,
			Related_Project_ID,
			Related_QUpdateProject_Year,
			Related_QUpdateProject_QuarterName,
			DiaryNumber_Promoter,
			DiaryNumber_Project,
			DiaryNumber_QUpdateProject,
			EventAction_Summary,
			EventAction_Description,
			EventAction_Category,
			EventAction_Aggregate,
			EventAction_Relationship,
			AssignedTo,
			Target_ResolutionDate,
			Target_ResolutionSummary,
			Actual_ResolutionDate,
			IsBefore_TargetResolution,
			ProgressStatus,
			Remarks_IfAny,
			IsActive,
			IsDraft,
			IsActiveProvider,
			IsLock,
			CreatedBy,
			CreatedOn,
			ModifyBy,
			ModifyOn
		)  
		VALUES  
		(   
			160001,  
			'999',  
			NOW(), 
            p_QUpdatePromoter_ID,
			p_QUpdateProject_ID,
            p_QUpdateProject_Year,
			p_QUpdateProject_QuarterName,
            p_Extra2, -- ProjectDiaryNumber
            v_GetProject_RERAnumberRegistration, -- RERA Number
            v_PutProject_QUPRegDiaryNumber_Name, -- QUP DairyNumber 
			'Quarterly Updates of Project Submitted (New Application)',  
			'Quarterly Updates submiited by Promoter with RERA',  
			'Actor Anonymous',  
			'Quarterly Updates Submitted',  
			'Role Promoter',  
			'HelpDesk Level I',  
			NOW(),    
			'999',  
			NOW(),    
			1,  
			'Quarterly Updates',  
			'Quarterly Updates of Registered Project',
            1, -- IsActive,
			0, -- IsDraft, 
            v_Put_QuarterlyEventProviderFlag, -- IsActiveProvider,
            0, -- IsLock,
			'sysadmin',  
			NOW(),    
			'sysadmin',  
			NOW()
		); 
 
	end if; 
	-- END-105
    
	-- END-102
END IF;
-- -- END-101 --

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;  
      
set p_Return_QUProjectRegDiaryNumber_Name= v_PutProject_QUPRegDiaryNumber_Name; 
  
END ;;
