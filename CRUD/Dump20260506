CREATE DEFINER=`sa`@`%` PROCEDURE `Display_RERA_Project_ExtensionFormContentPrmPrjFeeForDesk`(
  p_ExtnFrm_ProjectRegistration_ID bigint,
  p_ExtnFrm_ProjectPromoter_ID bigint,
  p_ExtnFrm_ProjectExtension_ID bigint
)
begin

declare v_Get_ProjectExtension_ID bigint;
declare v_Get_ProjectExtension_DiaryNumber varchar (150);
declare v_Get_ProjectExtension_ApplicationDate datetime(3);

declare v_Get_Related_Promoter_ID bigint;
declare v_Get_Related_Project_ID bigint;
declare v_Get_Project_DiaryNumber varchar (150);
declare v_Get_Project_ApplicationDate datetime(3);

declare v_Get_Project_OfflineYN int;
declare v_Get_Project_ApprovalDate datetime(3);
declare v_Get_ProjectLastModifiedOn datetime(3);
declare v_Get_PromoterProject_OfflineYN varchar (150);

declare v_Get_Project_RegistrationNumber varchar (150);
declare v_Get_Registration_IssueDate datetime(3);
declare v_Get_Registration_ValidUptoDate datetime(3);


DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

-- Extension Form Application Display
select ProjectExtForm_RegDiaryNumber_ID, ProjectExtForm_RegDiaryNumber_Name, CreatedOn 
into v_Get_ProjectExtension_ID, v_Get_ProjectExtension_DiaryNumber, v_Get_ProjectExtension_ApplicationDate
from tbl_rera_projectextensionform_regdiarynumber where Project_ID=p_ExtnFrm_ProjectRegistration_ID 
order by ProjectExtForm_RegDiaryNumber_IndexID asc
Limit 1;

-- Project Application Display
select Related_Promoter_ID, Related_Project_ID, Project_DiaryNumber, EventAction_IdentifiedOn
into v_Get_Related_Promoter_ID, v_Get_Related_Project_ID, v_Get_Project_DiaryNumber, v_Get_Project_ApplicationDate
from tbl_rera_project_promoter_eventaction
where Related_Project_ID=p_ExtnFrm_ProjectRegistration_ID and EventAction_Type=110001
order by PromoterEventAction_ID asc
Limit 1;

-- Project RERA Registration Display
select a.RERAnumberRegistration, a.RERAnumberIssueDate, a.RERAnumberRegUptoDate
into v_Get_Project_RegistrationNumber, v_Get_Registration_IssueDate, v_Get_Registration_ValidUptoDate
-- c.EventAction_Type,  
-- c.EventAction_IdentifiedOn,  
-- c.EventAction_Aggregate 
from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_rera_project_promoter_eventaction c   
where a.ProjectRegDiaryNumber_Name=c.Project_DiaryNumber  
and a.Project_ID=c.Related_Project_ID and c.IsActive=1 and a.IsActive=1 
and c.EventAction_Type in (110020, 110023)
and c.Related_Project_ID=p_ExtnFrm_ProjectRegistration_ID; 


-- Project Mode (Offline OR Online) Display
select count(*) into v_Get_Project_OfflineYN from tbl_rera_project_registration 
where ProjectRegistration_ID=p_ExtnFrm_ProjectRegistration_ID
and IsAlready_RERANumber='Y'
and isactive=1;

if (v_Get_Project_OfflineYN > 0) then      
	set v_Get_Project_ApprovalDate=v_Get_Registration_IssueDate; -- v_Get_Project_ApplicationDate;  
    set v_Get_PromoterProject_OfflineYN='(Offline Registration)';
else         
	select EventAction_IdentifiedOn into v_Get_Project_ApprovalDate
	from tbl_rera_project_promoter_eventaction
	where Related_Project_ID=p_ExtnFrm_ProjectRegistration_ID and EventAction_Type=110017
	order by PromoterEventAction_ID desc
	Limit 1;  
    set v_Get_PromoterProject_OfflineYN='';
end if;

-- Extension Form LastActionDate Display
select EventAction_IdentifiedOn into v_Get_ProjectLastModifiedOn from tbl_rera_project_extensionform_eventaction 
where Related_Project_ID=p_ExtnFrm_ProjectRegistration_ID and Related_Promoter_ID=v_Get_Related_Promoter_ID and isactive=1;


-- Main Select Retuen
      
select 
	0 as ProjectExtFormOne_ID,
	0 as ProjectExtFormTwo_ID,

	v_Get_ProjectExtension_ID as Related_ProjectExtension_ID,
	v_Get_ProjectExtension_DiaryNumber as ProjectExtension_DiaryNumber,
	v_Get_ProjectExtension_ApplicationDate as ProjectExtension_ApplicationDate,

	v_Get_Related_Promoter_ID as Related_Promoter_ID,
	v_Get_Related_Project_ID as Related_Project_ID,
	v_Get_PromoterProject_OfflineYN as Promoter_DiaryNumber, -- Offline Mode OR Online Mode
	v_Get_Project_DiaryNumber as Project_DiaryNumber,
	v_Get_Project_ApplicationDate as Project_ApplicationDate,

	udfn_GetPromoterName(v_Get_Related_Promoter_ID) as PromoterName,
	udfn_GetProjectName(v_Get_Related_Project_ID) as ProjectName,
	v_Get_Project_ApprovalDate as Project_ApprovalDate,
	v_Get_ProjectLastModifiedOn as ProjectLastModifiedOn,

	v_Get_Project_RegistrationNumber as Project_RegistrationNumber,
	v_Get_Registration_IssueDate as Registration_IssueDate,
	v_Get_Registration_ValidUptoDate as Registration_ValidUptoDate,

	'NA' as A_Column,
	'NA' as B_Column,
	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn;
   

IF `_rollback` THEN
ROLLBACK;
ELSE
COMMIT;
END IF;

-- IF @@ERROR<>0      
--      BEGIN      
--       ROLLBACK      
--      -- SET @MAXID=0    
--       RETURN          
--      END      
--    COMMIT TRANSACTION    
 
-- END TRY    

-- BEGIN CATCH    
-- SELECT @out_error_number=ERROR_NUMBER()    
-- END CATCH  

end ;;
DELIMITER ;
