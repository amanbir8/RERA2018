		PUC_ReferencePUC_Name,
		PUC_ReferencePUC_Date,
		RERA_RegistrationNumber,
		EventAction_Summary,
		EventAction_Description,
		EventAction_Category,
		EventAction_Aggregate,
		EventAction_Relationship,
		AssignedTo,
		Target_ResolutionDate,
		Target_ResolutionSummary,
		Actual_ResolutionDate,
		IsBefore_TargetResolution,
		ProgressStatus,
		Remarks_IfAny,
		IsActive,
		IsDraft,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	) 
	VALUES  
	( 
		-- ProjectEventActionPUC_ID,
		910002,  -- Close PUC By Admin Event
		p_CreatedBy,  
		NOW(), 
		p_Related_Promoter_ID,
		p_Related_Project_ID,
		p_RelatedApplicationPUC_ID, 
		'',
		p_ProjectDiaryNumber,
		p_PUC_DiaryNumber,
		p_PUC_ReferencePUC_Name,
		p_PUC_ReferencePUC_Date,
		p_RERAnumberRegistration,
		'PUC Closed (Completed)',  
		'Change Request (PUC) Updated/Modified',  
		'System Administrator',  
		'PUC Closed (Completed)',  
		'Role Admin',  
		'HelpDesk Level II', 
		NOW(),    
		'999',  
		NOW(), 
		0,
		'In Process' ,  
		'Change Request (PUC)(Promoter Name) Updated/Modified',
		1,  
		0,  
		p_CreatedBy,  
		NOW(),    
		p_ModifyBy, 
		NOW()
	);
end if;
-- END verify (Registration Number)

else
	set p_PUC_DiaryNumber='Already in-complete registered project';
end if;
-- END (registration count)

else
	set p_PUC_DiaryNumber='Invalid Type of Promoter';
end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

set p_valreturn=p_PUC_DiaryNumber; 

END ;;
