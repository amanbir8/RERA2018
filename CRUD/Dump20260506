	and isactive=1
	Limit 1; 
end if;


select
	m.QUP_ProjectProvider_IndexID,
	m.QUP_ProjectProvider_ID,
	m.QUpdateProject_Year,
	m.QUpdateProject_QuarterName,
	m.UserID,
	m.PromoterID,
	m.ProjectID,
	m.RERA_RegistrationID,
	m.DiaryNumber_Project,
	m.DiaryNumber_ExtensionProject,
	m.ReferenceNumber,
	m.ReferenceDate,
	m.Remarks_IfAny,
	m.Locked_From_Date,
	m.Locked_To_Date,
	m.A_column,
	m.B_column,
	m.C_column,
	m.IsActive,
	m.IsDraft,
	m.IsDraftSecMember,
	m.IsDraftMember,
	m.IsActiveProvider,
	m.IsLock,
	m.CreatedBy,
	m.CreatedOn,
	m.ModifyBy,
	m.ModifyOn,

	g.Promoter_ID as RelatedPromoter_ID,
	g.Project_ID as RelatedProject_ID,
	'0' as User_ID,
	g.RERAnumberRegistration as RERAnumberRegistration,
	g.RERAnumberIssueDate as RERAnumberIssueDate,
	g.RERAnumberRegUptoDate as RERAnumberRegUptoDate,
