	ELSE           
		set v_PutRenewalAgent_RegDiaryNumber_ID=v_GetRenewalAgent_RegDiaryNumber_ID+1;      
		set v_PutRenewalAgent_RegDiaryNumber_Name=CONCAT('FormJ', CAST(YEAR(NOW()) as CHAR(50)),'R' ,CAST(LPAD(v_Put_RenewalSequenceID, 2, '0') as CHAR(50)) ,CAST(LPAD(v_PutRenewalAgent_RegDiaryNumber_ID, 4, '0') as CHAR(50)));
	END IF;


select COUNT(*) into v_profileCount from tbl_rera_agent_renewal_profile 
	where RenewalAgent_ID=p_Related_RenewalAgent_ID and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
    and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsLock=1 and IsDraft in (1,5,6);
select COUNT(*) into v_othermemberCount from tbl_rera_agent_renewal_othermemberdetail 
	where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
    and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsLock=1 and IsDraft in (1,5,6);
select COUNT(*) into v_documentCount from tbl_rera_agent_renewal_documents 
	where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
    and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsLock=1 and IsDraft in (1,5,6);   
select COUNT(*) into v_otherstateregisterCount from tbl_rera_agent_renewal_otherstateut_regreradetails 
	where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
    and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsLock=1 and IsDraft in (1,5,6);
select COUNT(*) into v_paymentfeeCount from tbl_rera_agent_renewal_payment 
	where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
    and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsLock=1 and IsDraft in (1,5,6);


SELECT COUNT(*) INTO v_Totalofflineregistered FROM tbl_rera_agent_offlineagents_pendinguploads where OfflineAgents_RERAregistrationNumber=p_Related_Registration_Number and isactive=1;
SELECT COUNT(*) INTO v_Totalprofile FROM tbl_rera_agent_profile where Agent_ID=p_Related_Agent_ID and Agent_Type=p_Related_TypeOfAgent_ID and IsActive=1 and IsDraft in (1,5,6);
SELECT COUNT(*) INTO v_Totalregistered FROM tbl_rera_agent_regdiarynumber where Agent_ID=p_Related_Agent_ID and IsActive=1 and IsDraft=1;
SELECT COUNT(*) INTO v_TotalRERAcount FROM tbl_rera_ldr_agent_reranumber_diarynumber where Agent_ID=p_Related_Agent_ID and IsActive=1 and IsPublicView=1;

if (v_Totalregistered>0 and v_TotalRERAcount>0) then      
	set  v_mainCount=1;      
else
	if (v_Totalprofile>0 or v_Totalofflineregistered>0) then      
		set  v_mainCount=1;      
	else
		set  v_mainCount=0;      
	end if;     
end if;


-- START-101 -- [if (DiaryNumber and RERA Number exits in table) or (Profile-ID and Offline RERA Number exits in table) then RenewalAgent-DiaryNumber implemented else set Zero] --         
IF (v_mainCount=0)   
THEN
	set v_GetRenewalAgent_RegDiaryNumber_ID=0;    
	set v_PutRenewalAgent_RegDiaryNumber_Name='NA';    
ELSE
      
	-- START-101 A -- [Diary ActiveProvider Setter] --
    select COUNT(*) into v_checkExistingRNAgentDiaryProviderFlagCount from tbl_rera_agent_renewal_regdiarynumber 
	where Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number and IsActive=1;    
    
    IF (v_checkExistingRNAgentDiaryProviderFlagCount>0) THEN
        update tbl_rera_agent_renewal_regdiarynumber set IsActiveProvider=0 
		where Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number
		and IsActive=1;
    END IF;
    -- END-101 A    
    
    -- START-102 -- [Check Count Existing RenewalAgent Diary Number] -- 
	SELECT COUNT(*) into v_checkExistingRNAdiaryNumberCount FROM tbl_rera_agent_renewal_regdiarynumber
	where AgentRenewal_ID=p_Related_RenewalAgent_ID and AgentRenewal_Year=p_Related_RenewalAgent_Year and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
	and Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number
