)
begin


if (p_ApplicationModeFlag=21) then
-- RERA Registration Number (21)   
	SELECT
	0 as PrjSuperLockUnlock_RegDNProvider_IndexID,
	0 as PrjSuperLockUnlock_RegDNProvider_ID,

	t.Related_Promoter_ID,
	t.Related_Project_ID,
