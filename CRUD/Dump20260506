		-- Lock Case Institution record
		update tbl_rera_ecourt_complaint_formn_institutiondetail set IsLockRefNumber=1
		where Related_ComplaintFormN_ID=p_ComplaintFormN_ID
		and InstitutionFormN_ID=p_InstitutionFormN_ID
		and IsActive=1;

		select count(Related_ComplaintorApplication_ID) into v_checkAppno from tbl_rera_complaint_formn_eventaction 
		where Related_ComplaintorApplication_ID=p_ComplaintFormN_ID and IsActive=1;
        
        IF (v_checkAppno <> 0) THEN        
		update tbl_rera_complaint_formn_eventaction set IsActive=2
		where Related_ComplaintorApplication_ID=p_ComplaintFormN_ID and IsActive=1; 
	
		INSERT INTO tbl_rera_complaint_formn_eventaction
		   (
		   `EventAction_Type`
		   ,`EventAction_IdentifiedBy`
		   ,`EventAction_IdentifiedOn`
		   ,`Related_ComplaintorApplication_ID`
		   ,`Related_RegDiaryNumber`
		   ,`EventAction_Summary`
		   ,`EventAction_Description`
		   ,`EventAction_Category`
		   ,`EventAction_Aggregate`
		   ,`EventAction_Relationship`
		   ,`AssignedTo`
		   ,`Target_ResolutionDate`
		   ,`Target_ResolutionSummary`
		   ,`Actual_ResolutionDate`
		   ,`ProgressStatus`
		   ,`Remarks_IfAny`
		   ,`IsActive`
		   ,`IsDraft`
		   ,`CreatedBy`
		   ,`CreatedOn`
		   ,`ModifyBy`
		   ,`ModifyOn`
		   )
		VALUES
		   (
		   440101, -- p_p_EventAction_Type,
		   p_EventAction_IdentifiedBy,
		   NOW(),
		   p_ComplaintFormN_ID,
		   p_ComplaintDiaryNumber,
		   'Case institution and assignment for initiating a legal process',
		   'Case institution and assignment for initiating a legal process',
		   'Authority Desk',
		   'Case institution and assignment for initiating a legal process',
		   'Role Legal Desk',
		   'NA',
		   NOW(),
		   p_EventAction_Aggregate,
		   NOW(),           
		   'CaseAssignemnt',
		   concat('Case institution and assignment (Ref Number: ', v_Institution_Ref_Number, ' and Bench Name: ', v_CaseAssigned_BenchName, ')'),
		   1,
		   0,
		   p_CreatedBy,
		   NOW(),
		   p_CreatedBy,
		   NOW()
	    );
		END IF;

		set v_AssignedRefFlag=102;
		set v_AssignedRefNumber=p_InstitutionDNumber;
    ELSE
		-- Case Already Exist
    	set v_AssignedRefFlag=104;
		set v_AssignedRefNumber=p_InstitutionDNumber;
    END IF;
END IF;

-- Dak Receipt Event
IF (p_AuthDesk_ActionID='DR') THEN

	select IsLockRefNumber, IsLock, Dak_Number, Dak_Date 
    into v_IsLockRefNumber, v_IsLock, v_Dak_Number, v_Dak_Date
    from tbl_rera_ecourt_complaint_formn_institutiondetail
	where Related_ComplaintFormN_ID=p_ComplaintFormN_ID and InstitutionFormN_ID=p_InstitutionFormN_ID and IsActive=1
    order by InstitutionFormN_IndexID desc limit 1;

	
		IF (v_IsLock = 1) THEN
			-- Case Already Exist
			set v_AssignedRefFlag=105;
			set v_AssignedRefNumber=p_InstitutionDNumber;
		ELSE
			-- Case DR Lock Event
			IF (v_IsLockRefNumber = 1) THEN
				-- Case DR Recrod Check
				IF (v_Dak_Number = '') THEN
					set v_AssignedRefFlag=105;
					set v_AssignedRefNumber='Dak Receipt Pending';
				ELSE            
					-- Case DR Lock Event
					-- Lock Case Institution record
					update tbl_rera_ecourt_complaint_formn_institutiondetail set IsLockRefNumber=1, IsDraft=1, IsLock=1
					where Related_ComplaintFormN_ID=p_ComplaintFormN_ID
					and InstitutionFormN_ID=p_InstitutionFormN_ID
					and IsActive=1;
				
					select count(Related_ComplaintorApplication_ID) into v_checkAppno from tbl_rera_complaint_formn_eventaction 
					where Related_ComplaintorApplication_ID=p_ComplaintFormN_ID and IsActive=1;
					
					IF (v_checkAppno <> 0) THEN        
					update tbl_rera_complaint_formn_eventaction set IsActive=2
					where Related_ComplaintorApplication_ID=p_ComplaintFormN_ID and IsActive=1; 
				
					INSERT INTO tbl_rera_complaint_formn_eventaction
					   (
					   `EventAction_Type`
					   ,`EventAction_IdentifiedBy`
					   ,`EventAction_IdentifiedOn`
					   ,`Related_ComplaintorApplication_ID`
					   ,`Related_RegDiaryNumber`
					   ,`EventAction_Summary`
					   ,`EventAction_Description`
					   ,`EventAction_Category`
					   ,`EventAction_Aggregate`
					   ,`EventAction_Relationship`
					   ,`AssignedTo`
					   ,`Target_ResolutionDate`
					   ,`Target_ResolutionSummary`
					   ,`Actual_ResolutionDate`
					   ,`ProgressStatus`
					   ,`Remarks_IfAny`
					   ,`IsActive`
					   ,`IsDraft`
					   ,`CreatedBy`
					   ,`CreatedOn`
					   ,`ModifyBy`
					   ,`ModifyOn`
					   )
					VALUES
					   (
					   440102, -- p_p_EventAction_Type,
					   p_EventAction_IdentifiedBy,
					   NOW(),
					   p_ComplaintFormN_ID,
					   p_ComplaintDiaryNumber,
					   'Dak receipt registration with reference number',
					   'Dak receipt registration with reference number',
					   'Authority Desk',
					   'Dak receipt registration with reference number',
					   'Role FrontOffice Desk',
					   'NA',
					   NOW(),
					   p_EventAction_Aggregate,
					   NOW(),           
					   'RegisterDak',
					   concat('Dak Receipt (Dak Number: ', v_Dak_Number, ' dated ', Date_Format(v_Dak_Date, '%d/%m/%Y'), ')'),
					   1,
					   0,
					   p_CreatedBy,
					   NOW(),
					   p_CreatedBy,
					   NOW()
					);
					END IF;
					
					set v_AssignedRefFlag=103;
					set v_AssignedRefNumber=p_InstitutionDNumber;
                
                END IF;
				
			ELSEIF (v_IsLockRefNumber = 0) THEN
				set v_AssignedRefFlag=105;
				set v_AssignedRefNumber='Case Assignment Pending';
			END IF;    
		END IF;
    
END IF;

set p_valoutput=v_AssignedRefFlag;
set p_valoutputDNumber=v_AssignedRefNumber;

END ;;
