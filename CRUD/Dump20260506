    select max(RenewalOrderSequence) into v_Get_RenewalSequenceMaxID from tbl_rera_agent_renewal_profile where Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID and Isactive=1;
    IF (v_Get_RenewalSequenceMaxID IS NULL) THEN
		set v_Put_RenewalSequenceID=1;
