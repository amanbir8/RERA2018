CREATE DEFINER=`sa`@`%` PROCEDURE `Display_RERA_ProjectQUpdate_IsDraftValue_FromDiaryNumber`(  
 p_Project_ID bigint, 
 p_Quarter_Year varchar(50),
 p_Quarter_Name varchar(50)  
)
begin 

Declare v_Total Int; 
Declare v_GetIsDraft Int;
Declare v_GetIsLock Int;
Declare v_GetIsRegisterationAccess Int;

-- RegDiaryNumber Table
SELECT COUNT(*) INTO v_Total FROM tbl_rera_project_quarterlyupdate_regdiarynumber 
where ProjectID=p_Project_ID and QUpdateProject_Year=p_Quarter_Year and QUpdateProject_QuarterName=p_Quarter_Name; 

SELECT IsLock INTO v_GetIsLock FROM tbl_rera_project_quarterlyupdate_regdiarynumber 
where ProjectID=p_Project_ID and QUpdateProject_Year=p_Quarter_Year and QUpdateProject_QuarterName=p_Quarter_Name
and isactive=1;

-- Access Provider Table
SELECT IsLock INTO v_GetIsRegisterationAccess FROM tbl_rera_project_quarterlyupdate_regdiarynumberprovider
where QUpdateProject_Year=p_Quarter_Year and QUpdateProject_QuarterName=p_Quarter_Name
and isactive=1;
    
if v_Total>0 then 
	-- IsLock Flag (Flag=1)
    if v_GetIsLock>0 then
		set v_GetIsDraft=1;
	else
		-- IsDraft Flag (Flag=1/4/5/6)
		SELECT IsDraft INTO v_GetIsDraft FROM tbl_rera_project_quarterlyupdate_regdiarynumber
		where ProjectID=p_Project_ID and QUpdateProject_Year=p_Quarter_Year and QUpdateProject_QuarterName=p_Quarter_Name and IsActive=1;
	end if;
else
	if v_GetIsRegisterationAccess>0 then
		-- IsRegAccess Flag (Flag=9)
		set v_GetIsDraft=9;
	else
		-- IsDraft Flag (Flag=0) Open
		set v_GetIsDraft=2;
	end if;
end if; 
        
Select v_GetIsDraft AS mainCount;   

end ;;
