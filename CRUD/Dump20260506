CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetProject_All_EmailAddressByID`(p_Project_ID bigint) RETURNS varchar(4000) CHARSET utf8
BEGIN  
    DECLARE v_ret varchar(4000); 
    
    DECLARE v_A_emailaddress varchar(120);
    DECLARE v_B_emailaddress varchar(120);
    DECLARE v_C_emailaddress varchar(120);
    
	select Email INTO v_A_emailaddress from users where Id in 
	(select UserID from tbl_rera_project_regdiarynumber where Project_ID=p_Project_ID and IsActive=1) 
	and EmailConfirmed=1;
		
    SELECT AuthorizedPerson_EmailAddress INTO v_B_emailaddress FROM tbl_rera_project_registration where ProjectRegistration_ID in 
	(select Project_ID from tbl_rera_project_regdiarynumber where Project_ID=p_Project_ID and IsActive=1)
	and isactive=1;   

	SELECT Email INTO v_C_emailaddress FROM rera_tbl_promoter where Application_id in 
	(select Promoter_ID from tbl_rera_project_regdiarynumber where Project_ID=p_Project_ID and IsActive=1) 
	and isactive=1;

    Set v_ret = Concat(v_A_emailaddress , ',' , space(1) , v_B_emailaddress , ',' , space(1) , v_C_emailaddress);
      
     IF (v_ret IS NULL) THEN   
        SET v_ret = 'NA';
     END IF;
    RETURN v_ret; 
END ;;
