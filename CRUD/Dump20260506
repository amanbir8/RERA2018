	Promoter_ID=p_Promoter_ID and 
	IsActive=1; 
		  
	
    if v_checkExistingProjectExtFormDiaryNumberCount>0
	then
		-- ------------Update Previous Record (LOCK)-----------
		update tbl_rera_ProjectExtensionForm_RegDiaryNumber set IsDraft=1 
		where Project_ID=p_Project_ID and 
		Promoter_ID=p_Promoter_ID and 
		IsActive=1;
	  
	  
		select ProjectExtForm_RegDiaryNumber_Name,ProjectExtForm_RegDiaryNumber_NameYear,ProjectExtForm_RegDiaryNumber_ID 
