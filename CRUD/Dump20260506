CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_MISreports_EPayProjectPaymentsRegistrationDetail`(
    p_UserRole varchar(50),
    p_Fromdate datetime(3),
    p_Todate datetime(3),
    p_SearchTypeFlag varchar(50),
    p_SearchRangeFlag varchar(50),
    p_EventMonth int,
    p_EventYear int
 )
BEGIN
 
 IF (p_SearchRangeFlag = '1') THEN
 -- FromDate / ToDate
 
 SELECT 
 r.*,
 pg.PG_Transaction_Fee,
 pg.PG_Additional_Charges,
 pg.PG_Payment_Type,
 pg.PG_Bank_Reference_No,
 pg.PG_Transaction_ID,
 pg.PG_PayU_ID,
 pg.PG_Date,
 pg.PG_Amount,
 pg.PG_Status,
 CONCAT(pg.PG_UDF_1,'REA',pg.PG_UDF_3,'PG',pg.PG_UDF_4) AS PG_PaymentRef_Number,
 pg.PaymentSuccessDate
 
 FROM tbl_rera_payment_epay_registration r, tbl_rera_payment_epay_challannumber c, tbl_rera_payment_epay_paymentgateway pg
 
-- JOIN tbl_rera_payment_epay_registration r
-- ON r.Payment_epayTxnNumber = pg.Related_Payment_epayTxnNumber
 
 WHERE r.Payment_epayTxnNumber = pg.Related_Payment_epayTxnNumber
 AND pg.IsPaymentSuccessComplete = 1
 -- AND pg.PaymentSuccessDate BETWEEN p_Fromdate AND p_Todate
 AND DATE(pg.PaymentSuccessDate) BETWEEN DATE(p_Fromdate) AND DATE(p_Todate)
 AND pg.IsActive = 1
 AND r.IsActive = 1
  AND c.IsActive = 1
 AND r.PaymentForCode = p_SearchTypeFlag
 AND r.Payment_epayTxnNumber = c.Payment_epayTxnNumber
 AND r.Project_ID IS NOT NULL
 AND r.Project_ID <> 0
 
 ORDER BY pg.PG_Date DESC;
 
 ELSE
 -- Month / Year Search
 
 SELECT 
 r.*,
 pg.PG_Transaction_Fee,
 pg.PG_Additional_Charges,
 pg.PG_Payment_Type,
 pg.PG_Bank_Reference_No,
 pg.PG_Transaction_ID,
 pg.PG_PayU_ID,
 pg.PG_Date,
 pg.PG_Amount,
 pg.PG_Status,
 CONCAT(pg.PG_UDF_1,'REA',pg.PG_UDF_3,'PG',pg.PG_UDF_4) AS PG_PaymentRef_Number,
 pg.PaymentSuccessDate
 
-- FROM tbl_rera_payment_epay_paymentgateway pg
 FROM tbl_rera_payment_epay_registration r, tbl_rera_payment_epay_challannumber c, tbl_rera_payment_epay_paymentgateway pg
 
 -- JOIN tbl_rera_payment_epay_registration r
 -- ON r.Payment_epayTxnNumber = pg.Related_Payment_epayTxnNumber
 
 WHERE r.Payment_epayTxnNumber = pg.Related_Payment_epayTxnNumber
 AND pg.IsPaymentSuccessComplete = 1
 AND MONTH(pg.PaymentSuccessDate) = p_EventMonth
 AND YEAR(pg.PaymentSuccessDate) = p_EventYear
 AND pg.IsActive = 1
 AND r.IsActive = 1
  AND c.IsActive = 1
 AND r.PaymentForCode = p_SearchTypeFlag
 AND r.Payment_epayTxnNumber = c.Payment_epayTxnNumber
 AND r.Project_ID IS NOT NULL
 AND r.Project_ID <> 0
 
 ORDER BY pg.PG_Date DESC;
 
 END IF;
 
 END ;;
DELIMITER ;
