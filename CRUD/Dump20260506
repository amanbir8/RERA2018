CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_AgentRERAnumber_AdvRevokeAgent_ByParms`(
p_UserRole varchar(50),
p_DistrictCode varchar(50),
p_SubDivisionCode varchar(90),
p_RegistrationIssueYear integer,
p_AgentRERAnumber varchar(50),
p_FlagDistrict integer,
p_FlagSubDivision integer,
p_FlagYear integer,
p_FlagRERAnumber integer,
p_FlagAgentType varchar(50),
p_AdvSearchOptionType varchar(50),
p_AdvSearchAgentType integer
