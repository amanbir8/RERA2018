     -- select @PutProject_QuaterRegDiaryNumber_Name as PutProject_QuaterRegDiaryNumber_Name
     set v_PutProject_QuaterRegDiaryNumber_ID = v_GetExistingForDeskProjectQuarterRegDiaryNumber_ID;
     
else
