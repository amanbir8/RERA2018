                A_column,B_column,C_column,IsActive,IsDraft,IsLock,IsPublicView,CreatedBy,CreatedOn
            FROM tbl_rera_complaint_formm_listenclosuresdocuments WHERE ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID AND IsActive=1;
            
	-- declare NOT FOUND handler
	DECLARE CONTINUE HANDLER FOR NOT FOUND SET flag_curbifurcate = 1;
	DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET flag_bifurcate_IsError = 1;

	OPEN curBifurcateFormMdoc;

	getFormMdoc: LOOP
		FETCH curBifurcateFormMdoc INTO vProfile_ID,vUser_ID,vComplaintType_MN,vComplaintDoc_InfoCode,vComplaintDoc_InfoName,vComplaintDoc_ReferenceNumber,
				vComplaintDoc_IssueDate,vComplaintDoc_FileSize,vComplaintDoc_FileFormat,vComplaintDoc_FilePath,vComplaintDoc_FileName,
                vComplaintDoc_IsGroup,vDoc_SerialNumber,vDoc_PageStartNumber,vDoc_PageEndNumber,vRemarks_IfAny,
                vA_column,vB_column,vC_column,vIsActive,vIsDraft,vIsLock,vIsPublicView,vCreatedBy,vCreatedOn;
                
		IF flag_curbifurcate = 1 THEN 
			SET v_ret_bifurcatevalue = 0;
			LEAVE getFormMdoc;
		END IF;
               
        -- Application ID
		select max(ListEnclDocument_ID) into v_get_ListEnclDocument_ID from tbl_rera_complaint_formm_listenclosuresdocuments;    
		IF (v_get_ListEnclDocument_ID IS NULL) then        
		  set v_put_ListEnclDocument_ID=1; 
		ELSE         
		  set v_put_ListEnclDocument_ID=v_get_ListEnclDocument_ID+1;
		end if;
        
		-- build bifurcate list and insert
		insert into tbl_rera_complaint_formm_listenclosuresdocuments
