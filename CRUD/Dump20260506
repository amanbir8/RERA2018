CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AuthDesk_Complaint_FormN_LogCommunicationByID`(        
 p_ComplaintFormN_ID bigint,
 p_UserLog_ID bigint
 )
begin   


SELECT 
a.CommUserLog_IndexID,
a.Complaint_ID,
a.Complaint_DiaryNumber,
a.CommunicationTitleName,
a.SignInDate,
a.CommunicationActivity,
a.DestinationEmailAddress,
a.SourceHostName,
a.SourceIP,
a.Activity,
a.ActivityDescription,
b.RelatesComplaint_ProjectAgent_RERA_RegNumber as RERAnumber,
b.RelatesComplaint_ComplaintAgainstType as ComplaintAganistName,
a.UserName,
a.HearingDate,
a.HearingTime,
a.HearingBench,
a.A_Column,
a.B_Column,
a.C_Column,
a.IsActive,
a.CreatedOn,
a.ModifyOn
FROM
(
SELECT
ComplaintFormN_EventAction_ID as CommUserLog_IndexID,
Related_ComplaintorApplication_ID as Complaint_ID,
Related_RegDiaryNumber as Complaint_DiaryNumber,
CASE
    WHEN EventAction_Type = 440058 THEN "Notice to Complainant (Hearing)"
    WHEN EventAction_Type = 440059 THEN "Notice to Respondent"
    WHEN EventAction_Type = 440061 THEN "Notice to Complainant (Preliminary Hearing)"
    ELSE "Unknown Notice"
END as CommunicationTitleName,
EventAction_IdentifiedOn as SignInDate,
'Sent' as CommunicationActivity,
'Web-portal' as DestinationEmailAddress,
'Web-portal' as SourceHostName,
'Proxy Server' as SourceIP,
EventAction_Aggregate as Activity,
EventAction_Aggregate as ActivityDescription,
EventAction_IdentifiedBy as UserName,
NOW() as HearingDate,
'' as HearingTime,
'' as HearingBench,
'' as A_Column,
'' as B_Column,
