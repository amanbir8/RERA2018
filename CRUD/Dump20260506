select COUNT(*) into v_ExtFormPaymentDetailsCount from tbl_rera_project_payment_extensionforme where ProjectPaymentRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
select COUNT(*) into v_ExtFormRegistrationDetailsCount from tbl_rera_project_applicationforextensionform where Project_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6);          
     
set v_mainCount=1;      
    
-- ---------------if no diary number in quater table then set projet diary number to 0 else project Diary Number implemented------------------------------------------------------------------------------------------         
