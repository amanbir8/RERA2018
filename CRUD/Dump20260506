CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetProjectChecklistVerified_StatusValue_ByFID`(p_promoter_ID bigint, p_project_ID bigint, p_event_ID bigint, p_CLview_ID varchar(50), p_signin_user_ID varchar(50)) RETURNS varchar(200) CHARSET utf8
BEGIN 
    DECLARE v_ret varchar(200);  
    DECLARE v_chkcountvalue int;
    DECLARE v_chktotalcountvalue int;
	DECLARE v_chkYesCasecountvalue int;
    DECLARE v_chkvalue varchar(50);
    
    IF (p_event_ID=110006 OR p_event_ID=110038 OR p_event_ID=110024) THEN
        -- Case (Checklist Prepared Action)
        
        SET v_ret = '0'; -- NA
        -- Project and Regulations
        IF (p_CLview_ID='PR') THEN
		
			SELECT count(*) INTO v_chkcountvalue FROM tbl_rera_project_promoter_checklistaction 
			WHERE Related_Promoter_ID=p_promoter_ID
			AND Related_Project_ID=p_project_ID 
			AND IsChecklistValueOk='N'
            AND CriteriaSubCode in (201,203,204,206,207,222,225,226,227,230,240,241,242,243,246,254,255,258,259,260,269,272,276,278)
			AND IsActive=1;
			
			IF (v_chkcountvalue>0) THEN
				SET v_ret = '21'; -- RED
			ELSE    
				SELECT count(*) INTO v_chktotalcountvalue FROM tbl_rera_project_promoter_checklistaction 
				WHERE Related_Promoter_ID=p_promoter_ID
				AND Related_Project_ID=p_project_ID 
                AND CriteriaSubCode in (201,203,204,206,207,222,225,226,227,230,240,241,242,243,246,254,255,258,259,260,269,272,276,278)
				AND IsActive=1;
				
				IF (v_chktotalcountvalue<24) THEN
					SET v_ret = '22'; -- PENDING      
				ELSE
					SET v_ret = '23'; -- COMPLETE
				END IF;        
			END IF;        
        END IF;
        -- Legal
        IF (p_CLview_ID='LG') THEN
		
			SELECT count(*) INTO v_chkcountvalue FROM tbl_rera_project_promoter_checklistaction 
			WHERE Related_Promoter_ID=p_promoter_ID
			AND Related_Project_ID=p_project_ID 
			AND IsChecklistValueOk='N'
            AND CriteriaSubCode in (235,237,238,239,244,245,248,250,280)
			AND IsActive=1;
			
			IF (v_chkcountvalue>0) THEN
				SET v_ret = '21'; -- RED
			ELSE    
				SELECT count(*) INTO v_chktotalcountvalue FROM tbl_rera_project_promoter_checklistaction 
				WHERE Related_Promoter_ID=p_promoter_ID
				AND Related_Project_ID=p_project_ID 
                AND CriteriaSubCode in (235,237,238,239,244,245,248,250,280)
				AND IsActive=1;
				
				IF (v_chktotalcountvalue<9) THEN
					SET v_ret = '22'; -- PENDING      
				ELSE
					SET v_ret = '23'; -- COMPLETE
				END IF;        
			END IF;        
        END IF;
        -- Town Planning
        IF (p_CLview_ID='TP') THEN
		
			SELECT count(*) INTO v_chkcountvalue FROM tbl_rera_project_promoter_checklistaction 
			WHERE Related_Promoter_ID=p_promoter_ID
			AND Related_Project_ID=p_project_ID 
			AND IsChecklistValueOk='N'
            AND CriteriaSubCode in (229,251,252,253,256,257,265,267,270,271,266)
			AND IsActive=1;
			
			IF (v_chkcountvalue>0) THEN
				SET v_ret = '21'; -- RED
			ELSE    
				SELECT count(*) INTO v_chktotalcountvalue FROM tbl_rera_project_promoter_checklistaction 
				WHERE Related_Promoter_ID=p_promoter_ID
				AND Related_Project_ID=p_project_ID 
                AND CriteriaSubCode in (229,251,252,253,256,257,265,267,270,271,266)
				AND IsActive=1;
				
				IF (v_chktotalcountvalue<11) THEN
					SET v_ret = '22'; -- PENDING      
				ELSE
					SET v_ret = '23'; -- COMPLETE
				END IF;        
			END IF;        
        END IF;
        -- Finance and Account
        IF (p_CLview_ID='FA') THEN
		
			SELECT count(*) INTO v_chkcountvalue FROM tbl_rera_project_promoter_checklistaction 
			WHERE Related_Promoter_ID=p_promoter_ID
			AND Related_Project_ID=p_project_ID 
			AND IsChecklistValueOk='N'
            AND CriteriaSubCode in (213,214,215,216,217,231,261,263,264,279,282,202)
			AND IsActive=1;
			
			IF (v_chkcountvalue>0) THEN
				SET v_ret = '21'; -- RED
			ELSE    
				SELECT count(*) INTO v_chktotalcountvalue FROM tbl_rera_project_promoter_checklistaction 
				WHERE Related_Promoter_ID=p_promoter_ID
				AND Related_Project_ID=p_project_ID 
                AND CriteriaSubCode in (213,214,215,216,217,231,261,263,264,279,282,202)
				AND IsActive=1;
				
				IF (v_chktotalcountvalue<12) THEN
					SET v_ret = '22'; -- PENDING      
				ELSE
					SET v_ret = '23'; -- COMPLETE
				END IF;        
			END IF;        
        END IF;

    ELSE
		-- Case (Other Action)
		SET v_ret = '0'; -- NA
    END IF;
	
    IF (v_ret IS NULL) THEN   
		SET v_ret = '0'; -- NA
	END IF;
    RETURN v_ret;     
END ;;
