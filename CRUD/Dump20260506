end if; 
 
 
select count(CaseTransfer_ID) into v_checkComplaintM_CaseTransfer from tbl_rera_complaint_formm_CaseTransferDetails     
where ComplainantApplicant_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and
IsActive=1;
  
