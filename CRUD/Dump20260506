    declare v_PUCdetailsCount int;
    declare v_PUCdocumentsCount int;
    declare v_mainCount Int; 
    declare v_ApplicationPUC_ID bigint;
	declare v_ApplicationOrderSequencePUCnumber int;
    declare v_ApplicationExistingOrderSequencePUCnumber int;
    
	declare v_checkExistingPUCdiarynumberCount int;
    
	declare v_GetExistingForDeskPUCdiaryNumber_Name varchar(120);
	declare v_GetExistingForDeskPUCdiaryNumber_NameYear varchar(50); 
