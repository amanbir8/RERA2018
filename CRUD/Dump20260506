	WHEN p.Flag=1 THEN Concat(Cast(p.First_Name as char(180)) , SPACE(1) , Cast(p.Middle_Name as char(180)) , SPACE(1) , Cast(p.Last_Name as char(180)))
	WHEN p.Flag=2 THEN Concat(Cast(p.Org_Name as char(350)))
