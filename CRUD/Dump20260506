			if v_checkisdraftzerocnt > 0 then
				set v_TotalCnt=0;
			else
				set v_TotalCnt=1;
			end if;
		else
            -- code ret value 0 or 1
			SELECT IsDraft INTO v_TotalCnt FROM tbl_RERA_Project_Documents
