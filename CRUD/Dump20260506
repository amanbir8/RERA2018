CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Reat_CourtView_OrderJudgements_ByFilter`(  
	p_Complaint_Year bigint,
	p_Complainant_Name varchar(290),
	p_Complaint_RefNumber varchar(290),
    p_Complaint_TypeOrder varchar(290),
	p_ComplaintYear_Flag int,	
	p_ComplainantName_Flag int,
    p_ComplaintRefNumber_Flag int,
    p_ComplaintTypeOrder_Flag int,
	p_UserRole varchar(100)
)
begin 

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

if (p_ComplaintTypeOrder_Flag<>0) then
	if (p_Complaint_TypeOrder='999' or p_Complaint_TypeOrder=999) then
		SET p_ComplaintTypeOrder_Flag=0;
	end if;
end if;

if (p_ComplaintRefNumber_Flag<>0) then
	-- Complaint Number = VALUE
    if (p_ComplaintYear_Flag<>0) then
		-- YEAR = VALUE
		if (p_ComplaintTypeOrder_Flag<>0) then
			-- By (Year=1,Type=1,Name=1or0)
			if (p_ComplainantName_Flag<>0) then
				-- By Name/TypeOrder/Year
				select
				 	`AppellateTribunalOrder_IndexID` as OrderJudgementByREAT_IndexID,
					`AppellateTribunalOrder_ID` as OrderJudgementByREAT_ID,    
					`SerialOrderNumber` as SerialOrderNumber,
					`Appeal_RefNumber` as ComplaintAppealNumber,
					`ComplaintNumber` as ComplaintApplicationNumber,
					`ComplainantName` as ComplainantName,
					`RespondentName` as RespondentName,
					`Appeal_FilingDate` as Date_of_Filing,
					`Date_of_Decision` as Date_of_Decision, 
					`HearingBenchCode` as HearingBenchCode, 
					`AppealOrderDoc_InfoCode` as ViewJugdement_InfoCode,
					`AppealOrderDoc_FilePath` as ViewJugdement_FilePath,
					`AppealOrderDoc_FileName` as ViewJugdement_FileName,
					`AppealOrderDoc_FileFormat` as ViewJugdement_FileType,	
					`Related_ComplaintID` as Related_OrderJudgement_ComplaintID,
					`Related_ComplaintType_MN` as Related_OrderJudgement_ComplaintType,
					`Related_DiaryNumber` as Related_OrderJudgement_DiaryNumber,
					`Related_Complaint_OrderRefNumber` as Related_OrderJudgement_OrderRefNumber,
					`IsActive`,
					`IsDraft`,
					`IsDraftMember`,
					`IsPublicView`,    
					`CreatedBy`,
					`CreatedOn`,
					`ModifyBy`,
					`ModifyOn`,
					Remarks_IfAny as RemarksIfAny,
					'' as EventAction_Type,
					'' as EventAction_TypeName,
					'2015-01-01 00:00:00.000' as EventAction_IdentifiedOn,
					'' as EventAction_Aggregate,
					'' as EventRemarks_IfAny,
					'' as EventAction_Summary
				from tbl_rera_webapplication_appeal_appellatetribunal 
				where IsActive=1 
				and IsPublicView=1
				-- and A_column is not null
				-- and A_column <> ''
				and YEAR(Date_of_Decision)=p_Complaint_Year
				and ComplainantName like p_Complainant_Name
                and Appeal_RefNumber like p_Complaint_RefNumber
				and AppealOrderDoc_InfoCode=p_Complaint_TypeOrder
				order by Date_of_Decision desc;
			else
				-- By TypeOrder/Year
				select
				  	`AppellateTribunalOrder_IndexID` as OrderJudgementByREAT_IndexID,
					`AppellateTribunalOrder_ID` as OrderJudgementByREAT_ID,    
					`SerialOrderNumber` as SerialOrderNumber,
					`Appeal_RefNumber` as ComplaintAppealNumber,
					`ComplaintNumber` as ComplaintApplicationNumber,
					`ComplainantName` as ComplainantName,
					`RespondentName` as RespondentName,
					`Appeal_FilingDate` as Date_of_Filing,
					`Date_of_Decision` as Date_of_Decision, 
					`HearingBenchCode` as HearingBenchCode, 
					`AppealOrderDoc_InfoCode` as ViewJugdement_InfoCode,
					`AppealOrderDoc_FilePath` as ViewJugdement_FilePath,
					`AppealOrderDoc_FileName` as ViewJugdement_FileName,
					`AppealOrderDoc_FileFormat` as ViewJugdement_FileType,	
					`Related_ComplaintID` as Related_OrderJudgement_ComplaintID,
