CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_OrderJudgements_FormM_Documents_ByCode`(  
	p_ComplaintDoc_InfoCode bigint,
	p_ComplaintFormM_ID bigint,
    p_ComplaintForm_Type varchar(90),
	p_TransferCase_ID bigint,
    p_TransferFlag int,
    p_TransferTypeOption varchar(150)
)
begin 

declare v_countfile bigint;
declare v_sumfile bigint;
declare v_counthearingfile bigint;
declare v_sumhearingfile bigint;

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

set v_countfile=0;
set v_sumfile=0;

if (p_TransferFlag<>0) then
	-- Transfer-Case
    if (p_TransferTypeOption='TransferToAO') then 
		-- Input Form-M and Output Form-N -- (Transfer Case)('TransferToAO')
		select COUNT(*) into v_countfile 
		from tbl_rera_webapplication_orderjudgementbyao 
		where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;        
        
        select IFNULL(sum(CAST(C_column as unsigned integer)), 0) into v_sumfile
		from tbl_rera_webapplication_orderjudgementbyao 
		where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;
    else
		-- Input Form-M and Output Form-M -- (Transfer Case)('TransferToAUTH', 'TransferToOTH')
		select COUNT(*) into v_countfile 
		from tbl_rera_webapplication_orderjudgementbyauthority 
		where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;        
        
		select IFNULL(sum(CAST(C_column as unsigned integer)), 0) into v_sumfile
		from tbl_rera_webapplication_orderjudgementbyauthority 
		where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;
    end if;
else
	-- Form-M
	select COUNT(*) into v_countfile 
	from tbl_rera_webapplication_orderjudgementbyauthority 
	where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;
    
	select IFNULL(sum(CAST(C_column as unsigned integer)), 0) into v_sumfile
	from tbl_rera_webapplication_orderjudgementbyauthority 
	where A_column=p_ComplaintFormM_ID and B_column='FormTypeM' and IsActive=1;
end if;

set v_sumhearingfile=0;
set v_counthearingfile=0;

Select
v_sumfile as sumTotalFileSize,
v_countfile as CountTotalFileType,
v_sumhearingfile as sumHearingFileSize,
v_counthearingfile as CountHearingFileType;

  
IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
