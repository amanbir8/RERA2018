CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_project_puc_regdiarynumber`(
  p_ApplicationPUC_IndexID bigint(20),
  p_ApplicationPUC_ID bigint(20),
  p_RelatedPromoter_ID bigint(20),
