CREATE DEFINER=`sa`@`%` PROCEDURE `usp_deleteTrash_tbl_rera_agent_CP_FileRearrangementPanel`(
	p_AgentDoc_IndexID bigint(20),
	p_AgentDoc_ID bigint(20),
	p_Agent_ID bigint(20),
	p_AgentRenewal_ID bigint(20),    
    p_User_ID varchar(150),
    p_User_Role varchar(150),    
	p_AgentDoc_InfoCode int,
	p_AgentDoc_InfoName varchar(250),    
	    
	p_Agent_DiaryNumber varchar(250),
	p_RERA_RegistrationNumber varchar(100),
	p_RERAnumberIssueDate datetime,
	p_RERAnumberRegUptoDate datetime,
	p_Agent_Name varchar(350),
	p_Type_of_Agent varchar(350),
    p_AgentAddressDistrict varchar(250),
	p_IsRERAregisteredAgent int,    
	p_Extra01_column varchar(250),
	p_Extra02_column varchar(250),
    
	p_Application_SearchTypeFlag int,
	p_RERAnumberRegistration_Input varchar(100),
	p_AgentDiaryNumber_Input varchar(100),
	p_IsUpdateModifyFlag_AgentDocument int,
	out p_valreturn varchar(250)
)
BEGIN

declare var_count int(11);
declare var_message varchar(190);
declare var_remarks varchar(220);

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

set var_message='Error';
set var_remarks='';

select count(AgentDoc_InfoCode) into var_count from tbl_rera_agent_documents
where IsActive=1 and IsDraft in (1,4,5,6)
and AgentDoc_IndexID=p_AgentDoc_IndexID
and AgentDoc_ID=p_AgentDoc_ID
and Agent_ID=p_Agent_ID;

if (var_count <> 0) then
	if (p_IsUpdateModifyFlag_AgentDocument=2) then
		-- Trash
		UPDATE tbl_rera_agent_documents 
		SET IsActive=2, C_column='FlagACR', ModifyBy=p_User_ID, ModifyOn=NOW()
		WHERE AgentDoc_IndexID=p_AgentDoc_IndexID
		and AgentDoc_ID=p_AgentDoc_ID
		and Agent_ID=p_Agent_ID
		and AgentDoc_InfoCode=p_AgentDoc_InfoCode
		and IsActive=1 and IsDraft in (1,4,5,6);        
		set var_message=concat('trashed');
        set var_remarks=concat('Trashed request completed, ID(' , p_Agent_ID, ')');
    else
		if (p_IsUpdateModifyFlag_AgentDocument=3) then
			-- Delete
			UPDATE tbl_rera_agent_documents 
			SET IsActive=2, IsDraft=0, C_column='FlagACR', ModifyBy=p_User_ID, ModifyOn=NOW()
			WHERE AgentDoc_IndexID=p_AgentDoc_IndexID
			and AgentDoc_ID=p_AgentDoc_ID
			and Agent_ID=p_Agent_ID
			and AgentDoc_InfoCode=p_AgentDoc_InfoCode
			and IsActive=1 and IsDraft in (1,4,5,6);
			set var_message=concat('deleted');
            set var_remarks=concat('Deleted request completed, ID(' , p_Agent_ID, ')');
        else
			if (p_IsUpdateModifyFlag_AgentDocument=4) then
				-- NPV (Not PV)
				UPDATE tbl_rera_agent_documents 
				SET B_column='NPV', C_column='FlagACR', ModifyBy=p_User_ID, ModifyOn=NOW()
				WHERE AgentDoc_IndexID=p_AgentDoc_IndexID
				and AgentDoc_ID=p_AgentDoc_ID
				and Agent_ID=p_Agent_ID
				and AgentDoc_InfoCode=p_AgentDoc_InfoCode
				and IsActive=1 and IsDraft in (1,4,5,6);    
				set var_message=concat('not applicable for Public View');
                set var_remarks=concat('NA for PV request completed, ID(' , p_Agent_ID, ')');
			else
				set var_message=concat('Error');
                set var_remarks=concat('Error' , p_Agent_ID);
			end if;
        end if;    
    end if;
    
	-- insert history log
	Insert into tbl_rera_ldr_agent_document_changefile_logdetails
	(    
		-- Agentlog_changefile_IndexID,
		Related_AgentDoc_IndexID,
		Related_AgentDoc_ID,
		Related_Agent_ID,
		Related_AgentRenewal_ID,
		Related_AgentDoc_InfoCode,
		Related_Agent_DiaryNumber,
		Related_RERA_RegistrationNumber,
		User_Role,
		UserID,
		Remarks_IfAny,
		LockUnlockMsg_IfAny,
		A_Column,
		B_Column,
		C_Column,
		IsActive,
		IsDraft,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	)    
	values    
	(    
		-- Agentlog_changefile_IndexID,
		p_AgentDoc_IndexID,
        p_AgentDoc_ID,
        p_Agent_ID,
        p_AgentRenewal_ID,
        p_AgentDoc_InfoCode,
        p_Agent_DiaryNumber,
        p_RERA_RegistrationNumber,
        p_User_Role,
        p_User_ID,
        var_remarks,
        var_message,
		'', -- A_Column,
		'', -- B_Column,
		'', -- C_Column,
        1, -- IsActive,
        1, -- IsDraft,
        p_User_ID, -- p_CreatedBy,
        NOW(),
        'sysadmin', -- p_CreatedBy,
        NOW()
	);
end if;


set p_valreturn=var_message;

IF `_rollback` THEN
	set p_valreturn = 'Error';
	ROLLBACK;
ELSE
	COMMIT;
END IF;

END ;;
DELIMITER ;
