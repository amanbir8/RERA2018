	ELSE           
	  SET v_PutPUC_RegDiaryNumber_ID=v_GetPUC_RegDiaryNumber_ID+1;      
	  set v_PutPUC_RegDiaryNumber_Name=CONCAT('PPUC', CAST(LPAD(v_PutPUC_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
	end if; 
 
	-- select count(*) into v_PCCdetailsCount from tbl_rera_project_completiondetails where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;
    set v_PUCdetailsCount=1;
	set v_PUCdocumentsCount=1;

-- ---STARTS--------check PUC details and documents if not exits then no Diary Number implemented--------         
if v_PUCdetailsCount>0 and v_PUCdocumentsCount>0    
then      
	set v_mainCount=1;      
else    
	set v_mainCount=0;      
end if; 
    
	-- ---------------if exist then Diary Number implemented only--------         
	if v_mainCount=0    
	then     
	  set v_PutPUC_RegDiaryNumber_ID=0;    
	  set v_PutPUC_RegDiaryNumber_Name=0;    
	else  
          -- -------Check Count Existing Diary Number----------		  
		  select COUNT(*) into v_checkExistingPUCdiarynumberCount from  tbl_rera_project_puc_regdiarynumber 
		  where RelatedPromoter_ID=p_RelatedPromoter_ID and RelatedProject_ID=p_RelatedProject_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and PUC_RequestCategoryID=p_PUC_RequestCategoryID and IsActive=1; 
		  	 
          select max(ApplicationPUC_ID) into v_ApplicationPUC_ID from tbl_rera_project_puc_paperunderconsiderations;
		  IF (v_ApplicationPUC_ID IS NULL)          
			then          
			set v_ApplicationPUC_ID=1001; 
