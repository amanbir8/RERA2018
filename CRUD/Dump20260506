CREATE DEFINER=`sa`@`%` PROCEDURE `Display_RERA_ProjectQUpdate_Quater_Count_RegDiaryNumber`(
	p_QUpdateProjectID bigint,
	p_QUpdateYear int(11),
	p_QUpdateName varchar(100)
)
begin

	declare v_TotalCnt Int;    
	declare v_inventoryCount int;        
	declare v_parkingCount int;        
	declare v_statusphotographsCount int;        
	declare v_internalfacCount int;        
	declare v_externalfacCount int;        
	declare v_approvalsCount int;
    declare v_approvalsOptionalCount int;
    
	declare v_Totalregistered Int;
    declare v_TotalRERAcount Int;
    declare v_mainCount Int; 

	declare v_QUP_inventory varchar(10);  
	declare v_QUP_parking varchar(10);  
	declare v_QUP_statusphotographs  varchar(10);  
	declare v_QUP_internalfac varchar(10);  
	declare v_QUP_externalfac varchar(10);  
	declare v_QUP_approvals  varchar(10);  

set v_mainCount=0;
set v_TotalCnt=6; 
set v_QUP_inventory='N';        
set v_QUP_parking='N';        
set v_QUP_statusphotographs='N';        
set v_QUP_internalfac='N';        
set v_QUP_externalfac='N';        
set v_QUP_approvals='N';


select COUNT(*) into v_inventoryCount from tbl_rera_project_quarterlyupdate_inventory 
	where isactive=1 and Related_ProjectRegistration_ID=p_QUpdateProjectID and QUpdateInventory_Year=p_QUpdateYear and QUpdateInventory_QuarterName=p_QUpdateName and IsDraft in (1,5,6);
select COUNT(*) into v_parkingCount from tbl_rera_project_quarterlyupdate_parkingdetails 
	where isactive=1 and Related_ParkingProjectRegistration_ID=p_QUpdateProjectID and QUpdateParking_Year=p_QUpdateYear and QUpdateParking_QuarterName=p_QUpdateName and IsDraft in (1,5,6);
select COUNT(*) into v_statusphotographsCount from tbl_rera_project_quarterlyupdate_constructionstatusphotographs 
	where isactive=1 and ProjectPhotographsRelated_Project_ID=p_QUpdateProjectID and QUpdatePhotographs_Year=p_QUpdateYear and QUpdatePhotographs_QuarterName=p_QUpdateName and IsDraft in (1,5,6);
select COUNT(*) into v_internalfacCount from tbl_rera_project_quarterlyupdate_internalfacilities 
	where isactive=1 and ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_QUpdateProjectID and QUpdateInfraFacilities_Year=p_QUpdateYear and QUpdateInfraFacilities_QuarterName=p_QUpdateName and IsDraft in (1,5,6);
select COUNT(*) into v_externalfacCount from tbl_rera_project_quarterlyupdate_externalfacilities 
	where isactive=1 and ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_QUpdateProjectID and QUpdateInfraExFacilities_Year=p_QUpdateYear and QUpdateInfraExFacilities_QuarterName=p_QUpdateName and IsDraft in (1,5,6);
select COUNT(*) into v_approvalsCount from tbl_rera_project_quarterlyupdate_approvaldetails 
	where isactive=1 and Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName and IsDraft in (1,5,6);

select COUNT(*) into v_approvalsOptionalCount from tbl_rera_project_quarterlyupdate_approvaldetails 
	where isactive=1 and Related_ApprovalProjectRegistration_ID=p_QUpdateProjectID and QUpdateApproval_Year=p_QUpdateYear and QUpdateApproval_QuarterName=p_QUpdateName;


if (v_inventoryCount<>0) then        
	set v_QUP_inventory='Y';         
end if;
if (v_parkingCount<>0) then        
	set v_QUP_parking='Y';         
end if;
if (v_statusphotographsCount<>0) then        
	set v_QUP_statusphotographs='Y';         
end if;
if (v_internalfacCount<>0) then        
	set v_QUP_internalfac='Y';         
end if;
if (v_externalfacCount<>0) then        
	set v_QUP_externalfac='Y';         
end if;

if (v_approvalsOptionalCount<>0) then        
	if (v_approvalsCount<>0) then        
		set v_QUP_approvals='Y';         
	end if;
else
	set v_QUP_approvals='Y'; 
end if;

IF (v_QUP_inventory='Y' AND v_QUP_parking='Y' AND v_QUP_statusphotographs='Y' AND v_QUP_internalfac='Y' AND v_QUP_externalfac='Y' AND v_QUP_approvals='Y') THEN     
          
	SELECT COUNT(*) INTO v_Totalregistered FROM tbl_RERA_Project_RegDiaryNumber 
	 	where Project_ID=p_QUpdateProjectID -- and Promoter_ID=p_QUpdatePromoter_ID 
        and IsActive=1 and IsDraft=1;
	SELECT COUNT(*) INTO v_TotalRERAcount FROM tbl_rera_ldr_project_reranumber_diarynumber 
		where Project_ID=p_QUpdateProjectID -- and Promoter_ID=p_QUpdatePromoter_ID 
        and IsActive=1 and IsPublicView=1;

	if v_Totalregistered>0 and v_TotalRERAcount>0     
	then      
		set v_mainCount=1;      
	else    
		set v_mainCount=0;      
	end if;
    
	set v_TotalCnt=v_mainCount;    
end if;           

Select v_TotalCnt AS TotalCount;

end ;;
DELIMITER ;
