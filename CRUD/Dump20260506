CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_RERA_Project_Quater_RegDiaryNumber`( 
	p_Promoter_ID bigint ,     
    p_UserID varchar(50) ,
	
	p_Project_ID bigint ,
	p_Quater varchar(50) ,
	p_Year bigint ,
	
	p_Extra2 varchar(200) ,
	p_Extra3 varchar(200) ,
	p_Extra4 varchar(200) ,
	p_Remarks_IfAny varchar(250) ,
	
    -- IsActive int ,
	p_IsDraft int ,
	p_IsDraftHelpDesk int ,
	p_IsDraftEvaluation int ,
	p_IsDraftSecMember int ,
	p_IsDraftMember int ,
	p_CreatedBy varchar(50) ,
	-- CreatedOn datetime ,
	p_ModifyBy varchar(50) ,
	-- ModifyOn datetime ,
	
    out p_Return_Project_QuaterRegDiaryNumber_Name   varchar(50)  
)
begin
     
 declare v_GET_Project_QuaterRegDiaryNumber_Name varchar(10); 
 declare v_PutProject_QuaterRegDiaryNumber_Name varchar(50); 
 declare v_GetProject_QuaterRegDiaryNumber_ID bigint;  
 declare v_PutProject_QuaterRegDiaryNumber_ID bigint;  
 declare v_checkrno int;    
 
 declare v_SETIsRegistration int; 
 declare v_getConstructionCount int;
 declare v_getInventoryCount int;
 declare v_getFacilitiesCount int;

 declare v_getParkingDetailsCount int;
 declare v_getProfessionalCount int;

 declare v_getExternalFacilitiesCount int;
 declare v_getPhotographCount int;
 
 
declare v_GetExistingForDeskProjectQuarterRegDiaryNumber_ID varchar(50); 
declare v_checkExistingProjectQuarterDiaryNumberCount int;
declare v_checkExistingEventCount int;
 
 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
    
START TRANSACTION; 
    
 -- ------------------------- Application_id ------------------------    
 select max(Project_QuaterRegDiaryNumber_ID) into v_GetProject_QuaterRegDiaryNumber_ID
  from tbl_RERA_Project_Quater_RegDiaryNumber;
    
 IF (v_GetProject_QuaterRegDiaryNumber_ID IS NULL)    
	  then    
	  set v_PutProject_QuaterRegDiaryNumber_ID =1001;
 ELSE     
	  SET v_PutProject_QuaterRegDiaryNumber_ID= v_GetProject_QuaterRegDiaryNumber_ID+1;
	  end if;
	  
	
  IF p_Quater='Registration Process'    
	  then    
	  set v_SETIsRegistration =1;
 ELSE     
	 set v_SETIsRegistration =0;
	  end if;
	
select COUNT(*) into v_getConstructionCount from tbl_RERA_Project_BuildingTowerBlock_Construction where ProjectConstructionRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 
select COUNT(*) into v_getInventoryCount from tbl_RERA_Project_BuildingTowerBlock_Inventory where ProjectInventoryRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 
select COUNT(*) into v_getFacilitiesCount from tbl_RERA_Project_InternalInfrastructure_Facilities where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 

select COUNT(*) into v_getParkingDetailsCount from tbl_RERA_Project_ParkingDetails where ProjectParkingRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 
select COUNT(*) into v_getProfessionalCount from tbl_RERA_Project_ProfessionalDetails where ProjectProfessionalRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 

select COUNT(*) into v_getExternalFacilitiesCount from tbl_RERA_Project_ExternalInfrastructure_Facilities where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 
select COUNT(*) into v_getPhotographCount from tbl_RERA_Project_ConstructionStatusPhotographs where ProjectPhotographsRelated_Project_ID=p_Project_ID and IsActive=1 and IsDraft in (1,5,6) and A_column=p_Quater  and B_column=p_Year; 


-- -------Check Count Existing Promoter Diary Number----------
		  
		  select COUNT(*) into v_checkExistingProjectQuarterDiaryNumberCount from  tbl_RERA_Project_Quater_RegDiaryNumber 
		  where Promoter_ID=p_Promoter_ID and 
          Project_ID=p_Project_ID and
