START TRANSACTION;


select count(*) into v_Get_Project_OfflineYN from tbl_rera_project_registration 
where ProjectRegistration_ID=p_RegPrj_ProjectRegistration_ID
and IsAlready_RERANumber='Y'
and isactive=1;


if (v_Get_Project_OfflineYN > 0) then

	-- Project Approval Display
	select 
	0 as ProjectRegistrationActionOne_ID,
	'NA' as ProjectRegistrationActionTwo_ID,
	a.Related_Promoter_ID as Related_Promoter_ID,
	a.Related_Project_ID as Related_Project_ID,

	'NA' as PromoterName,
