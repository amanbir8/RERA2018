	select D_column into v_flag_registeredproject from tbl_rera_complaint_formn_details where ComplaintFormN_Code=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1;
    if (v_flag_registeredproject='unregisteredproject')
    then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'UR');
    end if;
    
    select count(CaseBifurcate_ID) into v_checkBifurcateCount from tbl_rera_complaint_formn_bifurcationdetails where RelatedBifurcate_Complaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and IsActive=1 and IsDraft=1;
    if (v_checkBifurcateCount<>0)
    then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'BF');
    end if;
end if; 
 
IF (p_TransferTypeOption IS NOT NULL)          
then
	IF (p_TransferTypeOption='TransferToAUTH')      
	then 
		-- Transfer To AUTH
		set v_Put_CaseTransfer_RegDiaryName=CONCAT('TR-AUTH', CAST(LPAD(v_Put_CaseTransfer_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
        set v_Get_CaseTransfer_RegDiaryName=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(20)), CAST(v_Put_CaseTransfer_RegDiaryName as CHAR(50)));
        set v_Put_TransferDisplay=1;
	ELSE 
		-- Transfer To AO/ REGD/ OTH       
		set v_Put_CaseTransfer_RegDiaryName='TR';
        set v_Get_CaseTransfer_RegDiaryName=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(20)), CAST(v_Put_CaseTransfer_RegDiaryName as CHAR(50)));
        set v_Put_TransferDisplay=2;
	end if;
	IF (p_C_column=1)
    then
		-- Transfer To AUTH/ AO/ REGD/ OTH (CASE: diary number without Post-fix option)
        -- set v_Get_CaseTransfer_RegDiaryName=CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(60));
        -- set v_Get_CaseTransfer_RegDiaryName=CAST(p_CaseTransferN_RegDiaryNumber_Name as CHAR(120));
        set v_Get_CaseTransfer_RegDiaryName=CAST(v_Put_BasicComplaintRegDiaryNumber_Name as CHAR(120));        
    end if;
end if; 
 
 
select count(CaseTransferN_ID) into v_checkComplaintN_CaseTransfer from tbl_rera_complaint_formN_CaseTransferDetails     
where ComplainantApplicant_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID and
IsActive=1;
  
if (v_checkComplaintN_CaseTransfer <> 0)
then      
        
update tbl_rera_complaint_formn_CaseTransferDetails set IsActive=3, IsLatestActive=2
where ComplainantApplicant_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID 
and IsActive=1;

update tbl_rera_complaint_formn_CaseTransferDetails set IsDraft=1
where ComplainantApplicant_RelatedComplaint_ID=p_ComplainantApplicant_RelatedComplaint_ID;
  
Insert into tbl_rera_complaint_formn_CaseTransferDetails
(    
