end if;
if v_getPaymentCount<>0 then
	set v_PaymentDetails='Y'; 
end if;


if v_getOtherMemberFlag<>0 then
	set v_CheckOtherMemberDetails='Y'; 
end if;
if v_getOtherStateFlag<>0 then
	set v_CheckOtherStateUTRERADetails='Y'; 
end if;



if v_getAgentType=1
then
    -- Individual Agent
    if v_CheckOtherStateUTRERADetails='Y'
    then
		-- Yes Other RERA
		if v_profie='Y' AND v_documentupload='Y' AND v_OtherStateUTRERADetails='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	else
	    -- No Other RERA
		if v_profie='Y' AND v_documentupload='Y' AND v_PaymentDetails='Y' 
		then
		set  v_mainCount=1;
		end if;
	end if;
else 
