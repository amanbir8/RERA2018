    DECLARE v_ret varchar(250);  
    SELECT  
    CASE 
	WHEN p.Flag=1 THEN Concat(Cast(p.First_Name as char(80)) , SPACE(1) , Cast(p.Middle_Name as char(80)) , SPACE(1) , Cast(p.Last_Name as char(80)) , SPACE(1) , '(Individual)')
	WHEN p.Flag=2 THEN Concat(Cast(p.Org_Name as char(80)) , SPACE(1) , '(Other than Individual)')
	END INTO v_ret 
    FROM Rera_Tbl_Promoter p   
    WHERE p.Application_id = p_Promoter_ID   
        AND p.IsActive = 1;    
     IF (v_ret IS NULL) THEN   
        SET v_ret = 'Unknown Promoter';
     END IF;
    RETURN v_ret; 
