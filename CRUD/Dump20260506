    p_InputRequestID varchar(150),
    p_InputRefPromoterID varchar(150),
    p_InputRefProjectID varchar(150),
    p_InputReferenceID varchar(150),
	p_InputLockUnlockValue varchar(100),
	p_ByUserName varchar(150),
	p_ByUserID varchar(150),
	p_RelatedRemarksIfAny varchar(500),
	p_RelatedPVMsg varchar(250),
	p_A_Column varchar(100),
	p_B_Column varchar(100),
	out p_valIsFlagReturn int
)
BEGIN 

declare v_putIsDraftvalue int;
declare v_registeredreopenvalue int;
declare v_registeredlockvalue int;
declare v_RelatedType varchar(250);

set v_RelatedType = 'Unlock Master of Promoter (unlock request)';
set v_registeredreopenvalue = 0;
set v_registeredlockvalue = 0;
set v_putIsDraftvalue=100;

if p_InputLockUnlockValue = '1' then
	set v_RelatedType = 'Lock Master of Promoter (lock request)';	   
end if;

if (p_InputReferenceID = '55') then
	-- Working File Table
	select count(*) into v_registeredreopenvalue from tbl_rera_ldr_project_reopen_unlock_historydetails 
	where Related_ProjectID=p_InputRefProjectID and Related_PromoterID=p_InputRefPromoterID
	and IsActive=1 and IsLock=0 and IsUnlockRequest=1
	limit 1;

end if;

if (p_InputReferenceID = '56' or p_InputReferenceID = '57' or p_InputReferenceID = '58') then
	-- Unlock Application File Table
	select count(*) into v_registeredreopenvalue from tbl_rera_ldr_project_reopen_editapplication_historydetails 
	where Related_ProjectID=p_InputRefProjectID and Related_PromoterID=p_InputRefPromoterID
	and IsActive=1 and IsLock=0 and IsUnlockRequest=1
	limit 1;

end if;

select count(*) into v_registeredlockvalue from tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=p_InputRefPromoterID and IsActive=1;  


if (v_registeredreopenvalue <> 0 and v_registeredlockvalue <> 0) then

	Insert into tbl_rera_ldr_cp_setlockunlockprojectsuperlock_logdetails
	(    
	  -- `CP_SuperLockUnLock_IndexID`,
	  `RelatedType`,
	  `RelatedRefIndexId`,
	  `RelatedRefId`,
	  `RelatedPromoterId`,
	  `RelatedProjectId`,
	  `RelatedReferenceId`,
	  `PublicUnpublicValue`,
	  `UserName`,
	  `UserID`,
	  `Remarks_IfAny`,
	  `PVMsg_IfAny`,
	  `A_Column`,
	  `B_Column`,
	  `IsActive`,
	  `IsDraft`,
	  `CreatedBy`,
	  `CreatedOn`,
	  `ModifyBy`,
	  `ModifyOn`
	) 
	values( 
	  -- CP_SuperLockUnLock_IndexID,
	  v_RelatedType,
	  p_InputRequestIndexID,
	  p_InputRequestID,
	  p_InputRefPromoterID,
	  p_InputRefProjectID,
	  p_InputReferenceID,
	  p_InputLockUnlockValue,
	  p_ByUserName,
	  p_ByUserID,
	  p_RelatedRemarksIfAny,
	  p_RelatedPVMsg,
	  p_A_Column,
	  p_B_Column,
	  1,
	  0,
	  p_ByUserName,
	  NOW(),
	  p_ByUserName,
	  NOW()
	);
    
    
    if (p_InputReferenceID = '55' or p_InputReferenceID = '56') then
		-- Working File Table	
		if p_InputLockUnlockValue = '1' then
		   -- request for ON Lock-Unlock regarding Superlock
		   update tbl_RERA_Promoter_RegDiaryNumber set IsDraftMember=1, IsDraft=1
		   where Promoter_ID=p_InputRefPromoterID and IsActive=1;
		   
		   set v_putIsDraftvalue=101;	   
		end if;

		if p_InputLockUnlockValue = '0' then
		   -- request for OFF Lock-Unlock regarding Superlock
		   update tbl_RERA_Promoter_RegDiaryNumber set IsDraftMember=0
		   where Promoter_ID=p_InputRefPromoterID and IsActive=1;
		   
		   set v_putIsDraftvalue=105;	   
		end if;
    else		
		-- Application File Table (57/58)
		if p_InputLockUnlockValue = '1' then
		   -- request for ON Lock-Unlock regarding SuperDraftlock
		   update tbl_RERA_Promoter_RegDiaryNumber set IsDraftMember=0, IsDraft=1
		   where Promoter_ID=p_InputRefPromoterID and IsActive=1;
		   
		   set v_putIsDraftvalue=101;	   
		end if;

		if p_InputLockUnlockValue = '0' then
		   -- request for OFF Lock-Unlock regarding SuperDraftlock
		   update tbl_RERA_Promoter_RegDiaryNumber set IsDraftMember=0, IsDraft=0
		   where Promoter_ID=p_InputRefPromoterID and IsActive=1;
		   
		   set v_putIsDraftvalue=105;	   
		end if;
	end if;
    
end if;

set p_valIsFlagReturn = v_putIsDraftvalue;
   
END ;;
