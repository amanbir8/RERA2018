in 
(
'PRJ2018SAS1272',
'PRJ2018SAS1291',
'PRJ2018SAS1281',
'PRJ2020SAS2011',
'PRJ2018SAS1416',
'PRJ2022SAS0157'
)
)
) m,
tbl_RERA_Project_Registration n 
where n.ProjectRegistration_ID=m.Project_ID and n.IsActive=1) Y,
(

select 
p.ProjectConstructionRelated_ProjectRegistration_ID,
p.Unit_FloorPlotsNumber,
q.Unit_ApartmentShopPlot_CarpetArea
from
(select ProjectConstructionRelated_ProjectRegistration_ID,SUM(Proposed_FloorPlotsNumber) as Unit_FloorPlotsNumber from tbl_RERA_Project_BuildingTowerBlock_Construction 
