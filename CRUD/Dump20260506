CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Project_Photographs_ByPhotoCodeInfoProjectID`(  
 p_Promoter_ID bigint,
 p_Project_ID bigint,
 p_varYear int,
 p_varQuater varchar(100),
 p_ConstructionCode int,
 p_BlockCode bigint
 )
begin 

declare v_countfile bigint; declare v_countfilesize bigint;-- , @ConstructionCode bigint

-- set @ConstructionCode =1
if (p_ConstructionCode = 1)
then
select COUNT(*) into v_countfile from tbl_RERA_Project_ConstructionStatusPhotographs 
where ProjectPhotographsRelated_Project_ID=p_Project_ID
  and Promoter_ID=p_Promoter_ID
  and TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Code=p_ConstructionCode
  and B_column=p_varYear
  and IsActive=1;
end if;
if (p_ConstructionCode = 2)
then
select COUNT(*) into v_countfile from tbl_RERA_Project_ConstructionStatusPhotographs 
where ProjectPhotographsRelated_Project_ID=p_Project_ID
  and Promoter_ID=p_Promoter_ID
  and TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Code=p_ConstructionCode
  and B_column=p_varYear
  and BuildingTowerBlock_InfoCode=p_BlockCode
  and IsActive=1;
end if;
if (p_ConstructionCode = 3)
then
select COUNT(*) into v_countfile from tbl_RERA_Project_ConstructionStatusPhotographs 
where ProjectPhotographsRelated_Project_ID=p_Project_ID
  and Promoter_ID=p_Promoter_ID
  and TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Code=p_ConstructionCode
  and B_column=p_varYear
  and IsActive=1;
end if; 

if (p_ConstructionCode = 1)
then
select IFNULL(sum(CAST(Photographs_FileSize as unsigned integer)), 0) into v_countfilesize  
from tbl_RERA_Project_ConstructionStatusPhotographs 
where ProjectPhotographsRelated_Project_ID=p_Project_ID
  and Promoter_ID=p_Promoter_ID
  and TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Code=p_ConstructionCode
  and B_column=p_varYear
  and IsActive=1;
end if;
if (p_ConstructionCode = 2)
then
