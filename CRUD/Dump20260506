				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as LastActionEvent_IdentifiedOn,
				EventAction_Type as LastActionEvent_Type,
				EventAction_Aggregate as LastActionEvent_Aggregate
				from tbl_rera_project_extensionform_eventaction 
				where isactive=1
                and MONTH(EventAction_IdentifiedOn)=p_InputEntry_Month
			    and YEAR(EventAction_IdentifiedOn)=p_InputEntry_Year
				) MF
				left outer join
				(
				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as ApplicationApprovalDate,
				'Y' as ApprovalFlag
				from tbl_rera_project_extensionform_eventaction 
