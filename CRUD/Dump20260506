CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_RERA_AgentRenewal_RegDiaryNumber`( 	
    p_Related_Agent_ID bigint(20),
    p_Related_TypeOfAgent_ID int(11),
    p_Related_RenewalAgent_ID bigint(20),
    p_Related_RenewalAgent_SequenceID int(11),
    p_Related_RenewalAgent_Year int(11),
    p_Related_Agent_DiaryNumber varchar(100),
    p_Related_Registration_Number varchar(100),
    p_Flag int(11),
    p_UserID varchar(150), 
	p_A_column varchar(200),
	p_B_column varchar(200),
	p_C_column varchar(200),
	p_Remarks_IfAny varchar(250),    
	p_IsActive int(11),
	p_IsDraft int(11),
	p_IsLock int(11),
	p_IsDraftEvaluation int(11),
	p_IsDraftSecMember int(11),
	p_IsDraftMember int(11),
	p_IsActiveProvider int(11),
	p_CreatedBy varchar(50),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),
    out p_Return_RenewalAgent_RegDiaryNumber_Name varchar(120)
)
begin

	declare v_Get_RenewalSequenceID int;
    declare v_Get_RenewalSequenceMaxID int;
    declare v_Put_RenewalSequenceID int;
	declare v_GetRenewalAgent_RegDiaryNumber_ID bigint;
	declare v_PutRenewalAgent_RegDiaryNumber_ID bigint;
