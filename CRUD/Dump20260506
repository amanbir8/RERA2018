CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_JointPromoter_Isdraftvalue_FromDiaryNumber`(  
	p_Promoter_ID bigint,
    p_Promoter_Type int,
    p_JointPromoter_ID bigint,
    p_JointPromoter_Type int
)
begin 
Declare v_Total Int; 
Declare v_PromoterTotal Int;
Declare v_GetIsDraft Int;
Declare v_JointPromoterTotal Int; 
Declare v_GetJointPromoterIsDraft Int;
Declare v_GetJointPromoterIsLock Int;
Declare v_GetIsDraftFINAL Int;

set v_GetIsDraft=0;
set v_GetJointPromoterIsDraft=0;
set v_GetJointPromoterIsLock=0;
set v_GetIsDraftFINAL=0;

-- START -- PROMOTER
SELECT COUNT(*) INTO v_Total FROM tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=p_Promoter_ID and isactive=1;  
    
if (v_Total>0) then 
	SELECT IsDraft INTO v_GetIsDraft FROM tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=p_Promoter_ID and isactive=1
	order by PromoterRegDiaryNumber_IndexID desc
	limit 1; 
    
    if (v_GetIsDraft>0) then
		set v_GetIsDraftFINAL=v_GetIsDraft;
    else
		-- START -- JOINT PROMOTER
        SELECT COUNT(*) INTO v_JointPromoterTotal FROM tbl_rera_copromoter_regdiarynumber 
        where LinkTo_Related_Promoter_ID=p_Promoter_ID and Related_CoPromoter_ApplicationID=p_JointPromoter_ID and isactive=1;
        
        if (v_JointPromoterTotal>0) then        
			SELECT IsDraft, IsLock INTO v_GetJointPromoterIsDraft, v_GetJointPromoterIsLock FROM tbl_rera_copromoter_regdiarynumber 
			WHERE LinkTo_Related_Promoter_ID=p_Promoter_ID and Related_CoPromoter_ApplicationID=p_JointPromoter_ID
			and IsActive=1
			order by CoPromoter_RegDiaryNumber_IndexID desc
			limit 1;
            
            if (v_GetJointPromoterIsLock>0) then
				set v_GetIsDraftFINAL=v_GetJointPromoterIsLock;
			else
				set v_GetIsDraftFINAL=v_GetJointPromoterIsDraft;
            end if;
		else
			set v_GetIsDraftFINAL=0;
        end if;
        -- END -- JOINT PROMOTER
    end if;
    
else
	set v_GetIsDraftFINAL=0;  
    
    SELECT COUNT(*) INTO v_PromoterTotal FROM rera_tbl_promoter WHERE Application_id=p_Promoter_ID and IsActive=1;    
    if (v_PromoterTotal>0) then
		-- START -- JOINT PROMOTER
        SELECT COUNT(*) INTO v_JointPromoterTotal FROM tbl_rera_copromoter_regdiarynumber 
        where LinkTo_Related_Promoter_ID=p_Promoter_ID and Related_CoPromoter_ApplicationID=p_JointPromoter_ID and isactive=1;
        
        if (v_JointPromoterTotal>0) then        
			SELECT IsDraft, IsLock INTO v_GetJointPromoterIsDraft, v_GetJointPromoterIsLock FROM tbl_rera_copromoter_regdiarynumber 
			WHERE LinkTo_Related_Promoter_ID=p_Promoter_ID and Related_CoPromoter_ApplicationID=p_JointPromoter_ID
			and IsActive=1
			order by CoPromoter_RegDiaryNumber_IndexID desc
			limit 1;
            
            if (v_GetJointPromoterIsLock>0) then
				set v_GetIsDraftFINAL=v_GetJointPromoterIsLock;
			else
				set v_GetIsDraftFINAL=v_GetJointPromoterIsDraft;
            end if;
		else
			set v_GetIsDraftFINAL=0;
        end if;
        -- END -- JOINT PROMOTER    
    end if;
end if; 
-- END -- PROMOTER
        
Select v_GetIsDraftFINAL AS mainCount;

end ;;
DELIMITER ;
