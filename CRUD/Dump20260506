		from  tbl_RERA_Agent_RegDiaryNumber 
		where Agent_ID=p_Related_Agent_ID and IsActive=1;
	END IF;
    
	-- INSERT RNA DiaryNumber
	IF v_checkExistingRNAdiaryNumberCount>0 THEN

		-- START-103 -- [Update Previous Record (LOCK)] --
		update tbl_rera_agent_renewal_regdiarynumber set IsDraft=1, IsLock=1, IsActiveProvider=0 
		where AgentRenewal_ID=p_Related_RenewalAgent_ID and AgentRenewal_Year=p_Related_RenewalAgent_Year and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
		and Agent_ID=p_Related_Agent_ID and RERAnumberRegistration=p_Related_Registration_Number
