	IF(p_GroupId=2) THEN
		-- Agent Cases
		SELECT 
		PaymentType_Code as epayID,
        PaymentType as epayNAME
		FROM tbl_rera_master_paymenttype
		where isactive=1
		and PaymentType_Code in (1,2,3,5)
		Order by epayNAME desc;
	ELSE
		IF(p_GroupId=3) THEN
			-- Court Cases
			SELECT '501' AS epayID, 'Registered Complaints' AS epayNAME
			UNION ALL
			SELECT '502', 'Pending Diary Number Complaints';
		ELSE
			-- All Cases
			SELECT 
            PaymentType_Code as epayID, 
            PaymentType as epayNAME 
            FROM tbl_rera_master_paymenttype
			where isactive=1
			and PaymentType_Code in (1,2,3)
			Order by epayNAME desc;
		END IF;
	END IF;
END IF;

  
end ;;
