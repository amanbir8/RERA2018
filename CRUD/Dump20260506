CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_tbl_rera_project_completioncertificatedetails`(
  p_ProjectCompletion_IndexID bigint(20),
  p_ProjectCompletion_ID bigint(20),
  p_Promoter_ID bigint(20),
  p_Project_ID bigint(20),
  p_User_ID varchar(50),
  p_RERAnumberRegistration varchar(200),
  p_RERAnumberIssueDate datetime,
  p_RERAnumberRegUptoDate datetime,
  p_IsExtensionRegistration int,
  p_RERAnumberExtensionRegUptoDate datetime,
  p_ProjectDiaryNumber varchar(250),
  p_ExtensionRegdDiaryNumber varchar(250),
  p_ProjectName varchar(250),
  p_PromoterName varchar(250),
  p_ProjectAddressDistrict varchar(250),
  p_DName varchar(250),
  p_ProjectType varchar(250),
  p_PCC_InfoDetails varchar(250),
  p_PCC_IssueAuthority varchar(250),
  p_PCC_ReferenceName varchar(250),
  p_PCC_ReferenceDate datetime,
  p_PCC_CertificateType varchar(200),
  p_PCC_CertificateStatus varchar(200),
  p_PCC_ReceiptDatePlanned_DateExpected datetime,
  p_PCC_ReciptType varchar(200),
  p_RemarksIfAny varchar(250),
  p_Extra1 varchar(250),
  p_Extra2 varchar(250),
  p_Extra3 varchar(250),
  p_Extra4 varchar(250),
  p_Extra5 varchar(250),
  p_IsActive int,
  p_IsDraft int,
  p_IsLock int,
  p_IsApproval int,
  p_IsConditional int,
  p_IsPublicView int,
  p_CreatedBy varchar(50),
  p_CreatedOn datetime(3),
  p_ModifyBy varchar(50),
  p_ModifyOn datetime(3),
  out p_valreturn varchar(150)          
)
begin        
  
    declare v_verifyPCCdetailsCount int;    
    declare v_GetProjectCompletion_ID bigint;
    declare v_PutProjectCompletion_ID bigint;
    declare v_verifyProjectCompletion_ID bigint;
    declare v_returnValueCode varchar(100);

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
 

	-- ---------PCC Information details INSERT -------------
	select COUNT(*) into v_verifyPCCdetailsCount from tbl_rera_project_completiondetails 
	where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERAnumberRegistration=p_RERAnumberRegistration and IsActive=1;

	if v_verifyPCCdetailsCount>0
	then
		select ProjectCompletion_ID into v_verifyProjectCompletion_ID from tbl_rera_project_completiondetails 
		where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERAnumberRegistration=p_RERAnumberRegistration and IsActive=1;
    
		update tbl_rera_project_completiondetails set IsActive=2 
		where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERAnumberRegistration=p_RERAnumberRegistration and IsActive=1;  
  
		INSERT INTO tbl_rera_project_completiondetails  
		(
		  -- ProjectCompletion_IndexID,
		  ProjectCompletion_ID,
		  Promoter_ID,
		  Project_ID,
		  User_ID,
		  RERAnumberRegistration,
		  RERAnumberIssueDate,
		  RERAnumberRegUptoDate,
		  IsExtensionRegistration,
		  RERAnumberExtensionRegUptoDate,
          ProjectDiaryNumber,
		  ExtensionRegdDiaryNumber,
		  ProjectName,
		  PromoterName,
		  ProjectAddressDistrict,
		  DName,
		  ProjectType,
		  PCC_InfoDetails,
		  PCC_IssueAuthority,
		  PCC_ReferenceName,
		  PCC_ReferenceDate,
		  PCC_CertificateType,
		  PCC_CertificateStatus,
		  PCC_ReceiptDatePlanned_DateExpected,
		  PCC_ReciptType,
		  RemarksIfAny,
		  Extra1,
		  Extra2,
		  Extra3,
		  Extra4,
          Extra5,
		  IsActive,
		  IsDraft,
		  IsLock,
          IsApproval,
		  IsConditional,
		  IsPublicView,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		)  
		VALUES  
		(  
		  -- p_ProjectCompletion_IndexID,
		  v_verifyProjectCompletion_ID, -- p_ProjectCompletion_ID,
		  p_Promoter_ID,
		  p_Project_ID,
		  p_User_ID,
		  p_RERAnumberRegistration,
		  p_RERAnumberIssueDate,
		  p_RERAnumberRegUptoDate,
		  p_IsExtensionRegistration,
		  p_RERAnumberExtensionRegUptoDate,
		  p_ProjectDiaryNumber,
		  p_ExtensionRegdDiaryNumber,
		  p_ProjectName,
		  p_PromoterName,
		  p_ProjectAddressDistrict,
		  p_DName,
		  p_ProjectType,
		  p_PCC_InfoDetails,
		  p_PCC_IssueAuthority,
		  p_PCC_ReferenceName,
		  p_PCC_ReferenceDate,
		  p_PCC_CertificateType,
		  p_PCC_CertificateStatus,
		  p_PCC_ReceiptDatePlanned_DateExpected,
		  p_PCC_ReciptType,
		  p_RemarksIfAny,
		  p_Extra1,
		  p_Extra2,
		  p_Extra3,
		  p_Extra4,
		  p_Extra5,
		  1, -- p_IsActive,
		  1, -- p_IsDraft,
		  1, -- p_IsLock,
		  p_IsApproval,
		  p_IsConditional,
		  p_IsPublicView,
		  p_CreatedBy,
		  NOW(), -- p_CreatedOn,
		  p_ModifyBy,
		  NOW() -- p_ModifyOn
		);
        
        set v_returnValueCode='Updated';
    else    
		-- ------------------------- Application Number ------------------------            
		select max(ProjectCompletion_ID) into v_GetProjectCompletion_ID from tbl_rera_project_completiondetails;        

		IF (v_GetProjectCompletion_ID IS NULL)          
		then          
			set v_PutProjectCompletion_ID=1001;
		else           
			set v_PutProjectCompletion_ID=v_GetProjectCompletion_ID+1;
		end if; 
	
        -- New PCC details
	    INSERT INTO tbl_rera_project_completiondetails  
		(
		  -- ProjectCompletion_IndexID,
		  ProjectCompletion_ID,
		  Promoter_ID,
		  Project_ID,
		  User_ID,
		  RERAnumberRegistration,
		  RERAnumberIssueDate,
		  RERAnumberRegUptoDate,
		  IsExtensionRegistration,
		  RERAnumberExtensionRegUptoDate,
          ProjectDiaryNumber,
		  ExtensionRegdDiaryNumber,
		  ProjectName,
		  PromoterName,
		  ProjectAddressDistrict,
		  DName,
		  ProjectType,
		  PCC_InfoDetails,
		  PCC_IssueAuthority,
		  PCC_ReferenceName,
		  PCC_ReferenceDate,
		  PCC_CertificateType,
		  PCC_CertificateStatus,
		  PCC_ReceiptDatePlanned_DateExpected,
		  PCC_ReciptType,
		  RemarksIfAny,
		  Extra1,
		  Extra2,
		  Extra3,
		  Extra4,
          Extra5,
		  IsActive,
		  IsDraft,
		  IsLock,
          IsApproval,
		  IsConditional,
		  IsPublicView,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		)  
		VALUES  
		(  
		  -- p_ProjectCompletion_IndexID,
		  v_PutProjectCompletion_ID, -- p_ProjectCompletion_ID,
		  p_Promoter_ID,
		  p_Project_ID,
		  p_User_ID,
		  p_RERAnumberRegistration,
		  p_RERAnumberIssueDate,
		  p_RERAnumberRegUptoDate,
		  p_IsExtensionRegistration,
		  p_RERAnumberExtensionRegUptoDate,
		  p_ProjectDiaryNumber,
		  p_ExtensionRegdDiaryNumber,
		  p_ProjectName,
		  p_PromoterName,
		  p_ProjectAddressDistrict,
		  p_DName,
		  p_ProjectType,
		  p_PCC_InfoDetails,
		  p_PCC_IssueAuthority,
		  p_PCC_ReferenceName,
		  p_PCC_ReferenceDate,
		  p_PCC_CertificateType,
		  p_PCC_CertificateStatus,
		  p_PCC_ReceiptDatePlanned_DateExpected,
		  p_PCC_ReciptType,
		  p_RemarksIfAny,
		  p_Extra1,
		  p_Extra2,
		  p_Extra3,
		  p_Extra4,
		  p_Extra5,
		  1, -- p_IsActive,
		  1, -- p_IsDraft,
		  1, -- p_IsLock,
		  p_IsApproval,
		  p_IsConditional,
		  p_IsPublicView,
		  p_CreatedBy,
		  NOW(), -- p_CreatedOn,
		  p_ModifyBy,
		  NOW() -- p_ModifyOn
		);
        
        set v_returnValueCode='Submitted';
	end if;


-- End------------------------       

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;        
    
set p_valreturn=v_returnValueCode; 

end ;;
DELIMITER ;
