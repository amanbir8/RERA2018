CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AgentRenewal_VerifyRegistrationNumberByID`(  
	p_Index_ID bigint,
    p_Key_ID bigint,
    p_Agent_ID bigint,
    p_TypeOfAgent_ID bigint,
    p_RegNumber varchar(120),
    p_RegFromDate datetime(3),
    p_RegToDate datetime(3),
    p_UserNam varchar(100)
)
begin
-- Case 1
declare v_AgentID_count int(11);
declare v_AgentID bigint;
declare v_Agent_ID_Flag int;
-- Case 2
declare v_getAR_ldr_agent_reranumber_count int(11);
declare v_getAR_agent_renewal_profile_count int(11);
declare v_getAR_ldr_agent_reranumber_renewalregd_count int(11);

declare v_getAR_ldr_Agent_ID bigint(20);
declare v_getAR_ldr_Agent_Type int(11);
declare v_getAR_ldr_AgentRegDiaryNumber_Name varchar(120);
declare v_getAR_ldr_reranumber varchar(150);
declare v_getAR_ldr_reranumber_FromDate datetime(3);
declare v_getAR_ldr_reranumber_ToDate datetime(3);

declare v_getAR_new_RenewalAgent_ID bigint(20);
declare v_getAR_new_RenewalSequence_ID int(11);
declare v_getAR_new_RenewalYear int(11);
declare v_getAR_new_Agent_ID bigint(20);
declare v_getAR_new_Agent_Type int(11);
declare v_IsOtherOrgMembers varchar(50);
declare v_IsOtherStateUT_reranumber varchar(50);
declare v_getAR_new_reranumber varchar(150);
declare v_getAR_new_reranumber_FromDate datetime(3);
declare v_getAR_new_reranumber_ToDate datetime(3);
declare v_getAR_renewal_reranumber varchar(150);
declare v_getAR_renewal_reranumber_FromDate datetime(3);
declare v_getAR_renewal_reranumber_ToDate datetime(3);

declare v_putAR_reranumber varchar(150);
declare v_putAR_reranumber_FromDate datetime(3);
declare v_putAR_reranumber_ToDate datetime(3);
declare v_YesNo_AgentID_Flag int(11);
declare v_YesNo_AgentRegistered_Flag int(11);
declare v_YesNo_RenewalAgentID_Flag int(11);
declare v_YesNo_RenewalAgentRegistered_Flag int(11);
declare v_YesNo_RenewalAgent_OrgMembers_Flag int(11);
declare v_YesNo_RenewalAgent_OtherStateUTnumber_Flag int(11);
declare v_YesNo_ValidforAgentRenewal_Flag int(11);


IF (p_Key_ID=1) THEN
	-- Search Offline Registration Number
    set v_Agent_ID_Flag=0;
    set v_AgentID=0;
    select count(*) into v_AgentID_count from tbl_rera_agent_profile 
    where IsAlready_RERANumber='Y' and IsActive=1 and Existing_RERANumber=p_RegNumber;
    IF (v_AgentID_count<>0) THEN
        select Agent_ID into v_AgentID from tbl_rera_agent_profile 
		where IsAlready_RERANumber='Y' and IsActive=1 and Existing_RERANumber=p_RegNumber
        Limit 1;    
		Set v_Agent_ID_Flag=21;
    END IF;    
    
	SELECT
	0 as AgentRenewal_VerifyPreviousRegistration_IndexID,
	0 as AgentRenewal_VerifyPreviousRegistration_ID,
	--  //Registration Number//
	OfflineAgents_RERAregistrationNumber as RERAnumberRegistration,
	OfflineAgents_RERAregistrationIssueDate as RERAnumberIssueDate,
	OfflineAgents_RERAregistrationValidUptoDate as RERAnumberRegUptoDate,
	--  //Agent ID//
	v_AgentID as Agent_ID,
	'' as UserID,
	'' as UserName,
	'' as Agent_RegDiaryNumber_Name,
	0 as Agent_RegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Agent_RegDiaryNumber_Application_Date,
	v_Agent_ID_Flag as Agent_LDR_RERAnumber_DiaryNumber_ID,
	0 as Is_YesNo_AgentRegistered_Flag,
	-- //Agent Description//
	OfflineAgents_AgentName_OrganizationName as Agent_Name,
	OfflineAgents_BusinessPlaceDistrict as Agent_AddressDistrictName,
	OfflineAgents_AgentType as Agent_Type,
	OfflineAgents_PlaceOfBussinessAddress as Agent_PlaceOfBussiness_AddressLine1,
	OfflineAgents_ContactDetails as Agent_PlaceOfBussiness_AddressLine2,
	 '' as Agent_PlaceOfBussiness_District,
	'' as Agent_PlaceOfBussiness_State,
	'' as Agent_PlaceOfBussiness_PIN,
	'' as Agent_Email_Address,
	0 as Agent_Mobile_PhoneNumber,
	1 as Is_YesNo_AgentDescription_Flag,
	-- //Agent Renewal ID//
	0 as Related_RenewalAgent_ID,
	0 as Related_RenewalAgent_Year,
	0 as Renewal_OrderSequence,
	'' as Renewal_OrderSequence_Name,
	'' as Related_RenewalAgentRegDiaryNumber_Name,
	0 as Related_RenewalAgentRegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Related_RenewalAgentRegDiaryNumber_Application_Date,
	'' as RenewalAgentRegistrationNumber,
	'0001-01-01 00:00:00.000' as RenewalAgentRegistrationIssueDate,
	'0001-01-01 00:00:00.000' as RenewalAgentRegistrationRegUptoDate,
	0 as Agent_LDR_RenewalRERAnumber_DiaryNumber_ID,
	0 as Is_YesNo_ActiveProvider_Flag,
	0 as Is_YesNo_RenewalAgentRegistered_Flag,
	-- //Offline Agent Registered Number//
	OfflineAgents_RERAregistrationNumber as OfflineAgentRegistrationNumber,
	OfflineAgents_RERAregistrationIssueDate as OfflineAgentRegistrationIssueDate,
	OfflineAgents_RERAregistrationValidUptoDate as OfflineAgentRegistrationRegUptoDate,
	v_AgentID as ProfileNewCreated_Agent_ID,
	v_Agent_ID_Flag as Is_YesNo_ProfileNewCreated_Flag,
	1 as Is_YesNo_OfflineAgentRegistered_Flag,
	-- //Agent Renewal Permission Flag//
	0 as Is_YesNo_AgentRenewalPermission_Flag,
	udfn_GetAgent_ValidforAgentRenewal(OfflineAgents_RERAregistrationValidUptoDate) as Is_YesNo_ValidforAgentRenewal_Flag,

	'' as A_column,
	'' as B_column,
	'' as C_column,

	0 as IsActive,
	0 as IsDraft,
	0 as IsLock,
	0 as IsPublicView,
	'' as CreatedBy,
	'0001-01-01 00:00:00.000' as CreatedOn,
	'' as ModifyBy,
	'0001-01-01 00:00:00.000' as ModifyOn
	FROM tbl_rera_agent_offlineagents_pendinguploads
	WHERE IsActive=1
    AND OfflineAgents_RERAregistrationNumber=p_RegNumber 
    AND OfflineAgents_RERAregistrationIssueDate=p_RegFromDate 
    AND OfflineAgents_RERAregistrationValidUptoDate=p_RegToDate
    LIMIT 1;
END IF;

IF (p_Key_ID=2) THEN
	-- Option Flow for FLAG config (Online RegNumber and latest Renewal Case)
	set v_putAR_reranumber='';
    set v_putAR_reranumber_FromDate='0001-01-01 00:00:00.000';
	set v_putAR_reranumber_ToDate='0001-01-01 00:00:00.000';
    set v_YesNo_AgentID_Flag=0;
	set v_YesNo_AgentRegistered_Flag=0;
	set v_YesNo_RenewalAgentID_Flag=0;
    set v_YesNo_RenewalAgentRegistered_Flag=0;
    set v_getAR_new_RenewalAgent_ID=0;
	set v_getAR_new_RenewalYear=0;
	set v_getAR_new_RenewalSequence_ID=0;
	set v_YesNo_RenewalAgent_OrgMembers_Flag=0;
    set v_YesNo_RenewalAgent_OtherStateUTnumber_Flag=0;
    set v_YesNo_ValidforAgentRenewal_Flag=0;
    
	select count(*) into v_getAR_ldr_agent_reranumber_count from tbl_rera_ldr_agent_reranumber_diarynumber 
    where Agent_ID=p_Agent_ID and IsActive=1 and IsPublicView=1 and IsDraftSecMember=0;
    
    IF (v_getAR_ldr_agent_reranumber_count<>0) THEN
        select m.Agent_ID,m.Agent_Type,n.AgentRegDiaryNumber_Name,n.RERAnumberRegistration,n.RERAnumberIssueDate,n.RERAnumberRegUptoDate 
        into v_getAR_ldr_Agent_ID,v_getAR_ldr_Agent_Type,v_getAR_ldr_AgentRegDiaryNumber_Name,v_getAR_ldr_reranumber,v_getAR_ldr_reranumber_FromDate,v_getAR_ldr_reranumber_ToDate
		from tbl_rera_agent_profile m, tbl_rera_ldr_agent_reranumber_diarynumber n
		where m.Agent_ID=n.Agent_ID and m.IsActive=1 and m.IsDraft in (1,5,6)
		and n.IsActive=1 and n.IsPublicView=1 and n.IsDraftSecMember=0
		and m.Agent_ID=p_Agent_ID
        Limit 1;
        
        set v_putAR_reranumber=v_getAR_ldr_reranumber;
		set v_putAR_reranumber_FromDate=v_getAR_ldr_reranumber_FromDate;
		set v_putAR_reranumber_ToDate=v_getAR_ldr_reranumber_ToDate;
        set v_YesNo_AgentID_Flag=1;
		set v_YesNo_AgentRegistered_Flag=1;
    END IF;
    
    select count(*) into v_getAR_agent_renewal_profile_count from tbl_rera_agent_renewal_profile 
    where Related_Agent_ID=p_Agent_ID and Related_Agent_Type=p_TypeOfAgent_ID and IsActive=1 and IsActiveProvider=1;
    
    IF (v_getAR_agent_renewal_profile_count<>0) THEN
		select RenewalAgent_ID,RenewalOrderSequence,RelatedRenewalAgent_Year,Related_Agent_ID,Related_Agent_Type,IsOtherOrganizationMembers,IsOtherStateUT_RERAregistration,
        Related_RERAnumberRegistration,Related_RERAnumberIssueDate,Related_RERAnumberRegUptoDate
		into v_getAR_new_RenewalAgent_ID,v_getAR_new_RenewalSequence_ID,v_getAR_new_RenewalYear,v_getAR_new_Agent_ID,v_getAR_new_Agent_Type,v_IsOtherOrgMembers,v_IsOtherStateUT_reranumber,
		v_getAR_new_reranumber,v_getAR_new_reranumber_FromDate,v_getAR_new_reranumber_ToDate
        from tbl_rera_agent_renewal_profile where Related_Agent_ID=p_Agent_ID and Related_Agent_Type=p_TypeOfAgent_ID 
        and IsActive=1 and IsActiveProvider=1
		order by RenewalOrderSequence desc
        Limit 1;
        
        set v_YesNo_RenewalAgentID_Flag=1;
        -- set v_YesNo_ValidforAgentRenewal_Flag=21;
        set v_putAR_reranumber=v_getAR_new_reranumber;
        set v_putAR_reranumber_FromDate=v_getAR_new_reranumber_FromDate;
		set v_putAR_reranumber_ToDate=v_getAR_new_reranumber_ToDate;        
        
        IF (v_IsOtherOrgMembers='Y') THEN
			set v_YesNo_RenewalAgent_OrgMembers_Flag=1;
        END IF;
        IF (v_IsOtherStateUT_reranumber='Y') THEN
			set v_YesNo_RenewalAgent_OtherStateUTnumber_Flag=1;
        END IF;
    END IF;
    
    select count(*) into v_getAR_ldr_agent_reranumber_renewalregd_count from tbl_rera_ldr_agent_reranumber_renewalregistration 
    where RelatedAgent_ID=v_getAR_new_Agent_ID 
    and RelatedRenewalAgent_ID=v_getAR_new_RenewalAgent_ID 
    and RelatedRenewalAgent_Year=v_getAR_new_RenewalYear 
    and RenewalOrderSequence=v_getAR_new_RenewalSequence_ID
    and IsActive=1 and IsDraft=1;
    
    IF (v_getAR_ldr_agent_reranumber_renewalregd_count<>0) THEN        
        set v_YesNo_RenewalAgentRegistered_Flag=1;
        -- set v_putAR_reranumber='';
    END IF;    
    
	SELECT
	0 as AgentRenewal_VerifyPreviousRegistration_IndexID,
	0 as AgentRenewal_VerifyPreviousRegistration_ID,
	--  //Registration Number//
	v_putAR_reranumber as RERAnumberRegistration,
	v_putAR_reranumber_FromDate as RERAnumberIssueDate,
	v_putAR_reranumber_ToDate as RERAnumberRegUptoDate,
	--  //Agent ID//
	p_Agent_ID as Agent_ID,
	'' as UserID,
	'' as UserName,
	'' as Agent_RegDiaryNumber_Name,
	0 as Agent_RegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Agent_RegDiaryNumber_Application_Date,
	v_YesNo_AgentID_Flag as Agent_LDR_RERAnumber_DiaryNumber_ID, -- 1/0
	v_YesNo_AgentRegistered_Flag as Is_YesNo_AgentRegistered_Flag, -- 1/0
	-- //Agent Description//
	'' as Agent_Name,
	'' as Agent_AddressDistrictName,
	'' as Agent_Type,
	'' as Agent_PlaceOfBussiness_AddressLine1,
	'' as Agent_PlaceOfBussiness_AddressLine2,
	'' as Agent_PlaceOfBussiness_District,
	'' as Agent_PlaceOfBussiness_State,
	'' as Agent_PlaceOfBussiness_PIN,
	'' as Agent_Email_Address,
	0 as Agent_Mobile_PhoneNumber,
	0 as Is_YesNo_AgentDescription_Flag,
	-- //Agent Renewal ID//
	v_getAR_new_RenewalAgent_ID as Related_RenewalAgent_ID,
	v_getAR_new_RenewalYear as Related_RenewalAgent_Year,
	v_getAR_new_RenewalSequence_ID as Renewal_OrderSequence,
	'' as Renewal_OrderSequence_Name,
	'' as Related_RenewalAgentRegDiaryNumber_Name,
	0 as Related_RenewalAgentRegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Related_RenewalAgentRegDiaryNumber_Application_Date,
	'' as RenewalAgentRegistrationNumber,
	'0001-01-01 00:00:00.000' as RenewalAgentRegistrationIssueDate,
	'0001-01-01 00:00:00.000' as RenewalAgentRegistrationRegUptoDate,
	0 as Agent_LDR_RenewalRERAnumber_DiaryNumber_ID,
	v_YesNo_RenewalAgentID_Flag as Is_YesNo_ActiveProvider_Flag, -- 1/0
	v_YesNo_RenewalAgentRegistered_Flag as Is_YesNo_RenewalAgentRegistered_Flag, -- 1/0
	-- //Offline Agent Registered Number//
	OfflineAgents_RERAregistrationNumber as OfflineAgentRegistrationNumber,
	OfflineAgents_RERAregistrationIssueDate as OfflineAgentRegistrationIssueDate,
	OfflineAgents_RERAregistrationValidUptoDate as OfflineAgentRegistrationRegUptoDate,
	0 as ProfileNewCreated_Agent_ID,
	0 as Is_YesNo_ProfileNewCreated_Flag,
	1 as Is_YesNo_OfflineAgentRegistered_Flag,
	-- //Agent Renewal Permission Flag//
	0 as Is_YesNo_AgentRenewalPermission_Flag,
	0 as Is_YesNo_ValidforAgentRenewal_Flag, -- 21/0

	'' as A_column,
	'' as B_column,
	'' as C_column,

	0 as IsActive,
	0 as IsDraft,
	0 as IsLock,
	0 as IsPublicView,
	'' as CreatedBy,
	'0001-01-01 00:00:00.000' as CreatedOn,
	'' as ModifyBy,
	'0001-01-01 00:00:00.000' as ModifyOn
	FROM tbl_rera_agent_offlineagents_pendinguploads
	WHERE IsActive=1
	LIMIT 1;
END IF;

IF (p_Key_ID=3) THEN
	-- Search Online Registration Number and latest renewal case
    set v_putAR_reranumber='';
    set v_putAR_reranumber_FromDate='0001-01-01 00:00:00.000';
	set v_putAR_reranumber_ToDate='0001-01-01 00:00:00.000';
    set v_YesNo_RenewalAgentID_Flag=0;
    set v_YesNo_RenewalAgentRegistered_Flag=0;
    set v_getAR_new_RenewalAgent_ID=0;
	set v_getAR_new_RenewalYear=0;
	set v_getAR_new_RenewalSequence_ID=0;
	set v_YesNo_RenewalAgent_OrgMembers_Flag=0;
    set v_YesNo_RenewalAgent_OtherStateUTnumber_Flag=0;
    
    select count(*) into v_getAR_agent_renewal_profile_count from tbl_rera_agent_renewal_profile 
    where Related_Agent_ID=p_Agent_ID and Related_Agent_Type=p_TypeOfAgent_ID and IsActive=1 and IsActiveProvider=1;
    
    IF (v_getAR_agent_renewal_profile_count<>0) THEN
		select RenewalAgent_ID,RenewalOrderSequence,RelatedRenewalAgent_Year,Related_Agent_ID,Related_Agent_Type,IsOtherOrganizationMembers,IsOtherStateUT_RERAregistration,
        Related_RERAnumberRegistration,Related_RERAnumberIssueDate,Related_RERAnumberRegUptoDate
		into v_getAR_new_RenewalAgent_ID,v_getAR_new_RenewalSequence_ID,v_getAR_new_RenewalYear,v_getAR_new_Agent_ID,v_getAR_new_Agent_Type,v_IsOtherOrgMembers,v_IsOtherStateUT_reranumber,
		v_getAR_new_reranumber,v_getAR_new_reranumber_FromDate,v_getAR_new_reranumber_ToDate
        from tbl_rera_agent_renewal_profile where Related_Agent_ID=p_Agent_ID and Related_Agent_Type=p_TypeOfAgent_ID 
        and IsActive=1 and IsActiveProvider=1
		order by RenewalOrderSequence desc
        Limit 1;
        
        set v_YesNo_RenewalAgentID_Flag=1;
        -- set v_YesNo_ValidforAgentRenewal_Flag=21;
        set v_putAR_reranumber=v_getAR_new_reranumber;
        set v_putAR_reranumber_FromDate=v_getAR_new_reranumber_FromDate;
		set v_putAR_reranumber_ToDate=v_getAR_new_reranumber_ToDate;        
        
        IF (v_IsOtherOrgMembers='Y') THEN
			set v_YesNo_RenewalAgent_OrgMembers_Flag=1;
        END IF;
        IF (v_IsOtherStateUT_reranumber='Y') THEN
			set v_YesNo_RenewalAgent_OtherStateUTnumber_Flag=1;
        END IF;
    END IF;
    
    select count(*) into v_getAR_ldr_agent_reranumber_renewalregd_count from tbl_rera_ldr_agent_reranumber_renewalregistration 
    where RelatedAgent_ID=v_getAR_new_Agent_ID 
    and RelatedRenewalAgent_ID=v_getAR_new_RenewalAgent_ID 
    and RelatedRenewalAgent_Year=v_getAR_new_RenewalYear 
    and RenewalOrderSequence=v_getAR_new_RenewalSequence_ID
    and IsActive=1 and IsDraft=1;
    
    IF (v_getAR_ldr_agent_reranumber_renewalregd_count<>0) THEN        
        
        select RenewalAgentRegistrationNumber,RenewalAgentRegistrationIssueDate,RenewalAgentRegistrationRegUptoDate
        into v_getAR_renewal_reranumber,v_getAR_renewal_reranumber_FromDate,v_getAR_renewal_reranumber_ToDate
        from tbl_rera_ldr_agent_reranumber_renewalregistration 
		where RelatedAgent_ID=v_getAR_new_Agent_ID 
		and RelatedRenewalAgent_ID=v_getAR_new_RenewalAgent_ID 
		and RelatedRenewalAgent_Year=v_getAR_new_RenewalYear 
		and RenewalOrderSequence=v_getAR_new_RenewalSequence_ID
		and IsActive=1 and IsDraft=1
        order by RenewalOrderSequence desc
        Limit 1;
        
        set v_YesNo_RenewalAgentRegistered_Flag=1;
		set v_putAR_reranumber=v_getAR_renewal_reranumber;
        set v_putAR_reranumber_FromDate=v_getAR_renewal_reranumber_FromDate;
		set v_putAR_reranumber_ToDate=v_getAR_renewal_reranumber_ToDate;
    END IF; 
    
    SELECT
	0 as AgentRenewal_VerifyPreviousRegistration_IndexID,
	0 as AgentRenewal_VerifyPreviousRegistration_ID,
	--  //Registration Number//
	CASE when v_YesNo_RenewalAgentID_Flag=1 then v_putAR_reranumber else n.RERAnumberRegistration END RERAnumberRegistration,
	CASE when v_YesNo_RenewalAgentID_Flag=1 then v_putAR_reranumber_FromDate else n.RERAnumberIssueDate	END RERAnumberIssueDate,
    CASE when v_YesNo_RenewalAgentID_Flag=1 then v_putAR_reranumber_ToDate else n.RERAnumberRegUptoDate	END RERAnumberRegUptoDate,
	--  //Agent ID//
	m.Agent_ID as Agent_ID,
	'' as UserID,
	'' as UserName,
	n.AgentRegDiaryNumber_Name as Agent_RegDiaryNumber_Name,
	0 as Agent_RegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Agent_RegDiaryNumber_Application_Date,
	1 as Agent_LDR_RERAnumber_DiaryNumber_ID,
	1 as Is_YesNo_AgentRegistered_Flag,
	-- //Agent Description//
	udfn_GetAgentName(m.Agent_ID) as Agent_Name,
	udfn_GetDistrictName(m.BusinessPlace_AddressDistrictCode) as Agent_AddressDistrictName,
	CASE when m.Agent_Type = 1 then "Individual" when m.Agent_Type = 2 then "Other Than Individual"	else m.Agent_Type END as Agent_Type,
	m.BusinessPlace_AddressLine1 as Agent_PlaceOfBussiness_AddressLine1,
	m.BusinessPlace_AddressLine2 as Agent_PlaceOfBussiness_AddressLine2,
	udfn_GetDistrictName(m.BusinessPlace_AddressDistrictCode) as Agent_PlaceOfBussiness_District,
	udfn_GetStateName(m.BusinessPlace_AddressStateCode) as Agent_PlaceOfBussiness_State,
	m.BusinessPlace_AddressPIN as Agent_PlaceOfBussiness_PIN,
	m.EmailAddress as Agent_Email_Address,
	m.MobileNumber as Agent_Mobile_PhoneNumber,
	1 as Is_YesNo_AgentDescription_Flag,
	-- //Agent Renewal ID//
	v_getAR_new_RenewalAgent_ID as Related_RenewalAgent_ID,
	v_getAR_new_RenewalYear as Related_RenewalAgent_Year,
	v_getAR_new_RenewalSequence_ID as Renewal_OrderSequence,
	'' as Renewal_OrderSequence_Name,
	'' as Related_RenewalAgentRegDiaryNumber_Name,
	0 as Related_RenewalAgentRegDiaryNumber_Year,
	'0001-01-01 00:00:00.000' as Related_RenewalAgentRegDiaryNumber_Application_Date,
	v_putAR_reranumber as RenewalAgentRegistrationNumber,
	v_putAR_reranumber_FromDate as RenewalAgentRegistrationIssueDate,
	v_putAR_reranumber_ToDate as RenewalAgentRegistrationRegUptoDate,
	0 as Agent_LDR_RenewalRERAnumber_DiaryNumber_ID,
	v_YesNo_RenewalAgentID_Flag as Is_YesNo_ActiveProvider_Flag,
	v_YesNo_RenewalAgentRegistered_Flag as Is_YesNo_RenewalAgentRegistered_Flag,
	-- //Offline Agent Registered Number//
	n.RERAnumberRegistration as OfflineAgentRegistrationNumber,
	n.RERAnumberIssueDate as OfflineAgentRegistrationIssueDate,
	n.RERAnumberRegUptoDate as OfflineAgentRegistrationRegUptoDate,
	m.Agent_ID as ProfileNewCreated_Agent_ID,
