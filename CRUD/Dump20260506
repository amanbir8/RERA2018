CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Project_RERAnumberExtensionRegistration_ForDesk`(      
 p_Project_ID bigint,
 p_Promoter_ID bigint,
 p_FormE_DiaryNumber varchar(100)
)
begin 

declare v_reranumbercnt int;
declare v_reraextensionnumbercnt int;

declare v_ProjectRegDiaryNumber_ID bigint;
declare v_ProjectRegDiaryNumber_Name varchar(50);
declare v_ProjectRegDiaryNumber_NameYear  varchar(50);
declare v_ProjectRegDiaryNumber_tbl_IndexID bigint;
declare v_ProjectRegDiaryNumber_CreatedDate datetime(3);
  
declare v_ProjectRERAnumberRegistration varchar(150);
declare v_ProjectRERAnumberIssueDate datetime(3);
declare v_ProjectRERAnumberRegUptoDate datetime(3);

declare v_PromoterType int(11);
declare v_PromoterWebLink varchar(250);
declare v_PromoterAuthSignFormB varchar(250);


set v_reranumbercnt=0;
set v_reraextensionnumbercnt=0;

select count(*) into v_reranumbercnt from tbl_rera_ldr_project_reranumber_diarynumber 
where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1;

select count(*) into v_reraextensionnumbercnt from tbl_rera_ldr_project_reranumber_extensionform 
where RelatedProject_ID=p_Project_ID and RelatedPromoter_ID=p_Promoter_ID and IsActive=1;
     
if v_reranumbercnt>0 then	
	if v_reraextensionnumbercnt>0 then

		select * from tbl_rera_ldr_project_reranumber_extensionform    
		where RelatedProject_ID=p_Project_ID and RelatedPromoter_ID=p_Promoter_ID and IsActive=1
		order by Project_ExtnRegd_DiaryNumber_IndexID asc;
 
	else    
		-- Promoter Info
		select Flag, WebLink_Promoter_website, First_Name
		into v_PromoterType, v_PromoterWebLink, v_PromoterAuthSignFormB
		from rera_tbl_promoter where Application_id=p_Promoter_ID and IsActive=1 limit 1;
        
		-- Project Diary Number Info
		select Project_RegDiaryNumber_ID, PromoterRegDiaryNumber_Name, PromoterRegDiaryNumber_NameYear, Project_RegDiaryNumber_IndexID, CreatedOn    
		into v_ProjectRegDiaryNumber_ID, v_ProjectRegDiaryNumber_Name, v_ProjectRegDiaryNumber_NameYear, v_ProjectRegDiaryNumber_tbl_IndexID, v_ProjectRegDiaryNumber_CreatedDate
        from tbl_rera_project_regdiarynumber where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1 limit 1;

		-- Project RERA Registration Number Info		
        select RERAnumberRegistration, RERAnumberIssueDate, RERAnumberRegUptoDate
        into v_ProjectRERAnumberRegistration, v_ProjectRERAnumberIssueDate, v_ProjectRERAnumberRegUptoDate
        from tbl_rera_ldr_project_reranumber_diarynumber where Project_ID=p_Project_ID and Promoter_ID=p_Promoter_ID and IsActive=1 limit 1;


		select        
          0 as Project_ExtnRegd_DiaryNumber_IndexID,
		  0 as Project_ExtnRegd_DiaryNumber_ID,
          
