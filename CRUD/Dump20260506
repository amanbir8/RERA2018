	vgetextnregduptodate as RERAnumberExtensionRegUptoDate,
	g.ProjectRegDiaryNumber_Name as ProjectDiaryNumber,
	vgetextndiarynumber as ExtensionRegdDiaryNumber,
	g.ProjectName,
	g.PromoterName,
	g.ProjectAddressDistrict,
	'' as DName,
	g.Extra2 as ProjectType,
    
	p_ApplicationModeFlag as IsApplicationModeFlag,
	p_InputEntry_QuarterYear as InputEntry_QuarterYear,
	p_InputEntry_QuarterName as InputEntry_QuarterName,
	p_RequestRERAcode as InputEntry_RegistrationNumber
    
from (select * from tbl_rera_ldr_project_reranumber_diarynumber where isactive=1 and RERAnumberRegistration like p_RequestRERAcode) g 
left outer join (select * from tbl_rera_project_quarterlyupdate_projectprovider where isactive=1) m
on g.Project_ID=m.ProjectID 
and g.Promoter_ID=m.PromoterID
order by g.RERAnumberRegistration asc
limit 250;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF; 

end ;;
