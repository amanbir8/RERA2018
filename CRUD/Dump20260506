			Select 
			0 as IndexCode,
			JB.Related_Project_ID,
			JB.Related_Promoter_ID,
			JC.Project_DiaryNumber,
			JC.ApplicationDate_IdentifiedOn,
			udfn_GetProjectName(JB.Related_Project_ID) as Project_Name,
			-- '' as Project_Name,
			JB.LastActionEvent_Type as LastActivity_EventAction_Type,
			JB.LastActionEvent_Aggregate as LastActivity_EventAction_Aggregate,
			JB.LastActionEvent_IdentifiedOn as LastActivity_EventAction_IdentifiedOn,
			case
				when JB.ApplicationApprovalDate is null then '0001-01-01 00:00:00'
				else JB.ApplicationApprovalDate
			end as ApplicationApprovalDate,
			case
				when JB.ApprovalFlag = 'Y' then DATEDIFF(JB.ApplicationApprovalDate, JC.ApplicationDate_IdentifiedOn)
				else 'NA'
			end as RegistrationApproval_Days,
			DATEDIFF(JB.LastActionEvent_IdentifiedOn, JC.ApplicationDate_IdentifiedOn) AS LastActionbyRERA_Days,
			case
				when (JB.LastActionEvent_Type in (150005, 150017, 150020, 150023, 150032, 150099)) then 'NA'
				else DATEDIFF(CURDATE(),JC.ApplicationDate_IdentifiedOn)
			end as ApplicationRecipt_Days,
			-- '' as A_column, 
            udfn_GetExtensionProjectIndexForPromoterSideDuration(JB.Related_Project_ID,JB.Related_Promoter_ID) as A_column,
			0 as B_column,
			Now() as C_column,
			Now() as D_column,
			0 as IsApplicationDateFlag,
			0 as IsApplicationModeFlag,
			Now() as InputEntry_FromDate,
			Now() as InputEntry_ToDate,
			0 as IsActive,
			0 as IsDraft,
			'' as CreatedBy,
			Now() as CreatedOn,
			'' as ModifyBy,
			Now() as ModifyOn
			from 
			(
				Select 
				MF.Related_Project_ID,
				MF.Related_Promoter_ID,
				MF.LastActionEvent_IdentifiedOn,
				MF.LastActionEvent_Type,
				MF.LastActionEvent_Aggregate,
				MG.ApplicationApprovalDate,
				MG.ApprovalFlag
				from 
				(
				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as LastActionEvent_IdentifiedOn,
				EventAction_Type as LastActionEvent_Type,
				EventAction_Aggregate as LastActionEvent_Aggregate
				from tbl_rera_project_extensionform_eventaction 
				where isactive=1
				and EventAction_Type in (150007)
                and MONTH(EventAction_IdentifiedOn)=p_InputEntry_Month
			    and YEAR(EventAction_IdentifiedOn)=p_InputEntry_Year				
				) MF
				left outer join
				(
				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as ApplicationApprovalDate,
				'Y' as ApprovalFlag
				from tbl_rera_project_extensionform_eventaction 
				where EventAction_Type=150017
				group by Related_Project_ID
				order by EventAction_IdentifiedOn asc
				) MG
				ON
				MF.Related_Project_ID=MG.Related_Project_ID
				and MF.Related_Promoter_ID=MG.Related_Promoter_ID
			) JB,
			(
				Select Project_DiaryNumber,
				Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as ApplicationDate_IdentifiedOn 
				from tbl_rera_project_extensionform_eventaction 
				group by Related_Project_ID
				order by EventAction_IdentifiedOn asc
			) JC
			where JB.Related_Project_ID=JC.Related_Project_ID
			and JB.Related_Promoter_ID=JC.Related_Promoter_ID		
			order by JC.Project_DiaryNumber asc
            Limit 100;
            
		elseif (p_ApplicationDateFlag = 23) then
		-- Approval Date
			Select 
			0 as IndexCode,
			JB.Related_Project_ID,
			JB.Related_Promoter_ID,
			JC.Project_DiaryNumber,
			JC.ApplicationDate_IdentifiedOn,
			udfn_GetProjectName(JB.Related_Project_ID) as Project_Name,
			-- '' as Project_Name,
			JB.LastActionEvent_Type as LastActivity_EventAction_Type,
			JB.LastActionEvent_Aggregate as LastActivity_EventAction_Aggregate,
			JB.LastActionEvent_IdentifiedOn as LastActivity_EventAction_IdentifiedOn,
			case
				when JB.ApplicationApprovalDate is null then '0001-01-01 00:00:00'
				else JB.ApplicationApprovalDate
			end as ApplicationApprovalDate,
			case
				when JB.ApprovalFlag = 'Y' then DATEDIFF(JB.ApplicationApprovalDate, JC.ApplicationDate_IdentifiedOn)
				else 'NA'
			end as RegistrationApproval_Days,
			DATEDIFF(JB.LastActionEvent_IdentifiedOn, JC.ApplicationDate_IdentifiedOn) AS LastActionbyRERA_Days,
			case
				when (JB.LastActionEvent_Type in (150005, 150017, 150020, 150023, 150032, 150099)) then 'NA'
				else DATEDIFF(CURDATE(),JC.ApplicationDate_IdentifiedOn)
			end as ApplicationRecipt_Days,
			-- '' as A_column, 
            udfn_GetExtensionProjectIndexForPromoterSideDuration(JB.Related_Project_ID,JB.Related_Promoter_ID) as A_column,
			0 as B_column,
			Now() as C_column,
			Now() as D_column,
			0 as IsApplicationDateFlag,
			0 as IsApplicationModeFlag,
			Now() as InputEntry_FromDate,
			Now() as InputEntry_ToDate,
			0 as IsActive,
			0 as IsDraft,
			'' as CreatedBy,
			Now() as CreatedOn,
			'' as ModifyBy,
			Now() as ModifyOn
			from 
			(
				Select 
				MF.Related_Project_ID,
				MF.Related_Promoter_ID,
				MF.LastActionEvent_IdentifiedOn,
				MF.LastActionEvent_Type,
				MF.LastActionEvent_Aggregate,
				MG.ApplicationApprovalDate,
				MG.ApprovalFlag
				from 
				(
				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as LastActionEvent_IdentifiedOn,
				EventAction_Type as LastActionEvent_Type,
				EventAction_Aggregate as LastActionEvent_Aggregate
				from tbl_rera_project_extensionform_eventaction 
				where isactive=1
				) MF,			
				(
				Select Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as ApplicationApprovalDate,
				'Y' as ApprovalFlag
				from tbl_rera_project_extensionform_eventaction 
				where EventAction_Type=150017
				group by Related_Project_ID
				order by EventAction_IdentifiedOn asc
				) MG
				where MF.Related_Project_ID=MG.Related_Project_ID
				and MF.Related_Promoter_ID=MG.Related_Promoter_ID
                and MONTH(MG.ApplicationApprovalDate)=p_InputEntry_Month
			    and YEAR(MG.ApplicationApprovalDate)=p_InputEntry_Year
			) JB,
			(
				Select Project_DiaryNumber,
				Related_Project_ID,
				Related_Promoter_ID,
				EventAction_IdentifiedOn as ApplicationDate_IdentifiedOn 
				from tbl_rera_project_extensionform_eventaction 
				group by Related_Project_ID
				order by EventAction_IdentifiedOn asc
			) JC
			where JB.Related_Project_ID=JC.Related_Project_ID
			and JB.Related_Promoter_ID=JC.Related_Promoter_ID		
			order by JC.Project_DiaryNumber asc
            Limit 100;
			-- '2019-07-07 00:00:00.000' and '2019-08-07 00:00:00.000'
		end if;
	elseif (p_ApplicationModeFlag = 53) then 
	-- Project Completion
		Select     
			0 as IndexCode,
			0 as Related_Project_ID,
			0 as Related_Promoter_ID,
			'' as Project_DiaryNumber,
			'0001-01-01 00:00:00' as ApplicationDate_IdentifiedOn,
			'' as Project_Name,
			0 as LastActivity_EventAction_Type,
			'' as LastActivity_EventAction_Aggregate,
			'0001-01-01 00:00:00' as LastActivity_EventAction_IdentifiedOn,
			'0001-01-01 00:00:00' as ApplicationApprovalDate,
			'0' as RegistrationApproval_Days,
			'0' as LastActionbyRERA_Days,
			'0' as ApplicationRecipt_Days,
			'' as A_column,
			0 as B_column,
			Now() as C_column,
			Now() as D_column,
			0 as IsApplicationDateFlag,
			0 as IsApplicationModeFlag,
			Now() as InputEntry_FromDate,
			Now() as InputEntry_ToDate,
			0 as IsActive,
			0 as IsDraft,
			'' as CreatedBy,
			Now() as CreatedOn,
			'' as ModifyBy,
			Now() as ModifyOn
		from tbl_rera_project_extensionform_eventaction
		where isactive=9
        Limit 100;
	end if;
end if;

IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
