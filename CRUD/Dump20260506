CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_RERA_JointPromoter_RegDiaryNumber`( 
	p_JointPromoter_Confirm_Step_IndexID bigint(20),
	p_JointPromoter_Confirm_Step_ID bigint(20),
	p_Related_JointPromoter_ID bigint(20),
	p_Related_JointPromoter_Type int(11),
	p_Related_JointPromoter_DiaryNumber varchar(150),
	p_Related_JointPromoter_Name varchar(180),
	p_Related_RegistrationNumber varchar(150),
	p_Related_Promoter_DiaryNumber varchar(150),
	p_Related_Promoter_ID bigint(20),
	p_Related_Promoter_Type int(11),
	p_Related_Promoter_Name varchar(180),
	p_Registration_OtherMember_YN_Flag int(11),
	p_Registration_OtherParentEntity_YN_Flag int(11),
	p_Registration_OtherExperience_YN_Flag int(11),
	p_Registration_OtherLitigations_YN_Flag int(11),
	p_Flag int(11),
    p_UserID varchar(150), 
	p_A_column varchar(200),
	p_B_column varchar(200),
	p_C_column varchar(200),
	p_Remarks_IfAny varchar(250),  
	p_IsActive int(11),
	p_IsDraft int(11),
	p_IsLock int(11),
	p_IsFlag int(11),
	p_IsPublicView int(11),
	p_IsConditional int(11),
	p_IsDraftMember int(11),
	p_CreatedBy varchar(50),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(50),
	p_ModifyOn datetime(3),
    out p_Return_JointPromoter_RegDiaryNumber_Name varchar(120)
)
begin

	declare v_GetJointPromoter_RegDiaryNumber_ID bigint;
	declare v_PutJointPromoter_RegDiaryNumber_ID bigint;
    declare v_PutJointPromoter_RegDiaryNumber_Name varchar(60);

	declare v_profileCount int;    
	declare v_getexperiencelitigationsCount int;        
  
  	declare v_Totalprofile Int;  
	declare v_Totalregistered Int;
    declare v_TotalRERAcount Int;
    declare v_mainCount Int;  
    
	declare v_checkExistingJPrmdiaryNumberCount int;
	declare v_GetExistingJPrmRegDiaryNumber_Name varchar(50);
	declare v_GetExistingJPrmRegDiaryNumber_NameYear varchar(50); 
	declare v_GetExistingJPrmRegDiaryNumber_ID varchar(50);

	declare v_checkPromoterDiaryNumberCount int;
	declare v_GetPromoterRegDiaryNumber_Name varchar(50);
	declare v_GetPromoterRegDiaryNumber_NameYear varchar(50); 
	declare v_GetPromoterRegDiaryNumber_ID varchar(50);    
    
	declare v_checkExistingReferenceDiaryNumberID bigint;
    declare v_checkExistingReferenceDiaryNumberName varchar(100);
    declare v_checkExistingReferenceDiaryNumberYear int;
    declare v_checkExistingReferencePromoterID bigint;
	declare v_checkrno int;

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;
 
-- ------------------------- Application_id ------------------------ 
select max(CoPromoter_RegDiaryNumber_ID) into v_GetJointPromoter_RegDiaryNumber_ID from tbl_rera_copromoter_regdiarynumber where CoPromoter_RegDiaryNumber_NameYear=YEAR(NOW());
    
IF (v_GetJointPromoter_RegDiaryNumber_ID IS NULL) THEN         
	set v_PutJointPromoter_RegDiaryNumber_ID=1;      
	set v_PutJointPromoter_RegDiaryNumber_Name=CONCAT('JPRM', CAST(LPAD(v_PutJointPromoter_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));         
ELSE           
	set v_PutJointPromoter_RegDiaryNumber_ID=v_GetJointPromoter_RegDiaryNumber_ID+1;      
	set v_PutJointPromoter_RegDiaryNumber_Name=CONCAT('JPRM', CAST(LPAD(v_PutJointPromoter_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
END IF;

select COUNT(*) into v_profileCount from tbl_rera_copromoter_registrationdetails 
	where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_Promoter_Application_ID=p_Related_Promoter_ID
    and IsActive=1 and IsDraft in (1,5,6) and IsLock=1;
select COUNT(*) into v_getexperiencelitigationsCount from tbl_rera_copromoter_trackrecord_litigations 
	where Related_JointPromoter_ID=p_Related_JointPromoter_ID and Related_Promoter_ID=p_Related_Promoter_ID
    and IsActive=1 and IsDraft in (1,5,6) and IsLock=1;


SELECT COUNT(*) INTO v_Totalprofile FROM rera_tbl_promoter where Application_id=p_Related_Promoter_ID and Flag=p_Related_Promoter_Type and IsActive=1 and IsDraft in (1,5,6);
SELECT COUNT(*) INTO v_Totalregistered FROM tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=p_Related_Promoter_ID and IsActive=1 and IsDraft=1;
SELECT COUNT(*) INTO v_TotalRERAcount FROM tbl_rera_ldr_project_reranumber_diarynumber where Promoter_ID=p_Related_Promoter_ID and IsActive=1 and IsPublicView=1;

if (v_Totalregistered>0 and v_profileCount>0) then      
	set  v_mainCount=1;      
else
	if (v_Totalprofile>0 and v_profileCount>0) then      
		set  v_mainCount=1;      
	else
		set  v_mainCount=0;      
	end if;     
end if;

-- START-101 -- [if (DiaryNumber and RERA Number exits in table) or (DiaryNumber exits in table) or (Profile-ID exits in table) then JointPromoter-DiaryNumber implemented else set Zero] --         
IF (v_mainCount=0)   
THEN
	set v_GetJointPromoter_RegDiaryNumber_ID=0;    
	set v_PutJointPromoter_RegDiaryNumber_Name='NA';    
ELSE

    -- START-102 -- [Check Count Existing JointPromoter Diary Number] -- 
	SELECT COUNT(*) into v_checkExistingJPrmdiaryNumberCount FROM tbl_rera_copromoter_regdiarynumber
	where Related_CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_CoPromoterType_Flag=p_Related_JointPromoter_Type
	and LinkTo_Related_Promoter_ID=p_Related_Promoter_ID
    and IsActive=1;
        
	set v_GetPromoterRegDiaryNumber_Name='0';
	set v_GetPromoterRegDiaryNumber_NameYear='0'; 
	set v_GetPromoterRegDiaryNumber_ID='0';
    
    set v_checkPromoterDiaryNumberCount=v_Totalregistered;
    IF (v_checkPromoterDiaryNumberCount<>0) THEN
		select PromoterRegDiaryNumber_Name, PromoterRegDiaryNumber_NameYear, PromoterRegDiaryNumber_ID 
		into v_GetPromoterRegDiaryNumber_Name, v_GetPromoterRegDiaryNumber_NameYear, v_GetPromoterRegDiaryNumber_ID
		from  tbl_RERA_Promoter_RegDiaryNumber 
		where Promoter_ID=p_Related_Promoter_ID and IsActive=1
        Limit 1;
	END IF;
    
    set v_checkExistingReferenceDiaryNumberID=0; 
	set v_checkExistingReferenceDiaryNumberName='0'; 
	set v_checkExistingReferenceDiaryNumberYear=0; 
	set v_checkExistingReferencePromoterID=0;
    
    IF (v_profileCount<>0) THEN
		select Link_RegDiaryNumber_ID, Link_RegDiaryNumber_Name, Link_RegDiaryNumber_NameYear, Column_B 
		into v_checkExistingReferenceDiaryNumberID, v_checkExistingReferenceDiaryNumberName, v_checkExistingReferenceDiaryNumberYear, v_checkExistingReferencePromoterID
		from  tbl_rera_copromoter_registrationdetails 
		where CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_Promoter_Application_ID=p_Related_Promoter_ID
        and IsActive=1
        Limit 1;
	END IF;
    -- END-102
    
    
	-- START-103 -- INSERT JointPromoter DiaryNumber
	IF v_checkExistingJPrmdiaryNumberCount>0 THEN
    
		-- START-102 -- [Update Previous Record (LOCK)] --
		update tbl_rera_copromoter_regdiarynumber set IsDraft=1, IsLock=1 
		where Related_CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_CoPromoterType_Flag=p_Related_JointPromoter_Type
		and LinkTo_Related_Promoter_ID=p_Related_Promoter_ID
		and IsActive=1;

		-- extract existing code
		select CoPromoter_RegDiaryNumber_Name, CoPromoter_RegDiaryNumber_NameYear, CoPromoter_RegDiaryNumber_ID 
		INTO v_GetExistingJPrmRegDiaryNumber_Name, v_GetExistingJPrmRegDiaryNumber_NameYear, v_GetExistingJPrmRegDiaryNumber_ID
		from  tbl_rera_copromoter_regdiarynumber 
		where Related_CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_CoPromoterType_Flag=p_Related_JointPromoter_Type
		and LinkTo_Related_Promoter_ID=p_Related_Promoter_ID
		and IsActive=1;
        
        update tbl_rera_copromoter_regdiarynumber set IsActive=2 
		where Related_CoPromoter_ApplicationID=p_Related_JointPromoter_ID and Related_CoPromoterType_Flag=p_Related_JointPromoter_Type
		and LinkTo_Related_Promoter_ID=p_Related_Promoter_ID
        and CoPromoter_RegDiaryNumber_Name=v_GetExistingJPrmRegDiaryNumber_Name
		and IsActive=1;
        

		-- ------- Generate New Diary Number (Application Modification)---------- 
		INSERT INTO tbl_rera_copromoter_regdiarynumber        
		(        
			-- CoPromoter_RegDiaryNumber_IndexID,
			CoPromoter_RegDiaryNumber_ID,
