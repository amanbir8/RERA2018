CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetComplaint_OrderJudgement_CaseTypeName`(p_ComplaintID bigint, p_ComplaintType varchar(90),p_ComplaintSNumber bigint) RETURNS varchar(500) CHARSET utf8
BEGIN  
    DECLARE v_ret varchar(500);  
    
    IF (p_ComplaintType='FormTypeM') THEN    
		SELECT
		CaseTypeName INTO v_ret
		FROM tbl_rera_ecourt_complaint_formm_ordersjudgements a, tbl_rera_master_complaint_courtcasetypes b
		WHERE a.eCourt_CaseType_Code=b.CaseType_ID
		AND b.IsActive=1
		AND a.IsActive=1
		AND a.Related_Complaint_ID=p_ComplaintID
		AND a.SerialOrderNumber=p_ComplaintSNumber
        ORDER BY a.OrderDesc_formM_eCourtIndexID DESC LIMIT 1;    
    END IF;
    
	IF (p_ComplaintType='FormTypeN') THEN    
		SELECT
		CaseTypeName INTO v_ret
		FROM tbl_rera_ecourt_complaint_formn_ordersjudgements a, tbl_rera_master_complaint_courtcasetypes b
		WHERE a.eCourt_CaseType_Code=b.CaseType_ID
		AND b.IsActive=1
		AND a.IsActive=1
		AND a.Related_Complaint_ID=p_ComplaintID
		AND a.SerialOrderNumber=p_ComplaintSNumber
        ORDER BY a.OrderDesc_formN_eCourtIndexID DESC LIMIT 1;    
    END IF;
        
	IF (v_ret IS NULL) THEN   
       SET v_ret = 'Unknown Value';
    END IF;
    
    RETURN v_ret;
END ;;
