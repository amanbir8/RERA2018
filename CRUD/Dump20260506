CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_AgentRERAnumber_RegisteredAgent_ByParms`(
p_UserRole varchar(50),
p_DistrictCode varchar(50),
p_AgentName varchar(90),
p_ProjectName varchar(90),
p_AgentRERAnumber varchar(50),
p_AgentType integer,
p_FlagDistrict integer,
p_FlagAgent integer,
p_FlagProject integer,
p_FlagRERAnumber integer
)
begin  

-- SET ONE
if (p_FlagDistrict <> 0 and p_FlagAgent <> 0 and p_FlagRERAnumber <> 0)
then

-- UNIT Level-I START
SELECT
	-- RealEstate-Agent
	m.OfflineAgents_IndexID as Agent_RERAnumber_DiaryNumber_IndexID,
	m.OfflineAgents_ID as Agent_RERAnumber_DiaryNumber_ID,
	m.OfflineAgents_ReferenceNumber as AgentRegDiaryNumber_Name,
	0 as AgentRegDiaryNumber_NameYear,
	m.OfflineAgents_ID as UserID,
	m.A_column as Agent_ID,

	0 as OtherMemDetailsCount,
	0 as DocumentuploadsCount,
	0 as UTotherStateRERACount,
	0 as PaymentsCount,
	0 as AgentDocumentCount,

	m.OfflineAgents_RemarksIfAny as Remarks_IfAny,
	9999 as CurrentEventcode,
	9999 as EventCodeDetails_indexID,
	0 as tbl_RegDiaryNumber_indexID,

	0 as Project_ID,
	'' as Project_Name,
	0 as Promoter_ID,
	'' as Promoter_Name,
	'' as IsAlreadyRegistration,
	'' as ExistingRegistration,
	0 as Agent_Type,
	'' as Agent_FirstName,
	'' as Agent_MiddleName,
	'' as Agent_LastName,
	'' as Organization_Name,
	0 as BComm_AddressStateCode,
	0 as BComm_AddressDistrictCode,
	'' as EmailAddress,
	0 as MobileNumber,

	m.OfflineAgents_RERAregistrationNumber as RERAnumberRegistration,
	m.OfflineAgents_RERAregistrationIssueDate as RERAnumberIssueDate,
	-- m.OfflineAgents_RERAregistrationValidUptoDate as RERAnumberRegUptoDate,
	CASE
		WHEN n.EventAction_Type=290012 THEN n.RenewalAgentRegistrationRegUptoDate
		WHEN n.EventAction_Type is null THEN m.OfflineAgents_RERAregistrationValidUptoDate
		ELSE 'NA'
	END as RERAnumberRegUptoDate,

	m.A_column as Extra2,
	m.B_column as Extra3,
	m.C_column as Extra4,

	m.IsActive,
	m.IsDraft,
	0 as IsDraftHelpDesk,
	0 as IsDraftEvaluation,
	0 as IsDraftSecMember,
	m.IsCertificate as IsDraftMember,

	m.IsPublicView,

	m.CreatedBy,
	m.CreatedOn,
	m.ModifyBy,
	m.ModifyOn,

	m.OfflineAgents_AgentName_OrganizationName as Agent_Name,
	m.OfflineAgents_BusinessPlaceDistrict as Agent_AddressDistrictName,
	m.OfflineAgents_RERAregistrationNumber as Agent_RERAregistrationNumber,

	'' as EventAction_Type,
	'' as EventAction_TypeName,
	m.OfflineAgents_RERAregistrationIssueDate as EventAction_IdentifiedOn,
	'' as EventAction_Aggregate,
	'2015-01-01 00:00:00' as Target_ResolutionDate,
	'' as EventRemarks_IfAny,
	'' as EventAction_Summary,

	'' as AgentRERAcert_FilePath,
	'' as AgentRERAcert_FileName,
	'NA' as AgentRERAcert_ReferenceNumber,
	'2015-01-01 00:00:00' as AgentRERAcert_IssueDate,

	-- Renewal-of-Registration-AGENT
	IFNULL(n.AgentRegRenewal_DiaryNumber_IndexID, 0) as RenewalAgentDiaryNumber_IndexID,
	IFNULL(n.AgentRegRenewal_DiaryNumber_ID, 0) as RenewalAgentDiaryNumber_ID,
	n.RelatedRenewalAgentRegDiaryNumber_Name as RenewalAgentDiaryNumber_Name,
	IFNULL(n.RelatedRenewalAgentRegDiaryNumber_NameYear, 0) as RenewalAgentDiaryNumber_NameYear,

	IFNULL(n.RelatedRenewalAgent_ID, 0) as Related_RenewalAgent_ID,
	IFNULL(n.RelatedRenewalAgent_Year, 0) as Related_RenewalAgent_Year,
	IFNULL(n.RenewalOrderSequence, 0) as Related_RenewalAgent_SequenceID,
	n.UserID as Related_UserID,
	IFNULL(n.RelatedAgent_ID, 0) as Related_Agent_ID,
	IFNULL(n.Agent_Type, 0) as Related_AgentType_ID,

	n.RelatedAgentDiaryNumber_Name as Related_Agent_DiaryNumber,
	n.RERAnumberRegistration as Related_RERAnumberRegistration,
	n.RERAnumberIssueDate as Related_LastRegistrationIssueDate,
	n.RERAnumberRegUptoDate as Related_LastRegistrationRegUptoDate,

	n.OtherMemDetailsCount as m_othermemdetailCount,
	n.DocumentuploadsCount as m_documentuploadCount,
	n.UTotherStateRERACount as m_UTOtherStateRERACount,
	n.PaymentsCount as m_PaymentCount,
	n.AgentDocumentCount as m_AgentDocumentCount,

	n.Remarks_IfAny as m_Remarks_IfAny,
	n.CurrentEventcode as m_CurrentEventcode,
	n.EventCodeDetails_indexID as m_EventCodeDetails_indexID,

	n.IsActive as m_IsActive,
	n.IsActiveProvider as m_IsActiveProvider,
	n.IsDraft as m_IsDraft,
	n.IsLock as m_IsLock,
	n.IsDraftHelpDesk as m_IsDraftHelpDesk,
	n.IsDraftEvaluation as m_IsDraftEvaluation,
	n.IsDraftSecMember as m_IsDraftSecMember,
	n.IsDraftMember as m_IsDraftMember,
	n.IsConditionAnnexureIssued as m_IsConditional,

	n.CreatedBy as m_CreatedBy,
	n.CreatedOn as m_CreatedOn, -- Application Created Date
	n.ModifyBy as m_ModifyBy,
	n.ModifyOn as m_ModifyOn,

	n.Extra1 as m_Extra1,
	n.Extra2 as m_Extra2,
	n.Extra3 as m_Extra3,

	CASE
		WHEN n.Agent_Type = 1 THEN Concat(n.Agent_FirstName, space(1), n.Agent_LastName)
		WHEN n.Agent_Type = 2 THEN n.Organization_Name
		ELSE 'NA'
	END as RenewalAgent_Name,
	'' as RenewalAgent_AddressDistrictName,
	n.RenewalAgentRegistrationNumber as RenewalAgent_RERAregistrationNumber,
	'2015-01-01 00:00:00' as Application_Date,

	n.RenewalAgentRegistrationNumber as RERA_Registration_Number, -- RERAnumberRegistration
	n.RenewalAgentRegistrationIssueDate as RERA_Number_IssueDate, -- RERAnumberIssueDate
	n.RenewalAgentRegistrationRegUptoDate as RERA_Number_RegistrationUptoDate, -- RERAnumberRegUptoDate

	'' as RenewalAgent_RERAcert_FilePath,
	'' as RenewalAgent_RERAcert_FileName,
	'NA' as RenewalAgent_RERAcert_ReferenceNumber,
	NOW() as RenewalAgent_RERAcert_IssueDate,

	-- Advance-Search-Details (Revoke Registration)
	'' as revRERAnumberRegistration,
	'2015-01-01 00:00:00' as revRERAnumberIssueDate,
	'2015-01-01 00:00:00' as revRERAnumberRegUptoDate,
	0 as revIsRenewalRegistration,
	'2015-01-01 00:00:00' as revRERAnumberRenewalRegUptoDate,

	'2015-01-01 00:00:00' as AgentApplicationDate,
	'2015-01-01 00:00:00' as AgentRenewalApplicationDate,

	'' as revAgentName,
	'' as revAgentAddressDistrict,
	'' as revDName,
	0 as revAgentType,
	'' as revRevoke_InfoDetails,
	'' as revRevoke_ReferenceName,
	NOW() as revRevoke_ReferenceDate,
	'' as revRevoke_Category,
	'' as revRevoke_ReciptType,
	'' as revRevoke_Reasons,
	'' as revAgent_DiaryNumber,
	'' as revRenewalAgent_DiaryNumber,
	'' as revRevoke_DiaryNumber,

	-- Manage-Registration-Params
	CASE
	WHEN n.EventAction_Type=290012 THEN
		CASE
		WHEN (n.RenewalAgentRegistrationRegUptoDate < NOW())
			THEN 1 
			ELSE 0  
		END
	WHEN n.EventAction_Type is null THEN
		CASE
		WHEN (m.OfflineAgents_RERAregistrationValidUptoDate < NOW())
			THEN 1 
			ELSE 0 
		END
	ELSE
		0
	END AS IsRegistration_Lapsed,	
	0 as IsRegistration_Withdrawn,
	0 as IsRegistration_Cancelled,
	0 as IsRegistration_Revoked,
	CASE
	WHEN n.EventAction_Type=290012 THEN
		CASE
		WHEN (n.RenewalAgentRegistrationRegUptoDate < NOW())
			THEN 'Lapsed Registration' 
			ELSE ''  
		END
	WHEN n.EventAction_Type is null THEN
		CASE
		WHEN (m.OfflineAgents_RERAregistrationValidUptoDate < NOW())
			THEN 'Lapsed Registration' 
			ELSE '' 
		END
	ELSE
		''
	END AS IsRegistration_Condition,
	n.EventAction_Type as IsRegistration_Flag

from tbl_rera_agent_offlineagents_pendinguploads m

LEFT JOIN

(select a.*,  

c.EventAction_Type,  
c.EventAction_Type as EventAction_TypeName,  
c.EventAction_IdentifiedOn,  
c.EventAction_Aggregate,  
c.Target_ResolutionDate,  
c.Remarks_IfAny as EventRemarks_IfAny,  
c.EventAction_Summary
  
from tbl_rera_ldr_agent_reranumber_renewalregistration a, tbl_rera_authdesk_agent_renewal_eventaction c   
where a.RelatedRenewalAgentRegDiaryNumber_Name=c.RelatedAgent_RenewalDiaryNumber  
and a.RelatedAgent_ID=c.Related_Agent_ID 
and a.RelatedRenewalAgent_ID=Related_RenewalAgent_ID
and a.RenewalOrderSequence=Related_RenewalAgent_SequenceID
and c.IsActive=1  
and a.IsActive=1
and a.IsPublicView=1 
and a.IsActiveProvider=1
and c.EventAction_Type in (290012)
) n
ON 
n.RelatedAgent_ID=m.A_column
where m.isactive=1
and m.IsPublicView=1
and m.CreatedBy<>'J'
and 
(
m.OfflineAgents_RERAregistrationNumber like p_AgentRERAnumber or
m.OfflineAgents_BusinessPlaceDistrict like udfn_GetDistrictName(p_DistrictCode) or
m.OfflineAgents_AgentName_OrganizationName like p_AgentName
)

UNION -- ADD ONLINE and OFFLINE

SELECT 
	-- RealEstate-Agent
	u.Agent_RERAnumber_DiaryNumber_IndexID,
	u.Agent_RERAnumber_DiaryNumber_ID,
	u.AgentRegDiaryNumber_Name,
	u.AgentRegDiaryNumber_NameYear,
	u.UserID,
	u.Agent_ID,

	u.OtherMemDetailsCount,
	u.DocumentuploadsCount,
	u.UTotherStateRERACount,
	u.PaymentsCount,
	u.AgentDocumentCount,
	u.Remarks_IfAny,
	u.CurrentEventcode,
	u.EventCodeDetails_indexID,
	u.tbl_RegDiaryNumber_indexID,
	u.Project_ID,
	u.Project_Name,
	u.Promoter_ID,
	u.Promoter_Name,
	u.IsAlreadyRegistration,
	u.ExistingRegistration,
	u.Agent_Type,
	u.Agent_FirstName,
	u.Agent_MiddleName,
	u.Agent_LastName,
	u.Organization_Name,
	u.BComm_AddressStateCode,
	u.BComm_AddressDistrictCode,
	u.EmailAddress,
	u.MobileNumber,

	u.RERAnumberRegistration,
	u.RERAnumberIssueDate,
	-- u.RERAnumberRegUptoDate,
	CASE
		WHEN v.EventAction_Type=290012 THEN v.RenewalAgentRegistrationRegUptoDate
		WHEN v.EventAction_Type is null THEN u.RERAnumberRegUptoDate
		ELSE 'NA'
	END as RERAnumberRegUptoDate,

	u.Extra2,
	u.Extra3,
	u.Extra4,
	u.IsActive,
	u.IsDraft,
	u.IsDraftHelpDesk,
	u.IsDraftEvaluation,
	u.IsDraftSecMember,
	u.IsDraftMember,
	u.IsPublicView,
	u.CreatedBy,
	u.CreatedOn,
	u.ModifyBy,
	u.ModifyOn,

	u.Agent_Name,
	u.Agent_AddressDistrictName,
	u.Agent_RERAregistrationNumber,

	u.EventAction_Type,
	u.EventAction_TypeName,
	u.EventAction_IdentifiedOn,
	u.EventAction_Aggregate,
	u.Target_ResolutionDate,
	u.EventRemarks_IfAny,
	u.EventAction_Summary,

	u.AgentRERAcert_FilePath,
	u.AgentRERAcert_FileName,
	u.AgentRERAcert_ReferenceNumber,
	u.AgentRERAcert_IssueDate,

	-- Renewal-of-Registration-AGENT
	IFNULL(v.AgentRegRenewal_DiaryNumber_IndexID, 0) as RenewalAgentDiaryNumber_IndexID,
	IFNULL(v.AgentRegRenewal_DiaryNumber_ID, 0) as RenewalAgentDiaryNumber_ID,
	v.RelatedRenewalAgentRegDiaryNumber_Name as RenewalAgentDiaryNumber_Name,
	IFNULL(v.RelatedRenewalAgentRegDiaryNumber_NameYear, 0) as RenewalAgentDiaryNumber_NameYear,

	IFNULL(v.RelatedRenewalAgent_ID, 0) as Related_RenewalAgent_ID,
	IFNULL(v.RelatedRenewalAgent_Year, 0) as Related_RenewalAgent_Year,
	IFNULL(v.RenewalOrderSequence, 0) as Related_RenewalAgent_SequenceID,
	v.UserID as Related_UserID,
	IFNULL(v.RelatedAgent_ID, 0) as Related_Agent_ID,
	IFNULL(v.Agent_Type, 0) as Related_AgentType_ID,

	v.RelatedAgentDiaryNumber_Name as Related_Agent_DiaryNumber,
	v.RERAnumberRegistration as Related_RERAnumberRegistration,
	v.RERAnumberIssueDate as Related_LastRegistrationIssueDate,
	v.RERAnumberRegUptoDate as Related_LastRegistrationRegUptoDate,

	v.OtherMemDetailsCount as m_othermemdetailCount,
	v.DocumentuploadsCount as m_documentuploadCount,
	v.UTotherStateRERACount as m_UTOtherStateRERACount,
	v.PaymentsCount as m_PaymentCount,
	v.AgentDocumentCount as m_AgentDocumentCount,

	v.Remarks_IfAny as m_Remarks_IfAny,
	v.CurrentEventcode as m_CurrentEventcode,
	v.EventCodeDetails_indexID as m_EventCodeDetails_indexID,

