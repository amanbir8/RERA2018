declare v_GetBenchName varchar(50); 

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;


	select PreHearingFixedForName, B_column into v_GetFixedForName, v_GetBenchName
    from tbl_rera_complaint_formm_prehearingdate
    where ComplainantApplicant_RelatedComplaint_ID=p_ComplaintFormM_ID
    and PreHearingDate_ID=p_HearingFormM_ID
	and IsActive in (1,3)
    order by PreHearingDate_IndexID desc
    Limit 1;
	

     
	select *,
    v_GetBenchName as PreHearingBenchName,
    v_GetFixedForName as PreHearingFixedForName
    from tbl_rera_complaint_formm_IntrimOrder    
	where Related_ComplaintID=p_ComplaintFormM_ID 
    and Related_PreHearingDate_ID=p_HearingFormM_ID
	and IsActive=1
	order by CAST(Upload_SerialNumber AS UNSIGNED) desc;
    
    
IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

end ;;
