udfn_GetQUP_Flag_STR(a.Project_ID, 2020, 'FourthQTR') as `DN (2020-IV)`,
udfn_GetQUP_Flag_DATE(a.Project_ID, 2020, 'FourthQTR') as `Submitted Date (2020-IV)`
-- Loop 2018 END

from tbl_rera_ldr_project_reranumber_diarynumber a, tbl_RERA_Project_Registration b
