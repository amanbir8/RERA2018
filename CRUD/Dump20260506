CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_MIS_ProjectFileTimeNoReplyFromPromotersByID`(  
	p_UserRole varchar(50),
    p_ApplicationModeFlag int,
    p_RelatedProjectID bigint,
    p_RelatedPromoterID bigint
)
begin

    DECLARE v_lastaction int;
    DECLARE v_dateoflastaction datetime(3);

if (p_ApplicationModeFlag = 51) then 
-- Project Registration
    Select count(*) into v_lastaction from tbl_rera_project_promoter_eventaction 
	where isactive=1 and 
	Related_Project_ID=p_RelatedProjectID and 
	Related_Promoter_ID=p_RelatedPromoterID and 
	EventAction_Type in (110007,110010,110011,110012);


	Select EventAction_IdentifiedOn into v_dateoflastaction from tbl_rera_project_promoter_eventaction 
	where isactive=1 and 
	Related_Project_ID=p_RelatedProjectID and 
	Related_Promoter_ID=p_RelatedPromoterID;

    
	SELECT 
    0 as IndexCode,
    0 as Related_Project_ID,
    0 as Related_Promoter_ID,
    '' as Project_DiaryNumber,                           
    t1EventAction_IdentifiedOn as FromDate_EventAction_IdentifiedOn,
    t2EventAction_IdentifiedOn as ToDate_EventAction_IdentifiedOn,
	DATEDIFF(t2EventAction_IdentifiedOn,t1EventAction_IdentifiedOn) as NoReplybyPromoters_Days,
    '' as A_column,
    0 as B_column,
    '0001-01-01 00:00:00.000' as C_column,
    '0001-01-01 00:00:00.000' as D_column
	FROM 
	(
		SELECT 
		t1.PromoterEventAction_ID as t1PromoterEventAction_ID,t1.EventAction_Type as t1EventAction_Type,t1.EventAction_IdentifiedOn as t1EventAction_IdentifiedOn, 
		t2.PromoterEventAction_ID as t2PromoterEventAction_ID,t2.EventAction_Type as t2EventAction_Type,
		CASE
			WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction<>0) THEN now()	
			WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction=0) THEN v_dateoflastaction
			ELSE t2.EventAction_IdentifiedOn
		END as t2EventAction_IdentifiedOn
		FROM (
			SELECT PromoterEventAction_ID,
			CASE
				WHEN EventAction_Type = 110007 THEN 110012
				WHEN EventAction_Type = 110010 THEN 110012
				WHEN EventAction_Type = 110011 THEN 110012
				ELSE EventAction_Type
			END as EventAction_Type,
			Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum1 := @rownum1 + 1 AS id
			FROM
			 tbl_rera_project_promoter_eventaction alfabet  , (SELECT @rownum1 := 0) r
			WHERE alfabet.Related_Project_ID=p_RelatedProjectID
			and alfabet.Related_Promoter_ID=p_RelatedPromoterID
			and alfabet.EventAction_Type in (110007,110010,110011,110012,110004)
			ORDER BY
			 alfabet.PromoterEventAction_ID ASC
		) AS t1
		LEFT OUTER JOIN ( 
			SELECT PromoterEventAction_ID,
			CASE
				WHEN EventAction_Type = 110007 THEN 110012
				WHEN EventAction_Type = 110010 THEN 110012
				WHEN EventAction_Type = 110011 THEN 110012
				ELSE EventAction_Type
			END as EventAction_Type,
			Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum2 := @rownum2 + 1 AS id
			FROM
			 tbl_rera_project_promoter_eventaction alfabet  , (SELECT @rownum2 := 0) r
			WHERE alfabet.Related_Project_ID=p_RelatedProjectID
			and alfabet.Related_Promoter_ID=p_RelatedPromoterID
			and alfabet.EventAction_Type in (110007,110010,110011,110012,110004)
			ORDER BY
			 alfabet.PromoterEventAction_ID ASC
		) AS t2
		ON t1.id +1 = t2.id
	) MZ
	where MZ.t1EventAction_Type <> 110004;

elseif (p_ApplicationModeFlag = 52) then 
-- Extension of Registration
	Select count(*) into v_lastaction from tbl_rera_project_extensionform_eventaction 
	where isactive=1 and 
	Related_Project_ID=p_RelatedProjectID and 
	Related_Promoter_ID=p_RelatedPromoterID and 
	EventAction_Type in (150007);


	Select EventAction_IdentifiedOn into v_dateoflastaction from tbl_rera_project_extensionform_eventaction 
	where isactive=1 and 
	Related_Project_ID=p_RelatedProjectID and 
	Related_Promoter_ID=p_RelatedPromoterID;
    

	SELECT
    0 as IndexCode,
    0 as Related_Project_ID,
    0 as Related_Promoter_ID,
    '' as Project_DiaryNumber,
    t1EventAction_IdentifiedOn as FromDate_EventAction_IdentifiedOn,
    t2EventAction_IdentifiedOn as ToDate_EventAction_IdentifiedOn,
	DATEDIFF(t2EventAction_IdentifiedOn,t1EventAction_IdentifiedOn) as NoReplybyPromoters_Days,
    '' as A_column,
    0 as B_column,
    '0001-01-01 00:00:00.000' as C_column,
    '0001-01-01 00:00:00.000' as D_column
	FROM 
	(
		SELECT 
		t1.ProjectExtFormEventAction_ID as t1ProjectExtFormEventAction_ID,t1.EventAction_Type as t1EventAction_Type,t1.EventAction_IdentifiedOn as t1EventAction_IdentifiedOn, 
		t2.ProjectExtFormEventAction_ID as t2ProjectExtFormEventAction_ID,t2.EventAction_Type as t2EventAction_Type,
		CASE
			WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction<>0) THEN now()	
			WHEN (t2.EventAction_IdentifiedOn is null) and (v_lastaction=0) THEN v_dateoflastaction	
			ELSE t2.EventAction_IdentifiedOn
		END as t2EventAction_IdentifiedOn
		FROM (
			SELECT ProjectExtFormEventAction_ID,EventAction_Type,Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum1 := @rownum1 + 1 AS id
			FROM tbl_rera_project_extensionform_eventaction alfabet  , (SELECT @rownum1 := 0) r
			WHERE alfabet.Related_Project_ID=p_RelatedProjectID
			and alfabet.Related_Promoter_ID=p_RelatedPromoterID
			and alfabet.EventAction_Type in (150007,150004)
			ORDER BY alfabet.ProjectExtFormEventAction_ID ASC
		) AS t1
		LEFT OUTER JOIN ( 
			SELECT ProjectExtFormEventAction_ID,EventAction_Type,Related_Promoter_ID,Related_Project_ID,EventAction_IdentifiedOn, @rownum2 := @rownum2 + 1 AS id
			FROM tbl_rera_project_extensionform_eventaction alfabet  , (SELECT @rownum2 := 0) r
			WHERE alfabet.Related_Project_ID=p_RelatedProjectID
			and alfabet.Related_Promoter_ID=p_RelatedPromoterID
			and alfabet.EventAction_Type in (150007,150004)
			ORDER BY alfabet.ProjectExtFormEventAction_ID ASC
		) AS t2
		ON t1.id +1 = t2.id
	) MZ
	where MZ.t1EventAction_Type <> 150004;

elseif (p_ApplicationModeFlag = 53) then 
-- Project Completion
	SELECT
    0 as IndexCode,
    0 as Related_Project_ID,
    0 as Related_Promoter_ID,
    '' as Project_DiaryNumber,
    '0001-01-01 00:00:00.000' as FromDate_EventAction_IdentifiedOn,
    '0001-01-01 00:00:00.000' as ToDate_EventAction_IdentifiedOn,
	0 as NoReplybyPromoters_Days,
    '' as A_column,
    0 as B_column,
    '0001-01-01 00:00:00.000' as C_column,
    '0001-01-01 00:00:00.000' as D_column
	FROM tbl_rera_project_extensionform_eventaction
    WHERE isactive=99;
    
end if;

end ;;
