if v_checkExistingProjectQuarterDiaryNumberCount>0
then
	  -- ------------Update Previous Record (LOCK)-----------
	  update tbl_RERA_Project_Quater_RegDiaryNumber set IsDraft=1 
	  where Promoter_ID=p_Promoter_ID and 
			Project_ID=p_Project_ID and
