  '0001-01-01 00:00:00.000' as CreatedOn,
  'sysadmin' as ModifyBy,
  '0001-01-01 00:00:00.000' as ModifyOn
FROM tbl_rera_master_complaint_prehearingbench  
where IsActive=1
and PreHearingBench_ID=1206
and B_column='YPV'

order by PreHearingBenchName asc;
  
END ;;
