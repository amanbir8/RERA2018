CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formn_bifurcation_agreedetails`(
	p_ComplaintFormN_ID bigint,
	p_ComplaintFormN_DiaryNumber varchar(50),
	p_ComplaintType_MN varchar(50),
    p_BifurcateFormN_ID bigint,
    p_BifurcateType_MN varchar(50),
	p_Flag int,
    p_UserName varchar(50),
    out p_valoutput bigint 
)
BEGIN    
 
 declare v_get_validatecount int;
 declare v_Get_ApplicationForm_Date datetime(3);
 declare v_Get_ApplicationForm_Count int;
 
 declare v_checkBasicRegdNumber int; 
 declare v_Put_FormMN_RelatedComplaintCode varchar(90);
 declare v_Put_BasicComplaintRegDiaryNumber_Name varchar(90);
 declare v_flag_registeredproject varchar(90);
 declare v_ComplaintRegDiaryNumber_IndexID bigint; 
 declare v_ComplaintRegDiaryNumber_ID bigint;
 declare v_ComplaintRegDiaryNumber_Year int;
 declare v_Profile_ID bigint;
 
 declare v_Get_BifurcateForm_ID bigint;  
 declare v_Put_BifurcateForm_ID bigint;  
 declare v_Get_BifurcateDiaryNumber_Name varchar(90);
 declare v_Put_BifurcateDiaryNumber_Name varchar(90);
 
 declare v_get_bifurcatecount int;
 declare v_ret_bifurcatevalue bigint;
 
 
 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

 START TRANSACTION;

SET v_ret_bifurcatevalue=0;
-- Validate ID 
IF (p_BifurcateFormN_ID<>0) THEN

select count(ComplaintRegDiaryNumber_ID) into v_get_validatecount from tbl_rera_complaint_formn_regdiarynumber where FormN_RelatedComplaint_ID=p_BifurcateFormN_ID and IsActive=1;
-- Validate ID (Step-II)
IF (v_get_validatecount = 0) THEN


-- Basic DiaryNumber
select count(ComplaintRegDiaryNumber_ID) into v_checkBasicRegdNumber from tbl_rera_complaint_formn_regdiarynumber
where FormN_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive=1;

set v_Put_FormMN_RelatedComplaintCode='';
set v_Put_BasicComplaintRegDiaryNumber_Name='';
IF (v_checkBasicRegdNumber <> 0)
then
	select ComplaintRegDiaryNumber_IndexID, ComplaintRegDiaryNumber_ID, ComplaintRegDiaryNumber_NameYear, Profile_ID, CONCAT('AdCNo', CAST(LPAD(ComplaintRegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(ComplaintRegDiaryNumber_NameYear as CHAR(50))), ComplaintRegDiaryNumber_Name
	into v_ComplaintRegDiaryNumber_IndexID, v_ComplaintRegDiaryNumber_ID, v_ComplaintRegDiaryNumber_Year, v_Profile_ID, v_Put_FormMN_RelatedComplaintCode, v_Put_BasicComplaintRegDiaryNumber_Name
	from tbl_rera_complaint_formn_regdiarynumber
	where FormN_RelatedComplaint_ID=p_ComplaintFormN_ID and IsActive=1;
	
	select D_column into v_flag_registeredproject from tbl_rera_complaint_formn_details where ComplaintFormN_Code=p_ComplaintFormN_ID and IsActive=1;
	if (v_flag_registeredproject='unregisteredproject')
	then
		set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'UR');
	end if;
	
	set v_Put_FormMN_RelatedComplaintCode=CONCAT(CAST(v_Put_FormMN_RelatedComplaintCode as CHAR(70)), 'BF');
end if;

SELECT count(ComplaintRegDiaryNumber_IndexID) INTO v_Get_ApplicationForm_Count FROM tbl_rera_complaint_formn_regdiarynumber
WHERE FormN_RelatedComplaint_ID=p_ComplaintFormN_ID;

IF (v_Get_ApplicationForm_Count>1) THEN

	SELECT CreatedOn INTO v_Get_ApplicationForm_Date FROM tbl_rera_complaint_formn_regdiarynumber 
	WHERE FormN_RelatedComplaint_ID=p_ComplaintFormN_ID ORDER BY ComplaintRegDiaryNumber_IndexID asc LIMIT 1; 
		
	IF (v_Get_ApplicationForm_Date IS NULL) THEN   
		SET v_Get_ApplicationForm_Date='2018-04-13 00:00:00.000';
	END IF;
    
    -- Clone Copy
	INSERT INTO tbl_rera_complaint_formn_regdiarynumber
	(    
	  -- ComplaintRegDiaryNumber_IndexID,
	  ComplaintRegDiaryNumber_ID,
	  ComplaintRegDiaryNumber_Name,
	  ComplaintRegDiaryNumber_NameYear,
	  FormN_RelatedComplaint_ID,
	  FormN_RelatedComplaint_Code,
	  Profile_ID,
	  User_ID,
	  ComplaintType_MN,
	  IsComplaintComplete,
	  IsPaymentComplete,
	  PaymentTransactionID,
	  PaymentTransactionDate,
	  IsDocumentsComplete,
	  DocumentUploadCount,
	  IsVerificationComplete,
	  ComplaintVerificationDate,
	  CurrentEventcode,
	  EventCodeDetails_indexID,
	  Remarks_IfAny,
	  A_column,
	  B_column,
	  C_column,
	  IsActive,
	  IsDraft,
	  IsLock,
	  IsPublicView,
	  IsDraftHelpDesk,
	  IsDraftEvaluation,
	  IsDraftSecMember,
	  IsDraftMember,
	  CreatedBy,
	  CreatedOn,
	  ModifyBy,
	  ModifyOn
	)
	SELECT 
	  -- ComplaintRegDiaryNumber_IndexID,
	  ComplaintRegDiaryNumber_ID,
	  v_Put_FormMN_RelatedComplaintCode, -- ComplaintRegDiaryNumber_Name,
	  ComplaintRegDiaryNumber_NameYear,
	  p_BifurcateFormN_ID, -- FormN_RelatedComplaint_ID,
	  p_BifurcateFormN_ID, -- FormN_RelatedComplaint_Code,
	  Profile_ID,
	  User_ID,
	  ComplaintType_MN,
	  IsComplaintComplete,
	  IsPaymentComplete,
	  PaymentTransactionID,
	  PaymentTransactionDate,
	  IsDocumentsComplete,
	  DocumentUploadCount,
	  IsVerificationComplete,
	  ComplaintVerificationDate,
	  CurrentEventcode,
	  EventCodeDetails_indexID,
	  Remarks_IfAny,
	  A_column,
	  B_column,
	  C_column,
	  IsActive,
	  IsDraft,
	  IsLock,
	  IsPublicView,
	  IsDraftHelpDesk,
	  IsDraftEvaluation,
	  IsDraftSecMember,
	  IsDraftMember,
	  CreatedBy,
	  v_Get_ApplicationForm_Date, -- CreatedOn,
	  'BifurcateAdmin', -- ModifyBy,
	  NOW() -- ModifyOn
	FROM tbl_rera_complaint_formn_regdiarynumber
	WHERE FormN_RelatedComplaint_ID=p_ComplaintFormN_ID
	and ComplaintType_MN=p_ComplaintType_MN
	and IsActive=1
	Limit 1;
    
ELSE 
	-- Clone Copy
	INSERT INTO tbl_rera_complaint_formn_regdiarynumber
	(    
	  -- ComplaintRegDiaryNumber_IndexID,
	  ComplaintRegDiaryNumber_ID,
	  ComplaintRegDiaryNumber_Name,
	  ComplaintRegDiaryNumber_NameYear,
	  FormN_RelatedComplaint_ID,
	  FormN_RelatedComplaint_Code,
	  Profile_ID,
	  User_ID,
	  ComplaintType_MN,
	  IsComplaintComplete,
	  IsPaymentComplete,
	  PaymentTransactionID,
	  PaymentTransactionDate,
	  IsDocumentsComplete,
	  DocumentUploadCount,
	  IsVerificationComplete,
	  ComplaintVerificationDate,
	  CurrentEventcode,
	  EventCodeDetails_indexID,
	  Remarks_IfAny,
	  A_column,
	  B_column,
	  C_column,
	  IsActive,
	  IsDraft,
	  IsLock,
	  IsPublicView,
	  IsDraftHelpDesk,
	  IsDraftEvaluation,
	  IsDraftSecMember,
	  IsDraftMember,
	  CreatedBy,
	  CreatedOn,
	  ModifyBy,
	  ModifyOn
	)
	SELECT 
	  -- ComplaintRegDiaryNumber_IndexID,
	  ComplaintRegDiaryNumber_ID,
	  v_Put_FormMN_RelatedComplaintCode, -- ComplaintRegDiaryNumber_Name,
	  ComplaintRegDiaryNumber_NameYear,
	  p_BifurcateFormN_ID, -- FormN_RelatedComplaint_ID,
	  p_BifurcateFormN_ID, -- FormN_RelatedComplaint_Code,
	  Profile_ID,
	  User_ID,
	  ComplaintType_MN,
	  IsComplaintComplete,
	  IsPaymentComplete,
	  PaymentTransactionID,
	  PaymentTransactionDate,
	  IsDocumentsComplete,
	  DocumentUploadCount,
	  IsVerificationComplete,
	  ComplaintVerificationDate,
	  CurrentEventcode,
	  EventCodeDetails_indexID,
	  Remarks_IfAny,
	  A_column,
	  B_column,
	  C_column,
	  IsActive,
	  IsDraft,
	  IsLock,
	  IsPublicView,
	  IsDraftHelpDesk,
	  IsDraftEvaluation,
	  IsDraftSecMember,
	  IsDraftMember,
	  CreatedBy,
	  CreatedOn,
	  'BifurcateAdmin', -- ModifyBy,
	  NOW() -- ModifyOn
	FROM tbl_rera_complaint_formn_regdiarynumber
	WHERE FormN_RelatedComplaint_ID=p_ComplaintFormN_ID
	and ComplaintType_MN=p_ComplaintType_MN
	and IsActive=1
	Limit 1;
 
END IF;


-- New Bifurcate Case (ID)
set v_Get_BifurcateDiaryNumber_Name='NA';
set v_Put_BifurcateDiaryNumber_Name='NA';

-- Application ID
select max(CaseBifurcate_ID) into v_Get_BifurcateForm_ID from tbl_rera_complaint_formn_bifurcationdetails where CaseBifurcate_RegDiaryNumber_NameYear=YEAR(NOW());    
IF (v_Get_BifurcateForm_ID IS NULL) then        
  set v_Put_BifurcateForm_ID=1; 
  set v_Get_BifurcateDiaryNumber_Name=CONCAT('BFNo', CAST(LPAD(v_Put_BifurcateForm_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
ELSE         
  set v_Put_BifurcateForm_ID=v_Get_BifurcateForm_ID+1;
  set v_Get_BifurcateDiaryNumber_Name=CONCAT('BFNo', CAST(LPAD(v_Put_BifurcateForm_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
end if;

set v_Put_BifurcateDiaryNumber_Name=CONCAT(v_Get_BifurcateDiaryNumber_Name, ' in ', v_Put_BasicComplaintRegDiaryNumber_Name);


-- Bifurcate RegdDiaryNumber
select count(CaseBifurcate_IndexID) into v_get_bifurcatecount from tbl_rera_complaint_formn_bifurcationdetails 
where ComplaintN_RelatedComplaint_ID=p_ComplaintFormN_ID and RelatedBifurcate_Complaint_ID=p_BifurcateFormN_ID
and Verified_BifurcateFlag=0 and IsDraft=0;

IF (v_get_bifurcatecount<>0) THEN
	-- Set Bifurcation Case ID
    Update tbl_rera_complaint_formn_bifurcationdetails 
    set CaseBifurcate_ID=v_Put_BifurcateForm_ID,
		CaseBifurcate_RegDiaryNumber_IndexName=v_Get_BifurcateDiaryNumber_Name,
		CaseBifurcate_RegDiaryNumber_NameYear=YEAR(NOW()),
		CaseBifurcate_RegDiaryNumber_Name=v_Put_BifurcateDiaryNumber_Name,
		Verified_BifurcateFlag=1, 
		IsDraft=1, 
		Verified_BifurcateDate=NOW(), 
		RelatedOld_RegDiaryNumber_IndexID=v_ComplaintRegDiaryNumber_IndexID, 
		RelatedOld_RegDiaryNumber_ID=v_ComplaintRegDiaryNumber_ID, 
		RelatedOld_RegDiaryNumber_NameYear=v_ComplaintRegDiaryNumber_Year, 
		RelatedOld_Profile_ID=v_Profile_ID,
		RelatedBifurcate_RegDiaryNumber_ID=v_ComplaintRegDiaryNumber_ID,
		RelatedBifurcate_RegDiaryNumber_Name=v_Put_FormMN_RelatedComplaintCode,
		RelatedBifurcate_RegDiaryNumber_NameYear=v_ComplaintRegDiaryNumber_Year,
		RelatedBifurcate_Profile_ID=v_Profile_ID,
        ModifyBy='BifurcateAdmin',
        ModifyOn=NOW()
	where ComplaintN_RelatedComplaint_ID=p_ComplaintFormN_ID 
    and RelatedBifurcate_Complaint_ID=p_BifurcateFormN_ID
    and Verified_BifurcateFlag=0 
    and IsDraft=0
    and CaseBifurcate_IndexID<>0;
    
    -- Bifurcate Case (Success)
    SET v_ret_bifurcatevalue=1001;
END IF;

ELSE
	-- Bifurcate Case (DiaryNumber Exist - Failure)
    SET v_ret_bifurcatevalue=1002;
-- END Validate ID (Step-II)
END IF;

-- END Validate ID
END IF;
 
IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

set p_valoutput=v_ret_bifurcatevalue; 
   
END ;;
DELIMITER ;
