CREATE DEFINER=`sa`@`%` PROCEDURE `usp_update_tbl_rera_agent_CP_FileRearrangementPanel`(
	p_AgentDoc_IndexID bigint(20),
	p_AgentDoc_ID bigint(20),
	p_Agent_ID bigint(20),
	p_AgentRenewal_ID bigint(20),    
    p_User_ID varchar(150),
    p_User_Role varchar(150),
    
	p_AgentDoc_InfoCode int,
	p_AgentDoc_InfoName varchar(250),
	p_AgentDoc_ReferenceNumber varchar(250),
	p_AgentDoc_IssueDate datetime,    
	p_AgentDoc_FileSize varchar(250),
    p_AgentDoc_FileFormat varchar(250),
    p_AgentDoc_FilePath varchar(250),
    p_AgentDoc_FileName varchar(250),
	p_AgentDoc_IsGroup int,
    
	p_Remarks_IfAny varchar(500),    
    p_A_column varchar(250),
    p_B_column varchar(250),
    p_C_column varchar(250),
    p_D_column varchar(250),    
	p_IsActive int,
	p_IsDraft int,
	p_CreatedBy varchar(250),
	p_CreatedOn datetime,
	p_ModifyBy varchar(250),
    p_ModifyOn datetime,    
    
	p_Agent_DiaryNumber varchar(250),
	p_RERA_RegistrationNumber varchar(100),
	p_RERAnumberIssueDate datetime,
	p_RERAnumberRegUptoDate datetime,
	p_Agent_Name varchar(350),
	p_Type_of_Agent varchar(350),
    p_AgentAddressDistrict varchar(250),
	p_IsRERAregisteredAgent int,    
	p_Extra01_column varchar(250),
	p_Extra02_column varchar(250),
    
	p_Application_SearchTypeFlag int,
	p_RERAnumberRegistration_Input varchar(100),
	p_AgentDiaryNumber_Input varchar(100),
	p_IsUpdateModifyFlag_AgentDocument int,
	p_AgentDoc_InfoCode_Input int,
    p_AgentDoc_InfoCode_ConfirmInput int,
    p_AgentDoc_ReferenceNumber_Input varchar(250),
    p_Remarks_IfAny_Input varchar(500),
	out p_valreturn varchar(250)
)
BEGIN

declare val_AgentDoc_IndexID bigint(20);
declare val_AgentDoc_ID bigint(20);
declare val_Agent_ID bigint(20);
declare val_AgentDoc_InfoCode int(11);
declare val_AgentDoc_InfoName varchar(90);
declare val_AgentDoc_ReferenceNumber varchar(90);
declare val_AgentDoc_IssueDate datetime(3);
declare val_AgentDoc_FileSize varchar(50);
declare val_AgentDoc_FileFormat varchar(50);
declare val_AgentDoc_FilePath varchar(250);
declare val_AgentDoc_FileName varchar(250);
declare val_AgentDoc_IsGroup int(11);
declare val_Remarks_IfAny varchar(300);
declare val_A_column varchar(500);
declare val_B_column varchar(50);
declare val_C_column varchar(50);
declare val_IsActive int(11);
declare val_IsDraft int(11);
declare val_CreatedBy varchar(50);
declare val_CreatedOn datetime(3);
declare val_ModifyBy varchar(50);
declare val_ModifyOn datetime(3);

declare var_count int(11);
declare var_message varchar(190);
declare v_Get_AgentPUC_DocumentName_ID bigint(20);
declare v_Put_AgentPUC_DocumentName_ID bigint(20);

declare v_AgentDocMaster_InfoCode int(11); 
declare v_AgentDocMaster_InfoName varchar(90); 

DECLARE `_rollback` BOOL DEFAULT 0;
DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

START TRANSACTION;

set var_message='Error';

select count(AgentDoc_InfoCode) into var_count from tbl_rera_agent_documents
where IsActive=1 and IsDraft in (1,4,5,6)
and AgentDoc_IndexID=p_AgentDoc_IndexID
and AgentDoc_ID=p_AgentDoc_ID
and Agent_ID=p_Agent_ID;

if (var_count <> 0) then
	-- extract record of documents
	select AgentDoc_IndexID, AgentDoc_ID, Agent_ID, AgentDoc_InfoCode, AgentDoc_InfoName, AgentDoc_ReferenceNumber,
	  AgentDoc_IssueDate, AgentDoc_FileSize, AgentDoc_FileFormat, AgentDoc_FilePath, AgentDoc_FileName, AgentDoc_IsGroup, Remarks_IfAny,
	  A_column, B_column, C_column, IsActive, IsDraft, CreatedBy, CreatedOn, ModifyBy, ModifyOn
	into
	  val_AgentDoc_IndexID, val_AgentDoc_ID, val_Agent_ID, val_AgentDoc_InfoCode, val_AgentDoc_InfoName, val_AgentDoc_ReferenceNumber,
	  val_AgentDoc_IssueDate, val_AgentDoc_FileSize, val_AgentDoc_FileFormat, val_AgentDoc_FilePath, val_AgentDoc_FileName, val_AgentDoc_IsGroup, val_Remarks_IfAny,
	  val_A_column, val_B_column, val_C_column, val_IsActive, val_IsDraft, val_CreatedBy, val_CreatedOn, val_ModifyBy, val_ModifyOn
	from tbl_rera_agent_documents where IsActive=1 and IsDraft in (1,4,5,6)
	and AgentDoc_IndexID=p_AgentDoc_IndexID
	and AgentDoc_ID=p_AgentDoc_ID
	and Agent_ID=p_Agent_ID
	Limit 1;
    
    -- get master records
    set v_AgentDocMaster_InfoCode=p_AgentDoc_InfoCode_Input;
	set v_AgentDocMaster_InfoName=val_AgentDoc_InfoName;
    
    SELECT AgentDocMaster_InfoCode, AgentDocMaster_InfoName
    INTO v_AgentDocMaster_InfoCode, v_AgentDocMaster_InfoName
    FROM tbl_rera_master_agent_documents WHERE IsActive=1
    and AgentDocMaster_InfoCode=p_AgentDoc_InfoCode_Input
    Limit 1;
    
    -- Application IndexID
	select max(AgentPUC_DocumentName_ID) into v_Get_AgentPUC_DocumentName_ID from tbl_rera_hdcr_agent_documentnamedetails;
	IF (v_Get_AgentPUC_DocumentName_ID  IS NULL)        
	then        
		SET v_Put_AgentPUC_DocumentName_ID=1001;          
	ELSE         
		SET v_Put_AgentPUC_DocumentName_ID=v_Get_AgentPUC_DocumentName_ID+1;    
	end if;
    
    -- insert history log
	Insert into tbl_rera_hdcr_agent_documentnamedetails
	(    
		-- AgentPUC_DocumentName_IndexID,
		AgentPUC_DocumentName_ID,
		Related_Agent_ID,
		Related_AgentRenewal_ID,        
		RelatedApplicationPUC_ID,
		PUC_DiaryNumber,
		PUC_ReferencePUC_Name,
		PUC_ReferencePUC_Date,
		PUC_RequestCategoryID,
		RERAnumberRegistration,
		AgentDiaryNumber,
		AgentDoc_InfoCode_ChangeTo,
		AgentDoc_InfoName_ChangeTo,
		Account_FormDate,
		Account_ToDate,        
		Approved_AccountDate,
		Approved_AccountBy,
		ACR_AccountDate,
		ACR_AccountBy,
        
		rea_AgentDoc_IndexID,
		rea_AgentDoc_ID,
		rea_Agent_ID,
		rea_AgentDoc_InfoCode,
		rea_AgentDoc_InfoName,
		rea_AgentDoc_ReferenceNumber,
		rea_AgentDoc_IssueDate,
		rea_AgentDoc_FileSize,
		rea_AgentDoc_FileFormat,
		rea_AgentDoc_FilePath,
		rea_AgentDoc_FileName,
		rea_AgentDoc_IsGroup,
		rea_Remarks_IfAny,
		rea_A_column,
		rea_B_column,
		rea_C_column,
		rea_IsActive,
		rea_IsDraft,
		rea_CreatedBy,
		rea_CreatedOn,
		rea_ModifyBy,
		rea_ModifyOn
	)    
	values    
	(    
		-- AgentPUC_DocumentName_IndexID,
		v_Put_AgentPUC_DocumentName_ID, -- AgentPUC_DocumentName_ID,
        p_Agent_ID,
        0, -- Related_AgentRenewal_ID
        0, -- RelatedApplicationPUC_ID,
        '', -- PUC_DiaryNumber,
		'', -- PUC_ReferencePUC_Name,
		'0001-01-01 00:00:00.000', -- PUC_ReferencePUC_Date,
		0, -- PUC_RequestCategoryID,
        p_RERA_RegistrationNumber,
        p_Agent_DiaryNumber,
        p_AgentDoc_InfoCode_Input, -- AgentDoc_InfoCode_ChangeTo,
        v_AgentDocMaster_InfoName, -- AgentDoc_InfoName_ChangeTo,
        val_ModifyOn, -- Account_FormDate,
		NOW(), -- Account_ToDate,        
		NOW(), -- Approved_AccountDate,
        p_CreatedBy, -- 'sysadmin', -- Approved_AccountBy,
        NOW(), -- ACR_AccountDate,
        p_User_ID, -- 'sysadmin', -- ACR_AccountBy,
        
        val_AgentDoc_IndexID, 
        val_AgentDoc_ID, 
        val_Agent_ID, 
        val_AgentDoc_InfoCode, 
        val_AgentDoc_InfoName, 
        val_AgentDoc_ReferenceNumber,
		val_AgentDoc_IssueDate, 
		val_AgentDoc_FileSize, 
        val_AgentDoc_FileFormat, 
        val_AgentDoc_FilePath, 
        val_AgentDoc_FileName, 
        val_AgentDoc_IsGroup, 
        val_Remarks_IfAny,
		val_A_column, 
        val_B_column, 
        val_C_column, 
        val_IsActive, 
        val_IsDraft, 
        val_CreatedBy, 
        val_CreatedOn, 
        val_ModifyBy, 
        val_ModifyOn
	);
    
    -- modify existed documents
	UPDATE tbl_rera_agent_documents 
    SET AgentDoc_InfoCode=p_AgentDoc_InfoCode_Input, AgentDoc_InfoName=v_AgentDocMaster_InfoName, AgentDoc_ReferenceNumber=p_AgentDoc_ReferenceNumber_Input, AgentDoc_IssueDate=NOW(), Remarks_IfAny=p_Remarks_IfAny_Input, C_column='FlagACR', ModifyBy=p_User_ID, ModifyOn=NOW()
    WHERE AgentDoc_IndexID=p_AgentDoc_IndexID
	and AgentDoc_ID=p_AgentDoc_ID
	and Agent_ID=p_Agent_ID
    and AgentDoc_InfoCode=p_AgentDoc_InfoCode
    and IsActive=1 and IsDraft in (1,4,5,6);
        
    set var_message=concat('document ' , v_AgentDocMaster_InfoName);
end if;


set p_valreturn=var_message; 

IF `_rollback` THEN
	set p_valreturn = 'Error';
	ROLLBACK;
ELSE
	COMMIT;
END IF;

END ;;
