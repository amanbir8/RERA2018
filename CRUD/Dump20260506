CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formm_bifurcation_eventdetails`(
	p_ComplaintFormM_ID bigint,
	p_ComplaintFormM_DiaryNumber varchar(50),
	p_ComplaintType_MN varchar(50),
    p_BifurcateFormM_ID bigint,
    p_BifurcateType_MN varchar(50),
	p_Flag int,
    p_UserName varchar(50),
    out p_valoutput bigint 
)
BEGIN    
 
 declare v_get_validatecount int;
 declare v_checkExistingEventCount int;
 declare v_checkExistingBifurcateEventCount int;
 declare v_checkBifurcateEventCount int;
 
 declare v_Get_ComplaintOldDiaryNumber_Name varchar(90);
 declare v_Get_ComplaintNewDiaryNumber_Name varchar(90);
 declare v_Get_BifurcateDiaryNumber_Name varchar(90);
 
 declare v_Get_ReferenceDiaryNumber_Name varchar(90);
 declare v_Get_ReferenceDiaryNumber_RemarksIfAny varchar(400);
 declare v_Put_RefNumber_RemarksIfAny varchar(500);
  
 declare v_get_bifurcatecount int;
 declare v_ret_bifurcatevalue bigint;
 
 
 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

 START TRANSACTION;

SET v_ret_bifurcatevalue=0;
-- Validate ID 
IF (p_ComplaintFormM_ID<>0 and p_BifurcateFormM_ID<>0) THEN

select count(CaseBifurcate_ID) into v_get_bifurcatecount from tbl_rera_complaint_formm_bifurcationdetails 
where ComplaintM_RelatedComplaint_ID=p_ComplaintFormM_ID and RelatedBifurcate_Complaint_ID=p_BifurcateFormM_ID and IsActive=1 and Verified_BifurcateFlag=1 and IsDraft=1 and IsApproved=0;
-- Validate (Step-II)
IF (v_get_bifurcatecount<>0) THEN

  select RelatedOld_RegDiaryNumber_Name, CaseBifurcate_RegDiaryNumber_Name, RelatedBifurcate_RegDiaryNumber_Name
  into v_Get_ComplaintOldDiaryNumber_Name, v_Get_BifurcateDiaryNumber_Name, v_Get_ComplaintNewDiaryNumber_Name
  from tbl_rera_complaint_formm_bifurcationdetails 
  where ComplaintM_RelatedComplaint_ID=p_ComplaintFormM_ID and RelatedBifurcate_Complaint_ID=p_BifurcateFormM_ID
  and IsActive=1 and Verified_BifurcateFlag=1 and IsDraft=1 
  Limit 1;

  SET v_Put_RefNumber_RemarksIfAny='Bifurcate Case';

  -- Event Insert (Complaint Form)
  select COUNT(*) into v_checkExistingEventCount from tbl_rera_complaint_formM_eventaction where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1;
  IF (v_checkExistingEventCount>0) THEN
	-- If record Exist
	select Related_RegDiaryNumber, Remarks_IfAny
    into v_Get_ReferenceDiaryNumber_Name, v_Get_ReferenceDiaryNumber_RemarksIfAny
    from tbl_rera_complaint_formM_eventaction 
    where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1 Limit 1;
    
    SET v_Put_RefNumber_RemarksIfAny=CONCAT('Ref. Number ', CAST(v_Get_BifurcateDiaryNumber_Name as CHAR(50)), ', and ', CAST(v_Get_ReferenceDiaryNumber_RemarksIfAny as CHAR(400)));
    
	update tbl_rera_complaint_formM_eventaction set IsActive=2 where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1 and ComplaintFormM_EventAction_ID<>0;
	INSERT INTO tbl_rera_complaint_formM_eventaction  
	(
		-- ComplaintFormM_EventAction_ID,
		EventAction_Type,
		EventAction_IdentifiedBy,
		EventAction_IdentifiedOn,
		Related_Complaint_ID,
		Related_RegDiaryNumber,
		EventAction_Summary,
		EventAction_Description,
		EventAction_Category,
		EventAction_Aggregate,
		EventAction_Relationship,
		AssignedTo,
		Target_ResolutionDate,
		Target_ResolutionSummary,
		Actual_ResolutionDate,
		ProgressStatus,
		Remarks_IfAny,
		IsActive,
		IsDraft,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	)  
	VALUES  
	(   
		-- ComplaintFormM_EventAction_ID,
		330092,  
		p_UserName,  
		NOW(),    
		p_ComplaintFormM_ID,
		v_Get_ReferenceDiaryNumber_Name, -- v_Get_ComplaintOldDiaryNumber_Name,
		'Case Bifurcated with Reference Diary Number',  
		'Case Bifurcated with Reference Diary Number',  
		'Authority Desk' ,  
		'Case Bifurcated with Reference Diary Number',  
		'Role SystemAdmin',  
		'IT Cell RERA',  
		NOW(),    
		'999',  
		NOW(), 
		'In Process' ,  
		v_Put_RefNumber_RemarksIfAny,  
		1,  
		0,  
		p_UserName,  
		NOW(),    
		'BifurcateAdmin',  
		NOW()  
	);
    
	-- Bifurcate Case (Success)
	SET v_ret_bifurcatevalue=1001;
  END IF; 
  
  
  -- (Step-A) Bifurcate Event Intialize
  select COUNT(*) into v_checkBifurcateEventCount from  tbl_rera_complaint_formM_eventaction where Related_Complaint_ID=p_BifurcateFormM_ID and IsActive=1;
  IF (v_checkBifurcateEventCount = 0) THEN
	INSERT INTO tbl_rera_complaint_formM_eventaction
	(    
	  -- ComplaintFormM_EventAction_ID,
	  EventAction_Type,
	  EventAction_IdentifiedBy,
	  EventAction_IdentifiedOn,
	  Related_Complaint_ID,
	  Related_RegDiaryNumber,
	  EventAction_Summary,
	  EventAction_Description,
	  EventAction_Category,
	  EventAction_Aggregate,
	  EventAction_Relationship,
	  AssignedTo,
	  Target_ResolutionDate,
	  Target_ResolutionSummary,
	  Actual_ResolutionDate,
	  ProgressStatus,
	  Remarks_IfAny,
	  IsActive,
	  IsDraft,
	  CreatedBy,
	  CreatedOn,
	  ModifyBy,
	  ModifyOn
	)
	SELECT 
	  -- ComplaintFormM_EventAction_ID,
	  EventAction_Type,
	  EventAction_IdentifiedBy,
	  EventAction_IdentifiedOn,
	  p_BifurcateFormM_ID, -- Related_Complaint_ID,
	  v_Get_ComplaintNewDiaryNumber_Name, -- Related_RegDiaryNumber,
	  EventAction_Summary,
	  EventAction_Description,
	  EventAction_Category,
	  EventAction_Aggregate,
	  EventAction_Relationship,
	  AssignedTo,
	  Target_ResolutionDate,
	  Target_ResolutionSummary,
	  Actual_ResolutionDate,
	  ProgressStatus,
	  Remarks_IfAny,
	  1, -- IsActive,
	  IsDraft,
	  CreatedBy,
	  CreatedOn,
	  'BifurcateAdmin', -- ModifyBy,
	  ModifyOn
	FROM tbl_rera_complaint_formM_eventaction
	WHERE Related_Complaint_ID=p_ComplaintFormM_ID
    ORDER BY EventAction_IdentifiedOn ASC
	LIMIT 1;
  
  	-- Bifurcate Case (Success)
	SET v_ret_bifurcatevalue=1002;
  END IF;
  
  
  -- (Step-B) Event Insert (Bifurcate Form)
  select COUNT(*) into v_checkExistingBifurcateEventCount from  tbl_rera_complaint_formM_eventaction where Related_Complaint_ID=p_BifurcateFormM_ID and IsActive=1;
  IF (v_checkExistingBifurcateEventCount>0) THEN
	-- If record Exist
	update tbl_rera_complaint_formM_eventaction set IsActive=2 where Related_Complaint_ID=p_BifurcateFormM_ID and IsActive=1 and ComplaintFormM_EventAction_ID<>0;
	INSERT INTO tbl_rera_complaint_formM_eventaction  
	(
		-- ComplaintFormM_EventAction_ID,
		EventAction_Type,
		EventAction_IdentifiedBy,
		EventAction_IdentifiedOn,
		Related_Complaint_ID,
		Related_RegDiaryNumber,
		EventAction_Summary,
		EventAction_Description,
		EventAction_Category,
		EventAction_Aggregate,
		EventAction_Relationship,
		AssignedTo,
		Target_ResolutionDate,
		Target_ResolutionSummary,
		Actual_ResolutionDate,
		ProgressStatus,
		Remarks_IfAny,
		IsActive,
		IsDraft,
		CreatedBy,
		CreatedOn,
		ModifyBy,
		ModifyOn
	)  
	VALUES  
	(  
		-- ComplaintFormM_EventAction_ID,
		330092,  
		p_UserName,  
		NOW(),    
		p_BifurcateFormM_ID,
		v_Get_ComplaintNewDiaryNumber_Name,
		'Case Bifurcated with Reference Diary Number',  
		'Case Bifurcated with Reference Diary Number',  
		'Authority Desk' ,  
		'Case Bifurcated with Reference Diary Number',  
		'Role SystemAdmin',  
		'IT Cell RERA',  
		NOW(),    
		'999',  
		NOW(), 
		'In Process' ,  
		v_Put_RefNumber_RemarksIfAny,  
		1,  
		0,  
		p_UserName,  
		NOW(),    
		'BifurcateAdmin',  
		NOW()  
	);
    
	-- Bifurcate Case (Success)
	SET v_ret_bifurcatevalue=1003;
  END IF;
ELSE
	-- Bifurcate Case (Failure)
	SET v_ret_bifurcatevalue=1999;
-- END Validate (Step-II)
END IF;

-- END Validate ID
END IF;
 
IF `_rollback` THEN
	ROLLBACK;
ELSE
	COMMIT;
END IF;

set p_valoutput=v_ret_bifurcatevalue; 
   
END ;;
