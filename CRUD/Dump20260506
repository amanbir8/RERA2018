	'NA' as C_Column,

	'NA' as Remarks_IfAny,
	0 as IsActive,
	0 as IsDraft,
	'NA' as CreatedBy,
	Now() as CreatedOn,
	'NA' as ModifyBy,
	Now() as ModifyOn
	 
	from tbl_rera_project_promoter_eventaction a
	where a.Related_Project_ID=p_RegPrj_ProjectRegistration_ID 
