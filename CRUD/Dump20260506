CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_AgentRenewal_Count_RegistrationFeePayment`(
	p_Related_Agent_ID bigint,
	p_Related_TypeOfAgent_ID int,
	p_Related_RenewalAgent_ID bigint,
	p_Related_RenewalAgent_SequenceID int,
	p_Related_RenewalAgent_Year int,
	p_Flag int,
	p_UserNam varchar(150)    
)
begin   
  
declare v_countfile bigint; 
declare v_TypeProfile int; 
declare v_statusFlag int;
declare v_submitFlag int;
declare v_getchkFeeRecordsCount int;
declare v_getPaymentAmount bigint;
declare v_getIsLock int;

set v_TypeProfile=1; 
set v_statusFlag=0;
set v_submitFlag=0;
  
select count(*) into v_countfile from tbl_rera_agent_renewal_profile 
where RenewalAgent_ID=p_Related_RenewalAgent_ID
and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID
and RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
and Related_Agent_ID=p_Related_Agent_ID
and Related_Agent_Type=p_Related_TypeOfAgent_ID
and Isactive=1;

if (v_countfile<>0) then
	select Related_Agent_Type into v_TypeProfile from tbl_rera_agent_renewal_profile
	where RenewalAgent_ID=p_Related_RenewalAgent_ID	and RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
	and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID
	and Isactive=1
    order by RenewalAgent_IndexID desc 
    Limit 1;
end if;

select COUNT(*) into v_getchkFeeRecordsCount from tbl_rera_agent_renewal_payment
where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID
and Isactive=1;

if (v_getchkFeeRecordsCount <> 0) then
	select sum(DD_BankersCheque_Amount) into v_getPaymentAmount from tbl_rera_agent_renewal_payment 
    where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
	and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID
	and Isactive=1;
	
    if (v_TypeProfile=1) then
		-- Individual Profile
        if (v_getPaymentAmount>10999) then
			select IsLock into v_getIsLock from tbl_rera_agent_renewal_payment 
			where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
			and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID
			and Isactive=1
            order by RenewalAgentPayment_IndexID desc
 			limit 1; 
        end if;
	end if;
	if (v_TypeProfile=2) then
		-- OtherThan Individual Profile
        if (v_getPaymentAmount>28999) then
			select IsLock into v_getIsLock from tbl_rera_agent_renewal_payment 
			where Related_RenewalAgent_ID=p_Related_RenewalAgent_ID and Related_RenewalOrderSequence=p_Related_RenewalAgent_SequenceID and Related_RelatedRenewalAgent_Year=p_Related_RenewalAgent_Year
			and Related_Agent_ID=p_Related_Agent_ID and Related_Agent_Type=p_Related_TypeOfAgent_ID
			and Isactive=1
            order by RenewalAgentPayment_IndexID desc
 			limit 1;
        end if;
	end if;
    
    -- Start ALGO
	if (v_getIsLock=1) then
		set v_statusFlag=1;
		set v_submitFlag=1;
	else
		if (v_getIsLock=0) then
			set v_statusFlag=1;
			set v_submitFlag=2;
		end if;
	end if;
    -- End ALGO
end if;
  
-- //TypeProfile/statusFlag/submitFlag
Select v_TypeProfile AS TypeProfile, v_statusFlag as statusFlag, v_submitFlag as submitFlag; 
  
end ;;
