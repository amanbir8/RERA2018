/*!50003 CREATE*/ /*!50017 DEFINER=`sa`@`%`*/ /*!50003 TRIGGER utrigger_Rera_Complaint_FormM_EventRecord_INSERT AFTER INSERT ON tbl_rera_complaint_formm_eventaction
  FOR EACH ROW
BEGIN      
     DECLARE v_ComplaintId BigInt;      
     Declare v_ComplaintDiaryNumber varchar(100);   
     Declare v_ComplaintEventType int;   
       
       SET v_ComplaintId=NEW.Related_Complaint_ID;
       SET v_ComplaintDiaryNumber=NEW.Related_RegDiaryNumber;            
       SET v_ComplaintEventType=NEW.EventAction_Type;

 -- Complaint Form-M Details Incomplete File         
 If v_ComplaintEventType = 330007   
 then      
   update tbl_rera_complaint_formm_regdiarynumber set IsDraft=0 where FormM_RelatedComplaint_ID=v_ComplaintId and ComplaintRegDiaryNumber_Name=v_ComplaintDiaryNumber and IsActive=1 and IsLock=0;   
   
   update tbl_rera_complaint_formm_details set IsLock=0 where ComplaintFormM_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_listenclosuresdocuments set IsLock=0 where ComplainantApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_additioncomplainant set IsLock=0 where ComplainantorApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_additionrespondent set IsLock=0 where AdditionRespondentM_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1;
   update tbl_rera_complaint_formm_document_factsofthecase set IsLock=0 where ComplainantApplicant_RelatedComplaintM_ID=v_ComplaintId and IsActive=1 and IsLock=1;
   
   update tbl_rera_complaint_formm_details set IsDraft=4 where ComplaintFormM_ID=v_ComplaintId and IsActive=1 and IsDraft=5; 
   update tbl_rera_complaint_formm_listenclosuresdocuments set IsDraft=4 where ComplainantApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsDraft=5; 
   update tbl_rera_complaint_formm_additioncomplainant set IsDraft=4 where ComplainantorApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsDraft=5; 
   update tbl_rera_complaint_formm_additionrespondent set IsDraft=4 where AdditionRespondentM_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsDraft=5;
   update tbl_rera_complaint_formm_document_factsofthecase set IsDraft=4 where ComplainantApplicant_RelatedComplaintM_ID=v_ComplaintId and IsActive=1 and IsDraft=5;
   
   -- -- Reminder Scheduler (Emails and SMS)
   call usp_insert_tbl_rera_complaint_formm_reminderscheduler_emails(v_ComplaintId, v_ComplaintDiaryNumber, v_ComplaintEventType);
   call usp_insert_tbl_rera_complaint_formm_reminderscheduler_smsgateway(v_ComplaintId, v_ComplaintDiaryNumber, v_ComplaintEventType);
 end if;
 -- Complaint NO reply within 15 days
 If v_ComplaintEventType = 330057   
 then      
   update tbl_rera_complaint_formm_regdiarynumber set IsDraft=1 where FormM_RelatedComplaint_ID=v_ComplaintId and ComplaintRegDiaryNumber_Name=v_ComplaintDiaryNumber and IsActive=1;   
   
   update tbl_rera_complaint_formm_details set IsDraft=1, IsLock=1 where ComplaintFormM_ID=v_ComplaintId and IsActive=1; 
   update tbl_rera_complaint_formm_listenclosuresdocuments set IsDraft=1, IsLock=1 where ComplainantApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1; 
   update tbl_rera_complaint_formm_additioncomplainant set IsDraft=1, IsLock=1 where ComplainantorApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1; 
   update tbl_rera_complaint_formm_additionrespondent set IsDraft=1, IsLock=1 where AdditionRespondentM_RelatedComplaint_ID=v_ComplaintId and IsActive=1;
   update tbl_rera_complaint_formm_document_factsofthecase set IsDraft=1, IsLock=1 where ComplainantApplicant_RelatedComplaintM_ID=v_ComplaintId and IsActive=1;
   
   -- -- Reminder Scheduler (Emails and SMS)
   update tbl_rera_complaint_formm_reminderscheduler_emails set IsActive=2, D_Column=NOW() where RelatedComplaintFormM_ID=v_ComplaintId and IsActive=1 and FormM_Reminder_IndexID <> 0;
   update tbl_rera_complaint_formm_reminderscheduler_smsgateway set IsActive=2, D_Column=NOW() where RelatedComplaintFormM_ID=v_ComplaintId and IsActive=1 and FormM_ReminderSMS_IndexID <> 0;
 end if;
 -- Complaint TRANSFER between M and N (Transfer Request)
 If v_ComplaintEventType = 330063   
 then      
   update tbl_rera_complaint_formm_regdiarynumber set IsPublicView=1 where FormM_RelatedComplaint_ID=v_ComplaintId and ComplaintRegDiaryNumber_Name=v_ComplaintDiaryNumber and IsActive=1 and IsDraft=1;   
   
   update tbl_rera_complaint_formm_details set IsPublicView=1 where ComplaintFormM_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_listenclosuresdocuments set IsPublicView=1 where ComplainantApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_additioncomplainant set IsPublicView=1 where ComplainantorApplicant_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_additionrespondent set IsPublicView=1 where AdditionRespondentM_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsLock=1; 
   update tbl_rera_complaint_formm_document_factsofthecase set IsPublicView=1 where ComplainantApplicant_RelatedComplaintM_ID=v_ComplaintId and IsActive=1 and IsLock=1;
   
   update tbl_rera_complaint_formm_paymentgateway set IsPublicView=1 where PaymentComplaint_RelatedComplainant_ID=v_ComplaintId and isactive=1 and IsLock=1;
   
 end if;
 -- Complaint TRANSFER between M and N (Case Transfered)
 If v_ComplaintEventType = 330064   
 then
	update tbl_rera_complaint_formm_regdiarynumber set IsPublicView=1, IsActive=3 where FormM_RelatedComplaint_ID=v_ComplaintId and IsActive=1 and IsDraft=1; 
      
	Insert Into tbl_rera_complaint_formM_regdiarynumber 
	(
		-- `ComplaintRegDiaryNumber_IndexID`, 
		`ComplaintRegDiaryNumber_ID`, 
		`ComplaintRegDiaryNumber_Name`, 
		`ComplaintRegDiaryNumber_NameYear`, 
		`FormM_RelatedComplaint_ID`, 
