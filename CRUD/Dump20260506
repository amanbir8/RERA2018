  D_column,
  
  IsActive,
  IsDraft,
  CreatedBy,
  CreatedOn,
  ModifyBy,
  ModifyOn
  
from tbl_RERA_Project_Documents    
 where Project_ID=p_Project_ID  and IsActive=1 and IsDraft=1
 and B_column <> 'NPV'
 
union
 
select
  ProjectApproval_IndexID as ProjectDoc_IndexID,
  ProjectApproval_ID as ProjectDoc_ID,
  11 as Promoter_ID,  
  ProjectApprovalRelated_ProjectRegistration_ID as Project_ID,  
  DocumentType_Code as ProjectDoc_InfoCode,
  CASE DocumentType_Name
   when 'Other Document' then CONCAT('Other Document (', A_column , ')')
   else DocumentType_Name
  END as ProjectDoc_InfoName,
  'Project Approval Details' as ProjectDoc_RelatedSectionName,
  CONCAT(DocumentType_CategoryName , ' (' , DocumentType_Status , ')') as ProjectDoc_ReferenceNumber,  
  Date_ApplicationPlannedorExpectedReceipt as ProjectDoc_IssueDate,  
  
  DocumentType_FileSize as ProjectDoc_FileSize,
  DocumentType_FileFormat as ProjectDoc_FileFormat,
  DocumentType_FilePath as ProjectDoc_FilePath,
  DocumentType_FileName as ProjectDoc_FileName,
  999 as ProjectDoc_IsGroup,
  Remarks_IfAny,
  A_column,
  B_column,
  C_column,
  '' as D_column,
  
  IsActive,
  IsDraft,
  CreatedBy,
  CreatedOn,
  ModifyBy,
  ModifyOn
  
from tbl_RERA_Project_ApprovalDetails  
where ProjectApprovalRelated_ProjectRegistration_ID=p_Project_ID   
 and IsActive=1 and IsDraft in (1,6)
 and B_column <> 'NPV'

order by ProjectDoc_RelatedSectionName asc,ProjectDoc_InfoName asc;
   
 end ;;
