set vgetPUC_RegDiaryNumber_IndexID=0;
set vgetPUC_RegDiaryNumber_ID=0;
set vgetPUC_RegDiaryNumber_Name='';
set vgetRelatedApplicationPUC_ID=0;
set vgetPUC_RequestCategoryName='';
set vgetPUC_RequestCategoryID=0;
set vgetPUC_ReferencePUC_Name='';
