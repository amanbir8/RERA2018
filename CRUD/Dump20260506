   SET v_PutAgentDiaryNumber_ID= v_GetAgentDiaryNumber_ID+1;
 end if; 
 
 -- Registration Number and Special Number Logic
 -- A
 Select CONVERT(SUBSTRING(RTRIM(LTRIM(p_RERAnumberRegistration)), 17, 4), UNSIGNED) as GenNumber Into v_GetSequenceCode;
 Select SUBSTRING(RTRIM(LTRIM(p_RERAnumberRegistration)), 8, 3) as TypeNumber Into v_GetAgentStateTypeCode;
 
 set v_PutAgentStateTypeCode='PUN'; 
