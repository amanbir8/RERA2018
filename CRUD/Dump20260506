set v_reranumbercnt=0;

select count(*) into v_reranumbercnt from tbl_rera_ldr_agent_reranumber_renewalregistration
where RelatedAgent_ID=p_AgentID 
and Agent_Type=p_AgentTypeID
and RelatedRenewalAgent_ID=p_RnAgentID
and RenewalOrderSequence=p_RnAgentSeqID
and RelatedRenewalAgent_Year=p_RnAgentYrID
and IsActive=1 and IsDraft=1 
and IsActiveProvider=1 
limit 1;
     
if v_reranumbercnt>0
then
	-- UPDATE CASE
	select 
	AgentRegRenewal_DiaryNumber_IndexID as RenewalAgent_RERAnumber_DiaryNumber_IndexID,
	AgentRegRenewal_DiaryNumber_ID as RenewalAgent_RERAnumber_DiaryNumber_ID,
	RelatedRenewalAgent_ID as Related_RenewalAgent_ID,
    RenewalOrderSequence as Related_RenewalOrderSequence,
	RelatedRenewalAgent_Year as Related_RelatedRenewalAgent_Year,
	RelatedAgent_ID as Related_Agent_ID,
    RelatedRenewalAgentRegDiaryNumber_Name as Related_AgentDiaryNumber_Name,
    Agent_Type as Related_Agent_Type,
    UserID as Related_UserID,
	RERAnumberRegistration as Related_RERAnumberRegistration,
	'0001-01-01 00:00:00.000' as Related_RERAnumberIssueDate,
	'0001-01-01 00:00:00.000' as Related_RERAnumberRegUptoDate,
	
    RelatedAgentDiaryNumber_ID,
	RelatedAgentDiaryNumber_Name,
	RelatedAgentDiaryNumber_NameYear,
	RelatedRenewalAgentRegDiaryNumber_ID,
	RelatedRenewalAgentRegDiaryNumber_Name,
	RelatedRenewalAgentRegDiaryNumber_NameYear,
	UserID,
	
    OtherMemDetailsCount,
	DocumentuploadsCount,
	UTotherStateRERACount,
	PaymentsCount,
	AgentDocumentCount,    
	CurrentEventcode,
	EventCodeDetails_indexID,
	tbl_RegDiaryNumber_indexID,
	ReferenceProject_ID,
	ReferenceProject_Name,
	ReferencePromoter_ID,
	ReferencePromoter_Name,
	
    IsAlreadyRegistration,
	ExistingRegistration,
	Agent_Type,
	Agent_FirstName,
	Agent_LastName,
	Organization_Name,
	
    BComm_AddressLine1,
	BComm_AddressLine2,
	BComm_AddressStateCode,
	BComm_AddressDistrictCode,
	BComm_Address_PIN as BComm_AddressPIN,
	'' as BComm_AddressStateName, 
	'' as BComm_AddressDistrictName,
	EmailAddress,
	MobileNumber,
    
	AuthorizedPerson_FirstName as AuthorizedSignatory_FirstName,
	AuthorizedPerson_LastName as AuthorizedSignatory_LastName,
	AuthorizedPerson_AddressLine1 as AuthorizedSignatory_AddressLine1,
	AuthorizedPerson_AddressLine2 as AuthorizedSignatory_AddressLine2, 
	AuthorizedPerson_State as AuthorizedSignatory_AddressStateCode,
	AuthorizedPerson_District as AuthorizedSignatory_AddressDistrictCode,
	AuthorizedPerson_PIN as AuthorizedSignatory_AddressPIN,
	'' as AuthorizedSignatory_AddressStateName,
	'' as AuthorizedSignatory_AddressDistrictName,
	AuthorizedPerson_Email as AuthorizedSignatory_EmailAddress,
	AuthorizedPerson_Mobile as AuthorizedSignatory_MobileNumber,
	
    RERAnumberRegistration as Agent_RERAnumberRegistration,
	RERAnumberIssueDate as Agent_RERAnumberIssueDate,
	RERAnumberRegUptoDate as Agent_RERAnumberRegUptoDate,
	RenewalAgentRegistrationNumber as LatestRenewalAgent_RERAnumberRegistration,
	RenewalAgentRegistrationIssueDate as LatestRenewalAgent_RERAnumberIssueDate,
	RenewalAgentRegistrationRegUptoDate as LatestRenewalAgent_RERAnumberRegUptoDate,
	
    Remarks_IfAny,
	Extra1,
	Extra2,
	Extra3,
	Extra4,
	
    IsActive,
	IsActiveProvider,
	IsDraft,
	IsLock,
	IsDraftHelpDesk,
	IsDraftEvaluation,
	IsDraftSecMember,
	IsDraftMember,
	IsPublicView,
	IsConditionAnnexureIssued as IsCertificateIssued,
	IsWithdrawn,
	
    CreatedBy,
	CreatedOn,
	ModifyBy,
	ModifyOn
    from tbl_rera_ldr_agent_reranumber_renewalregistration    
	where RelatedAgent_ID=p_AgentID 
	and Agent_Type=p_AgentTypeID
	and RelatedRenewalAgent_ID=p_RnAgentID
	and RenewalOrderSequence=p_RnAgentSeqID
	and RelatedRenewalAgent_Year=p_RnAgentYrID
	and IsActive=1 and IsDraft=1 
	and IsActiveProvider=1
	limit 1;
 
else
	-- NEW ISSUE CASE
	select 
	0 as RenewalAgent_RERAnumber_DiaryNumber_IndexID,
	n.RenewalAgentDiaryNumber_ID as RenewalAgent_RERAnumber_DiaryNumber_ID,
	m.RenewalAgent_ID as Related_RenewalAgent_ID,
	m.RenewalOrderSequence as Related_RenewalOrderSequence,
