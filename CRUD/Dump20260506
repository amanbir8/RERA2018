where IsActive=1 group by ProjectInventoryRelated_ProjectRegistration_ID) q
where p.ProjectConstructionRelated_ProjectRegistration_ID=q.ProjectInventoryRelated_ProjectRegistration_ID
) Z
WHERE Z.ProjectConstructionRelated_ProjectRegistration_ID=Y.Project_ID
ORDER BY Y.Project_ID ASC;


end ;;
