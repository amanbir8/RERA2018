CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_PublicView_ePay_GenerateChallanByID`(  
	p_Related_RegistrationID bigint,
	p_Related_TransactionID bigint,
    p_Related_ChallanNumberID bigint,	
	p_PublicView_Flag int,
    p_Flag int,
	p_UserRole varchar(100)
)
begin 

	declare v_Get_ChallanNumber_ID bigint;
    declare v_Put_ChallanNumber_ID bigint; 
	declare v_Put_ChallanNumber_Name varchar(100);
    declare v_Put_ChallanNumber_value varchar(20);    
    declare v_ChallandetailsCount int;
    declare v_TransactionsCount int;
    
    declare v_PutPaymentGatewayFlag int;
	declare v_PutPaymentGatewayType int;
	declare v_PutPaymentGatewayDesc varchar(100);
        
    -- extract Variable
	declare v_PaymentRegistration_ID bigint(20);
    declare v_Payment_epayTxnID bigint(20);
    declare v_Payment_epayTxnNumber varchar(90);
    declare v_Payment_epayChallanNumber varchar(90);
    declare v_Payment_epayBankNumber varchar(90);    
    declare v_IsTransaction int(11);
    declare v_IsChallan int(11);
    declare v_IsBankGateway int(11);
    declare v_IsVerified int(11);
    declare v_TransactionDate datetime(3);
    declare v_ChallanDate datetime(3);
    declare v_BankGatewayDate datetime(3);
    declare v_VerifiedDate datetime(3);    
    declare v_Payment_GroupID int(11);
    declare v_Payment_GroupName varchar(120);
    declare v_PaymentForCode int(11);
    declare v_PaymentForName varchar(120);
    declare v_ReferenceChoiceName varchar(120);
    declare v_ReferenceChoiceValue varchar(120);  
    declare v_Project_ID bigint(20);
    declare v_Promoter_ID bigint(20);
    declare v_ExtensionProject_ID bigint(20);   
    declare v_Agent_ID bigint(20);
    declare v_RenewalAgent_ID bigint(20);   
    declare v_Complaint_ID bigint(20);
    declare v_Complaint_Type varchar(90);    
    declare v_RERAnumberRegistration varchar(180);    
    declare v_Payment_AccountHead varchar(120);
    declare v_Payment_AccountHead_Flag varchar(120);    
    declare v_Payment_IAgree int(11);

-- DECLARE `_rollback` BOOL DEFAULT 0;
-- DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;

-- START TRANSACTION;


SELECT count(*) into v_TransactionsCount FROM tbl_rera_payment_epay_registration 
WHERE PaymentRegistration_ID=p_Related_RegistrationID and Payment_epayTxnID=p_Related_TransactionID and IsActive=1 and IsChallan=0;

IF(v_TransactionsCount>0) THEN
    -- ------------------------- extract transactions ------------------------
    SELECT 
    PaymentRegistration_ID,
    Payment_epayTxnID,
    Payment_epayTxnNumber,
    Payment_epayChallanNumber,
    Payment_epayBankNumber,    
    IsTransaction,
    IsChallan,
    IsBankGateway,
    IsVerified,
    TransactionDate,
    ChallanDate,
    BankGatewayDate,
    VerifiedDate,    
    Payment_GroupID,
    Payment_GroupName,
    PaymentForCode,
    PaymentForName,
    ReferenceChoiceName,
    ReferenceChoiceValue,    
    Project_ID,
    Promoter_ID,
    ExtensionProject_ID,    
    Agent_ID,
    RenewalAgent_ID,    
    Complaint_ID,
    Complaint_Type,    
    RERAnumberRegistration,    
    Payment_AccountHead,
    Payment_AccountHead_Flag,    
    Payment_IAgree
	INTO    
	v_PaymentRegistration_ID,
    v_Payment_epayTxnID,
    v_Payment_epayTxnNumber,
    v_Payment_epayChallanNumber,
    v_Payment_epayBankNumber,   
    v_IsTransaction,
    v_IsChallan,
    v_IsBankGateway,
    v_IsVerified,
    v_TransactionDate,
    v_ChallanDate,
    v_BankGatewayDate,
    v_VerifiedDate,   
    v_Payment_GroupID,
    v_Payment_GroupName,
    v_PaymentForCode,
    v_PaymentForName,
    v_ReferenceChoiceName,
    v_ReferenceChoiceValue,
    v_Project_ID,
    v_Promoter_ID,
    v_ExtensionProject_ID,  
    v_Agent_ID,
    v_RenewalAgent_ID,  
    v_Complaint_ID,
    v_Complaint_Type,
    v_RERAnumberRegistration,
    v_Payment_AccountHead,
    v_Payment_AccountHead_Flag,
    v_Payment_IAgree

	FROM tbl_rera_payment_epay_registration
	WHERE IsActive=1 and PaymentRegistration_ID=p_Related_RegistrationID and Payment_epayTxnID=p_Related_TransactionID
    Limit 1;
    
	-- ------------------------- Challan Number ------------------------  
    if (v_Payment_GroupID=1) then
		set v_Put_ChallanNumber_value='PRJ';
    elseif (v_Payment_GroupID=2) then
		set v_Put_ChallanNumber_value='REA';
    elseif (v_Payment_GroupID=3) then
		set v_Put_ChallanNumber_value='CMP';
    else
		set v_Put_ChallanNumber_value='OTH';
    end if;
    
	select max(Payment_ChallanNumber_ID) into v_Get_ChallanNumber_ID from tbl_rera_payment_epay_challannumber where Payment_ChallanNumber_Year=YEAR(NOW());        

	IF (v_Get_ChallanNumber_ID IS NULL)          
	then          
	  set v_Put_ChallanNumber_ID=1;      
	  set v_Put_ChallanNumber_Name=CONCAT('ChNo', CAST(LPAD(v_Put_ChallanNumber_ID, 4, '0') as CHAR(50)), v_Put_ChallanNumber_value, CAST(YEAR(NOW()) as CHAR(50))); 
	ELSE           
	  SET v_Put_ChallanNumber_ID=v_Get_ChallanNumber_ID+1;      
	  set v_Put_ChallanNumber_Name=CONCAT('ChNo', CAST(LPAD(v_Put_ChallanNumber_ID, 4, '0') as CHAR(50)), v_Put_ChallanNumber_value, CAST(YEAR(NOW()) as CHAR(50)));
	end if; 

	select count(*) into v_ChallandetailsCount from tbl_rera_payment_epay_challannumber where Related_PaymentRegistration_ID=p_Related_RegistrationID and Related_Payment_epayTxnID=p_Related_TransactionID and IsActive=1;
    

	if(v_TransactionsCount<>0 and v_ChallandetailsCount=0) then
    
		-- --------- Update Transactions Record ---------
        update tbl_rera_payment_epay_registration set IsChallan=1, ChallanDate=NOW(), Payment_epayChallanNumber=v_Put_ChallanNumber_Name, Payment_Status='Challan', IsLock=1
		where PaymentRegistration_ID=p_Related_RegistrationID and Payment_epayTxnID=p_Related_TransactionID and IsActive=1;  
    
		-- --------- Payment Gateway --------------------
        if (v_PaymentForCode=503) then
			set v_PutPaymentGatewayFlag=2;
            set v_PutPaymentGatewayType=1002;
            set v_PutPaymentGatewayDesc='ePay-PENALTY Gateway';
        elseif (v_PaymentForCode=603) then
			set v_PutPaymentGatewayFlag=2;
            set v_PutPaymentGatewayType=1002;
            set v_PutPaymentGatewayDesc='ePay-PENALTY Gateway';
        elseif (v_PaymentForCode=703) then
			set v_PutPaymentGatewayFlag=2;
            set v_PutPaymentGatewayType=1002;
            set v_PutPaymentGatewayDesc='ePay-PENALTY Gateway';
		else
			set v_PutPaymentGatewayFlag=1;
            set v_PutPaymentGatewayType=1001;
            set v_PutPaymentGatewayDesc='ePay-RERA Gateway';
        end if;
        
		-- ------- Generate New Challan Number ---------- 
		INSERT INTO tbl_rera_payment_epay_challannumber        
		(  
		  -- Payment_ChallanNumber_IndexID,
		  Payment_ChallanNumber_ID,
		  Payment_ChallanNumber_Name,
		  Payment_ChallanNumber_Year,
		  Related_PaymentRegistration_ID,
		  Related_Payment_epayTxnID,
		  Payment_epayTxnNumber,
		  Payment_epayChallanNumber,
		  Payment_epayBankNumber,
		  IsTransaction,
		  IsChallan,
		  IsBankGateway,
		  IsVerified,
		  TransactionDate,
		  ChallanDate,
		  BankGatewayDate,
		  VerifiedDate,
		  PaymentGatewayFlag,
		  PaymentGatewayType,
		  PaymentGatewayDesc,
		  Project_ID,
		  Promoter_ID,
		  ExtensionProject_ID,
		  Agent_ID,
		  RenewalAgent_ID,
		  Complaint_ID,
		  Complaint_Type,
		  RegistrationNumber,
		  ExtraA,
		  ExtraB,
		  ExtraC,
		  Remarks_IfAny,
		  IsActive,
		  IsDraft,
		  IsLock,
		  IsDraftHelpDesk,
		  IsDraftMember,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		)        
		VALUES        
		( 
			-- Payment_ChallanNumber_IndexID,
			v_Put_ChallanNumber_ID,
			v_Put_ChallanNumber_Name,
			YEAR(NOW()),
			p_Related_RegistrationID,
			p_Related_TransactionID,
			v_Payment_epayTxnNumber,
			v_Put_ChallanNumber_Name, -- v_Payment_epayChallanNumber
			v_Payment_epayBankNumber,
			1, -- IsTransaction,
			1, -- IsChallan,
			v_IsBankGateway,
			v_IsVerified,
			v_TransactionDate,
			NOW(), -- ChallanDate,
			'0001-01-01 00:00:00.000', -- BankGatewayDate,
			'0001-01-01 00:00:00.000', -- VerifiedDate,
			v_PutPaymentGatewayFlag, -- PaymentGatewayFlag,
			v_PutPaymentGatewayType, -- PaymentGatewayType,
			v_PutPaymentGatewayDesc, -- PaymentGatewayDesc,
			v_Project_ID,
			v_Promoter_ID,
			v_ExtensionProject_ID,
			v_Agent_ID,
			v_RenewalAgent_ID,
			v_Complaint_ID,
			v_Complaint_Type,
			v_RERAnumberRegistration,
			'', -- ExtraA,
			'', -- ExtraB,
			'', -- ExtraC,
			concat(v_Payment_GroupName, ',',v_ReferenceChoiceName, ',',v_ReferenceChoiceValue) , -- Remarks_IfAny,
			1, -- IsActive,
			1, -- IsDraft,
			1, -- IsLock,
			0, -- IsDraftHelpDesk,
			1, -- IsDraftMember,
			'user', -- CreatedBy,
			NOW(), -- CreatedOn,
			'user', -- ModifyBy,
			NOW() -- ModifyOn
		); 
    end if;
    
    
    -- Case - Challan Exist
	SELECT 
    p.PaymentRegistration_IndexID AS p_PaymentRegistration_IndexID,
    p.PaymentRegistration_ID AS p_PaymentRegistration_ID,
    p.Payment_epayTxnID AS p_Payment_epayTxnID,
    p.Payment_epayTxnNumber AS p_Payment_epayTxnNumber,
    p.Payment_epayTxnYear AS p_Payment_epayTxnYear,
    p.Payment_epayChallanNumber AS p_Payment_epayChallanNumber,
    p.Payment_epayBankNumber AS p_Payment_epayBankNumber,
    p.IsTransaction AS p_IsTransaction,
    p.IsChallan AS p_IsChallan,
    p.IsBankGateway AS p_IsBankGateway,
    p.IsVerified AS p_IsVerified,
    p.TransactionDate AS p_TransactionDate,
    p.ChallanDate AS p_ChallanDate,
    p.BankGatewayDate AS p_BankGatewayDate,
    p.VerifiedDate AS p_VerifiedDate,
    p.Payment_GroupID AS p_Payment_GroupID,
    p.Payment_GroupName AS p_Payment_GroupName,
    p.PaymentForCode AS p_PaymentForCode,
    p.PaymentForName AS p_PaymentForName,
    p.ReferenceChoiceCode AS p_ReferenceChoiceCode,
    p.ReferenceChoiceName AS p_ReferenceChoiceName,
    p.ReferenceChoiceValue AS p_ReferenceChoiceValue,
    p.Project_ID AS p_Project_ID,
    p.Promoter_ID AS p_Promoter_ID,
    p.ExtensionProject_ID AS p_ExtensionProject_ID,
    p.TypeOfProject AS p_TypeOfProject,
    p.Project_Name AS p_Project_Name,
    p.Promoter_Name AS p_Promoter_Name,
    p.ProjectAddress_DistrictCode AS p_ProjectAddress_DistrictCode,
    p.ProjectAddress_DistrictName AS p_ProjectAddress_DistrictName,
    p.Agent_ID AS p_Agent_ID,
    p.RenewalAgent_ID AS p_RenewalAgent_ID,
    p.Agent_Name AS p_Agent_Name,
    p.Agent_TypeID AS p_Agent_TypeID,
    p.Agent_TypeName AS p_Agent_TypeName,
    p.AgentAddress_DistrictCode AS p_AgentAddress_DistrictCode,
    p.AgentAddress_DistrictName AS p_AgentAddress_DistrictName,
    p.Complaint_ID AS p_Complaint_ID,
    p.Complaint_Type AS p_Complaint_Type,
    p.Complaint_Number AS p_Complaint_Number,
    p.Complainant_Name AS p_Complainant_Name,
    p.ComplaintAgainst_Code AS p_ComplaintAgainst_Code,
    p.ComplaintAgainst_Name AS p_ComplaintAgainst_Name,
    p.ComplaintProject_ID AS p_ComplaintProject_ID,
    p.ComplaintAdvocate_Code AS p_ComplaintAdvocate_Code,
    p.ComplaintAdvocate_Name AS p_ComplaintAdvocate_Name,
    p.RERAnumberRegistration AS p_RERAnumberRegistration,
    p.RERAnumberIssueDate AS p_RERAnumberIssueDate,
    p.RERAnumberRegUptoDate AS p_RERAnumberRegUptoDate,
    p.PartyName AS p_PartyName,
    p.PaymentReferenceID AS p_PaymentReferenceID,
    p.PaymentReferenceName AS p_PaymentReferenceName,
    p.BenchName AS p_BenchName,
    p.BenchOrderNumber AS p_BenchOrderNumber,
    p.Payment_Amount AS p_Payment_Amount,
    p.Payment_AmountWords AS p_Payment_AmountWords,
    p.Payment_FilingDate AS p_Payment_FilingDate,
    p.Payment_AccountHead AS p_Payment_AccountHead,
    p.Payment_AccountHead_Flag AS p_Payment_AccountHead_Flag,
    p.Bank_Name AS p_Bank_Name,
    p.Bank_Charges AS p_Bank_Charges,
    p.Payment_EmailAddress AS p_Payment_EmailAddress,
    p.Payment_MobileNumber AS p_Payment_MobileNumber,
    p.Remarks_IfAny AS p_Remarks_IfAny,
    p.Payment_IAgree AS p_Payment_IAgree,
    p.Payment_Status AS p_Payment_Status,
    p.Payment_ErrorMessage AS p_Payment_ErrorMessage,
    p.A_column AS p_A_column,
    p.B_column AS p_B_column,
    p.C_column AS p_C_column,
    p.IsActive AS p_IsActive,
    p.IsDraft AS p_IsDraft,
    p.IsLock AS p_IsLock,
    p.CreatedBy AS p_CreatedBy,
    p.CreatedOn AS p_CreatedOn,
    p.ModifyBy AS p_ModifyBy,
    p.ModifyOn AS p_ModifyOn,
	  
	q.Payment_ChallanNumber_IndexID,
	q.Payment_ChallanNumber_ID,
	q.Payment_ChallanNumber_Name,
	q.Payment_ChallanNumber_Year,
	q.Related_PaymentRegistration_ID,
	q.Related_Payment_epayTxnID,
	q.Payment_epayTxnNumber,
	q.Payment_epayChallanNumber,
	q.Payment_epayBankNumber,
	q.IsTransaction,
	q.IsChallan,
	q.IsBankGateway,
	q.IsVerified,
	q.TransactionDate,
	q.ChallanDate,
	q.BankGatewayDate,
	q.VerifiedDate,
	q.PaymentGatewayFlag,
	q.PaymentGatewayType,
	q.PaymentGatewayDesc,
	q.Project_ID,
	q.Promoter_ID,
	q.ExtensionProject_ID,
	q.Agent_ID,
	q.RenewalAgent_ID,
	q.Complaint_ID,
	q.Complaint_Type,
	q.RegistrationNumber,
	q.ExtraA,
	q.ExtraB,
	q.ExtraC,
	q.Remarks_IfAny,
	q.IsActive,
	q.IsDraft,
	q.IsLock,
	q.IsDraftHelpDesk,
	q.IsDraftMember,
	q.CreatedBy,
	q.CreatedOn,
	q.ModifyBy,
	q.ModifyOn

	FROM tbl_rera_payment_epay_registration p, tbl_rera_payment_epay_challannumber q
	WHERE p.IsActive=1 and q.IsActive=1 and p.Payment_IAgree=1
	and q.Related_PaymentRegistration_ID=p.PaymentRegistration_ID
	and q.Related_Payment_epayTxnID=p.Payment_epayTxnID
    and p.PaymentRegistration_ID=p_Related_RegistrationID
    and p.Payment_epayTxnID=p_Related_TransactionID
    -- and q.Payment_ChallanNumber_ID=p_Related_ChallanNumberID
	order by p.PaymentRegistration_IndexID asc
    Limit 1;
    
    
ELSE

	-- Case - Challan NOT Exist
	SELECT 
	p.PaymentRegistration_IndexID AS p_PaymentRegistration_IndexID,
    p.PaymentRegistration_ID AS p_PaymentRegistration_ID,
    p.Payment_epayTxnID AS p_Payment_epayTxnID,
