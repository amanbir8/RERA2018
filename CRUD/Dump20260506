CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_project_completioncertificate_regdiarynumber`(
  p_ProjectCompletion_IndexID bigint(20),
  p_ProjectCompletion_ID bigint(20),
  p_Promoter_ID bigint(20),
  p_Project_ID bigint(20),
  p_User_ID varchar(50),
  p_RERAnumberRegistration varchar(200),
  p_RERAnumberIssueDate datetime,
  p_RERAnumberRegUptoDate datetime,
  p_IsExtensionRegistration int,
  p_RERAnumberExtensionRegUptoDate datetime,
  p_ProjectDiaryNumber varchar(250),
  p_ExtensionRegdDiaryNumber varchar(250),
  p_ProjectName varchar(250),
  p_PromoterName varchar(250),
  p_ProjectAddressDistrict varchar(250),
  p_DName varchar(250),
  p_ProjectType varchar(250),
  p_PCC_InfoDetails varchar(250),
  p_PCC_IssueAuthority varchar(250),
  p_PCC_ReferenceName varchar(250),
  p_PCC_ReferenceDate datetime,
  p_PCC_CertificateType varchar(200),
  p_PCC_CertificateStatus varchar(200),
  p_PCC_ReceiptDatePlanned_DateExpected datetime,
  p_PCC_ReciptType varchar(200),
  p_RemarksIfAny varchar(250),
  p_Extra1 varchar(250),
  p_Extra2 varchar(250),
  p_Extra3 varchar(250),
  p_Extra4 varchar(250),
  p_Extra5 varchar(250),
  p_IsActive int,
  p_IsDraft int,
  p_IsLock int,
  p_IsApproval int,
  p_IsConditional int,
  p_IsPublicView int,
  p_CreatedBy varchar(50),
  p_CreatedOn datetime(3),
  p_ModifyBy varchar(50),
  p_ModifyOn datetime(3),
  out p_valreturn varchar(150)          
)
begin        
  
	declare v_GetPCC_RegDiaryNumber_ID bigint; 
    declare v_PutPCC_RegDiaryNumber_ID bigint; 
	declare v_PutPCC_RegDiaryNumber_Name varchar(100);
    
    declare v_PCCdetailsCount int;
    declare v_PCCdocumentsCount int;
    declare v_mainCount Int; 
    
	declare v_checkExistingPCCdiarynumberCount int;
    
	declare v_GetExistingForDeskPCCdiaryNumber_Name varchar(120);
	declare v_GetExistingForDeskPCCdiaryNumber_NameYear varchar(50); 
	declare v_GetExistingForDeskPCCdiaryNumber_ID varchar(50);
  
    declare v_checkExistingEventCount int;
    declare v_verifyPCCdetailsCount int;
    
    declare v_GetProjectCompletion_ID bigint;
    declare v_PutProjectCompletion_ID bigint;
    declare v_verifyProjectCompletion_ID bigint;
    

 DECLARE `_rollback` BOOL DEFAULT 0;
 DECLARE CONTINUE HANDLER FOR SQLEXCEPTION SET `_rollback` = 1;
 
START TRANSACTION;
 
	-- ------------------------- DiaryNumber ------------------------            
	select max(PCC_RegDiaryNumber_ID) into v_GetPCC_RegDiaryNumber_ID from tbl_rera_project_completioncertificate_regdiarynumber where PCC_RegDiaryNumber_NameYear=YEAR(NOW());        

	IF (v_GetPCC_RegDiaryNumber_ID IS NULL)          
	then          
	set v_PutPCC_RegDiaryNumber_ID=1;      
	set v_PutPCC_RegDiaryNumber_Name=CONCAT('CCNo', CAST(LPAD(v_PutPCC_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50))); 
	ELSE           
	SET v_PutPCC_RegDiaryNumber_ID=v_GetPCC_RegDiaryNumber_ID+1;      
	set v_PutPCC_RegDiaryNumber_Name=CONCAT('CCNo', CAST(LPAD(v_PutPCC_RegDiaryNumber_ID, 4, '0') as CHAR(50)), CAST(YEAR(NOW()) as CHAR(50)));
	end if; 
 
	-- select count(*) into v_PCCdetailsCount from tbl_rera_project_completiondetails where ComplaintFormM_ID=p_ComplaintFormM_ID and IsActive=1;
    set v_PCCdetailsCount=1;
	set v_PCCdocumentsCount=1; 

-- ---STARTS--------check PCC details and documents if not exits then no Diary Number implemented--------         
if v_PCCdetailsCount>0 and v_PCCdocumentsCount>0    
then      
	set v_mainCount=1;      
else    
	set v_mainCount=0;      
end if; 
    
	-- ---------------if exist then Diary Number implemented only--------         
	if v_mainCount=0    
	then     
	  set v_PutPCC_RegDiaryNumber_ID=0;    
	  set v_PutPCC_RegDiaryNumber_Name=0;    
	else  
          -- -------Check Count Existing Diary Number----------		  
		  select COUNT(*) into v_checkExistingPCCdiarynumberCount from  tbl_rera_project_completioncertificate_regdiarynumber 
		  where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1; 
		  
		  if v_checkExistingPCCdiarynumberCount>0
		  then
			  -- ------------Update Previous Record (LOCK)-----------
			  update tbl_rera_project_completioncertificate_regdiarynumber set IsDraft=1 
			  where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1;
  
			  select PCC_RegDiaryNumber_ID, PCC_RegDiaryNumber_Name, PCC_RegDiaryNumber_NameYear
			  into v_GetExistingForDeskPCCdiaryNumber_ID, v_GetExistingForDeskPCCdiaryNumber_Name, v_GetExistingForDeskPCCdiaryNumber_NameYear
			  from tbl_rera_project_completioncertificate_regdiarynumber 
			  where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1;  
		  
			  update tbl_rera_project_completioncertificate_regdiarynumber set IsActive=2
			  where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERA_RegistrationNumber=p_RERAnumberRegistration
              and PCC_RegDiaryNumber_Name=v_GetExistingForDeskPCCdiaryNumber_Name and IsActive=1;	  
		  
		  
			  -- ------- Generate New Diary Number (Application Modification)---------- 
			  INSERT INTO tbl_rera_project_completioncertificate_regdiarynumber        
			  (  
				-- PCC_RegDiaryNumber_IndexID,
				PCC_RegDiaryNumber_ID,
				PCC_RegDiaryNumber_Name,
				PCC_RegDiaryNumber_NameYear,
				UserID,
				Promoter_ID,
				Project_ID,
				RERA_RegistrationNumber,
				PaymentDetailsCount,
				ProjectCompletionCertificateCount,
				IsRegistration,
				CurrentEventcode,
				EventCodeDetails_indexID,
				Extra1,
				Extra2,
				Extra3,
				Extra4,
				Remarks_IfAny,
				IsActive,
				IsDraft,
				IsDraftHelpDesk,
				IsDraftEvaluation,
				IsDraftSecMember,
				IsDraftMember,
				CreatedBy,
				CreatedOn,
				ModifyBy,
				ModifyOn
			  )        
			  VALUES        
			  ( 
				-- PCC_RegDiaryNumber_IndexID,
				v_GetExistingForDeskPCCdiaryNumber_ID, 
				v_GetExistingForDeskPCCdiaryNumber_Name, 
				v_GetExistingForDeskPCCdiaryNumber_NameYear,
				p_User_ID,
				p_Promoter_ID,
				p_Project_ID,
				p_RERAnumberRegistration,
				0,  -- PaymentDetailsCount,
				0,  -- ProjectCompletionCertificateCount,
				1,  -- IsRegistration,
				0,  -- CurrentEventcode,
				0,  -- EventCodeDetails_indexID,
				'', -- Extra1,
				'', -- Extra2,
				'', -- Extra3,
				'', -- Extra4,
				p_RemarksIfAny,
				1, -- IsActive,
				1, -- IsDraft,
				0, -- IsDraftHelpDesk,
				0, -- IsDraftEvaluation,
				0, -- IsDraftSecMember,
				0, -- IsDraftMember,
				p_CreatedBy,
				NOW(), -- p_CreatedOn,
				p_ModifyBy,
				NOW() -- p_ModifyOn
			  );
          else
			-- ------- Generate New Diary Number (NEW APPLICATIONS)---------- 
			INSERT INTO tbl_rera_project_completioncertificate_regdiarynumber        
			  (  
				-- PCC_RegDiaryNumber_IndexID,
				PCC_RegDiaryNumber_ID,
				PCC_RegDiaryNumber_Name,
				PCC_RegDiaryNumber_NameYear,
				UserID,
				Promoter_ID,
				Project_ID,
				RERA_RegistrationNumber,
				PaymentDetailsCount,
				ProjectCompletionCertificateCount,
				IsRegistration,
				CurrentEventcode,
				EventCodeDetails_indexID,
				Extra1,
				Extra2,
				Extra3,
				Extra4,
				Remarks_IfAny,
				IsActive,
				IsDraft,
				IsDraftHelpDesk,
				IsDraftEvaluation,
				IsDraftSecMember,
				IsDraftMember,
				CreatedBy,
				CreatedOn,
				ModifyBy,
				ModifyOn
			  )
            VALUES        
			  ( 
				-- PCC_RegDiaryNumber_IndexID,
                v_PutPCC_RegDiaryNumber_ID, -- PCC_RegDiaryNumber_ID
                v_PutPCC_RegDiaryNumber_Name, -- PCC_RegDiaryNumber_Name
				YEAR(NOW()), -- PCC_RegDiaryNumber_NameYear,
				p_User_ID,
				p_Promoter_ID,
				p_Project_ID,
				p_RERAnumberRegistration,
				0,  -- PaymentDetailsCount,
				0,  -- ProjectCompletionCertificateCount,
				1,  -- IsRegistration,
				0,  -- CurrentEventcode,
				0,  -- EventCodeDetails_indexID,
				'', -- Extra1,
				'', -- Extra2,
				'', -- Extra3,
				'', -- Extra4,
				p_RemarksIfAny,
				1, -- IsActive,
				1, -- IsDraft,
				0, -- IsDraftHelpDesk,
				0, -- IsDraftEvaluation,
				0, -- IsDraftSecMember,
				0, -- IsDraftMember,
				p_CreatedBy,
				NOW(), -- p_CreatedOn,
				p_ModifyBy,
				NOW() -- p_ModifyOn
			  );
	end if;
	-- -------------------------------       
        
	-- ---------EVENT INSERT -------------
	select COUNT(*) into v_checkExistingEventCount from tbl_rera_project_completioncertificate_eventaction 
	where Related_Promoter_ID=p_Promoter_ID and Related_Project_ID=p_Project_ID 
	and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1;

	if v_checkExistingEventCount>0
	then
		update tbl_rera_project_completioncertificate_eventaction set IsActive=2 
		where Related_Promoter_ID=p_Promoter_ID and Related_Project_ID=p_Project_ID 
		and RERA_RegistrationNumber=p_RERAnumberRegistration and IsActive=1;
  
  
		INSERT INTO tbl_rera_project_completioncertificate_eventaction  
		(
		  -- ProjectCompletionEventAction_ID,
		  EventAction_Type,
		  EventAction_IdentifiedBy,
		  EventAction_IdentifiedOn,
		  Related_Promoter_ID,
		  Related_Project_ID,
		  Promoter_DiaryNumber,
		  Project_DiaryNumber,
		  Completion_DiaryNumber,
		  RERA_RegistrationNumber,
		  EventAction_Summary,
		  EventAction_Description,
		  EventAction_Category,
		  EventAction_Aggregate,
		  EventAction_Relationship,
		  AssignedTo,
		  Target_ResolutionDate,
		  Target_ResolutionSummary,
		  Actual_ResolutionDate,
		  IsBefore_TargetResolution,
		  ProgressStatus,
		  Remarks_IfAny,
		  IsActive,
		  IsDraft,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		)  
		VALUES  
		(  
          -- ProjectCompletionEventAction_ID,
		  810004,  -- ReSubmitted Event Code
		  p_CreatedBy,  
		  NOW(), 
          p_Promoter_ID,
          p_Project_ID,
          '',
          p_ProjectDiaryNumber,
          v_GetExistingForDeskPCCdiaryNumber_Name, -- Completion_DiaryNumber
          p_RERAnumberRegistration, 
		  'Application Re-Submitted (Modified Application)',  
		  'Project Completion Certificate with RERA' ,  
		  'System Administrator' ,  
		  'CC Re-Submitted with Modification' ,  
		  'Role Admin' ,  
		  'HelpDesk Level I' ,  
		  NOW(),    
		  '999',  
		  NOW(), 
          0,
		  'In Process' ,  
		  'CC Re-Submitted with Modification',
		  1,  
		  0,  
		  p_CreatedBy,  
		  NOW(),    
		  p_ModifyBy, 
		  NOW()  
		);  
  
		set v_PutPCC_RegDiaryNumber_Name=v_GetExistingForDeskPCCdiaryNumber_Name;
    else
	    INSERT INTO tbl_rera_project_completioncertificate_eventaction  
		(
		  -- ProjectCompletionEventAction_ID,
		  EventAction_Type,
		  EventAction_IdentifiedBy,
		  EventAction_IdentifiedOn,
		  Related_Promoter_ID,
		  Related_Project_ID,
		  Promoter_DiaryNumber,
		  Project_DiaryNumber,
		  Completion_DiaryNumber,
		  RERA_RegistrationNumber,
		  EventAction_Summary,
		  EventAction_Description,
		  EventAction_Category,
		  EventAction_Aggregate,
		  EventAction_Relationship,
		  AssignedTo,
		  Target_ResolutionDate,
		  Target_ResolutionSummary,
		  Actual_ResolutionDate,
		  IsBefore_TargetResolution,
		  ProgressStatus,
		  Remarks_IfAny,
		  IsActive,
		  IsDraft,
		  CreatedBy,
		  CreatedOn,
		  ModifyBy,
		  ModifyOn
		) 
     VALUES  
     ( 
		-- ProjectCompletionEventAction_ID,
		810001,  -- New Application By Admin (Intialization) Event Code
        p_CreatedBy,  
	    NOW(), 
	    p_Promoter_ID,
	    p_Project_ID,
	    '',
	    p_ProjectDiaryNumber,
        v_PutPCC_RegDiaryNumber_Name, -- Completion_DiaryNumber
        p_RERAnumberRegistration,
        'CC Submission (New Application)',  
		'Project Completion Certificate with RERA',  
		'System Administrator',  
		'Completion Certificate Application Submitted',  
		'Role Admin',  
		'HelpDesk Level I', 
		NOW(),    
		'999',  
		NOW(), 
		0,
		'In Process' ,  
		'Completion Certificate Application Submitted',
		1,  
		0,  
		p_CreatedBy,  
		NOW(),    
		p_ModifyBy, 
		NOW()
	 ); 
	end if; 

		-- ---------PCC Information details INSERT -------------
	select COUNT(*) into v_verifyPCCdetailsCount from tbl_rera_project_completiondetails 
	where Promoter_ID=p_Promoter_ID and Project_ID=p_Project_ID and RERAnumberRegistration=p_RERAnumberRegistration and IsActive=1;

	if v_verifyPCCdetailsCount>0
