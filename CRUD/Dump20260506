CREATE DEFINER=`sa`@`%` PROCEDURE `usp_insert_tbl_rera_complaint_formm_caseinstitution_eventaction`(  
	p_AuthDesk_ActionID varchar(50), -- p_EventAction_Type
	p_InstitutionFormM_ID bigint,
	p_ComplaintFormM_ID bigint,
	p_User_ID varchar(50),	
	p_ComplaintDiaryNumber varchar(90),
	p_ComplaintType_MN varchar(50),
	p_InstitutionDNumber varchar(90),
	p_DakNumber varchar(90),  
    -- p_EventAction_Type bigint,
    p_EventAction_IdentifiedBy varchar(50),
	p_EventAction_IdentifiedOn datetime(3),
    -- p_EventAction_Summary varchar(50),
    -- p_EventAction_Description varchar(200),
	p_EventAction_Category varchar(50),
	p_EventAction_Aggregate varchar(50),
	p_EventAction_Relationship varchar(50),           
	p_AssignedTo varchar(50),
    -- p_Target_ResolutionSummary varchar(100),
    -- p_Actual_ResolutionDate datetime(3),
	p_Target_ResolutionDate datetime(3),
    -- p_ProgressStatus varchar(50),
	p_Remarks_IfAny varchar(1500),
	p_IsActive int,
	p_IsDraft int,
	p_CreatedBy varchar(90),
	p_CreatedOn datetime(3),
	p_ModifyBy varchar(90),
	p_ModifyOn datetime(3),
	out p_valoutput int,
	out p_valoutputDNumber varchar(90)
)
BEGIN 

declare v_AssignedRefFlag int default 1;
declare v_AssignedRefNumber varchar(300) default 'NA';
declare v_IsLockRefNumber int default 0;
declare v_IsLock int default 0;
declare v_checkAppno int default 0;
declare v_Institution_Ref_Number VARCHAR(50) default 'NA';
declare v_CaseAssigned_BenchName VARCHAR(90) default 'NA';
declare v_Dak_Number varchar(90) default 'NA';
declare v_Dak_Date datetime(3);

-- BEGIN TRY  
-- BEGIN TRANSACTION 

-- Case Institution Event
IF (p_AuthDesk_ActionID='AC') THEN

	select IsLockRefNumber, IsLock, Institution_Ref_Number, CaseAssignement_BenchName 
    into v_IsLockRefNumber, v_IsLock, v_Institution_Ref_Number, v_CaseAssigned_BenchName    
    from tbl_rera_ecourt_complaint_formm_institutiondetail
	where Related_ComplaintFormM_ID=p_ComplaintFormM_ID and InstitutionFormM_ID=p_InstitutionFormM_ID and IsActive=1
    order by InstitutionFormM_IndexID desc limit 1;
    
	IF (v_IsLockRefNumber = 0 and v_IsLock = 0) THEN
		-- Case AC Lock Event
		-- Lock Case Institution record
		update tbl_rera_ecourt_complaint_formm_institutiondetail set IsLockRefNumber=1
		where Related_ComplaintFormM_ID=p_ComplaintFormM_ID
		and InstitutionFormM_ID=p_InstitutionFormM_ID
		and IsActive=1;

		select count(Related_Complaint_ID) into v_checkAppno from tbl_rera_complaint_formm_eventaction 
		where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1;
        
        IF (v_checkAppno <> 0) THEN        
		update tbl_rera_complaint_formm_eventaction set IsActive=2
		where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1; 
	
		INSERT INTO tbl_rera_complaint_formm_eventaction
		   (
		   `EventAction_Type`
		   ,`EventAction_IdentifiedBy`
		   ,`EventAction_IdentifiedOn`
		   ,`Related_Complaint_ID`
		   ,`Related_RegDiaryNumber`
		   ,`EventAction_Summary`
		   ,`EventAction_Description`
		   ,`EventAction_Category`
		   ,`EventAction_Aggregate`
		   ,`EventAction_Relationship`
		   ,`AssignedTo`
		   ,`Target_ResolutionDate`
		   ,`Target_ResolutionSummary`
		   ,`Actual_ResolutionDate`
		   ,`ProgressStatus`
		   ,`Remarks_IfAny`
		   ,`IsActive`
		   ,`IsDraft`
		   ,`CreatedBy`
		   ,`CreatedOn`
		   ,`ModifyBy`
		   ,`ModifyOn`
		   )
		VALUES
		   (
		   330101, -- p_p_EventAction_Type,
		   p_EventAction_IdentifiedBy,
		   NOW(),
		   p_ComplaintFormM_ID,
		   p_ComplaintDiaryNumber,
		   'Case institution and assignment for initiating a legal process',
		   'Case institution and assignment for initiating a legal process',
		   'Authority Desk',
		   'Case institution and assignment for initiating a legal process',
		   'Role Legal Desk',
		   'NA',
		   NOW(),
		   p_EventAction_Aggregate,
		   NOW(),           
		   'CaseAssignemnt',
		   concat('Case institution and assignment (Ref Number: ', v_Institution_Ref_Number, ' and Bench Name: ', v_CaseAssigned_BenchName, ')'),
		   1,
		   0,
		   p_CreatedBy,
		   NOW(),
		   p_CreatedBy,
		   NOW()
	    );
		END IF;

		set v_AssignedRefFlag=102;
		set v_AssignedRefNumber=p_InstitutionDNumber;
    ELSE
		-- Case Already Exist
    	set v_AssignedRefFlag=104;
		set v_AssignedRefNumber=p_InstitutionDNumber;
    END IF;
END IF;

-- Dak Receipt Event
IF (p_AuthDesk_ActionID='DR') THEN

	select IsLockRefNumber, IsLock, Dak_Number, Dak_Date 
    into v_IsLockRefNumber, v_IsLock, v_Dak_Number, v_Dak_Date
    from tbl_rera_ecourt_complaint_formm_institutiondetail
	where Related_ComplaintFormM_ID=p_ComplaintFormM_ID and InstitutionFormM_ID=p_InstitutionFormM_ID and IsActive=1
    order by InstitutionFormM_IndexID desc limit 1;

	
		IF (v_IsLock = 1) THEN
			-- Case Already Exist
			set v_AssignedRefFlag=105;
			set v_AssignedRefNumber=p_InstitutionDNumber;
		ELSE
			-- Case DR Lock Event
			IF (v_IsLockRefNumber = 1) THEN
				-- Case DR Recrod Check
				IF (v_Dak_Number = '') THEN
					set v_AssignedRefFlag=105;
					set v_AssignedRefNumber='Dak Receipt Pending';
				ELSE            
					-- Case DR Lock Event
					-- Lock Case Institution record
					update tbl_rera_ecourt_complaint_formm_institutiondetail set IsLockRefNumber=1, IsDraft=1, IsLock=1
					where Related_ComplaintFormM_ID=p_ComplaintFormM_ID
					and InstitutionFormM_ID=p_InstitutionFormM_ID
					and IsActive=1;
				
					select count(Related_Complaint_ID) into v_checkAppno from tbl_rera_complaint_formm_eventaction 
					where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1;
					
					IF (v_checkAppno <> 0) THEN        
					update tbl_rera_complaint_formm_eventaction set IsActive=2
					where Related_Complaint_ID=p_ComplaintFormM_ID and IsActive=1; 
				
					INSERT INTO tbl_rera_complaint_formm_eventaction
					   (
					   `EventAction_Type`
					   ,`EventAction_IdentifiedBy`
					   ,`EventAction_IdentifiedOn`
					   ,`Related_Complaint_ID`
					   ,`Related_RegDiaryNumber`
					   ,`EventAction_Summary`
					   ,`EventAction_Description`
					   ,`EventAction_Category`
					   ,`EventAction_Aggregate`
					   ,`EventAction_Relationship`
					   ,`AssignedTo`
					   ,`Target_ResolutionDate`
					   ,`Target_ResolutionSummary`
					   ,`Actual_ResolutionDate`
					   ,`ProgressStatus`
					   ,`Remarks_IfAny`
					   ,`IsActive`
					   ,`IsDraft`
					   ,`CreatedBy`
					   ,`CreatedOn`
					   ,`ModifyBy`
					   ,`ModifyOn`
					   )
					VALUES
					   (
					   330102, -- p_p_EventAction_Type,
					   p_EventAction_IdentifiedBy,
					   NOW(),
					   p_ComplaintFormM_ID,
					   p_ComplaintDiaryNumber,
					   'Dak receipt registration with reference number',
					   'Dak receipt registration with reference number',
					   'Authority Desk',
					   'Dak receipt registration with reference number',
					   'Role FrontOffice Desk',
					   'NA',
					   NOW(),
					   p_EventAction_Aggregate,
					   NOW(),           
					   'RegisterDak',
					   concat('Dak Receipt (Dak Number: ', v_Dak_Number, ' dated : ', Date_Format(v_Dak_Date, '%d/%m/%Y'), ')'),
					   1,
					   0,
					   p_CreatedBy,
					   NOW(),
					   p_CreatedBy,
					   NOW()
					);
					END IF;
					
					set v_AssignedRefFlag=103;
					set v_AssignedRefNumber=p_InstitutionDNumber;
                
                END IF;
				
			ELSEIF (v_IsLockRefNumber = 0) THEN
				set v_AssignedRefFlag=105;
				set v_AssignedRefNumber='Case Assignment Pending';
			END IF;    
		END IF;
    
END IF;

set p_valoutput=v_AssignedRefFlag;
set p_valoutputDNumber=v_AssignedRefNumber;

END ;;
DELIMITER ;
