/*!50003 CREATE*/ /*!50017 DEFINER=`sa`@`%`*/ /*!50003 TRIGGER utrigger_Rera_Project_EventRecord_INSERT
AFTER INSERT
ON tbl_rera_project_promoter_eventaction
FOR EACH ROW
BEGIN
      
     DECLARE v_PromoterId BigInt; 
     Declare v_ProjectId BigInt;
     Declare v_ProjectDiaryNumber varchar(100);   
     Declare v_EventType int; 
     Declare varcheckpromoterisdraftmembervalue int; 
     
     Declare v_CL_SeqCount int;
     Declare v_CL_SeqCycleID int;
     Declare v_CL_EventAction_BranchGroup varchar(50);
     Declare v_EventUserName varchar(200);
     Declare v_CL_EventAction_Relationship varchar(150);
     
     Declare v_CL_IsPR int; 
     Declare v_CL_IsTP int; 
     Declare v_CL_IsLG int; 
     Declare v_CL_IsFA int; 
     Declare v_CL_IsAL int; 
     Declare v_CL_IsOR int;
     
     Declare v_EventCycle_SequenceFlag varchar(100);
     
	 Declare v_RCL_SeqCount int;
     Declare v_RCL_SeqCycleID int;
     Declare v_RCL_EventCycle_SequenceFlag varchar(100);
     Declare v_RCL_EventAction_BranchGroup varchar(50);
     
	 Declare v_RCL_IsCP int; 
     Declare v_RCL_IsMO int; 
     Declare v_RCL_IsMT int; 
     Declare v_RCL_IsAL int; 
     Declare v_RCL_IsOR int;
     
      SET v_ProjectId=NEW.Related_Project_ID;         
      SET v_PromoterId=NEW.Related_Promoter_ID;           
      SET v_ProjectDiaryNumber=NEW.Project_DiaryNumber;            
      SET v_EventType=NEW.EventAction_Type;     
	  SET v_EventUserName=NEW.EventAction_IdentifiedBy;
      SET v_CL_EventAction_Relationship=NEW.EventAction_Relationship;
      
-- Project Details          
If v_EventType = 110007   
then      
   update tbl_RERA_Project_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1;   
   
   update tbl_RERA_Project_ApprovalDetails set IsDraft=4 where ProjectApprovalRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Documents set IsDraft=4 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_KhasraAreaDetails set IsDraft=4 where ProjectKhasraAreaRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_LandDetails set IsDraft=4 where ProjectLandRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Litigations set IsDraft=4 where LitigationsRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_SpecialBankAccountDetails set IsDraft=4 where SpecialBankAccountRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Payment set IsDraft=4 where ProjectPaymentRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Registration set IsDraft=4 where Promoter_ID=v_PromoterId and ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;   
   
   
end if;
 
-- Promoter Profile  
If v_EventType = 110010  
then 
   select count(*) into varcheckpromoterisdraftmembervalue from tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=v_PromoterId and IsActive=1 and IsDraftMember=0;

   if (varcheckpromoterisdraftmembervalue > 0)
   then     
	   update tbl_RERA_Promoter_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and IsActive=1;  
	   update tbl_RERA_Project_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1;
		  
		
	   update Rera_Tbl_Promoter set IsDraft=4 where Application_id=v_PromoterId and IsActive=1 and IsDraft=5;
	   update tbl_RERA_Promoter_Documents set IsDraft=4 where Promoter_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update tbl_RERA_Promoter_Experience_Completed_OnGoing set Flag=4 where Application_id=v_PromoterId and IsActive=1 and Flag=5;
	   update tbl_RERA_Promoter_Litigations set IsDraft=4 where Promoter_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update Tbl_Rera_Promoter_OtherMemberDetails set IsDraft=4 where Application_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update Tbl_Rera_Promoter_ParentEntity set IsDraft=4 where Application_ID=v_PromoterId and IsActive=1 and IsDraft=5;
    end if;

end if; 
 
-- Project Quarterly Updates  
If v_EventType = 110011  
then      
   update tbl_RERA_Project_Quater_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1; 
   update tbl_RERA_Project_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1;
   
   
   update tbl_RERA_Project_BuildingTowerBlock_Construction set IsDraft=4 where ProjectConstructionRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_BuildingTowerBlock_Inventory set IsDraft=4 where ProjectInventoryRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ExternalInfrastructure_Facilities set IsDraft=4 where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_InternalInfrastructure_Facilities set IsDraft=4 where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ParkingDetails set IsDraft=4 where ProjectParkingRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ProfessionalDetails set IsDraft=4 where ProjectProfessionalRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ConstructionStatusPhotographs set IsDraft=4 where Promoter_ID=v_PromoterId and ProjectPhotographsRelated_Project_ID=v_ProjectId and IsActive=1 and IsDraft=5; 

end if; 
 
-- Project Application  ALL
If v_EventType = 110012  
then  
   update tbl_RERA_Project_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1;  
   update tbl_RERA_Project_Quater_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1; 
   
   -- Project Details
   update tbl_RERA_Project_ApprovalDetails set IsDraft=4 where ProjectApprovalRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Documents set IsDraft=4 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_KhasraAreaDetails set IsDraft=4 where ProjectKhasraAreaRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_LandDetails set IsDraft=4 where ProjectLandRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Litigations set IsDraft=4 where LitigationsRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_SpecialBankAccountDetails set IsDraft=4 where SpecialBankAccountRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Payment set IsDraft=4 where ProjectPaymentRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   update tbl_RERA_Project_Registration set IsDraft=4 where Promoter_ID=v_PromoterId and ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5;      
  
   -- Project Quarterly Updates 
   update tbl_RERA_Project_BuildingTowerBlock_Construction set IsDraft=4 where ProjectConstructionRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_BuildingTowerBlock_Inventory set IsDraft=4 where ProjectInventoryRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ExternalInfrastructure_Facilities set IsDraft=4 where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_InternalInfrastructure_Facilities set IsDraft=4 where ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ParkingDetails set IsDraft=4 where ProjectParkingRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ProfessionalDetails set IsDraft=4 where ProjectProfessionalRelated_ProjectRegistration_ID=v_ProjectId and IsActive=1 and IsDraft=5; 
   update tbl_RERA_Project_ConstructionStatusPhotographs set IsDraft=4 where Promoter_ID=v_PromoterId and ProjectPhotographsRelated_Project_ID=v_ProjectId and IsActive=1 and IsDraft=5;
   
   
   select count(*) into varcheckpromoterisdraftmembervalue from tbl_RERA_Promoter_RegDiaryNumber where Promoter_ID=v_PromoterId and IsActive=1 and IsDraftMember=0;
   
   if (varcheckpromoterisdraftmembervalue > 0)
   then
	   update tbl_RERA_Promoter_RegDiaryNumber set IsDraft=0 where Promoter_ID=v_PromoterId and IsActive=1;
        
        -- Promoter Profile
	   update Rera_Tbl_Promoter set IsDraft=4 where Application_id=v_PromoterId and IsActive=1 and IsDraft=5;
	   update tbl_RERA_Promoter_Documents set IsDraft=4 where Promoter_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update tbl_RERA_Promoter_Experience_Completed_OnGoing set Flag=4 where Application_id=v_PromoterId and IsActive=1 and Flag=5;
	   update tbl_RERA_Promoter_Litigations set IsDraft=4 where Promoter_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update Tbl_Rera_Promoter_OtherMemberDetails set IsDraft=4 where Application_ID=v_PromoterId and IsActive=1 and IsDraft=5;
	   update Tbl_Rera_Promoter_ParentEntity set IsDraft=4 where Application_ID=v_PromoterId and IsActive=1 and IsDraft=5;

   end if;   
   
   -- Project Reminder Scheduler Updates
   -- CALL usp_insert_tbl_rera_project_reminderscheduler_emails(10435,1108,''''PRJ2019ABC1121'''',110012);
   CALL usp_insert_tbl_rera_project_reminderscheduler_emails(v_ProjectId, v_PromoterId, v_ProjectDiaryNumber, v_EventType);
   CALL usp_insert_tbl_rera_project_reminderscheduler_smsgateway(v_ProjectId, v_PromoterId, v_ProjectDiaryNumber, v_EventType);
   
   -- CheckList Director Desk -- Prepared and Verified
   select count(*) into v_CL_SeqCount from tbl_rera_project_promoter_eventaction_traybox where Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   IF (v_CL_SeqCount<>0) THEN		
		update tbl_rera_project_promoter_eventaction_traybox set EventCycle_SequenceFlag='Close' where Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   END IF;
   
end if; 

-- Project Application - LOCK (Promoter Project and Quarterly)
If ((v_EventType = 110017) or (v_EventType = 110020) or (v_EventType = 110021)) 
then 
   -- Project Details  
   update tbl_RERA_Promoter_RegDiaryNumber set IsDraftMember=1 where Promoter_ID=v_PromoterId and IsActive=1 and IsDraft=1;
   -- Promoter Profile
   update tbl_RERA_Project_RegDiaryNumber set IsDraftMember=1 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1 and IsDraft=1; 
   -- Project Quarterly Updates
   update tbl_RERA_Project_Quater_RegDiaryNumber set IsDraftMember=1 where Promoter_ID=v_PromoterId and Project_ID=v_ProjectId and IsActive=1 and IsDraft=1;
   
   -- Authority Desk CheckList - Approved and CloseFile
   select count(*) into v_RCL_SeqCount from tbl_rera_project_promoter_eventaction_traybox_member where Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   IF (v_RCL_SeqCount<>0) THEN	
		update tbl_rera_project_promoter_eventaction_traybox_member set EventCycle_SequenceFlag='Close' where Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   END IF;
   
end if;

-- Director Desk CheckList - Prepared and OpenFile
If ((v_EventType = 110039) or (v_EventType = 110037) or (v_EventType = 110036) or (v_EventType = 110035) or (v_EventType = 110014)) 
then 
   SET v_CL_IsPR=0; 
   SET v_CL_IsTP=0; 
   SET v_CL_IsLG=0; 
   SET v_CL_IsFA=0; 
   SET v_CL_IsAL=1; 
   SET v_CL_IsOR=1;
   
   select count(*) into v_CL_SeqCount from tbl_rera_project_promoter_eventaction_traybox where EventAction_Branch='ECLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   IF (v_CL_SeqCount<>0) THEN
	   -- Already Exist Record
	   
       select EventCycle_SequenceID, EventCycle_SequenceFlag, IsPR, IsTP, IsLG, IsFA, IsAL, IsOR 
       into v_CL_SeqCycleID, v_EventCycle_SequenceFlag, v_CL_IsPR, v_CL_IsTP, v_CL_IsLG, v_CL_IsFA, v_CL_IsAL, v_CL_IsOR
       from tbl_rera_project_promoter_eventaction_traybox 
       where EventAction_Branch='ECLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
       
       IF (v_EventCycle_SequenceFlag='Close') THEN
       
			IF (v_CL_IsPR<>3) THEN
				SET v_CL_IsPR=0;
			END IF;
			IF (v_CL_IsTP<>3) THEN
				SET v_CL_IsTP=0;
			END IF;
			IF (v_CL_IsLG<>3) THEN
				SET v_CL_IsLG=0;
			END IF;
			IF (v_CL_IsFA<>3) THEN
				SET v_CL_IsFA=0;
			END IF;
			SET v_CL_IsAL=1; 
			SET v_CL_IsOR=1;
       END IF;
       
	   IF (v_EventType = 110039) THEN
			SET v_CL_EventAction_BranchGroup='FA';
			SET v_CL_IsFA=1; 
		ELSE IF (v_EventType = 110037) THEN
			SET v_CL_EventAction_BranchGroup='LG';
			SET v_CL_IsLG=1;
		ELSE IF (v_EventType = 110036) THEN
			SET v_CL_EventAction_BranchGroup='TP';
			SET v_CL_IsTP=1;
		ELSE IF (v_EventType = 110035) THEN
			SET v_CL_EventAction_BranchGroup='PR';
			SET v_CL_IsPR=1;
		ELSE IF (v_EventType = 110014) THEN
			SET v_CL_EventAction_BranchGroup='PR';
			SET v_CL_IsPR=1;
		END IF;  
		END IF; 
		END IF; 
		END IF; 
	   END IF;
       
       IF (v_EventCycle_SequenceFlag<>'Open') THEN
		   select max(EventCycle_SequenceID) into v_CL_SeqCycleID from tbl_rera_project_promoter_eventaction_traybox where EventAction_Branch='ECLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId;
		   IF (v_CL_SeqCycleID IS NULL) THEN   
			  set v_CL_SeqCycleID=1;
		   ELSE     
			  set v_CL_SeqCycleID=v_CL_SeqCycleID+1;
		   END IF;
       END IF;
       
       update tbl_rera_project_promoter_eventaction_traybox set IsActive=2 where EventAction_Branch='ECLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
       
	   INSERT INTO tbl_rera_project_promoter_eventaction_traybox 
	   (EventAction_Type, SubEventAction_Type, EventAction_Branch, EventAction_BranchGroup, EventCycle_SequenceID, EventCycle_SequenceFlag, SubEvent_IdentifiedBy, SubEvent_IdentifiedOn, Related_Promoter_ID, Related_Project_ID, Promoter_DiaryNumber, Project_DiaryNumber, SubEvent_Summary, SubEvent_Description, SubEvent_Category, SubEvent_Aggregate, SubEvent_Relationship, IsPR, IsTP, IsLG, IsFA, IsAL, IsOR, IsAcceptedStatus, AssignedTo, Target_ResolutionDate, Actual_ResolutionDate, IsBefore_TargetResolution, IsActive, IsDraft, CreatedBy, CreatedOn, ModifyBy, ModifyOn)
	   VALUES (v_EventType, '0', 'ECLP', v_CL_EventAction_BranchGroup, v_CL_SeqCycleID, 'Open', v_EventUserName, NOW(), v_PromoterId, v_ProjectId, 'NA', v_ProjectDiaryNumber, 'NA', 'NA', 'Authority Desk', 'ECLP', v_CL_EventAction_Relationship, v_CL_IsPR, v_CL_IsTP, v_CL_IsLG, v_CL_IsFA, v_CL_IsAL, v_CL_IsOR, 'NA', ' ', NOW(), NOW(), '0', '1', '0', v_EventUserName, NOW(), v_EventUserName, NOW());
   
   ELSE
	   -- NEW CYCLE
	   IF (v_EventType = 110039) THEN
			SET v_CL_EventAction_BranchGroup='FA';
			SET v_CL_IsFA=1; 
	   ELSE IF (v_EventType = 110037) THEN
			SET v_CL_EventAction_BranchGroup='LG';
			SET v_CL_IsLG=1;
	   ELSE IF (v_EventType = 110036) THEN
			SET v_CL_EventAction_BranchGroup='TP';
			SET v_CL_IsTP=1;
	   ELSE IF (v_EventType = 110035) THEN
			SET v_CL_EventAction_BranchGroup='PR';
			SET v_CL_IsPR=1;
	   ELSE IF (v_EventType = 110014) THEN
			SET v_CL_EventAction_BranchGroup='PR';
			SET v_CL_IsPR=1;
	   END IF;  
	   END IF; 
	   END IF; 
	   END IF; 
	   END IF;
       
       
       INSERT INTO tbl_rera_project_promoter_eventaction_traybox 
       (EventAction_Type, SubEventAction_Type, EventAction_Branch, EventAction_BranchGroup, EventCycle_SequenceID, EventCycle_SequenceFlag, SubEvent_IdentifiedBy, SubEvent_IdentifiedOn, Related_Promoter_ID, Related_Project_ID, Promoter_DiaryNumber, Project_DiaryNumber, SubEvent_Summary, SubEvent_Description, SubEvent_Category, SubEvent_Aggregate, SubEvent_Relationship, IsPR, IsTP, IsLG, IsFA, IsAL, IsOR, IsAcceptedStatus, AssignedTo, Target_ResolutionDate, Actual_ResolutionDate, IsBefore_TargetResolution, IsActive, IsDraft, CreatedBy, CreatedOn, ModifyBy, ModifyOn)
       VALUES (v_EventType, '0', 'ECLP', v_CL_EventAction_BranchGroup, '1', 'Open', v_EventUserName, NOW(), v_PromoterId, v_ProjectId, 'NA', v_ProjectDiaryNumber, 'NA', 'NA', 'Authority Desk', 'ECLP', v_CL_EventAction_Relationship, v_CL_IsPR, v_CL_IsTP, v_CL_IsLG, v_CL_IsFA, v_CL_IsAL, v_CL_IsOR, 'NA', ' ', NOW(), NOW(), '0', '1', '0', v_EventUserName, NOW(), v_EventUserName, NOW());
   END IF;
   
end if;

-- Director Desk CheckList - Verified and CloseFile
If ((v_EventType = 110024) or (v_EventType = 110061)) 
then 
   SET v_CL_IsPR=1; 
   SET v_CL_IsTP=0; 
   SET v_CL_IsLG=0; 
   SET v_CL_IsFA=0; 
   SET v_CL_IsAL=2; 
   SET v_CL_IsOR=2;
   
   select count(*) into v_CL_SeqCount from tbl_rera_project_promoter_eventaction_traybox where EventAction_Branch='VCLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
   IF (v_CL_SeqCount<>0) THEN
	   -- Already Exist Record
	   
       select EventCycle_SequenceID, EventCycle_SequenceFlag, IsPR, IsTP, IsLG, IsFA, IsAL, IsOR 
       into v_CL_SeqCycleID, v_EventCycle_SequenceFlag, v_CL_IsPR, v_CL_IsTP, v_CL_IsLG, v_CL_IsFA, v_CL_IsAL, v_CL_IsOR
       from tbl_rera_project_promoter_eventaction_traybox 
       where EventAction_Branch='VCLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
       
       IF (v_EventCycle_SequenceFlag='Close') THEN
		   SET v_CL_IsPR=1; 
		   SET v_CL_IsTP=0; 
		   SET v_CL_IsLG=0; 
		   SET v_CL_IsFA=0; 
		   SET v_CL_IsAL=2; 
		   SET v_CL_IsOR=2;
       END IF;
       
       SET v_CL_EventAction_BranchGroup='PR';
       select Occupation into v_CL_EventAction_BranchGroup FROM userprofiledetails where UserName=v_EventUserName and IsActive=1 and IsDraft=1 and IsLock=1;
       
       IF (v_CL_EventAction_BranchGroup='FA') THEN
			SET v_CL_IsFA=2; 
	   ELSE IF (v_CL_EventAction_BranchGroup='LG') THEN
			SET v_CL_IsLG=2;
	   ELSE IF (v_CL_EventAction_BranchGroup='TP') THEN
			SET v_CL_IsTP=2;
	   ELSE IF (v_CL_EventAction_BranchGroup='PR') THEN
			SET v_CL_IsPR=2; 
	   END IF; 
	   END IF; 
	   END IF; 
	   END IF;
       
       IF (v_EventCycle_SequenceFlag<>'Open') THEN
		   select max(EventCycle_SequenceID) into v_CL_SeqCycleID from tbl_rera_project_promoter_eventaction_traybox where EventAction_Branch='VCLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId;
		   IF (v_CL_SeqCycleID IS NULL) THEN   
			  set v_CL_SeqCycleID=1;
		   ELSE     
			  set v_CL_SeqCycleID=v_CL_SeqCycleID+1;
		   END IF;
       END IF;
       
       update tbl_rera_project_promoter_eventaction_traybox set IsActive=2 where EventAction_Branch='VCLP' and Related_Promoter_ID=v_PromoterId and Related_Project_ID=v_ProjectId and IsActive=1;
       
