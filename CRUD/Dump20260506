CREATE DEFINER=`sa`@`%` FUNCTION `udfn_GetAgent_RERA_RegistrationValidUptoDate`(pAgent_ID bigint, pRenewalAgent_ID bigint, pFlag int) RETURNS datetime(3)
BEGIN  
    DECLARE v_ret datetime(3);
    DECLARE v_chkrenewalregdnumber int; 
    DECLARE v_chkAgentOnlineCnt int;
    
    SELECT count(*) into v_chkrenewalregdnumber FROM tbl_rera_ldr_agent_reranumber_renewalregistration
    WHERE RelatedAgent_ID=pAgent_ID and IsActive=1;
    
    SELECT count(*) into v_chkAgentOnlineCnt FROM tbl_rera_ldr_agent_reranumber_diarynumber
    WHERE Agent_ID=pAgent_ID and IsActive=1;
    
    IF (v_chkrenewalregdnumber<>0) THEN    
        SELECT RenewalAgentRegistrationRegUptoDate INTO v_ret FROM tbl_rera_ldr_agent_reranumber_renewalregistration
		WHERE RelatedAgent_ID=pAgent_ID 
        and IsActive=1
        and IsActiveProvider=1
        -- ORDER BY RenewalOrderSequence asc
        Limit 1;    
    ELSE
		IF (v_chkAgentOnlineCnt<>0) THEN        
            SELECT RERAnumberRegUptoDate INTO v_ret FROM tbl_rera_ldr_agent_reranumber_diarynumber
			WHERE Agent_ID=pAgent_ID and IsActive=1 and IsPublicView=1
            LIMIT 1;        
        ELSE        
			SELECT OfflineAgents_RERAregistrationValidUptoDate INTO v_ret FROM tbl_rera_agent_offlineagents_pendinguploads
            WHERE A_column=pAgent_ID and IsActive=1 and IsPublicView=1
            LIMIT 1;        
        END IF;    
    END IF;
    
	IF (v_ret IS NULL) THEN   
		SET v_ret = '2018-04-13 00:00:00.000';
	END IF;
     
    RETURN v_ret; 
END ;;
