	0 as Is_YesNo_RenewalAgent_OtherMembers,
	0 as Is_YesNo_RenewalAgent_OtherStateUTnumber,    
	0 as Is_YesNo_ValidforAgentRenewal_Flag,

	'' as A_column,
	'' as B_column,
	0 as IsLock,
	0 as IsPublicView
	FROM tbl_rera_agent_offlineagents_pendinguploads
	WHERE IsActive=1
	LIMIT 1;
END IF;
 
