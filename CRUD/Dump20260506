CREATE DEFINER=`sa`@`%` PROCEDURE `Display_Rera_Agent_Dashboard_RenewalRegistrationNumber_ByID`(        
  p_Agent_ID bigint,
  p_RenewalAgent_ID bigint,
  p_RenewalAgent_SequenceID int,
  p_RenewalAgent_Year int,
  p_UserRole varchar(120)    
)
begin      
      
SELECT 
m.RenewalAgentDiaryNumber_IndexID as RenewalAgent_RegDiaryNumber_IndexID,
m.RenewalAgentDiaryNumber_ID as RenewalAgent_RegDiaryNumber_ID,

m.AgentRenewal_ID as Related_RenewalAgent_ID,
m.RenewalOrderSequence as Related_RenewalOrderSequence,
m.AgentRenewal_Year as Related_RelatedRenewalAgent_Year,
m.Agent_ID as Related_Agent_ID,
m.RelatedAgentDiaryNumber_Name as Related_AgentDiaryNumber_Name,
m.CurrentEventcode as Related_Agent_Type,
m.UserID as Related_UserID,
m.RERAnumberRegistration as Related_RERAnumberRegistration,
'0001-01-01 00:00:00.000' as Related_RERAnumberIssueDate, -- m.RERAnumberIssueDate
'0001-01-01 00:00:00.000' as Related_RERAnumberRegUptoDate, -- m.RERAnumberRegUptoDate

m.RenewalAgentDiaryNumber_IndexID as AgentRegDiaryNumber_IndexID,
m.RenewalAgentDiaryNumber_ID as AgentRegDiaryNumber_ID,
m.RenewalAgentDiaryNumber_Name as AgentRegDiaryNumber_Name,
m.RenewalAgentDiaryNumber_NameYear as AgentRegDiaryNumber_NameYear,
m.Agent_ID,
m.UserID,
m.othermemdetailCount,
m.documentuploadCount,
m.UTOtherStateRERACount,
m.PaymentCount,
m.AgentDocumentCount,
m.Remarks_IfAny,
m.CurrentEventcode,
m.EventCodeDetails_indexID,
m.IsActive,
m.IsDraft,
m.IsDraftHelpDesk,
m.IsDraftEvaluation,
m.IsDraftSecMember,
m.IsDraftMember,

m.IsActiveProvider,
m.IsLock,
m.IsConditional as IsPublicView,

m.CreatedBy,
m.CreatedOn,
m.ModifyBy,
m.ModifyOn,
m.Agent_Name,
m.Agent_RERAregistrationNumber,


m.EventAction_Type,
m.EventAction_TypeName,
m.EventAction_IdentifiedOn,
m.EventAction_Aggregate,
m.Target_ResolutionDate,
m.EventRemarks_IfAny,
m.EventAction_Summary,

m.RenewalAgentDiaryNumber_ID as RenewalAgentRegDiaryNumber_ID,
m.RenewalAgentDiaryNumber_Name as RenewalAgentRegDiaryNumber_Name,
m.RenewalAgentDiaryNumber_NameYear as RenewalAgentRegDiaryNumber_NameYear,
0 as Registration_Number_Code,
0 as Registration_Number_EventTypeID,
'' as Registration_Number_SeqOrder,
0 as Registration_Number_ReferenceID,
'' as Registration_Number_ReferenceNumber,
'0001-01-01 00:00:00.000' as Registration_Number_ReferenceDate,
0 as Registration_Number_IsLatestRenewal_Flag,

Ifnull(n.RERAnumberRegistration, 'NA') as RERA_Registration_Number,
Ifnull(n.RERAnumberIssueDate, '0001-01-01 00:00:00.000') as RERA_Registration_IssueDate,
Ifnull(n.RERAnumberRegUptoDate, '0001-01-01 00:00:00.000') as RERA_Registration_ValidUptoDate,

Ifnull(n.RenewalAgentRegistrationIssueDate, '0001-01-01 00:00:00.000') as LastRenewal_Registration_IssueDate,
Ifnull(n.RenewalAgentRegistrationRegUptoDate, '0001-01-01 00:00:00.000') as LastRenewal_Registration_ValidUptoDate,

case when n.RERAnumberRegistration is null then 0 else 21 end Registration_Number_Flag,
'' as Registration_Number_Status
        
FROM
(
select a.*,
udfn_GetAgentName(a.Agent_ID) as Agent_Name,
'--' as Agent_RERAregistrationNumber,
c.EventAction_Type,      
c.EventAction_Type as EventAction_TypeName,      
c.EventAction_IdentifiedOn,    
case     
	when c.EventAction_Type=290007 then CONCAT(c.EventAction_Aggregate , SPACE(1) , '(' , c.Remarks_IfAny , ')' )   
	else c.EventAction_Aggregate    
end EventAction_Aggregate,     
c.Target_ResolutionDate,      
c.Remarks_IfAny as EventRemarks_IfAny,      
c.EventAction_Summary
from tbl_rera_agent_renewal_regdiarynumber a, tbl_rera_authdesk_agent_renewal_eventaction c       
where a.RenewalAgentDiaryNumber_Name=c.RelatedAgent_RenewalDiaryNumber  
and a.Agent_ID=c.Related_Agent_ID
and a.AgentRenewal_ID=c.Related_RenewalAgent_ID
and a.AgentRenewal_Year=c.Related_RenewalAgent_Year
and a.RenewalOrderSequence=c.Related_RenewalAgent_SequenceID     
and c.IsActive=1      
and a.IsActive=1
and a.Agent_ID=p_Agent_ID
) m 
LEFT OUTER JOIN 
tbl_rera_ldr_agent_reranumber_renewalregistration n
ON
m.Agent_ID=n.RelatedAgent_ID 
and m.AgentRenewal_ID=n.RelatedRenewalAgent_ID
and m.AgentRenewal_Year=n.RelatedRenewalAgent_Year
and m.RenewalOrderSequence=n.RenewalOrderSequence 
and n.IsActive=1 and n.IsPublicView=1;

end ;;
