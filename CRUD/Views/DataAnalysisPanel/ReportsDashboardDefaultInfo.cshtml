<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>


<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [2]
            }]
        });

        $('#btnExportToExcel').click(function () {
            window.location = BASE_URL + 'DataAnalysisPanel/RegisteredAgentsExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', 'a#modalOpenerAddressButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var agentDetailsModal = $(document).find('#myModal');
            $(agentDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var agentId = $.trim($(parentRow).find('input.hdnAgentID').val());
            agentId = parseInt(agentId);
            $.ajax({
                url: BASE_URL + 'MISrealestateagentToExcel/AgentQRcodeCertificateDetailsForRegisteredAgentsMIS',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': agentId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(agentDetailsModal).find('.modal-body').html(response);
                    $(agentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(agentDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(agentDetailsModal).modal('show');
        });


        var vcheckrangevaluedatemode = $("input[name='IsRangeValueDateInputFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").attr("style", "display:block");
            $("#rowDateFilterYY").attr("style", "display:none");
        }
        else if (vcheckrangevaluedatemode == '2') {
            $("#rowDateFilterDD").attr("style", "display:none");
            $("#rowDateFilterYY").attr("style", "display:block");
        }

        $(document).on('click', '.radio-applicationrangevaluedate', function (e) {
            if (this.value == '1') {
                $("#rowDateFilterDD").attr("style", "display:block");
                $("#rowDateFilterYY").attr("style", "display:none");
            }
            else if (this.value == '2') {
                $("#rowDateFilterDD").attr("style", "display:none");
                $("#rowDateFilterYY").attr("style", "display:block");
            }
        });

    });
</script>

<script>
    $(function () {
        $("#InputEntry_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#InputEntry_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#InputEntry_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#InputEntry_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());

                var start = $("#InputEntry_FromDate").datepicker("getDate");
                var end = $("#InputEntry_ToDate").datepicker("getDate");
                var days = (end - start) / (1000 * 60 * 60 * 24);
                if (days > 180) {
                    alert('Please select upto 180 days Only!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                $("#InputEntry_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>

