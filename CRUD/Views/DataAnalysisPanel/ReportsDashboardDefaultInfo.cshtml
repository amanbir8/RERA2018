<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerReportsPortaldetails);
    });

    function infohelpHandlerReportsPortaldetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Portal Reports Panel</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Web Reporting And Web Analysis of Project(s), Agent(s) and Complaint(s).<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> It displays the generation options that are defined for the respective report.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> It provides a comprehensive web reporting platforms.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
