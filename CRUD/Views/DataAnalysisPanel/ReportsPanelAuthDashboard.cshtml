<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        $(document).on("click", "a.info-help-details", infohelpHandlerReportsPortaldetails);
    });

    function infohelpHandlerReportsPortaldetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Portal Reports Panel</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Web Reporting And Web Analysis of Project(s), Agent(s) and Complaint(s).<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> It displays the generation options that are defined for the respective report.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> It provides a comprehensive web reporting platforms.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .collapsible {
        background-color: #999999; /*#7bb73f  #d9edf7;*/
        border-color: #bce8f1;
        color: white;
        cursor: pointer;
        padding: 10px;
        width: 95%;
        border: none;
        border-radius: .35rem;
        text-align: left;
        outline: none;
        font-size: 15px;
    }

    .active, .collapsible:hover, .collapsible:active {
        background-color: #31708f;
    }

    .collapsible:after {
        content: '\002B'; /*'\2212'*/
        color: white;
        font-weight: bold;
        float: right;
        margin-left: 5px;
    }

    .border-left-primary {
        border-left: .25rem solid #4e73df !important;
    }

    .sub-items a {
        border-left: .5rem solid #7bb73f;
    }

    .sub-items a:hover {
        border-left: .5rem solid #31708f;
        font-weight: bold;
    }

    li {
        margin: 0px;
        list-style: none;
        color: #999999;
    }

    .sub-items a {
        position: relative;
        display: block;
        margin: 0 auto;
        width: 92.9%;
        text-indent: 24px;
        line-height: 39px;
        background: #f5f5f5;
        margin-bottom: 1px;
        text-align: left;
        margin-top: 2px;
        padding-top: 0px;
    }

    .sub-items {
        display: none;
        background: #fff;
        margin: 0px;
        width: 100%;
    }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>


