    @if (User.Identity.IsAuthenticated)
    {
        <script>
        (function () {
            let isInternalNavigation = false;
            let isReloadAction = false;
            let autoLogoutSent = false;

            // Internal navigation (links/forms) should NOT trigger auto logout
            document.addEventListener("click", function (e) {
                if (e.target.closest("a")) {
                    isInternalNavigation = true;
                }
            }, true);

            document.addEventListener("submit", function () {
                isInternalNavigation = true;
            }, true);

            // Reload detection (F5 / Ctrl+R / Cmd+R)
            window.addEventListener("keydown", function (e) {
                const key = (e.key || "").toLowerCase();
                if (key === "f5" || ((e.ctrlKey || e.metaKey) && key === "r")) {
                    isReloadAction = true;
                }
            }, true);

            try {
                const originalReload = window.location.reload.bind(window.location);
                window.location.reload = function () {
                    isReloadAction = true;
                    return originalReload();
                };
            } catch (err) {
                
            }

            function sendAutoLogout(event) {
                if (autoLogoutSent) return;
                if (isInternalNavigation) return;
                if (isReloadAction) return;

                // If page goes to back-forward cache, do NOT logout
                if (event && event.type === "pagehide" && event.persisted) return;

                autoLogoutSent = true;

                const url = "/Account/AutoLogout";
                const payload = "userId=@User.Identity.GetUserId()";

                if (navigator.sendBeacon) {
                    const blob = new Blob([payload], {
                        type: "application/x-www-form-urlencoded; charset=UTF-8"
                    });
                    navigator.sendBeacon(url, blob);
                } else {
                    fetch(url, {
                        method: "POST",
                        headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
                        body: payload,
                        keepalive: true,
                        credentials: "same-origin"
                    });
                }
            }

            // Close/tab close/browser close path
            window.addEventListener("pagehide", sendAutoLogout, true);
            window.addEventListener("beforeunload", sendAutoLogout, true);
        })();
        </script>
    }

