@using Microsoft.AspNet.Identity

<script>
    $(document).ready(function () {
        
        var currentLoc = window.location.pathname;
        var currentLocName = window.location.pathname.split('/');
        var currentLink = currentLocName[3];
        $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
        $(document).find('a.btn-drpmenuitem[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff', 'background-color': '#064576' });
        switch (currentLink) {
            case 'Display_PromoterIndPrintForm':                
            case 'Display_PromoterOthIndPrintForm':
            case 'Display_PromoterTrackLitigationsDetails':
            case 'Display_PromoterDoc':
                $("#drpMenuButton_PromoterProfileAndDocuments").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectRegistrationDetails':
            case 'Display_ProjectLitigations':
            case 'Display_ProjectProfessionalDetails':
            case 'Display_ProjectSpecialBankAccount':
                $("#drpMenuButton_ProjectDetails").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectLandKhasraDetails':
            case 'Display_ProjectRegistrationFeeDetails':
                $("#drpMenuButton_LandandRegistrationFees").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectUpdatesCIIEFPDetails':
            case 'Display_ProjectPhotographDetails':
                $("#drpMenuButton_ProjectStatusUpdates").addClass('active').css({ 'color': '#fff' });
                break;
            default:
                $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
                break;
        }
    });
</script>

