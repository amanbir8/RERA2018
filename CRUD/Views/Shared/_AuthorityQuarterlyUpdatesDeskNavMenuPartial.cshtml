@using Microsoft.AspNet.Identity

<script>
    $(document).ready(function () {
        
        var currentLoc = window.location.pathname;
        var currentLocName = window.location.pathname.split('/');
        var currentLink = currentLocName[3];
        $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
        $(document).find('a.btn-drpmenuitem[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff', 'background-color': '#064576' });
        switch (currentLink) {            
            case 'Display_ProjectQUpdatesInventoryNumbersDetail':
            case 'Display_ProjectQUpdatesParkingNumbersDetail':                       
                $("#drpMenuButton_QuarterlyUpdatesProjectInventoryParkingDetails").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectQUpdatesStatusOfConstructionPhotographs':
            case 'Display_ProjectQUpdatesStatusOfInternalFacilities':
            case 'Display_ProjectQUpdatesStatusOfExternalFacilities':
                $("#drpMenuButton_QuarterlyUpdatesProjectStatusConstructionDetails").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectQUpdatesStatusOfApprovals':
            case 'Display_ProjectQUpdatesStatusOfApprovalRecords':            
                $("#drpMenuButton_ProjectQUpdatesStatusOfApprovals").addClass('active').css({ 'color': '#fff' });
                break;
            case 'Display_ProjectQUpdatesAAReportOnStatementAccounts':
            case 'Display_ProjectQUpdatesAAReportOnStatementAccountRecords':            
                $("#drpMenuButton_ProjectQUpdatesAAReportOnStatementAccounts").addClass('active').css({ 'color': '#fff' });
                break;
            default:
                $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
                break;
        }
    });
</script>

@if (Request.IsAuthenticated)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <fieldset class="col-md-12">
                    <legend class="my">View Quarterly Updates of Project Details</legend>
                    <div class="row" id="mygroupmenutabbtns">
                        <div class="form-group">
                            <div class="col-md-12">
                                <div class="dropdown pull-left" style="padding: 0 3px 0 0;">
                                    <button class="btn tab-btns btn-outline btn-primary dropdown-toggle" type="button" id="drpMenuButton_QuarterlyUpdatesProjectInventoryParkingDetails" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        List of Number/Booked Details <i class="fa fa-caret-down"></i>
                                    </button>
                                    <ul class="dropdown-menu" role="menu" aria-labelledby="drpMenuButton_QuarterlyUpdatesProjectInventoryParkingDetails">
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ProjectQUpdatesInventoryNumbersDetail", "Helpdesk")">List of Number and types of Apartments or Plots, Booked</a></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ProjectQUpdatesParkingNumbersDetail", "Helpdesk")">List of Number of Garages Booked</a></li>
                                    </ul>
                                </div>
                                <div class="dropdown pull-left" style="padding: 0 3px 0 0;">
                                    <button class="btn tab-btns btn-outline btn-primary dropdown-toggle" type="button" id="drpMenuButton_QuarterlyUpdatesProjectStatusConstructionDetails" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Status of the project <i class="fa fa-caret-down"></i>
                                    </button>
                                    <ul class="dropdown-menu" role="menu" aria-labelledby="drpMenuButton_QuarterlyUpdatesProjectStatusConstructionDetails">
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ProjectQUpdatesStatusOfConstructionPhotographs", "Helpdesk")">Status of Construction with Photographs</a></li>                                        
                                        <li role="separator" class="divider"></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ProjectQUpdatesStatusOfInternalFacilities", "Helpdesk")">Status of Construction of Internal Infrastructure and Common Areas</a></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ProjectQUpdatesStatusOfExternalFacilities", "Helpdesk")">Status of Construction of External Development and Facilities</a></li>
                                    </ul>                                    
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("Status of Approvals", "Display_ProjectQUpdatesStatusOfApprovals", "Helpdesk", null, new { @class = "btn btn-outline tab-btns btn-primary", @id = "drpMenuButton_ProjectQUpdatesStatusOfApprovals" })
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("Audited Annual Report on Statement of Accounts", "Display_ProjectQUpdatesAAReportOnStatementAccounts", "Helpdesk", null, new { @class = "btn btn-outline tab-btns btn-primary", @id = "drpMenuButton_ProjectQUpdatesAAReportOnStatementAccounts" })
                                </div>
                                <div class="pull-left">
                                    @Html.ActionLink("Action", "ProjectQUpdatesInfoEventInsert", "Helpdesk", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                </div>
                            </div>
                        </div>
                    </div>                    
                </fieldset>
            </div>
        </div>
    </div>
}

