<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="Real Estate Regulatory Authority">
        <meta name="author" content="Navdeep">
        <link rel="icon" href="@Url.Content("~/images/Rera_Design3b_03.png")">
        
        <title>Real Estate Regulatory Authority, Punjab</title>
        @Scripts.Render("~/bundles/modernizr")

        <!--CSS-->
        <link href="@Url.Content("~/css/roboto.css")" rel="stylesheet" type="text/css">
        <link href="@Url.Content("~/css/style-complaint.css")" rel="stylesheet" type="text/css">
        <!--CSS-->
        <link href="@Url.Content("~/js/simplelightbox.min.css")" rel="stylesheet" type="text/css">
        <!-- Bootstrap core CSS -->
        <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet">
        <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet">
        <link href="@Url.Content("~/css/style.css")" rel="stylesheet">
        <script src="@Url.Content("~/js/jquery.min.js")"></script>      
                        
    </head>
    <body style="background-color: #101c2a;">
    <!--Header Section-->
        <div class="contianer-fluid" style="padding-right: 15px;    padding-left: 15px;    margin-right: auto;    margin-left: auto;">
            <div class="row" style="margin-right: -15px;  margin-left: -15px;">
                <div class="col-md-12">&nbsp;</div>
                <div class="col-md-5"></div>
                <div class="col-md-2 text-center">  <a href="index.html"><img src="@Url.Content("~/images/Rera_Design3b_03.png")" alt="RERA logo" class="logo" title="REAL ESTATE REGULATORY AUTHORITY, PUNJAB"></a></div>
                <div class="col-md-5"></div>
            </div>
            <div class="row">
                <div class="col-md-12" style="">&nbsp;</div>
                <div class="col-md-3"></div>
                <div class="col-md-6 text-center" style="color: #fff; font-size: 15px;"> REAL ESTATE REGULATORY AUTHORITY, PUNJAB </div>
                <div class="col-md-3"></div>
            </div>
        </div>
        @RenderBody()
        <div class="contianer-fluid" style="padding-right: 15px;    padding-left: 15px;    margin-right: auto;    margin-left: auto;">
            <div class="row " style="margin-top: 10px;">
                <div class="text-md-center col-md-12">
                    <ul class="list-inline copyright" style="color: #fff; font-size: 11px;">
                        <li class="list-inline-item">© @DateTime.Now.Year RERA Punjab. All Rights Reserved</li>
                        <li class="list-inline-item">|</li>
                        <li class="list-inline-item">Designed and Developed by C-DAC Mohali</li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- jQuery -->
        <script src="@Url.Content("~/js/popper.js")"></script>
        <script src="@Url.Content("~/js/bootstrap.js")"></script>

        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)

    </body>
</html>