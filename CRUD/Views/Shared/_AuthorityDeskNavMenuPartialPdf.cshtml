        $(document).on('click', '#btnDownloadProjectZip', function () {
            var files = $('.project-file-url').map(function () {
                return $(this).data('url');
            }).get();

            confirmZipDownload(
                'Project',
                files,
                'Are you sure you want to download the Project documents as a ZIP?'
            );
        });

        $(document).on('click', '#btnDownloadTrashProjectZip', function () {
            var files = $('.projecttrash-file-url').map(function () {
                return $(this).data('url');
            }).get();

            confirmZipDownload(
                'ProjectTrash',
                files,
                'Are you sure you want to download the deleted Project documents as a ZIP?'
            );
        });

        $(document).on('click', '#btnDownloadPromoterZip', function () {
