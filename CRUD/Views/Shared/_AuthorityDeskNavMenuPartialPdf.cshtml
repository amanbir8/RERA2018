        $(document).on('click', 'a.projectDocsModalOpener', function (e) {
            e.preventDefault();
            var projectDocsModal = $(document).find('#projectDocsModal');
            $(projectDocsModal).find('.modal-body').html('');
            $(projectDocsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'ProjectPrintForm/GetProjectDocumentSelection',
                dataType: 'HTML',
                type: 'GET',
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDocsModal).find('.modal-body').html(response);
                    var wrapper = $(projectDocsModal).find('#projectDocSelectionWrapper');
                    var diaryNo = $.trim(wrapper.data('diary-number'));
                    var projectName = $.trim(wrapper.data('project-name'));
                    $(projectDocsModal).find('.modal-title').find('.title-project-details')
                        .html(projectName + ' (' + diaryNo + ')');
                }
            });
            $(projectDocsModal).modal('show');
        });

        function downloadZipWithProgress(docType, files) {

            if (!files || files.length === 0) {
                alert('No documents available.');
                return;
            }

            var $modal = $('#zipProgressModal');
            var $bar = $('#zipProgressBar');
            var $label = $('#zipProgressLabel');

            $bar.css('width', '0%').text('0%');
            $label.text('Preparing ZIP...');

            //$modal.modal({
            //    backdrop: 'static',
            //    keyboard: false
            //});

            $modal.css('display', 'block');

            var body = new URLSearchParams();

            body.append('docType', docType);

            files.forEach(function (f) {
                body.append('files', f);
            });

            // STEP 1: Start ZIP creation
            fetch(
                BASE_URL + 'ProjectPrintForm/StartZipDownload',
                {
                    method: 'POST',
                    body: body
                }
            )
                .then(function (response) {

                    if (!response.ok) {
                        throw new Error(
                            'Unable to start ZIP creation.'
                        );
                    }

                    return response.json();
                })
                .then(function (result) {

                    if (!result.success) {
                        throw new Error(
                            result.message ||
                            'Unable to start download.'
                        );
                    }

                    var jobId = result.jobId;

                    // STEP 2: Poll progress
                    var progressTimer =
                        setInterval(function () {

                            $.ajax({
                                url:
                                    BASE_URL +
                                    'ProjectPrintForm/GetZipDownloadProgress',

                                type: 'GET',

                                data: {
                                    jobId: jobId
                                },

                                dataType: 'json',

                                success: function (progress) {

                                    if (!progress.success) {
                                        clearInterval(progressTimer);

                                        //$modal.modal('hide');
                                        closeZipProgressModal();

                                        alert(
                                            progress.message ||
                                            'Progress not available.'
                                        );

                                        return;
                                    }

                                    var percent =
                                        progress.percent || 0;

                                    $bar
                                        .css(
                                            'width',
                                            percent + '%'
                                        )
                                        .text(
                                            percent + '%'
                                        );

                                    $label.text(
                                        progress.status ||
                                        'Creating ZIP...'
                                    );

                                    // STEP 3: ZIP finished
                                    if (progress.completed) {

                                        clearInterval(
                                            progressTimer
                                        );

                                        if (progress.error) {

                                            $modal.modal(
                                                'hide'
                                            );

                                            alert(
                                                'ZIP creation failed.'
                                            );

                                            return;
                                        }

                                        $bar
                                            .css(
                                                'width',
                                                '100%'
                                            )
                                            .text('100%');

                                        $label.text(
                                            'ZIP ready. Starting download...'
                                        );

                                        setTimeout(function () {

                                            // Start the ZIP download
                                            window.location.href =
                                                BASE_URL +
                                                'ProjectPrintForm/DownloadCompletedZip?jobId=' +
                                                encodeURIComponent(jobId);

                                            // Close progress modal and restore PDF modal scrolling
                                            setTimeout(function () {
                                                closeZipProgressModal();
                                            }, 1000);

                                        }, 500);
                                    }
                                },

                                error: function () {
                                    clearInterval(
                                        progressTimer
                                    );
                                    closeZipProgressModal();
                                    alert(
                                        'Unable to check ZIP progress.'
                                    );
                                }
                            });

                        }, 500);
                })
                .catch(function (error) {
                    closeZipProgressModal();
                    alert(
                        'Unable to start ZIP download.'
                    );
                });
        }
 


