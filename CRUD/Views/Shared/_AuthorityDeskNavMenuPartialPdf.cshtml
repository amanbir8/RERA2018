                    Document(s)
                    <a href="javascript:void(0);" class="title-project-details"></a>
                </h4>

            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ZIP Download Progress Overlay -->
