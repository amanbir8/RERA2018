@using Microsoft.AspNet.Identity
<style>
    .zip-progress-floating {
        display: none;
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: 360px;
        z-index: 999999 !important;
        pointer-events: none;
    }

    .zip-progress-box {
        background: #fff;
        padding: 22px 25px;
        border-radius: 6px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.35);
        text-align: center;
        border: 1px solid #ddd;
    }

    .zip-progress-label {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .zip-progress {
        height: 22px;
        margin-bottom: 0;
    }

    #zipProgressBar {
        line-height: 22px;
        font-weight: bold;
    }
</style>


@if (Request.IsAuthenticated)
{
    <div class="row">
        <div class="col-md-12">
            <div class="pull-left">
                <a href="javascript:void(0);" class="btn btn-outline tab-btns btn-primary projectDocsModalOpener">PDF</a>
            </div>
        </div>
    </div>
}


