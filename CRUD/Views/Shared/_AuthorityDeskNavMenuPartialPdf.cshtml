        $(document).on('click', '#btnDownloadApprovalZip', function () {
            var files = $('.approval-file-url').map(function () {
                var url = $(this).data('url');
                var name = $(this).data('name');

                return name + '||' + url;
            }).get();

            confirmZipDownload(
                'Approval',
                files,
                'Are you sure you want to download the NOC/Approval documents as a ZIP?'
            );
        });


        function confirmZipDownload(docType, files, message) {

            if (!files || files.length === 0) {
                alert('No documents available.');
                return;
            }

            // Browser Yes/No confirmation
            var confirmed = confirm(message);
            if (!confirmed) {
                return;
            }
            downloadZipWithProgress(docType, files);
        }

        function closeZipProgressModal() {

            $('#zipProgressModal').css('display', 'none');

