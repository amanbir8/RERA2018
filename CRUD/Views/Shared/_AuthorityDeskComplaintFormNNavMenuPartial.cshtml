@using Microsoft.AspNet.Identity
<script>
    $(document).ready(function () {
        //var currentLoc = window.location.pathname;
        //$(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });

        var currentLoc = window.location.pathname;
        var currentLocName = window.location.pathname.split('/');
        var currentLink = currentLocName[3];
        $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
        $(document).find('a.btn-drpmenuitem[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff', 'background-color': '#064576' });
        switch (currentLink) {
            case 'Display_ComplaintFormN':
            case 'Display_FormNaddmoreComplainant':
            case 'Display_FormNaddmoreRespondent':
                $("#drpMenuButton_ComplaintDetails").addClass('active').css({ 'color': '#fff' });
                break;
            case 'FormN_PreHearingDateAdd':
            case 'FormN_InterimOrderHearingAdd':
            case 'FormN_InterimOrderHearingDate':
            case 'FormN_CaseTransferDetails':
            case 'FormN_OrderJudgmentDetails':
                $("#drpMenuButton_HearingDateDetails").addClass('active').css({ 'color': '#fff' });
                break;
            default:
                $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
                break;
        }
    });
</script>
@if (Request.IsAuthenticated)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <fieldset class="col-md-12">
                    <legend class="my">View Complaint Form-N Details</legend>
                    <div class="row" id="mygroupmenutabbtns">
                        <div class="form-group">
                            <div class="col-md-12">
                                <div class="dropdown pull-left" style="padding: 0 3px 0 0;">
                                    <button class="btn tab-btns btn-outline btn-primary dropdown-toggle" type="button" id="drpMenuButton_ComplaintDetails" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Complaint Details <i class="fa fa-caret-down"></i>
                                    </button>
                                    <ul class="dropdown-menu" role="menu" aria-labelledby="drpMenuButton_ComplaintDetails">
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_ComplaintFormN", "HelpdeskComplaint")">Complaint Details</a></li>
                                        <li role="separator" class="divider"></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_FormNaddmoreComplainant", "HelpdeskComplaint")">Additional Applicant Details</a></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("Display_FormNaddmoreRespondent", "HelpdeskComplaint")">Additional Respondent Details</a></li>
                                    </ul>
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
