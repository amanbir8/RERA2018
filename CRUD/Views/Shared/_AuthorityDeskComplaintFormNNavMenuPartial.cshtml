                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("MAP", "Map_AdvocatesN", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("Fee Details", "Display_ComplaintFeeFormN", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("PDF Print", "Print_ComplaintFormNdeskDetails", "ComplaintPrintForm", null, new { @class = "btn btn-outline tab-btns btn-primary", @target = "_blank" })
                                </div>
                                <div class="pull-left" style="padding: 0 3px 0 0;">
                                    @Html.ActionLink("Communications", "Display_ListCommunicationLogFormN", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                </div>
                                @*<div class="pull-left" style="padding: 0 3px 0 0;">
                                        @Html.ActionLink("Complaint Hearing Details", "FormN_PreHearingDateAdd", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary", @id = "drpMenuButton_HearingDateDetails" })
                                    </div>*@
                                <div class="dropdown pull-left" style="padding: 0 3px 0 0;">
                                    <button class="btn tab-btns btn-outline btn-primary dropdown-toggle" type="button" id="drpMenuButton_HearingDateDetails" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        Complaint Hearing Details <i class="fa fa-caret-down"></i>
                                    </button>
                                    <ul class="dropdown-menu" role="menu" aria-labelledby="drpMenuButton_HearingDateDetails">
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("FormN_PreHearingDateAdd", "HelpdeskComplaint")">Complaint Hearing Details</a></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("FormN_OrderJudgmentDetails", "HelpdeskComplaint")">Order & Judgments</a></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("FormN_CaseAssignment", "HelpdeskComplaint")">Case Assignment/Institution Details</a></li>
                                        <li role="separator" class="divider"></li>
                                        <li role="presentation"><a role="menuitem" class="btn-drpmenuitem" tabindex="-1" href="@Url.Action("FormN_CaseTransferDetails", "HelpdeskComplaint")">Case Transfer Details</a></li>
                                    </ul>
                                </div>
                                <div class="pull-left">
                                    @Html.ActionLink("Action", "FormNInfoEventInsert", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                </div>
                            </div>
                        </div>
                    </div>

                    @*@Html.ActionLink("Complaint Details", "Display_ComplaintFormN", "HelpdeskComplaint", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                        @Html.ActionLink("List of enclosures in support of the complaint", "Display_ListEnclosuresDocFormN", "HelpdeskComplaint", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                        @Html.ActionLink("Fee Details", "Display_ComplaintFeeFormN", "HelpdeskComplaint", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                        @Html.ActionLink("PDF Print", "Print_ComplaintFormNdeskDetails", "ComplaintPrintForm", null, new { @class = "btn tab-btns btn-outline btn-primary", @target = "_blank" })
                        @Html.ActionLink("Communications", "Display_ListCommunicationLogFormN", "HelpdeskComplaint", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                        @Html.ActionLink("Complaint Hearing Details", "FormN_PreHearingDateAdd", "HelpdeskComplaint", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                        @Html.ActionLink("Action", "FormNInfoEventInsert", "HelpdeskComplaint", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                        </div>
                        </div>
                        </div>*@
                </fieldset>
            </div>
        </div>
    </div>
