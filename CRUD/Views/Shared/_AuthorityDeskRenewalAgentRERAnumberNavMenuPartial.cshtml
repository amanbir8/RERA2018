@using Microsoft.AspNet.Identity
<script>
    $(document).ready(function () {
        var currentLoc = window.location.pathname;
        $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
    });
</script>
@if (Request.IsAuthenticated)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <fieldset class="col-md-12">
                    <legend class="my">RERA Registration Number (Renewal of Registration) Application Details</legend>
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-12"> 
                                @Html.ActionLink("Add RERA Registration Number", "Add_RenewalAgentRERAregistrationNumber", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })                                                                                               
                                @Html.ActionLink("Upload RERA Certificate", "Add_RenewalAgentRERAcertificateDetails", "HelpdeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                                @Html.ActionLink("Registration History", "Display_RenewalAgent_RefRegistrations_RERAinfoDesk", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })                                
                                @Html.ActionLink("Action", "RenewalAgentRERAnumberInfoEventInsert", "HelpdeskAgent", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
}

