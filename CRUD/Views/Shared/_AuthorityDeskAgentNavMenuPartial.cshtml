@using Microsoft.AspNet.Identity
<script>
    $(document).ready(function () {
        var currentLoc = window.location.pathname;
        $(document).find('a.tab-btns[href="' + currentLoc + '"]').addClass('active').css({ 'color': '#fff' });
    });
</script>
@if (Request.IsAuthenticated)
{
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <fieldset class="col-md-12">
                    <legend class="my">View Real Estate Agent Application Details</legend>
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-12">                              
                                @Html.ActionLink("Agent Profile", "Display_AgentIndProfile", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })                                                                                               
                                @Html.ActionLink("Payment Details", "Display_AgentPaymentDetails", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                                @Html.ActionLink("Agent Documents", "Display_AgentDocumentDetails", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                                @Html.ActionLink("RERA Registration to other State/UT", "Display_AgentOtherStateUT_RERA", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })                                
                                @Html.ActionLink("Registration History", "Display_AgentRefRegistrations_RERA", "HelpDeskAgent", null, new { @class = "btn tab-btns btn-outline btn-primary" })
                                @Html.ActionLink("Check List Sheet", "AgentInfoCheckListDisplay", "HelpdeskAgent", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                                @Html.ActionLink("Action", "AgentInfoEventInsert", "HelpdeskAgent", null, new { @class = "btn btn-outline tab-btns btn-primary" })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>
}

