<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="Real Estate Regulatory Authority">
        <meta name="author" content="Navdeep">
        <link rel="icon" href="@Url.Content("~/images/Rera_Design3b_03.png")">
        
        <title>Real Estate Regulatory Authority, Punjab</title>        
        @Scripts.Render("~/bundles/modernizr")

        <!--CSS-->
        <link href="@Url.Content("~/css/roboto.css")" rel="stylesheet" type="text/css">
        <!--CSS-->
        <link href="@Url.Content("~/js/simplelightbox.min.css")" rel="stylesheet" type="text/css">
        <!-- Bootstrap core CSS -->
        <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet">
        <link href="@Url.Content("~/css/font-awesome.min.css")" rel="stylesheet">
        <link href="@Url.Content("~/css/style.css")" rel="stylesheet">
        <script src="@Url.Content("~/js/jquery.min.js")"></script>    
                        
    </head>
    <body style="background-color: #101c2a;" data-sync-url="@Url.Content("../")">        
        <!-- loader text -->
        <div class="loader-gif-img" style="display:none;">
            <div>                
                <h1>Loading...</h1>
            </div>
        </div>
        <!-- /loader text -->
        <!--Header Section-->
        @RenderBody()
        @*<hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - RERA Punjab. All Rights Reserved | Designed and Developed by C-DAC Mohali</p>
        </footer>*@
        <!-- /#page-wrapper -->
        <!-- /#wrapper -->
        <script>
            /** function to show Ajax-loader */
            function startPreloader() {
                $(".loader-gif-img").css("display", "block");
            }
            /** function to hide Ajax-loader */
            function stopPreloader() {
                $(".loader-gif-img").css("display", "none");
            }
        </script>



        <!-- jQuery -->
        <script src="@Url.Content("~/js/popper.js")"></script>
        <script src="@Url.Content("~/js/bootstrap.js")"></script>

        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)

</body>
</html>