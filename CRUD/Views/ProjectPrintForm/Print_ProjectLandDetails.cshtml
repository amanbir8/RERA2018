@model CRUD.Models.ProjectPrint.ClsPrp_PrmProject_Print_ProjectLandDetails

@{    
    Layout = null;
}

<div id="wrapper">   
    <div class="row">
        <div class="col-lg-12">           
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                @if (Model.prpProjectDiaryNumberDetails != null)
                {
                    foreach (var item in Model.prpProjectDiaryNumberDetails)
                    {
                        var varDate = System.DateTime.Now.Date;
                        <tr>
                            <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>                            
                            <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                        </tr>
                        <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Application Form (Project Land Details)")</b></td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr>
                            <td width="25%">@Html.DisplayName("Project Diary Number")</td>
                            <td width="35%">@Html.DisplayFor(modelitem => item.PromoterRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.zipProjectName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("District")</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.zipProjectDistrictName, new { htmlAttributes = new { @class = "form-control" } })
                            </td>                            
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.zipPromoterName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.zipPromoterName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br/><br /></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                @if (Model.prpongoing != null)
                {
                    foreach (var item in Model.prpongoing)
                    {
                        <tr><td colspan="4"><h4>@Html.DisplayName("Project Land Details(in sqr mtrs only)")</h4></td></tr>
                        <tr>
                            <td colspan="2">@Html.DisplayName("Total Area of Land Proposed to be developed")</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_TobeDeveloped_Area_Total, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>                            
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_TobeDeveloped_TotalOpenArea, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_TobeDeveloped_TotalOpenArea, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td> 
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_TobeDeveloped_TotalCoveredArea, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_TobeDeveloped_TotalCoveredArea, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Area of Land Under various components(in sqr mtrs only)")</h4></td></tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_ResidentialGroupHousing, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_ResidentialGroupHousing, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>                           
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_ResidentialPlotted, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_ResidentialPlotted, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>                            
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_Commercial, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_Commercial, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_Industrial, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_Industrial, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_B_column, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_B_column, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_C_column, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_C_column, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedLand_Area_A_column, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.ProposedLand_Area_A_column, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" sqr mtrs")
                            </td>
                            <td></td>                            
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Other Details")</h4></td></tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedProjectLand_StartPoint_Longitude, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.ProposedProjectLand_StartPoint_Longitude, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedProjectLand_StartPoint_Latitude, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.ProposedProjectLand_StartPoint_Latitude, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedProjectLand_EndPoint_Longitude, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.ProposedProjectLand_EndPoint_Longitude, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.LabelFor(modelitem => item.ProposedProjectLand_EndPoint_Latitude, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.ProposedProjectLand_EndPoint_Latitude, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="2">@Html.DisplayName("Project Land Encumbrances (Yes/No)")</td>
                            <td>
                                @if (item.IsLandEncumbrances_IfAny == "Y")
                                {
                                    @Html.DisplayName("Yes")

                                }
                                else
                                {
                                    @Html.DisplayName("No")
                                }
                            </td>
                            <td></td>
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Name of Villages/ Mohalla/ Towns Details")</h4></td></tr>
                        <tr>
                            <td>@Html.DisplayName("Name of Villages/ Mohalla/ Towns")</td>
                            <td colspan="3">@Html.DisplayFor(modelitem => item.Name_of_Villages, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">(Authorized Signatory)</td></tr>
            </table>                                      
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->


