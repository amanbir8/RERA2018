@model CRUD.Models.ProjectPrint.ClsPrp_PrmProject_Print_ProjectSpecialBankAccountDetails

@{    
    Layout = null;
}

<div id="wrapper">   
    <div class="row">
        <div class="col-lg-12">           
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                @if (Model.prpProjectDiaryNumberDetails != null)
                {
                    foreach (var item in Model.prpProjectDiaryNumberDetails)
                    {
                        var varDate = System.DateTime.Now.Date;
                        <tr>
                            <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>                            
                            <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                        </tr>
                        <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Application Form (Project Special Bank Account Details)")</b></td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr>
                            <td width="25%">@Html.DisplayName("Project Diary Number")</td>
                            <td width="35%">@Html.DisplayFor(modelitem => item.PromoterRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.zipProjectName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("District")</td>
                            <td>
                                @Html.DisplayFor(modelitem => item.zipProjectDistrictName, new { htmlAttributes = new { @class = "form-control" } })
                            </td>                            
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.zipPromoterName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.zipPromoterName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br/><br /></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                @if (Model.prpongoing != null)
                {
                    foreach (var item in Model.prpongoing)
                    {
                        <tr><td colspan="4"><h4>@Html.DisplayName("Special Bank Account Details")</h4></td></tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.Bank_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="2">@Html.DisplayFor(modelitem => item.Bank_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>                            
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.Branch_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="2">@Html.DisplayFor(modelitem => item.Branch_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td> 
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.Bank_AccountNumber, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="2">@Html.DisplayFor(modelitem => item.Bank_AccountNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.A_column, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="2">
                                @if (item.A_column != "")
                                {
                                    @Html.DisplayFor(modelitem => item.A_column, new { htmlAttributes = new { @class = "form-control" } })
                                }
                                else
                                {
                                    @Html.DisplayName("--")
                                }                                
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.Bank_IFSC_Code, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="2">@Html.DisplayFor(modelitem => item.Bank_IFSC_Code, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>                           
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Bank Address Details")</h4></td></tr>
                        <tr>
                            <td>@Html.LabelFor(modelitem => item.Bank_AddressLine1, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.Bank_AddressLine1, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.LabelFor(modelitem => item.Bank_AddressLine2, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.Bank_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })</td>                           
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("District & State")</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Bank_AddressDistrictCode, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(", ")
                                @Html.DisplayFor(modelItem => item.Bank_AddressStateCode, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                            <td>@Html.LabelFor(modelitem => item.Bank_AddressPIN, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelitem => item.Bank_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>                        
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Scan Copy of Cancelled Cheque")</h4></td></tr>
                        @*<tr><td colspan="4">@Html.DisplayFor(modelItem => item.ImageCancelledCheque_FileName)@Html.DisplayFor(modelItem => item.ImageCancelledCheque_FilePath)</td></tr>*@
                        <tr>
                            <td colspan="4" style="text-align:left;">
                                @{
                                    var StrPathImg1 = item.ImageCancelledCheque_FileName;
                                    var StrPathImg2 = item.ImageCancelledCheque_FilePath;
                                    var StrPathImg = StrPathImg1 + StrPathImg2;
                                }
                                <itext creationdate="@DateTime.Now.ToString()" producer="RazorPDF">
                                    <img height="200" width="500"  style="border:1px solid;" src="@Context.Server.MapPath("~/" + StrPathImg)" />                                   
                                </itext>                                
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">(Authorized Signatory)</td></tr>
            </table>                                      
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->


