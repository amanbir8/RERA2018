                        </td>

                        <td>
                            @doc.Remarks_IfAny
                        </td>
                        <td>
                            <a href="@StrcallBaseURL/@doc.PromoterDoc_FilePath.Replace("\\", "/").TrimStart('/')"target="_blank">View</a>
                        </td>
                    </tr>
                }
            </table>
        }
        else
        {
            <table cellpadding="8" cellspacing="0" class="section-table">
                <tr>
                    <td class="rpt-pdf-display-border-box" style="font-weight:bold; text-align:center;">
                        Promoter Document(s)
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px;text-align:center;font-style:italic;">
                        No promoter documents available.
                    </td>
                </tr>
            </table>
        }


