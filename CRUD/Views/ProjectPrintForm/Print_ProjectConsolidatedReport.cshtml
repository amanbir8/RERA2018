    @* ===================== PROJECT SECTION continued: Litigations / Documents / Approvals / Payments ===================== *@
    @if (showProject)
    {
        <div class="pagebreak"></div>
        if (Model.Litigations != null && Model.Litigations.prpongoing != null && Model.Litigations.prpongoing.Count > 0)
        {
            <table cellpadding="8" cellspacing="0" class="section-table" style="width: 100%; margin-bottom: 25px; page-break-inside: avoid;">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="3" style="font-weight:bold; text-align:center;">Project Litigations Details</td>
                </tr>
                <tr>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight: bold; width: 40%;">Case Title</td>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight: bold; width: 30%;">Case Number</td>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight: bold; width: 30%;">Authority / Forum Name</td>
                </tr>
                @foreach (var lit in Model.Litigations.prpongoing)
                {
                    <tr>
                        <td style="padding: 8px;">@(!string.IsNullOrWhiteSpace(lit.Case_Title) ? lit.Case_Title : "N/A")</td>
                        <td style="padding: 8px;">@(!string.IsNullOrWhiteSpace(lit.Case_Number) ? lit.Case_Number : "N/A")</td>
                        <td style="padding: 8px;">@(!string.IsNullOrWhiteSpace(lit.AuthorityForumName_CasePendingResolved) ? lit.AuthorityForumName_CasePendingResolved : "N/A")</td>
                    </tr>
                }
            </table>
        }
        else
        {
            <table cellpadding="8" cellspacing="0" class="section-table" style="width: 100%; margin-bottom: 25px; page-break-inside: avoid;">
                <tr>
                    <td class="rpt-pdf-display-border-box" style="font-weight:bold; text-align:center;">Project Litigations Details</td>
                </tr>
                <tr>
                    <td class="rpt-pdf-display-border-box" style="padding: 8px; text-align: center; font-style: italic; color: black;">
                        No litigation details reported for this project.
                    </td>
                </tr>
            </table>
        }
        <div class="pagebreak"></div>
        if (Model.Documents != null && Model.Documents.prpongoing != null && Model.Documents.prpongoing.Count > 0)
        {
            <table cellpadding="8" cellspacing="0" class="section-table" style="width: 100%; margin-bottom: 25px; page-break-inside: avoid;">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="4" style="font-weight:bold; text-align:center;">Project Documents</td>
                </tr>
                <tr>
                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 20%; padding: 12px 15px;">
                        Documents
                    </th>
                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 35%; padding: 12px 15px;">
                        Reference Number / Date
                    </th>
                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 25%; padding: 12px 15px;">
                        Remarks
                    </th>
                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 20%; padding: 12px 15px;">
                        Links
                    </th>
                </tr>
                @foreach (var group in Model.Documents.prpongoing.GroupBy(x => x.ProjectDoc_InfoName))
                {
                    var groupFirst = group.FirstOrDefault();
                    <tr>
                        <td style="vertical-align: top; padding: 15px;">
                            @group.Key
                        </td>
                        <td style="vertical-align: top; padding: 15px;">
                            @(groupFirst != null && !string.IsNullOrWhiteSpace(groupFirst.ProjectDoc_ReferenceNumber) ? groupFirst.ProjectDoc_ReferenceNumber : "NA")
                            @(groupFirst != null && groupFirst.ProjectDoc_IssueDate != null ? " / " + Convert.ToDateTime(groupFirst.ProjectDoc_IssueDate).ToString("dd/MM/yyyy") : "")
                        </td>
                        <td style="vertical-align: top; padding: 15px;">
                            @(groupFirst != null && !string.IsNullOrWhiteSpace(groupFirst.Remarks_IfAny) ? groupFirst.Remarks_IfAny : "NA")
                        </td>
                        <td class="label-cell" style="vertical-align: top; padding: 15px;">
                            @{
                                // Get only the items in this group that actually have a file attached
                                var validFiles = group.Where(x => !string.IsNullOrWhiteSpace(x.ProjectDoc_FileName)).ToList();
                            }
                            @if (validFiles.Any())
                            {
                                int totalFiles = validFiles.Count;

                                for (int i = 0; i < totalFiles; i++)
                                {
                                    var doc = validFiles[i];

                                    @*<a href="@Url.Content("~/" + doc.ProjectDoc_FilePath.Replace("\\", "/").TrimEnd('/') + "/" + doc.ProjectDoc_FileName.TrimStart('/'))"
                                           target="_blank">
                                            View
                                        </a>*@
                                    <a href="@StrcallBaseURL/@doc.ProjectDoc_FilePath.Replace("\\", "/").TrimStart('/')" target="_blank">View</a>

                                    if (i < totalFiles - 1)
                                    {
                                        <br />
                                        <br />
                                    }
                                }
                            }
                            else
                            {
                                <span>Not Uploaded</span>
                            }
                        </td>
                    </tr>
                }
            </table>
        }
        if (Model.Approvals != null && Model.Approvals.prpongoing != null && Model.Approvals.prpongoing.Count > 0)
        {
            <table cellpadding="8" cellspacing="0"
                   class="section-table" style="width:100%; table-layout:fixed;">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="5" style="font-weight:bold; text-align:center;">Project Approvals, Performa & Other Documents</td>
                </tr>
                <tr>
                    @*<th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 30%; padding: 12px 15px;">Documents</th>
                        <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; padding: 12px 15px;">Category</th>
                        <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; padding: 12px 15px;">Status</th>
                        <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; padding: 12px 15px;">Expected/Planned Date of Receipt</th>
                        <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 20%; padding: 12px 15px;">Links</th>*@
                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 20%; padding: 12px 15px;">
                        Documents
                    </th>

                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 15%; padding: 12px 15px;">
                        Category
                    </th>

                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 15%; padding: 12px 15px;">
                        Status
                    </th>

                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 30%; padding: 12px 15px;">
                        Expected/Planned Date of Receipt
                    </th>

                    <th class="rpt-pdf-display-border-top-box" style="font-weight:bold; text-align:left; width: 20%; padding: 12px 15px;">
                        Links
                    </th>
                </tr>
                @foreach (var app in Model.Approvals.prpongoing)
                {
                    <tr>
                        <td style="word-wrap:break-word;">
                            @app.DocumentType_Name
                        </td>
                        <td style="word-wrap:break-word;">@app.DocumentType_CategoryName</td>
                        <td style="word-wrap:break-word;">@app.DocumentType_Status</td>
                        <td style="word-wrap:break-word;">@(app.Date_ApplicationPlannedorExpectedReceipt?.ToString("dd/MM/yyyy"))</td>
                        <td style="word-wrap:break-word;">
                            @if (!string.IsNullOrWhiteSpace(app.DocumentType_FileName))
                            {
                                @*<a href="@Url.Content("~/" + app.DocumentType_FilePath.Replace("\\", "/") + app.DocumentType_FilePath)"

                                       target="_blank">
                                        View
                                    </a>*@
                                <a href="@StrcallBaseURL/@app.DocumentType_FileName.Replace("\\", "/").TrimEnd('/')/@app.DocumentType_FilePath.TrimStart('/')"
                                   target="_blank">
                                    View
                                </a>
                            }
                            else
                            {
                                <span>Not Uploaded</span>
                            }
                        </td>
                    </tr>
                }
            </table>


        }
    }

