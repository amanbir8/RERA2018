@using System.Linq
<link href="@Url.Content("~/css/font-awesome-4.7.0/css/font-awesome.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/css/bootstrap-5.3.3-dist/js/bootstrap.bundle.js")"></script>
@model CRUD.Models.ProjectPrintForm.ClsPrp_PrmProject_Print_ConsolidatedReport
@{
    Layout = null;

    string reportType = ViewBag.ReportType as string ?? "All";

    bool showProject = reportType == "Project" || reportType == "All";

    bool showPromoter = reportType == "Promoter" || reportType == "All";

    bool showQuaterly = reportType == "Quaterly" || reportType == "All";

    // Promoter type
    int promoterType = 0;
    if (ViewBag.PromoterType != null)
    {
        promoterType = Convert.ToInt32(ViewBag.PromoterType);
    }

    bool isIndividualPromoter = promoterType == 1;
    bool isOtherThanIndividualPromoter = promoterType == 2;


    var StrcallBaseURL = System.Configuration.ConfigurationManager.AppSettings["imagewebBaseURL"].ToString();

}
<!DOCTYPE html>
<html>
<head>
    <style>

        .header {
            text-align: center;
            margin-bottom: 15px;
        }

        .rpt-pdf-display-border-top-box {
            padding: 9px 9px 9px 9px;
            font-size: 15px;
            background-color: lightgrey;
            border: 1px solid white;
        }

        .rpt-pdf-display-border-box {
            padding: 9px;
            border: 1px solid #4CAF50;
            text-align: justify;
            /*font-size: 15px;*/
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
            color: #000000;
            line-height: 1.4;
        }

        .pagebreak {
            page-break-before: always;
        }

        a {
            text-decoration: underline;
            font-weight: bold;
        }

        .section-table {
            width: 100%;
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .header-cell {
            font-weight: bold;
            font-size: 14px;
        }

        .label-cell {
            width: 35%;
        }

        .section-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <table style="width: 100%; text-align:center;" cellpadding="0" cellspacing="0">
        <tr><td style="margin-bottom:0; font-size: 1.3em;font-weight: bold;">REAL ESTATE REGULATORY AUTHORITY, PUNJAB</td></tr>
        <tr><td style="margin-bottom:0; font-size: 1em;font-weight: bold;">Plot No.3, Block B, 1<sup>st</sup> Floor, Madhya Marg, Sector 18A, Chandigarh</td></tr>
    </table>

    <div class="header">
        <h2> Form-A</h2>
    </div>

    @* ===================== PROJECT SECTION (reportType == "Project" or "All") ===================== *@
    @if (showProject && Model.Registration != null && Model.Registration.prpongoing != null && Model.Registration.prpongoing.Count > 0)
    {
        var proj = Model.Registration.prpongoing.FirstOrDefault();
        var land = Model.Land != null && Model.Land.prpongoing != null ? Model.Land.prpongoing.FirstOrDefault() : null;
        var diary = Model.Registration.prpProjectDiaryNumberDetails != null ? Model.Registration.prpProjectDiaryNumberDetails.FirstOrDefault() : null;

        Func<int?, string> getZoneName = z =>
        {
            switch (z)
            {
                case 1: return "Zone 1 - Master Plan Area of S.A.S. Nagar, New Chandigarh and Zirakpur.";
                case 2: return "Zone 2 - Master Plan Area of Kharar, Dera Bassi and Banur.";
                case 3: return "Zone 3 - Ludhiana (within and outside municipal limits upto 15 Kms.)";
                case 4: return "Zone 4 - Jalandhar (within and outside municipal limits upto 10 Kms.)";
                case 5: return "Zone 5 - Amritsar, Patiala, Khanna, Rajpura, Mandi Gobindgarh, Sirhind and Phagwara within and outside municipal limits upto 7 Kms and NH-1 upto 2 Kms on both sides, outside the potential zone.";
                case 6: return "Zone 6 - Bathinda, Moga, Batala, Pathankot, Barnala, Malerkotla, Morinda, Hoshiarpur, within and outside municipal limits upto 5 Kms.";
                case 7: return "Zone 7 - Sangrur, Sunam Udham Singh Wala, Nabha, Faridkot, Kotkapura, Ferozepur, Malout, Abohar, Sri Muktsar Sahib, Kapurthala, Nawanshahr, Rupnagar, Taran Taran, Gurdaspur, Samana, Jagraon, Mansa, Lalru, Kurali within and outside municipal limits upto 3 Kms and all other NH (except NH 1)/SH/Scheduled Roads upto 1 Kms both sides, outside the potential zone.";
                case 8: return "Zone 8 - Rest of Punjab.";
                default: return z != null ? z.ToString() : "NA";
            }
        };


        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Project details</td>

            </tr>
            <tr>
                <td colspan="2" class="header-cell">General Details</td>
            </tr>
            <tr>
                <td class="label-cell">Application Reference Number (ARN):</td>
                <td>@(diary != null ? diary.PromoterRegDiaryNumber_Name : "NA")</td>
            </tr>
            <tr>
                <td class="label-cell">Project Name:</td>
                <td>@proj.Project_Name</td>
            </tr>
            <tr>
                <td class="label-cell">Existing/New Registration:</td>
                <td>
                    @if (proj.IsAlready_RERANumber != null && proj.IsAlready_RERANumber.ToString() == "Y")
                    {
                        @(proj.Existing_RERANumber + " (Registered Project)")
                    }
                    else
                    {
                        @:New Project Registration
                    }
                </td>
            </tr>
            <tr>
                <td class="label-cell">Project Description:</td>
                <td>@proj.Project_Amenities</td>
            </tr>

            @{
                var projectTypes = "";

                if (Model.Registration.ProjectType_Registration != null)
                {
                    projectTypes = string.Join("<br/>",
                        Model.Registration.ProjectType_Registration
                            .Select(x => x.ProjectType_Name + " - " +
                                         x.ProjectType_SubType_Name)
                            .Distinct());
                }
            }
            <tr>
                <td class="label-cell">Project Type:</td>
                <td>@Html.Raw(projectTypes)</td>
            </tr>

            <tr>
                <td class="label-cell">Project Location:</td>
                <td>@proj.Project_AddressLine1 @proj.Project_AddressLine2</td>
            </tr>
            <tr>
                <td class="label-cell">Sub District / Tehsil / City:</td>
                <td>@proj.Project_AddressSubDivisionCode</td>
            </tr>
            <tr>
                <td class="label-cell">State:</td>
                <td>@proj.Project_AddressStateCode</td>
            </tr>
            <tr>
                <td class="label-cell">District:</td>
                <td>@proj.Project_AddressDistrictCode</td>
            </tr>
            <tr>
                <td class="label-cell">Pin Code:</td>
                <td>@proj.Project_AddressPIN</td>
            </tr>
            <tr>
                <td class="label-cell">Potential Zone:</td>
                <td>@getZoneName(proj.Project_PotentialZoneCode)</td>
            </tr>
            <tr>
                <td class="label-cell">Project Website:</td>
                <td>@(!string.IsNullOrWhiteSpace(proj.ProjectWebsite_WebLink) ? proj.ProjectWebsite_WebLink : "NA")</td>
            </tr>
            @if (land != null)
            {
                <tr>
                    <td class="label-cell">Latitude:</td>
                    <td>@land.ProposedProjectLand_StartPoint_Latitude</td>
                </tr>
                <tr>
                    <td class="label-cell">Longitude:</td>
                    <td>@land.ProposedProjectLand_StartPoint_Longitude</td>
                </tr>
                <tr>
                    <td class="label-cell">Type of Project Land:</td>
                    <td>
                        @(land.IsProjectLand_Status_OwnedByPromoter == "Y" ? "Owned By Promoter" : land.IsProjectLand_Status_OwnedByPromoter == "N" ? "Not Owned By Promoter" : land.IsProjectLand_Status_OwnedByPromoter == "A" ? "Both (Owned and Not Owned) By Promoter" : "NA")
                    </td>
                </tr>

            }
        </table>

        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Specification Details (as per Brochure/Prospectus)</td>
            </tr>
            <tr>
                <td class="label-cell">Structure:</td>
                <td>@proj.ProposedProjectDetail_Structure</td>
            </tr>
            <tr>
                <td class="label-cell">Flooring:</td>
                <td>@proj.ProposedProjectDetail_Flooring</td>
            </tr>
            <tr>
                <td class="label-cell">Wall Finishing:</td>
                <td>@proj.ProposedProjectDetail_WallFinishing</td>
            </tr>
            <tr>
                <td class="label-cell">Sanitary Fittings:</td>
                <td>@proj.ProposedProjectDetail_SanitaryFittings</td>
            </tr>
            <tr>
                <td class="label-cell">Electrical Fittings:</td>
                <td>@proj.ProposedProjectDetail_ElectricalFittings</td>
            </tr>
            <tr>
                <td class="label-cell">Kitchen:</td>
                <td>@proj.ProposedProjectDetail_Kitchen</td>
            </tr>
            @if (proj.IsProposedProjectDetail_OthersIfAny != null && proj.IsProposedProjectDetail_OthersIfAny.ToString() == "Y")
            {
                <tr>
                    <td class="label-cell">Others (@proj.ProposedProjectDetail_OthersIfAnyName):</td>
                    <td>@proj.ProposedProjectDetail_OthersIfAny</td>
                </tr>
            }
        </table>

        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td colspan="2" class="header-cell">Timelines (Project Status: @proj.Project_Status)</td>
            </tr>
            <tr>
                <td class="label-cell">Expected Start Date:</td>
                <td>@(proj.ProjectStart_Date != null ? Convert.ToDateTime(proj.ProjectStart_Date).ToString("dd/MM/yyyy") : "NA")</td>
            </tr>
            <tr>
                <td class="label-cell">Original Completion Date:</td>
                <td>@(proj.ProjectCompletion_OriginalDate != null ? Convert.ToDateTime(proj.ProjectCompletion_OriginalDate).ToString("dd/MM/yyyy") : "NA")</td>
            </tr>
            <tr>
                <td class="label-cell">Expected End Date:</td>
                <td>@(proj.ProjectCompletion_ProposedDate != null ? Convert.ToDateTime(proj.ProjectCompletion_ProposedDate).ToString("dd/MM/yyyy") : "NA")</td>
            </tr>
            <tr>
                <td class="label-cell">Reason for Delay, if any:</td>
                <td>@(proj.ProjectDelayReason_IfAny != null && proj.ProjectDelayReason_IfAny.ToString() != "0" && !string.IsNullOrWhiteSpace(proj.ProjectDelayReason_IfAny.ToString()) ? proj.ProjectDelayReason_IfAny.ToString() : "NA")</td>
            </tr>
        </table>

        if (land != null)
        {
            <table cellpadding="8" cellspacing="0" class="section-table">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Project Specifications</td>

                </tr>
                <tr>
                    <td colspan="2" class="header-cell">Area Details (sq. mt.)</td>
                </tr>
                <tr>
                    <td class="label-cell">Land Area (Sq.meter.):</td>
                    <td>@land.ProposedLand_TobeDeveloped_Area_Total</td>
                </tr>
                <tr>
                    <td class="label-cell">Total Open Area:</td>
                    <td>@land.ProposedLand_TobeDeveloped_TotalOpenArea sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Total Covered Area:</td>
                    <td>@land.ProposedLand_TobeDeveloped_TotalCoveredArea sqr mtrs</td>
                </tr>
                <tr>
                    <td colspan="2" class="header-cell">Area of Land Under Various Components (sq. mt.)</td>
                </tr>
                <tr>
                    <td class="label-cell">Residential Group Housing:</td>
                    <td>@land.ProposedLand_Area_ResidentialGroupHousing sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Residential Plotted:</td>
                    <td>@land.ProposedLand_Area_ResidentialPlotted sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Commercial:</td>
                    <td>@land.ProposedLand_Area_Commercial sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Industrial:</td>
                    <td>@land.ProposedLand_Area_Industrial sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Other Component (B):</td>
                    <td>@land.ProposedLand_Area_B_column sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Other Component (C):</td>
                    <td>@land.ProposedLand_Area_C_column sqr mtrs</td>
                </tr>
                <tr>
                    <td class="label-cell">Other Component (A):</td>
                    <td>@land.ProposedLand_Area_A_column sqr mtrs</td>
                </tr>
                <tr>
                    <td colspan="2" class="header-cell">Boundary Points</td>
                </tr>
                <tr>
                    <td class="label-cell">Start Point (Lat / Long):</td>
                    <td>@land.ProposedProjectLand_StartPoint_Latitude / @land.ProposedProjectLand_StartPoint_Longitude</td>
                </tr>
                <tr>
                    <td class="label-cell">End Point (Lat / Long):</td>
                    <td>@land.ProposedProjectLand_EndPoint_Latitude / @land.ProposedProjectLand_EndPoint_Longitude</td>
                </tr>
                <tr>
                    <td class="label-cell">Name of Villages/ Mohalla/ Towns:</td>
                    <td>@land.Name_of_Villages</td>
                </tr>
            </table>
        }

        if (Model.Khasra != null && Model.Khasra.prpongoing != null && Model.Khasra.prpongoing.Count > 0)
        {
            <div class="pagebreak"></div>
            <table cellpadding="8" cellspacing="0" class="section-table">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="4" style="font-weight:bold; text-align:center;">Khasra Number(s) of Land Proposed to be Developed</td>
                </tr>
                <tr>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">S.No</td>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Khasra Number</td>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Area (Sq. Mtr.)</td>
                    <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Village/Mohalla/Town &amp; Land Status</td>
                </tr>
                @{
                    int khasraSno = 0;
                }
                @foreach (var kh in Model.Khasra.prpongoing)
                {
                    khasraSno++;
                    <tr>
                        <td>@khasraSno</td>
                        <td>@kh.KhasraNumber_ProposedLand_TobeDeveloped</td>
                        <td>@kh.Area_ProposedLand_EachKhasraNumber</td>
                        <td>@kh.A_column (@(kh.B_column == "Y" ? "Owned By Promoter" : "Not Owned By Promoter"))</td>
                    </tr>
                }
            </table>
        }

        if (Model.Registration.prpongoing != null)
        {
            <div class="pagebreak"></div>
            <table cellpadding="8" cellspacing="0" class="section-table">
                <tr>
                    <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Contact Person for Communication with Regards to Project</td>
                </tr>
                <tr>
                    <td class="label-cell">Contact Person:</td>
                    <td>@proj.AuthorizedPerson_FirstName @proj.AuthorizedPerson_MiddleName @proj.AuthorizedPerson_LastName</td>
                </tr>
                <tr>
                    <td class="label-cell">Address:</td>
                    <td>@proj.AuthorizedPerson_AddressLine1 @proj.AuthorizedPerson_AddressLine2</td>
                </tr>
                <tr>
                    <td class="label-cell">District / State:</td>
                    <td>@proj.AuthorizedPerson_AddressDistrictCode, @proj.AuthorizedPerson_AddressStateCode</td>
                </tr>
                <tr>
                    <td class="label-cell">Pin Code:</td>
                    <td>@proj.AuthorizedPerson_AddressPIN</td>
                </tr>
                <tr>
                    <td class="label-cell">Email Address:</td>
                    <td>@proj.AuthorizedPerson_EmailAddress</td>
                </tr>
                <tr>
                    <td class="label-cell">Mobile Number:</td>
                    <td>@proj.AuthorizedPerson_MobileNumber</td>
                </tr>
            </table>
        }
        <div class="pagebreak"></div>
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Cost & Estimations</td>

            </tr>
            <tr>
                <td class="label-cell">Total Cost of Project (In lakhs):</td>
                <td>@proj.A_column</td>
            </tr>
        </table>
    }

    @if (showProject)
    {
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Project Approval</td>

            </tr>
            <tr>
                <td colspan="2" class="header-cell">Encumbrance / Non Encumbrance Details</td>
            </tr>
            <tr>
                <td class="label-cell">Do you have Non Encumbrance Certificate?:</td>
                <td>@(Model.Land != null && Model.Land.prpongoing != null && Model.Land.prpongoing.Any() ? Model.Land.prpongoing.FirstOrDefault().IsLandEncumbrances_IfAny : "NA")</td>
            </tr>
            @if (Model.Registration != null && Model.Registration.prpongoing != null && Model.Registration.prpongoing.Count > 0)
            {
                var declProj = Model.Registration.prpongoing.FirstOrDefault();
                <tr>
                    <td colspan="2" class="header-cell">Other Declarations</td>
                </tr>
                <tr>
                    <td class="label-cell">Agreement of Sale as per RERA Form-Q format?:</td>
                    <td>@(declProj.IsProForma_AOS_RERAformat_AnnexureA != null && declProj.IsProForma_AOS_RERAformat_AnnexureA.ToString() == "Y" ? "Yes" : "No")</td>
                </tr>
                if (declProj.IsProForma_AOS_RERAformat_AnnexureA != null && declProj.IsProForma_AOS_RERAformat_AnnexureA.ToString() == "NotApplicable")
                {
                    <tr>
                        <td class="label-cell">If No, changes approved by RERA Punjab?:</td>
                        <td>@(declProj.IsProForma_AOS_RERAformat_No_IsApproved != null && declProj.IsProForma_AOS_RERAformat_No_IsApproved.ToString() == "Y" ? "Yes" : "No")</td>
                    </tr>
                }
                <tr>
                    <td class="label-cell">Falls under Mega Project category?:</td>
                    <td>@(declProj.IsProject_MegaProjectCategory != null && declProj.IsProject_MegaProjectCategory.ToString() == "Y" ? "Yes" : "No")</td>
                </tr>
                <tr>
                    <td class="label-cell">Any litigation(s) related to the Project?:</td>
                    <td>@(declProj.IsLitigation_RelatedProject != null && declProj.IsLitigation_RelatedProject.ToString() == "Y" ? "Yes" : "No")</td>
                </tr>
            }
        </table>
    }

    @if (showProject && Model.Bank != null && Model.Bank.prpongoing != null && Model.Bank.prpongoing.Count > 0)
    {
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="2" style="font-weight:bold; text-align:center;">Special (RERA) Bank Account Details</td>
            </tr>
            @foreach (var bank in Model.Bank.prpongoing)
            {
                <tr>
                    <td class="label-cell">Bank Name:</td>
                    <td>@bank.Bank_Name</td>
                </tr>
                <tr>
                    <td class="label-cell">Branch Name:</td>
                    <td>@bank.Branch_Name</td>
                </tr>
                <tr>
                    <td class="label-cell">Account Number:</td>
                    <td>@bank.Bank_AccountNumber</td>
                </tr>
                <tr>
                    <td class="label-cell">Account Type:</td>
                    <td>@(!string.IsNullOrWhiteSpace(bank.A_column) ? bank.A_column : "--")</td>
                </tr>
                <tr>
                    <td class="label-cell">IFSC Code:</td>
                    <td>@bank.Bank_IFSC_Code</td>
                </tr>
                <tr>
                    <td class="label-cell">Bank Address:</td>
                    <td>@bank.Bank_AddressLine1 @bank.Bank_AddressLine2, @bank.Bank_AddressDistrictCode, @bank.Bank_AddressStateCode - @bank.Bank_AddressPIN</td>
                </tr>
            }
        </table>
    }

    @* ===================== QUATERLY SECTION (reportType == "Quaterly" or "All") ===================== *@
    @if (showQuaterly && Model.InternalFacilities != null && Model.InternalFacilities.prpongoing != null && Model.InternalFacilities.prpongoing.Count > 0)
    {
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="3" style="font-weight:bold; text-align:center;">Facilities & Amenties</td>
            </tr>
            <tr>
                <td colspan="1" class="header-cell">Proposed Common (Internal) Facilities</td>
            </tr>
            <tr>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Facility Name</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Work Progress %</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Details</td>
            </tr>
            @foreach (var fac in Model.InternalFacilities.prpongoing)
            {
                <tr>
                    <td class="label-cell">@fac.InternalInfrastructureFacilities_Name</td>
                    <td>@fac.WorkProgress_Percentage</td>
                    <td>@fac.InternalInfrastructureFacilities_Details</td>
                </tr>
            }
        </table>
    }

    @if (showQuaterly && Model.ExternalFacilities != null && Model.ExternalFacilities.prpongoing != null && Model.ExternalFacilities.prpongoing.Count > 0)
    {
        <div class="pagebreak"></div>
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="4" style="font-weight:bold; text-align:center;">External Infrastructure & Facilities</td>
            </tr>
            <tr>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Facility Name</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Type / Agency</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Work Progress %</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Details</td>
            </tr>
            @foreach (var ext in Model.ExternalFacilities.prpongoing)
            {
                <tr>
                    <td>@ext.InternalInfrastructureFacilities_Name</td>
                    <td>@ext.InternalInfrastructureFacilities_Type (@ext.ExternalAgency_LocalAuthority_Name)</td>
                    <td>@ext.WorkProgress_Percentage</td>
                    <td>@ext.InternalInfrastructureFacilities_Details</td>
                </tr>
            }
        </table>
    }

    @if (showQuaterly && Model.Parking != null && Model.Parking.prpongoing != null && Model.Parking.prpongoing.Count > 0)
    {
        <table cellpadding="8" cellspacing="0" class="section-table">
            <tr>
                <td class="rpt-pdf-display-border-box" colspan="4" style="font-weight:bold; text-align:center;">Parking Details</td>
            </tr>
            <tr>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Parking Type</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Available for Sale</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Area (Sq. Mtr.)</td>
                <td class="rpt-pdf-display-border-top-box" style="font-weight:bold;">Booked/Sold</td>
            </tr>
            @foreach (var item in Model.Parking.prpongoing)
            {
                <tr>
                    <td>@item.ParkingType</td>
                    <td>@item.ParkingSpace_AvailableforSale_Number</td>
                    <td>@String.Format("{0:N3}", item.ParkingSpace_Area_Total)</td>
                    <td>@item.ParkingSpace_BookedSold_Number</td>
                </tr>
            }
        </table>
    }


    @if (showQuaterly)
    {
