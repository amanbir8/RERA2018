            <td class="document-action-cell">
                <!-- PDF -->
                <a href="@Url.Action("Print_ProjectDocumentDetails","ProjectPrintForm")" target="_blank" title="View Project Documents PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td>
                <!-- Download Dropdown -->
                <div class="dropdown document-action-dropdown">
                    <button type="button" class="btn doc-action-download dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-download"></i>Download<span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right">
                        <li>
                            <a href="javascript:void(0);" id="btnDownloadProjectZip">
                                <i class="fa fa-file-archive-o download-zip-icon"></i>Download ZIP
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" id="btnDownloadTrashProjectZip">
                                <i class="fa fa-trash download-trash-icon"></i>Download Trash ZIP
                            </a>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>
        <!-- 8. Payment -->
        <tr>
            <td class="document-sno">@(++projectSno)</td>
            <td>Payment Detail</td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_ProjectPaymentDetails","ProjectPrintForm")" target="_blank" title="View Payment PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
    </tbody>

</table>
@if (Model.Documents != null && Model.Documents.prpongoing != null)
{
    foreach (var doc in Model.Documents.prpongoing.Where(x => !string.IsNullOrWhiteSpace(x.ProjectDoc_FileName)))
    {
        string fileUrl = StrcallBaseURL + "/" + doc.ProjectDoc_FilePath.Replace("\\", "/").TrimStart('/');
        <span class="project-file-url" data-url="@fileUrl" style="display:none;"></span>
    }
}
@if (Model.ApprovalDocuments != null && Model.ApprovalDocuments.prpongoing != null)
{
    foreach (var doc in Model.ApprovalDocuments.prpongoing.Where(x => !string.IsNullOrWhiteSpace(x.DocumentType_FileName)))
    {
        string fileUrl = StrcallBaseURL + "/" + doc.DocumentType_FileName.Replace("\\", "/").TrimEnd('/') + "/" + doc.DocumentType_FilePath.TrimStart('/');
        string docName = !string.IsNullOrWhiteSpace(doc.DocumentType_Name) ? doc.DocumentType_Name : "Document";
        <span class="approval-file-url" data-url="@fileUrl" data-name="@docName" style="display:none;"></span>
    }
}
@if (Model.TrashDocuments != null && Model.TrashDocuments.prpongoing != null)
{
    foreach (var doc in Model.TrashDocuments.prpongoing.Where(x => !string.IsNullOrWhiteSpace(x.ProjectDoc_FileName)))
    {
        string fileUrl = StrcallBaseURL + "/" + doc.ProjectDoc_FilePath.Replace("\\", "/").TrimStart('/');
        <span class="projecttrash-file-url" data-url="@fileUrl" style="display:none;"></span>
    }
}


