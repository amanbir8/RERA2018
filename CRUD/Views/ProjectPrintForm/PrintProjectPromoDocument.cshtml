@model CRUD.Models.ProjectPrintForm.ClsPrp_PrmProject_Print_ConsolidatedReport
@using System.Linq
<link href="@Url.Content("~/css/font-awesome-4.7.0/css/font-awesome.min.css")" rel="stylesheet" />
@{
    var StrcallBaseURL = System.Configuration.ConfigurationManager.AppSettings["imagewebBaseURL"].ToString();
    var diaryDetails = Model.Registration.prpProjectDiaryNumberDetails?.FirstOrDefault();
}
<div id="projectDocSelectionWrapper"
     data-diary-number="@(diaryDetails.PromoterRegDiaryNumber_Name)"
     data-project-name="@(diaryDetails.zipProjectName)"
     style="display:none;">
</div>

<style>
    /* =========================
       Project Document Actions
       ========================= */

    #projectDocTable,
    #promoterDocTable,
    #projectQuarterlyDocTable {
        margin-bottom: 20px;
    }

    .document-table thead th {
        vertical-align: middle !important;
    }

    .document-table tbody td {
        vertical-align: middle !important;
    }

    .document-table tbody tr {
        transition: background-color 0.15s ease;
    }

        .document-table tbody tr:hover {
            background-color: #f7fbfd;
        }

    .document-action-cell {
        width: 17.5%;
        text-align: center;
        white-space: nowrap;
    }

    /* Download button */
    .doc-action-download {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 32px;
        padding: 5px 10px;
        border: 1px solid #074c75;
        border-radius: 4px !important;
        background: #fff;
        color: #074c75;
        font-size: 12px;
        font-weight: 600;
    }

        .doc-action-download:hover,
        .doc-action-download:focus {
            background: #074c75;
            color: #fff;
        }

        .doc-action-download .caret {
            margin-left: 3px;
        }

    /* Dropdown */
    .document-action-dropdown {
        display: inline-block;
        margin-left: 5px;
    }

        .document-action-dropdown .dropdown-menu {
            min-width: 205px;
            padding: 5px 0;
            border-radius: 5px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.18);
            border: 1px solid #ddd;
        }

            .document-action-dropdown .dropdown-menu > li > a {
                padding: 9px 15px;
                font-size: 13px;
                color: #333;
            }

                .document-action-dropdown .dropdown-menu > li > a:hover {
                    background: #f3f8fb;
                    color: #074c75;
                }

                .document-action-dropdown .dropdown-menu > li > a i {
                    width: 20px;
                    margin-right: 5px;
                    text-align: center;
                }

    .download-zip-icon {
        color: #074c75;
    }

    .download-trash-icon {
        color: #d9534f;
    }

    /* Header */
    .document-section-header {
        background: #074c75;
        color: white;
        font-weight: bold;
        text-align: left;
        padding: 8px 10px;
    }

    .document-section-header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .document-section-title {
        font-size: 14px;
    }

    .document-section-pdf {
        color: white !important;
        text-decoration: none !important;
        font-size: 17px;
    }

        .document-section-pdf:hover {
            opacity: 0.8;
        }

    /* S.No */
    .document-sno {
        width: 8%;
        text-align: center;
    }

    /* Review */
    .document-review {
        width: 67%;
    }

    /* Actions */
    .document-actions {
        width: 25%;
        text-align: center;
    }
</style>


