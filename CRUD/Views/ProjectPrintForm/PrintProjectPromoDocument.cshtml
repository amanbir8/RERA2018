<!-- Promoter Details Table -->
<table class="table table-bordered align-middle document-table" id="promoterDocTable">
    <thead>
        <!-- Section Header -->
        <tr>
            <td colspan="4" class="document-section-header">
                <div class="document-section-header-inner">
                    <span class="document-section-title"><i class="fa fa-user-o"></i> Promoter Details</span>
                    <a href="@Url.Action("Print_ProjectConsolidatedReport","ProjectPrintForm",new { reportType = "Promoter" })" target="_blank" title="View Complete Promoter PDF" class="document-section-pdf">
                        <i class="fa fa-file-pdf-o"></i>
                    </a>
                </div>
            </td>
        </tr>
        <!-- Column Header -->
        <tr>
            <th class="document-sno">S.No</th>
            <th class="document-review">Document</th>
            <th style="width:15%; text-align:center;">PDF</th>
            <th style="width:15%; text-align:center;">Download</th>
        </tr>
    </thead>
    <tbody>
        @{
            int promoterSno = 0;
        }
        <!-- 1. Promoter Profile -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Promoter's Profile
            </td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_PromoterIndDetail","PromoterPrintForm")" target="_blank" title="View Promoter Profile PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
        <!-- 2. Member Details -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Member(s) Detail
            </td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_PromoterOrganizationMember","PromoterPrintForm")" target="_blank" title="View Member Details PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
        <!-- 3. Parent Entity -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Parent Entity(s) Detail
            </td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_PromoterParentEntity","PromoterPrintForm")" target="_blank" title="View Parent Entity Details PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
        <!-- 4. Track Record -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Track Record of the Promoter
            </td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_PromoterTrackRecordDetails","PromoterPrintForm")" target="_blank" title="View Promoter Track Record PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
        <!-- 5. Litigation -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Litigation(s) Detail
            </td>
            <td class="document-action-cell">
                <a href="@Url.Action("Print_PromoterLitigationsDetails","PromoterPrintForm")" target="_blank" title="View Promoter Litigation PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td style="text-align:center;">-</td>
        </tr>
        <!-- 6. Documents -->
        <tr>
            <td class="document-sno">
                @(++promoterSno)
            </td>
            <td>
                Document(s) Detail
            </td>
            <td class="document-action-cell">
                <!-- PDF -->
                <a href="@Url.Action("Print_PromoterDocumentDetails","PromoterPrintForm")" target="_blank" title="View Promoter Documents PDF">
                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                </a>
            </td>
            <td>
                <!-- ZIP Dropdown -->
                <div class="dropdown document-action-dropdown">
                    <button type="button" class="btn doc-action-download dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-download"></i>Download<span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right">
                        <li>
                            <a href="javascript:void(0);" id="btnDownloadPromoterZip">
                                <i class="fa fa-file-archive-o download-zip-icon"></i>Download ZIP
                            </a>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>
    </tbody>
</table>

@if (Model.PromoterDocuments != null && Model.PromoterDocuments.prpongoing != null)
{
    foreach (var doc in Model.PromoterDocuments.prpongoing.Where(x => !string.IsNullOrWhiteSpace(x.PromoterDoc_FileName)))
    {
        string fileUrl = StrcallBaseURL + "/" + doc.PromoterDoc_FilePath.Replace("\\", "/").TrimStart('/');
        <span class="promoter-file-url" data-url="@fileUrl" style="display:none;"></span>
    }
}