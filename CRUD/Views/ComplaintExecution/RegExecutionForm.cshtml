<script>
    $(document).ready(function () {
        $("#ExecutionForm").on("submit", function (e) {
            var file = $("#ComplianceFile")[0].files[0];
            if (!file) {
                e.preventDefault();
                $("#ComplianceFileError").show();
                $("#ComplianceFile").focus();
                return false;
            }

            $("#ComplianceFileError").hide();

            return true;
        });

        $("#ComplianceFile").on("change", function () {

            if (this.files.length > 0) {
                $("#ComplianceFileError").hide();
            }

        });

    });
</script>

