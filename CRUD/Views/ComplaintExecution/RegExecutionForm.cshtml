                    });
                }
            });
        });

        $.ajax({
            type: "GET",
            url: baseUrl + "/ComplaintExecution/Benchname",
            dataType: "json",
            success: function (data) {
                var ddl = $('#Benchname');
                ddl.empty();
                ddl.append('<option value="">-- Select Bench --</option>');
                $.each(data.prpongoing, function (index, value) {
