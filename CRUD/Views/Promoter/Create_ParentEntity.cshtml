<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({

            type: "GET",
            url: baseUrl + "Promoter/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data.stateMaster, function (index, value) {
                    $('#State').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');

                    $("#State option:contains(undefined)").remove();
                });
            }
        });

        $('#State').change(function () {

            $('#District').empty();

            $.ajax({
                type: "POST",
                url: baseUrl + "Promoter/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#State').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#District').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });
</script>
