<script>
    $(function () {

        // var $j = jQuery.noConflict();
        @*if($(@ViewBag.submitvalue)!= "Update")
            {*@
        //alert(ViewBag.submitvalue);
        // alert(ViewBag.submitvalue);

        if ($('#RExtentofDelayProject').val() == "0" || $('#RExtentofDelayProject').val() == "") {
            $('#div_reasonfordelay').hide();
            $('#RExtentofDelayProject').val("0");
        }
        else {
            $('#div_reasonfordelay').show();
        }


        if ($('input[name=IsPaymentDetailsPending_RelatedLand]:checked').val() == "N") {
            $('#DetailPaymentPendingProject').val("0");
            $('#show_payment_pending').hide();
        }
        else {
            $('#show_payment_pending').show();
        }

        if ($('#DetailPaymentPendingProject').val() == "") {
            $('#DetailPaymentPendingProject').val("0");
            $('#show_payment_pending').hide();
        }


        //$('#ProjectStartDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        //$('#OCDateProject').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        //$('#ACDProject').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        // $('#ProjectStartDate').datepicker({ changeMonth: true, changeYear: true, });
        // $('#OCDateProject').datepicker({ changeMonth: true, changeYear: true, });//end date
        // $('#ACDProject').datepicker({ changeMonth: true, changeYear: true, });



        $("#ProjectStartDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1,
            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#OCDateProject").datepicker("option", "minDate", dt);
            }
        });

        $("#OCDateProject").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#ProjectStartDate").val();
                if (projStartDate == '') {
                    alert('Please select Project Start Date first!');
                    $("#OCDateProject").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#ProjectStart_Date").datepicker("option", "maxDate", dt);
                $("#ACDProject").datepicker("option", "minDate", dt);
                //$("#ProjectCompletion_ProposedDate").datepicker("option", "minDate", dt);
                CalculateDiff();
            }
        });

        $("#ACDProject").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            //minDate: "0D",
            onSelect: function (selected) {
                var compOrigDate = $("#OCDateProject").val();
                if (compOrigDate == '') {
                    alert('Please select Original Proposed Date of Completion first!');
                    $("#ACDProject").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#OCDateProject").datepicker("option", "maxDate", dt);
                CalculateDiff();
            }
        });




        $('input[name=IsPaymentDetailsPending_RelatedLand]').click(function () {
            //debugger;
            if ($('input[name=IsPaymentDetailsPending_RelatedLand]:checked').val() == "N") {
                $('#DetailPaymentPendingProject').val("0");
                $('#show_payment_pending').hide();
                //$('#show1').hide();
                //$('#show2').hide();
            }
            else {

                $('#show_payment_pending').show();

            }

        });

        $('[data-toggle="tooltip"]').tooltip();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]//, 5]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });


    // To calulate difference b/w two dates
    function CalculateDiff() {

        if ($("#OCDateProject").val() != "" && $("#ACDProject").val() != "") {
            var From_date = new Date($("#OCDateProject").val());
            var To_date = new Date($("#ACDProject").val());
            var toDateTime = To_date.getTime();
            var fromDateTime = From_date.getTime();

            var oneDay = 1000 * 60 * 60 * 24;
            var diff_date = toDateTime - fromDateTime;
            var diffInDays = Math.round(diff_date / oneDay);

            if (diffInDays > 0) {
                // alert(years + " year(s) " + months + " month(s) " + days + " and day(s)");
                $('#div_reasonfordelay').show();
            }
            else {
                $('#div_reasonfordelay').hide();
                $('#RExtentofDelayProject').val("0");
            }

        }
        else {
            //alert("Please select dates");
            return false;
        }
    }
</script>

