                                                            @Html.DropDownListFor(model => model.ProjectType, new SelectList(listItems, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.ProjectType, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @{var listItems2 = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                                    new SelectListItem {  Text = "Promoter Owned" , Value="0"  },
                                                                    new SelectListItem {  Text = "Leased" , Value="1"  },
