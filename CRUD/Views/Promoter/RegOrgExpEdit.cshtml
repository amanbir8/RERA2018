@model CRUD.Models.Promoter.ClsPrp_OrgExp

<script type="text/javascript">
    $(document).ready(function () {

        if ($('input[name=Experience]:checked').val() === "Y") {
            $('#show').show();
            $('#Past_Exp_Punjab').focus();
        }
        else {
            $('#Past_Exp_Punjab').val("0");
            $('#Past_Exp_Other_States').val("0");

            $('#Ind_Org_CompltdProj_FiveYrs').val("0");
            $('#Ind_Org_TotalArea_Constructed').val("0");

            $('#Ind_Org_OngoingProjects').val("0");
            $('#Ind_Org_AreaToBe_Constructed').val("0");

            $('#show').hide();
        }

        if ($('#Phone_No').val() === "0") {
            $('#Phone_No').val("");
        }
       

        $('input[name=Experience]').click(function () {
            if ($('input[name=Experience]:checked').val() === "N") {
                //$("#Past_Exp_Punjab").val("0");
                //$('#Past_Exp_Other_States').val("0");

                //$('#Ind_Org_CompltdProj_FiveYrs').val("0");
                //$('#Ind_Org_TotalArea_Constructed').val("0");

                //$('#Ind_Org_OngoingProjects').val("0");
                //$('#Ind_Org_AreaToBe_Constructed').val("0");
                $('#show').hide();
            }
            else {

                $('#show').show();

            }
        });

        $('[data-toggle="tooltip"]').tooltip();

    });
    var loginuser = function () {
        if ($('input[name=Experience]:checked').val() === "Y") {
            var exp_punjab = $('#Past_Exp_Punjab').val();
            var exp_other = $('#Past_Exp_Other_States').val();
            if (exp_punjab == "" || exp_punjab == undefined || exp_other == "" || exp_other == undefined) {
                alert("Please enter required experience");

                $('#Past_Exp_Punjab').focus();
                return false;
            }
        }
        else if ($('input[name=Experience]:checked').val() === "N") {
            //alert("else case");
            //$('#Past_Exp_Punjab').val() = 0;
            //$('#Past_Exp_Other_States').val() = 0;

            $("#Past_Exp_Punjab").val("0");
            $('#Past_Exp_Other_States').val("0");

            $('#Ind_Org_CompltdProj_FiveYrs').val("0");
            $('#Ind_Org_TotalArea_Constructed').val("0");

            $('#Ind_Org_OngoingProjects').val("0");
            $('#Ind_Org_AreaToBe_Constructed').val("0");
        }


        if ($('input[name=Last_FiveYr_Exp]:checked').val() === "Y") {
            var Compltd_FiveYrs = $('#Ind_Org_CompltdProj_FiveYrs').val();
            var TotalArea_Const = $('#Ind_Org_TotalArea_Constructed').val();
            if (Compltd_FiveYrs == "" || Compltd_FiveYrs == undefined || TotalArea_Const == "" || TotalArea_Const == undefined) {
                alert("Please enter required experience");

                $('#Ind_Org_CompltdProj_FiveYrs').focus();
                return false;
            }
        }
        else if ($('input[name=Last_FiveYr_Exp]:checked').val() === "N") {
            //alert("else case");
            $('#Ind_Org_CompltdProj_FiveYrs').val() = 0;
            $('#Ind_Org_TotalArea_Constructed').val() = 0;
        }

        if ($('input[name=Ongoing_Exp]:checked').val() === "Y") {
            var Ongoing_Projects = $('#Ind_Org_OngoingProjects').val();
            var Area_ToBeConst = $('#Ind_Org_AreaToBe_Constructed').val();
            if (Ongoing_Projects == "" || Ongoing_Projects == undefined || Area_ToBeConst == "" || Area_ToBeConst == undefined) {
                alert("Please enter required experience");

                $('#Ind_Org_OngoingProjects').focus();
                return false;
            }
        }
        else if ($('input[name=Ongoing_Exp]:checked').val() === "N") {
            //alert("else case");
            $('#Ind_Org_OngoingProjects').val() = 0;
            $('#Ind_Org_AreaToBe_Constructed').val() = 0;
        }


    };
</script>
<script type="text/javascript">

    function showPAN(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_PAN').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
        }
    }
    function showOrgCert(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_OrgCert').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
        }
    }
</script>
