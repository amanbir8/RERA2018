<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');

        $.ajax({
            type: "GET",
            url: baseUrl + "Promoter/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data.stateMaster, function (index, value) {
                    $('#State').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                    $("#State option:contains(undefined)").remove();
                });
            }
        });

        $('#State').change(function () {
            $('#District').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Promoter/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#State').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#District').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });

        $('[data-toggle="tooltip"]').tooltip();
        $('[data-spzoom]').spzoom();

        $('table#joint-promoter-profiles-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

        if ($('#CoPromoter_Aadhaar_Number').val() === "0") {
            $('#CoPromoter_Aadhaar_Number').val("");
        }
        if ($('#AuthorizedPerson_MobileNumber').val() === "0") {
            $('#AuthorizedPerson_MobileNumber').val("");
        }
        if ($('#AuthorizedPerson_LandlineNumber').val() === "0") {
            $('#AuthorizedPerson_LandlineNumber').val("");
        }
    });
</script>

<script type="text/javascript">
    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }   
</script>
<script>   
    var loginuser = function loginuser() {
        //"photo address" have value on submit button
        //and "user_photo" have value on update button
        //so check length of control on save (files.length) and update (path.length)

        var files = $("#Photo_Address").get(0).files;
        var path = $('#user_Photo').attr('src').replace('/', '');

        if (files.length > 0 || path.length > 0) {
            $(submitButton).parents('form').submit();
        }
        else {
            var vcheckpromotertypevalue = $("input[name='CoPromoterType_Flag']:checked").val();
            if (vcheckpromotertypevalue == '2') {
                $(submitButton).parents('form').submit();                
            }
            else {
                alert("Please Add Photograph file to Upload!")
                return false;
            }
        }
    }
</script>

