                                                                @Html.RadioButtonFor(model => model.IsLitigation_RelatedProject, "Y", new { id = "chkLitigationY", @class = "radio-litigation" }) Yes                                                                
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsLitigation_RelatedProject, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3" id="rowLitigationsC1">
                                                            @Html.LabelFor(model => model.Past_Litigations_InNumber, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" id="rowLitigationsC2">
                                                            @Html.EditorFor(model => model.Past_Litigations_InNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Past_Litigations_InNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="rowReferenceDiaryNumberR1">
                                                    <hr />
                                                </div>
                                                <div class="row" id="rowReferenceDiaryNumberR2">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Link_RegDiaryNumber_Name, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.Link_RegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model?.stateMaster != null)
                                            {
                                                if (Model.IsLock == 1)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else if (Model.IsLock == 0)
                                                {
                                                    if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        if (Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 1 || Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 5 || Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 6)
                                                        {
                                                            <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                        }
                                                        else
                                                        {
                                                            <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" onclick="return loginuser();" />
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                            }
                                            else
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }                                            
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Create_JointPromoterProfile", "Promoter", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            @if (Model?.prpjointpromoter != null && Model?.prpjointpromoter.Any() == true)
                                            {
                                                <table class="table table-striped table-bordered" id="joint-promoter-profiles-list-table">
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_Type)
                                                            </th>                                                        
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Link_RegDiaryNumber_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_District)
                                                            </th>                                                        
                                                            <th>@Html.DisplayName("Edit| Delete")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.prpjointpromoter)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.JointPromoter_Name)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.JointPromoter_Type)
                                                                </td>                                                            
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Link_RegDiaryNumber_Name)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.JointPromoter_District)
                                                                </td>
                                                                <td>
                                                                    @if (item.IsLock == 1)
                                                                    {
                                                                        @Html.ActionLink("View", "Edit_JointPromoterProfile", new { JPrmAppID = item.CoPromoter_ApplicationID, JPrmType = item.CoPromoterType_Flag, JPrmIndexID = item.CoPromoter_IndexID })
                                                                    }
                                                                    else if (Model.IsLock == 0)
                                                                    {
                                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                                        {
                                                                            @Html.ActionLink("View", "Edit_JointPromoterProfile", new { JPrmAppID = item.CoPromoter_ApplicationID, JPrmType = item.CoPromoterType_Flag, JPrmIndexID = item.CoPromoter_IndexID })
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.ActionLink("Edit", "Edit_JointPromoterProfile", new { JPrmAppID = item.CoPromoter_ApplicationID, JPrmType = item.CoPromoterType_Flag, JPrmIndexID = item.CoPromoter_IndexID }) @("| ")
                                                                            @Html.ActionLink("Delete", "Delete_JointPromoterProfile", new { JPrmAppID = item.CoPromoter_ApplicationID, JPrmType = item.CoPromoterType_Flag, JPrmIndexID = item.CoPromoter_IndexID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.ActionLink("View", "Edit_JointPromoterProfile", new { JPrmAppID = item.CoPromoter_ApplicationID, JPrmType = item.CoPromoterType_Flag, JPrmIndexID = item.CoPromoter_IndexID })
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                            else
                                            {
                                                <table class="table table-striped table-bordered" id="joint-promoter-profiles-list-table">
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_Type)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Link_RegDiaryNumber_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.JointPromoter_District)
                                                            </th>
                                                            <th>@Html.DisplayName("Edit| Delete")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- /.col-lg-12 (nested) -->
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

