@{
    ViewBag.Title = "Promoter Profile";
}


    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">My Profile</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading form-heading-text">
                    Select Promoter Type
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("OptionView", "Promoter", FormMethod.Post))
                            {
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Select Option</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            <label class="control-label mand">
                                                                Select Option
                                                            </label>
                                                        @*</div>
                                                        <div class="col-md-10">*@
                                                            <label class="checkbox-inline">
                                                                @*@Html.Label("Select Promoter Type")  <br />*@
                                                                @Html.RadioButton("rdbPromoter", "1", isChecked: true) @Html.Label("Individual")
                                                                @Html.RadioButton("rdbPromoter", "2", isChecked: false) @Html.Label("Other Than Individual (Company/ Proprietorship Firm/ Societies/ Partnership Firm/Competent Authority etc)")
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Note</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="help-block col-md-12 justify">
                                                            Applicants are advised to select <i>'Promoter's Profile Option'</i> as Individual or Other Than Individual (Company/ Proprietorship Firm/ Societies/ Partnership Firm/ Competent Authority etc) carefully, If by mistake, the applicant has select the wrong option data, After that no editing will be done and thereafter data will be locked and no change will be acceptable/ allowed.
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <input type="submit" value="Proceed" class="btn btn-outline btn-primary" />
                                        </div>
                                    </div>
                                </div>
                            }
                            @*<div class="col-lg-12">*@
                            <!-- /.col-lg-12 (nested) -->
                        </div>



                                        <!-- /.row (nested) -->
                                    </div>
                                    <!-- /.panel-body -->
                                </div>
                                                <!-- /.panel -->
                                            </div>
                                        <!-- /.col-lg-12 -->
                                    </div>
                                    <!-- /.row -->

                                </div>


                                <!-- /.wrapper -->
                                @section Scripts {
                                    @Scripts.Render("~/bundles/jqueryval")

                                    <!-- Metis Menu Plugin JavaScript -->
                                    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
                                }
