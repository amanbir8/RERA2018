<style>   
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<script>$.uiBackCompat = false;</script>

<script>
    $(document).ready(function () {
        var vchecklitigationsvalue = $("input[name='JointPromoter_LitigationsFlag']:checked").val();
        if (vchecklitigationsvalue == '1') {
            $("#rowjpLitigationsifany").attr("style", "display:block");
        }
        else if (vchecklitigationsvalue == '0') {
            $("#rowjpLitigationsifany").attr("style", "display:none");
        }

        $(document).on('click', '.radio-jplitigationsvalue', function (e) {
            if (this.value == '1') {
                $("#rowjpLitigationsifany").attr("style", "display:block");
            }
            else if (this.value == '0') {
                $("#rowjpLitigationsifany").attr("style", "display:none");
            }
        });

        $("#LitigationsRelated_ProjectName").change(function () {
            var selectedValue = $(this).val();            
            if (selectedValue == "0") {
                $("#rowProjectNameC1").attr("style", "display:block");
                $("#rowProjectNameC2").attr("style", "display:block");
            }
            else {
                $("#rowProjectNameC1").attr("style", "display:none");
                $("#rowProjectNameC2").attr("style", "display:none");
            };
        });

        var selectedPrjValue = $("#LitigationsRelated_ProjectName").val();
        if (selectedPrjValue == "0") {
            $("#rowProjectNameC1").attr("style", "display:block");
            $("#rowProjectNameC2").attr("style", "display:block");
        }
        else {
            $("#rowProjectNameC1").attr("style", "display:none");
            $("#rowProjectNameC2").attr("style", "display:none");
        };
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $('table#joint-promoter-list-table').dataTable({
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [4]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
        });

        $('table#joint-promoter-partial-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });   
</script>

<script>
    $(document).ready(function () {
        $('#Related_JointPromoter_ID').change(function () {

            var jpromoterId = $(this).val();
            var jpromoterType = 0;
            var jpromoterText = $('#Related_JointPromoter_ID option:selected').text();
            $('#LitigationsRelated_JointPromoterName').val(jpromoterText);

            if (!jpromoterId) {
                $('#dataTableContainer_byID').html('');
                $("#dataTableContainer_default").attr("style", "display:block");
                return;
            }

            $.ajax({
                url: '@Url.Action("Partial_JointPromoterTrackLitigations_ByFilterID", "Promoter")', 
                type: 'GET',
                data: { jointpromoterID: jpromoterId, jointpromoterType: jpromoterType },
                success: function (data) {
                    // partial view
                    $('#dataTableContainer_byID').html(data);                    
                    $('#joint-promoter-partial-list-table').DataTable();
                    $("#dataTableContainer_default").attr("style", "display:none");
                },
                error: function () {
                    alert("An error occurred while loading data.");
                }
            });
        });
    });
</script>
<script>
    $(document).ready(function () {
        $('#LitigationsRelated_ProjectName').change(function () {
            var projectId = $(this).val();
            if (projectId != 0) {
                var projectText = $('#LitigationsRelated_ProjectName option:selected').text();
                $('#Project_Name').val(projectText);
            };

            var requestBASE_URL = $('body').attr('data-base-url');

            $.ajax({
                url: requestBASE_URL + 'Promoter/GetEditorData_JointPromoterTrackLitigations_ByFilterID',
                type: 'GET',
                data: { p_projectId: projectId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (result) {
                    stopPreloader();
                    //console.log(result);
                    if (result.statusCode == 105) {
                        $('#Project_Type').val(result.statusPType);
                        $('#Project_Status').val(result.statusPStatus);
                        $('#Project_AreaConstructed').val(result.statusArea);
                    };
                },
                error: function () {
                    alert('Error occurred while fetching data.');
                }
            });

        });
    });
</script>

<script>
    $(document).ready(function () {
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);

        $('.submit-track-litigations').click(function () {
            swal({
                title: "Message",
                text: "Submitted - Joint-Promoter",
                type: "success"
            });
        });        
    });

    function infohelpHandlerRegistrationdetails() {
        new PNotify({
            title: 'Help',
            text: '<b>Joint-Promoter Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Search Existing Promoter Profile Detail (if Any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Add Joint-Promoter Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Add Track Record and Litigations, If Any.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    };
</script>

<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<style>
    #customTopBtn {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 20px; /* Place the button at the bottom of the page */
        right: 30px; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #064576; /* Set a background color */
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Litigations of the Joint-Promoter, If Any</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Detail of Joint-Promoter's Track Record & Litigation(s) related to Project (If Any)
                    <span class="pull-right">                        
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                @Html.HiddenFor(model => model.JointPromoter_Litigations_IndexID)
                                @Html.HiddenFor(model => model.JointPromoter_Litigation_ID)
                                @Html.HiddenFor(model => model.Related_Promoter_ID)
                                @Html.HiddenFor(model => model.Related_PromoterType)

                                @Html.HiddenFor(model => model.LitigationsRelated_JointPromoterName)
                                @Html.HiddenFor(model => model.Related_JointPromoterType)

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Select Option</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select Joint-Promoter Name</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.Related_JointPromoter_ID, new SelectList(Model.Prp_JointPromoter_Name, "CoPromoter_ApplicationID", "JointPromoter_Name"), "-- Select --", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Related_JointPromoter_ID, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                if (Model?.Prp_JointPromoter_Name != null && Model?.Prp_JointPromoter_Name.Any() == true)
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Previous Projects (Track Record, If Any)</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                <label class="control-label mand">Project Name</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.LitigationsRelated_ProjectName, new SelectList(Model.Prp_Project_Name, "Promoter_Experience_ID", "Projectname"), "-- Select --", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.LitigationsRelated_ProjectName, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-3" id="rowProjectNameC1">
                                                                <label class="control-label mand">In case of Other, then Project Name</label>
                                                            </div>
                                                            <div class="col-md-3" id="rowProjectNameC2">
                                                                @Html.EditorFor(model => model.Project_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Project_Name, "", new { @class = "text-danger" })
                                                            </div>                                                      
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">                                                        
                                                            <div class="col-md-3">
                                                                @{
                                                                    var ProjectType_listItems = new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem {  Text = "-- Select --" , Value=""  },
                                                                        new SelectListItem {  Text = "Residential" , Value="1"  },
                                                                        new SelectListItem {  Text = "Commercial" , Value="2"  },
                                                                        new SelectListItem {  Text = "Industrial" , Value="3"  },
                                                                        new SelectListItem {  Text = "Mixed Development" , Value="4"  },
                                                                    };
                                                                }
                                                                @Html.LabelFor(model => model.Project_Type, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Details with reference to Type of Projects.">
                                                                @Html.DropDownListFor(model => model.Project_Type, new SelectList(ProjectType_listItems, "Value", "Text"), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.Project_Type, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @{
                                                                    var ProjectStatus_listItems = new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem {  Text = "-- Select --" , Value=""  },
                                                                        new SelectListItem {  Text = "On-going" , Value="On-going"  },
                                                                        new SelectListItem {  Text = "Complete" , Value="Complete"  },
                                                                    };
                                                                }
                                                                @Html.LabelFor(model => model.Project_Status, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Details with reference to Completed and On-going Projects.">
                                                                @Html.DropDownListFor(model => model.Project_Status, new SelectList(ProjectStatus_listItems, "Value", "Text"), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.Project_Status, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.Project_AreaConstructed, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Constructed Area under the project (in sqr mtrs).">
                                                                @Html.EditorFor(model => model.Project_AreaConstructed, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Project_AreaConstructed, "", new { @class = "text-danger" })
                                                            </div>                                                            
                                                        </div>                                                 
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">                                                            
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.JointPromoter_LitigationsFlag, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-group">
                                                                    @Html.RadioButtonFor(model => model.JointPromoter_LitigationsFlag, "1", new { id = "chkjpLitigationYes", @class = "radio-jplitigationsvalue", @checked = "checked" }) Yes
                                                                    @Html.RadioButtonFor(model => model.JointPromoter_LitigationsFlag, "0", new { id = "chkjpLitigationNo", @class = "radio-jplitigationsvalue" }) No
                                                                </label>
                                                                @Html.ValidationMessageFor(model => model.JointPromoter_LitigationsFlag, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowjpLitigationsifany">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Project related Litigations of Joint-Promoter</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.Case_Title, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Title of the Litigation related to the Project.">
                                                                @Html.EditorFor(model => model.Case_Title, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Case_Title, "", new { @class = "text-danger" })
                                                            </div>                                                        
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.Case_Number, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Reference Number of Litigation related to the Project.">
                                                                @Html.EditorFor(model => model.Case_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Case_Number, "", new { @class = "text-danger" })
                                                            </div>                                                        
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.Authority_ForumName_CasePendingResolved, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.EditorFor(model => model.Authority_ForumName_CasePendingResolved, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Authority_ForumName_CasePendingResolved, "", new { @class = "text-danger" })
                                                            </div>                                                        
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                @if (Model?.Prp_JointPromoter_Name != null)
                                                {
                                                    if (Convert.ToInt32(TempData["JointPromoter_IsdraftValue"]) == 1 || Convert.ToInt32(TempData["JointPromoter_IsdraftValue"]) == 5 || Convert.ToInt32(TempData["JointPromoter_IsdraftValue"]) == 6)
                                                    {
                                                        <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        if (Model.IsLock == 1)
                                                        {
                                                            <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                        }
                                                        else if (Model.IsLock == 0)
                                                        {
                                                            if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                            {
                                                                <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                            }
                                                            else
                                                            {
                                                                if (Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 1 || Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 5 || Convert.ToInt32(TempData["PromoterIsdraftValue"]) == 6)
                                                                {
                                                                    <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary submit-track-litigations btn-jointpromoter-litigations" onclick="return loginuser();" />
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@ViewBag.submitvalue" class="btn btn-outline btn-primary btn-jointpromoter-litigations" disabled="disabled" />
                                                }
                                                &nbsp;
                                                @Html.ActionLink("Reset", "Create_JointPromoterTrackLitigations", "Promoter", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>

                                    <div id="dataTableContainer_byID">
                                        <!-- data via Ajax -->
                                    </div>
                                    <div id="dataTableContainer_default">
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    <div class="table-responsive">
                                                        <table class="table table-striped table-bordered" id="joint-promoter-list-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>
                                                                        @Html.DisplayNameFor(model => model.Project_Name)
                                                                    </th>
                                                                    <th>
                                                                        @Html.DisplayNameFor(model => model.Case_Title)
                                                                    </th>
                                                                    <th>
                                                                        @Html.DisplayNameFor(model => model.Case_Number)
                                                                    </th>
                                                                    <th>
                                                                        @Html.DisplayNameFor(model => model.Authority_ForumName_CasePendingResolved)
                                                                    </th>
                                                                    <th>@Html.DisplayName("Edit| Delete")</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var item in Model.prpongoing)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            @Html.DisplayFor(modelItem => item.Project_Name)
                                                                        </td>
                                                                        <td>
                                                                            @Html.DisplayFor(modelItem => item.Case_Title)
                                                                        </td>
                                                                        <td>
                                                                            @Html.DisplayFor(modelItem => item.Case_Number)
                                                                        </td>
                                                                        <td>
                                                                            @Html.DisplayFor(modelItem => item.Authority_ForumName_CasePendingResolved)
                                                                        </td>
                                                                        <td>
                                                                            @if (item.IsLock == 1)
                                                                            {
                                                                                @Html.ActionLink("View", "Edit_JointPromoterTrackLitigations", new { JPrmAppID = item.Related_JointPromoter_ID, JPrmType = item.Related_JointPromoterType, JPrmLitigationIndexID = item.JointPromoter_Litigations_IndexID, JPrmLitigationID = item.JointPromoter_Litigation_ID })
                                                                            }
                                                                            else if (Model.IsLock == 0)
                                                                            {
                                                                                if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                                                {
                                                                                    @Html.ActionLink("View", "Edit_JointPromoterTrackLitigations", new { JPrmAppID = item.Related_JointPromoter_ID, JPrmType = item.Related_JointPromoterType, JPrmLitigationIndexID = item.JointPromoter_Litigations_IndexID, JPrmLitigationID = item.JointPromoter_Litigation_ID })
                                                                                }
                                                                                else
                                                                                {
                                                                                    @Html.ActionLink("Edit", "Edit_JointPromoterTrackLitigations", new { JPrmAppID = item.Related_JointPromoter_ID, JPrmType = item.Related_JointPromoterType, JPrmLitigationIndexID = item.JointPromoter_Litigations_IndexID, JPrmLitigationID = item.JointPromoter_Litigation_ID }) @("| ")
                                                                                    @Html.ActionLink("Delete", "Delete_JointPromoterTrackLitigations", new { JPrmAppID = item.Related_JointPromoter_ID, JPrmType = item.Related_JointPromoterType, JPrmLitigationIndexID = item.JointPromoter_Litigations_IndexID, JPrmLitigationID = item.JointPromoter_Litigation_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                @Html.ActionLink("View", "Edit_JointPromoterTrackLitigations", new { JPrmAppID = item.Related_JointPromoter_ID, JPrmType = item.Related_JointPromoterType, JPrmLitigationIndexID = item.JointPromoter_Litigations_IndexID, JPrmLitigationID = item.JointPromoter_Litigation_ID })
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Not Applicable</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-2">
                                                                @Html.Label("Joint-Promoter's Status", htmlAttributes: new { @class = "control-label" })
