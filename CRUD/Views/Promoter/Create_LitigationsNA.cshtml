
<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Litigation related to Project, If Any</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Detail of Promoter Litigation(s) related to Project (If Any)
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Not Applicable</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-2">
                                                            @Html.Label("Litigation(s) Status", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-9 alert alert-warning">
                                                            Not Applicable, As per profile details, the detail of promoter litigation(s) related to the On-Going and Completed Projects Details and Profile in Past Five Years or since Inception - Nil.
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @Html.ActionLink("Reset", "Create_Litigations", "Promoter", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>                                 
                            }
                            <!-- /.col-lg-12 (nested) -->
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

}