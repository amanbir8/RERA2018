
<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Application for Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Agent Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Organization Member Details (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Upload Document(s).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Other State/UT Registration Number Detail (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-V: Application Fee.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-VI: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Organization Member(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Organization Member(s) - Chairman, Partner, Director or Other Authorized Signatory Details
                    <span class="pull-right">
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()                             
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Not Applicable</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-2">
                                                            @Html.Label("Organization Member Status", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-9 alert alert-warning">
                                                            Not Applicable, As per profile details, the Organization Member(s) details - Nil.
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        @Html.ActionLink("Cancel", "Create_Agent_memNA", "Agent", null, new { @class = "btn btn-outline btn-primary" })
                                    </div>
                                </div>
                            </div>
                            }
                        </div>

                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>

}
