<script type="text/javascript">
            $(function () {
                var baseUrl = $('body').attr('data-base-url');
                $.ajax({

                    type: "GET",
                    url: baseUrl + "Agent/GetState",
                    datatype: "Json",
                    success: function (data) {
                        $.each(data, function (index, value) {
                            $('#OfficeComm_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');

                            $("# option:contains(undefined)").remove();
                        });
                    }
                });

                $('#OfficeComm_AddressStateCode').change(function () {

                    $('#OfficeComm_AddressDistrictCode').empty();

                    $.ajax({
                        type: "POST",
                        url: baseUrl + "Agent/GetDistrictByStateId",
                        datatype: "Json",
                        data: { StateId: $('#OfficeComm_AddressStateCode').val() },
                        success: function (data) {
                            $.each(data, function (index, value) {
                                $('#OfficeComm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                            });
                        }
                    });
                });

                $('[data-toggle="tooltip"]').tooltip();

                $('table#promoter-documents-list-table').dataTable({
                    'aoColumnDefs': [{
                        'bSortable': false,
                        'aTargets': [5]
                    }],
                    "language": {
                        "info": "Showing _START_ to _END_ of _TOTAL_ records",
                        "lengthMenu": "Show _MENU_ records"
                    },
                    "pagingType": "full_numbers"
                });

            });
    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }
</script>
<script>
$(function() {
    $('[data-spzoom]').spzoom();

    if ($('#PhoneNumber_Number').val() === "0") {
        $('#PhoneNumber_Number').val("");
    }
});
</script>
