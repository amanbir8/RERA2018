<script>
    $(document).ready(function () {
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Application for Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Agent Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Organization Member Details (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Upload Document(s).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Other State/UT Registration Number Detail (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-V: Application Fee.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-VI: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Organization Member(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Organization Member(s) - Chairman, Partner, Director or Other Authorized Signatory Details
                    <span class="pull-right">
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("Create_Agent_mem", "Agent", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                <h6>@ViewBag.Message</h6>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.Agent_OtherMemberDetails_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.Agent_ID, new { htmlAttributes = new { @class = "form-control" } })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Organization Member Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Name of Chairman/ Director/ Authorized Signatory / Managing Director / Partner of the Organization as per the MoU.">
                                                            @Html.EditorFor(model => model.OtherMember_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Designation, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Designation as per MoU, Eg. - Chairman/ Partner/ Director/ Other Auhtorized Signatory etc.">
                                                            @Html.EditorFor(model => model.Designation, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Designation, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_PAN_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="PAN Number of the Member in the PAN Number format, eg. ABCDE1234F.">
                                                            @Html.EditorFor(model => model.OtherMember_PAN_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_PAN_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_Aadhaar_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="12 Digit Aadhaar Number of the Member.">
                                                            @Html.EditorFor(model => model.OtherMember_Aadhaar_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_Aadhaar_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Residential/ Communication Address</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OfficeComm_AddressLine1, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Valid address of the Member for all official communication with the Authority.">
                                                            @Html.EditorFor(model => model.OfficeComm_AddressLine1, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OfficeComm_AddressLine1, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OfficeComm_AddressLine2, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.OfficeComm_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OfficeComm_AddressLine2, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select State</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(m => m.OfficeComm_AddressStateCode, new SelectList(Model.stateMaster, "StateId", "StateName"), "Select State", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.OfficeComm_AddressStateCode, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select District</label>
                                                        </div>
                                                        @if (Model.districtMaster != null)
                                                        {
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.OfficeComm_AddressDistrictCode, new SelectList(Model.districtMaster, "DistrictId", "DistrictName"), "Select District", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.OfficeComm_AddressDistrictCode, "", new { @class = "text-danger" })
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OfficeComm_AddressPIN, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.OfficeComm_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.OfficeComm_AddressPIN, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Other Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Mobile Number of the Member without any prefix and country code.">
                                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                        @*<div class="form-group">
                                                            @Html.LabelFor(model => model.PhoneNumber_STD, htmlAttributes: new { @class = "control-label col-md-2" })
                                                            <div class="col-md-10">
                                                                @Html.EditorFor(model => model.PhoneNumber_STD, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.PhoneNumber_STD, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>*@
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.PhoneNumber_Number, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Landline Number with std code and without '0' prefix, eg. 1721234567.">
                                                            @Html.EditorFor(model => model.PhoneNumber_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PhoneNumber_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.EmailAddress, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Active and valid email Id of the Member.">
                                                            @Html.EditorFor(model => model.EmailAddress, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Upload Photograph</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("Upload Photograph", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        @*<div class="col-md-3">
                                                            <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" />
                                                        </div>*@
                                                        <div class="col-md-3">
                                                            <div class="input-group">
                                                                <label class="input-group-btn">
                                                                    <span class="btn btn-primary">
                                                                        Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                    </span>
                                                                </label>
                                                                <input type="text" id="Photo_AddressShow" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.HiddenFor(model => model.Image_FileName)
                                                            @Html.HiddenFor(model => model.Image_FilePath, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>                                                        
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.Image_FilePath)@Html.DisplayFor(model => model.Image_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.Image_FilePath)@Html.DisplayFor(model => model.Image_FileName)" alt="No Image" />
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            @TempData["notice"]<br />Photo Should be in .jpg format and less than 512KB
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Convert.ToInt32(TempData["AgentIsdraftValue"]) == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else
                                            {
                                                if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" onclick="return loginuser();" />
                                                }                                                
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Create_Agent_mem", "Agent", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
