                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.OtherMember_Aadhaar_Number)
                                            </th>                                            
                                            <th>
                                                @Html.DisplayNameFor(model => model.MobileNumber)
                                            </th>
                                            @*<th>
                                                @Html.HiddenFor(model => model.PhoneNumber_Number)
                                            </th>
                                            <th>
                                                @Html.HiddenFor(model => model.EmailAddress)
                                            </th>*@
                                            <th>@Html.DisplayName("Edit| Delete")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Agent_OtherMember)
                                        {
                                            <tr>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.OtherMember_Name)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Designation)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.OtherMember_PAN_Number)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.OtherMember_Aadhaar_Number)
                                                </td>
                                                @*<td>
                                                    @Html.DisplayFor(modelItem => item.PhoneNumber_Number)
                                                </td>*@
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.MobileNumber)
                                                </td>
                                                @*<td>
                                                    @Html.HiddenFor(modelItem => item.EmailAddress)
                                                </td>*@
                                                <td>
                                                    @if (Convert.ToInt32(TempData["AgentIsdraftValue"]) == 1)
                                                    {
                                                        @Html.ActionLink("View", "Edit_Agent_mem", new { Agent_OtherMemberDetails_ID = item.Agent_OtherMemberDetails_ID, id = item.ID, Application_id = item.Agent_ID })
                                                    }
                                                    else
                                                    {
                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            @Html.ActionLink("View", "Edit_Agent_mem", new { Agent_OtherMemberDetails_ID = item.Agent_OtherMemberDetails_ID, id = item.ID, Application_id = item.Agent_ID })
                                                        }
                                                        else
                                                        {
                                                            @Html.ActionLink("Edit", "Edit_Agent_mem", new { Agent_OtherMemberDetails_ID = item.Agent_OtherMemberDetails_ID, id = item.ID, Application_id = item.Agent_ID }) @("| ")
                                                            @Html.ActionLink("Delete", "Delete_Agent_mem", new { Agent_OtherMemberDetails_ID = item.Agent_OtherMemberDetails_ID, id = item.ID, Application_id = item.Agent_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                        }
                                                    }                                                
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>

}
