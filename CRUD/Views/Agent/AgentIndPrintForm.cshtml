@if (Model.IsOtherStateUT_RERAregistration != "N")
{
    <div id="wrapper">
        <div class="row">
            <div class="col-lg-12">
                <h3 class="page-header" style="margin-top: 15px;">RERA Registration Details with Other State/UT(s)</h3>
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-info">
                    <div class="panel-heading">
                        Registration Details for Agent Member with Other State/UT(s)
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-lg-12">
                                @if (Model.Agent_OtherStateUTMember != null)
                                {

                                    foreach (var item in Model.Agent_OtherStateUTMember)
                                    {


                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">RERA Registration Details</legend>

                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    <LabelFor class="control-LabelFor ">State</LabelFor>
                                                                </div>
                                                                <div class="col-md-3">

                                                                    @Html.DisplayFor(model => model.P_AddressState)

                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.Label("RERA Registration Issue Date", htmlAttributes: new { @class = "control-LabelFor " })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(model => item.RERAregistration_IssueDate, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => item.RERAregistration_IssueDate, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    @Html.Label("RERA Registration Number", htmlAttributes: new { @class = "control-LabelFor " })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(model => item.RERAregistration_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => item.RERAregistration_Number, "", new { @class = "text-danger" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.Label("RERA Registration Expiry Date")
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(model => item.RERAregistration_ExpiryDate, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => item.RERAregistration_ExpiryDate, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                            

                                    }
                                }


                            </div>
                        </div>

                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
}
