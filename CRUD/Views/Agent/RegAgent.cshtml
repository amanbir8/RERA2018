@model CRUD.Models.Agent.CLSprpAgent_Payment

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(function () {
        $('#AgentPayment_TitleCode').change(function () {
            $('#AgentPayment_TitleName').empty();
            $("input[name='AgentPayment_TitleName']").val($("#AgentPayment_TitleCode option:selected").text());
            //alert($("#AgentPayment_TitleCode option:selected").text());                
        });

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [6]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });
</script>
<script>
    $(function () {
        $('#Date_of_Payment_RegistrationFee').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
    });
</script> 
<script type="text/javascript">
         function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }

</script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();
    });
</script>

<script>

    var loginuser = function loginuser() {

        //"photo address" have value on submit button
        //and "user_photo" have value on update button
        //so check length of control on save (files.length) and update (path.length)

        var files = $("#Photo_Address").get(0).files;
        var path = $('#user_Photo').attr('src').replace('/', '');


        if (files.length > 0 || path.length > 0) {
            $(submitButton).parents('form').submit();            
        }
        else {
            if ($('#Payment_Mode').val() == 'Online Payment') {
                $(submitButton).parents('form').submit();
            }
            else {
                alert("Please Add Scan copy of DD/Banker Cheque file to Upload!")
                return false;
            }
        }

        //var files = ($("#Photo_Address"))[0].files[0];
        //if (files) {
        //    return true;
        //}
        //else {
        //    alert("Please Add Photograph file to Upload!")
        //    return false;
        //}
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        new PNotify({
            title: 'Notification',
            text: 'The registration fee for Agent registering as an Individual is INR 15,000/- (which includes INR 10000/- registration fee & INR 5000/- composite web-portal fee).',
            hide: false
        });

        new PNotify({
            title: 'Notification',
            text: 'The registration fee for Agent registering as other than Individual is INR 55,000/- (which includes INR 50000/- registration fee & INR 5000/- composite web-portal fee).',
            hide: false
        });

        new PNotify({
            title: 'Notification',
            // text: 'The registration payment can be made through Demand Draft (in favor of Real Estate Regulatory Authority, Punjab) as well as Online till 31st of October, 2018. Further from 1st of November, 2018 only Online Payment will be accepted.',
            // text: 'All payments need to be in the form of a Demand Draft in favor of Real Estate Regulatory Authority, Punjab.',
            text: 'All payments need to be in the form of a Online Payment Mode through web-portal i.e. only Online Payment(s) will be accepted.',
            type: 'info',
            hide: false            
        });
    });
</script>
<script type="text/javascript">
    $(function () {

        if ($('#Payment_Mode').val() != 'Online Payment') {
            $("#onlinepaymentrow1").css("display", "block");
            $("#onlinepaymentrow2").css("display", "block");
            $("#onlinepaymentrow3").css("display", "block");
            $("#onlinepaymentrow4").css("display", "block");
        }
        else {            
            $("#onlinepaymentrow1").css("display", "none");
            $("#onlinepaymentrow2").css("display", "none");
            $("#onlinepaymentrow3").css("display", "none");
            $("#onlinepaymentrow4").css("display", "none");
        }


        $('#Payment_Mode').on('change', function () {
            var paymentmode = $('#Payment_Mode').val();
            if (paymentmode != 'Online Payment') {
                $("#onlinepaymentrow1").css("display", "block");
                $("#onlinepaymentrow2").css("display", "block");
                $("#onlinepaymentrow3").css("display", "block");
                $("#onlinepaymentrow4").css("display", "block");
            }
            else {                
                $("#onlinepaymentrow1").css("display", "none");
                $("#onlinepaymentrow2").css("display", "none");
                $("#onlinepaymentrow3").css("display", "none");
                $("#onlinepaymentrow4").css("display", "none");
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Application for Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Agent Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Organization Member Details (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Upload Document(s).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Other State/UT Registration Number Detail (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-V: Application Fee.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-VI: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Application for Registration : Payment Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Payment for New Registration Fee(s)
                    <span class="pull-right">
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("RegAgent", "Agent", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()                              
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })                                    
                                @Html.HiddenFor(model => model.AgentPayment_IndexID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.AgentPayment_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.Agent_ID, new { htmlAttributes = new { @class = "form-control" } })
                              
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Payment (New Registration) Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">                                                            
                                                            @Html.LabelFor(model => model.AgentPayment_TitleCode, htmlAttributes: new { @class = "control-label mand" })
                                                            @*@Html.LabelFor(model => model.AgentPayment_TitleName, htmlAttributes: new { @class = "control-label" })*@
                                                            @Html.HiddenFor(model => model.AgentPayment_TitleName, new { htmlAttributes = new { @class = "form-control" } })
                                                            @*@Html.ValidationMessageFor(model => model.AgentPayment_TitleName, "", new { @class = "text-danger" })*@
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.AgentPayment_TitleCode, new SelectList(Model.PayFeeMaster, "PaymentType_Code", "PaymentType"), "Select", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.AgentPayment_TitleCode, "", new { @class = "text-danger" })
                                                        </div>                                                                                                                
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @{var listItems2 = new List<SelectListItem>
                                                                        {
                                                                            new SelectListItem {  Text = "Select" , Value=""  },
                                                                            new SelectListItem {  Text = "Demand Draft" , Value="Demand Draft"  },
                                                                            new SelectListItem {  Text = "Bankers Cheque" , Value="Bankers Cheque"  },
                                                                            new SelectListItem {  Text = "Online Payment" , Value="Online Payment"  },
                                                                        };
                                                            }
                                                            @Html.LabelFor(model => model.Payment_Mode, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.Payment_Mode, new SelectList(listItems2, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Payment_Mode, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Registration_Fee, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Registration_Fee, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Registration_Fee, "", new { @class = "text-danger" })
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Other_Fee, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Other_Fee, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Other_Fee, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" id="onlinepaymentrow1">
                                                    <div class="form-group">                                                        
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Bank_Charges, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Bank_Charges, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Bank_Charges, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Date_of_Payment_RegistrationFee, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Date_of_Payment_RegistrationFee, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Date_of_Payment_RegistrationFee, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" id="onlinepaymentrow2">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Bank_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.Bank_Name, new SelectList(Model.BankMaster, "BankName", "BankName"), "Select", new { @class = "form-control" })                                                            
                                                            @Html.ValidationMessageFor(model => model.Bank_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3"> 
                                                            @Html.LabelFor(model => model.Branch_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Branch_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Branch_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row"  id="onlinepaymentrow3">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.DD_BankersCheque_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.DD_BankersCheque_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.DD_BankersCheque_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.DD_BankersCheque_Amount, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.DD_BankersCheque_Amount, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.DD_BankersCheque_Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" id="onlinepaymentrow4">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Upload Scan copy of DD/ Bankers Cheque</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ImageDDorBankersCheque_FileName, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        @*<div class="col-md-3">
                                                            <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" />
                                                        </div>*@ 
                                                        <div class="col-md-3">
                                                            <div class="input-group">
                                                                <label class="input-group-btn">
                                                                    <span class="btn btn-primary">
                                                                        Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                    </span>
                                                                </label>
                                                                <input type="text" id="Photo_AddressShow" class="form-control">
                                                            </div>
                                                        </div>                                                       
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.HiddenFor(model => model.ImageDDorBankersCheque_FileName)
                                                            @Html.HiddenFor(model => model.ImageDDorBankersCheque_FilePath, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                        @*<div class="col-md-3">
                                                            <img id="user_Photo" height="100" width="90" style="border:solid" src="~/readwritedata/@Html.DisplayFor(model => model.ImageDDorBankersCheque_FileName,   new { htmlAttributes = new { @class = "form-control" } })" />
                                                        </div>*@
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.ImageDDorBankersCheque_FilePath)@Html.DisplayFor(model => model.ImageDDorBankersCheque_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.ImageDDorBankersCheque_FilePath)@Html.DisplayFor(model => model.ImageDDorBankersCheque_FileName)" alt="No Image" />
                                                            </a>
                                                        </div>                                                       
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">                                                            
                                                            @TempData["notice"]<br />Photo Should be in .jpg format and less than 512KB
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                            

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Convert.ToInt32(TempData["AgentIsdraftValue"]) == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else
                                            {
                                                if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" onclick="return loginuser();" />
                                                }                                                
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "RegAgent", "Agent", null, new { @class = "btn btn-outline btn-primary" })
                                            &nbsp;
                                            <span style="color:tomato;">@TempData["OnlinePayMessageShow"]</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.AgentPayment_TitleName)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Bank_Name)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DD_BankersCheque_Number)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DD_BankersCheque_Amount)
                                            </th>
                                            @*<th>
                                                @Html.DisplayNameFor(model => model.Date_of_Payment_RegistrationFee)
                                            </th>*@
                                            <th>
                                                @Html.DisplayNameFor(model => model.Registration_Fee)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Other_Fee)
                                            </th>
                                            <th>@Html.DisplayName("Payment| Edit| Delete")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.AgentPayment)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.AgentPayment_TitleName)
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.Bank_Name)
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayName("Online Payment")
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.DD_BankersCheque_Number)
                                                    }
                                                    else
                                                    {                                                        
                                                        if (item.IsActive != 1)
                                                        {
                                                            @Html.DisplayName("Online Payment [PENDING]")
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("Online Payment [COMPLETE]")
                                                        }
                                                    }                                                    
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.DD_BankersCheque_Amount)
                                                    }
                                                    else
                                                    {
                                                        if (item.IsActive != 1)
                                                        {
                                                            @Html.DisplayName("Online Payment [PENDING]")
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("Online Payment [COMPLETE]")
                                                        }
                                                    }                                                    
                                                </td>
                                                @*<td>
                                                    @Html.DisplayFor(modelItem => item.Date_of_Payment_RegistrationFee)
                                                </td>*@
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Registration_Fee)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Other_Fee)
                                                </td>
                                                <td>
                                                    @if (Convert.ToInt32(TempData["AgentIsdraftValue"]) == 1)
                                                    {
                                                        if (item.Payment_Mode != "Online Payment")
                                                        {
                                                            @Html.ActionLink("View", "Edit_AgentPayment", new { AgentPayment_ID = item.AgentPayment_ID, Indexid = item.AgentPayment_IndexID, Application_id = item.Agent_ID })
                                                        }
                                                        else
                                                        {
                                                            @Html.ActionLink("View", "Detail_RequestAgentApplicationPayment", "AgentPayment", new { RelatedPaymentCode = item.AgentPayment_ID }, null)
                                                        }
                                                    }
                                                    else
                                                    {
                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            if (item.Payment_Mode != "Online Payment")
                                                            {
                                                                @Html.ActionLink("View", "Edit_AgentPayment", new { AgentPayment_ID = item.AgentPayment_ID, Indexid = item.AgentPayment_IndexID, Application_id = item.Agent_ID })
                                                            }
                                                            else
                                                            {
                                                                @Html.ActionLink("View", "Detail_RequestAgentApplicationPayment", "AgentPayment", new { RelatedPaymentCode = item.AgentPayment_ID }, null)
                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (item.Payment_Mode != "Online Payment")
                                                            {
                                                                @Html.ActionLink("Edit", "Edit_AgentPayment", new { AgentPayment_ID = item.AgentPayment_ID, Indexid = item.AgentPayment_IndexID, Application_id = item.Agent_ID }) @("| ")
                                                                @Html.ActionLink("Delete", "Delete_AgentPayment", new { AgentPayment_ID = item.AgentPayment_ID, AgentPayment_IndexID = item.AgentPayment_IndexID, Agent_ID = item.Agent_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                            }
                                                            else
                                                            {
                                                                if (item.IsActive != 1)
                                                                {
                                                                    @Html.ActionLink("Make Payment", "Detail_RequestAgentApplicationPayment", "AgentPayment", new { RelatedPaymentCode = item.AgentPayment_ID }, new { @class = "btn btn-danger" })
                                                                }
                                                                else
                                                                {
                                                                    @Html.ActionLink("View", "Detail_RequestAgentApplicationPayment", "AgentPayment", new { RelatedPaymentCode = item.AgentPayment_ID }, new { @class = "btn btn-outline btn-primary" })
                                                                }
                                                            }
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}
