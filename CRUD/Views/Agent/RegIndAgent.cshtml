<script type="text/javascript">
    function Get_Rear_Number() {
        var baseUrl = $('body').attr('data-base-url');
        var resetFlag = 1;
        var typeAgent = 1;
        resetFlag = parseInt(resetFlag);
        typeAgent = parseInt(typeAgent);
        $.ajax({
            type: "POST",
            url: baseUrl + "Agent/GetReraExistingNumberByID",
            datatype: "Json",
            data: { 'RERA_RegNumber': $('#Existing_RERANumber').val(), 'typeAgent': typeAgent, 'resetFlag': resetFlag },
            success: function (data) {
                $.each(data, function (index, value) {
                    if (value.EnableStatus == 'Success') {
                        if (value.FlagStatus == 'Y') {
                            $('#Agent_FirstName').val(value.Agent_FirstName);
                            $('#Agent_MiddleName').val(value.Agent_MiddleName);
                            $('#Agent_LastName').val(value.Agent_LastName);

                            $('#Existing_RERANumber').attr('readonly', true);
                            $('#Agent_FirstName').attr('readonly', true);
                            $('#Agent_MiddleName').attr('readonly', true);
                            $('#Agent_LastName').attr('readonly', true);
                        }
                        else {
                            message_alert_statusfunction();                            
                        }
                    }
                    else if (value.EnableStatus == 'NA') {
                        if (value.FlagStatus == 'Y') {
                            message_alert_statusfunction();
                        }
                        else {
                            message_alert_notapplicable();
                        }
                    }
                    else if (value.EnableStatus == 'OtherState') {                        
                        if (value.FlagStatus == 'Y') {
                            $("#chkYes").prop('checked', true);
                            $("#idReraNo").show();
                            $('#Existing_RERANumber').attr('readonly', false);
                            $('#Agent_FirstName').attr('readonly', false);
                            $('#Agent_MiddleName').attr('readonly', false);
                            $('#Agent_LastName').attr('readonly', false);
                        }
                        else {
                            $('#Existing_RERANumber').val('');
                            $("#idReraNo").hide();
                            $("#chkNo").prop('checked', true);
                        }
                    }
                    else {
                        message_alert_error();                        
                    }
                });
            }
        });
    };

    function message_alert_statusfunction() {
        $(document).ready(function () {
            swal({
                title: "Something went wrong!",
                text: "Error! Invalid RERA Registration Number.",
                type: "error",
                showCancelButton: true,
                confirmButtonText: "Yes, Try again!",
                cancelButtonText: "No, cancel!",
                closeOnConfirm: false,
                closeOnCancel: false
            }, function (isConfirm) {
                if (isConfirm) {
                    swal("Are you sure?", "Please enter valid Registration Number.", "warning");
                    $('#Existing_RERANumber').val('');
                } else {
                    swal("Cancelled", "No record found! Request cancelled.", "success");
                    $('#Existing_RERANumber').val('');
                    $("#idReraNo").hide();
                    $("#chkNo").prop('checked', true);
                }
            });
        });
    };

    function message_alert_notapplicable() {
        $(document).ready(function () {
            swal({
                title: 'Unknown Value!',
                text: 'Invalid! Registration Number.',
                icon: 'warning',
                confirmButtonText: 'OK'
            });
            $('#Existing_RERANumber').val('');
            $("#idReraNo").hide();
            $("#chkNo").prop('checked', true);
        });
    };

    function message_alert_error() {
        $(document).ready(function () {
            swal({
                title: 'Error!',
                text: 'Something went wrong. Try Again!',
                icon: 'error',
                confirmButtonText: 'OK'
            });
            $('#Existing_RERANumber').val('');
            $("#idReraNo").hide();
            $("#chkNo").prop('checked', true);
        });
    };
</script>

