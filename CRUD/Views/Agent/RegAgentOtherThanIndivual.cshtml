            } else {
                $("input[name='BComm_AddressLine1']").val('');
                $("input[name='BComm_AddressLine2']").val('');
                $("input[name='BComm_AddressPIN']").val('');
                $("select[name='BComm_AddressDistrictCode']").val('');
                $("select[name='BComm_AddressStateCode']").val('');
                //$('input[name=city\\[' + this.value + '\\]]').val('');
                //$('input[name=state\\[' + this.value + '\\]]').val('');
            }
        });

        $("input[name='IsAlready_RERANumber']").click(function () {
            if ($("#chkYes").is(":checked")) {
                $("#idReraNo").show();
                $('#Existing_RERANumber').attr('readonly', false);
                $('#Organization_Name').attr('readonly', false);
            }
            else {
                $("#idReraNo").hide();
                $('#Organization_Name').attr('readonly', false);
                $('#Existing_RERANumber').attr('readonly', false);
                $('#Existing_RERANumber').val('');
                $('#Organization_Name').val('');
            }
        });

        if ($("#chkYes").is(":checked")) {
            $("#idReraNo").show();
            $('#Existing_RERANumber').attr('readonly', false);
            $('#Organization_Name').attr('readonly', false);
        }
        else {
            $("#idReraNo").hide();            
            $('#Organization_Name').attr('readonly', false);
            $('#Existing_RERANumber').attr('readonly', false);
            $('#Existing_RERANumber').val('');
