@model CRUD.Models.classProjectPmPayment.ClsPrp_ProjectPmApplication_PaymentIntegration

@*Payment Failed*@

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Payment Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Payment for Registration Fees
                </div>
                <div class="panel-body">                    
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()

                                @Html.HiddenFor(model => model.PaymentRefNumberProjectPm_IndexID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PaymentRefNumberProjectPm_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.RelatedProject_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.RelatedPromoter_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.RelatedProject_Code, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.RelatedPromoter_Code, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.RelatedPayment_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.RelatedPayment_IndexID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.ProjectPmZoneType, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PromoterType_IO, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.PG_Product_Info, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Amount, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Amount_INR, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Additional_Charges, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Transaction_Fee, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Merchant_Name, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.PG_Address_Line1, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Address_Line2, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_City, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_State, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Country, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_ZipCode, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.PG_Shipping_Firstname, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Lastname, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Phone, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Address1, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Address2, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_City, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_State, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Country, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Shipping_Zipcode, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.PG_Customer_Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Last_Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Customer_Phone, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Customer_Email, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.PG_Status, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_PayU_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Transaction_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Date, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Bank_Reference_No, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Payment_Type, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_Payment_Gateway, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_UDF_1, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PG_UDF_2, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.HiddenFor(model => model.ProjectPm_BriefSummary, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.IsPaymentSuccessComplete, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.PaymentSuccessDate, new { htmlAttributes = new { @class = "form-control" } })

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Particulars of Online Payment (in rupees) Details</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">A/c Holder's Name</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Customer_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Customer_Name, "", new { @class = "text-danger" })
                                                            @Html.DisplayFor(model => model.PG_Last_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Last_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">Mobile Number</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Customer_Phone, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Customer_Phone, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label">E-Mail ID</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Customer_Email, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Customer_Email, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <br />
                                                <b>Particulars of Online Payment (in rupees)</b>
                                                <hr />
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Fee Amount (INR)</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Amount, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Amount, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Additional Charges (INR)</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Additional_Charges, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Additional_Charges, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Transaction Fee (INR)</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PG_Transaction_Fee, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.PG_Transaction_Fee, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Online Payment Status Info (in respect of the fee) Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12 align-center">
                                                            <img src="@Url.Content("~/images/sorrymsg.png")" alt="Sorry for Inconvenience" height="210" width="250">
                                                        </div>                                                        
                                                    </div>
                                                </div>                                                
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        @*<input type="submit" value="@TempData["submitvalueFormMStep2furl"]" class="btn btn-outline btn-primary" />*@
                                        @Html.ActionLink("Payment Try Again", "RequestProjectPmApplicationPayment", "ProjectPmPayment", null, new { @class = "btn btn-outline btn-primary" })
                                        &nbsp;
                                        @Html.ActionLink("Reset", "failurepaymentprojectpmapp", "ProjectPmPayment", null, new { @class = "btn btn-outline btn-primary" })
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- /.panel-body -->
                    </div>
                    <!-- /.panel -->
                </div>
                <!-- /.col-lg-12 -->
            </div>
            <!-- /.row -->
        </div>
    </div>
    <!-- /.wrapper -->
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
}





