@model CRUD.Models.classProjectPmPayment.ClsPrp_ProjectPmApplication_PaymentIntegration

<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet" />
<!-- DataTables JavaScript -->
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
<link href="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
<!-- Custom Theme JavaScript -->
<script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 15,
            "lengthMenu": [[15, 30, 45, 60], [15, 30, 45, 60]],
            'aoColumnDefs': [{
                //'bSortable': false,
                //'aTargets': [8, 9]
            }]
        });

    });
</script>

<script>
    $(document).ready(function () {

        $(document).on('click', '.btnReverifyPayment', function () {

            var baseUrl = $('body').attr('data-base-url');
            var txnID = $(this).data('txnid');

            $.ajax({
                url: baseUrl + "ProjectPmPayment/reverifyTxnAPI",
                type: 'GET',
                dataType: 'json',
                data: {
                    zPG_Transaction_ID: txnID
                },
                success: function (res) {
                    swal({
                        title: "Payment Status",
                        text: res.message,
                        type: res.type == 'success' ? 'success' :
                            res.type == 'warning' ? 'warning' : 'error',
                        confirmButtonText: "OK"
                    }, function () {
                        location.reload();
                    });
                },
                error: function () {
                    swal({
                        title: "Payment Status",
                        text: "Error while verifying payment.",
                        type: "error"
                    });
                }
            });

        });

    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">ReVerify Project(s) Payment</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->

    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="home-tab" href="@Url.Action("AllProjectreverify", "ProjectPmPayment")" role="tab" aria-controls="home" aria-selected="true">Project</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("AllProjectExtnreverify", "ProjectPmPayment")" role="tab" aria-controls="profile" aria-selected="false">Project Extensions</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="link-tab" href="@Url.Action("AllEpayPaymentsReverify", "ProjectPmPayment")" role="tab" aria-controls="link" aria-selected="false">Epay</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Project Payment : Details
                    @*<span class="pull-right">
                            <a class="complainantdeskHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        </span>*@
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Product_Info)</th>
                                            <th>@Html.DisplayNameFor(model => model.PaymentSuccessDate)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Transaction_ID)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Customer_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Customer_Email)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Amount_INR)</th>
                                            <th>@Html.DisplayName("Re-Verify")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.ProjectPmPayment)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Product_Info)</td>
                                                <td>@item.PaymentSuccessDate.ToString("dd MMMM yyyy")</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Transaction_ID)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Customer_Name)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Customer_Email)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Amount_INR)</td>
                                                <td class="center">
                                                    <button type="submit"
                                                            class="btn btn-success btnReverifyPayment"
                                                            data-txnid="@item.PG_Transaction_ID">
                                                        <i class="fa fa-refresh"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- /.row (nested) -->
                </div>
                <!-- /.panel-body -->
            </div>
            <!-- /.panel -->
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
}