@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthorityDesk_FormExeEventLog


<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script type="text/javascript">

    @if (TempData["EventSubmitMessage"].ToString() != "")
    {
        if (TempData["EventSubmitMessageSaveAsDraftFlag"].ToString() != "99")
        {
            if (TempData["EventSubmitMessageSaveAsDraftFlag"].ToString() == "1")
            {
                <text >
                    $(document).ready(function () {
                        swal({
                            title: "Message",
                            text: "@TempData["EventSubmitMessage"]",
                            type: "success"
                        }, function () {
                            window.location = "../HelpdeskComplaint/FormExe_InfoDesk";
                        });
                    });
                </text>
            }
            else
            {
                <text >
                    $(document).ready(function()
                        {
                        swal({
                        title: "Message",
                            text: "@TempData["EventSubmitMessage"]",
                            type: "warning"
                        });
                    });
                </text>
            }
        }
    }


</script>
<script type="text/javascript">
    $(document).ready(function () {

        $('#EventAction_Type').change(function () {

            var BASE_URLn = $('body').attr('data-base-url');

            $.ajax({
                type: "POST",
                url: BASE_URLn + 'HelpdeskComplaint/GetEventDescriptionMasterDetailsByEventCode',
                datatype: "Json",
                data: { EventCode: $('#EventAction_Type').val() },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    $.each(data, function (index, value) {

                        $('#getEventDescFileInfo').show();
                        $('#EventDescDiscription').text("Description : " + value.EventAction_Description);
                    });
                }
            });
        });
    });
</script>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonCode', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormExe_Id = $('#Related_Complaint_ID').val();
            FormExe_Id = parseInt(FormExe_Id);
            var varDNumber = $("#Related_RegDiaryNumber").val();
            var varProjectName = $.trim($(document).find("div.project-name").text());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormExeInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormExe_Id': FormExe_Id },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });

            $(projectDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
   // get remaining words count for textarea
   var maxMessageLength = 1500;
    var messageField = $('#myform_FormExeInfoEventInsert').find('textarea#Remarks_IfAny');
   $('body').on('input', 'textarea#Remarks_IfAny', function (e) {
       var msgVal = $(this).val();
       var msgValLen = msgVal.length;
       if (msgValLen <= maxMessageLength) {
           var remaining = parseInt(maxMessageLength - msgValLen);
           $(this).parents('.form-group').find('.words-remain').html(remaining + ' characters remaining');
       }
   });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Complaint (Form-Execution) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Form-Execution (Complaint under section 31 of the Act) [See rule 36(1)] Action Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("FormExeInfoEventInsert", "HelpdeskComplaint", FormMethod.Post, new { enctype = "multipart/form-data", id = "myform_FormExeInfoEventInsert" }))
                            {
                                @Html.AntiForgeryToken()

                                @*<div class="form-horizontal col-md-10" style="position:relative;margin-left:5%;text-align:left;">*@
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.ComplaintFormexe_EventAction_ID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.Related_Complaint_ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => model.Related_RegDiaryNumber, new { htmlAttributes = new { @class = "form-control" } })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Complaint Form-Execution - ( @Html.DisplayFor(model => model.Related_RegDiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ComplainantName, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-5 project-name">
                                                            @Html.DisplayFor(model => model.ComplainantName, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                        <div class="col-md-2">
                                                            @Html.LabelFor(model => model.ComplaintFormLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-2">
                                                            @Html.DisplayFor(model => model.ComplaintFormLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                @Html.Partial("_AuthorityDeskComplaintFormExeNavMenuPartial")

                                <div class="row">
                                    <div class="col-lg-12">
                                        <h4 class="page-header" style="margin-top: 15px;"><a class="modalOpenerButtonCode" href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>Application Action Details</h4>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Application Action Operations</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.EventAction_Type, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        @if (Model.EventMaster != null)
                                                        {
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.EventAction_Type, new SelectList(Model.EventMaster, "EventAction_Code", "EventAction_Aggregate"), "Select", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.EventAction_Type, "", new { @class = "text-danger" })
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.EventAction_Type, new SelectList(" "), "Select", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.EventAction_Type, "", new { @class = "text-danger" })
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row" id="getEventDescFileInfo" style="display:none">
                                                    <div class="help-block col-md-offset-3 col-md-9">
                                                        <div id="EventDescDiscription" class="info"></div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Remarks_IfAny, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Remarks_IfAny, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Remarks_IfAny, "", new { @class = "text-danger" })
                                                            <i class="words-remain help-block">
                                                                1500 characters remaining
                                                            </i>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <a href="@Url.Action("FormExeInfoFileHistoryListPDF", "HelpdeskComplaint")" target="_blank">
                                                                <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                                            </a> (File History .PDF)
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" id="getChecklistDescFileInfo" style="display:none">
                                                    <div class="help-block col-md-offset-3 col-md-9">
                                                        <div id="ChecklistDescDiscription" class="info"></div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                            &nbsp;
                                            @Html.ActionLink("Reset", "FormExeInfoEventInsert", "HelpdeskComplaint", null, new { @class = "btn btn-outline btn-primary" })
                                            &nbsp;
                                            <input type="submit" value="Save As Draft" formaction="@Url.Action("FormExeInfoEventInsertSaveAsDraftRemarks")" formmethod="post" class="btn btn-outline btn-info" />
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Checklist Criteria Details <a href="javascript:void(0);" class="title-project-details"></a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


