@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthDesk_FormM_DiaryNumberPreHearing

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormM_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            FormM_Id = parseInt(FormM_Id);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormMInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormM_Id': FormM_Id },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title').html('File History Details - ' + diaryNo + ' (' + agentName + ')');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a#modalOpenerPreHearingNoticeButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormM_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            FormM_Id = parseInt(FormM_Id);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormM_PreHearingNotice',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormM_Id': FormM_Id },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Notice : ' + diaryNo + ' (' + agentName + ')');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a#modalOpenerPreHearingRespondentNoticeButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormM_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            FormM_Id = parseInt(FormM_Id);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormM_PreHearingRespondentNotice',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormM_Id': FormM_Id },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Notice : ' + diaryNo + ' (' + agentName + ')');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });
    });

    $(document).ready(function () {
        $('[data-toggle="popover"]').popover({
            title: false,
            content: setData,
            html: true,
            placement: 'right'
        });

        function getReadableDateFormat(dateString) {
            var today = new Date(dateString);
            var dd = today.getDate();
            var mm = today.getMonth() + 1; //January is 0!
            var monthsArray = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var monthName = monthsArray[today.getMonth()];
            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd;
            }
            if (mm < 10) {
                mm = '0' + mm;
            }
            var RetDate = dd + '-' + monthName + '-' + yyyy;
            return RetDate;
        }

        function setData(id) {
            var set_data = '';
            var element = $(this);
            var parentRow = $(element).parents('tr');

            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var popHearingDate = $.trim($(parentRow).find('input#hdnHearingDate').val());
            var popHearingTime = $.trim($(parentRow).find('input.hdnHearingTime').val());
            var popHearingBench = $.trim($(parentRow).find('input.hdnHearingBench').val());
            var popHearingType = $.trim($(parentRow).find('input.hdnHearingType').val());
            var popHearingFixedFor = $.trim($(parentRow).find('input.hdnHearingFixFor').val());

            set_data = '<div class="row" style="line-height:23px; margin-top:10px;">' +
                            '<div class="col-lg-12">' +
                                '<div><span style="font-weight:bold;">Diary Number:</span>  ' + diaryNo + '</div>' +
                                '<div><span style="font-weight:bold;">Hearing Date:</span>  ' + getReadableDateFormat(popHearingDate) + ' (' + popHearingTime + ')</div>' +
                                '<div><span style="font-weight:bold;">Hearing Bench:</span>  ' + popHearingBench + '</div>' +
                                '<div><span style="font-weight:bold;">Hearing Type:</span>  ' + popHearingType + '</div>' +
                                '<div><span style="font-weight:bold;">Fixed For:</span>  ' + popHearingFixedFor + '</div>' +
                            '</div>' +
                        '</div>';
            return set_data;
        }
    });
</script>
<script>
    $(document).ready(function () {
        var BASExn_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASExn_URL + 'HelpdeskComplaint/PreHearingComplaintsFormM_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerComplaintFormMdetails);
    });
    function infohelpHandlerComplaintFormMdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Hearing Case(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Hearing records for Form-M complaints regarding real-estate project/ agent/ allottee(s).<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .nav-tabs > li.active > a {
        border-top: 2px solid #7bb73f;
    }

    .nav-tabs > li > a {
        background-color: #eee;
        color: #333;
    }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Form-M Complaint(s)</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="home-tab" href="@Url.Action("FormM_InfoDeskPreHearingDetail", "HelpdeskComplaint")" role="tab" aria-controls="home" aria-selected="true">Hearing Record Details</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("FormN_InfoDeskPreHearingDetailTransferCaseNM", "HelpdeskComplaint")" role="tab" aria-controls="profile" aria-selected="false">Transfer Case (Hearing Record Details)</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="bifurcate-tab" href="@Url.Action("FormM_InfoDeskPreHearingBifurcateCaseDetail", "HelpdeskComplaint")" role="tab" aria-controls="bifurcate" aria-selected="false">Bifurcate Case (Hearing Record Details)</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Form-M Complaints : Hearing Record Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.ComplaintRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Complainant_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Respondent_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.RelatesComplaint_ComplaintAgainstType)</th>
                                            <th>@Html.DisplayName("Entrusted To")</th>
                                            <th>@Html.DisplayName("Last Application Status")</th>                                            
                                            <th>@Html.DisplayName("Hearing Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="agent-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)">
                                                    <a href="javascript:void(0);" data-toggle="popover" data-trigger="hover" id="@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)</a>
                                                </td>
                                                <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.Complainant_Name)">@Html.DisplayFor(modelItem => item.Complainant_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Respondent_Name)
                                                    @Html.HiddenFor(modelItem => item.FormM_RelatedComplaint_ID, new { @class = "hdnAgentID" })
                                                    @Html.HiddenFor(modelItem => item.PreHearingDate, new { @class = "control-label", @id = "hdnHearingDate" })
                                                    @Html.HiddenFor(modelItem => item.PreHearingTime, new { @class = "hdnHearingTime" })
                                                    @Html.HiddenFor(modelItem => item.HearingBench_Bcolumn, new { @class = "hdnHearingBench" })
                                                    @Html.HiddenFor(modelItem => item.HearingType_Acolumn, new { @class = "hdnHearingType" })
                                                    @Html.HiddenFor(modelItem => item.PreHearingFixedForName, new { @class = "hdnHearingFixFor" })
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.A_column)
                                                    @*@Html.DisplayFor(modelItem => item.RelatesComplaint_ComplaintAgainstType)*@                                                    
                                                </td> 
                                                <td>@Html.DisplayFor(modelItem => item.HearingBench_Bcolumn)</td>                                               
                                                @if (item.EventAction_Type.ToString() == "330011")
                                                {
                                                    <td class="success">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.PreHearingDate)
                                                        @Html.DisplayName(" (")
                                                        @Html.DisplayFor(modelItem => item.PreHearingTime)
                                                        @Html.DisplayName(")")
                                                    </td>
                                                }
                                                else if (item.EventAction_Type.ToString() == "330007")
                                                {
                                                    <td class="danger">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.PreHearingDate)
                                                        @Html.DisplayName(" (")
                                                        @Html.DisplayFor(modelItem => item.PreHearingTime)
                                                        @Html.DisplayName(")")
                                                    </td>
                                                }
                                                else if (item.EventAction_Type.ToString() == "330061" || item.EventAction_Type.ToString() == "330058")
                                                {
                                                    <td>
                                                        <a id="modalOpenerPreHearingNoticeButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)                                                        
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.PreHearingDate)
                                                        @Html.DisplayName(" (")
                                                        @Html.DisplayFor(modelItem => item.PreHearingTime)
                                                        @Html.DisplayName(")")
                                                    </td>
                                                }
                                                else if (item.EventAction_Type.ToString() == "330059")
                                                {
                                                    <td>
                                                        <a id="modalOpenerPreHearingRespondentNoticeButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.PreHearingDate)
                                                        @Html.DisplayName(" (")
                                                        @Html.DisplayFor(modelItem => item.PreHearingTime)
                                                        @Html.DisplayName(")")
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.PreHearingDate)
                                                        @Html.DisplayName(" (")
                                                        @Html.DisplayFor(modelItem => item.PreHearingTime)
                                                        @Html.DisplayName(")")
                                                    </td>
                                                }
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">                                                    
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">                                                   
                                                    @Html.ActionLink("View", "FormMInfoEventInsertAction", new { FormMDiaryNumber = item.ComplaintRegDiaryNumber_Name, FormMComplainantName = item.Complainant_Name, FormMRespondantName = item.Complainant_Name, ComplainantRERAnumber = 0, ComplaintFormM_ID = item.FormM_RelatedComplaint_ID, LastModifiedOn = item.EventAction_IdentifiedOn,profileid = item.Profile_ID, diarynumberid = item.ComplaintRegDiaryNumber_ID, diarynumberyear = item.ComplaintRegDiaryNumber_NameYear, type = item.ComplaintType_MN })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

