    function lockUnlockHandlerDoclist() {
        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmLockUnlock = $.trim($(document).find('#IsDraftAllDocuments').val());
            var parmComplaintID = $.trim($(document).find('#zapRelated_Complaint_ID').val());
            var parmRelatedComplaintID = $.trim($(document).find('#ComplainantApplicant_RelatedComplaint_ID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskComplaint/LockUnlockHandler_FormNcomplaintDocumentList',
                data: { 'parmComplaintID': parmComplaintID, 'parmLockUnlock': parmLockUnlock, 'parmRelatedComplaintID': parmRelatedComplaintID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockdoclistDetails").attr("title", "Unlock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockdoclistDetails").attr("title", "Lock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
    function lockUnlockHandlerDocument() {
        var elem = $(this);
        var parmComplaintID = $.trim($(document).find('#zapRelated_Complaint_ID').val());
        var parmRelatedComplaintID = $.trim($(document).find('#ComplainantApplicant_RelatedComplaint_ID').val());
        var parmLockUnlockdoc = $(this).attr('data-locknnlockdoc-code');
        var parmDocindex = $(this).attr('data-docindex-code');

        if (parmLockUnlockdoc == 1 || parmLockUnlockdoc == 5) {

            var btnLabel = $(this).attr("title");
            var cnfrmTxt = "Do you want to lock details?";
            if (btnLabel == "Unlock Details") {
                var cnfrmTxt = "Do you want to unlock details?";
            }

            if (confirm(cnfrmTxt)) {
                var baseUrllockunlock = $('body').attr('data-base-url');

                $.ajax({
                    type: 'GET',
                    url: baseUrllockunlock + 'HelpdeskComplaint/LockUnlockHandler_FormNcomplaintDocumentByIndex',
                    data: { 'parmComplaintID': parmComplaintID, 'parmLockUnlock': parmLockUnlockdoc, 'parmRelatedComplaintID': parmRelatedComplaintID, 'parmDocIndex': parmDocindex },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        alert(data.status);
                        if (data.statusCode == 101) {
                            elem.find("span").removeClass("btn-warning").addClass("btn-primary");
                            elem.attr("title", "Unlock Details");
                            elem.find("i").removeClass("fa-unlock").addClass("fa-key");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        } else if (data.statusCode == 105) {
                            elem.find("span").removeClass("btn-primary").addClass("btn-warning");
                            elem.attr("title", "Lock Details");
                            elem.find("i").removeClass("fa-key").addClass("fa-unlock");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        }
                    },
                    failure: function (data) {
                        alert('Bad Request! Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Error');
                    }
                });
            }
        }
        else {
            $(this).preventDefault();
        }
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Complaint (Form-N) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of enclosures in support of the complaint (Form-N)
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Complaint Form-N - ( @Html.DisplayFor(model => model.zapRelated_RegDiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zapComplainantName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5 project-name">
                                                        @Html.DisplayFor(model => model.zapComplainantName, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.HiddenFor(model => model.ComplainantApplicant_RelatedComplaint_ID)
                                                        @Html.HiddenFor(model => model.zapRelated_RegDiaryNumber)                                                        
                                                        @Html.HiddenFor(model => model.IsDraftAllDocuments)
                                                        @Html.HiddenFor(model => model.zapRelated_Complaint_ID)
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapComplaintFormLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zapComplaintFormLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskComplaintFormNNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;">
                                        <a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>List of Enclosures/ Document(s) in support of the complaint (Form-N) Details
                                        <span class="pull-right">
                                            @*<a class="modalOpenerButtonExpandDocument" data-document-code="158" data-subdocument-code="0" data-document-flag="1" href="javascript:void(0);" title="View Documents"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-text" aria-hidden="true"></i></span></a>*@
                                            <a class="a lock-doclist-details" id="btnLockdoclistDetails" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                        </span>
                                    </h4>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Doc_SerialNumber)
                                            </th>
                                            <th>@Html.Label("Activity")</th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.ComplaintDoc_InfoName)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.ComplaintDoc_ReferenceNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Doc_PageStartNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                            </th>
                                            <th>
                                                @Html.Label("View")
                                            </th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int pagelastnumber = 0;
                                        }
                                        @foreach (var item in Model.prpFormN_Docs)
                                        {
                                            {
                                                pagelastnumber = item.Doc_PageStartNumber + item.Doc_PageEndNumber - 1;
                                            }
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_SerialNumber)
                                                </td>
                                                <td style="text-align:center;">
                                                    <span>
                                                        @if (item.IsDraft == 1)
                                                        { //L
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ListEnclDocument_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                        }
                                                        else if (item.IsDraft == 5)
                                                        { //UL
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ListEnclDocument_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                        }
                                                        else if (item.IsDraft == 6)
                                                        { //PL
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ListEnclDocument_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs disabledlockunlock"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ListEnclDocument_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs disabledlockunlock"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                        }
                                                    </span>
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_InfoName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_ReferenceNumber)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_PageStartNumber)
                                                    @Html.DisplayName(" (Pages ")
                                                    @Html.DisplayFor(modelItem => item.Doc_PageEndNumber)
                                                    @Html.DisplayName(" to ")
                                                    @Html.DisplayName(pagelastnumber.ToString())
                                                    @Html.DisplayName(" )")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                </td>
                                                <td>
                                                    <a href="~/@Html.DisplayFor(modelItem => item.ComplaintDoc_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                </td>                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

