<script type="text/javascript">
    $(document).ready(function () {

        $("#AssignementBench_ID").change(function () {
            var selectedName = $("#AssignementBench_ID option:selected").text();
            $("#AssignementBench_Name").val(selectedName);
        });

        function updateBenchState() {
            var benchDropdown = $('#AssignementBench_ID');
            var benchNameHidden = $('#AssignementBench_Name');
            var onlineRadioButton = $('#rbBenchAutomatic');
            var onlineId = onlineRadioButton.data('online-id');
            var onlineName = onlineRadioButton.data('online-name');

            if ($('#rbBenchManual').is(':checked')) {
                // --- MANUAL MODE ---
                benchDropdown.prop('disabled', false);
                benchDropdown.find("option[value='" + onlineId + "']").remove();

                if (benchDropdown.val() == onlineId) {
                    benchDropdown.val('');
                    benchNameHidden.val('');
                }
            } else {
                // --- ONLINE MODE ---
                if (benchDropdown.find("option[value='" + onlineId + "']").length === 0) {
                    benchDropdown.append($('<option>', { value: onlineId, text: onlineName }));
                }
                benchDropdown.val(onlineId);
                benchNameHidden.val(onlineName);
                benchDropdown.prop('disabled', true);
            }
        }

        $('input[name="IsManualAssignBench"]').on('change', updateBenchState);

        updateBenchState();

        $('#caseAssignmentForm').on('submit', function () {
            $('#AssignementBench_ID').prop('disabled', false);
        });
    });
</script>

