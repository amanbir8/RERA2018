<script>
    $(document).ready(function () {
        function toggleHardcopySection() {
            var val = $('.isHardcopy:checked').val();
            if (val === '1') {
                $('.hardcopydetails').slideDown(400);
            } else {
                $('.hardcopydetails').slideUp(400);
            }
        }
        toggleHardcopySection();
        $('.isHardcopy').change(function () {
            toggleHardcopySection();
        });
         var isLocked = '@Model.IsLock';
        if (isLocked === '1') {
            //$("#optionalDetailsFieldset input[type=text], #optionalDetailsFieldset input[type=number]").prop("readonly", true);

            $("#optionalDetailsFieldset select").prop("disabled", true);
            $(".Dak_Date").prop("readonly", true).datepicker("disable");
            $("#optionalDetailsFieldset input").prop("readonly", true);
        }
    });
</script>



