                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(modelItem => item.Service_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    <label class="control-label">Address State</label>
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(modelItem => item.Service_AddressStateCode, new { htmlAttributes = new { @class = "form-control" } })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    <label class="control-label">Address District</label>
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayFor(modelItem => item.Service_AddressDistrictCode, new { htmlAttributes = new { @class = "form-control" } })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
