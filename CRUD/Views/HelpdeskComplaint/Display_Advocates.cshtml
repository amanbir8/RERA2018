<script>
    $(document).ready(function () {
        function updatebarregnumber() {
            var statecode = $("#StateCode").val();
            var barcode = $("#BarCode").val();
            var baryear = $("#BarYear").val();

            if (statecode || barcode || baryear) {
                $("#BarRegNumber").val(statecode + barcode + baryear);
            }
        }

        $("#StateCode, #BarCode, #BarYear").on("input", updatebarregnumber);

        var fullBarReg = $("#BarRegNumber").val();
        if (fullBarReg && fullBarReg.length > 4) {
            var year = fullBarReg.slice(-4);
            var prefix = fullBarReg.slice(0, -4);

            var state = prefix.match(/^[A-Za-z]+/);
            var code = prefix.replace(/^[A-Za-z]+/, "");

            $("#StateCode").val(state ? state[0] : "");
            $("#BarCode").val(code);
            $("#BarYear").val(year);
        }
    })
</script>
<script>
    $(document).ready(function () {
