<script>
    $(document).ready(function () {
        function validateBarRegNumber() {
            var state = $("#StateCode").val().trim();
            var code = $("#BarCode").val().trim();
            var year = $("#BarYear").val().trim();

            if (!state || !code || !year) {
                $("#BarRegNumber-error").text("Bar Registration Number is required");
                return false;
            } else {
                $("#BarRegNumber-error").text("");
                return true;
            }
        }

        $("form").submit(function (e) {
            if (!validateBarRegNumber()) {
                e.preventDefault();
                return false;
            }
        });

        $("#StateCode, #BarCode, #BarYear").on("keyup blur change", function () {
            validateBarRegNumber();
        });
    });
</script>



