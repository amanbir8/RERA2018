<script type="text/javascript">
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        $.ajax({
            type: "GET",
            url: baseUrl + "HelpdeskComplaint/GetState",
            dataType: "json",
            success: function (data) {
                $("#AdvocateState").empty().append('<option value="">Select State</option>');
                $.each(data, function (i, value) {
                    $("#AdvocateState").append(`<option value="${value.StateId}">${value.StateName}</option>`);

                });
                $("#AddressState").empty().append('<option value="">Select State</option>');
                $.each(data, function (i, value) {
                    $("#AddressState").append(`<option value="${value.StateId}">${value.StateName}</option>`);
                });
            }
        });

        $("#AddressState").change(function () {
            var stateid = $(this).val();
            $("#AddressDistrict").empty().append('<option value="">Select District</option>');

            if (stateid) {
                $.ajax({
                    type: "POST",
                    url: baseUrl + "HelpdeskComplaint/GetDistrictByStateId",
                    dataType: "json",
                    data: { stateId: stateid },
                    success: function (data) {
                        $.each(data, function (i, value) {
                            $('#AddressDistrict').append(`<option value="${value.DistrictId}">${value.DistrictName}</option>`)
                        });
                    }
                });
            }
        });
    });
</script>

<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
