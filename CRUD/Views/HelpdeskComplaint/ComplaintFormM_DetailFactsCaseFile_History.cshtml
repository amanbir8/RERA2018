@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthorityDesk_FormM_FactsCaseDocument

@{
    Layout = null;
}

<div id="wrapper">
    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.FactsCaseDoc_InfoName)</th>
                            <th>@Html.DisplayNameFor(model => model.FactsCaseDoc_IssueDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Doc_NumberOfPages)</th>
                            <th>@Html.DisplayNameFor(model => model.FactsCaseDoc_FileFormat)</th>
                            <th>@Html.DisplayNameFor(model => model.FactsCaseDoc_FileSize)</th>
                            <th>@Html.DisplayName("View")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.prpAuthFormM_FactsCase_Docs)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.FactsCaseDoc_InfoName)</td>
                                <td>@Html.DisplayFor(modelItem => item.FactsCaseDoc_IssueDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.Doc_NumberOfPages)</td>
                                <td>@Html.DisplayFor(modelItem => item.FactsCaseDoc_FileFormat)</td>
                                <td align="justify">@Html.DisplayFor(modelItem => item.FactsCaseDoc_FileSize)</td>
                                <td>
                                    @if (item.FactsCaseDoc_FileFormat == ".pdf")
                                    {
                                        <a href="~/@Html.DisplayFor(modelItem => item.FactsCaseDoc_FilePath)" target="_blank">
                                            <img src="~/images/pdf.png" alt="Print" height="20" width="20" />
                                        </a>
                                    }
                                    else
                                    {
                                        @Html.Display("File Not Found(s)")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div> 

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}
