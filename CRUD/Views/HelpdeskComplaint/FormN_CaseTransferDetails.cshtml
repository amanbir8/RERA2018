                                                                <td class="complaint-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.CaseTransferN_RegDiaryNumber_Name)">
                                                                    @Html.DisplayFor(modelItem => item.CaseTransferN_RegDiaryNumber_Name)
                                                                    @Html.HiddenFor(modelItem => item.ComplainantApplicant_RelatedComplaint_ID, new { @class = "hdnComplaintID" })
                                                                    @Html.HiddenFor(modelItem => item.CaseTransferN_ID, new { @class = "hdnHearingID" })
                                                                </td>
                                                                <td class="bench-name" data-bench-name="@Html.DisplayFor(modelItem => item.TransferTypeOption)">
                                                                    @if (item.TransferTypeOption == "TransferToAO")
                                                                    {
                                                                        @Html.DisplayName("Transfer To AO")
                                                                    }
                                                                    else if (item.TransferTypeOption == "TransferToAUTH")
                                                                    {
                                                                        @Html.DisplayName("Transfer To Authority")
                                                                    }
                                                                    else if (item.TransferTypeOption == "TransferToREGD")
                                                                    {
                                                                        @Html.DisplayName("Transfer To Registered Project")                                                                        
                                                                        @Html.DisplayName(" (")
                                                                        @Html.DisplayFor(modelItem => item.TransferOrderStatusRemark) 
                                                                        @Html.DisplayName(")")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("Transfer Case (Others)")
                                                                    }                                                                    
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.TransferDate)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.ComplainantApplicant_RelatedComplaint_Code)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Transfer_FromBenchName)
                                                                </td>
                                                                <td>                                                                        
                                                                    @Html.DisplayFor(modelItem => item.Transfer_ToBenchName)
                                                                </td>                                                                                                                                    
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                                </td>                                                                    
                                                                @*<td>
                                                                    @if (item.IsPublicView == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }                                                                   
                                                                </td>*@
                                                                <td>
                                                                    @if (Model.IsCaseTransferlockUnlockFlag == 1)
                                                                    {
                                                                        @Html.ActionLink("View", "Edit_FormN_CaseTransferDetails", new { FormNCaseTrIndexID = item.CaseTransferN_IndexID, FormNCaseTrID = item.CaseTransferN_ID, ComplaintFmNID = item.ComplainantApplicant_RelatedComplaint_ID })
                                                                    }
                                                                    else
                                                                    {
                                                                        if (item.IsDraft != 1)
                                                                        {
                                                                            @Html.ActionLink("Edit", "Edit_FormN_CaseTransferDetails", new { FormNCaseTrIndexID = item.CaseTransferN_IndexID, FormNCaseTrID = item.CaseTransferN_ID, ComplaintFmNID = item.ComplainantApplicant_RelatedComplaint_ID }) @("| ")
                                                                            @Html.ActionLink("Delete", "Delete_FormN_CaseTransferDetails", new { FormNCaseTrIndexID = item.CaseTransferN_IndexID, FormNCaseTrID = item.CaseTransferN_ID, ComplaintFmNID = item.ComplainantApplicant_RelatedComplaint_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.ActionLink("View", "Edit_FormN_CaseTransferDetails", new { FormNCaseTrIndexID = item.CaseTransferN_IndexID, FormNCaseTrID = item.CaseTransferN_ID, ComplaintFmNID = item.ComplainantApplicant_RelatedComplaint_ID })
                                                                        }
                                                                    }                                                                    
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>                         
                            <!-- /.col-lg-12 (nested) -->
                        </div>
                        <!-- /.row (nested) -->
                    </div>
