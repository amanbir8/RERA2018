                });

                html += '</div>';

                html += '<div style="margin-top:10px;">';

                html += '<button type="button" ';
                html += 'class="btn btn-primary btn-xs btnConfirmInlineAdvocate">';
                html += '<i class="fa fa-check"></i> Apply';
                html += '</button> ';

                html += '<button type="button" ';
                html += 'class="btn btn-default btn-xs btnCancelInlineAdvocate">';
                html += 'Cancel';
                html += '</button>';

                html += '</div>';

                html += '</div>';

                button.after(html);
            }
        );

    /* =========================================================
   CONFIRM APPLY
   ========================================================= */

    $(document)
        .off(
            'click.ecourtConfirmInlineAdvocate',
            '.btnConfirmInlineAdvocate'
        )
        .on(
            'click.ecourtConfirmInlineAdvocate',
            '.btnConfirmInlineAdvocate',
            function (e) {

                e.preventDefault();

                var panel = $(this).closest(
                    '.applyAdvocateInlinePanel'
                );

                // Find the button that opened this panel
                var applyButton = panel.prev(
                    '.btnApplyAdvocateComplainant, .btnApplyAdvocateRespondant'
                );

                var sourceRow = applyButton.closest('tr');

                var advocate = sourceRow
                    .find('textarea[name$=".CRAS_AdvocateName"]')
                    .val();

                if (!advocate || $.trim(advocate) === '') {

                    alert('Advocate Name is empty.');

                    return;
                }

                var selected =
                    panel.find(
                        '.chkInlineAdvocateRow:checked'
                    );

                if (selected.length === 0) {

                    alert('Please select at least one row.');

                    return;
                }

                selected.each(function () {

                    var rowId =
                        $(this).attr('data-row-id');

                    var targetRow =
                        $('tr[data-advocate-row-id="' +
                            rowId +
                            '"]');

                    targetRow
                        .find(
                            'textarea[name$=".CRAS_AdvocateName"]'
                        )
                        .val(advocate);
                });

                panel.remove();
            }
        );

    /* =========================================================
   CANCEL APPLY
   ========================================================= */

    $(document)
        .off(
            'click.ecourtCancelInlineAdvocate',
            '.btnCancelInlineAdvocate'
        )
        .on(
            'click.ecourtCancelInlineAdvocate',
            '.btnCancelInlineAdvocate',
            function (e) {

                e.preventDefault();

                $(this)
                    .closest('.applyAdvocateInlinePanel')
                    .remove();
            }
        );
</script>

