            var PreHearingDate_IndexID = $.trim(parentRow.find('.hdnPreHearingDateIndexID').val());
            var PreHearingDate_ID = $.trim(parentRow.find('.hdnHearingID').val());
            var ComplaintID = $.trim(parentRow.find('.hdnComplaintID').val());
            var ComplaintCode = $.trim(parentRow.find('.hdnComplaintCode').val());
            var ComplaintTypeMN = $.trim(parentRow.find('.hdnComplaintTypeMN').val());

            var FormM_Id = $.trim($(parentRow).find('input.hdnComplaintID').val());
            //var HearingFormM_Id = $.trim($(parentRow).find('input.hdnHearingID').val());
            FormM_Id = parseInt(FormM_Id);
            //HearingFormM_Id = parseInt(HearingFormM_Id);
            $.ajax({
                url: baseUrl + 'HelpdeskComplaint/FormMECourtRoomDetails',
                dataType: 'HTML',
                type: 'GET',
                data: {
                    'FormM_Id': FormM_Id,
                    'PreHearingDate_IndexID': PreHearingDate_IndexID,
                    'PreHearingDate_ID': PreHearingDate_ID,
                    'ComplainantApplicant_RelatedComplaint_ID': ComplaintID,
