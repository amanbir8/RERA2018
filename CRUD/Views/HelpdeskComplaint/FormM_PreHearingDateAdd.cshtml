<script>
    /* =========================================================
       APPLY ADVOCATE - COMPLAINANT
       ========================================================= */

    $(document)
        .off(
            'click.ecourtApplyComplainantAdvocate',
            '.btnApplyAdvocateComplainant'
        )
        .on(
            'click.ecourtApplyComplainantAdvocate',
            '.btnApplyAdvocateComplainant',
            function (e) {

                e.preventDefault();

                var button = $(this);
                var row = button.closest('tr');

                var advocate = row
                    .find('textarea[name$=".CRAS_AdvocateName"]')
                    .val();

                if (!advocate || $.trim(advocate) === '') {

                    alert('Please enter Advocate Name first.');

                    return;
                }

                // Remove any existing panel
                $('.applyAdvocateInlinePanel').remove();

                var html = '';

                html += '<div class="applyAdvocateInlinePanel" ';
                html += 'style="margin-top:8px; padding:10px; ';
                html += 'border:1px solid #ddd; ';
                html += 'background:#f9f9f9;">';

                html += '<strong>Select rows to apply this advocate:</strong>';

                html += '<div style="max-height:180px; overflow-y:auto; margin-top:8px;">';

                $('#tbodyComplainants tr').each(function () {

                    var targetRow = $(this);

                    // Do not show the row from which Apply was clicked
                    if (targetRow[0] === row[0]) {
                        return;
                    }

                    var rowNumber = targetRow.index() + 1;

                    var name = targetRow
                        .find('input[name$=".CRAS_Name"]')
                        .val();

                    if (!name) {
                        name = 'Complainant';
                    }

                    var rowId = 'complainant_' + Date.now() + '_' + rowNumber;

                    targetRow.attr(
                        'data-advocate-row-id',
                        rowId
                    );

                    html += '<div class="checkbox" style="margin-top:5px;">';

                    html += '<label>';

                    html += '<input type="checkbox" ';
                    html += 'class="chkInlineAdvocateRow" ';
                    html += 'data-row-id="' + rowId + '" /> ';

                    html += '<strong>Row ' +
                        rowNumber +
                        '</strong> - ';

                    html += $('<div>')
                        .text(name)
                        .html();

                    html += '</label>';

                    html += '</div>';
                });

                html += '</div>';

                html += '<div style="margin-top:10px;">';

                html += '<button type="button" ';
                html += 'class="btn btn-primary btn-xs btnConfirmInlineAdvocate">';
                html += '<i class="fa fa-check"></i> Apply';
                html += '</button> ';

                html += '<button type="button" ';
                html += 'class="btn btn-default btn-xs btnCancelInlineAdvocate">';
                html += 'Cancel';
                html += '</button>';

                html += '</div>';

                html += '</div>';

                button.after(html);
            }
        );

