    /* =========================================================
       SAVE COMPLAINANTS
       ========================================================= */

    $(document)
        .off('click.ecourtSaveComplainants', '#btnSaveComplainants')
        .on('click.ecourtSaveComplainants', '#btnSaveComplainants', function (e) {

            e.preventDefault();
            var form = $('#frmECourtRoomComplainants');
            var baseUrl = $('body').attr('data-base-url');
            var button = $(this);
            updateComplainantOrder();
            button.prop('disabled', true);
            button.html('<i class="fa fa-spinner fa-spin"></i> Saving...');
            $.ajax({
                url: baseUrl + 'HelpdeskComplaint/SaveECourtRoom',
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        alert('Complainants saved successfully.');
                        // Set CourtRoom_ID returned from server
                        form.find('input[name="CourtRoom_ID"]').val(response.CourtRoom_ID);
                        form.find('input[name="IsUpdate"]').val('true');
                        button.prop('disabled', false);
                        button.removeClass('btn-success').addClass('btn-primary');
                        button.html('Update');
                    }
                    else {
                        alert(response.message || 'Unable to save complainants.');
                        button.prop('disabled', false);
                        button.html('Save');
                    }
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert('Error while saving complainants.');
                    button.prop('disabled', false);
                    button.html('Save');
                }
            });

        });


    /* =========================================================
       SAVE RESPONDANTS
       ========================================================= */

    $(document)
        .off('click.ecourtSaveRespondants', '#btnSaveRespondants')
        .on('click.ecourtSaveRespondants', '#btnSaveRespondants', function (e) {
