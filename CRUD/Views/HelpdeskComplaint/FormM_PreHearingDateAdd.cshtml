<script type="text/javascript">

    /* =========================================================
       COMPLAINANT
       ========================================================= */
    function updateComplainantOrder() {

        $('#tbodyComplainants tr').each(function (index) {

            // Visible S.No.
            $(this).find('.complainantSerialNo').text(index + 1);

            // ONLY Applied Sequence changes
            $(this)
                .find('.hdnComplainantAppliedSeqOrder')
                .val(index + 1);

        });
    }


    function reIndexComplainants() {

        $('#tbodyComplainants tr').each(function (index) {

            $(this).find('input, textarea, select').each(function () {

                var name = $(this).attr('name');

                if (name) {

                    name = name.replace(
                        /Complainants\[\d+\]/g,
                        'Complainants[' + index + ']'
                    );

                    $(this).attr('name', name);
                }

            });

        });

        updateComplainantOrder();
    }


    /* =========================================================
       RESPONDANT
       ========================================================= */
    function updateRespondantOrder() {

        $('#tbodyRespondants tr').each(function (index) {

            $(this).find('.respondantSerialNo').text(index + 1);

            $(this)
                .find('.hdnRespondantAppliedSeqOrder')
                .val(index + 1);

        });
    }


    function reIndexRespondants() {

        $('#tbodyRespondants tr').each(function (index) {

            $(this).find('input, textarea, select').each(function () {

                var name = $(this).attr('name');

                if (name) {

                    name = name.replace(
                        /Respondents\[\d+\]/g,
                        'Respondents[' + index + ']'
                    );

                    $(this).attr('name', name);
                }

            });

        });

        updateRespondantOrder();
    }


    /* =========================================================
       MOVE UP
       ========================================================= */

    $(document)
        .off('click.ecourtMoveUp', '.btnMoveUp')
        .on('click.ecourtMoveUp', '.btnMoveUp', function (e) {

            e.preventDefault();

            var row = $(this).closest('tr');
            var previousRow = row.prev('tr');

            if (previousRow.length === 0) {
                return;
            }

            row.insertBefore(previousRow);

            if (row.parent().is('#tbodyComplainants')) {

                reIndexComplainants();

            }
            else if (row.parent().is('#tbodyRespondants')) {

                reIndexRespondants();

            }

        });


    /* =========================================================
       MOVE DOWN
       ========================================================= */

    $(document)
        .off('click.ecourtMoveDown', '.btnMoveDown')
        .on('click.ecourtMoveDown', '.btnMoveDown', function (e) {

            e.preventDefault();

            var row = $(this).closest('tr');
            var nextRow = row.next('tr');

            if (nextRow.length === 0) {
                return;
            }

            row.insertAfter(nextRow);

            if (row.parent().is('#tbodyComplainants')) {

                reIndexComplainants();

            }
            else if (row.parent().is('#tbodyRespondants')) {

                reIndexRespondants();

            }

        });


