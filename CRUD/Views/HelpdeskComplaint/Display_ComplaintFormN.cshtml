    function lockUnclockfactscasefileHandler() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {
            var elem = $(this);
            var parmComplaintId = $.trim($(document).find('#ComplaintFormN_ID').val());
            var parmFactsCaseId = $.trim(elem.attr('data-factscase-code'));
            var parmProfileId = $.trim(elem.attr('data-factscase-profile'));
            var parmLockUnlock = $.trim(elem.attr('data-factscase-flag'));
            var clickedElementId = $.trim(elem.attr('id'));
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskComplaint/LockUnlockHandler_ComplaintFormN_FactsCaseFile',
                data: { 'parmComplaintId': parmComplaintId, 'parmFactsCaseId': parmFactsCaseId, 'parmProfileId': parmProfileId, 'parmLockUnlock': parmLockUnlock },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    clickedElementId = "#" + clickedElementId;
                    if (data.statusCode == 101) {
                        $(clickedElementId).find("span").removeClass("btn-warning").addClass("btn-primary");
                        $(clickedElementId).attr("title", "Unlock Details");
                        $(clickedElementId).find("i").removeClass("fa-unlock").addClass("fa-key");
                        $(clickedElementId).prop('disabled', true);
                        $(clickedElementId).find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $(clickedElementId).find("span").removeClass("btn-primary").addClass("btn-warning");
                        $(clickedElementId).attr("title", "Lock Details");
                        $(clickedElementId).find("i").removeClass("fa-key").addClass("fa-unlock");
                        $(clickedElementId).prop('disabled', true);
                        $(clickedElementId).find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

