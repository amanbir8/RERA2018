<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }
</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on("click", "a.lock-acc-details", lockUnclockHandler);

        //Lock-Unlock-Loader-Handler
        var parmLockUnlock = $.trim($(document).find('#IsDraft').val());
        if (parmLockUnlock == 1) { //L
            $("#btnLockAccDetails").prop('disabled', false);
            $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAccDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Unlock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlock == 5) { //UL
            $("#btnLockAccDetails").prop('disabled', false);
            $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAccDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Lock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlock == 6) { //PL
            $("#btnLockAccDetails").prop('disabled', true);
            $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Unlock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockAccDetails").prop('disabled', true);
            $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Lock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnclockHandler() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmComplaintId = $.trim($(document).find('#ComplaintFormN_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraft').val());
            var parmComplaintIndexID = $.trim($(document).find('#ComplaintFormN_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskComplaint/LockUnlockHandler_ComplaintFormNcontentDetails',
                data: { 'parmComplaintId': parmComplaintId, 'parmLockUnlock': parmLockUnlock, 'parmComplaintIndexID': parmComplaintIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockAccDetails").attr("title", "Unlock Details");
                        $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockAccDetails").prop('disabled', true);
                        $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockAccDetails").attr("title", "Lock Details");
                        $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockAccDetails").prop('disabled', true);
                        $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.display-factscase-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var complaintDetailsModal = $(document).find('#myModal');
            $(complaintDetailsModal).find('.modal-body').html('');
            var factscaseId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-code'));
            var profileId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-profile'));
            var complaintNId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-formcode'));
            factscaseId = parseInt(factscaseId);
            profileId = parseInt(profileId);
            complaintNId = parseInt(complaintNId);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/ComplaintFormN_DetailFactsCaseFile',
                dataType: 'HTML',
                type: 'GET',
                data: { 'factscaseID': factscaseId, 'profileID': profileId, 'complaintNID': complaintNId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(complaintDetailsModal).find('.modal-body').html(response);
                }
            });
            var complaintName = 'PDF file';//$.trim($(document).find('#zipProjectName').val());
            $(complaintDetailsModal).find('h4.modal-title').html('Facts of the Case - (' + complaintName + ')');
            $(complaintDetailsModal).modal('show');
        });

        $(document).on('click', 'a.display-factscase-history-details', function (e) {
            e.preventDefault();
            var elem = $(this);
            var complaintDetailsModal = $(document).find('#myModal');
            $(complaintDetailsModal).find('.modal-body').html('');
            var pComplaintId = $.trim($(document).find('#ComplaintFormN_ID').val());
            pComplaintId = parseInt(pComplaintId);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/ComplaintFormN_DetailFactsCaseFile_History',
                dataType: 'HTML',
                type: 'GET',
                data: { 'complaintNID': pComplaintId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(complaintDetailsModal).find('.modal-body').html(response);
                    $(complaintDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var complaintName = $.trim($(document).find('#zapRelated_RegDiaryNumber').val());
            $(complaintDetailsModal).find('h4.modal-title').html('"Facts of the Case" Document Trash History - (File: ' + complaintName + ')');
            $(complaintDetailsModal).modal('show');
        });

        $(document).on('click', 'a.download-factscase-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var factscaseId = $.trim($(document).find('.download-factscase-document').attr('data-factscase-code'));
            var filename = $.trim($(document).find('.download-factscase-document').attr('data-factscase-filename'));
            var filelink = $.trim($(document).find('.download-factscase-document').attr('data-factscase-file'));
            factscaseId = parseInt(factscaseId);
            $.ajax({
                type: "GET",
                url: BASE_URL + 'HelpdeskComplaint/Download_FactsCase_ConplaintFormN_File',
                cache: false,
                data: { 'factscaseID': factscaseId, 'filename': filename, 'filelink': filelink },
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    //Convert Base64 string to Byte Array.
                    var bytes = Base64ToBytes(data);
                    //Convert the Byte Data to BLOB object.
                    var blob = new Blob([bytes], { type: "application/octetstream" });

                    //Check the Browser type and download the File.
                    var isIE = false || !!document.documentMode;
                    //if (isIE) {
                        //    window.navigator.msSaveBlob(blob, fileName);
                    //} else {
                    //}
                    var url = window.URL || window.webkitURL;
                    var pdflink = url.createObjectURL(blob);
                    var downloadLink = $("<a></a>")
                        .attr("href", pdflink)
                        .attr("download", filename) //"file.pdf")
                        .css("display", "none");
                    $("body").append(downloadLink);
                    downloadLink[0].click();
                    downloadLink.remove();
                    url.revokeObjectURL(pdflink);
                }
            });
        });

        function Base64ToBytes(base64) {
            var s = window.atob(base64);
            var bytes = new Uint8Array(s.length);
            for (var i = 0; i < s.length; i++) {
                bytes[i] = s.charCodeAt(i);
            }
            return bytes;
        };
    });
</script>
<script>
