                @*<iframe src="@Url.Content("~/rwPDF/registeredprojectslist/List_of_Registered_Projects.pdf&embedded=true")" style="width:100%; height:600px;" frameborder="0"></iframe>*@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
