                                            <legend class="my">(4.) Facts of the case</legend>                                                    

                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Facts of Case [Give a concise statement of facts and grounds of claim against the promoter.]</label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        @Html.Raw("<div style='width:95%; text-align:justify;'>" + Model.FactsCase_Statement + "</div>")
                                                    </div>
                                                </div>
                                            </div>

                                            @if (Model.FactsCase_Documents != null)
                                            {
                                                if (Model.FactsCase_Documents.Count != 0)
                                                {
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                            </div>
                                                            <div class="col-md-9">
                                                                @{
                                                                    int snoFactsCaseDocs = 0;
                                                                    string btnLockfactscaseDetails = string.Empty;
                                                                }
                                                                <!-- PDF file (Cnt One or More) -->
                                                                @foreach (var item in Model.FactsCase_Documents)
                                                                {
                                                                    {
                                                                        snoFactsCaseDocs = snoFactsCaseDocs + 1;
                                                                        btnLockfactscaseDetails = "btnLockfactscaseDetails" + snoFactsCaseDocs.ToString();
                                                                    }
                                                                    <div class="panel-group">
                                                                        <div class="row">
                                                                            <!-- PDF file (Cnt One or More) -->
                                                                            <div class="col-lg-12">
                                                                                <div class="form-group">
                                                                                    <fieldset class="col-md-12">
                                                                                        <legend class="my">
                                                                                            @Html.DisplayName("(" + snoFactsCaseDocs.ToString() + ")") Facts of the Case
                                                                                            @Html.DisplayName("(")
                                                                                            @Html.DisplayFor(model => item.FactsCaseDoc_FileFormat, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            @Html.DisplayName(")")
                                                                                        </legend>
                                                                                        <div class="row">
                                                                                            <div class="form-group">
                                                                                                <div class="col-md-3">
                                                                                                    @Html.LabelFor(model => item.FactsCaseDoc_InfoName, htmlAttributes: new { @class = "control-label" })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.DisplayFor(model => item.FactsCaseDoc_InfoName, new { htmlAttributes = new { @class = "form-control" } })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.LabelFor(model => item.FactsCaseDoc_IssueDate, htmlAttributes: new { @class = "control-label" })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.DisplayFor(model => item.FactsCaseDoc_IssueDate, new { htmlAttributes = new { @class = "form-control" } })
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="row">
                                                                                            <div class="form-group">
                                                                                                <div class="col-md-3">
                                                                                                    @Html.LabelFor(model => item.Doc_NumberOfPages, htmlAttributes: new { @class = "control-label" })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.DisplayFor(model => item.Doc_NumberOfPages, new { htmlAttributes = new { @class = "form-control" } })
                                                                                                    @Html.DisplayName("page(s)")
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.LabelFor(model => item.FactsCaseDoc_FileFormat, htmlAttributes: new { @class = "control-label" })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.DisplayFor(model => item.FactsCaseDoc_FileFormat, new { htmlAttributes = new { @class = "form-control" } })
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="row">
                                                                                            <div class="form-group">
                                                                                                <div class="col-md-3">
                                                                                                    @Html.LabelFor(model => item.FactsCaseDoc_FileSize, htmlAttributes: new { @class = "control-label" })
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    @Html.DisplayFor(model => item.FactsCaseDoc_FileSize, new { htmlAttributes = new { @class = "form-control" } })
                                                                                                </div>
                                                                                                <div class="col-md-6">
                                                                                                    <div class="pull-right">
                                                                                                        <span class="btn-boxfile-factscase">
                                                                                                            <a class="a display-factscase-document" data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-profile="@Html.DisplayFor(model => item.Profile_ID)" data-factscase-formcode="@Html.DisplayFor(model => item.ComplainantApplicant_RelatedComplaintN_ID)" href="javascript:void(0);" title="View File"><span class="btn btn-primary btn-outline btn-xs"><i class="fa fa-file-pdf-o" aria-hidden="true"> </i></span></a>
                                                                                                            <a class="a download-factscase-document" data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-filename="@Html.DisplayFor(model => item.FactsCaseDoc_FileName)" data-factscase-file="@Html.DisplayFor(model => item.FactsCaseDoc_FilePath)" href="javascript:void(0);" title="Download"><span class="btn btn-primary btn-outline btn-xs"><i class="fa fa-download" aria-hidden="true"> </i></span></a>
                                                                                                            <a href="~/@Html.DisplayFor(model => item.FactsCaseDoc_FilePath)" title="New Browser Tab" target="_blank"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-external-link" aria-hidden="true"></i></span></a>
                                                                                                        </span>
                                                                                                        @if (item.IsDraft == 1)
                                                                                                        {   //L
                                                                                                            <a class="a lock-factscase-file-details" data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-profile="@Html.DisplayFor(model => item.Profile_ID)" data-factscase-flag="@Html.DisplayFor(model => item.IsDraft)" id=@btnLockfactscaseDetails href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                                                                        }
                                                                                                        else if (item.IsDraft == 5)
                                                                                                        {   //UL
                                                                                                            <a class="a lock-factscase-file-details" data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-profile="@Html.DisplayFor(model => item.Profile_ID)" data-factscase-flag="@Html.DisplayFor(model => item.IsDraft)" id=@btnLockfactscaseDetails href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                                                                        }
                                                                                                        else if (item.IsDraft == 6)
                                                                                                        {   //PL
                                                                                                            <a data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-profile="@Html.DisplayFor(model => item.Profile_ID)" data-factscase-flag="@Html.DisplayFor(model => item.IsDraft)" id=@btnLockfactscaseDetails href="javascript:void(0);" title="Unlock Details" disabled="disabled"><span class="btn btn-outline btn-primary btn-xs disabledlockunlock"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <a data-factscase-code="@Html.DisplayFor(model => item.FactsCaseDocument_ID)" data-factscase-profile="@Html.DisplayFor(model => item.Profile_ID)" data-factscase-flag="@Html.DisplayFor(model => item.IsDraft)" id=@btnLockfactscaseDetails href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs disabledlockunlock"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                                                                        }                                                                                                       
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </fieldset>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                <!-- /.col-lg-12 (nested) -->
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </fieldset>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">(5.) Compensation(s) Sought</legend>                                                  
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label" style="text-align:justify;">In view of the facts mentioned in paragraph 4 above, the applicant prays for the following compensation(s) <br/>[Specify the compensation(s) claimed explaining the grounds of claim(s) and the legal provisions(if any) relied upon.]</label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        @Html.Raw("<div style='width:95%; text-align:justify;'>" + Model.ReliefSought_Statement + "</div>")
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">(6.) Claim not pending by any other Court, etc. or has not been decided by any other Court, etc. (Declaration)</legend>

                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-offset-1 col-md-11">
                                                        @if (Model.IsAgreeDeclaration_ComplaintNotPendingCourtAuthority == "1")
                                                        {
                                                            @Html.DisplayName("[YES], ")
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("[NO], ")
                                                        }
                                                        I/we, the applicant(s), further declare that the matter regarding which this complaint has been made is not pending before any court of law or any other authority or any other tribunal(s) and has not been decided by any court of law or any other authority or any other tribunal(s).
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>                                


                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

