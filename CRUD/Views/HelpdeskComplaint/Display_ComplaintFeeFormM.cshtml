@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthorityDesk_FormM_Fee

<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<style>
    #customTopBtn {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 20px; /* Place the button at the bottom of the page */
        right: 30px; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #064576; /* Set a background color */
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>


<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Complaint (Form-M) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Form-M (Complaint under section 31 of the Act) Complaint Fee Details
                </div>
                <div class="panel-body">                    
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Complaint Form-M - ( @Html.DisplayFor(model => model.zapRelated_RegDiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zapComplainantName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5 project-name">
                                                        @Html.DisplayFor(model => model.zapComplainantName, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapComplaintFormLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zapComplaintFormLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskComplaintNavMenuPartial")                            
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;"><a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>Complaint Fee (Form-M) Details</h4>
                                </div>
                            </div>    
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">(9.) Particulars of Online Payment (in rupees) in respect of the fee in terms of sub-rule (1) of rule 36</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Fee Amount (INR)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Amount, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Amount, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Additional Charges (INR)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Additional_Charges, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Additional_Charges, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label">Transaction Fee (INR)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Transaction_Fee, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Transaction_Fee, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>                                                
                                        </fieldset>
                                    </div>
                                </div>
                            </div>                                

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Online Payment Status Info (in respect of the fee) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Online Payment Related To</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Product_Info, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Product_Info, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label">Status Info</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Status, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Status, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">PayU ID</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_PayU_ID, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_PayU_ID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label">Payment Reference Number</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_UDF_1, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_UDF_1, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Transaction Number</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Transaction_ID, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Transaction_ID, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label">Transaction Date</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Date, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Date, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>                                                
                                            <div class="row">
                                                <div class="form-group">                                                        
                                                    <div class="col-md-3">
                                                        <label class="control-label">Bank Reference Number</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Bank_Reference_No, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Bank_Reference_No, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label">Payment Type</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Payment_Type, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Payment_Type, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        <label class="control-label">Payment Mode</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.DisplayFor(model => model.PG_Payment_Gateway, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.ValidationMessageFor(model => model.PG_Payment_Gateway, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div> 
                        </div>
                        <!-- /.panel-body -->
                    </div>
                    <!-- /.panel -->
                </div>
                <!-- /.col-lg-12 -->
            </div>
            <!-- /.row -->
        </div>
    </div>
    <!-- /.wrapper -->
</div>

<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
}