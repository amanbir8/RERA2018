                                                                        <i class="fa fa-ban" style="color:#064576;" aria-hidden="true" title="Delete locked"></i>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa fa-ban" style="color:#064576;" aria-hidden="true" title="Delete Locked"></i>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
