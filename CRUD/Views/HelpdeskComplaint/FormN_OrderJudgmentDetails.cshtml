<script>
    $(document).ready(function () {
        var popBASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerOrderDetailButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var OrderDetailsModal = $(document).find('#myModal');
            $(OrderDetailsModal).find('.modal-body').html('');

            // ajax to fetch data corresponding to complaint-Id
            var formNumber = $.trim($(parentRow).find('input.hdnFormNumber').val());
            var formId = $.trim($(parentRow).find('input.hdnFormID').val());
            var formType = $.trim($(parentRow).find('input.hdnFormType').val());
            var transferId = $.trim($(parentRow).find('input.hdnTransferCode').val());
            var transferType = $.trim($(parentRow).find('input.hdnTransferType').val());
            formId = parseInt(formId);
            transferId = parseInt(transferId);
            $.ajax({
                url: popBASE_URL + 'HelpdeskComplaint/FormN_OrderJudgmentsForShowDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'frmNumber': formNumber, 'frmId': formId, 'frmType': formType, 'frmtransferId': transferId, 'frmtransferType': transferType },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(OrderDetailsModal).find('.modal-body').html(response);
                    $(OrderDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.complaint-diary-number').attr('data-diary-no'));
            var complainantNam = $.trim($(parentRow).find('td.complainant-name').attr('data-complainant-name'));
            $(OrderDetailsModal).find('h4.modal-title').html('Order & Judgement Details - <a href="javascript:void(0);"></a>');
            $(OrderDetailsModal).find('.modal-title a').html(diaryNo + ' (' + complainantNam + ')');
            $(OrderDetailsModal).modal('show');
        });
    });
</script>

