<script>
    function singleFileSelected() {
        var baseUrl = $('body').attr('data-base-url');
        $(".InfoContainer").fadeIn();
        var selectedFile = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];
        if (selectedFile) {
            var FileSize = 0;
            var imageType = /image.*/;
            if (selectedFile.size > 1048576) {
                FileSize = Math.round(selectedFile.size * 100 / 1048576) / 100 + " MB";
            }
            else if (selectedFile.size > 1024) {
                FileSize = Math.round(selectedFile.size * 100 / 1024) / 100 + " KB";
            }
            else {
                FileSize = selectedFile.size + " Bytes";
            }

            // here we will add the code of thumbnail preview of upload images
            $("#showFileInfoGrid").show();
            $("#FileName").text("Name : " + selectedFile.name);
            $("#FileType").text("Type : " + selectedFile.type);
            $("#FileSize").text("Size : " + FileSize);

            $("#showSaveFileUploadMessage").hide();

            if (selectedFile.type.match(imageType)) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = reader.result;
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "100";
                    img.width = "100";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(100);
                    $("#Imagecontainer").width(100);
                };
                reader.readAsDataURL(selectedFile);
            }
            if (selectedFile.type.match('application/pdf')) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = baseUrl + 'images/pdf.png';
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "35";
                    img.width = "35";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(35);
                    $("#Imagecontainer").width(35);
                };
                reader.readAsDataURL(selectedFile);
            }
        }
    }
</script>
<script type="text/javascript">
    $(function () {
        $("#FormUpload").submit(function (event) {
            var form = $('#FormUpload')[0];
            var baseUrl = $('body').attr('data-base-url');
            var files = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];

            if (typeof files === 'undefined') {
                $("#showSaveFileUploadMessage").show();
                $("#saveFileUploadMessageName").text("Note : Please Add files... to Upload!");
                return false;
            }
            if (files.size > 0) {
                var formData = new FormData(form);
                for (var i = 0; i < files.length; i++) {
                    formData.append(files[i].name, files[i]);
                }
                var progressbarLabel = $('body').find('#progressBar-label');
                var progressbarDiv = $('body').find('#progressbar');

                $.ajax({
                    url: baseUrl + 'HelpdeskComplaint/FormN_OrderJudgmentDocumentUpload',
                    method: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.statusCode == 101)
                        {
                            progressbarLabel.text('COMPLETE');
                            progressbarDiv.fadeOut(2000);
                            $(".InfoContainer").fadeOut(2000);
                            $("#showFileInfo").fadeOut(2500);

                            // Load Uploaded List - Highlight Pending Docs
                            highlightPendingDocs();
                        }
                        else
                        {
                            progressbarLabel.text('Bad Request! Upload Failed');
                            progressbarDiv.fadeOut(2000);

                            $("#showSaveFileUploadMessage").show();
                            $("#saveFileUploadMessageName").text("Note : " + data.status);
                        }
                    },
                    failure: function(data) {
                        alert('Bad Request! Upload Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Upload Failed');
                    }
                });

                progressbarLabel.text('UPLOADING ...');
                progressbarDiv.progressbar({
                    value: false
                }).fadeIn(500);

                $("#showSaveFileUploadMessage").hide();
            }
            return false;
        });
    });
</script>
<script>
    $(document).ready(function () {
        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');
            switch (criteriaCode) {
                case '#accordionformnOrderJudgementdetails':
                    $("#btnAccordionformnOrderJudgements").find("span").toggleClass("btn-outline");
                    $("#btnAccordionformnOrderJudgements").find("i").toggleClass("fa-upload fa-times");
                    $("#btnAccordionformnOrderJudgements").attr("title", function (index, attr) {
                        return attr == 'Cancel Uploads' ? 'Upload Order & Judgements' : 'Cancel Uploads';
                    });
                    break;
            }
        });

        $('#oeCourt_CaseType_Name').change(function () {
            if (this.value == '5001') {
                $("#rowCaseTypeDesc01").addClass('hide').removeClass('show');
            }
            else {
                $("#rowCaseTypeDesc01").addClass('show').removeClass('hide');
            };
        });

        $('#oOrderDocument_InfoName').change(function () {
            if (this.value == '1003') {
                $("#rowOrderRef01").addClass('show').removeClass('hide');
            }
            else {
                $("#rowOrderRef01").addClass('hide').removeClass('show');
            };
            if (this.value == '1004') {
                $("#rowOrderTrueCopy01").addClass('show').removeClass('hide');
            }
            else {
                $("#rowOrderTrueCopy01").addClass('hide').removeClass('show');
            };
        });
    });
</script>
