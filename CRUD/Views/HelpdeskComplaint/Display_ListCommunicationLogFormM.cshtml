@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthDesk_FormM_LogCommunication

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<link href="@Url.Content("~/css/jquery-ui-fileupload.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<script>
$(function() {    
    $('table#promoter-documents-list-table').dataTable({
        'aoColumnDefs': [{
            'bSortable': false,
            'aTargets': [6, 7]
        }],
        "language": {
            "info": "Showing _START_ to _END_ of _TOTAL_ records",
            "lengthMenu": "Show _MENU_ records"
        },
        "pagingType": "full_numbers",

         responsive: true
    });
});
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<style>
    #customTopBtn {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 20px; /* Place the button at the bottom of the page */
        right: 30px; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #064576; /* Set a background color */
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>

<script>
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();       

    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Complaint (Form-M) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Details of Communication/ Log History (Form-M)
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Complaint Form-M - ( @Html.DisplayFor(model => model.zapRelated_RegDiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zapComplainantName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5 project-name">
                                                        @Html.DisplayFor(model => model.zapComplainantName, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapComplaintFormLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zapComplaintFormLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskComplaintNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;"><a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>Communication /Log History (Form-M) Details</h4>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.Raw("Sr.No")
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.CommunicationTitleName)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.SignInDate)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.CommunicationActivity)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DestinationEmailAddress)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.RERAnumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.ComplaintAganistName)
                                            </th> 
                                            <th>
                                                @Html.DisplayNameFor(model => model.UserName)
                                            </th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int stnumber = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                stnumber = stnumber + 1;
                                            }
                                            <tr>
                                                <td>
                                                    @Html.DisplayName(stnumber.ToString())
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.CommunicationTitleName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.SignInDate)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.CommunicationActivity)                                                   
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DestinationEmailAddress)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.RERAnumber)
                                                </td> 
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintAganistName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.UserName)
                                                </td>                                              
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>    
}