@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthDesk_FormExe_DiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormExe_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            FormExe_Id = parseInt(FormExe_Id);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormExeInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormExe_Id': FormExe_Id },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a#modalOpenerSimilarComplaintsButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormExe_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            var FormExe_RERAregistration = $.trim($(parentRow).find('input.hdnRelatedRERA').val());
            FormExe_Id = parseInt(FormExe_Id);
            $.ajax({
                url: BASE_URL + 'HelpdeskComplaint/FormExeInfoContentDetailsByRERAregistration',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormExe_Id': FormExe_Id, 'FormExe_RERAregistration': FormExe_RERAregistration },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var relatedreraName = $.trim($(parentRow).find('td.relatedrera-name').attr('data-relatedrera-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Grouping of All Complaints By - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(relatedreraName + ' (Ref. ' + diaryNo + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a#modalOpenerReminderAlertsButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var complaintformModal = $(document).find('#myModal');
            $(complaintformModal).find('.modal-body').html('');
            var FormExe_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            var FormExe_code = 0;
            var formExediaryNumber = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            FormExe_Id = parseInt(FormExe_Id);
            $.ajax({
                url: BASE_URL + 'MIScomplaintToExcel/FormExecomplaintReminderEmailsSchedulerContentDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormExeId': FormExe_Id, 'FormExecode': FormM_code, 'ComplaintDNumber': formExediaryNumber },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(complaintformModal).find('.modal-body').html(response);
                    $(complaintformModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNumber = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var complainantName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(complaintformModal).find('h4.modal-title').html('Reminder/Notification(s) - <a href="javascript:void(0);"></a>');
            $(complaintformModal).find('.modal-title a').html(diaryNumber + ' (' + complainantName + ')');
            $(complaintformModal).modal('show');
        });
    });

    $(document).ready(function () {
        $('[data-toggle="popover"]').popover({
            title: false,
            content: setData,
            html: true,
            placement: 'right'
        });

        function setData(id) {
            var set_data = '';
            var element = $(this);
            var parentRow = $(element).parents('tr');

            var popRelatedType = $.trim($(parentRow).find('input.hdnRelatedType').val());
            var popRelatedName = $.trim($(parentRow).find('input.hdnRelatedName').val());
            var popRelatedRERA = $.trim($(parentRow).find('input.hdnRelatedRERA').val());

            set_data = '<div class="row" style="line-height:23px; margin-top:10px;">' +
                '<div class="col-lg-12">' +
                '<div><span style="font-weight:bold;">RERA No:</span>  ' + popRelatedRERA + '</div>' +
                '<div><span style="font-weight:bold;">Complaint Against:</span>  ' + popRelatedType + '</div>' +
                '<div><span style="font-weight:bold;">Project/Agent:</span>  ' + popRelatedName + '</div>' +
                '</div>' +
                '</div>';
            return set_data;
        }
    });
</script>
