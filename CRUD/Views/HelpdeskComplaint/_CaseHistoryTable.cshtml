@model CRUD.Models.HelpDeskComplaint.Cls_Prp_FormM_CaseAssignment

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>SNo</th>
                <th>@Html.DisplayNameFor(m => m.HardcopySetNumber)</th>
                <th>@Html.DisplayNameFor(m => m.NumberOfComplainant)</th>
                <th>@Html.DisplayNameFor(m => m.NumberOfRespondent)</th>
                <th>@Html.DisplayNameFor(m => m.AssignementBench_Name)</th>
                <th>@Html.DisplayNameFor(m => m.InstitutionFormM_Code)</th>
                <th>Remarks</th>
                <th>Date of Upload</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sr = 0;
            }
            @foreach (var item in Model.prpongoing)
            {
                sr++;
                <tr>
                    <td>@sr</td>
                    <td>@item.HardcopySetNumber</td>
                    <td>@item.NumberOfComplainant</td>
                    <td>@item.NumberOfRespondent</td>
                    <td>@item.AssignementBench_Name</td>
                    <td>@item.InstitutionFormM_Code</td>
                    <td>@item.Remarks_IfAny</td>
                    <td>@item.CreatedOn</td>
                </tr>
            }
        </tbody>
    </table>
</div>
