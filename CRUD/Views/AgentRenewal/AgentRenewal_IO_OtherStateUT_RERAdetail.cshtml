<script>
    $(document).ready(function () {
        var displayBASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalRegistrationStatusOpenerButton', function (e) {
            e.preventDefault();
            var RenewalAgentDetailsModal = $(document).find('#myModal');
            $(RenewalAgentDetailsModal).find('.modal-body').html('');
            var qagentid = $('#RefAgentID').val();
            var ptypeagent = $('#RefAgentType').val();
            var prenewalagentid = $('#RefRenewalAgentID').val();
            var prenewalagentseq = $('#RefRenewalOrderSequence').val();
            var prenewalagentyr = $('#RefRenewalAgentYear').val();
            var pkeyflag = 214;
            qagentid = parseInt(qagentid);
            ptypeagent = parseInt(ptypeagent);
            prenewalagentid = parseInt(prenewalagentid);
            prenewalagentseq = parseInt(prenewalagentseq);
            prenewalagentyr = parseInt(prenewalagentyr);
            pkeyflag = parseInt(pkeyflag);
            var pkeysubflag = 'OtherRera';

            $.ajax({
                url: displayBASE_URL + 'AgentRenewal/AgentRenewal_ListPreviousRegistration',
                dataType: 'HTML',
                type: 'GET',
                data: { 'qagentid': qagentid, 'ptypeagent': ptypeagent, 'prenewalagentid': prenewalagentid, 'prenewalagentseq': prenewalagentseq, 'prenewalagentyr': prenewalagentyr, 'pkeyflag': pkeyflag, 'pkeysubflag': pkeysubflag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(RenewalAgentDetailsModal).find('.modal-body').html(response);
                    $(RenewalAgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = 'Real Estate Agent (No record founds)';
            if ($('#RefRegistrationNumber').val() != '') {
                var diaryNo = $('#RefRegistrationNumber').val();
            };
            //var realestateagentName = $('#ProjectName').val();
            $(RenewalAgentDetailsModal).find('h4.modal-title').html('Registration Details - <a href="javascript:void(0);"></a>');
            //$(RenewalAgentDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + realestateagentName + ')');
            $(RenewalAgentDetailsModal).find('h4.modal-title a').html(diaryNo);
            $(RenewalAgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Renewal of Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Agent Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Organization Member Details (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Upload Document(s).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Other State/UT Registration Number Detail (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-V: Application Fee.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-VI: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Renewal of Registration : RERA Registration Details with Other State/UT(s)</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Renewal of Registration (Form-J) : Registration Details of Real-estate Agent with Other State/UT(s)
                    <span class="pull-right">
                        <a id="modalRegistrationStatusOpenerButton" href="javascript:void(0);" title="View Registration Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-list-ul" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
