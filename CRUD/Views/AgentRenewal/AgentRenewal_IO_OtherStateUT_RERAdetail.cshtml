                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                @Html.HiddenFor(model => model.RERAnumberRegistration, htmlAttributes: new { @class = "control-label", @id = "RefRegistrationNumber" })
                                @Html.HiddenFor(model => model.Agent_ID, htmlAttributes: new { @class = "control-label", @id = "RefAgentID" })
                                @Html.HiddenFor(model => model.Agent_Type, htmlAttributes: new { @class = "control-label", @id = "RefAgentType" })
                                @Html.HiddenFor(model => model.Related_RenewalAgent_ID, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentID" })
                                @Html.HiddenFor(model => model.Related_RenewalAgent_Year, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentYear" })
                                @Html.HiddenFor(model => model.Renewal_OrderSequence, htmlAttributes: new { @class = "control-label", @id = "RefRenewalOrderSequence" })
                                @Html.HiddenFor(model => model.IsPublicView, htmlAttributes: new { @class = "control-label", @id = "RefPublicView" })

                                if (Model.AgentStepRenewal != null)
                                {
                                    if (Model.AgentStepRenewal.Count != 0)
                                    {
                                        foreach (var item in Model.AgentStepRenewal)
                                        {
                                            if (item.Is_YesNo_ValidforAgentRenewal_Flag == 21)
                                            {
                                                if (item.Is_YesNo_RenewalAgent_OtherStateUTnumber == 1)
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            <div class="form-group">
                                                                <fieldset class="col-md-12">
                                                                    <legend class="my">Renewal of registration (Form-J) Status</legend>
                                                                    <div class="row">
                                                                        <div class="form-group">
                                                                            <div class="col-md-2">
                                                                                @Html.Label("Registration Status", htmlAttributes: new { @class = "control-label" })
                                                                            </div>
                                                                            <div class="col-md-9 alert alert-success">
                                                                                <i>"Eligible"</i> for renewal of registration with reference to the information provided directly by the sign-in user or the Agent, and also as per the <i>'Registered Real-Estate Agent'</i> and <i>'Agent's Profile'</i> details.
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </fieldset>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-12">
                                                                <div class="btn-toolbar">
                                                                    @Html.ActionLink("Cancel", "AgentRenewal_RegistrationOptionView", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            <div class="form-group">
                                                                <fieldset class="col-md-12">
                                                                    <legend class="my">Not Applicable</legend>
                                                                    <div class="row">
                                                                        <div class="form-group">
                                                                            <div class="col-md-2">
                                                                                @Html.Label("Registration Status", htmlAttributes: new { @class = "control-label" })
                                                                            </div>
                                                                            <div class="col-md-9 alert alert-warning">
                                                                                @Html.DisplayFor(model => model.B_column, new { htmlAttributes = new { @class = "form-control" } })
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </fieldset>
                                                            </div>
                                                        </div>
                                                    </div>                                                    
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-12">
                                                                <div class="btn-toolbar">
                                                                    @Html.ActionLink("Cancel", "AgentRenewal_RegistrationOptionView", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            if (item.Is_YesNo_ValidforAgentRenewal_Flag == 0)
                                            {
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <div class="form-group">
                                                            <fieldset class="col-md-12">
                                                                <legend class="my">Not Applicable</legend>
                                                                <div class="row">
                                                                    <div class="form-group">
                                                                        <div class="col-md-2">
                                                                            @Html.Label("Registration Status", htmlAttributes: new { @class = "control-label" })
                                                                        </div>
                                                                        <div class="col-md-9 alert alert-danger">
                                                                            @Html.DisplayFor(model => model.B_column, new { htmlAttributes = new { @class = "form-control" } })                                                                            
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </fieldset>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row hide">
                                                    <div class="col-lg-12">
                                                        <div class="form-group">
                                                            <fieldset class="col-md-12">
                                                                <legend class="my">Note</legend>
                                                                <div class="row">
                                                                    <div class="form-group">
                                                                        <div class="help-block col-md-12 justify">
                                                                            The real-estate agent was registered before the online system of the Authority became functional. Further, in case of online system for renewal of registration, the information of <i>'Agent's Profile'</i> has been uploaded directly by the Agent, and is yet to be verified by the Authority.Till such verification, the information supplied to the Authority at the time of manual registration shall be the authentic record.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </fieldset>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            <div class="btn-toolbar">
                                                                @Html.ActionLink("Cancel", "AgentRenewal_RegistrationOptionView", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Not Applicable</legend>
                                                        <div class="row">
