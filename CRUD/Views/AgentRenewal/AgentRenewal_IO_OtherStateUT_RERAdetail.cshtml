                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    <div class="btn-toolbar">
                                                        @Html.ActionLink("Cancel", "AgentRenewal_RegistrationOptionView", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Not Applicable</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-2">
                                                                @Html.Label("Other Registrations Status", htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-9 alert alert-warning">
                                                                "No Records Found (Registration details of agent with other state/UT(s))", for renewal of registration with reference to the information provided directly by the sign-in user or the Agent, and also as per the <i>'Registered Real-Estate Agent'</i> and <i>'Agent's Profile'</i> details.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="btn-toolbar">
                                                    @Html.ActionLink("Cancel", "AgentRenewal_RegistrationOptionView", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
