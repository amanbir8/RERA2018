                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.OfficeComm_AddressDistrictCode, new SelectList(" "), "Select District", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.OfficeComm_AddressDistrictCode, "", new { @class = "text-danger" })
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OfficeComm_AddressPIN, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.OfficeComm_AddressPIN, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.OfficeComm_AddressPIN, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                              
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Upload Photograph</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("Upload Photograph", htmlAttributes: new { @class = "control-label mand" })
                                                            <span class="fa-help">
                                                                <a class="a info-help-uploadimage" href="javascript:void(0);" title="Help"><span><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                                                            </span>
                                                        </div>                                                        
                                                        <div class="col-md-3">
                                                            <div class="input-group">
                                                                <label class="input-group-btn">
                                                                    <span class="btn btn-primary">
                                                                        Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                    </span>
                                                                </label>
                                                                <input type="text" id="Photo_AddressShow" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.HiddenFor(model => model.Image_FileName)
                                                            @Html.HiddenFor(model => model.Image_FilePath, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>                                                       
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.Image_FilePath)@Html.DisplayFor(model => model.Image_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.Image_FilePath)@Html.DisplayFor(model => model.Image_FileName)" alt="No Image" />
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            @TempData["notice"]<br />Photo Should be in .jpg format and less than 512KB
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                              
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.IsLock == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else if(Model.IsLock == 0)
                                            {
                                                if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" onclick="return loginuser_verifyPhoto();" />
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "AgentRenewal_OTIProfile_OrgMemberDetail", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }


                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="renewalregistration-agent-member-list">
                                    <thead>
                                        <tr>                                            
                                            <th>
                                                @Html.DisplayName("OtherMember_Name")
                                            </th>
                                            <th>
                                                @Html.DisplayName("Designation")
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.OtherMember_PAN_Number)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.EmailAddress)
                                            </th>                                            
                                            <th>
                                                @Html.DisplayNameFor(model => model.MobileNumber)
                                            </th>                                          
                                            <th>@Html.DisplayName("Edit| Delete")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.AgentRenewal_OtherMember)
                                        {
                                            <tr>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.OtherMember_Name)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Designation)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.OtherMember_PAN_Number)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.EmailAddress)
                                                </td>                                               
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.MobileNumber)
                                                </td>                                               
                                                <td>
                                                    @if (item.IsLock == 1)
                                                    {
                                                        @Html.ActionLink("View", "AgentRenewal_EditOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                    }
                                                    else if (item.IsLock == 0)
                                                    {
                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            @Html.ActionLink("View", "AgentRenewal_EditOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                        }
                                                        else
                                                        {
                                                            if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                            {
                                                                @Html.ActionLink("View", "AgentRenewal_EditOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                            }
                                                            else
                                                            {
                                                                @Html.ActionLink("Edit", "AgentRenewal_EditOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID }) @(" | ")
                                                                @Html.ActionLink("Delete", "AgentRenewal_DeleteOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @Html.ActionLink("View", "AgentRenewal_EditOTIProfile_OrgMemberDetail", new { IndexID = item.RenewalAgent_OtherMember_IndexID, OtherID = item.RenewalAgent_OtherMember_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}

