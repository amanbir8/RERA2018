<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            if (confirm('Are you sure you want to submit the other member details ?')) {
                $(submitButton).parents('form').submit();
            }
            else {
                return false;
            }
        });
    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
        $(function () {
            var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "AgentRenewal/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    if (value != null) {
                        $('#OfficeComm_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                        $("#OfficeComm_AddressStateCode option:contains(undefined)").remove();
                    }
                });
            }
        });

        $('#OfficeComm_AddressStateCode').change(function () {
            $('#OfficeComm_AddressDistrictCode').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "AgentRenewal/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#OfficeComm_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#OfficeComm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
<style>
