                                @Html.HiddenFor(model => model.RenewalAgent_OtherMember_ID, htmlAttributes: new { @class = "control-label" })

                                @Html.HiddenFor(model => model.Related_RERAnumberRegistration, htmlAttributes: new { @class = "control-label", @id = "RefRegistrationNumber" })
                                @Html.HiddenFor(model => model.Related_Agent_ID, htmlAttributes: new { @class = "control-label", @id = "RefAgentID" })
                                @Html.HiddenFor(model => model.Related_Agent_Type, htmlAttributes: new { @class = "control-label", @id = "RefAgentType" })
                                @Html.HiddenFor(model => model.Related_RenewalAgent_ID, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentID" })
                                @Html.HiddenFor(model => model.Related_RelatedRenewalAgent_Year, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentYear" })
                                @Html.HiddenFor(model => model.Related_RenewalOrderSequence, htmlAttributes: new { @class = "control-label", @id = "RefRenewalOrderSequence" })
                                @Html.HiddenFor(model => model.Related_UserID, htmlAttributes: new { @class = "control-label", @id = "RefPublicView" })

                                @Html.HiddenFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsActiveProvider, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsDraft, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsLock, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsPublicView, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsConditional, htmlAttributes: new { @class = "control-label" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Organization Member Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Name of Chairman/ Director/ Authorized Signatory / Managing Director / Partner of the Organization as per the MoU.">
                                                            @Html.EditorFor(model => model.OtherMember_Name, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @{var listItemDesignation = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "Select Designation" , Value=""  },
                                                                    new SelectListItem {  Text = "Additional Director" , Value="Additional Director"  },
                                                                    new SelectListItem {  Text = "Authorized Signatory" , Value="Authorized Signatory"  },
                                                                    new SelectListItem {  Text = "Authorized Partner" , Value="Authorized Partner"  },
                                                                    new SelectListItem {  Text = "Chairperson" , Value="Chairperson"  },
                                                                    new SelectListItem {  Text = "Chief Finance Officer" , Value="Chief Finance Officer"  },
                                                                    new SelectListItem {  Text = "Company Secretary" , Value="Company Secretary"  },
                                                                    new SelectListItem {  Text = "Director" , Value="Director"  },
                                                                    new SelectListItem {  Text = "Memeber" , Value="Memeber"  },
                                                                    new SelectListItem {  Text = "Managing Director" , Value="Managing Director"  },
                                                                    new SelectListItem {  Text = "Managing Partner" , Value="Managing Partner"  },
                                                                    new SelectListItem {  Text = "Partner" , Value="Partner"  },
                                                                    new SelectListItem {  Text = "Sales Head" , Value="Sales Head"  },
                                                                    new SelectListItem {  Text = "Sales and Operations Officer" , Value="Sales and Operations Officer"  },
                                                                    new SelectListItem {  Text = "Sole Proprietorship" , Value="Sole Proprietorship"  },
                                                                    new SelectListItem {  Text = "Other" , Value="Other"  },
                                                                };
                                                            }
                                                            @Html.LabelFor(model => model.Designation, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Designation as per MoU, Eg. - Chairman/ Partner/ Director/ Other Auhtorized Signatory etc.">
                                                            @Html.DropDownListFor(model => model.Designation, new SelectList(listItemDesignation, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Designation, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_PAN_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="PAN Number of the Member in the PAN Number format, eg. ABCDE1234F.">
                                                            @Html.EditorFor(model => model.OtherMember_PAN_Number, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_PAN_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.OtherMember_Aadhaar_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="12 Digit Aadhaar Number of the Member.">
                                                            @Html.EditorFor(model => model.OtherMember_Aadhaar_Number, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.OtherMember_Aadhaar_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Mobile Number of the Member without any prefix and country code.">
                                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.PhoneNumber_Number, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Landline Number with std code and without '0' prefix, eg. 1721234567.">
                                                            @Html.EditorFor(model => model.PhoneNumber_Number, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.PhoneNumber_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.EmailAddress, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Active and valid email Id of the Member.">
