<script type="text/javascript">
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        $('[data-spzoom]').spzoom();

        $('#IsSameBussinessAdd_CommAdd').on("click", function () {
            if ($(this).is(':checked')) {
                //debugger;
                //Clone the DropDownList
                var ddl = $("#BusinessPlace_AddressStateCode").clone();

                //[OPTIONAL] Copy the selected value
                var selectedValue = $("#BusinessPlace_AddressStateCode option:selected").val();
                $("input[name='BComm_AddressStateCode']").find("option[value = '" + selectedValue + "']").attr("selected", "selected");

                $("input[name='BComm_AddressLine1']").val($("input[name='BusinessPlace_AddressLine1']").val());
                $("input[name='BComm_AddressLine2']").val($("input[name='BusinessPlace_AddressLine2']").val());
                $("select[name='BComm_AddressStateCode']").val($("select[name='BusinessPlace_AddressStateCode']").val());

                $("select[name='BComm_AddressDistrictCode']").val($("select[name='BusinessPlace_AddressDistrictCode']").val());
                $("input[name='BComm_AddressPIN']").val($("input[name='BusinessPlace_AddressPIN']").val());
            } else {
                $("input[name='BComm_AddressLine1']").val('');
                $("input[name='BComm_AddressLine2']").val('');
                $("input[name='BComm_AddressPIN']").val('');
                $("select[name='BComm_AddressDistrictCode']").val('');
                $("select[name='BComm_AddressStateCode']").val('');
            }
        });
    });
</script>
