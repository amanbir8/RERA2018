<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Renewal of Registration : Agent Profile Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Renewal of Registration (Form-J) : Agent - Other Than Individual (Company/ Proprietorship Firm/ Societies/ Partnership Firm/Competent Authority etc) Details
                    <span class="pull-right">
                        <a id="modalRegistrationStatusOpenerButton" href="javascript:void(0);" title="View Registration Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-list-ul" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("AgentRenewal_OTIProfile", "AgentRenewal", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                
                                @Html.HiddenFor(model => model.RenewalAgent_IndexID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.RenewalAgent_ID, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentID" })
                                @Html.HiddenFor(model => model.RenewalOrderSequence, htmlAttributes: new { @class = "control-label", @id = "RefRenewalOrderSequence" })
                                @Html.HiddenFor(model => model.RelatedRenewalAgent_Year, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentYear" })
                                @Html.HiddenFor(model => model.Related_Agent_ID, htmlAttributes: new { @class = "control-label", @id = "RefAgentID" })
                                @Html.HiddenFor(model => model.Related_AgentDiaryNumber_Name, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.Related_Agent_Type, htmlAttributes: new { @class = "control-label", @id = "RefAgentType" })
                                @Html.HiddenFor(model => model.Related_RERAnumberRegistration, htmlAttributes: new { @class = "control-label", @id = "RefRegistrationNumber" })
                                @Html.HiddenFor(model => model.Related_RERAnumberIssueDate, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.Related_RERAnumberRegUptoDate, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.Agent_Type, htmlAttributes: new { @class = "control-label" })

                                @Html.HiddenFor(model => model.BusinessPlace_AddressSubDivisionName, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsAlready_RERANumber, htmlAttributes: new { @class = "control-label" })

                                @Html.HiddenFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsActiveProvider, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsDraft, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsLock, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsPublicView, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsConditional, htmlAttributes: new { @class = "control-label" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Agent Registration Details</legend>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Organization_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Name of Organization as per PAN Card of Organization.">
                                                            @Html.EditorFor(model => model.Organization_Name, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Organization_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @{var listItemstateOType = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                                    new SelectListItem {  Text = "Public Limited Company" , Value="0"  },
                                                                    new SelectListItem {  Text = "Undivided Hindu Family" , Value="1"  },
                                                                    new SelectListItem {  Text = "Partnerships" , Value="2"  },
                                                                    new SelectListItem {  Text = "Co-operative Societies" , Value="3"  },
                                                                    new SelectListItem {  Text = "Limited Liabilities Partnership" , Value="4"  },
                                                                    new SelectListItem {  Text = "Development Authorities" , Value="5"  },
                                                                    new SelectListItem {  Text = "Private Limited Company" , Value="7"  },
                                                                    new SelectListItem {  Text = "Sole Proprietorship" , Value="8"  },
                                                                    new SelectListItem {  Text = "Others" , Value="6"  },
                                                                };
                                                            }
                                                            @Html.Label("Organization Type", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.Organization_TypeCode, new SelectList(listItemstateOType, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Organization_TypeCode, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                               
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Organization_MainObjects, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Main Objects of Organization e.g. (1.) To assist in sale or purchase of land and building, (2.) Real estate consultants, (3.) Carry out business as real estate agents and managers etc.">
                                                            @Html.EditorFor(model => model.Organization_MainObjects, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Organization_MainObjects, "", new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Organization_PAN_Number, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="PAN Number of Organization as per PAN card and PAN Number format, eg. ABCDE1234F.">
                                                            @Html.EditorFor(model => model.Organization_PAN_Number, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Organization_PAN_Number, "", new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Do you have other Organization Members (Yes/No)?</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsOtherOrganizationMembers, "Y") Yes
                                                                @Html.RadioButtonFor(model => model.IsOtherOrganizationMembers, "N") No
                                                                @Html.ValidationMessageFor(model => model.IsOtherOrganizationMembers, "", new { @class = "text-danger" })
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Registration Number Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Registration Number</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="The existing Registration Number of Real-Estate Agent as per the Punjab RERA, Authority.">
                                                            @Html.EditorFor(model => model.Existing_RERANumber, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Existing_RERANumber, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Mode of Registration</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label>
                                                                @Html.RadioButtonFor(model => model.Mode_RegistrationNumber, "OfflineMode") Offline
                                                                @Html.RadioButtonFor(model => model.Mode_RegistrationNumber, "OnlineMode") Online (WebPortal)
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.Mode_RegistrationNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <label class="control-label mand">Do you have other State/UT RERA registration No.(Yes/No)?</label>
                                                        </div>
                                                        <div class="col-md-6" data-toggle="tooltip" data-placement="top" title="Are you registered with Real Estate Regulatory Authority of other States / UT as Real Estate Agent?">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsOtherStateUT_RERAregistration, "Y") Yes
                                                                @Html.RadioButtonFor(model => model.IsOtherStateUT_RERAregistration, "N") No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsOtherStateUT_RERAregistration, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Registered Address of Organization</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RegOffice_AddressLine1, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Registered Address of Organization as per PAN Card of Organization.">
                                                            @Html.EditorFor(model => model.RegOffice_AddressLine1, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
