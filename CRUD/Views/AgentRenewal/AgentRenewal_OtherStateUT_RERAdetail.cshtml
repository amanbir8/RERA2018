<script>
    $(document).ready(function () {
        var displayBASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalRegistrationStatusOpenerButton', function (e) {
            e.preventDefault();
            var RenewalAgentDetailsModal = $(document).find('#myModal');
            $(RenewalAgentDetailsModal).find('.modal-body').html('');
            var qagentid = $('#RefAgentID').val();
            var ptypeagent = $('#RefAgentType').val();
            var prenewalagentid = $('#RefRenewalAgentID').val();
            var prenewalagentseq = $('#RefRenewalOrderSequence').val();
            var prenewalagentyr = $('#RefRenewalAgentYear').val();
            var pkeyflag = 214;
            qagentid = parseInt(qagentid);
            ptypeagent = parseInt(ptypeagent);
            prenewalagentid = parseInt(prenewalagentid);
            prenewalagentseq = parseInt(prenewalagentseq);
            prenewalagentyr = parseInt(prenewalagentyr);
            pkeyflag = parseInt(pkeyflag);
            var pkeysubflag = 'OtherRera';

            $.ajax({
                url: displayBASE_URL + 'AgentRenewal/AgentRenewal_ListPreviousRegistration',
                dataType: 'HTML',
                type: 'GET',
                data: { 'qagentid': qagentid, 'ptypeagent': ptypeagent, 'prenewalagentid': prenewalagentid, 'prenewalagentseq': prenewalagentseq, 'prenewalagentyr': prenewalagentyr, 'pkeyflag': pkeyflag, 'pkeysubflag': pkeysubflag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(RenewalAgentDetailsModal).find('.modal-body').html(response);
                    $(RenewalAgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = 'Real Estate Agent (No record founds)';
            if ($('#RefRegistrationNumber').val() != '') {
                var diaryNo = $('#RefRegistrationNumber').val();
            };
            //var realestateagentName = $('#ProjectName').val();
            $(RenewalAgentDetailsModal).find('h4.modal-title').html('Registration Details - <a href="javascript:void(0);"></a>');
            //$(RenewalAgentDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + realestateagentName + ')');
            $(RenewalAgentDetailsModal).find('h4.modal-title a').html(diaryNo);
            $(RenewalAgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Renewal of Registration</b><br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-I: Agent Profile.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-II: Organization Member Details (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-III: Upload Document(s).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-IV: Other State/UT Registration Number Detail (if any).<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-V: Application Fee.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Step-VI: Review and Confirm Application Form.<br/> <i class="fa fa-check-square" style="color:#eff3f9"></i> Note down Diary Number for your future reference.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Renewal of Registration : RERA Registration Details with Other State/UT(s)</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Renewal of Registration (Form-J) : Registration Details of Real-estate Agent with Other State/UT(s)
                    <span class="pull-right">
                        <a id="modalRegistrationStatusOpenerButton" href="javascript:void(0);" title="View Registration Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-list-ul" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("AgentRenewal_OtherStateUT_RERAdetail", "AgentRenewal", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                @Html.HiddenFor(model => model.AgentRenewal_OtherStateUT_regRERA_IndexID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.AgentRenewal_OtherStateUT_regRERA_ID, htmlAttributes: new { @class = "control-label" })

                                @Html.HiddenFor(model => model.Related_RERAnumberRegistration, htmlAttributes: new { @class = "control-label", @id = "RefRegistrationNumber" })
                                @Html.HiddenFor(model => model.Related_Agent_ID, htmlAttributes: new { @class = "control-label", @id = "RefAgentID" })
                                @Html.HiddenFor(model => model.Related_Agent_Type, htmlAttributes: new { @class = "control-label", @id = "RefAgentType" })
                                @Html.HiddenFor(model => model.RenewalAgent_ID, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentID" })
                                @Html.HiddenFor(model => model.RelatedRenewalAgent_Year, htmlAttributes: new { @class = "control-label", @id = "RefRenewalAgentYear" })
                                @Html.HiddenFor(model => model.RenewalOrderSequence, htmlAttributes: new { @class = "control-label", @id = "RefRenewalOrderSequence" })
                                @Html.HiddenFor(model => model.Related_UserID, htmlAttributes: new { @class = "control-label", @id = "RefPublicView" })

                                @Html.HiddenFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsActiveProvider, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsDraft, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsLock, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsPublicView, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.IsConditional, htmlAttributes: new { @class = "control-label" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">RERA Registration Details</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select State</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @if (Model.stateMaster != null)
                                                            {
                                                                @Html.DropDownListFor(m => m.StateCode, new SelectList(Model.stateMaster, "StateId", "StateName"), "Select State", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(m => m.StateCode, "", new { @class = "text-danger" })
                                                            }
                                                            else
                                                            {
                                                                @Html.DropDownListFor(m => m.StateCode, new SelectList(" "), "Select State", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(m => m.StateCode, "", new { @class = "text-danger" })
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("RERA Registration Number", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RERAregistration_Number, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RERAregistration_Number, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("RERA Registration Issue Date", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RERAregistration_IssueDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RERAregistration_IssueDate, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.Label("RERA Registration Expiry Date", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RERAregistration_ExpiryDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RERAregistration_ExpiryDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("Remarks, If Any", htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Remarks_IfAny, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Remarks_IfAny, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.IsLock == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else if (Model.IsLock == 0)
                                            {
                                                if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "AgentRenewal_OtherStateUT_RERAdetail", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="row">
                                <div class="form-group">                                    
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="renewalregistration-agent-list">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_Number)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_IssueDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_ExpiryDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                        </th>
                                                        <th>@Html.DisplayName("Edit| Delete")</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.AgentRenewal_OtherStateUT)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_Number)
                                                            </td>
                                                            <td>
                                                                @if (item.RERAregistration_IssueDate != DateTime.MinValue)
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.RERAregistration_IssueDate)
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("NA")
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (item.RERAregistration_ExpiryDate != DateTime.MinValue)
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.RERAregistration_ExpiryDate)
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("NA")
                                                                }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                            </td>                    
                                                            <td>
                                                                @if (item.IsLock == 1)
                                                                {
                                                                    @Html.ActionLink("View", "AgentRenewal_EditOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID })
                                                                }
                                                                else if (item.IsLock == 0)
                                                                {
                                                                    if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                                    {
                                                                        @Html.ActionLink("View", "AgentRenewal_EditOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID })
                                                                    }
                                                                    else
                                                                    {
                                                                        if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                                        {
                                                                            @Html.ActionLink("View", "AgentRenewal_EditOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID })
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.ActionLink("Edit", "AgentRenewal_EditOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID }) @(" | ")
                                                                            @Html.ActionLink("Delete", "AgentRenewal_DeleteOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    @Html.ActionLink("View", "AgentRenewal_EditOtherStateUT_RERAdetail", new { IndexID = item.AgentRenewal_OtherStateUT_regRERA_IndexID, OtherID = item.AgentRenewal_OtherStateUT_regRERA_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.RenewalAgent_ID })
                                                                }                                                                
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
