<script>
    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }

    var loginuser = function loginuser_verifyScanCopy() {
        //"photo address" have value on submit button
        //and "user_photo" have value on update button
        var files = $("#Photo_Address").get(0).files;
        var path = $('#user_Photo').attr('src').replace('/', '');

        if (files.length > 0 || path.length > 0) {
            $(submitButton).parents('form').submit();
        }
        else {
            if ($('#Payment_Mode').val() == 'Online Payment') {
                $(submitButton).parents('form').submit();
            }
            else {
                alert("Please Add Scan copy of DD/Banker Cheque file to Upload!")
                return false;
            }
        }
    }
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
