                                                            @Html.LabelFor(model => model.ImageDDorBankersCheque_FileName, htmlAttributes: new { @class = "control-label mand" })
                                                            <span class="fa-help">
                                                                <a class="a info-help-uploadimage" href="javascript:void(0);" title="Help"><span><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                                                            </span>
                                                        </div>                                                       
                                                        <div class="col-md-3">
                                                            <div class="input-group">
                                                                <label class="input-group-btn">
                                                                    <span class="btn btn-primary">
                                                                        Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                    </span>
                                                                </label>
                                                                <input type="text" id="Photo_AddressShow" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.HiddenFor(model => model.ImageDDorBankersCheque_FileName)
                                                            @Html.HiddenFor(model => model.ImageDDorBankersCheque_FilePath, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>                                                       
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.ImageDDorBankersCheque_FilePath)@Html.DisplayFor(model => model.ImageDDorBankersCheque_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.ImageDDorBankersCheque_FilePath)@Html.DisplayFor(model => model.ImageDDorBankersCheque_FileName)" alt="No Image" />
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <span style="color:red;">@TempData["notice"]</span><br />Photo Should be in .jpg format and less than 512KB
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.IsLock == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else if (Model.IsLock == 0)
                                            {
                                                if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" onclick="return loginuser_verifyScanCopy();" />
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "AgentRenewal_ApplicationPayment", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                            &nbsp;
                                            <span style="color:tomato;">@TempData["OnlinePayMessageShow"]</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="renewal-agent-payments-list">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.AgentPayment_TitleName)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Bank_Name)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DD_BankersCheque_Number)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.DD_BankersCheque_Amount)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Registration_Fee)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Other_Fee)
                                            </th>                                            
                                            <th>@Html.DisplayName("Payment| Edit| Delete")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ARFeePayment)
                                        {
                                            <tr>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.AgentPayment_TitleName)
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.Bank_Name)
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayName("Online Payment")
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.DD_BankersCheque_Number)
                                                    }
                                                    else
                                                    {
                                                        if (item.IsActive == 1)
                                                        {
                                                            @Html.DisplayName("Online Payment [COMPLETE]")                                                            
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("Online Payment [PENDING]")
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.Payment_Mode != "Online Payment")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.DD_BankersCheque_Amount)
                                                    }
                                                    else
                                                    {
                                                        if (item.IsActive == 1)
                                                        {
                                                            @Html.DisplayName("Online Payment [COMPLETE]")                                                            
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("Online Payment [PENDING]")
                                                        }
                                                    }
                                                </td>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Registration_Fee)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Other_Fee)
                                                </td>                                                
                                                <td>
                                                    @if (item.IsLock == 1)
                                                    {
                                                        if (item.Payment_Mode != "Online Payment")
                                                        {
                                                            @Html.ActionLink("View", "AgentRenewal_EditApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                        }
                                                        else
                                                        {                                                            
                                                            @Html.ActionLink("View", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, null)
                                                        }
                                                    }
                                                    else if (item.IsLock == 0)
                                                    {
                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            if (item.Payment_Mode != "Online Payment")
                                                            {
                                                                @Html.ActionLink("View", "AgentRenewal_EditApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                            }
                                                            else
                                                            {                                                                
                                                                @Html.ActionLink("View", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, null)
                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                            {
                                                                if (item.Payment_Mode != "Online Payment")
                                                                {
                                                                    @Html.ActionLink("View", "AgentRenewal_EditApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                                }
                                                                else
                                                                {                                                                    
                                                                    @Html.ActionLink("View", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, null)
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (item.Payment_Mode != "Online Payment")
                                                                {
                                                                    @Html.ActionLink("Edit", "AgentRenewal_EditApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID }) @(" | ")
                                                                    @Html.ActionLink("Delete", "AgentRenewal_DeleteApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsActive == 1)
                                                                    {                                                                        
                                                                        @Html.ActionLink("View", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, new { @class = "btn btn-outline btn-primary" })
                                                                    }
                                                                    else
                                                                    {                                                                        
                                                                        @Html.ActionLink("Make Payment", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, new { @class = "btn btn-danger" })
                                                                        @*@Html.ActionLink(" ", "AgentRenewal_DeleteApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-remove", @title = "Delete" })*@
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        if (item.Payment_Mode != "Online Payment")
                                                        {
                                                            @Html.ActionLink("View", "AgentRenewal_EditApplicationPayment", new { IndexID = item.RenewalAgent_FeePayment_IndexID, OtherID = item.RenewalAgent_FeePayment_ID, KeyID = item.Related_Agent_ID, RnKeyID = item.Related_RenewalAgent_ID })
                                                        }
                                                        else
                                                        {                                                            
                                                            @Html.ActionLink("View", "Detail_RequestAgentRenewalApplicationPayment", "AgentRenewalPayment", new { RelatedPaymentCode = item.RenewalAgent_FeePayment_ID }, null)
                                                        }
                                                    }                                                    
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}

