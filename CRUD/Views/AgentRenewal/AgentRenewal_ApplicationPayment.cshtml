<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            if (confirm('Are you sure you want to update notice/complaint details ?')) {
                $(submitButton).parents('form').submit();
            }
            else {
                return false;
            }
        });

        var HBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', '#BtnHearingDetail', function (e) {
            e.preventDefault();
            var form = $(this);
            if ($(form).valid()) {
                if (confirm('Are you sure you want to submit for new hearing date details ?')) {
                    $.ajax({
                        url: HBASE_URL + 'HelpdeskAdmin/HearingDetailAdd_NoticeSecFiveNine',
                        type: "POST",
                        //contentType: 'application/json; charset=utf-8',
                        datatype: "JSON",
                        data: $("#secfivenineform").serialize(),
                        success: function (response) {
                            swal({
                                title: "Message",
                                text: "Successfully submitted/issued Hearing Date.",
                                type: "success"
                            }, function () {
                                return true;
                            });
                        },
                    });
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        });

        if ($('#OrderDate').val() == "01-Jan-0001") {
            $('#OrderDate').val("");
        }
    });
</script>

<script type="text/javascript">
    $(function () {

        if ($('#Payment_Mode').val() != 'Online Payment') {
            $("#onlinepaymentrow1").css("display", "block");
            $("#onlinepaymentrow2").css("display", "block");
            $("#onlinepaymentrow3").css("display", "block");
            $("#onlinepaymentrow4").css("display", "block");
        }
        else {
            $("#onlinepaymentrow1").css("display", "none");
            $("#onlinepaymentrow2").css("display", "none");
            $("#onlinepaymentrow3").css("display", "none");
            $("#onlinepaymentrow4").css("display", "none");
        }


        $('#Payment_Mode').on('change', function () {
            var paymentmode = $('#Payment_Mode').val();
            if (paymentmode != 'Online Payment') {
                $("#onlinepaymentrow1").css("display", "block");
                $("#onlinepaymentrow2").css("display", "block");
                $("#onlinepaymentrow3").css("display", "block");
                $("#onlinepaymentrow4").css("display", "block");
            }
            else {
                $("#onlinepaymentrow1").css("display", "none");
                $("#onlinepaymentrow2").css("display", "none");
                $("#onlinepaymentrow3").css("display", "none");
                $("#onlinepaymentrow4").css("display", "none");
            }
        });
    });
</script>
