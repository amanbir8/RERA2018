<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', '#btnSearchformDetails', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            if (confirm('Are you sure you want to view registration number details ?')) {
                $(submitButton).parents('form').submit();
            }
            else {
                return false;
            }
        });

        var HBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', '#BtnSaveform_IAgree', function (e) {
            e.preventDefault();
            var form = $(this);
            if ($(form).valid()) {
                if (confirm('Are you sure you want to submit for renewal of registration ?')) {
                    $.ajax({
                        url: HBASE_URL + 'AgentRenewal/AgentRenewal_AddSearchPreviousRegistration',
                        type: "POST",
                        //contentType: 'application/json; charset=utf-8',
                        datatype: "JSON",
                        data: $("#renewalagentsearchform").serialize(),
                        success: function (response) {
                            if (response.result == 'RedirectErr') {
                                swal({
                                    title: "Are you sure?",
                                    text: "Error! Something went wrong.",
                                    type: "warning"
                                }, function () {
                                    if (response.result == 'RedirectErr') {
                                        window.location.href = response.redirectToUrl;
                                    };
                                    return true;
                                });
                            }
                            else {
                                swal({
                                    title: "Message",
                                    text: "Successfully submitted the request.",
                                    type: "success"
                                }, function () {
                                    if (response.result == 'Redirect') {
                                        window.location.href = response.redirectToUrl;
                                    };
                                    return true;
                                });
                            };
                        },
                    });
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }
        });

        $('#Is_YesNo_AgentRenewalPermission_Flag').click(function () {
            $('#BtnSaveform_IAgree').prop("disabled", !$("#Is_YesNo_AgentRenewalPermission_Flag").prop("checked"));
        });
    });
</script>

<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<style>
    #customTopBtn {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 20px; /* Place the button at the bottom of the page */
        right: 30px; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #064576; /* Set a background color */
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>
<script>
    $(function () {
        $('[data-spzoom]').spzoom();
        $('[data-toggle="tooltip"]').tooltip();

        $('table#fivenine-hearing-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

        $("#RERAnumberRegistration").inputmask({ mask: function () { return ["AAAAAA-AAA99-AAA9999"]; } });
        $('#RERAnumberIssueDate').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#RERAnumberRegUptoDate").datepicker("option", "minDate", dt);
            }          
        });
        $('#RERAnumberRegUptoDate').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var IssueDate = $("#RERAnumberIssueDate").val();
                if (IssueDate == '') {
                    alert('Please select Registration Issued Date first!');
                    $("#RERAnumberRegUptoDate").val('');
                    return false;
                }
                else {
                    return true;
                }
            }
        });
    });
</script> 
