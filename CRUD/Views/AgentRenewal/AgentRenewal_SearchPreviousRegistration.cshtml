                                                                                The real-estate agent was registered before the online system of the Authority became functional. Further, in case of online system for renewal of registration, the information of <i>'Agent's Profile'</i> has been uploaded directly by the Agent, and is yet to be verified by the Authority.Till such verification, the information supplied to the Authority at the time of manual registration shall be the authentic record.
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </fieldset>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-12">
                                                                <div class="btn-toolbar">
                                                                    @Html.ActionLink("Cancel", "AgentRenewal_SearchPreviousRegistration", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                if (item.Is_YesNo_ProfileNewCreated_Flag == 0)
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            <div class="form-group">
                                                                <fieldset class="col-md-12">
                                                                    <legend class="my">Note</legend>
                                                                    <div class="row">
                                                                        <div class="form-group">
                                                                            <div class="help-block col-md-12 justify">
                                                                                If you don’t already have a my-profile account for the renewal of registration of real-estate agent, click the “Create New MyProfile” button. After creating or signing up with my-profile, then you’ll only start the renewal of registration by online service of the authority's web-portal.
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </fieldset>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-12">
                                                                <div class="btn-toolbar">
                                                                    @Html.ActionLink("Create New MyProfile", "OptionViewAgent", "Agent", null, new { @class = "btn btn-outline btn-primary" })
                                                                    @Html.ActionLink("Cancel", "AgentRenewal_SearchPreviousRegistration", "AgentRenewal", null, new { @class = "btn btn-outline btn-primary" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Result Status</legend>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-2">
                                                                    @Html.Label("Registration Status", htmlAttributes: new { @class = "control-label" })
                                                                </div>
                                                                <div class="col-md-9 alert alert-warning">
                                                                    "No Records Found", for renewal of registration with reference to the information provided directly by the sign-in user or the Agent, and also as per the <i>'Registered Real-Estate Agent'</i> and <i>'Agent's Profile'</i> details.
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    <div class="btn-toolbar">
                                                        @Html.ActionLink("Cancel", "IndexAgent", "Home", null, new { @class = "btn btn-outline btn-primary" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Result Status</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-2">
                                                                @Html.Label("Registration Status", htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-9 alert alert-warning">
                                                                "No Records Found", for renewal of registration with reference to the information provided directly by the sign-in user or the Agent, and also as per the <i>'Registered Real-Estate Agent'</i> and <i>'Agent's Profile'</i> details.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="btn-toolbar">
                                                    @Html.ActionLink("Cancel", "IndexAgent", "Home", null, new { @class = "btn btn-outline btn-primary" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
