                                <table class="table table-striped table-bordered" id="renewal-agent-documents-list">
                                    <thead>
                                        <tr>                                            
                                            <th>
                                                @Html.DisplayNameFor(model => model.AgentDoc_InfoCode)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.AgentDoc_ReferenceNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.AgentDoc_IssueDate)
                                            </th>                                            
                                            <th>
                                                @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                            </th>
                                            <th>
                                                @Html.Label("View")
                                            </th>
                                            <th>
                                                @Html.Label("Delete")
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.AgentRenewal_Document)
                                        {
                                            <tr>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.AgentDoc_InfoName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.AgentDoc_ReferenceNumber)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.AgentDoc_IssueDate)
                                                </td>                                                
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                </td>

                                                <td>
                                                    <a href="~/@Html.DisplayFor(modelItem => item.AgentDoc_FilePath)" target="_blank" title="View"><i class="fa fa-external-link-square"></i></a>                                                    
                                                </td>
                                                <td>
                                                    @if (item.IsLock == 1)
                                                    {
                                                        @("--")
                                                    }
                                                    else if (item.IsLock == 0)
                                                    {
                                                        if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            @("--")
                                                        }
                                                        else
                                                        {
                                                            if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                            {
                                                                @("--")
                                                            }
                                                            else
                                                            {
                                                                @Html.ActionLink(" ", "AgentRenewal_DeleteDocumentdetail", new { inDocIndexID = item.RenewalAgent_Document_IndexID, inDocID = item.RenewalAgent_Document_ID, inAgentID = item.Related_Agent_ID, inRenewalAgentID = item.Related_RenewalAgent_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-remove", @title = "Delete" })
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @("--")
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

