<script type="text/javascript">
    $(function () {
        $("#RenewalAgentFormUpload").submit(function (event) {
            var form = $('#RenewalAgentFormUpload')[0];
                var baseUrl = $('body').attr('data-base-url');
                var files = ($("#UploadedFile"))[0].files[0];

                if (typeof files === 'undefined') {
                    $("#showSaveFileUploadMessage").show();
                    $("#saveFileUploadMessageName").text("Note : Please Add files... to Upload!");
                    return false;
                }

                if (files.size > 0) {
                    var formData = new FormData(form);
                    for (var i = 0; i < files.length; i++) {
                        formData.append(files[i].name, files[i]);
                    }
                    var progressbarLabel = $('#progressBar-label');
                    var progressbarDiv = $('#progressbar');
                    $.ajax({
                        url: baseUrl + 'AgentRenewalDocument/AgentRenewal_FormUpload',
                        method: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            if (data.statusCode == 101)
                            {
                                progressbarLabel.text('COMPLETE');
                                progressbarDiv.fadeOut(2000);
                                $(".InfoContainer").fadeOut(2000);
                                $("#showFileInfo").fadeOut(2500);
                            }
                            else
                            {
                                progressbarLabel.text('Bad Request! Upload Failed');
                                progressbarDiv.fadeOut(2000);
                                $("#showSaveFileUploadMessage").show();
                                $("#saveFileUploadMessageName").text("Note : " + data.status);
                            }
                        },
                        failure: function(data) {
                            alert('Bad Request! Upload Failed');
                        },
                        error: function (err) {
                            alert('Bad Request! Upload Failed');
                        }
                    });

                    progressbarLabel.text('UPLOADING ...');
                    progressbarDiv.progressbar({
                        value: false
                    }).fadeIn(500);
                    $("#showSaveFileUploadMessage").hide();
                }
                return false;
        });

        $("#AgentDoc_InfoCode").change(function () {
            $("#showFileInfo").show();
        });

        $('#AgentDoc_InfoCode').change(function () {
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "AgentRenewalDocument/GetAgentDocumentMasterByDocId",
                datatype: "Json",
                data: { DocId: $('#AgentDoc_InfoCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#getDocFileInfo').show();
                        $('#DocFileFormat').text("File Format : " + value.AgentDoc_SetFileFormat);
                        var ofilesize = 0;
                        if (value.AgentDoc_SetFileSize > 1048576) {
                            ofilesize = Math.round(value.AgentDoc_SetFileSize * 100 / 1048576) / 100 + " MB";
                        }
                        else if (value.AgentDoc_SetFileSize > 1024) {
                            ofilesize = Math.round(value.AgentDoc_SetFileSize * 100 / 1024) / 100 + " KB";
                        }
                        else {
                            ofilesize = value.AgentDoc_SetFileSize + " Bytes";
                        }

                        $('#DocFileSize').text("File Size : " + ofilesize);
                        if (value.IsMandatory == 1)
                        {
                            $('#DocFileMandatoryStatus').text("File Status : This document is mandatory file for renewal of registration/upload.");
                        }
                        else
                        {
                            $('#DocFileMandatoryStatus').text("File Status : This document is optional file to upload.");
                        }
                        $('#DocFileDiscription').text("Description : " + value.A_column);
                    });
                }
            });
        });

        $('#AgentDoc_InfoCode').change(function () {
            $('#AgentDoc_InfoName').empty();
            $("input[name='AgentDoc_InfoName']").val($("#AgentDoc_InfoCode option:selected").text());
        });
    });
</script>
<script>
    function singleFileSelected() {
        //var selectedFile = evt.target.files can use this  or select input file element
        //and access it's files object
        //debugger;
        var baseUrl = $('body').attr('data-base-url');
        $(".InfoContainer").fadeIn();
        var selectedFile = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];
        if (selectedFile) {
            var FileSize = 0;
            var imageType = /image.*/;
            if (selectedFile.size > 1048576) {
                FileSize = Math.round(selectedFile.size * 100 / 1048576) / 100 + " MB";
            }
            else if (selectedFile.size > 1024) {
                FileSize = Math.round(selectedFile.size * 100 / 1024) / 100 + " KB";
            }
            else {
                FileSize = selectedFile.size + " Bytes";
            }
            // here we will add the code of thumbnail preview of upload images

            $("#showFileInfoGrid").show();
            $("#FileName").text("Name : " + selectedFile.name);
            $("#FileType").text("Type : " + selectedFile.type);
            $("#FileSize").text("Size : " + FileSize);

            $("#showSaveFileUploadMessage").hide();


            if (selectedFile.type.match(imageType)) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = reader.result;
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "100";
                    img.width = "100";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(100);
                    $("#Imagecontainer").width(100);
                };
                reader.readAsDataURL(selectedFile);
            }
            if (selectedFile.type.match('application/pdf')) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = baseUrl + 'images/pdf.png';
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "35";
                    img.width = "35";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(35);
                    $("#Imagecontainer").width(35);
                };
                reader.readAsDataURL(selectedFile);
            }
        }
    }
</script>
