@model CRUD.Models.PromoterProject.ClsPrp_Project_MasterExtensionName

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script type="text/javascript">

    @if (TempData["ProjectFormExtensionRegDiaryNumber_Name"].ToString() != "")
    { 
        <text >
            $(document).ready(function()
            {
                swal({
                title: "Message",
                    text: "@TempData["ProjectFormExtensionRegDiaryNumber_Name"]",
                    type: "success"
                }, function () {
                    window.location = "../ProjectConfirmExtension/Create_ProjectExtentionReviewConfirmDetails";
                });
            });
        </text>
    }


</script>

<script>
$(function() {
    $('[data-spzoom]').spzoom();

    $('table#promoter-documents-list-table').dataTable({
        'aoColumnDefs': [{
            'bSortable': false,
            'aTargets': [5, 6]
        }],
        "language": {
            "info": "Showing _START_ to _END_ of _TOTAL_ records",
            "lengthMenu": "Show _MENU_ records"
        },
        "pagingType": "full_numbers"
    });
});
</script>

<script type="text/javascript">
        $(document).ready(function () {

            $(document).on('click', '#BtnDrp', function (e) {
                e.preventDefault();
                var proceedButton = $(this);
                var drpText = $(document).find("select#ProjectRegistration_ID").val();
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                }
                else {
                    $("#idMainForm").show();                    
                    $(proceedButton).parents('form').submit();
                }
            });

            $(document).on('click', '#BtnMainform', function (e) {
                var submitButton = $(this);
                e.preventDefault();
                var drpText = $(document).find("select#ProjectRegistration_ID").val();
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    drpText = "";
                    return false;
                }
                else {
                    $(submitButton).parents('form').submit();                                
                }
            });

            //new PNotify({
            //    title: 'Notification',
            //    text: 'In addition to the project registration fee, INR 5000/- as annual portal convenience fee needs to be submitted.',
            //    hide: false                
            //});

            //new PNotify({
            //    title: 'Notification',
            //    text: 'All payments need to be in the form of a Demand Draft in favor of Real Estate Regulatory Authority, Punjab. Further, 50% of original registration fees (excluding late fee/ any penalty)/- as the extension of registration of project fee needs to be submitted.',
            //    type: 'info',
            //    hide: false                
            //});
        });
</script>


<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Form-E  [See rule 6(1)]  Application for Extension of Registration of Project</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>

    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link" id="formE-tab" href="@Url.Action("Create_ProjectExtensionFormEDocument", "Project")" role="tab" aria-controls="formE" aria-selected="false">Step I (Form-E Details)</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="formEpayment-tab" href="@Url.Action("Create_ProjectExtentionPaymentDetails", "Project")" role="tab" aria-controls="formEpayment" aria-selected="false">Step II (Payment)</a>
                </li>
                <li class="nav-item active">
                    <a class="nav-link active" id="formEreviewconfirm-tab" href="@Url.Action("Create_ProjectExtentionReviewConfirmDetails", "ProjectConfirmExtension")" role="tab" aria-controls="formEreviewconfirm" aria-selected="true">Step III (Review/Confirm)</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Step-III : Project Extension Review and Confirm (Form-E) Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm("DropdownlistProjectExtensionReviewConfirmDetails", "ProjectConfirmExtension", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Select Project</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label">Select Project</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(m => m.ProjectRegistration_ID, new SelectList((System.Collections.IEnumerable)TempData["list"], "ProjectRegistration_ID", "Project_Name"), "Select Project", new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="BtnDrp" value="Proceed" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div @if (Session["Project_id"] != null) { @Html.Raw("style=''")       } else { @Html.Raw("style='display: none;'")       }>
                                @using (Html.BeginForm("Create_ProjectExtentionReviewConfirmDetails", "ProjectConfirmExtension", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    if (TempData["submitvalueFormEpartFLAG1"].ToString() == "ReviewConfirmZero" || TempData["submitvalueFormEpartFLAG2"].ToString() == "ReviewConfirmZero")
                                    {
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Project Extension Application (Form-E) - Review/ Confirm Details</legend>                                                    
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-2">
                                                                    @Html.Label("Application Status", htmlAttributes: new { @class = "control-label" })
                                                                </div>
                                                                <div class="col-md-9 alert alert-warning">
                                                                    Not Applicable, As per application details, the Form-E details - Pending or Nil.
                                                                </div>
                                                            </div>
                                                        </div>                                          
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    <input type="submit" value="I Agree" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    &nbsp;
                                                    @Html.ActionLink("Reset", "Create_ProjectExtentionReviewConfirmDetails", "ProjectConfirmExtension", null, new { @class = "btn btn-outline btn-primary" })
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Project Extension Application (Form-E) - Review/ Confirm Details</legend>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-1">
                                                                    @Html.DisplayName("S No")
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayName("Review/ Confirmation Title")
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DisplayName("Status")
                                                                </div>
                                                                <div class="col-md-5">
                                                                    @Html.DisplayName("Action Required")
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <hr />
                                                        </div>
                                                        <div class="row">
                                                            @{
                                                                int sno = 1;
                                                            }
                                                            <div class="form-group">
                                                                <div class="col-md-1">
                                                                    @Html.DisplayName(sno.ToString())
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.ActionLink("Project Extension Application", "Create_ProjectExtensionFormEDocument", "Project")
                                                                </div>
                                                                @if (TempData["statusFormEpart1"].ToString() == "Complete")
                                                                {
                                                                    if (Convert.ToString(TempData["submitvalueFormEpartFLAG1"]) != "ReviewConfirmComplete")
                                                                    {
                                                                        <div class="col-md-3 alert-warning">
                                                                            @TempData["statusFormEpart1"]<br />
                                                                            @TempData["messageFormEpart1"]
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="col-md-3 alert-success">
                                                                            @TempData["statusFormEpart1"]
                                                                            @if (Convert.ToInt32(TempData["ProjectExtensionFormIsdraftValue"]) == 1)
                                                                            {
                                                                                <a href="@Url.Action("Print_ProjectExtensionFormDetails", "ProjectExtensionPrintForm")" target="_blank">
                                                                                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                                                                </a>
                                                                            }
                                                                            <br />
                                                                            @TempData["messageFormEpart1"]
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="col-md-3 alert-danger">
                                                                        @TempData["statusFormEpart1"]<br />
                                                                        @TempData["messageFormEpart1"]
                                                                    </div>
                                                                }
                                                                <div class="col-md-5">
                                                                    @if (Convert.ToInt32(TempData["ProjectExtensionFormIsdraftValue"]) == 1)
                                                                    {
                                                                        <input type="submit" value="@TempData["submitvalueFormEpart1"]" formaction="ProjectExtentionFormAndDocuments" class="btn btn-outline btn-primary col-md-9" disabled="disabled" />

                                                                    }
                                                                    else
                                                                    {
                                                                        <input type="submit" value="@TempData["submitvalueFormEpart1"]" formaction="ProjectExtentionFormAndDocuments" class="btn btn-outline btn-primary col-md-9" />

                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            @{
                                                                sno = sno + 1;
                                                            }
                                                            <div class="form-group">
                                                                <div class="col-md-1">
                                                                    @Html.DisplayName(sno.ToString())
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.ActionLink("Payment Details", "Create_ProjectExtentionPaymentDetails", "Project")
                                                                </div>
                                                                @if (TempData["statusFormEpart2"].ToString() == "Complete")
                                                                {
                                                                    if (Convert.ToString(TempData["submitvalueFormEpartFLAG2"]) != "ReviewConfirmComplete")
                                                                    {
                                                                        <div class="col-md-3 alert-warning">
                                                                            @TempData["statusFormEpart2"]<br />
                                                                            @TempData["messageFormEpart2"]
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="col-md-3 alert-success">
                                                                            @TempData["statusFormEpart2"]
                                                                            @if (Convert.ToInt32(TempData["ProjectExtensionFormIsdraftValue"]) == 1)
                                                                            {
                                                                                <a href="@Url.Action("Print_ProjectExtensionPaymentDetails", "ProjectExtensionPrintForm")" target="_blank">
                                                                                    <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                                                                </a>
                                                                            }
                                                                            <br />
                                                                            @TempData["messageFormEpart2"]
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="col-md-3 alert-danger">
                                                                        @TempData["statusFormEpart2"]<br />
                                                                        @TempData["messageFormEpart2"]
                                                                    </div>
                                                                }
                                                                <div class="col-md-5">
                                                                    @if (Convert.ToInt32(TempData["ProjectExtensionFormIsdraftValue"]) == 1)
                                                                    {
                                                                        <input type="submit" value="@TempData["submitvalueFormEpart2"]" formaction="ProjectExtentionPayment" class="btn btn-outline btn-primary col-md-9" disabled="disabled" />
                                                                    }
                                                                    else
                                                                    {  <input type="submit" value="@TempData["submitvalueFormEpart2"]" formaction="ProjectExtentionPayment" class="btn btn-outline btn-primary col-md-9" />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Disclaimer</legend>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-12 text-justify">
                                                                    Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-12 text-left">
                                                                    @if (Convert.ToInt32(TempData["ProjectExtensionFormIsdraftValue"]) == 1)
                                                                    {
                                                                        <input type="submit" value="I Agree" class="btn btn-outline btn-primary" formaction="BtnAgree_ProjectExtensionForm" disabled="disabled" />

                                                                    }
                                                                    else
                                                                    {
                                                                        if (TempData["AgreeFormEconfirm"].ToString() == "Done")
                                                                        {
                                                                            <input type="submit" value="I Agree" class="btn btn-outline btn-primary" formaction="BtnAgree_ProjectExtensionForm" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="submit" value="I Agree" class="btn btn-outline btn-primary" formaction="BtnAgree_ProjectExtensionForm" disabled="disabled" />
                                                                        }
                                                                    }
                                                                    <div>
                                                                        @if (TempData["ProjectFormExtensionRegDiaryNumber_Name"] != null)
                                                                        {
                                                                            <b>@TempData["ProjectFormExtensionRegDiaryNumber_Name"].ToString()</b>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}