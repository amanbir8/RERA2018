@using CaptchaMvc.HtmlHelpers
@using CaptchaMvc;

@model CRUD.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

@*<h2>@ViewBag.Title.</h2>*@

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
   
@* START CODE *@
<div class="contianer-fluid" style="padding-right: 15px;    padding-left: 15px;    margin-right: auto;    margin-left: auto;">
    <div class="row" style="margin-right: -15px;    margin-left: -15px;">
        @*<div class="col-md-12">&nbsp;</div>*@
        @*<div class="col-md-12">&nbsp;</div>*@
        <div class="col-md-5"></div>

        <div class="col-md-2 text-center">  <a href="index.html"><img src="@Url.Content("~/images/Rera_Design3b_03.png")" alt="RERA logo" class="logo" title="REAL ESTATE REGULATORY AUTHORITY, PUNJAB"></a></div>

        <div class="col-md-5"></div>

    </div>
    <div class="row">
        <div class="col-md-12" style="">&nbsp;</div>
        <div class="col-md-3"></div>

        <div class="col-md-6 text-center" style="color: #fff; font-size: 15px;"> REAL ESTATE REGULATORY AUTHORITY, PUNJAB </div>

        <div class="col-md-3"></div>

    </div>

    <div class="row">
        <div class="col-md-12" style="">&nbsp;</div>
        <div class="col-md-4"></div>

        <div class="col-md-4 text-center main-login main-center" style="background-color: #fff; ">

            <div class="" style="padding: 0px;">
                <div class="row">
                    <div class="col-md-12  text-center" style="background-color: #7bb73f;   height: 54px;  color: #fff;   padding: 14px 0px 0px 0px;">Create New Account</div>
                </div>
                <div class="container">
                    <!--Selection User-->
                    <div class="row" style="margin-top: 15px; margin-bottom: 15px;">
                        <div class="col-12 text-left">Select User Type</div>
                    </div>

                    <!--Radio Selection Control-->
                    <div class="row text-left" style="font-size: 15px;">
                        <div class="col-md-12">
                            <label class="form-group">
                                @Html.RadioButton("UserRoles", "Promoter", true, new { @style = "padding:0px 10px 0px 10px;" }) Promoter
                                @Html.RadioButton("UserRoles", "RealEstateAgent", false, new { @style = "padding:0px 10px 0px 10px;" }) Real Estate Agent
                                @Html.RadioButton("UserRoles", "Complainant", false, new { @style = "padding:0px 10px 0px 10px;" }) Complainant
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <!--Registration Controls-->
                        <div class="col-md-12">
                            <div class="login-form-1">                              
                                    <div class="main-login-form">
                                        <div class="login-group">
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.UserName) })
                                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.Email) })
                                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.Password) })
                                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = Html.DisplayNameFor(m => m.ConfirmPassword) })
                                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        </div>
                        <!--CAPTCHA INPUT-->
                        <div class="col-md-12 text-left">
                            @Html.Captcha("Refresh?", "", 5, "The Captcha field is required.", true)
                            <br />                            
                        </div>                       

                        <div class="col-md-12">
                            @Html.ValidationSummary("", new { @class = "text-danger" })
                            <input type="submit" class="btn btn-lg btn-block button_custom" value="Create user" />
                        </div>

                        <div class="col-md-12 text-center" style="margin-top: 10px;">
                            <ul class="list-inline copyright">
                                <li class="list-inline-item">
                                    @(Html.ActionLink("Forgot Password", "ForgotPassword", new { id = 1 }, new { @style = "color: #c86c49;" }))
                                </li>
                                <li class="list-inline-item">|</li>
                                <li class="list-inline-item">
                                    @(Html.ActionLink("Sign in", "Login", new { id = 1 }, new { @style = "color: #c86c49;" }))
                                </li>
                            </ul>
                        </div>                     
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4"></div>
    </div>
    <div class="row " style="margin-top: 10px;">
        <div class="text-md-center col-md-12">
            <ul class="list-inline copyright" style="color: #fff; font-size: 11px;">
                <li class="list-inline-item">&copy; @DateTime.Now.Year RERA Punjab. All Rights Reserved</li>
                <li class="list-inline-item">|</li>
                <li class="list-inline-item">Designed and Developed by C-DAC Mohali</li>
            </ul>
        </div>
    </div>
</div>
@* END CODE *@
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
