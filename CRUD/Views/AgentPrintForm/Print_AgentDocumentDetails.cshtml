@model CRUD.Models.AgentPrintForm.ClsPrp_Print_AgentDocuments

@{
    Layout = null;
}

<!DOCTYPE html>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                @if (Model.zapAgent_DiaryNumber != null)
                {
                        var varDate = System.DateTime.Now.Date;
                        <tr>
                            <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>
                            <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                        </tr>
                        <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Application Form (Agent Document(s) Details)")</b></td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr>
                            <td width="25%">@Html.DisplayName("Diary Number")</td>
                            <td width="35%">@Html.DisplayFor(model => model.zapAgent_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(model => model.zapAgentName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(model => model.zapAgentName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.LabelFor(model => model.zapAgentLastModifiedOn, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(model => model.zapAgentLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                        </tr>

                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Real Estate Agent Document(s) Details")</h4></td></tr>
                    
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
            </table>
            @if (Model.AgentDocs != null)
            {
                <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                    <thead>
                        <tr>
                            <th width="5%">@Html.Label("S No")</th>
                            <th width="40%">@Html.Label("Document Name")</th>
                            <th width="15%">@Html.Label("Reference Number")</th>
                            <th>@Html.Label("Date")</th>
                            <th width="20%">@Html.Label("Remarks, If Any")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sno = 0;
                        }
                        @foreach (var item in Model.AgentDocs)
                        {
                            {
                                sno = sno + 1;
                            }
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>
                                <td>@Html.DisplayFor(modelItem => item.AgentDoc_InfoName)</td>
                                <td>@Html.DisplayFor(modelItem => item.AgentDoc_ReferenceNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.AgentDoc_IssueDate)</td>
                                <td style="text-align:justify;">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                            }
                            else
                            {
                                <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                                </table>
                            }
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">(Authorized Signatory)</td></tr>
            </table>
        </div>

        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
