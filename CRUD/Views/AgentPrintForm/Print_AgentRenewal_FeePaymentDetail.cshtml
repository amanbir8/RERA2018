@model CRUD.Models.AgentPrintForm.ClsPrp_Print_RenewalAgent_Payment
@{
    Layout = null;
}

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
            @if (Model.zapAgent_DiaryNumber != null)
            {
                var varDate = System.DateTime.Now.Date;
                    <tr>
                        <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>
                        <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                    </tr>
                    <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("[Form-J] Renewal of Registration Application for Real Estate Agent")</b></td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr>
                        <td width="25%">@Html.DisplayName("Diary Number")</td>
                        <td width="35%">@Html.DisplayFor(model => model.zapAgent_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td width="25%">@Html.LabelFor(model => model.zapAgent_RegistrationNumber, htmlAttributes: new { @class = "control-label" })</td>
                        <td width="32%">@Html.DisplayFor(model => model.zapAgent_RegistrationNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>@Html.LabelFor(model => model.zapAgentName, htmlAttributes: new { @class = "control-label" })</td>
                        <td>@Html.DisplayFor(model => model.zapAgentName, new { htmlAttributes = new { @class = "form-control" } })</td>
                        <td>@Html.LabelFor(model => model.zapAgentLastModifiedOn, htmlAttributes: new { @class = "control-label" })</td>
                        <td>@Html.DisplayFor(model => model.zapAgentLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                @if (Model.AgentRenewalPayment != null)
                {
                    int spayno = 0;
                    foreach (var item in Model.AgentRenewalPayment)
                    {
                        spayno = spayno + 1;
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("(" + spayno.ToString() + ") Agent Registration Payment Details")</h4></td></tr>

                        if (item.Payment_Mode != "Online Payment")
                        {
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.AgentPayment_TitleCode, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.AgentPayment_TitleName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Payment_Mode, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Payment_Mode, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Registration_Fee, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Registration_Fee, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Other_Fee, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Other_Fee, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Bank_Charges, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Bank_Charges, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Date_of_Payment_RegistrationFee, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Date_of_Payment_RegistrationFee, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Bank_Name, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Bank_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Branch_Name, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Branch_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.DD_BankersCheque_Number, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.DD_BankersCheque_Number, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.DD_BankersCheque_Amount, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.DD_BankersCheque_Amount, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>                        

                            <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                            <tr><td colspan="4"><h4>@Html.DisplayName("Scan copy of DD/ Bankers Cheque")</h4></td></tr>
                            <tr>
                                <td colspan="4" style="text-align:left;">
                                    @{
                                        var StrPathImg1 = item.ImageDDorBankersCheque_FileName;
                                        var StrPathImg2 = item.ImageDDorBankersCheque_FilePath;
                                        var StrPathImg = StrPathImg2 + StrPathImg1;
                                    }
                                    <itext creationdate="@DateTime.Now.ToString()" producer="RazorPDF">
                                        <img height="200" width="500" style="border:1px solid;" src="@Context.Server.MapPath("~/" + StrPathImg)" />
                                    </itext>
                                </td>
                            </tr>
                        }
                        else if (item.Payment_Mode == "Online Payment")
                        {
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.AgentPayment_TitleCode, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.AgentPayment_TitleName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Payment_Mode, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Payment_Mode, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>
                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Registration_Fee, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Registration_Fee, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <td colspan="2">@Html.LabelFor(modelitem => item.Other_Fee, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => item.Other_Fee, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>                            

                            <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                            <tr><td colspan="4"><h4>@Html.DisplayName("Particulars of Online Payment (in rupees) Details")</h4></td></tr>

                            if (Model.AgentRenewalPaymentWithTranasactions != null)
                            {
                                foreach (var itemTrn in Model.AgentRenewalPaymentWithTranasactions)
                                {
                                    if (item.RenewalAgent_Payment_ID == itemTrn.RelatedPayment_ID)
                                    {
                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_Transaction_ID, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_Transaction_ID, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>

                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_PayU_ID, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_PayU_ID, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_Date, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_Date, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>

                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.Agent_BriefSummary, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.Agent_BriefSummary, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_Product_Info, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_Product_Info, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>

                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_Amount, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_Amount, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>
                                        <tr>
                                            <td colspan="2">@Html.LabelFor(modelitem => itemTrn.PG_Payment_Type, htmlAttributes: new { @class = "control-label" })</td>
                                            <td colspan="2" style="text-align:justify;">@Html.DisplayFor(modelitem => itemTrn.PG_Payment_Type, new { htmlAttributes = new { @class = "form-control" } })</td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                }
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">(Authorized Signatory)</td></tr>
            </table>
        </div>
    </div>
</div>



