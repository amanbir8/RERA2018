@model CRUD.Models.MIS.ClsprpMIS_EpayProjectRegistration
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<script src="@Url.Content("~/Scripts/moment.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]]
        });

        $('#btnExportToExcel').click(function () {
            window.location = BASE_URL + 'ExportToExcel/epayFeeExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        var vcheckrangevaluedatemode = $("input[name='Application_SearchRangeFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").attr("style", "display:block");
            $("#rowDateFilterYY").attr("style", "display:none");
        }
        else if (vcheckrangevaluedatemode == '2') {
            $("#rowDateFilterDD").attr("style", "display:none");
            $("#rowDateFilterYY").attr("style", "display:block");
        }


        $(document).on('click', '.radio-applicationrangevaluedate', function (e) {
            if (this.value == '1') {
                $("#rowDateFilterDD").attr("style", "display:block");
                $("#rowDateFilterYY").attr("style", "display:none");
            }
            else if (this.value == '2') {
                $("#rowDateFilterDD").attr("style", "display:none");
                $("#rowDateFilterYY").attr("style", "display:block");
            }
        });
    });
</script>
<script>
    $(function () {

        $("#Application_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#Application_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#Application_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#Application_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#Application_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#Application_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>
<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>
<style>
    .nav-tabs > li.active > a {
        border-top: 2px solid #7bb73f;
    }

    .nav-tabs > li > a {
        background-color: #eee;
        color: #333;
    }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Payment Report : List of Project Payment(s)/ Transaction(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link" id="regfee-tab" href="@Url.Action("Display_ProjectPaymentMIS", "ExportToExcel")" role="tab" aria-controls="home" aria-selected="true">Registration Payments</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="extnfee-tab" href="@Url.Action("Display_ProjectExtensionPaymentMIS", "ExportToExcel")" role="tab" aria-controls="formM" aria-selected="false">Extension of Registration Payments</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="addfee-tab" href="@Url.Action("Display_ProjectAdditionalPaymentMIS", "ExportToExcel")" role="tab" aria-controls="formN" aria-selected="false">Additional Payments</a>
                </li>
                <li class="nav-item ">
                    <a class="nav-link" id="miscfee-tab" href="@Url.Action("Display_ProjectMiscPaymentMIS", "ExportToExcel")" role="tab" aria-controls="formN" aria-selected="false">Miscellaneous Payments</a>
                </li>
                <li class="nav-item active">
                    <a class="nav-link active" id="epay-tab" href="@Url.Action("Display_ePayProjectPaymentMIS", "ExportToExcel")" role="tab" aria-controls="formN" aria-selected="false">ePay Payments</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of ePay Project Payment(s)/ Transaction(s) Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("Display_ePayProjectPaymentMIS", "ExportToExcel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "PaymentProjectMiscMIS" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Transactional Options</legend>

                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Search For</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "503", new { id = "chkPenaltyFee", @class = "radio-applicationdatevalue", @checked = "checked" }) Penalty Fee
                                                    @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "504", new { id = "chkServiceFee", @class = "radio-applicationdatevalue" }) Services Fee
                                                    @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "505", new { id = "chkOthersFee", @class = "radio-applicationdatevalue" }) Others Fee
                                                </label>
                                                @Html.ValidationMessageFor(model => model.Application_SearchOptionFlag, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowDateFilter">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Entry Date Type</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.Application_SearchRangeFlag, "1", new { id = "chkDatefromto", @class = "radio-applicationrangevaluedate", @checked = "checked" }) From-Date/To-Date
                                                    @Html.RadioButtonFor(model => model.Application_SearchRangeFlag, "2", new { id = "chkDateMonth", @class = "radio-applicationrangevaluedate" }) Month/Year
                                                </label>
                                                @Html.ValidationMessageFor(model => model.Application_SearchRangeFlag, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowDateFilterDD">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.Application_FromDate, htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.Application_FromDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @onfocus = "this.value=''" } })
                                                @Html.ValidationMessageFor(model => model.Application_FromDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.Application_ToDate, htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.Application_ToDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @onfocus = "this.value=''" } })
                                                @Html.ValidationMessageFor(model => model.Application_ToDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                <input type="submit" id="ViewDetailDD" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowDateFilterYY">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.EventMonth, htmlAttributes: new { @class = "control-label mand" })
                                                @{
                                                    var listItemsEventMonth = new List<SelectListItem>
                                                                                                                            {
                                                                                                                                new SelectListItem {  Text = "--Select--" , Value="0"  },
                                                                                                                                new SelectListItem {  Text = "January" , Value="1"  },
                                                                                                                                new SelectListItem {  Text = "February" , Value="2"  },
                                                                                                                                new SelectListItem {  Text = "March" , Value="3"  },
                                                                                                                                new SelectListItem {  Text = "April" , Value="4"  },
                                                                                                                                new SelectListItem {  Text = "May" , Value="5"  },
                                                                                                                                new SelectListItem {  Text = "June" , Value="6"  },
                                                                                                                                new SelectListItem {  Text = "July" , Value="7"  },
                                                                                                                                new SelectListItem {  Text = "August" , Value="8"  },
                                                                                                                                new SelectListItem {  Text = "September" , Value="9"  },
                                                                                                                                new SelectListItem {  Text = "October" , Value="10"  },
                                                                                                                                new SelectListItem {  Text = "November" , Value="11"  },
                                                                                                                                new SelectListItem {  Text = "December" , Value="12"  },
                                                                                                                            };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.EventMonth, new SelectList(listItemsEventMonth, "Value", "Text"), new { @id = "drpEventMonth", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.EventMonth, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.EventYear, htmlAttributes: new { @class = "control-label mand" })
                                                @{
                                                    var listItemsEventYear = new List<SelectListItem>
                                                                                                                            {
                                                                                                                                new SelectListItem {  Text = "--Select--" , Value="0"  },
                                                                                                                                new SelectListItem {  Text = "2016" , Value="2016"  },
                                                                                                                                new SelectListItem {  Text = "2017" , Value="2017"  },
                                                                                                                                new SelectListItem {  Text = "2018" , Value="2018"  },
                                                                                                                                new SelectListItem {  Text = "2019" , Value="2019"  },
                                                                                                                                new SelectListItem {  Text = "2020" , Value="2020"  },
                                                                                                                                new SelectListItem {  Text = "2021" , Value="2021"  },
                                                                                                                                new SelectListItem {  Text = "2022" , Value="2022"  },
                                                                                                                                new SelectListItem {  Text = "2023" , Value="2023"  },
                                                                                                                                new SelectListItem {  Text = "2024" , Value="2024"  },
                                                                                                                                new SelectListItem {  Text = "2025" , Value="2025"  },
                                                                                                                                new SelectListItem {  Text = "2026" , Value="2026"  },
                                                                                                                                new SelectListItem {  Text = "2027" , Value="2027"  },
                                                                                                                                new SelectListItem {  Text = "2028" , Value="2028"  },
                                                                                                                                new SelectListItem {  Text = "2029" , Value="2029"  },
                                                                                                                                new SelectListItem {  Text = "2030" , Value="2030"  },
                                                                                                                            };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.EventYear, new SelectList(listItemsEventYear, "Value", "Text"), new { @id = "drpEventYear", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.EventYear, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                <input type="submit" id="ViewDetailYY" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>

                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            @using (Html.BeginForm("epayFeeExportToExcel", "ExportToExcel"))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <span class="btn btn-outline btn-primary" id="btnExportToExcel">
                                                <i class="fa fa-download"></i>
                                                <span>Export To Excel</span>
                                            </span>
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Display_ePayProjectPaymentMIS", "ExportToExcel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            @*<th>@Html.DisplayNameFor(model => model.ProjectRegDiaryNumber_Name)</th>*@
                                            <th>@Html.DisplayName("Registration Number")</th>
                                            <th>@Html.DisplayName("Issue Date")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectAddress_DistrictName)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_PayU_ID)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Date)</th>
                                            <th>@Html.DisplayNameFor(model => model.PG_Amount)</th>
                                            <th>@Html.DisplayName("Payment Description")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                @*<td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)</td>*@
                                                @if (item.RERAnumberRegistration.ToString() == "NA")
                                                {
                                                    <td class="warning">@Html.DisplayName("--")</td>
                                                    <td class="warning">@Html.DisplayName("--")</td>
                                                    <td class="warning">@Html.DisplayName("--")</td>
                                                }
                                                else
                                                {
                                                    <td class="info">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                    <td class="info">@Html.DisplayFor(modelItem => item.RERAnumberIssueDate)</td>
                                                    <td class="info">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                }
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">
                                                    @Html.DisplayFor(modelItem => item.Project_Name)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID)
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.ProjectAddress_DistrictName)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_PayU_ID)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Date)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PG_Amount)</td>
                                                <td>@Html.DisplayFor(modelItem => item.PaymentReferenceName)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
