                                                @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "3", new { id = "chkPenalty", @class = "radio-applicationdatevalue" }) Penalty
                                                @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "4", new { id = "chkFee", @class = "radio-applicationdatevalue" }) Fee
                                                @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "5", new { id = "chkJudicialDeposit", @class = "radio-applicationdatevalue" }) Judicial Deposit
                                                @Html.RadioButtonFor(model => model.Application_SearchOptionFlag, "6", new { id = "chkCourt Fee", @class = "radio-applicationdatevalue" }) Court Fee
                                            </label>
                                            @Html.ValidationMessageFor(model => model.Application_SearchOptionFlag, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
