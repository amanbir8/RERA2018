                                                @Html.RadioButtonFor(model => model.Application_GroupOptionFlag, "3", new { id = "chkAgent", @class = "radio-applicationdatevalue" }) Agent
                                                @Html.RadioButtonFor(model => model.Application_GroupOptionFlag, "4", new { id = "chkcomplaint", @class = "radio-applicationdatevalue" }) complaint
                                            </label>
                                            @Html.ValidationMessageFor(model => model.Application_GroupOptionFlag, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

