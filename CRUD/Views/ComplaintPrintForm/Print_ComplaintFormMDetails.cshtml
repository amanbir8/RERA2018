                            <td>@Html.DisplayFor(modelitem => item.PG_Amount, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Fee Status")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_Status, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("Complaint Fee")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_Product_Info, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Payment Gateway")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_Payment_Gateway, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("Transaction ID")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_Transaction_ID, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Transaction Date")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_Date, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("PayU ID")</td>
                            <td>@Html.DisplayFor(modelitem => item.PG_PayU_ID, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Payment Ref Number")</td>
                            <td>@Html.DisplayFor(modelitem => item.PaymentComplaint_ID, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found [Fee Details].</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
                @{
                    int snumber = 0;
                    int pagelastnumber = 0;
                }
                @if (Model.prpComplaintFormM_Docs != null)
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4"><h4>@Html.DisplayName("(9) List of Enclosures [Specify the details of enclosures with the complaint]")</h4></td></tr>
                    foreach (var item in Model.prpComplaintFormM_Docs)
                    {
                        {
                            snumber = snumber + 1;
                            pagelastnumber = item.Doc_PageStartNumber + item.Doc_PageEndNumber - 1;
                        }
                        <tr>
                            <td>
                                @Html.DisplayName("(" + snumber.ToString() + ") ")
                                @Html.DisplayFor(modelitem => item.ComplaintDoc_InfoName, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ComplaintDoc_ReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Doc_PageStartNumber)
                                @Html.DisplayName(" (Pages ")
                                @Html.DisplayFor(modelItem => item.Doc_PageEndNumber)
                                @Html.DisplayName(" to ")
                                @Html.DisplayName(pagelastnumber.ToString())
                                @Html.DisplayName(" )")
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                            </td>
                        </tr>                        
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found [Enclosures /Document(s)].</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }                
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>                                 
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Verification</td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc; text-align:justify;">[I/We] ________________(name in full block letters) son / daughter of________________the complainant do hereby verify that the contents of paragraphs [1 to 9] are true to [my/our] personal knowledge and belief and that [I/We] have not suppressed any material fact(s).</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic;">Place:</td></tr>
                <tr><td colspan="4" style="font-style: italic;">Date:</td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">Signature of the complainant(s)</td></tr>
            </table>                                      
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->


