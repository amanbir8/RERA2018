<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]]
            //"order": [2, 'asc']
        });
       
        $('#btnAverageIndexExportToExcel').click(function () {
            window.location = BASE_URL + 'MISprojectToExcel/ExportProjectCheckListExtnRecordsFileTimeToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        var vcheckrangevaluedatemode = $("input[name='IsRangeValueDateInputFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").attr("style", "display:block");
            $("#rowDateFilterYY").attr("style", "display:none");
        }
        else if (vcheckrangevaluedatemode == '2') {
            $("#rowDateFilterDD").attr("style", "display:none");
            $("#rowDateFilterYY").attr("style", "display:block");
        }

        $(document).on('click', '.radio-applicationrangevaluedate', function (e) {
            if (this.value == '1') {
                $("#rowDateFilterDD").attr("style", "display:block");
                $("#rowDateFilterYY").attr("style", "display:none");
            }
            else if (this.value == '2') {
                $("#rowDateFilterDD").attr("style", "display:none");
                $("#rowDateFilterYY").attr("style", "display:block");                
            }
        });
    });
</script>
<script>
    $(function () {

        $("#InputEntry_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#InputEntry_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#InputEntry_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#InputEntry_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());

                var start = $("#InputEntry_FromDate").datepicker("getDate");
                var end = $("#InputEntry_ToDate").datepicker("getDate");
                var days = (end - start) / (1000 * 60 * 60 * 24);
                if (days > 90) {
                    alert('Please select upto 90 days Only!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                $("#InputEntry_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>

<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "POST",
            url: baseUrl + "MISprojectToExcel/GetPieChartProjectExtnActivityIndexLiveReportsActionTypeData",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawPieChartProjectAnalysisRecrods(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });
    });

    function drawPieChartProjectAnalysisRecrods(data) {
        var myPieChart = Highcharts.chart('lastactiontyperange-pie-chart-container', {
            chart: {
                plotBackgroundColor: null,
                plotBorderWidth: null,
                plotShadow: false,
                type: 'pie'
            },
            title: {
                text: ''
            },
            subtitle: {
                text: 'File Prepared Index/ Analysis (Search by Category)'
            },
            tooltip: {
                pointFormat: '{series.name} (%age): <b>{point.y:.1f}%</b> <br/>' +
                            'Number of Applications: <b>{point.projectaverageactivitynumber}</b>'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>: {point.y:.1f}%', //'<b>{point.name}</b>', //
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            },
            series: [{
                name: 'File Preprared Index',
                colorByPoint: true,
                data: data.LiveReportProjectRecordsPieChartsData
                //    [{
                //    name: 'Accepted',
                //    y: 21.41
                //}, {
                //    name: 'Not Accepted',
                //    y: 11.84
                //}, {
                //    name: 'Not Applicable',
                //    y: 19.85,
                //    sliced: true,
                //    selected: true
                //}, {
                //    name: 'Exempted Cases',
                //    y: 9.67
                //}, {
                //    name: 'Checklist Not Prepared',
                //    y: 14.18
                //}, {
                //    name: 'Other',
                //    y: 5.61
                //}]
            }]
        });
    }
</script>

