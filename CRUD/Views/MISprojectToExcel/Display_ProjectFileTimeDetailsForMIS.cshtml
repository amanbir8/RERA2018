<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [2]
            }]
        });
       
        $('#btnElementaryExportToExcel').click(function () {
            window.location = BASE_URL + 'MISprojectToExcel/ExportwithElementaryFileTimeToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', 'a#modalOpenerAddressButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectpromoterDetailsModal = $(document).find('#myModal');
            $(projectpromoterDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPromoterID').val());
            projectId = parseInt(projectId);
            promoterId = parseInt(promoterId);
            $.ajax({
                url: BASE_URL + 'MISprojectToExcel/ProjectQRcodeCertificateDetailsForRegisteredProjectsMIS',
                dataType: 'HTML',
                type: 'GET',
                data: { 'ProjectId': projectId, 'PromoterId': promoterId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectpromoterDetailsModal).find('.modal-body').html(response);
                    $(projectpromoterDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectpromoterDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectpromoterDetailsModal).modal('show');
        });

    });
</script>
<script>
    $(function () {

        $("#InputEntry_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#InputEntry_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#InputEntry_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#InputEntry_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#InputEntry_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>

<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');        

        var vcheckapplicationmode = $("input[name='IsApplicationModeFlag']:checked").val();
        vcheckapplicationmode = parseInt(vcheckapplicationmode);

        $.ajax({
            type: "POST",
            url: baseUrl + "MISprojectToExcel/GetSpiderChartProjectActivityIndexLiveReportsData",
            datatype: "Json",
            data: { IndexId: "0", ApplicationModeCode: vcheckapplicationmode },
            success: function (data) {               
                var series = {
                    arrTitle: new Array(),
                    arrCollection: new Array(),
                    arrProcessed: new Array()
                };                
                $.each(data.LiveReportProjectIndexSpiderChartsTitleData, function (key, val) {
                    series.arrTitle.push(val.name);
                });
                $.each(data.LiveReportProjectIndexSpiderChartsCollectionData, function (key, val) {
                    series.arrCollection.push(val.collectionvalue);
                });
                $.each(data.LiveReportProjectIndexSpiderChartsProcessedData, function (key, val) {
                    series.arrProcessed.push(val.processedvalue);
                });                
                drawSpiderWebChartProjectAnalysisRecrods(series);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });
    });

    function drawSpiderWebChartProjectAnalysisRecrods(series) {
        var myPieChart = Highcharts.chart('elementryindex-spiderweb-chart-container', {
            chart: {
                polar: true,
                type: 'line'
            },

            title: {
                text: 'Application Collection vs Processed',
                x: -80
            },

            pane: {
                size: '90%'
            },

            xAxis: {
                categories: series.arrTitle,
                tickmarkPlacement: 'on',
                lineWidth: 0
            },

            yAxis: {
                gridLineInterpolation: 'polygon',
                lineWidth: 0,
                min: 0
            },

            tooltip: {
                shared: true,
                pointFormat: '<span style="color:{series.color}">{series.name}: <b>{point.y:,.0f}</b><br/>'
            },

            legend: {
                align: 'right',
                verticalAlign: 'middle'
            },

            series: [{
                name: 'Application Collected',
                data: series.arrCollection,
                pointPlacement: 'on'
            }, {
                name: 'Actual Processed',
                data: series.arrProcessed,
                pointPlacement: 'on'
            }],

            responsive: {
                rules: [{
                    condition: {
                        maxWidth: 500
                    },
                    chartOptions: {
                        legend: {
                            align: 'center',
                            verticalAlign: 'bottom'
                        },
                        pane: {
                            size: '70%'
                        }
                    }
                }]
            }

        });

    }
</script>

