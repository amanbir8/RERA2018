</style>
<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "POST",
            url: baseUrl + "MISprojectToExcel/GetPieChartProjectQuarterlyUpdatesLiveReportsData",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawPieChartQuarterlyUpdatesAnalysisRecrods(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });
    });

    function drawPieChartQuarterlyUpdatesAnalysisRecrods(data) {
        var myPieChart = Highcharts.chart('quarterlyupdatecollectionindex-pie-chart-container', {
            chart: {
                plotBackgroundColor: null,
                plotBorderWidth: null,
                plotShadow: false,
                type: 'pie'
            },
            title: {
                text: ''
            },
            subtitle: {
                text: 'Quarterly Updates of Project Index/ Analysis (Search by Category)'
            },
            tooltip: {
                pointFormat: '{series.name} (%age): <b>{point.y:.1f}%</b> <br/>' +
                            'Number of Applications: <b>{point.projectaverageactivitynumber}</b>'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>: {point.y:.1f}%',
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            },
            series: [{
                name: 'Quarterly Update(s) Collection Index',
                colorByPoint: true,
                data: data.LiveReportQUpdateProjectRecordsPieChartsData
            }]
        });
    }
</script>

