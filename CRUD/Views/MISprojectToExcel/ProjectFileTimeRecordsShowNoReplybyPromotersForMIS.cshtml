@model CRUD.Models.MISprojectToExcel.Clsprp_MIS_ProjectAverageFileTimeNoReplyByPromoters

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="width: 100%;">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("S No")</th>
                        <th>@Html.DisplayNameFor(model => model.FromDate_EventAction_IdentifiedOn)</th>
                        <th>@Html.DisplayNameFor(model => model.ToDate_EventAction_IdentifiedOn)</th>
                        <th>@Html.DisplayNameFor(model => model.NoReplybyPromoters_Days)</th>                        
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 0;
                        int varNoReplyDays = 0;
                    }
                    @foreach (var item in Model.prpongoing)
                    {
                        {
                            sno = sno + 1;
                        }
                        <tr>
                            <td>@Html.DisplayName(sno.ToString())</td>
                            <td>@Html.DisplayFor(modelItem => item.FromDate_EventAction_IdentifiedOn)</td>
                            <td>@Html.DisplayFor(modelItem => item.ToDate_EventAction_IdentifiedOn)</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NoReplybyPromoters_Days)
                                @{
                                    varNoReplyDays = varNoReplyDays + Convert.ToInt32(item.NoReplybyPromoters_Days);
                                }
                            </td>                            
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3"></th>
                        <th>@Html.DisplayName(varNoReplyDays.ToString()) (in Days)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>