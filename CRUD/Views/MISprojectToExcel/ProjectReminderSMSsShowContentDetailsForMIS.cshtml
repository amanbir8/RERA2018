                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.SMS_TitleSubject, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.SMS_TitleSubject, new { htmlAttributes = new { @class = "form-control" } })
