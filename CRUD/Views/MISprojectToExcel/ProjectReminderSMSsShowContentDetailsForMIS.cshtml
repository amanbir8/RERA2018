                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Event_AggregateName, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.Event_AggregateName, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Event_IdentifiedOnDate, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.Event_IdentifiedOnDate, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>                                               
                    </fieldset>
                </div>
            </div>
        </div>     

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">SMS Reminder Details</legend>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.SMS_TitleSubject, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.SMS_TitleSubject, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
