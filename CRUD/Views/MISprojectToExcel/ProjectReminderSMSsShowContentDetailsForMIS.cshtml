@model CRUD.Models.MISprojectToExcel.ClsprpMIS_ProjectInCompleteRemindersSMSgateway

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">Project Details</legend>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Project_Name, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.Project_Name, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                                
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">                                
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Promoter_Name, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.Promoter_Name, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Project_DiaryNumber, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.Project_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.Project_Diary_ApplicationDate, htmlAttributes: new { @class = "control-label" })
