@model CRUD.Models.MISprojectToExcel.Clsprp_MIS_ProjectQRcodeCertificateDetails
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [2]
            }]
        });
       
        $('#btnExportToExcel').click(function () {
            window.location = BASE_URL + 'MISprojectToExcel/ExportwithQRcodeToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', 'a#modalOpenerAddressButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectpromoterDetailsModal = $(document).find('#myModal');
            $(projectpromoterDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPromoterID').val());
            projectId = parseInt(projectId);
            promoterId = parseInt(promoterId);
            $.ajax({
                url: BASE_URL + 'MISprojectToExcel/ProjectQRcodeCertificateDetailsForRegisteredProjectsMIS',
                dataType: 'HTML',
                type: 'GET',
                data: { 'ProjectId': projectId, 'PromoterId': promoterId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectpromoterDetailsModal).find('.modal-body').html(response);
                    $(projectpromoterDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectpromoterDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectpromoterDetailsModal).modal('show');
        });

    });
</script>
<script>
    $(function () {

        $("#frmfromdate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#frmtodate").datepicker("option", "minDate", dt);
            }
        });

        $("#frmtodate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#frmfromdate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#frmtodate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#frmfromdate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>
<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Project Report : Project's QR Code Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    
    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="profile-tab" href="@Url.Action("Display_ProjectQRcodeCertificateDetailsForRegisteredProjectsMIS", "MISprojectToExcel")" role="tab" aria-controls="profile" aria-selected="true">Projects In Public View</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="home-tab" href="@Url.Action("Display_ProjectQRcodeCertificateDetailsForOfflineProjectsMIS", "MISprojectToExcel")" role="tab" aria-controls="home" aria-selected="false">Pending Uploads Projects (Offline Registered)</a>
                </li>                
            </ul>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of QR Codes of Project for RERA registration certificate [Project's QR Code  In Public View] Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("Display_ProjectQRcodeCertificateDetailsForRegisteredProjectsMIS", "MISprojectToExcel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "ProjectCertificateQRcodeMIS" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Registration Issue Date</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">From Date</label>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" id="frmfromdate" onfocus="this.value=''" name="FromDate" class="form-control" autocomplete="off" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">To Date</label>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" id="frmtodate" name="ToDate" class="form-control" autocomplete="off" />
                                            </div>
                                            <div class="col-md-3">
                                                <input type="submit" id="ViewDetail" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>                            
                            @using (Html.BeginForm("ExportwithQRcodeToExcel", "MISprojectToExcel"))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <span class="btn btn-outline btn-primary" id="btnExportToExcel">
                                                <i class="fa fa-download"></i>
                                                <span>Export To Excel</span>                                                
                                            </span>
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Display_ProjectQRcodeCertificateDetailsForRegisteredProjectsMIS", "MISprojectToExcel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }


                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_DiaryNumber)</th>
                                            <th>@Html.DisplayNameFor(model => model.QRcodeImage_A)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>                                            
                                            <th style="width:15%;">@Html.DisplayNameFor(model => model.RERAnumberRegistration)</th>
                                            <th>@Html.DisplayNameFor(model => model.RERAnumberIssueDate)</th>
                                            <th>@Html.DisplayNameFor(model => model.RERAnumberRegUptoDate)</th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.Project_DiaryNumber)">
                                                    @Html.DisplayFor(modelItem => item.Project_DiaryNumber)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterID" })
                                                </td>
                                                <td style="align-content:center;">
                                                    <a id="modalOpenerAddressButton" href="javascript:void(0);" title="View or scan QR Code">
                                                        <i class="fa fa-qrcode" aria-hidden="true"></i>
                                                        @*<img width="20" height="20" src="~/images/RERApunjabQRcode.jpg" title="Click to view or scan QR Code" />*@
                                                        @*<img width="100" height="100" src="@Url.Action("GenerateQrCode", "MISrealestateagentToExcel", new { qrcodestring = (item.Agent_DiaryNumber + " " + item.Agent_Organization_Name) })" />*@
                                                    </a>
                                                </td>
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">
                                                    @Html.DisplayFor(modelItem => item.Project_Name)                                                    
                                                </td>                                                
                                                <td>@Html.DisplayFor(modelItem => item.Promoter_Name)</td>                                                
                                                <td style="width:15%;">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RERAnumberIssueDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Project's QR Code Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
