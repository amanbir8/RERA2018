<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]]
        });
       
        $('#btnExportToExcel').click(function () {
            window.location = BASE_URL + 'MISprojectToExcel/ExportwithDetailRecordsFileTimeToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', 'a#modalOpenerRecordsShowButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectpromoterDetailsModal = $(document).find('#myModal');
            $(projectpromoterDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId             
            var projectId = $.trim($(parentRow).find('input.hdnRelatedProjectID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnRelatedPromoterID').val());
            var applicationflagId = $.trim($(document).find('input.radio-projectregistration:checked').val());            
            projectId = parseInt(projectId);
            promoterId = parseInt(promoterId);
            applicationflagId = parseInt(applicationflagId);
            $.ajax({
                url: BASE_URL + 'MISprojectToExcel/ProjectFileTimeRecordsShowNoReplybyPromotersForMIS',
                dataType: 'HTML',
                type: 'GET',
                data: { 'ProjectId': projectId, 'PromoterId': promoterId, 'ApplicationFlagId': applicationflagId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectpromoterDetailsModal).find('.modal-body').html(response);
                    $(projectpromoterDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-eventactiontype').attr('data-eventactiontype-number'));
            var projectName = $.trim($(parentRow).find('td.project-eventactiontypename').attr('data-project-eventactiontypename'));
            $(projectpromoterDetailsModal).find('h4.modal-title').html('No Reply by Promoters Details - <a href="javascript:void(0);"></a>');
            $(projectpromoterDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectpromoterDetailsModal).modal('show');
        });

        var vcheckrangevaluedatemode = $("input[name='IsRangeValueDateInputFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").attr("style", "display:block");
            $("#rowDateFilterYY").attr("style", "display:none");
        }
        else if (vcheckrangevaluedatemode == '2') {
            $("#rowDateFilterDD").attr("style", "display:none");
            $("#rowDateFilterYY").attr("style", "display:block");
        }

        $(document).on('click', '.radio-applicationrangevaluedate', function (e) {
            if (this.value == '1') {
                $("#rowDateFilterDD").attr("style", "display:block");
                $("#rowDateFilterYY").attr("style", "display:none");
            }
            else if (this.value == '2') {
                $("#rowDateFilterDD").attr("style", "display:none");
                $("#rowDateFilterYY").attr("style", "display:block");
            }
        });

    });
</script>
<script>
    $(function () {

        $("#InputEntry_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#InputEntry_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#InputEntry_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#InputEntry_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);                
                dt.setDate(dt.getDate());

                var start = $("#InputEntry_FromDate").datepicker("getDate");
                var end = $("#InputEntry_ToDate").datepicker("getDate");
                var days = (end - start) / (1000 * 60 * 60 * 24);
                if (days>30) {
                    alert('Please select upto 30 days Only!');
                    $("#InputEntry_ToDate").val('');
                    return false;
                }
                $("#InputEntry_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>
<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "POST",
            url: baseUrl + "MISprojectToExcel/GetRotatelevelsChartProjectActivityIndexLiveReportsData",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {              
                drawRotatedLevelChartProjectAnalysisRecrods(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });        
    });
    
    function drawRotatedLevelChartProjectAnalysisRecrods(data) {        
        var myPieChart = Highcharts.chart('lastactiontyperange-rotated-level-container', {
            chart: {
                type: 'column'
            },
            title: {
                text: ''
            },
            subtitle: {
                text: 'File Prepared Index/ Analysis (In Days)'
            },
            xAxis: {
                type: 'category',
                labels: {
                    rotation: -45,
                    style: {
                        fontSize: '12px',
                        fontFamily: 'Verdana, sans-serif'                        
                    }
                }
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Number of Days'
                }
            },
            legend: {
                enabled: false
            },
            tooltip: {
                pointFormat: 'File Activity/Index: <b>{point.y:f} days</b>'
            },
            series: [{
                name: 'indexfilerecords',
                data: data.LiveReportProjectIndexRecordsRotatelevelsChartsData,                    
                dataLabels: {
                    enabled: true,                    
                    color: '#064576',                    
                    format: '{point.y:f}'                    
                }
            }]
        });

    }
</script>

