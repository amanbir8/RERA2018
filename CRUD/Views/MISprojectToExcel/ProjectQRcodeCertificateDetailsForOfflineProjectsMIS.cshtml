@model CRUD.Models.MISprojectToExcel.Clsprp_MIS_ProjectQRcodeOfflineCertificateDetails

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">Project Details</legend>                        
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_Name, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineProject_Name, new { htmlAttributes = new { @class = "form-control" } })
                                </div>  
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflinePromoter_Name, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflinePromoter_Name, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                              
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_TotalArea, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineProject_TotalArea, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.DisplayName(" sqrmtrs")
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_Type, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineProject_Type, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                                                                
                            </div>
                        </div>                        
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_Address, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.OfflineProject_Address, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                                
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group">                                
                                <div class="col-md-3">
                                    <label class="control-label">Contact Details</label>
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.OfflineProject_ContactDetails, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>  
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_RERAregistrationNumber, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineProject_RERAregistrationNumber, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_BusinessPlaceDistrict, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineProject_BusinessPlaceDistrict, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div> 
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_RERAregistrationIssueDate, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @if (Model.OfflineProject_RERAregistrationIssueDate.Value.ToString("MM/dd/yyyy") == "01/01/0001")
                                    {
                                        @Html.DisplayName("--")
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(model => model.OfflineProject_RERAregistrationIssueDate, new { htmlAttributes = new { @class = "form-control" } })
                                    }                                   
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineProject_RERAregistrationValidUptoDate, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @if (Model.OfflineProject_RERAregistrationValidUptoDate.Value.ToString("MM/dd/yyyy") == "01/01/0001")
                                    {
                                        @Html.DisplayName("--")
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(model => model.OfflineProject_RERAregistrationValidUptoDate, new { htmlAttributes = new { @class = "form-control" } })
                                    }                                   
                                </div>
                            </div>
                        </div>                                         
                    </fieldset>
                </div>
            </div>
        </div>     

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">QR Code Image</legend> 
                        <div class="row" style="align-content:center;">
                            <div class="form-group">                                
                                <div class="col-md-12">
                                    <img width="350" height="350" src="@Url.Action("GenerateQrCodeByOfflineProjectID", "MISprojectToExcel", new { qrRERAnumber = Model.OfflineProject_RERAregistrationNumber, qrValidUptoDate = Model.OfflineProject_RERAregistrationValidUptoDate, qrProjectName = Model.OfflineProject_Name, qrProjectType = Model.OfflineProject_Type, qrPromoterName = Model.OfflinePromoter_Name, qrProjectAddressPlaceOfBussiness = Model.OfflineProject_Address })" />
                                </div>                               
                            </div>
                        </div>                        
                    </fieldset>
                </div>
            </div>
        </div>       

    </div>
</div>
