        $('#displayInProcessApplicationsupPop').text(result[1].value);
        $('#displayChecklistPreparedApplicationsupPop').text(result[2].value);
        $('#displayReviewChecklistApplicationsupPop').text(result[3].value);

        $('#displayApprovedApplicationsupPop').text(result[4].value);
        $('#displayRejectedApplicationsupPop').text(result[5].value);
        $('#displayWithdrawnApplicationsupPop').text(result[6].value);
        $('#displayOfflineRegdProjectsShiftedPublicViewupPop').text(result[7].value);
        $('#displayOfflineRegdProjectsPendingUploadsupPop').text(result[8].value);

        $('#displayPublicViewProjectsupPop').text(result[9].value);
        $('#displayPublicViewProjectsWebPageupPop').text(result[10].value);
