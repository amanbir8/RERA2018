<script>
    $(function () {

        var baseUrl = $('body').attr('data-base-url');

        (function (H) {
            //DATALABELS
            H.wrap(H.Series.prototype, 'drawDataLabels', function (proceed) {
                var css = this.chart.options.drilldown.activeDataLabelStyle;
                proceed.call(this);
            
                css.textDecoration = 'none !important';
                css.fontWeight = 'normal';
                css.cursor = 'default';
                css.color = 'black !important';
            
            
                H.each(this.points, function (point) {
               
                    if (point.drilldown && point.dataLabel) {
                        point.dataLabel
                            .css(css)
                            .on('click', function () {
                                return false;
                            });
                    }
                });
            });
        
            //For X-axis labels
            H.wrap(H.Point.prototype, 'init', function (proceed, series, options, x) {
                var point = proceed.call(this, series, options, x),
                    chart = series.chart,
                    tick = series.xAxis && series.xAxis.ticks[x],
                    tickLabel = tick && tick.label;
                console.log("series");
                console.log(series);

                if (point.drilldown) {

                    // Add the click event to the point label
                    H.addEvent(point, 'click', function () {
                        point.doDrilldown();
                    });

                    // Make axis labels clickable
                    if (tickLabel) {
                        if (!tickLabel._basicStyle) {
                            tickLabel._basicStyle = tickLabel.element.getAttribute('style');
                        }
                        tickLabel.addClass('highcharts-drilldown-axis-label').css({
                            'text-decoration': 'none !important',
                            'font-weight': 'normal !important',
                            'cursor': 'auto',
                            'color': 'black !important'

                        }).on('click', function () {
                            if (point.doDrilldown) {
                                return false;
                            }
                        });
                    }
                } else if (tickLabel && tickLabel._basicStyle) {
                }

                return point;
            });
        })(Highcharts);

        //For Projects DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetProjectLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawBarChartProjectsByAO(data);
                //console.log(data.LiveReportProjectsDrilldownData[0].data);
                displayListProjectsByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        //For Projects PieCharts DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetPieChartProjectLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawPieChartProjectsByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerProjectdetails);
    });

    function drawBarChartProjectsByAO(data) {
        var myChart = Highcharts.chart('projects-livereport-container', {
            chart: {
                type: 'column',
                events: {
                    drilldown: function (e) {                       
                        if (e.point.name == 'New Applications')
                        {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Application"
                                }
                            });
                        }
                        if (e.point.name == 'In-Process Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Last Action By RERA"
                                }
                            });
                        }
                        if (e.point.name == 'In-Complete Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Application"
                                }
                            });
                        }
                        if (e.point.name == 'ReSubmitted Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of ReSubmitted Application"
                                }
                            });
                        }
                        if (e.point.name == 'Due Project Extension') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Registration Valid upto"
                                }
                            });
                        }
                        if (e.point.name == 'Completion Certificate') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Completion"
                                }
                            });
                        }
                        if (e.point.name == 'Registered Projects') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Approval/ Registration"
                                }
                            });
                        }
                    },
                    drillup: function (e) {
                        this.xAxis[0].update({
                            title: false
                        });
                    }
                }
            },
            title: false,
            subtitle: false,
            xAxis: {
                type: 'category',
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }                
            },
            yAxis: {
                title: {
                    text: 'Number of Applications'
                },
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }

            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.f}',
                        style: {
                            color: 'black !important',
                            textDecoration: "none !important"
                        }
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.f}</b><br/>'
            },

            series: [
                {
                    name: "Projects",
                    colorByPoint: true,
                    data: data.LiveReportProjectsData
                }
            ],
            drilldown: {
                series: [
                    {
                        name: data.LiveReportProjectsDrilldownData[0].name,
                        id: data.LiveReportProjectsDrilldownData[0].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[0].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[1].name,
                        id: data.LiveReportProjectsDrilldownData[1].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[1].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[2].name,
                        id: data.LiveReportProjectsDrilldownData[2].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[2].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[3].name,
                        id: data.LiveReportProjectsDrilldownData[3].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[3].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[4].name,
                        id: data.LiveReportProjectsDrilldownData[4].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[4].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[5].name,
                        id: data.LiveReportProjectsDrilldownData[5].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[5].data)
                    },
                    {
                        name: data.LiveReportProjectsDrilldownData[6].name,
                        id: data.LiveReportProjectsDrilldownData[6].id,
                        data: JSON.parse(data.LiveReportProjectsDrilldownData[6].data)
                    }
                ]
            }
        });
    }

    function drawPieChartProjectsByAO(data) {
        var myPieChart = Highcharts.chart('zone-pie-chart-container', {
            chart: {
                type: 'variablepie'
            },
            //-- title: false,
            title: {
                text: ''
            },
            subtitle: {
                text: 'Note: The data shown in the chart excludes the pending uploads under offline registered projects.'
            },
            tooltip: {
                headerFormat: '',
                pointFormat: '<span style="color:{point.color}">\u25CF</span> <b> {point.name}</b><br/>' +
                    'Area (square km): <b>{point.y}</b><br/>' +
                    'Projects (projects per zone): <b>{point.z}</b>' 
                    //'Fee Amount (INR): <b>{point.amount}</b><br/>'
            },
            
            series: [{
                minPointSize: 40,
                innerSize: '45%',
                zMin: 0,
                name: 'projects-zone',
                data: data.LiveReportProjectsPieChartsData
            }]
        });
    }

