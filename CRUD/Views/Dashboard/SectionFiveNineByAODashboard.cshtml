<script>
    $(function () {

        var baseUrl = $('body').attr('data-base-url');

        (function (H) {
            //DATALABELS
            H.wrap(H.Series.prototype, 'drawDataLabels', function (proceed) {
                var css = this.chart.options.drilldown.activeDataLabelStyle;
                proceed.call(this);
            
                css.textDecoration = 'none !important';
                css.fontWeight = 'normal';
                css.cursor = 'default';
                css.color = 'black !important';
            
            
                H.each(this.points, function (point) {
               
                    if (point.drilldown && point.dataLabel) {
                        point.dataLabel
                            .css(css)
                            .on('click', function () {
                                return false;
                            });
                    }
                });
            });
        
            //For X-axis labels
            H.wrap(H.Point.prototype, 'init', function (proceed, series, options, x) {
                var point = proceed.call(this, series, options, x),
                    chart = series.chart,
                    tick = series.xAxis && series.xAxis.ticks[x],
                    tickLabel = tick && tick.label;
                console.log("series");
                console.log(series);

                if (point.drilldown) {

                    // Add the click event to the point label
                    H.addEvent(point, 'click', function () {
                        point.doDrilldown();
                    });

                    // Make axis labels clickable
                    if (tickLabel) {
                        if (!tickLabel._basicStyle) {
                            tickLabel._basicStyle = tickLabel.element.getAttribute('style');
                        }
                        tickLabel.addClass('highcharts-drilldown-axis-label').css({
                            'text-decoration': 'none !important',
                            'font-weight': 'normal !important',
                            'cursor': 'auto',
                            'color': 'black !important'

                        }).on('click', function () {
                            if (point.doDrilldown) {
                                return false;
                            }
                        });
                    }
                } else if (tickLabel && tickLabel._basicStyle) {
                }

                return point;
            });
        })(Highcharts);

        //For Section Five-Nine DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetSectionFiveNineLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawBarChartSectionFiveNinesByAO(data);
                displayListSectionFiveNineByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        //For Section Five-Nine PieCharts DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetPieChartSectionFiveNineLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawPieChartSectionFiveNinesByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerSectionFiveNinedetails);
    });

    function drawBarChartSectionFiveNinesByAO(data) {
        var myChart = Highcharts.chart('sectionfivenine-livereport-container', {
            chart: {
                type: 'column'
            },
            title: false,
            subtitle: false,
            xAxis: {
                type: 'category',
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }
            },
            yAxis: {
                title: {
                    text: 'Number of Complaints'
                },
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }

            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.f}',
                        style: {
                            color: 'black !important',
                            textDecoration: "none !important"
                        }
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.f}</b><br/>'
            },

            series: [
                {
                    name: "Notices (Section 59)",
                    colorByPoint: true,
                    data: data.LiveReportSectionFiveNinesData
                }
            ]
        });
    }

    function drawPieChartSectionFiveNinesByAO(data) {
        var myPieChart = Highcharts.chart('districtwithsectionfivenines-pie-chart-container', {
            chart: {
                plotBackgroundColor: null,
                plotBorderWidth: null,
                plotShadow: false,
                type: 'pie'
            },
            title: {
                text: ''
            },
            subtitle: {
                text: ''
            },
            tooltip: {
                pointFormat: '{series.name} (%age): <b>{point.percentage:.1f}%</b><br/>' +
                            'Number of Complaints/Notices (per district): <b>{point.sectionfivenines}</b>'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>', //'<b>{point.name}</b>: {point.percentage:.1f}%'
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            },
            series: [{
                name: 'Section Five-Nine',
                colorByPoint: true,
                data: data.LiveReportSectionFiveNinePieChartsData
            }]
        });
    }

