        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<script>
    $(document).ready(function () {
        $().ready(function () {

            window_width = $(window).width();

            if (window_width > 767) {
                //if ($('.fixed-plugin .dropdown').hasClass('show-dropdown')) {
                //    $('.fixed-plugin .dropdown').addClass('open');
                //}
                if ($('.fixed-plugin .dropdown').hasClass('show-dropdown')) {
                    $('.fixed-plugin .dropdown').removeClass("open");
                }
            }

            $('.fixed-plugin a').click(function (event) {
                if ($(this).hasClass('switch-trigger')) {                    
                    if (event.stopPropagation) {
                        event.stopPropagation();
                    } else if (window.event) {
                        window.event.cancelBubble = true;
                    }
                }
            });

            $('.fixed-plugin .badge').click(function () {
                var elem = $(this);
                var parentBadge = $(elem).attr('data-color');

                $(".fa-dot-circle-o").removeClass('icon-cog-purple');
                $(".fa-dot-circle-o").removeClass('icon-cog-azure');
                $(".fa-dot-circle-o").removeClass('icon-cog-green');
                $(".fa-dot-circle-o").removeClass('icon-cog-orange');
                $(".fa-dot-circle-o").removeClass('icon-cog-danger');
                $(".fa-dot-circle-o").removeClass('icon-cog-rose');

                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-purple');
                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-azure');
                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-green');
                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-orange');
                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-danger');
                $(".dashboard-filter-strong").removeClass('dashboard-filter-text-rose');

                if (parentBadge == "purple") {                    
                    $(".fa-dot-circle-o").addClass('icon-cog-purple');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-purple');
                }
                if (parentBadge == "azure") {                    
                    $(".fa-dot-circle-o").addClass('icon-cog-azure');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-azure');
                }
                if (parentBadge == "green") {
                    $(".fa-dot-circle-o").addClass('icon-cog-green');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-green');
                }
                if (parentBadge == "orange") {
                    $(".fa-dot-circle-o").addClass('icon-cog-orange');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-orange');
                }
                if (parentBadge == "danger") {
                    $(".fa-dot-circle-o").addClass('icon-cog-danger');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-danger');
                }
                if (parentBadge == "rose") {                   
                    $(".fa-dot-circle-o").addClass('icon-cog-rose');
                    $(".dashboard-filter-strong").addClass('dashboard-filter-text-rose');
                }
            });
        });
    });
</script>
