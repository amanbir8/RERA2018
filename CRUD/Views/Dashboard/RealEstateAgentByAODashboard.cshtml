<script>
    $(function () {

        var baseUrl = $('body').attr('data-base-url');

        (function (H) {
            //DATALABELS
            H.wrap(H.Series.prototype, 'drawDataLabels', function (proceed) {
                var css = this.chart.options.drilldown.activeDataLabelStyle;
                proceed.call(this);
            
                css.textDecoration = 'none !important';
                css.fontWeight = 'normal';
                css.cursor = 'default';
                css.color = 'black !important';
            
            
                H.each(this.points, function (point) {
               
                    if (point.drilldown && point.dataLabel) {
                        point.dataLabel
                            .css(css)
                            .on('click', function () {
                                return false;
                            });
                    }
                });
            });
        
            //For X-axis labels
            H.wrap(H.Point.prototype, 'init', function (proceed, series, options, x) {
                var point = proceed.call(this, series, options, x),
                    chart = series.chart,
                    tick = series.xAxis && series.xAxis.ticks[x],
                    tickLabel = tick && tick.label;
                console.log("series");
                console.log(series);

                if (point.drilldown) {

                    // Add the click event to the point label
                    H.addEvent(point, 'click', function () {
                        point.doDrilldown();
                    });

                    // Make axis labels clickable
                    if (tickLabel) {
                        if (!tickLabel._basicStyle) {
                            tickLabel._basicStyle = tickLabel.element.getAttribute('style');
                        }
                        tickLabel.addClass('highcharts-drilldown-axis-label').css({
                            'text-decoration': 'none !important',
                            'font-weight': 'normal !important',
                            'cursor': 'auto',
                            'color': 'black !important'

                        }).on('click', function () {
                            if (point.doDrilldown) {
                                return false;
                            }
                        });
                    }
                } else if (tickLabel && tickLabel._basicStyle) {
                }

                return point;
            });
        })(Highcharts);

        //For Agents DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetRealEstateAgentLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                drawBarChartRealEstateAgentsByAO(data);
                //console.log(data.LiveReportProjectsDrilldownData[0].data);
                displayListRealEstateAgentsByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        //For Agents PieCharts DATA        
        $.ajax({
            type: "POST",
            url: baseUrl + "Dashboard/GetPieChartRealEstateAgentLiveReportsDataByAOdetails",
            datatype: "Json",
            data: { IndexId: "0" },
            success: function (data) {
                //drawPieChartRealEstateAgentsByAO(data);
                drawPieChartDistrictwiseRealEstateAgentsByAO(data);
            },
            error: function (data) {
                alert('Bad Request! Invalid Data Details.');
            }
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRealEstateAgentdetails);
    });

    function drawBarChartRealEstateAgentsByAO(data) {
        var myChart = Highcharts.chart('realestateagents-livereport-container', {
            chart: {
                type: 'column',
                events: {
                    drilldown: function (e) {
                        if (e.point.name == 'New Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Application"
                                }
                            });
                        }
                        if (e.point.name == 'In-Process Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Last Action By RERA"
                                }
                            });
                        }
                        if (e.point.name == 'In-Complete Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Application"
                                }
                            });
                        }
                        if (e.point.name == 'ReSubmitted Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of ReSubmitted Application"
                                }
                            });
                        }
                        if (e.point.name == 'Due for Agents Renewal') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Registration Valid upto"
                                }
                            });
                        }
                        if (e.point.name == 'Renewal Applications') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Renewal"
                                }
                            });
                        }
                        if (e.point.name == 'Registered Agents') {
                            this.xAxis[0].update({
                                title: {
                                    text: "Date of Approval/ Registration"
                                }
                            });
                        }
                    },
                    drillup: function (e) {
                        this.xAxis[0].update({
                            title: false
                        });
                    }
                }
            },
            title: false,
            subtitle: false,
            xAxis: {
                type: 'category',
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }
            },
            yAxis: {
                title: {
                    text: 'Number of Applications'
                },
                labels: {
                    style: {
                        color: 'black !important',
                        textDecoration: "none !important"
                    }
                }

            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.f}',
                        style: {
                            color: 'black !important',
                            textDecoration: "none !important"
                        }
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.f}</b><br/>'
            },

            series: [
                {
                    name: "Realestate Agents",
                    colorByPoint: true,
                    data: data.LiveReportAgentsData
                }
            ],
            drilldown: {
                series: [
                    {
                        name: data.LiveReportAgentsDrilldownData[0].name,
                        id: data.LiveReportAgentsDrilldownData[0].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[0].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[1].name,
                        id: data.LiveReportAgentsDrilldownData[1].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[1].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[2].name,
                        id: data.LiveReportAgentsDrilldownData[2].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[2].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[3].name,
                        id: data.LiveReportAgentsDrilldownData[3].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[3].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[4].name,
                        id: data.LiveReportAgentsDrilldownData[4].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[4].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[5].name,
                        id: data.LiveReportAgentsDrilldownData[5].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[5].data)
                    },
                    {
                        name: data.LiveReportAgentsDrilldownData[6].name,
                        id: data.LiveReportAgentsDrilldownData[6].id,
                        data: JSON.parse(data.LiveReportAgentsDrilldownData[6].data)
                    }
                ]
            }
        });
    }

    function drawPieChartRealEstateAgentsByAO(data) {
        var myPieChart = Highcharts.chart('zone-pie-chart-container', {
            chart: {
                type: 'variablepie'
            },
            //-- title: false,
            title: {
                text: ''
            },
            subtitle: {
                text: 'Note: The data shown in the chart excludes the pending uploads under offline registered realestate agents.'
            },
            tooltip: {
                headerFormat: '',
                pointFormat: '<span style="color:{point.color}">\u25CF</span> <b> {point.name}</b><br/>' +
                    'Population Percentage (%): <b>{point.y}</b><br/>' +
                    'Real Estate Agents (per zone): <b>{point.z}</b>' 
            },
            
            series: [{
                minPointSize: 40,
                innerSize: '45%',
                zMin: 0,
                name: 'realestateagents-zone',
                data: data.LiveReportAgentsPieChartsData
            }]
        });
    }

    function drawPieChartDistrictwiseRealEstateAgentsByAO(data) {
        var myPieChart = Highcharts.chart('districtwithagents-pie-chart-container', {
            chart: {
                plotBackgroundColor: null,
                plotBorderWidth: null,
                plotShadow: false,
                type: 'pie'
            },
            title: {
                text: ''
            },
            subtitle: {
                text: 'Note: The data shown in the chart excludes the offline registered realestate agents records.'
            },
            tooltip: {
                pointFormat: '{series.name} (%age): <b>{point.percentage:.1f}%</b><br/>' +
                            'Number of Agents (per district): <b>{point.agents}</b>'
            },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>', //'<b>{point.name}</b>: {point.percentage:.1f}%'
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            },
            series: [{
                name: 'Real Estate Agents',
                colorByPoint: true,
                data: data.LiveReportAgentsPieChartsData                
            }]
        });       
    }

