@model CRUD.Models.PromoterPrint.Clsprp_JointPromoter_Print_ProfileForm

@{
    Layout = null;
}

<!DOCTYPE html>
<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                @if (Model.zipJointPromoter_DiaryNumber != null)
                {
                    var varDate = System.DateTime.Now.Date;
                    <tr>
                        <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>
                        <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                    </tr>
                    <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Application Form (Joint Promoter Registration - Individual Details)")</b></td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr>
                            <td width="25%">@Html.DisplayName("Diary Number")</td>
                            <td width="35%">@Html.DisplayFor(model => model.zipJointPromoter_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(model => model.zipJointPromoterName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(model => model.zipJointPromoterName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(model => model.zipPromoterName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(model => model.zipPromoterName, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.LabelFor(model => model.zipJointPromoterLastModifiedOn, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(model => model.zipJointPromoterLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                        </tr>

                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Joint Promoter Registration - Individual Details")</h4></td></tr>

                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
            </table>
            @if (Model.prpongoingTR != null)
            {
                <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                    @foreach (var item in Model.prpongoingTR)
                    {                                        
                        <tr>
                            <td style="width:25%;">@Html.LabelFor(modelItem => item.First_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.First_Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" ")
                                @Html.DisplayFor(modelItem => item.Middle_Name, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                            <td style="width:25%;">@Html.LabelFor(modelItem => item.Last_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.Last_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>                    
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.Fath_First_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Fath_First_Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.DisplayName(" ")
                                @Html.DisplayFor(modelItem => item.Fath_Middle_Name, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                            <td>@Html.LabelFor(modelItem => item.Fath_Last_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.Fath_Last_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>                  
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.CoPromoter_PAN_Number, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.CoPromoter_PAN_Number, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.LabelFor(modelItem => item.CoPromoter_WebLink, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.CoPromoter_WebLink, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>                    
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.CoPromoter_Occupation, htmlAttributes: new { @class = "control-label" })</td>
                            <td colspan="3" style="text-align:justify;">@Html.DisplayFor(modelItem => item.CoPromoter_Occupation, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>

                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Address Details")</h4></td></tr>
                        <tr>
                            <td>@Html.DisplayName("Address Line 1")</td>
                            <td>@Html.DisplayFor(modelItem => item.Permanent_Address_Prm_Line1, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Address Line 2")</td>
                            <td>@Html.DisplayFor(modelItem => item.Permanent_Address_Prm_Line2, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("District & State")</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Permanent_Address_Prm_DistrictState_Name, new { htmlAttributes = new { @class = "form-control" } })                                    
                            </td>
                            <td>@Html.DisplayName("Pin Code")</td>
                            <td>@Html.DisplayFor(modelItem => item.Permanent_Address_Prm_Pin_Code, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>

                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Communication Address Details")</h4></td></tr>
                        <tr>
                            <td>@Html.DisplayName("Address Line 1")</td>
                            <td>@Html.DisplayFor(modelItem => item.Communication_AddressLine1, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.DisplayName("Address Line 2")</td>
                            <td>@Html.DisplayFor(modelItem => item.Communication_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.DisplayName("District & State")</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Communication_Address_DistrictState_Name, new { htmlAttributes = new { @class = "form-control" } })
                            </td>
                            <td>@Html.DisplayName("Pin Code")</td>
                            <td>@Html.DisplayFor(modelItem => item.Communication_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>

                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Authorized Person Details")</h4></td></tr>
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.AuthorizedPerson_Name, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.AuthorizedPerson_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td>@Html.LabelFor(modelItem => item.AuthorizedPerson_MobileNumber, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.AuthorizedPerson_MobileNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.AuthorizedPerson_EmailAddress, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.AuthorizedPerson_EmailAddress, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>


                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Past Experience Details")</h4></td></tr>
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.Past_Litigations_InNumber, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.Past_Litigations_InNumber, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.DisplayName(" nos")</td>
                            <td>@Html.LabelFor(modelItem => item.Past_Experience_InYear, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(modelItem => item.Past_Experience_InYear, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.DisplayName(" years")</td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(modelItem => item.IsOrganizationMembers, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @if (item.IsOrganizationMembers == "Y")
                                {
                                    @Html.DisplayName("Yes")
                                }
                                else
                                {
                                    @Html.DisplayName("No")
                                }
                            </td>
                            <td>@Html.LabelFor(modelItem => item.IsOrganizationParent_Entity, htmlAttributes: new { @class = "control-label" })</td>
                            <td>
                                @if (item.IsOrganizationParent_Entity == "Y")
                                {
                                    @Html.DisplayName("Yes")
                                }
                                else
                                {
                                    @Html.DisplayName("No")
                                }
                            </td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                </table>
            }
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Disclaimer: [I/We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.</td></tr>
                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                <tr><td colspan="4" style="text-align:right; font-style: italic; font-size:medium;">(Authorized Signatory)</td></tr>
            </table>
        </div>
        <!-- /.col-lg-12 -->
    </div>
</div>

