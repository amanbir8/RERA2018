<script type="text/javascript">
    function Get_ProjectAgentAllottee_Name() {        
        var checkregdproject = $("input[name='D_column']:checked").val();
        if (checkregdproject == 'registeredproject') {

            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "GET",
                url: baseUrl + "Complaint/GetProjectRealestateAgentAllotteeNameFromMN",
                datatype: "Json",
                data: { ReraID: $('#RelatesComplaint_ProjectAgent_RERA_RegNumber').val(), ReraType: $("input[name='RelatesComplaint_ComplaintAgainstType']:checked").val() },
                success: function (data) {
                    if (data.length > 0) {
                        $.each(data, function (index, value) {
                            $('#RelatesComplaint_ProjectAgent_Name').val(value.ProjectName);
                            //$('#RelatesComplaint_ProjectAgent_Name').attr('readonly', true);
                        });
                    }
                    else {
                        swal('Warning!', 'Invalid RERA Number OR Invalid field for Complaint Against', 'warning');
                        $('#RelatesComplaint_ProjectAgent_RERA_RegNumber').val("");
                        $('#RelatesComplaint_ProjectAgent_Name').val("");
                        $("#RelatesComplaint_ProjectAgent_RERA_RegNumber").focus();
                    }
                }
            });

        }
        else if (this.value == 'unregisteredproject') {
            $('#RelatesComplaint_ProjectAgent_RERA_RegNumber').val("Un-Registered Project");
            $("#RelatesComplaint_ProjectAgent_RERA_RegNumber").attr('readonly', true);
        }        
    }
</script>
