                                                                                                <div class="form-group">
                                                                                                    <fieldset class="col-md-12">
                                                                                                        <legend class="my">                                                                                                            
                                                                                                            @Html.DisplayName("(" + snoFactsCaseDocs.ToString() + ")") Facts of the Case
