                                                                                                                <div id="progressbar" style="position: relative; display: none">
                                                                                                                    <span style="position: absolute; left: 35%; top: 20%" id="progressBar-label">
                                                                                                                        UPLOADING ...
                                                                                                                    </span>
                                                                                                                </div>
                                                                                                            </div>
                                                                                                        </div>
