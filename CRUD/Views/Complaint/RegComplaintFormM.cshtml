                                                                                                        <div class="form-group">
                                                                                                            <div class="col-md-offset-2 col-md-6 alert alert-warning">
                                                                                                                <div id="saveFileUploadMessageName" class="info">HH</div>
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </fieldset>
                                                                                </div>
                                                                            </div>
                                                                        </div>                                                                        
                                                                    </div>
                                                                }                                                                    
                                                            </div>                                                            
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row show" id="rowFactsCaseTextCount">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-9 text-right">
                                                            <span id="characterLeft_FactsCase_Statement"></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">(5.) Relief(s) Sought</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand"><b>A.</b> In view of the facts mentioned in paragraph 4 above, the complainant prays for the following relief(s). [Specify below the relief(s) claimed explaining the grounds of relief(s) and the legal provisions (if any) relied upon]</label>
                                                            <label class="control-label">(Max. 2000 characters)</label>
                                                        </div>
