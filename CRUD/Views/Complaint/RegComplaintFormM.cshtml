<script>
    function singleFileSelected() {
        var baseUrl = $('body').attr('data-base-url');
        $(".InfoContainer").fadeIn();
        var selectedFile = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];
        if (selectedFile) {
            var FileSize = 0;
            var imageType = /image.*/;
            if (selectedFile.size > 1048576) {
                FileSize = Math.round(selectedFile.size * 100 / 1048576) / 100 + " MB";
            }
            else if (selectedFile.size > 1024) {
                FileSize = Math.round(selectedFile.size * 100 / 1024) / 100 + " KB";
            }
            else {
                FileSize = selectedFile.size + " Bytes";
            }

            // here we will add the code of thumbnail preview of upload images
            $("#showFileInfoGrid").show();
            $("#FileName").text("Name : " + selectedFile.name);
            $("#FileType").text("Type : " + selectedFile.type);
            $("#FileSize").text("Size : " + FileSize);

            $("#showSaveFileUploadMessage").hide();

            if (selectedFile.type.match(imageType)) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = reader.result;
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "100";
                    img.width = "100";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(100);
                    $("#Imagecontainer").width(100);
                };
                reader.readAsDataURL(selectedFile);
            }
            if (selectedFile.type.match('application/pdf')) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = baseUrl + 'images/pdf.png';
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "35";
                    img.width = "35";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(35);
                    $("#Imagecontainer").width(35);
                };
                reader.readAsDataURL(selectedFile);
            }
        }
    }
</script>
<script type="text/javascript">
    $(function () {
        $("#btn_FileSubmit").click(function (e) {
            e.preventDefault();
            //debugger;
            var form = $('#ComplaintFormM')[0];
            var baseUrl = $('body').attr('data-base-url');
            var files = ($("#UploadedFile"))[0].files[0];

            if (typeof files === 'undefined') {
                $("#showSaveFileUploadMessage").show();
                $("#saveFileUploadMessageName").text("Note : Please Add files... to Upload!");
                return false;
            }
            if (files.size > 0) {
                var formData = new FormData(form);
                for (var i = 0; i < files.length; i++) {
                    formData.append(files[i].name, files[i]);
                }
                var progressbarLabel = $('body').find('#progressBar-label');
                var progressbarDiv = $('body').find('#progressbar');
                                
                $.ajax({
                    url: baseUrl + 'Complaint/FactsCase_FormM_DocumentUpload',
                    method: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        if (data.statusCode == 101)
                        {
                            progressbarLabel.text('COMPLETE');
                            progressbarDiv.fadeOut(2000);
                            $(".InfoContainer").fadeOut(2000);
                            $("#showFileInfo").fadeOut(2500);
                            $("#showfile-note-message").fadeOut(2500);
                            $("#showUploadedFileAction").fadeIn(2500);
                        }
                        else
                        {
                            progressbarLabel.text('Bad Request! Upload Failed');
                            progressbarDiv.fadeOut(2000);
                            $("#showSaveFileUploadMessage").show();
                            $("#saveFileUploadMessageName").text("Note : " + data.status);
                        }
                    },
                    failure: function(data) {
                        alert('Bad Request! Upload Failed');
                    },
                    error: function (err) {
                        //alert(err.message);
                        alert('Bad Request! Upload Failed');
                    }
                });

                progressbarLabel.text('UPLOADING ...');
                progressbarDiv.progressbar({
                    value: false
                }).fadeIn(500);

                $("#showSaveFileUploadMessage").hide();
            }
            //start-upload :: remove add-more-files 
            $.trim($(document).find('#rowFactsCaseAddmoreDocs').removeClass('show').addClass('hide'));
            //start-upload :: remove uploaded-files            
            $.trim($(document).find('#rowFactsCaseRecordedDocs').removeClass('show').addClass('hide'));
            return false;
        });
    });
</script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.display-factscase-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var complaintDetailsModal = $(document).find('#myFormMmodal');
            $(complaintDetailsModal).find('.modal-body').html('');
            var factscaseId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-code'));
            var profileId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-profile'));
            var complaintMId = $.trim($(document).find('.display-factscase-document').attr('data-factscase-formcode'));
            factscaseId = parseInt(factscaseId);
            profileId = parseInt(profileId);
            complaintMId = parseInt(complaintMId);
            $.ajax({
                url: BASE_URL + 'Complaint/ComplaintFormMFactsCaseFileDetail',
                dataType: 'HTML',
                type: 'GET',
                data: { 'factscaseID': factscaseId, 'profileID': profileId, 'complaintMID': complaintMId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(complaintDetailsModal).find('.modal-body').html(response);
                }
            });
            var complaintName = 'PDF file';//$.trim($(document).find('#zipProjectName').val());
            $(complaintDetailsModal).find('h4.modal-title').html('Facts of the Case - (' + complaintName + ')');
            $(complaintDetailsModal).modal('show');
        });

        $(document).on('click', 'a.delete-factscase-document', function (e) {
            e.preventDefault();
            var flagmove = confirm('Are you sure want to delete?');
            if (flagmove) {
                var elem = $(this);
                var factscaseId = $.trim($(document).find('.delete-factscase-document').attr('data-factscase-code'));
                var profileId = $.trim($(document).find('.delete-factscase-document').attr('data-factscase-profile'));
                var complaintMId = $.trim($(document).find('.delete-factscase-document').attr('data-factscase-formcode'));
                var factscaseIndexId = 0;
                factscaseIndexId = parseInt(factscaseIndexId);
                factscaseId = parseInt(factscaseId);
                profileId = parseInt(profileId);
                complaintMId = parseInt(complaintMId);
                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    url: BASE_URL + 'Complaint/Delete_FactsCase_FormM_Document',
                    type: 'GET',
                    data: { 'inFactscase_IndexID': factscaseIndexId, 'inFactscase_ID': factscaseId, 'inProfile_ID': profileId, 'inComplaintM_ID': complaintMId },
                    success: function (d) {
                        if (d) {
                            $.trim($(document).find('#rowFactsCaseRecordedDocs').fadeOut(800));
                            $.trim($(document).find('#rowFactsCaseAddmoreDocs').fadeIn(800));
                            $.trim($(document).find('#rowFactsCaseAddmoreDocs').removeClass('hide').addClass('show'));
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            }
        });

        $(document).on('click', 'a.download-factscase-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var factscaseId = $.trim($(document).find('.download-factscase-document').attr('data-factscase-code'));
            var filename = $.trim($(document).find('.download-factscase-document').attr('data-factscase-filename'));
            var filelink = $.trim($(document).find('.download-factscase-document').attr('data-factscase-file'));
            factscaseId = parseInt(factscaseId);
            $.ajax({
                type: "GET",                
                url: BASE_URL + 'Complaint/Download_FactsCase_FormM_File',
                cache: false,
                data: { 'factscaseID': factscaseId, 'filename': filename, 'filelink': filelink },
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    //Convert Base64 string to Byte Array.
                    var bytes = Base64ToBytes(data);
                    //Convert the Byte Data to BLOB object.
                    var blob = new Blob([bytes], { type: "application/octetstream" });

                    //Check the Browser type and download the File.
                    var isIE = false || !!document.documentMode;
                    //if (isIE) {
                        //    window.navigator.msSaveBlob(blob, fileName);
                    //} else {
                    //}
                    var url = window.URL || window.webkitURL;
                    var pdflink = url.createObjectURL(blob);
                    var downloadLink = $("<a></a>")
                        .attr("href", pdflink)
                        .attr("download", filename) //"file.pdf")
                        .css("display", "none");
                    $("body").append(downloadLink);
                    downloadLink[0].click();
                    downloadLink.remove();
                    url.revokeObjectURL(pdflink);
                }
            });            
        });        

        $(document).on('click', 'a.display-factscase-uploaded-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var complaintDetailsModal = $(document).find('#myFormMmodal');
            $(complaintDetailsModal).find('.modal-body').html('');
            var factscaseId = $.trim($(document).find('.display-factscase-uploaded-document').attr('data-factscase-code'));
            var profileId = $.trim($(document).find('.display-factscase-uploaded-document').attr('data-factscase-profile'));
            var complaintMId = $.trim($(document).find('.display-factscase-uploaded-document').attr('data-factscase-formcode'));
            factscaseId = parseInt(factscaseId);
            profileId = parseInt(profileId);
            complaintMId = parseInt(complaintMId);
            $.ajax({
                url: BASE_URL + 'Complaint/ComplaintFormMFactsCaseCurrentFileDetail',
                dataType: 'HTML',
                type: 'GET',
                data: { 'factscaseID': factscaseId, 'profileID': profileId, 'complaintMID': complaintMId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(complaintDetailsModal).find('.modal-body').html(response);
                }
            });
            var complaintName = 'PDF file';
            $(complaintDetailsModal).find('h4.modal-title').html('Facts of the Case - (' + complaintName + ')');
            $(complaintDetailsModal).modal('show');
        });

        $(document).on('click', 'a.download-factscase-uploaded-document', function (e) {
            e.preventDefault();
            var elem = $(this);
            var factscaseId = $.trim($(document).find('.download-factscase-uploaded-document').attr('data-factscase-code'));
            var filename = $.trim($(document).find('.download-factscase-uploaded-document').attr('data-factscase-filename'));
            var filelink = $.trim($(document).find('.download-factscase-uploaded-document').attr('data-factscase-file'));
            factscaseId = parseInt(factscaseId);
            $.ajax({
                type: "GET",
                url: BASE_URL + 'Complaint/Download_FactsCase_FormM_CurrentFile',
                cache: false,
                data: { 'factscaseID': factscaseId, 'filename': filename, 'filelink': filelink },
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    //Convert Base64 string to Byte Array.
                    var bytes = Base64ToBytes(data);
                    //Convert the Byte Data to BLOB object.
                    var blob = new Blob([bytes], { type: "application/octetstream" });

                    //Check the Browser type and download the File.
                    var isIE = false || !!document.documentMode;
                    //if (isIE) {
                        //    window.navigator.msSaveBlob(blob, fileName);
                    //} else {
                    //}
                    var url = window.URL || window.webkitURL;
                    var pdflink = url.createObjectURL(blob);
                    var downloadLink = $("<a></a>")
                        .attr("href", pdflink)
                        .attr("download", "factsofthecase_formM_file.pdf")
                        .css("display", "none");
                    $("body").append(downloadLink);
                    downloadLink[0].click();
                    downloadLink.remove();
                    url.revokeObjectURL(pdflink);
                }
            });
        });

        function Base64ToBytes(base64) {
            var s = window.atob(base64);
            var bytes = new Uint8Array(s.length);
            for (var i = 0; i < s.length; i++) {
                bytes[i] = s.charCodeAt(i);
            }
            return bytes;
        };
    });
</script>

