                                                            @Html.EditorFor(model => model.B_column, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.B_column, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
