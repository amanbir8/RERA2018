                                                            @Html.EditorFor(model => model.ReliefSought_TotalValueINR_FlatPlotApartment, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.ReliefSought_TotalValueINR_FlatPlotApartment, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label">Total Amount paid till date (INR)</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="In Numeric only.">
                                                            @Html.EditorFor(model => model.ReliefSought_TotalAmountPaid_tilldateINR, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.ReliefSought_TotalAmountPaid_tilldateINR, "", new { @class = "text-danger" })
                                                        </div>
