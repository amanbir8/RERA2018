                                                                                {
                                                                                    {
                                                                                        snoFactsCaseDocs = snoFactsCaseDocs + 1;
                                                                                        accordionAddmorefiles = "accordionAddmorefiles" + snoFactsCaseDocs.ToString();
                                                                                        btnAccordionAddmorefiles = "btnAccordionAddmorefiles" + snoFactsCaseDocs.ToString();
                                                                                        accordionAddmorefilesparent = "#accordionAddmorefiles" + snoFactsCaseDocs.ToString();
                                                                                        collapseAddmorefilesparent = "#collapseAddmorefiles" + snoFactsCaseDocs.ToString();
                                                                                        collapseAddmorefiles = "collapseAddmorefiles" + snoFactsCaseDocs.ToString();
                                                                                    }
                                                                                    <div class="panel-group" id=@accordionAddmorefiles>
