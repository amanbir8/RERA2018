                                                                                                                    <input type="file" name="UploadedFile" id="UploadedFile" onchange="singleFileSelected()" />
                                                                                                                </span>
                                                                                                                @if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                                                                                {
                                                                                                                    <input type="submit" value="Start upload" class="btn btn-outline btn-primary" disabled="disabled" />
                                                                                                                }
                                                                                                                else
                                                                                                                {
                                                                                                                    if (Model.IsLock == 1)
                                                                                                                    {
                                                                                                                        <input type="submit" value="Start upload" class="btn btn-outline btn-primary" disabled="disabled" />
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <button class="btn btn-outline btn-primary" type="submit" value="submit" id="btn_FileSubmit">
                                                                                                                            <i class="glyphicon glyphicon-upload"></i>
                                                                                                                            <span>Start upload</span>
                                                                                                                        </button>
                                                                                                                    }
                                                                                                                }                                                                                                                
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                    <div class="row" id="showFileInfoGrid" style="display:none">
