                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label">Actual date of possession, If delivered</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Actual Date of Possession as per the documents attached, if applicable.">
                                                            @Html.EditorFor(model => model.ReliefSought_ActualPossessionDate_IfDelivered, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.ReliefSought_ActualPossessionDate_IfDelivered, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">Date of Allotment Letter</label>
                                                        </div>
