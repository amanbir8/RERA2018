                                                            @Html.TextAreaFor(m => m.ReliefSought_Statement, new
                                                            {
                                                                rows = "20",
                                                                style = "resize:none;width:400px;",
                                                                placeholder = Html.DisplayNameFor(m => m.ReliefSought_Statement),
                                                                @class = "form-control"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-9 text-right">
                                                            <span id="characterLeft_ReliefSought_Statement"></span>
                                                        </div>
                                                    </div>
                                                </div>
