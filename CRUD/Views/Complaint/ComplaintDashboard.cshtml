@model CRUD.Models.Complaint.ClsPrp_ComplaintFormM_DiaryNumberDashbaord

<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet" />
<!-- DataTables JavaScript -->
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
<!-- Custom Theme JavaScript -->
<script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>

<script>
    $(document).ready(function () {        
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 15,
            "lengthMenu": [[15, 30, 45, 60], [15, 30, 45, 60]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [8, 9]
            }]
        });

        $(document).on('click', 'a#modalOpenerPreHearingNoticeButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var FormM_Id = $.trim($(parentRow).find('input.hdnAgentID').val());
            var FormM_diaryNumber = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            FormM_Id = parseInt(FormM_Id);
            $.ajax({
                url: BASE_URL + 'Complaint/ComplaintPreHearingNoticeM',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormM_Id': FormM_Id, 'FormM_diaryNumber': FormM_diaryNumber },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Notice : ' + diaryNo + ' (' + agentName + ')');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });

    });
</script>
<script>
    $(document).ready(function () {
        var compBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.complainantdeskHomeButton', function (e) {
            e.preventDefault();
            window.location = compBASE_URL + 'Home/IndexComplainant';
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Complaint(s) : Form-M or Form-N</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->

    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }




       

    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="home-tab" href="@Url.Action("ComplaintDashboard", "Complaint")" role="tab" aria-controls="home" aria-selected="true">Complaint Form-M</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("ComplaintNDashboard", "Complaint")" role="tab" aria-controls="profile" aria-selected="false">Complaint Form-N</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("ComplaintExeDashboard", "ComplaintExecution")" role="tab" aria-controls="profile" aria-selected="false">Complaint Form-Execution</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Complaint Form-M : Status Summary Details
                    <span class="pull-right">
                        <a class="complainantdeskHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>                        
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.Complainant_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Complainant_MobileNumber)</th>
                                            <th>@Html.DisplayNameFor(model => model.RelatesComplaint_ComplaintAgainstType)</th>
                                            <th>@Html.DisplayNameFor(model => model.Respondent_Name)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.ComplaintRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayName("Status")</th>                                            
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Print")</th>                                            
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                        <tr class="odd gradeX">
                                            <td>@Html.DisplayName(sno.ToString())</td>
                                            <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.Complainant_Name)">@Html.DisplayFor(modelItem => item.Complainant_Name)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Complainant_MobileNumber)</td>
                                            <td>@Html.DisplayFor(modelItem => item.RelatesComplaint_ComplaintAgainstType)</td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Respondent_Name)
                                                @Html.HiddenFor(modelItem => item.FormM_RelatedComplaint_ID, new { @class = "hdnAgentID" })
                                            </td>
                                            <td class="agent-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)</td>
                                            @if (item.IsComplaintComplete.ToString() == "1" && item.IsDocumentsComplete.ToString() == "1" && item.IsPaymentComplete.ToString() == "1" && item.IsVerificationComplete.ToString() == "1")
                                            {
                                                if (item.EventAction_Type == "330007" || item.EventAction_Type == "330062")
                                                {
                                                    <td class="warning">
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                        @Html.DisplayName(" [Remarks, If Any : ")
                                                        @Html.DisplayFor(modelItem => item.EventRemarks_IfAny)
                                                        @Html.DisplayName("]")
                                                    </td>
                                                }
                                                else if (item.EventAction_Type == "330054")
                                                {
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                        @Html.DisplayName(" [Remarks, If Any : ")
                                                        @Html.DisplayFor(modelItem => item.EventRemarks_IfAny)
                                                        @Html.DisplayName("]")
                                                    </td>
                                                }
                                                else if (item.EventAction_Type == "330061" || item.EventAction_Type == "330058")
                                                {
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                        <a id="modalOpenerPreHearingNoticeButton" href="javascript:void(0);"> (View Notice) </a>
                                                    </td>
                                                }
                                                else if (item.EventAction_Type == "330059")
                                                {
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                        <a id="modalOpenerPreHearingNoticeButton" href="javascript:void(0);"> (View Notice to Complainant/s) </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td class="info">
                                                        @Html.DisplayFor(modelItem => item.EventAction_Aggregate)
                                                    </td>
                                                }
                                            }
                                            else if (item.IsComplaintComplete.ToString() == "1" && item.IsDocumentsComplete.ToString() == "1" && item.IsPaymentComplete.ToString() == "0" && item.IsVerificationComplete.ToString() == "0")
                                            {
                                                <td class="danger" style="width:12%;">
                                                    <span class="status-circle-green"><font class="status-count">1</font></span>
                                                    <span class="status-circle-green"><font class="status-count">2</font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span><br />
                                                    @Html.DisplayName("Step 3 and 4 of Form-M Pending")
                                                </td>
                                            }
                                            else if (item.IsComplaintComplete.ToString() == "1" && item.IsDocumentsComplete.ToString() == "1" && item.IsPaymentComplete.ToString() == "1" && item.IsVerificationComplete.ToString() == "0")
                                            {
                                                <td class="danger" style="width:12%;">
                                                    <span class="status-circle-green"><font class="status-count">1</font></span>
                                                    <span class="status-circle-green"><font class="status-count">2</font></span>
                                                    <span class="status-circle-green"><font class="status-count">3</font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span><br />
                                                    @Html.DisplayName("Step 4 of Form-M Pending")
                                                </td>
                                            }
                                            else /*(item.IsComplaintComplete.ToString() == "1") class="success" */
                                            {
                                                <td class="danger" style="width:12%;">
                                                    <span class="status-circle-green"><font class="status-count">1</font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span>
                                                    <span class="status-circle-grey"><font class="status-count"> </font></span><br />
                                                    @Html.DisplayName("Steps 2, 3 and 4 of Form-M Pending")
                                                </td>
                                            }
                                            <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>  @*/* item.EventAction_IdentifiedOn */*@
                                            <td class="center">
                                                @if (item.IsComplaintComplete.ToString() == "1" && item.IsDocumentsComplete.ToString() == "1" && item.IsPaymentComplete.ToString() == "1" && item.IsVerificationComplete.ToString() == "1")
                                                {
                                                    if (item.EventAction_Type != "330007")
                                                    {
                                                        <a href="@Url.Action("Print_ComplaintFormMDetails", "ComplaintPrintForm", new { FormMcode = item.FormM_RelatedComplaint_ID })" target="_blank">
                                                            <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                                        </a>
                                                        @*@Html.ActionLink("Print", "Print_ComplaintFormMDetails", "ComplaintPrintForm", new { FormMcode = item.FormM_RelatedComplaint_ID }, new { target = "_blank" })*@
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayName("--")
                                                    }
                                                }
                                                else
                                                {
                                                    @Html.DisplayName("--")
                                                }
                                            </td>
                                            <td class="center">
                                                @Html.ActionLink("View", "Details_RegComplaintFormM", new { zComplaintFormM_ID = item.FormM_RelatedComplaint_ID, zComplaintProfile_ID = item.Profile_ID })
                                                @Html.ActionLink("File Execution", "Create_RegExecutionForm","ComplaintExecution", new { zComplaintFormM_ID = item.FormM_RelatedComplaint_ID, zComplaintProfile_ID = item.Profile_ID },null)
                                            </td>
                                            
                                        </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>                                 
                        </div>
                    </div>
                    <!-- /.row (nested) -->
                </div>
                <!-- /.panel-body -->
            </div>
            <!-- /.panel -->
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>  
}



