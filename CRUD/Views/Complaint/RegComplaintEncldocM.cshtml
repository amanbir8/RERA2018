<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "Complaint/GetStatusRegdProjectandUnRegdProjectFromM",
            datatype: "Json",
            data: { ComplaintID: '0', FormType: 'FormM' },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (index, value) {
                        if (value.ComplaintProjectStatus == 'unregisteredproject') {
                            $("#rowUnRegdProjectDocs").attr("style", "display:block");
                            $("#rowEnclDocs").attr("style", "display:none");
                            $('#ComplaintDoc_InfoName').val("");
                            $('#displayUnRegdDocsMessage').text(value.ComplaintDocumentTrack);
                        }
                        else {
                            $("#rowUnRegdProjectDocs").attr("style", "display:none");
                            $("#rowEnclDocs").attr("style", "display:block");
                            $('#ComplaintDoc_InfoName').val("");
                            $("#ComplaintDoc_InfoName").attr('readonly', false);
                            $('#displayUnRegdDocsMessage').text("");
                        }
                    });
                }
                else {
                    $("#rowUnRegdProjectDocs").attr("style", "display:none");
                    $("#rowEnclDocs").attr("style", "display:block");
                    $('#ComplaintDoc_InfoName').val("");
                    $("#ComplaintDoc_InfoName").attr('readonly', false);
                    $('#displayUnRegdDocsMessage').text("");
                }
            }
        });


        $('#A_column').change(function () {
            var encldocValue = $('#A_column').val();
            if (encldocValue == 'OtherEnclosureDocs') {
                $("#rowEnclDocs").attr("style", "display:block");
                $('#ComplaintDoc_InfoName').val("");
                $("#ComplaintDoc_InfoName").attr('readonly', false);
            }
            else if (encldocValue == '') {
                $("#rowEnclDocs").attr("style", "display:none");
                $('#ComplaintDoc_InfoName').val("");
            }
            else {
                $("#rowEnclDocs").attr("style", "display:block");
                var encldocText = 'NA';
                if (encldocValue == 'DocumentCLU') {
                    encldocText = 'CLU Document';
                }
                else if (encldocValue == 'LicenseDevelopColony') {
                    encldocText = 'License to develop Colony';
                }
                else if (encldocValue == 'RegularizationCertificate') {
                    encldocText = 'Regularization Certificate';
                }
                else if (encldocValue == 'AgreementToSale') {
                    encldocText = 'Agreement to Sell';
                }
                else if (encldocValue == 'AllotmentLetter') {
                    encldocText = 'Allotment Letter';
                }
                else if (encldocValue == 'DocumentLOI') {
                    encldocText = 'LOI Document';
                }
                $('#ComplaintDoc_InfoName').val(encldocText);
                $("#ComplaintDoc_InfoName").attr('readonly', true);
            }
        });

    });
</script>

