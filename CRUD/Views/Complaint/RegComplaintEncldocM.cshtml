                                            }
                                        </div>
                                        <div class="col-md-12">                                        
                                            @if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                            {
                                                <input type="submit" value="Proceed" class="btn btn-outline btn-primary" disabled="disabled" />
