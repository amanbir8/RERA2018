                                                    <input type="submit" value="Proceed" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    @*@Html.ActionLink("Proceed", "RequestPaymentFormM", "ComplaintPayment", null, new { @class = "btn btn-primary", @disabled = "disabled" })*@
                                                }
                                                else
                                                {
                                                    <input type="submit" value="Proceed" class="btn btn-primary" />
                                                }
                                            }                                                                                   
                                            &nbsp;
                                            @Html.ActionLink("Back to List (View Enclosures/ Documents)", "RegComplaintEncldocM", "Complaint", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div> 
                            }
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Doc_SerialNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.ComplaintDoc_InfoName)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.ComplaintDoc_ReferenceNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Doc_PageStartNumber)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                            </th>                                           
                                            <th>
                                                @Html.Label("View")
                                            </th>
                                            <th>
                                                @Html.Label("Delete")
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int pagelastnumber = 0;
                                        }
                                        @foreach (var item in Model.prpFormM_Docs)
                                        {
                                            {
                                                pagelastnumber = item.Doc_PageStartNumber + item.Doc_PageEndNumber - 1;
                                            }
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_SerialNumber)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_InfoName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_ReferenceNumber)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_PageStartNumber)
                                                    @Html.DisplayName(" (Pages ")
                                                    @Html.DisplayFor(modelItem => item.Doc_PageEndNumber)
                                                    @Html.DisplayName(" to ")
                                                    @Html.DisplayName(pagelastnumber.ToString())
                                                    @Html.DisplayName(" )")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                </td>
                                                <td>
                                                    <a href="~/@Html.DisplayFor(modelItem => item.ComplaintDoc_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                </td>
                                                <td>
                                                    @if (item.IsLock != 1)
                                                    {
                                                        if (item.IsDraft == 0 || item.IsDraft == 4)
                                                        {
                                                            @Html.ActionLink(" ", "Delete_ComplaintEncldocMDocument", new { inComplaintFormM_DocIndexID = item.ListEnclDocument_IndexID, inComplaintFormM_DocID = item.ListEnclDocument_ID, inComplaintFormM_ID = item.ComplainantApplicant_RelatedComplaint_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-remove" })
                                                        }
                                                        else
                                                        {
                                                            @("--")
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @("--")
                                                    }                                                    
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                               
                        </div>                                                        
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
