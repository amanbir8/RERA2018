<script type="text/javascript">
    $(document).ready(function () {
        var dropdown = $('#ComplainantDropdown');

        $.ajax({
            url: '@Url.Action("GetComplainant", "Complaint")',
            type: 'GET',
            data: { complaintId: '@Session["ApplicationId"]' },
            dataType: 'json',
            success: function (data) {
                dropdown.empty();
                dropdown.append($('<option>').val('').text('-- Select Complainant --'));

                $.each(data, function (i, item) {
                    dropdown.append($('<option>').val(item.id).text(item.name));
                });
            },
            error: function () {
                alert("Failed to load complainants. Please try again.");
            }
        });

        dropdown.change(function () {
            var selected = $(this).find("option:selected");
            var Id = selected.val();
            var Name = selected.text();
            $("#SelectedComplainantName").val(selected.data("name"));
            $("#SelectedComplainantID").val(selected.val());
            console.log("Selected  ID:",Id);
            console.log("Selected  Name:",Name);
        });

    });
</script>


<script>
    function initializeAdvocateAutocomplete() {
        const $advocateInput = $(".input-advocateName");
        const $advocateIdInput = $("#SelectedAdvocateID");
        const $advocateDetails = $("#advocateDetails");

        $advocateInput.autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetAdvocates", "Complaint")',
                    type: "GET",
                    dataType: "json",
                    data: { term: request.term },
                    success: function (advocates) {
                        const suggestions = advocates.map(advocate => ({
                            label: advocate.name,
                            value: advocate.name,
                            id: advocate.id,
                            address: advocate.address || "",
                            email: advocate.email || "",
                            mobile: advocate.mobile || "",
                            otherMembers: (advocate.othermemb || "").split(",").filter(m => m.trim() !== "")
                        }));
                        response(suggestions);
                    },
                    error: function () {
                        alert("Error loading advocates. Please try again.");
                    }
                });
            },
            minLength: 1,
            select: function (event, selectedAdvocate) {
                updateAdvocateDetails(selectedAdvocate.item);
                return false;
            }
            //,
            //change: function (event, ui) {
            //    if (!ui.item) {
            //        $advocateInput.val("");
            //        $advocateIdInput.val("");
            //        $advocateDetails.hide();
            //    }
            //}
        });

        function updateAdvocateDetails(advocate) {
            $advocateIdInput.val(advocate.id);

            $advocateInput.val(advocate.value);

            $("#advAddress").text(advocate.address);
            $("#advEmail").text(advocate.email);
            $("#advMobile").text(advocate.mobile);

            const $otherMembersList = $("#advOtherList").empty();
            if (advocate.otherMembers && advocate.otherMembers.length > 0) {
                advocate.otherMembers.forEach(member => {
                    $otherMembersList.append($("<li>").text(member.trim()));
                });
            }

            $advocateDetails.show();
        }

        $advocateInput.on("input", function () {
            if (!$(this).val()) {
                $advocateIdInput.val("");
                $advocateDetails.hide();
            }
        });
        $("form").on("submit", function () {
            if (!$("#SelectedAdvocateID").val()) {
                swal({
                    title: "Warning",
                    text: "Please select a valid advocate from the list.",
                    type: "warning"
                });
                return false;
            }
        });

    }

    $(document).ready(function () {
        initializeAdvocateAutocomplete();
    });

</script>


<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
