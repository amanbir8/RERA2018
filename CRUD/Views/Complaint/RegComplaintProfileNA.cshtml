
<script>
    $(document).ready(function () {
        var compBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.complainantdeskHomeButton', function (e) {
            e.preventDefault();
            window.location = compBASE_URL + 'Home/IndexComplainant';
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">My Profile</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Complainant Profile Registration Details
                    <span class="pull-right">
                        <a class="complainantdeskHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()                             
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Invalid User Profile Registration</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-2">
                                                            @Html.Label("Note :", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-9 alert alert-warning">
                                                            Please submit user profile before submission of Form-M or Form-N details.
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        @Html.ActionLink("Reset", "RegComplaintProfile", "Complaint", null, new { @class = "btn btn-outline btn-primary" })
                                    </div>
                                </div>
                            </div>
                            }
                        </div>

                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>

}
