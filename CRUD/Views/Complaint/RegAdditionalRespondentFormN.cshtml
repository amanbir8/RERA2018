<script>
    jQuery.validator.addMethod("alphanumericcc", function (value, element) {        
        return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
    }, "Special characters are not allowed.");

    $("#myform_AddRespondent").validate({
        rules: {
            Name_of_Respondant_or_Applicant: {
                required: true,                
                alphanumericcc: true,
                maxlength: 60
            },            
            EmailAddress: {
                required: true,
                email: true,
                maxlength: 100
            },
            MobileNumber: {
                //required: true,
                number: true,
                maxlength: 10,
                minlength: 10
            },
            LandlineNumber: {
                number: true,
                maxlength: 10,
                minlength: 10
            },            
            RegOffice_AddressLine1: {
                required: true,
                alphanumericcc: true,
                maxlength: 90
            },
            RegOffice_AddressLine2: {
                alphanumericcc: true,
                maxlength: 90
            },
            RegOffice_AddressStateCode: {
                required: true                
            },
            RegOffice_AddressDistrictCode: {
                required: true
            },
            RegOffice_AddressPIN: {
                required: true,
                number: true,
                maxlength: 6,
                minlength: 6
            },
            Service_AddressLine1: {
                required: true,
                alphanumericcc: true,
                maxlength: 90
            },
            Service_AddressLine2: {
                alphanumericcc: true,
                maxlength: 90
            },
            Service_AddressStateCode: {
                required: true
            },
            Service_AddressDistrictCode: {
                required: true
            },
            Service_AddressPIN: {
                required: true,
                number: true,
                maxlength: 6,
                minlength: 6
            }
        }
    });
</script>
<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');

        $('table#detailsTable').dataTable({
            'aoColumnDefs': [
                {
                    'bSortable': false,
                    'aTargets': [7]
                },
                { className: "hidden", "targets": [1, 2, 3] },
                { className: "text-center", "targets": [5, 6, 7] }
            ],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records",
                "emptyTable": ""
            },
            "pagingType": "full_numbers",
            "ajax": {
                "url": baseUrl + "Complaint/GetRespondentFormNData",
                "type": "GET",
                "datatype": "json"
            },
            "columns": [
                { "data": "Name_of_Respondant_or_Applicant" },
                { "data": "AdditionRespondent_IndexID" },
                { "data": "AdditionRespondent_ID" },
                { "data": "Profile_ID" },
                { "data": "EmailAddress" },
                { "data": "MobileNumber" },
                { "data": "LandlineNumber" },
                {
                    data: "IsDraft",
                    "render": function (data, type, row) {
                        var strval = '--';
                        if (data == 0 || data == 4) {
                            strval = '<a href="javascript:void(0);" id="deleteButton" title="Delete">delete <i class="fa fa-trash-o"></i></a>';
                        }
                        else if (data == 1 || data == 5 || data == 6) {
                            strval = 'delete <i class="fa fa-ban"></i>';
                        }
                        return strval;
                    },
                    visible: true
                }
            ]
        });
    });
</script>
<script>
    $(document).ready(function () {

        //Add Multiple Respondent.
        $("#addToList").click(function (e) {            
            e.preventDefault();
            var isAllValid = false;

            if ($('#Name_of_Respondant_or_Applicant').val() != '' && $('#EmailAddress').val() != '' && $('#RegOffice_AddressLine1').val() != '' && $('#RegOffice_AddressPIN').val() != '' && $('#Service_AddressPIN').val() != '' && $('#Service_AddressLine1').val() != '') {
                //&& $('#MobileNumber').val() != ''
                isAllValid = true;
            }
            else
            {                
                alert('The mandatory (*) fields are required.');
            }

            if (isAllValid) {
                var Name_of_Respondant_or_Applicant = $("#Name_of_Respondant_or_Applicant").val(),
                    EmailAddress = $("#EmailAddress").val(),
                    MobileNumber = $("#MobileNumber").val(),
                    LandlineNumber = $("#LandlineNumber").val(),                    
                    RegOffice_AddressLine1 = $("#RegOffice_AddressLine1").val(),
                    RegOffice_AddressLine2 = $("#RegOffice_AddressLine2").val(),
                    RegOffice_AddressStateCode = $("#RegOffice_AddressStateCode").val(),
                    RegOffice_AddressDistrictCode = $("#RegOffice_AddressDistrictCode").val(),
                    RegOffice_AddressPIN = $("#RegOffice_AddressPIN").val(),
                    IsSameCommunicationAdd_ResOffAdd = $("#IsSameCommunicationAdd_ResOffAdd").val(),
                    Service_AddressLine1 = $("#Service_AddressLine1").val(),
                    Service_AddressLine2 = $("#Service_AddressLine2").val(),
                    Service_AddressStateCode = $("#Service_AddressStateCode").val(),
                    Service_AddressDistrictCode = $("#Service_AddressDistrictCode").val(),
                    Service_AddressPIN = $("#Service_AddressPIN").val(),
                    TempDataFlag = 999,
                    detailsTableBody = $("#detailsTable tbody");

                var RespondentDetail = '<tr><td>' + Name_of_Respondant_or_Applicant + '</td><td>' + EmailAddress + '</td><td class="text-center">' + MobileNumber + '</td><td class="text-center">' + LandlineNumber + '</td><td class="hidden">' + RegOffice_AddressLine1 + '</td><td class="hidden">' + RegOffice_AddressLine2 + '</td><td class="hidden">' + RegOffice_AddressStateCode + '</td><td class="hidden">' + RegOffice_AddressDistrictCode + '</td><td class="hidden">' + RegOffice_AddressPIN + '</td><td class="hidden">' + IsSameCommunicationAdd_ResOffAdd + '</td><td class="hidden">' + Service_AddressLine1 + '</td><td class="hidden">' + Service_AddressLine2 + '</td><td class="hidden">' + Service_AddressStateCode + '</td><td class="hidden">' + Service_AddressDistrictCode + '</td><td class="hidden">' + Service_AddressPIN + '</td><td class="hidden">' + TempDataFlag + '</td></td><td class="text-center"><a data-itemId="0" href="javascript:void(0);" class="deleteItem" title="Remove">remove <i class="fa fa-trash-o"></i></a></td></tr>';

                var rowCountTable = 0;
                $.each($("#detailsTable tbody tr"), function () {
                    rowCountTable = rowCountTable + 1;
                    if ($(this).find('td:eq(0)').html() === 'No matching records found') {
                        $(this).remove();
                    };
                });
                detailsTableBody.append(RespondentDetail);
                clearItem();
            }
        });

        //After Add A New Respondent In The List, Clear Clean The Form For Add More Respondent.
        function clearItem() {            
            $("#Name_of_Respondant_or_Applicant").val('');
            $("#MobileNumber").val('');
            $("#LandlineNumber").val('');
            $("#EmailAddress").val('');            
            $("#RegOffice_AddressLine1").val('');
            $("#RegOffice_AddressLine2").val('');
            $("#RegOffice_AddressStateCode").val('');
            $("#RegOffice_AddressDistrictCode").val('');
            $("#RegOffice_AddressPIN").val('');
            $("#IsSameCommunicationAdd_ResOffAdd").prop("checked", false);            
            $("#Service_AddressLine1").val('');
            $("#Service_AddressLine2").val('');
            $("#Service_AddressStateCode").val('');
            $("#Service_AddressDistrictCode").val('');
            $("#Service_AddressPIN").val('');
        }

        // After Add A New Respondent In The List, If You Want, You Can Remove It.
        $(document).on('click', 'a.deleteItem', function (e) {
            e.preventDefault();
            var flagmove = confirm('Are you sure want to remove?');
            if (flagmove) {
                var $self = $(this);
                if ($(this).attr('data-itemId') == "0") {
                    $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                        $(this).remove();
                    });
                }
            }
        });

        var baseUrl = $('body').attr('data-base-url');

        //After Click Save Button Pass All Data View To Controller For Save Database
        function saveOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "Complaint/SaveRespondentFormNDetail",
                data: data,
                success: function (d) {                    
                    if (d.status == true) {                        
                        alert('Additional Respondents saved successfully');
                        orderArr = [];
                        clearItem();
                        var projectDetailsModal = $(document).find('#myFormNmodal');                        
                        $(projectDetailsModal).fadeOut(1000, function () {
                            $(projectDetailsModal).modal('hide');
                        });
                    }
                    else {
                        alert('Additional Respondents submission Failed');
                    }
                },
                error: function () {
                    alert("oops! Something went wrong")
                }
            });
        }

        //Collect Multiple Order List For Pass To Controller
        $("#saveOrder").click(function (e) {
            e.preventDefault();

            var orderArr = [];
            orderArr.length = 0;

            $.each($("#detailsTable tbody tr"), function () {
                if ($(this).find('td:eq(15)').html() == 999) {
                    orderArr.push({
                        Name_of_Respondant_or_Applicant: $(this).find('td:eq(0)').html(),
                        EmailAddress: $(this).find('td:eq(1)').html(),
                        MobileNumber: $(this).find('td:eq(2)').html(),
                        LandlineNumber: $(this).find('td:eq(3)').html(),                        

                        RegOffice_AddressLine1: $(this).find('td:eq(4)').html(),
                        RegOffice_AddressLine2: $(this).find('td:eq(5)').html(),
                        RegOffice_AddressStateCode: $(this).find('td:eq(6)').html(),
                        RegOffice_AddressDistrictCode: $(this).find('td:eq(7)').html(),
                        RegOffice_AddressPIN: $(this).find('td:eq(8)').html(),

                        IsSameCommunicationAdd_ResOffAdd: $(this).find('td:eq(9)').html(),
                        Service_AddressLine1: $(this).find('td:eq(10)').html(),
                        Service_AddressLine2: $(this).find('td:eq(11)').html(),
                        Service_AddressStateCode: $(this).find('td:eq(12)').html(),
                        Service_AddressDistrictCode: $(this).find('td:eq(13)').html(),
                        Service_AddressPIN: $(this).find('td:eq(14)').html()
                    });
                }
            });

            var data = JSON.stringify({
                order: orderArr
            });

            $.when(saveOrder(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });
        });
    });
</script>

<script>
    $(function () {
        if ($('#MobileNumber').val() == 0) {
            $('#MobileNumber').val('');
        }

        $('#IsSameCommunicationAdd_ResOffAdd').on("click", function () {
            if ($(this).is(':checked')) {

                var ddl = $("#BusinessPlace_AddressStateCode").clone();
                var selectedValue = $("#RegOffice_AddressStateCode option:selected").val();

                $("input[name='Service_AddressStateCode']").find("option[value = '" + selectedValue + "']").attr("selected", "selected");
                $("input[name='Service_AddressLine1']").val($("input[name='RegOffice_AddressLine1']").val());
                $("input[name='Service_AddressLine2']").val($("input[name='RegOffice_AddressLine2']").val());
                $("select[name='Service_AddressStateCode']").val($("select[name='RegOffice_AddressStateCode']").val());
                $("select[name='Service_AddressDistrictCode']").val($("select[name='RegOffice_AddressDistrictCode']").val());
                $("input[name='Service_AddressPIN']").val($("input[name='RegOffice_AddressPIN']").val());

            } else {

                $("input[name='Service_AddressLine1']").val('');
                $("input[name='Service_AddressLine2']").val('');
                $("input[name='Service_AddressPIN']").val('');
                $("select[name='Service_AddressDistrictCode']").val('');
                $("select[name='Service_AddressStateCode']").val('');

            }
        });

        var baseUrl = $('body').attr('data-base-url');

        $(document).on('click', 'a#deleteButton', function (e) {
            e.preventDefault();
            var flagmove = confirm('Are you sure want to delete?');
            if (flagmove) {
                var elem = $(this);
                var parentRow = $(elem).parents('tr');
                var inRespN_IndexID = $.trim($(parentRow).find('td:eq(1)').text());
                var inRespN_ID = $.trim($(parentRow).find('td:eq(2)').text());
                var inProfile_ID = $.trim($(parentRow).find('td:eq(3)').text());
                inRespN_IndexID = parseInt(inRespN_IndexID);
                inRespN_ID = parseInt(inRespN_ID);
                inProfile_ID = parseInt(inProfile_ID);

                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    url: baseUrl + 'Complaint/Delete_AdditionalRespondentFormN',
                    type: 'GET',
                    data: { 'inRespN_IndexID': inRespN_IndexID, 'inRespN_ID': inRespN_ID, 'inProfile_ID': inProfile_ID },
                    success: function (d) {
                        if (d) {
                            //alert('Complainant successfully deleted');
                            $.trim($(parentRow).css("background-color", "#ff6347").fadeOut(800, function () {
                                $.trim($(parentRow).remove());
                            }));
                            //$('#detailsTable').DataTable().ajax.reload();
                        }
                        //else {
                        //    alert('Complainant delete Failed');
                        //}
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            }
        });
    });
</script>

<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "Complaint/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#RegOffice_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                    $("#RegOffice_AddressStateCode option:contains(undefined)").remove();
                });
            }
        });

        $('#RegOffice_AddressStateCode').change(function () {
            $('#RegOffice_AddressDistrictCode').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Complaint/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#RegOffice_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#RegOffice_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
