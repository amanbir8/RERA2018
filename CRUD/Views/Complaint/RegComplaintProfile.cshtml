@model CRUD.Models.Complaint.ClsPrp_ComplaintProfile

<script type="text/javascript">

    $(document).ready(function () {

        if ($('#PhoneNumber_Number').val() === "0") {
            $('#PhoneNumber_Number').val("");
        }


        $('#IsSameCommunicationAdd_ResOffAdd').on("click", function () {
            if ($(this).is(':checked')) {

                //Clone the DropDownList
                var ddl = $("#Residencial_Official_AddressStateCode").clone();

                //[OPTIONAL] Copy the selected value
                var selectedValue = $("#Residencial_Official_AddressStateCode option:selected").val();
                $("input[name='Comm_AddressStateCode']").find("option[value = '" + selectedValue + "']").attr("selected", "selected");
                $("input[name='Comm_AddressLine1']").val($("input[name='Residencial_Official_AddressLine1']").val());
                $("input[name='Comm_AddressLine2']").val($("input[name='Residencial_Official_AddressLine2']").val());
                $("select[name='Comm_AddressStateCode']").val($("select[name='Residencial_Official_AddressStateCode']").val());

                $("select[name='Comm_AddressDistrictCode']").val($("select[name='Residencial_Official_AddressDistrictCode']").val());
                $("input[name='Comm_AddressPIN']").val($("input[name='Residencial_Official_AddressPIN']").val());                
            } else {
                $("input[name='Comm_AddressLine1']").val('');
                $("input[name='Comm_AddressLine2']").val('');
                $("input[name='Comm_AddressPIN']").val('');
                $("select[name='Comm_AddressDistrictCode']").val('');
                $("select[name='Comm_AddressStateCode']").val('');
            }
        });       
        
        $(function () {
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "GET",
                url: baseUrl + "Complaint/GetState",
                datatype: "Json",
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#Residencial_Official_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');

                        $("#Residencial_Official_AddressStateCode option:contains(undefined)").remove();
                    });
                }
            });

            $('#Residencial_Official_AddressStateCode').change(function () {

                $('#Residencial_Official_AddressDistrictCode').empty();

                $.ajax({
                    type: "POST",
                    url: baseUrl + "Complaint/GetDistrictByStateId",
                    datatype: "Json",
                    data: { StateId: $('#Residencial_Official_AddressStateCode').val() },
                    success: function (data) {
                        $.each(data, function (index, value) {
                            $('#Residencial_Official_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                        });
                    }
                });
            });
        });

        $('[data-toggle="tooltip"]').tooltip();

    });        
</script>
<script>
        $(function () {            
            var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "Complaint/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#Comm_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');

                    $("#Comm_AddressStateCode option:contains(undefined)").remove();
                });
            }
        });

        $('#Comm_AddressStateCode').change(function () {

            $('#Comm_AddressDistrictCode').empty();

            $.ajax({
                type: "POST",
                url: baseUrl + "Complaint/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#Comm_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#Comm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
<script>
    $(document).ready(function () {
        var compBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.complainantdeskHomeButton', function (e) {
            e.preventDefault();
            window.location = compBASE_URL + 'Home/IndexComplainant';
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">My Profile</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Complainant Profile Registration Details
                    <span class="pull-right">
                        <a class="complainantdeskHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

