                                                                @Html.DropDownListFor(model => model.Residencial_Official_AddressDistrictCode, new SelectList(Model.districtMaster, "DistrictId", "DistrictName"), "Select District", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.Residencial_Official_AddressDistrictCode, "", new { @class = "text-danger" })
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3"> 
                                                            @Html.LabelFor(model => model.Residencial_Official_AddressPIN, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Residencial_Official_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Residencial_Official_AddressPIN, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                               
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Address for Official Communication or Notifications</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-9">                                                            
