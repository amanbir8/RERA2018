                                                            Is Your Communication or Notification Address is same as Residential Address?
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Comm_AddressLine1, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Valid address of the Applicant for all official communication with the Authority.">
                                                            @Html.EditorFor(model => model.Comm_AddressLine1, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Comm_AddressLine1, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Comm_AddressLine2, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Comm_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Comm_AddressLine2, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select State</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(m => m.Comm_AddressStateCode, new SelectList(Model.stateMaster, "StateId", "StateName"), "Select State", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Comm_AddressStateCode, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Select District</label>
                                                        </div>
                                                        @if (Model.districtMaster != null)
                                                        {
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.Comm_AddressDistrictCode, new SelectList(Model.districtMaster, "DistrictId", "DistrictName"), "Select District", new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.Comm_AddressDistrictCode, "", new { @class = "text-danger" })
                                                            </div>
                                                        }                                                        
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Comm_AddressPIN, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Comm_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Comm_AddressPIN, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                               

                                  <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.IsDraft == 1)
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-primary" disabled = "disabled" />
                                            }
                                            else
                                            {
                                                <input type="submit" value="@TempData["submitvalue"]" class="btn btn-outline btn-primary" />
                                            }                                            
                                            &nbsp;
                                            @Html.ActionLink("Reset", "RegComplaintProfile", "Complaint", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>

                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}