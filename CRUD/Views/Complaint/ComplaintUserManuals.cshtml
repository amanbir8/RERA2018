
<script>
    $(document).ready(function () {
        var compBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.complainantdeskHomeButton', function (e) {
            e.preventDefault();
            window.location = compBASE_URL + 'Home/IndexComplainant';
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">User Manual for Registration of Complaint(s) - Form M or Form N</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Complaint Registration User Manual - Form M or Form N Details
                    <span class="pull-right">
                        <a class="complainantdeskHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">                                            
                                                <embed src="~/pdf/usermanuals/Instruction_set_for_Complaint_RegistrationV1.pdf" style="width: 100%; height: 500px;" alt="pdf">
                                            </div>
                                        </div>
                                    </div>
                                }                                  
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

}



