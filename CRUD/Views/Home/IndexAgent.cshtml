@{
    ViewBag.Title = "Real Estate Agent";
    ViewBag.Message = "Address";
}

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script type="text/javascript">
    $(document).ready(function () {
        new PNotify({
            title: 'Notification',
            text: 'The registration fee for Agent registering as an Individual is INR 15,000/- (which includes INR 10000/- registration fee & INR 5000/- composite web-portal fee).',
            hide: false
        });

        new PNotify({
            title: 'Notification',
            text: 'The registration fee for Agent registering as other than Individual is INR 55,000/- (which includes INR 50000/- registration fee & INR 5000/- composite web-portal fee).',
            hide: false
        });

        new PNotify({
            title: 'Notification',
            //text: 'The registration payment can be made through Demand Draft (in favor of Real Estate Regulatory Authority, Punjab) as well as Online till 31st of October, 2018. Further from 1st of November, 2018 only Online Payment will be accepted.',
            // text: 'All payments need to be in the form of a Demand Draft in favor of Real Estate Regulatory Authority, Punjab.',
            text: 'All payments need to be in the form of a Online Payment Mode through web-portal i.e. only Online Payment(s) will be accepted.',
            type: 'info',
            hide: false
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Instructions and Application Process Flow</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Step By Step - Instructions for filing Online Agent Registration Form
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-12 text-justify" style="line-height: 28px; color: #000; font-family: roboto;">
                            
                            <p style=" text-align: justify;">
                                Online registration facility can be used for registration of New as well as Already Registered Agents (with
                                RERA registration number). The link to access the facility is same for both type of real estate agents –
                                “Register Online” on the home page of RERA Punjab web portal.
                            </p>

                            <p>
                                Before user starts filing the online agent registration form it is advisable to go through the “Agent
                                Registration Checklist” under Document tab and “User Manual” under FAQs tab, available on the
                                homepage of RERA Punjab, web portal.
                            </p>

                            <p>
                                Also, kindly note that online payment facility for payment of registration fees is now available for registration of real-estate agents. 
                                Further agent registration fees is payable through DD/ Bankers Cheque till 31st of October, 2018 while from 1st of November, 2018 Online Payment will be accepted only. Thus if payment through DD/ Bankers Cheque, then the user should be ready with the DD/ Bankers Cheque
                                before filing the online agent registration form for New Agents and should submit the same along with the
                                hardcopy of the application form and documents uploaded online for registration.

                                @*Also, kindly note that online payment facility is not provided currently. Therefore agent registration fees is
                                payable through DD/ Bankers Cheque only. Thus the user should be ready with the DD/ Bankers Cheque
                                before filing the online agent registration form for New Agents and should submit the same along with the
                                hardcopy of the application form and documents uploaded online for registration.*@
                            </p>



                            <div class="panel-group" id="accordion">
                                <div class="panel panel-info">
                                    <div class="panel-heading">
                                        <h4 class="panel-title">
                                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="false" class="panel-accordion-toggle collapsed">Instruction for New Agent Registration</a>
                                        </h4>
                                    </div>
                                    <div id="collapseOne" class="panel-collapse collapse" aria-expanded="false" style="height: 0px;">
                                        <div class="panel-body">

                                            <ul class="list-group" style="list-style-type: none;">
                                                <li>
                                                    <b style="">Step 1:</b> Click on the “Agent Profile” to see all the sub-sections to be filled for creation of agent profile and
                                                    filing online application form. All the sub-sections to be filled are mentioned below:
                                                    <ul>

                                                        <li>
                                                            Agent Profile
                                                            <ul>
                                                                <li>My Profile</li>
                                                                <li>Organization Member Details</li>                                                                
                                                            </ul>
                                                        </li>
                                                        <li>
                                                            Application for Registration
                                                            <ul>
                                                                <li>Documents Upload</li>
                                                                <li>Registration Details</li>
                                                                <li>Payment Details</li>
                                                            </ul>
                                                        </li>
                                                        <li>
                                                            Review Confirm
                                                            <ul>
                                                                <li>Application for Registration</li>
                                                            </ul>
                                                        </li>


                                                        <p>
                                                            User is requested to follow the sequence in which sub-sections are provided, while filing the
                                                            form.
                                                        </p>
                                                    </ul>
                                                </li>
                                                <li>
                                                    List of documents required to be uploaded:

                                                    <ul>
                                                        <li>Permanent address proof</li>
                                                        <li>Address proof for place of business</li>
                                                        <li>
                                                            Copy of PAN (In case of firm, the PAN card of firm is required. In case of individual, PAN
                                                            card of promoter is required)
                                                        </li>
                                                        <li> Photograph of Agent (In case of individual)</li>
                                                        <li> Photograph of Organization Members (In case of firm)</li>
                                                        <li>
                                                            Income Tax Return for the last 3 financial years
                                                        </li>
                                                        <li> Company Registration/MoU/AoA (In case of organization)</li>
                                                        <li> Copy of Online Payment/ DD/ Banker’s cheque for the registration fee</li>

                                                        <p>
                                                            Kindly note that, it is mandatory to upload all the documents listed on the drop down at the
                                                            “Document Upload” sub-section for online submission of application.
                                                        </p>
                                                    </ul>
                                                </li>
                                                <li>
                                                    <b>Step 2:</b> Profile Review/ Confirm: The last step for the submission of agent registration form is “Review/
                                                    Confirm” sub-section, where the user can review the details provided in all of the previous subsections
                                                    and then confirm the same.
                                                    All the sub-sections are to be confirmed by pressing the “Confirm Button” under the “Action
                                                    Required” column against each of the sub-section, once all the sub-sections are confirmed the “I
                                                    Agree” button at the bottom of the page will be activated.
                                                    On pressing the “I Agree” button the application form will be submitted and all the information
                                                    thus provided, will be available in the view mode only and the user would not be able to make any
                                                    changes. Therefore it is suggested that the final “I Agree” button will only be pressed when the user
                                                    has reviewed all the information and is sure of submitting the same. On submission a unique agent
                                                    application id will be created, which the user can save for future communications with the
                                                    Authority.
                                                </li>
                                            </ul>
                                            <ul class="list-group" style="list-style-type: none;">
                                                <li><b>Step 3:</b>  Print Out of Documents and Application Form</li>
                                                <p>
                                                    After submitting the application for registration, again go to the “Review/ Confirm” section to download
                                                    the forms filled under each of the sub-sections.
                                                    Once downloaded, take the print out of the forms and maintained a hard copy of the documents uploaded with the Authority for your future reference.
                                                </p>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <div class="panel panel-info">
                                    <div class="panel-heading">
                                        <h4 class="panel-title">
                                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseFour" aria-expanded="false" class="panel-accordion-toggle collapsed">Instruction for Renewal of Registration for Real Estate Agent</a>
                                        </h4>
                                    </div>
                                    <div id="collapseFour" class="panel-collapse collapse" aria-expanded="false" style="height: 0px;">
                                        <div class="panel-body">

                                            <ul class="list-group" style="list-style-type: none;">
                                                <li>
                                                    <b style="">Step 1:</b> Click on the “Renewal of Registration” to see all the sub-sections to be filled for creation of agent profile and
                                                    filing online application form. All the sub-sections to be filled are mentioned below:
                                                    <ul>

                                                        <li>
                                                            Agent Profile
                                                            <ul>
                                                                <li>My Profile</li>
                                                            </ul>
                                                        </li>
                                                        <li>
                                                            Renewal of Registration
                                                            <ul>
                                                                <li>Agent Profile Details</li>
                                                                <li>Organization Members Details</li>
                                                                <li>Documents Upload</li>
                                                                <li>Registration Details with Other State/UT's</li>
                                                                <li>Renewal Payment Details</li>
                                                            </ul>
                                                        </li>
                                                        <li>
                                                            Review Confirm
                                                            <ul>
                                                                <li>Renewal of Registration</li>
                                                            </ul>
                                                        </li>

                                                        <p>
                                                            User is requested to follow the sequence in which sub-sections are provided, while filing the form.
                                                        </p>
                                                    </ul>
                                                </li>
                                                <li>
                                                    List of documents required to be uploaded:

                                                    <ul>
                                                        <li>Permanent address proof</li>
                                                        <li>Address proof for place of business</li>
                                                        <li>
                                                            Copy of PAN (In case of firm, the PAN card of firm is required. In case of individual, PAN
                                                            card of promoter is required)
                                                        </li>
                                                        <li> Photograph of Agent (In case of individual)</li>
                                                        <li> Photograph of Organization Members (In case of firm)</li>
                                                        <li>
                                                            Income Tax Return for the last 3 financial years
                                                        </li>
                                                        <li> Company Registration/MoU/AoA (In case of organization)</li>
                                                        <li> Copy of Online Payment/ DD/ Banker’s cheque for the registration fee</li>

                                                        <p>
                                                            Kindly note that, it is mandatory to upload all the documents listed on the drop down at the
                                                            “Document Upload” sub-section for online submission of application.
                                                        </p>
                                                    </ul>
                                                </li>
                                                <li>
                                                    <b>Step 2:</b> Profile Review/ Confirm: The last step for the submission of renewal of registration form is “Review/
                                                    Confirm” sub-section, where the user can review the details provided in all of the previous subsections
                                                    and then confirm the same.
                                                    All the sub-sections are to be confirmed by pressing the “Confirm Button” under the “Action
                                                    Required” column against each of the sub-section, once all the sub-sections are confirmed the “I
                                                    Agree” button at the bottom of the page will be activated.
                                                    On pressing the “I Agree” button the application form will be submitted and all the information
                                                    thus provided, will be available in the view mode only and the user would not be able to make any
                                                    changes. Therefore it is suggested that the final “I Agree” button will only be pressed when the user
                                                    has reviewed all the information and is sure of submitting the same. On submission a unique agent
                                                    application id will be created, which the user can save for future communications with the
                                                    Authority.
                                                </li>
                                            </ul>
                                            <ul class="list-group" style="list-style-type: none;">
                                                <li><b>Step 3:</b>  Print Out of Documents and Application Form</li>
                                                <p>
                                                    After submitting the application for registration, again go to the “Review/ Confirm” section to download
                                                    the forms filled under each of the sub-sections.
                                                    Once downloaded, take the print out of the forms and maintained a hard copy of the documents uploaded with the Authority for your future reference.
                                                </p>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <div class="panel panel-info">
                                    <div class="panel-heading">
                                        <h4 class="panel-title">
                                            <a data-toggle="collapse" data-parent="#accordion" href="#collapseThree" class="panel-accordion-toggle" aria-expanded="false">
                                                Instruction for Already Registered Agents (RERA Registration Number Issued)
                                            </a>
                                        </h4>
                                    </div>
                                    <div id="collapseThree" class="panel-collapse collapse in" aria-expanded="false" style="">
                                        <div class="panel-body">

                                            <p>
                                                Please make sure that for upload of information as already registered agents, RERA Registration number
                                                must be issued and correct number is readily available for reference. The link is same as used for New
                                                Agent i.e. “Register Online” on the home page of RERA Punjab web portal. Follow the below mentioned
                                                steps for upload of the information of already registered agents:
                                            </p>

                                            <b>Step 1:</b> Refer Step 1 of “Instruction for New Agent Registration”
                                            <p>
                                                The only difference is, while filling the “My Profile” sub-section please select “Yes” against the field “Do
                                                you Already have RERA Number (Yes/No)?” and provide the RERA Registration number in the same
                                                issued format. On filing the “Existing RERA Number” field the agent name will be automatically populated,
                                                which the user can verify against the allotted registration number.
                                                Also in the “Payment Details” sub-section, provide the details and copy of the same DD/ Bankers cheque
                                                through which the registration fees was paid and was submitted with the Authority.
                                            </p>
                                            <b>Step 2:</b> Print Out of additional Documents uploaded
                                            <p>Refer Step 2 of “Instruction for New Agent Registration”</p>
                                        </div>
                                    </div>
                                </div>                                
                            </div>
                        </div>
                        <!-- /.col-lg-6 (nested) -->
                        <!-- /.col-lg-6 (nested) -->
                    </div>
                    <!-- /.row (nested) -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

}

