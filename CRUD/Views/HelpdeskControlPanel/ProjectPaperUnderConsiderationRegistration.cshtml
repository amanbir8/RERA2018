<script>
    $(document).ready(function () {
        $("#btnRequestOptionsPUC").click(function (e) {
            e.preventDefault();
            var isAllValid = false;
            if ($('#RERAnumberRegistration_Input').val() != '') {
                var xpRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();                
                var n = xpRelated_RegistrationNumber.length;

                if (parseInt(n) >= parseInt(19)) {                    
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Registration Number!');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();

                Date.prototype.toShortFormat = function () {
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let day = this.getDate();
                    let day1 = (day < 10 ? '0' : '') + day;
                    let monthIndex = this.getMonth();
                    let monthName = monthNames[monthIndex];
                    let year = this.getFullYear();
                    return `${day1}-${monthName}-${year}`;
                };

                var BASE_URLn = $('body').attr('data-base-url');
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskControlPanel/GetExistingProjectPUCRegistrationByID',
                    datatype: "Json",
                    data: { "mRegNumber": pRelated_RegistrationNumber },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        if (data) {
                            if (data.status == true) {

                                $("#dnoPUC").addClass('show').removeClass('hide');
                                $("#detailsPUC").addClass('show').removeClass('hide');
                                $("#othersPUC").addClass('show').removeClass('hide');
                                $("#submitPUC").addClass('show').removeClass('hide');                                

                                $.each(data, function () {
                                    $(this).each(function () {
                                        $('#RelatedProject_ID').val(this.RelatedProject_ID);
                                        $('#RelatedPromoter_ID').val(this.RelatedPromoter_ID);
                                        $('#RERAnumberRegistration').val(this.RERAnumberRegistration);
                                        var getIssueDate = String(this.RERAnumberIssueDate);
                                        var getUptoDate = String(this.RERAnumberRegUptoDate);
                                        var dateIssueDate = new Date(parseInt(getIssueDate.substr(6)));
                                        var dateUptoDate = new Date(parseInt(getUptoDate.substr(6)));
                                        $('#RERAnumberIssueDate').val(dateIssueDate.toShortFormat());
                                        $('#RERAnumberRegUptoDate').val(dateUptoDate.toShortFormat());
                                        $('#ProjectDiaryNumber').val(this.ProjectDiaryNumber);
                                        $('#ProjectName').val(this.ProjectName);
                                        $('#PromoterName').val(this.PromoterName);
                                        $("input[name='IsExtensionRegistration'][value=" + this.IsExtensionRegistration + "]").attr('checked', 'checked');
                                        $("input[name='ProjectType'][value=" + this.ProjectType + "]").attr('checked', 'checked');
                                        $('#ProjectAddressDistrict').val(this.ProjectAddressDistrict);
                                        if (this.IsExtensionRegistration == 1) {
                                            $("#rowExtnDateCol01").addClass('show').removeClass('hide');
                                            $("#rowExtnDateCol02").addClass('show').removeClass('hide');
                                            $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
                                            $("#rowExtnDNoCol02").addClass('show').removeClass('hide');
                                            var getExtnUptoDate = String(this.RERAnumberExtensionRegUptoDate);
                                            var dateExtnUptoDate = new Date(parseInt(getExtnUptoDate.substr(6)));
                                            $('#RERAnumberExtensionRegUptoDate').val(dateExtnUptoDate.toShortFormat());
                                            $('#ExtensionRegdDiaryNumber').val(this.ExtensionRegdDiaryNumber);
                                        }
                                        else
                                        {
                                            $("#rowExtnDateCol01").addClass('hide').removeClass('show');
                                            $("#rowExtnDateCol02").addClass('hide').removeClass('show');
                                            $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
                                            $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
                                        }
                                    });
                                });
                            }
                            else {
                                alert('Invalid! Registration Number!');
                            }
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            };
        });

        $("#RERAnumberRegistration_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPCC").addClass('hide').removeClass('show');
        });

        var vcheckvalueregdextndate = $("input[name='IsExtensionRegistration']:checked").val();
        if (vcheckvalueregdextndate == '1') {
            $("#rowExtnDateCol01").addClass('show').removeClass('hide');
            $("#rowExtnDateCol02").addClass('show').removeClass('hide');
            $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
            $("#rowExtnDNoCol02").addClass('show').removeClass('hide');
        }
        else if (vcheckvalueregdextndate == '0') {
            $("#rowExtnDateCol01").addClass('hide').removeClass('show');
            $("#rowExtnDateCol02").addClass('hide').removeClass('show');
            $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
            $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
        }

        $(document).on('click', '.radio-typeprojectregdextnvalue', function (e) {
            if (this.value == '1') {
                $("#rowExtnDateCol01").addClass('show').removeClass('hide');
                $("#rowExtnDateCol02").addClass('show').removeClass('hide');
                $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
                $("#rowExtnDNoCol02").addClass('show').removeClass('hide');                
            }
            else if (this.value == '0') {
                $("#rowExtnDateCol01").addClass('hide').removeClass('show');
                $("#rowExtnDateCol02").addClass('hide').removeClass('show');
                $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
                $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
            }
        });

        $('#PUC_DocumentStatus').change(function () {
            var getvalue = $('#PUC_DocumentStatus').val();
            if (getvalue == 'Permissions' || getvalue == 'Clearances' || getvalue == 'Revisions') {
                $("#rowPCCdateCol01").addClass('show').removeClass('hide');
                $("#rowPCCdateCol02").addClass('show').removeClass('hide');                
            }
            else {
                $("#rowPCCdateCol01").addClass('hide').removeClass('show');
                $("#rowPCCdateCol02").addClass('hide').removeClass('show');                
            }
        });
    });
</script>
