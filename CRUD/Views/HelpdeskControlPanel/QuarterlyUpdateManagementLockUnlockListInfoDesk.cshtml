<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskControlPanel/ExportQuarterlyUpdateManagementLockUnlockToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Web-Portal Users</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can lock/unlock quarterly updates of registered project.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }

    .bg-border-show {
        position: relative !important;
    }

    .border-left-danger {
        border-left: .15rem solid #FF4961 !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .bg-exclamation-triangle-warning {
        color: #FF4961 !important;
        display: inline-block !important;
    }

    .bg-exclamation-triangle-none {
        display: none !important;
    }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('.btn-toggle-lockend').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');

            var indexId = $.trim($(parentRow).find('input.hdnIndexID').val());
            var nameId = $.trim($(parentRow).find('input.hdnID').val());
            var quarterYear = $.trim($(parentRow).find('input.hdnQuarterYear').val());
            var quarterName = $.trim($(parentRow).find('input.hdnQuarterName').val());

            var pmLockoutEnabled = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the quarterly updates lock/unlock options?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'HelpdeskControlPanel/LockedEnabledHandler_QuarterlyUpdateManagementListById',
                        data: { 'pmindexId': indexId, 'pmnameId': nameId, 'pmquarterYear': quarterYear, 'pmquarterName': quarterName, 'pmLockoutEnabled': pmLockoutEnabled },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionlockendTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultlockendTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultlockendTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultlockendTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disablelockendTogglebtnYN(elemid);
            }
        });

        $('.btn-toggle-qupconfirm').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');

            var indexId = $.trim($(parentRow).find('input.hdnIndexID').val());
            var nameId = $.trim($(parentRow).find('input.hdnID').val());
            var quarterYear = $.trim($(parentRow).find('input.hdnQuarterYear').val());
            var quarterName = $.trim($(parentRow).find('input.hdnQuarterName').val());

            var pmQUPconfirm = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the quarterly updates confirmation options?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'HelpdeskControlPanel/LockedConfirmEnabledHandler_QuarterlyUpdateManagementListById',
                        data: { 'pmindexId': indexId, 'pmnameId': nameId, 'pmquarterYear': quarterYear, 'pmquarterName': quarterName, 'pmQUPconfirm': pmQUPconfirm },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionqupconfirmTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultqupconfirmTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultqupconfirmTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultqupconfirmTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disablequpconfirmTogglebtnYN(elemid);
            }
        });
    });

    function setdefaultlockendTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varlockendFlag = 0;
        if (dataAction != '0') {
            //YPV(1) NPV(0)
            varlockendFlag = 1;
        };
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        switch (varlockendFlag) {
            case 0:
                $(document).find(vallockendShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(vallockendShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionlockendTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varlockendFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varlockendFlag = 1;
        };
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        var len = vallockendShowId.toString().trim().length;
        var res = vallockendShowId.substring(17, len);
        var strpvstatus = '#lockendtogglestatus';
        var vallockendstatusShowId = strpvstatus.concat(res);
        switch (varlockendFlag) {
            case 0:
                $(document).find(vallockendShowId.trim()).removeClass('active');
                $(document).find(vallockendstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(vallockendShowId.trim()).addClass('active');
                $(document).find(vallockendstatusShowId.trim()).removeClass('border-left-danger warning');
                break;
        }
    }
    function disablelockendTogglebtnYN(srID) {
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        $(document).find(vallockendShowId.trim()).prop('disabled', true);
        $(document).find(vallockendShowId.trim()).addClass("disabledlockunlock");
    }

    function setdefaultqupconfirmTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varqupconfirmFlag = 0;
        if (dataAction != '0') {
            //YPV(1) NPV(0)
            varqupconfirmFlag = 1;
        };
        var srtitle = '#';
        var valqupconfirmShowId = srtitle.concat(srID);
        switch (varqupconfirmFlag) {
            case 0:
                $(document).find(valqupconfirmShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(valqupconfirmShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionqupconfirmTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varqupconfirmFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varqupconfirmFlag = 1;
        };
        var srtitle = '#';
        var valqupconfirmShowId = srtitle.concat(srID);
        var len = valqupconfirmShowId.toString().trim().length;
        var res = valqupconfirmShowId.substring(17, len);
        var strpvstatus = '#qupconfirmtogglestatus';
        var valqupconfirmstatusShowId = strpvstatus.concat(res);
        switch (varqupconfirmFlag) {
            case 0:
                $(document).find(valqupconfirmShowId.trim()).removeClass('active');
                $(document).find(valqupconfirmstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(valqupconfirmShowId.trim()).addClass('active');
                $(document).find(valqupconfirmstatusShowId.trim()).removeClass('border-left-danger warning');
                break;
        }
    }
    function disablequpconfirmTogglebtnYN(srID) {
        var srtitle = '#';
        var valqupconfirmShowId = srtitle.concat(srID);
        $(document).find(valqupconfirmShowId.trim()).prop('disabled', true);
        $(document).find(valqupconfirmShowId.trim()).addClass("disabledlockunlock");
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 5.1 Quarterly Updates Management: Lock-Unlock (Web-Portal Updates Validity) Details
                    <span class="pull-right">                        
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("QuarterlyUpdateManagementLockUnlockListInfoDesk", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "QUPLockUnlockListInfoDesk" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Select Options</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Quarter Name</label>
                                                @{
                                                    var listItemsQuarterName = new List<SelectListItem>
                                                    {                                                        
                                                        new SelectListItem {  Text = "QTR-I (January-March)" , Value="FirstQTR"  },
                                                        new SelectListItem {  Text = "QTR-II (April-June)" , Value="SecondQTR"  },
                                                        new SelectListItem {  Text = "QTR-III (July-September)" , Value="ThirdQTR"  },
                                                        new SelectListItem {  Text = "QTR-IV (October-December)" , Value="FourthQTR"  },
                                                    };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.InputEntry_QuarterName, new SelectList(listItemsQuarterName, "Value", "Text"), "--Select--", new { @class = "form-control", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.InputEntry_QuarterName, "", new { @class = "text-danger" })                                                
                                            </div>
                                            <div class="col-md-7">
                                            </div>
                                        </div>
                                    </div>                                    
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.InputEntry_QuarterYear, htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.InputEntry_QuarterYear, new SelectList(ViewBag.QUProjectYears, "Text", "Value"), "--Select--", new { @class = "form-control", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.InputEntry_QuarterYear, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-7">
                                                <input type="submit" id="ViewDetail" value="View Details" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "QuarterlyUpdateManagementLockUnlockListInfoDesk", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>                                    
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="table-responsive">
                                        <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                            <thead>
                                                <tr>
                                                    <th>@Html.DisplayName("SNo")</th>
                                                    <th>@Html.DisplayNameFor(model => model.QUpdateProject_Year)</th>
                                                    <th>@Html.DisplayNameFor(model => model.QUpdateProject_QuarterName)</th>
                                                    <th>@Html.DisplayName("Locked Enabled (Yes/No)?")</th>
                                                    <th>@Html.DisplayName("Unlocked till Date")</th>
                                                    <th>@Html.DisplayName("Locked Confirmed(Yes/No)?")</th>
                                                    <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int sno = 0;
                                                    string lockendtogglebtnID = string.Empty;
                                                    string lockendtogglestatusID = string.Empty;
                                                    string qupconfirmtogglebtnID = string.Empty;
                                                    string qupconfirmtogglestatusID = string.Empty;
                                                }
                                                @foreach (var item in Model.prpongoing)
                                                {
                                                    {
                                                        sno = sno + 1;
                                                        lockendtogglebtnID = "lockendtogglebtn" + @sno.ToString();
                                                        lockendtogglestatusID = "lockendtogglestatus" + @sno.ToString();
                                                        qupconfirmtogglebtnID = "qupconfirmtogglebtn" + @sno.ToString();
                                                        qupconfirmtogglestatusID = "qupconfirmtogglestatus" + @sno.ToString();
                                                    }
                                                    <tr class="odd gradeX">
                                                        <td>@Html.DisplayName(sno.ToString())</td>
                                                        <td class="text-center">@Html.DisplayFor(modelItem => item.QUpdateProject_Year)</td>
                                                        <td class="text-center">
                                                            @if (item.QUpdateProject_QuarterName.ToString() == "FirstQTR")
                                                            {
                                                                @Html.DisplayName("QTR-I (January-March)")
                                                            }
                                                            else if (item.QUpdateProject_QuarterName.ToString() == "SecondQTR")
                                                            {
                                                                @Html.DisplayName("QTR-II (April-June)")
                                                            }
                                                            else if (item.QUpdateProject_QuarterName.ToString() == "ThirdQTR")
                                                            {
                                                                @Html.DisplayName("QTR-III (July-September)")
                                                            }
                                                            else if (item.QUpdateProject_QuarterName.ToString() == "FourthQTR")
                                                            {
                                                                @Html.DisplayName("QTR-IV (October-December)")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayFor(modelItem => item.QUpdateProject_QuarterName)
                                                            }                                                            
                                                        </td>                                                        
                                                        <td class="text-center">
                                                            @if (Model.RoleAccessFlag == "PR")
                                                            {
                                                                <script type="text/javascript">
                                                                    $(document).ready(function () {
                                                                        showlockendTogglebtnYN("@item.IsLock.ToString()", "@sno.ToString()");
                                                                    });
                                                                </script>
                                                                <button type="button" id=@lockendtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary btn-toggle-lockend" data-toggle="button" aria-pressed="false" autocomplete="off" title="Is lock/unlock quarterly updates?">
                                                                    <div class="handle"></div>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                if (item.IsLock == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.A_column)
                                                            @Html.HiddenFor(modelItem => item.QUpdateProject_RegDNProvider_IndexID, new { @class = "hdnIndexID" })
                                                            @Html.HiddenFor(modelItem => item.QUpdateProject_RegDNProvider_ID, new { @class = "hdnID" })
                                                            @Html.HiddenFor(modelItem => item.QUpdateProject_Year, new { @class = "hdnQuarterYear" })
                                                            @Html.HiddenFor(modelItem => item.QUpdateProject_QuarterName, new { @class = "hdnQuarterName" })
                                                        </td>                                                         
                                                        <td class="text-center">
                                                            @if (Model.RoleAccessFlag == "SA" || Model.RoleAccessFlag == "PR")
                                                            {
                                                                <script type="text/javascript">
                                                                    $(document).ready(function () {
                                                                        showqupconfirmTogglebtnYN("@item.IsActiveProvider.ToString()", "@sno.ToString()");
                                                                    });
                                                                </script>
                                                                <button type="button" id=@qupconfirmtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary btn-toggle-qupconfirm" data-toggle="button" aria-pressed="false" autocomplete="off" title="Is confirmed lock/unlock quarterly updates?">
                                                                    <div class="handle"></div>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                if (item.IsActiveProvider == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            }
                                                        </td>                                                        
                                                        <td>@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>                                                      
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>                                
                            </div>
                            <!-- /.row (nested) -->
                        </div>
                        <!-- /.panel-body -->
                    </div>
                    <!-- /.panel -->
                </div>
                <!-- /.col-lg-12 -->
            </div>
            <!-- /.row -->
        </div>
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

