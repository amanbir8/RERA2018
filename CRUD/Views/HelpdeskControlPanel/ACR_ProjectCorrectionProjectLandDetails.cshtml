<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script type="text/javascript">
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
        $('[data-spzoom]').spzoom();

        $("#RERAnumberRegistration_Input").inputmask({ mask: function () { return ["AAAAAA-AAA99-AA9999"]; } });
        $("#ReferenceRegistrationProject_Input").inputmask({ mask: function () { return ["AAA9999AAA9999"]; } });
        $("#ReferenceRegistrationPUC_Input").inputmask({ mask: function () { return ["AAAA99999999"]; } });
        $("#ReferenceNumber_Input").inputmask({ mask: function () { return ["9999"]; } });

        $('#ReferenceNumberDate_Input').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	    $('#RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	    $('#RERAnumberRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	    $('#RERAnumberExtensionRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	    $('#PUC_ReferencePUC_Date').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	});
</script>
<script>
    $(document).ready(function () {
        $(".btnRequestOptionsACR").click(function (e) {
            e.preventDefault();
            var isAllValid = false;
            var prmRequestFlag = $("input[name='ReferenceNumberFlag_Input']:checked").val();
            if (prmRequestFlag == 15) {
                if ($('#RERAnumberRegistration_Input').val() != '') {
                    var xpRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                    var n = xpRelated_RegistrationNumber.length;

                    if (parseInt(n) >= parseInt(19)) {
                        isAllValid = true;
                    }
                    else {
                        alert('Invalid! Registration Number!');
                        isAllValid = false;
                    };
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                };
            }
            else if (prmRequestFlag == 16) {
                if ($('#ReferenceRegistrationProject_Input').val() != '') {
                    var xpRelated_ProjectDNumber = $("#ReferenceRegistrationProject_Input").val();
                    var n = xpRelated_ProjectDNumber.length;

                    if (parseInt(n) >= parseInt(14)) {
                        isAllValid = true;
                    }
                    else {
                        alert('Invalid! Project Diary Number!');
                        isAllValid = false;
                    };
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                };
            }
            else if (prmRequestFlag == 17) {
                if ($('#ReferenceRegistrationPUC_Input').val() != '') {
                    var xpRelated_PucDNumber = $("#ReferenceRegistrationPUC_Input").val();
                    var n = xpRelated_PucDNumber.length;

                    if (parseInt(n) >= parseInt(12)) {
                        isAllValid = true;
                    }
                    else {
                        alert('Invalid! PUC Diary Number!');
                        isAllValid = false;
                    };
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                };
            }
            else if (prmRequestFlag == 18) {
                if ($('#ReferenceNumber_Input').val() != '') {
                    var xpRelated_RefNumber = $("#ReferenceNumber_Input").val();
                    var xpRelated_RefDate = $("#ReferenceNumberDate_Input").val();
                    var nx = xpRelated_RefNumber.length;
                    var ny = xpRelated_RefDate.length;
                    if (parseInt(ny) >= parseInt(11)) {
                        if (parseInt(nx) >= parseInt(4)) {
                            isAllValid = true;
                        }
                        else {
                            alert('Invalid! PUC Reference Number!');
                            isAllValid = false;
                        };
                    }
                    else {
                        alert('Invalid! PUC Reference Number!');
                        isAllValid = false;
                    };                    
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                };
            }
            else {
                isAllValid = false;
            };

            if (isAllValid) {
                var pwRelated_RegNumber = "";
                var pwRelated_PrjDNumber = "";
                var pwRelated_PucDNumber = "";
                var pwRelated_RefNumber = "";
                var today = new Date();
                var dd = String(today.getDate()).padStart(2, '0');
                var mm = String(today.getMonth() + 1).padStart(2, '0');
                var yyyy = today.getFullYear();
                var pwRelated_RefDate = mm + '/' + dd + '/' + yyyy;

                var pwRequestFlag = $("input[name='ReferenceNumberFlag_Input']:checked").val();
                if (pwRequestFlag == 15) {
                    pwRelated_RegNumber = $("#RERAnumberRegistration_Input").val();
                }
                else if (pwRequestFlag == 16) {
                    pwRelated_PrjDNumber = $("#ReferenceRegistrationProject_Input").val();
                }
                else if (pwRequestFlag == 17) {
                    pwRelated_PucDNumber = $("#ReferenceRegistrationPUC_Input").val();
                }
                else if (pwRequestFlag == 18) {
                    pwRelated_RefNumber = $("#ReferenceNumber_Input").val();
                    pwRelated_RefDate = $("#ReferenceNumberDate_Input").val();
                };

                Date.prototype.toShortFormat = function () {
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let day = this.getDate();
                    let day1 = (day < 10 ? '0' : '') + day;
                    let monthIndex = this.getMonth();
                    let monthName = monthNames[monthIndex];
                    let year = this.getFullYear();
                    return `${day1}-${monthName}-${year}`;
                };

                var BASE_URLn = $('body').attr('data-base-url');
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskControlPanel/GetExistingProjectRegistrationACRCorrectionProjectLandByID',
                    datatype: "Json",
                    data: { "mRequestFlag": pwRequestFlag, "mRegNumber": pwRelated_RegNumber, "mDNumber": pwRelated_PrjDNumber, "mPucDNumber": pwRelated_PucDNumber, "mPUCnumber": pwRelated_RefNumber, "mPUCdate": pwRelated_RefDate },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        if (data) {
                            if (data.status == true) {
                                $("#dnoPACR").addClass('show').removeClass('hide');
                                $("#pucPACR").addClass('show').removeClass('hide');
                                $("#detailsPACR01").addClass('show').removeClass('hide');
                                $("#detailsPACR02").addClass('show').removeClass('hide');
                                $("#detailsPACR03").addClass('show').removeClass('hide');
                                $("#othersPACR").addClass('show').removeClass('hide');
                                $("#submitPACR").addClass('show').removeClass('hide');
                                $("#InvalidPACR").addClass('show').removeClass('hide');                                

                                $.each(data, function () {
                                    $(this).each(function () {                                        
                                        $('#Related_Project_ID').val(this.Project_ID);
                                        $('#Related_Promoter_ID').val(this.Promoter_ID);
                                        $('#RERAnumberRegistration').val(this.RERAnumberRegistration);
                                        $('#RelatedApplicationPUC_ID').val(this.PUC_ID);                                        
                                        var getIssueDate = String(this.RERAnumberIssueDate);
                                        var getUptoDate = String(this.RERAnumberRegUptoDate);
                                        var dateIssueDate = new Date(parseInt(getIssueDate.substr(6)));
                                        var dateUptoDate = new Date(parseInt(getUptoDate.substr(6)));
                                        $('#RERAnumberIssueDate').val(dateIssueDate.toShortFormat());
                                        $('#RERAnumberRegUptoDate').val(dateUptoDate.toShortFormat());
                                        $('#ProjectDiaryNumber').val(this.ProjectDiaryNumber);
                                        $('#ProjectName').val(this.ProjectName);
                                        $('#PromoterName').val(this.PromoterName);
                                        $("input[name='IsExtensionRegistration'][value=" + this.IsExtensionRegistration + "]").attr('checked', 'checked');
                                        $("input[name='ProjectType'][value=" + this.ProjectType + "]").attr('checked', 'checked');
                                        $('#ProjectAddressDistrict').val(this.ProjectAddressDistrict);
                                        if (this.IsExtensionRegistration == 1) {
                                            $("#rowExtnDateCol01").addClass('show').removeClass('hide');
                                            $("#rowExtnDateCol02").addClass('show').removeClass('hide');
                                            $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
                                            $("#rowExtnDNoCol02").addClass('show').removeClass('hide');
                                            var getExtnUptoDate = String(this.RERAnumberExtensionRegUptoDate);
                                            var dateExtnUptoDate = new Date(parseInt(getExtnUptoDate.substr(6)));
                                            $('#RERAnumberExtensionRegUptoDate').val(dateExtnUptoDate.toShortFormat());
                                            $('#ExtensionRegdDiaryNumber').val(this.ExtensionRegdDiaryNumber);
                                        }
                                        else {
                                            $("#rowExtnDateCol01").addClass('hide').removeClass('show');
                                            $("#rowExtnDateCol02").addClass('hide').removeClass('show');
                                            $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
                                            $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
                                        };                                        
                                        $('#mFlagPUC_YesNo').val(this.mFlagPUC_YesNo);
                                        $('#mFlagPUC_OpenClosed').val(this.mFlagPUC_OpenClosed);
                                        $('#mFlagPUC_ApprovedNotApproved').val(this.mFlagPUC_ApprovedNotApproved);

                                        //Start-Cnt-Vw
                                        var mxFlagPUC_YesNo = String(this.mFlagPUC_YesNo);
                                        var mxFlagPUC_OpenClosed = String(this.mFlagPUC_OpenClosed);
                                        var mxFlagPUC_ApprovedNotApproved = String(this.mFlagPUC_ApprovedNotApproved);                                        
                                        if (mxFlagPUC_YesNo == 'Y') {
                                            if (mxFlagPUC_OpenClosed == 'Open') {
                                                if (mxFlagPUC_ApprovedNotApproved == 'A55') {
                                                    $("#dnoPACR").addClass('show').removeClass('hide');
                                                    $("#pucPACR").addClass('show').removeClass('hide');                                                   
                                                    $("#detailsPACR01").addClass('show').removeClass('hide');
                                                    $("#detailsPACR02").addClass('show').removeClass('hide');
                                                    $("#detailsPACR03").addClass('show').removeClass('hide');
                                                    $("#othersPACR").addClass('show').removeClass('hide');
                                                    $("#submitPACR").addClass('show').removeClass('hide');
                                                    $("#InvalidPACR").addClass('hide').removeClass('show');

                                                    $('#PUC_DiaryNumber').val(this.PUC_DiaryNumber);
                                                    $('#PUC_ReferencePUC_Name').val(this.PUC_ReferencePUC_Name);
                                                    var getRefPUCDate = String(this.PUC_ReferencePUC_Date);
                                                    var dateReferencePUC = new Date(parseInt(getRefPUCDate.substr(6)));
                                                    $('#PUC_ReferencePUC_Date').val(dateReferencePUC.toShortFormat());
                                                    $('#PUC_RequestCategoryName').val(this.PUC_RequestCategoryName);
                                                    $('#PUC_RequestCategoryID').val(this.PUC_RequestCategoryID);
                                                }
                                                else {
                                                    $("#dnoPACR").addClass('show').removeClass('hide');
                                                    $("#pucPACR").addClass('hide').removeClass('show');
                                                    $("#detailsPACR01").addClass('hide').removeClass('show');
                                                    $("#detailsPACR02").addClass('hide').removeClass('show');
                                                    $("#detailsPACR03").addClass('hide').removeClass('show');
                                                    $("#othersPACR").addClass('hide').removeClass('show');
                                                    $("#submitPACR").addClass('hide').removeClass('show');
                                                    $("#InvalidPACR").addClass('show').removeClass('hide');
                                                };
                                            }
                                            else {
                                                $("#dnoPACR").addClass('show').removeClass('hide');
                                                $("#pucPACR").addClass('hide').removeClass('show');
                                                $("#detailsPACR01").addClass('hide').removeClass('show');
                                                $("#detailsPACR02").addClass('hide').removeClass('show');
                                                $("#detailsPACR03").addClass('hide').removeClass('show');
                                                $("#othersPACR").addClass('hide').removeClass('show');
                                                $("#submitPACR").addClass('hide').removeClass('show');
                                                $("#InvalidPACR").addClass('show').removeClass('hide');
                                            };
                                        }
                                        else {
                                            $("#dnoPACR").addClass('show').removeClass('hide');
                                            $("#pucPACR").addClass('hide').removeClass('show');
                                            $("#detailsPACR01").addClass('hide').removeClass('show');
                                            $("#detailsPACR02").addClass('hide').removeClass('show');
                                            $("#detailsPACR03").addClass('hide').removeClass('show');
                                            $("#othersPACR").addClass('hide').removeClass('show');
                                            $("#submitPACR").addClass('hide').removeClass('show');
                                            $("#InvalidPACR").addClass('show').removeClass('hide');
                                        };
                                        //End-Cnt-Vw
                                    });
                                });
                            }
                            else {
                                alert('Invalid! Registration Number!');
                            }
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            };
        });

        $("#RERAnumberRegistration_Input").change(function (e) {
            e.preventDefault();            
            $("#dnoPACR").addClass('hide').removeClass('show');
            $("#pucPACR").addClass('hide').removeClass('show');
            $("#detailsPACR01").addClass('hide').removeClass('show');
            $("#detailsPACR02").addClass('hide').removeClass('show');
            $("#detailsPACR03").addClass('hide').removeClass('show');
            $("#othersPACR").addClass('hide').removeClass('show');
            $("#submitPACR").addClass('hide').removeClass('show');
            $("#InvalidPACR").addClass('hide').removeClass('show');
        });
        $("#ReferenceRegistrationProject_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPACR").addClass('hide').removeClass('show');
            $("#pucPACR").addClass('hide').removeClass('show');
            $("#detailsPACR01").addClass('hide').removeClass('show');
            $("#detailsPACR02").addClass('hide').removeClass('show');
            $("#detailsPACR03").addClass('hide').removeClass('show');
            $("#othersPACR").addClass('hide').removeClass('show');
            $("#submitPACR").addClass('hide').removeClass('show');
            $("#InvalidPACR").addClass('hide').removeClass('show');
        });
        $("#ReferenceRegistrationPUC_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPACR").addClass('hide').removeClass('show');
            $("#pucPACR").addClass('hide').removeClass('show');
            $("#detailsPACR01").addClass('hide').removeClass('show');
            $("#detailsPACR02").addClass('hide').removeClass('show');
            $("#detailsPACR03").addClass('hide').removeClass('show');
            $("#othersPACR").addClass('hide').removeClass('show');
            $("#submitPACR").addClass('hide').removeClass('show');
            $("#InvalidPACR").addClass('hide').removeClass('show');
        });
        $("#ReferenceNumber_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPACR").addClass('hide').removeClass('show');
            $("#pucPACR").addClass('hide').removeClass('show');
            $("#detailsPACR01").addClass('hide').removeClass('show');
            $("#detailsPACR02").addClass('hide').removeClass('show');
            $("#detailsPACR03").addClass('hide').removeClass('show');
            $("#othersPACR").addClass('hide').removeClass('show');
            $("#submitPACR").addClass('hide').removeClass('show');
            $("#InvalidPACR").addClass('hide').removeClass('show');
        });
        $("#ReferenceNumberDate_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPACR").addClass('hide').removeClass('show');
            $("#pucPACR").addClass('hide').removeClass('show');
            $("#detailsPACR01").addClass('hide').removeClass('show');
            $("#detailsPACR02").addClass('hide').removeClass('show');
            $("#detailsPACR03").addClass('hide').removeClass('show');
            $("#othersPACR").addClass('hide').removeClass('show');
            $("#submitPACR").addClass('hide').removeClass('show');
            $("#InvalidPACR").addClass('hide').removeClass('show');
        });

        var vcheckvalueregdextndate = $("input[name='IsExtensionRegistration']:checked").val();
        if (vcheckvalueregdextndate == '1') {
            $("#rowExtnDateCol01").addClass('show').removeClass('hide');
            $("#rowExtnDateCol02").addClass('show').removeClass('hide');
            $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
            $("#rowExtnDNoCol02").addClass('show').removeClass('hide');
        }
        else if (vcheckvalueregdextndate == '0') {
            $("#rowExtnDateCol01").addClass('hide').removeClass('show');
            $("#rowExtnDateCol02").addClass('hide').removeClass('show');
            $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
            $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
        }

        $(document).on('click', '.radio-typeprojectregdextnvalue', function (e) {
            if (this.value == '1') {
                $("#rowExtnDateCol01").addClass('show').removeClass('hide');
                $("#rowExtnDateCol02").addClass('show').removeClass('hide');
                $("#rowExtnDNoCol01").addClass('show').removeClass('hide');
                $("#rowExtnDNoCol02").addClass('show').removeClass('hide');                
            }
            else if (this.value == '0') {
                $("#rowExtnDateCol01").addClass('hide').removeClass('show');
                $("#rowExtnDateCol02").addClass('hide').removeClass('show');
                $("#rowExtnDNoCol01").addClass('hide').removeClass('show');
                $("#rowExtnDNoCol02").addClass('hide').removeClass('show');
            }
        });
        
        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();                       
        });
    });
</script>
