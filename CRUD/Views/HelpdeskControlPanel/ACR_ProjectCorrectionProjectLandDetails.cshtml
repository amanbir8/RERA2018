<script>
    $(document).ready(function () {
        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');
            switch (criteriaCode) {
                case '#accordionPUCprojectdetail':
                    $("#btnAccordionPUCproject").find("span").toggleClass("btn-outline");
                    $("#btnAccordionPUCproject").find("i").toggleClass("fa-expand fa-compress");
                    break;                
            }
        });
