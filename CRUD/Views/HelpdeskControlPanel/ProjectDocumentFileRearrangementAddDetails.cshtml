                                                            @Html.EditorFor(model => model.Project_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Project_DiaryNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RERA_RegistrationNumber, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Reference RERA Registration Number of Project with the authority.">
