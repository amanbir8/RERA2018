                                            </div>
                                            <div class="col-md-7">
                                                <input type="Submit" id="ViewRegistrationFilter" value="Proceed" class="btn btn-outline btn-primary submit-projectdoc-options" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectDocumentFileRearrangementDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row hide" id="rowDiaryFilter">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Diary Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ProjectDiaryNumber_Input, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.ProjectDiaryNumber_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-7">
                                                <input type="Submit" id="ViewDiaryFilter" value="Proceed" class="btn btn-outline btn-primary submit-projectdoc-options" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectDocumentFileRearrangementDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            @using (Html.BeginForm("ProjectDocumentFileRearrangementAddDetails", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmRegisterMoreProjectDocs" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(m => m.Promoter_ID)
                                @Html.HiddenFor(m => m.Project_ID)                                

                                <div class="row hide" id="dnoFileReArrangement">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Reference/ Registration Number Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Project_DiaryNumber, htmlAttributes: new { @class = "control-label mand" })
