<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        var vchecksearchtypevaluedatemode = $("input[name='Application_SearchTypeFlag']:checked").val();
        if (vchecksearchtypevaluedatemode == '21') {
            $("#rowRegistrationFilter").addClass("show").removeClass("hide");
            $("#rowDiaryFilter").addClass("hide").removeClass("show");
        }
        else if (vchecksearchtypevaluedatemode == '22') {
            $("#rowRegistrationFilter").addClass("hide").removeClass("show");
            $("#rowDiaryFilter").addClass("show").removeClass("hide");
        };

        $(document).on('click', '.radio-applicationformvalue', function (e) {
            if (this.value == '21') {
                $("#rowRegistrationFilter").addClass("show").removeClass("hide");
                $("#rowDiaryFilter").addClass("hide").removeClass("show");
            }
            else if (this.value == '22') {
                $("#rowRegistrationFilter").addClass("hide").removeClass("show");
                $("#rowDiaryFilter").addClass("show").removeClass("hide");
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        $(".submit-projectdoc-options").click(function (e) {
            e.preventDefault();
            var isAllValid = false;
            var vartyperegistrationmode = $("input[name='Application_SearchTypeFlag']:checked").val();
            if (vartyperegistrationmode == '21') {
                if ($('#RERAnumberRegistration_Input').val() != '') {
                    var xpRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                    var n = xpRelated_RegistrationNumber.length;

                    if (parseInt(n) >= parseInt(19)) {
                        isAllValid = true;
                    }
                    else {
                        alert('Invalid! Registration Number.');
                        isAllValid = false;
                    }
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                }
            }
            else if (vartyperegistrationmode == '22') {
                if ($('#ProjectDiaryNumber_Input').val() != '') {
                    var xpRelated_DiaryNumber = $("#ProjectDiaryNumber_Input").val();
                    var n = xpRelated_DiaryNumber.length;

                    if (parseInt(n) >= parseInt(14)) {
                        isAllValid = true;
                    }
                    else {
                        alert('Invalid! Diary Number.');
                        isAllValid = false;
                    }
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                }
            };            

            if (isAllValid) {
                var pRelated_typeregistrationmode = $("input[name='Application_SearchTypeFlag']:checked").val();
                var pRelated_ReferenceNumber = '0';
                if (pRelated_typeregistrationmode == '21') {                    
                    pRelated_ReferenceNumber = $("#RERAnumberRegistration_Input").val();
                }
                else if (vartyperegistrationmode == '22') {                    
                    pRelated_ReferenceNumber = $("#ProjectDiaryNumber_Input").val();
                };

                Date.prototype.toShortFormat = function () {
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let day = this.getDate();
                    let day1 = (day < 10 ? '0' : '') + day;
                    let monthIndex = this.getMonth();
                    let monthName = monthNames[monthIndex];
                    let year = this.getFullYear();
                    return `${day1}-${monthName}-${year}`;
                };

                var BASE_URLn = $('body').attr('data-base-url');
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskControlPanel/GetExistingProjectDocumentFileRearrangementByID',
                    datatype: "Json",
                    data: { "mRegFlag": pRelated_typeregistrationmode, "mRefNumber": pRelated_ReferenceNumber },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        if (data) {
                            if (data.status == true) {
                                $("#dnoFileReArrangement").addClass('show').removeClass('hide');
                                $("#showFileReArrangement").css("display", "block");
                                $("#showFileInfo").css("display", "none");
                                $("#submitFileInfo").addClass('show').removeClass('hide');

                                $.each(data, function () {
                                    $(this).each(function () {
                                        $('#Project_ID').val(this.Project_ID);
                                        $('#Promoter_ID').val(this.Promoter_ID);
                                        $('#RERA_RegistrationNumber').val(this.RERA_RegistrationNumber);
                                        $('#Project_DiaryNumber').val(this.Project_DiaryNumber);
                                        $('#ProjectName').val(this.ProjectName);
                                        $('#PromoterName').val(this.PromoterName);
                                        $('#ProjectAddressDistrict').val(this.ProjectAddressDistrict);
                                        if (this.RERA_RegistrationNumber != 'NA') {
                                            $("#rowRegdDateRow01").addClass('show').removeClass('hide');
                                            var getIssueDate = String(this.RERAnumberIssueDate);
                                            var getUptoDate = String(this.RERAnumberRegUptoDate);
                                            var dateIssueDate = new Date(parseInt(getIssueDate.substr(6)));
                                            var dateUptoDate = new Date(parseInt(getUptoDate.substr(6)));
                                            $('#RERAnumberIssueDate').val(dateIssueDate.toShortFormat());
                                            $('#RERAnumberRegUptoDate').val(dateUptoDate.toShortFormat());
                                        }
                                        else
                                        {
                                            $("#rowRegdDateRow01").addClass('hide').removeClass('show');
                                        }
                                    });
                                });
                            }
                            else {
                                alert('Invalid! Registration/Diary Number!');
                            }
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            };
        });

        $("#RERAnumberRegistration_Input").change(function (e) {
            e.preventDefault();
            $("#dnoFileReArrangement").addClass('hide').removeClass('show');
            $("#showFileReArrangement").css("display", "none");
            $("#showFileInfo").css("display", "none");
            $("#submitFileInfo").addClass('hide').removeClass('show');
        });

        $("#ProjectDiaryNumber_Input").change(function (e) {
            e.preventDefault();
            $("#dnoFileReArrangement").addClass('hide').removeClass('show');
            $("#showFileReArrangement").css("display", "none");
            $("#showFileInfo").css("display", "none");
            $("#submitFileInfo").addClass('hide').removeClass('show');
        });

        $(".radio-applicationformvalue").change(function (e) {
            e.preventDefault();
            $("#dnoFileReArrangement").addClass('hide').removeClass('show');
            $("#showFileReArrangement").css("display", "none");
            $("#showFileInfo").css("display", "none");
            $("#submitFileInfo").addClass('hide').removeClass('show');
        });
    });
</script>
