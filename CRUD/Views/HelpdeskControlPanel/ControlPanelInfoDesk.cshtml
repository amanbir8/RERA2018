    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Control Panel</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Application Change Request(s)/ Modification Request(s)/ Administrator Control Panel.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager Desk Admin Panel.',
