        color: white;
        cursor: pointer;
        padding: 10px;
        width: 95%;
        border: none;
        border-radius: .35rem;
        text-align: left;
        outline: none;
        font-size: 15px;
    }

    .active, .collapsible:hover, .collapsible:active {
        background-color: #31708f;
    }

    .collapsible:after {
        content: '\002B'; /*'\2212'*/
        color: white;
        font-weight: bold;
        float: right;
        margin-left: 5px;
    }

    .border-left-primary {
        border-left: .25rem solid #4e73df !important;
