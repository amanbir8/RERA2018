@model CRUD.Models.HelpdeskControlPanel.ClsPrp_ControlPanel_View_QuarterlyUpdatesProjectFile

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<link href="@Url.Content("~/dist/css/rera-toggleshow.css")" rel="stylesheet" />
<!-- DataTables JavaScript -->
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
<!-- Custom Theme JavaScript -->
<script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script> 

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script src="@Url.Content("~/mask-validator/jquery.inputmask.bundle-old.js")"></script>
<script src="@Url.Content("~/mask-validator/inputmask/bindings/inputmask.binding.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;        

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskControlPanel/ExportQUPsProjectRegAccessStatusToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Status of Quarterly Updates</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Search Status of Quarterly Updates (Project) details with reference to Registration Number/ RERA Number.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can intialize lock-unlock of the quarterly updates of registered project.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }

    .bg-border-show {
        position: relative !important;
    }

    .border-left-danger {
        border-left: .15rem solid #FF4961 !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .bg-exclamation-triangle-warning {
        color: #FF4961 !important;
        display: inline-block !important;
    }

    .bg-exclamation-triangle-none {
        display: none !important;
    }

    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script type="text/javascript">
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $("#InputEntry_RegistrationNumber").inputmask({ mask: function () { return ["AAAAAA-AAA99-AA9999"]; } });
	});
</script>
<script>
    $(function () {
        $('table#qup-statusaccess-table').dataTable({
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers",
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [1, 11]
            }]
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerApplyLockStatusButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var QUPsModal = $(document).find('#myModal');
            $(QUPsModal).find('.modal-body').html('');
            var promoterId = $.trim($(parentRow).find('input.hdnPromoterID').val());
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var regdId = $.trim($(parentRow).find('input.hdnRegdID').val());
            var diaryId = $.trim($(parentRow).find('input.hdnDiaryID').val());
            var extndiaryId = $.trim($(parentRow).find('hdnExtnDiaryID').val());
            promoterId = parseInt(promoterId);
            projectId = parseInt(projectId);
            $.ajax({
                url: BASE_URL + 'HelpdeskControlPanel/QuarterlyUpdateApplyStatusDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'promoterId': promoterId, 'projectId': projectId, 'regdId': regdId, 'diaryId': diaryId, 'extndiaryId': extndiaryId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(QUPsModal).find('.modal-body').html(response);
                    $(QUPsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(QUPsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(QUPsModal).modal('show');
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 5.2 Quarterly Updates Management: Status of Quarterly Updates (Registered Project) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>                        
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>                        
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            
                            @using (Html.BeginForm("QuarterlyUpdateManagementRegAccessStatusDetails", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", id="frmQUPstatusaccessOptions" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Search Options</legend>                                    
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Registration Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.InputEntry_RegistrationNumber, new { htmlAttributes = new { @class = "form-control", @placeholder = "RERA Number", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.InputEntry_RegistrationNumber, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" value="Proceed" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "QuarterlyUpdateManagementRegAccessStatusDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            @if (Model.prpongoing != null)
                                            {
                                                <table class="table table-striped table-bordered" id="qup-statusaccess-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@Html.DisplayName("Sr No")</th>
                                                            <th>@Html.DisplayName("Action")</th> 
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.ProjectName)
                                                            </th>                                                          
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.RERAnumberRegistration)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.RERAnumberIssueDate)
                                                            </th>                                                                                                                                                                                   
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.RERAnumberRegUptoDate)
                                                            </th>                                                            
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.RERAnumberExtensionRegUptoDate)
                                                            </th>                                                            
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.IsLock)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.IsActiveProvider)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Locked_From_Date)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Locked_To_Date)
                                                            </th>                                                            
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            int snopccstatus = 0;
                                                        }
                                                        @foreach (var item in Model.prpongoing)
                                                        {
                                                            {
                                                                snopccstatus = snopccstatus + 1;
                                                            }
                                                            <tr>
                                                                <td>
                                                                    @Html.DisplayName(snopccstatus.ToString())
                                                                </td>
                                                                <td class="center">
                                                                    <a id="modalOpenerApplyLockStatusButton" href="javascript:void(0);" title="Apply Lock-Unlock details"><i class="fa fa-pencil-square-o fa-fw"></i></a>
                                                                </td>                                                           
                                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.ProjectName)">
                                                                    @Html.DisplayFor(modelItem => item.ProjectName)
                                                                </td>
                                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.RERAnumberRegistration)">
                                                                    @Html.DisplayFor(modelItem => item.RERAnumberRegistration)
                                                                </td>
                                                                <td class="text-center">
                                                                    @Html.DisplayFor(modelItem => item.RERAnumberIssueDate)
                                                                </td>
                                                                <td class="text-center">
                                                                    @Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)
                                                                    @Html.HiddenFor(modelItem => item.RelatedPromoter_ID, new { @class = "hdnPromoterID" })
                                                                    @Html.HiddenFor(modelItem => item.RelatedProject_ID, new { @class = "hdnProjectID" })
                                                                    @Html.HiddenFor(modelItem => item.RERAnumberRegistration, new { @class = "hdnRegdID" })                                                                    
                                                                    @Html.HiddenFor(modelItem => item.ProjectDiaryNumber, new { @class = "hdnDiaryID" })
                                                                    @Html.HiddenFor(modelItem => item.ExtensionRegdDiaryNumber, new { @class = "hdnExtnDiaryID" })
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (item.RERAnumberExtensionRegUptoDate != DateTime.MinValue)
                                                                    {
                                                                        @Html.DisplayFor(modelItem => item.RERAnumberExtensionRegUptoDate)
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("--")
                                                                    }
                                                                </td>                                                                
                                                                <td class="text-center">
                                                                    @if (item.IsLock == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }                                                                    
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (item.IsActiveProvider == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (item.Locked_From_Date != DateTime.MinValue)
                                                                    {
                                                                        @Html.DisplayFor(modelItem => item.Locked_From_Date)
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("--")
                                                                    }
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (item.Locked_To_Date != DateTime.MinValue)
                                                                    {
                                                                        @Html.DisplayFor(modelItem => item.Locked_To_Date)
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("--")
                                                                    }
                                                                </td>                                                           
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>            
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
}
