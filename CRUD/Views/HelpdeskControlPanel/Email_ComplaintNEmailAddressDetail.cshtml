<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;        

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Additional E-Mail(s)</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Add additional E-mail Address details with reference to Registration Number/ RERA Number.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can intialize the additional E-mail Address details.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Enter Search Option as Diary Number with first twelve characters only (e.g AdCNoXXXXXXXX instead of AdCNo00012016/ AdCNo00012016UR/ AdCNo00012016TR/ AdCNo00012016-AUTH00012016 etc.)',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
