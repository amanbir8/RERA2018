<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script type="text/javascript">
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
        
        $("#RERAnumberRegistration_Input").inputmask({ mask: function () { return ["AaAAa99999999"]; } });
        $('#AE_ReferenceDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	});
</script>
<script>
    $(document).ready(function () {
        $("#btnListEmailAddress").click(function (e) {
            e.preventDefault();
            var isAllvalueValid = false;
            if ($('#RERAnumberRegistration_Input').val() != '') {
                var input_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                var n = input_RegistrationNumber.length;

                if (parseInt(n) >= parseInt(13)) {
                    isAllvalueValid = true;
                }
                else {
                    alert('Invalid! Diary Number!');
                    isAllvalueValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllvalueValid = false;
            }

            if (isAllvalueValid) {
                var var_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                var projectnumber = { 'strRERAnumber': var_RegistrationNumber };
                var baseURLn = $('body').attr('data-base-url');

                $.ajax({
                    type: "POST",
                    cache: false,
                    url: baseURLn + 'HelpdeskControlPanel/GetExistingEmailComplaintNFormAddressByID',
                    data: projectnumber,
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data, xhr, settings) {
                        stopPreloader();
                        $("#dnoPCC").addClass('hide').removeClass('show');
                        $("#detailsPCC").addClass('hide').removeClass('show');
                        $("#othersPCC").addClass('hide').removeClass('show');
                        $("#submitPCC").addClass('hide').removeClass('show');
                        $('#viewComplaintNEmailsList').html(data);
                    },
                    error: function (xhr, textStatus, error) {
                        stopPreloader();
                        $('#viewComplaintNEmailsList').html(textStatus);
                    }
                });
            };
        });

        $("#btnRequestOptionsEmailAddress").click(function (e) {
            e.preventDefault();
            var isAllValid = false;
            if ($('#RERAnumberRegistration_Input').val() != '') {
                var xpRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                var n = xpRelated_RegistrationNumber.length;

                if (parseInt(n) >= parseInt(13)) {
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Diary Number!');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();

                Date.prototype.toShortFormat = function () {
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let day = this.getDate();
                    let day1 = (day < 10 ? '0' : '') + day;
                    let monthIndex = this.getMonth();
                    let monthName = monthNames[monthIndex];
                    let year = this.getFullYear();
                    return `${day1}-${monthName}-${year}`;
                };

                var BASE_URLn = $('body').attr('data-base-url');
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskControlPanel/GetExistingRegisteredComplaintFormNForEmailAddressByID',
                    datatype: "Json",
                    data: { "mDiaryNumber": pRelated_RegistrationNumber },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        if (data) {
                            if (data.status == true) {
                                $("#dnoPCC").addClass('show').removeClass('hide');
                                $("#detailsPCC").addClass('show').removeClass('hide');
                                $("#othersPCC").addClass('show').removeClass('hide');
                                $("#submitPCC").addClass('show').removeClass('hide');

                                $.each(data, function () {
                                    $(this).each(function () {
                                        $('#ComplaintFormN_ID').val(this.ComplaintFormN_ID);
                                        $('#ComplaintFormN_Code').val(this.ComplaintFormN_Code);
                                        $('#Profile_ID').val(this.Profile_ID);
                                        $('#User_ID').val(this.User_ID);
                                        $('#Complaint_DiaryNumber_Name').val(this.Complaint_DiaryNumber_Name);
                                        $('#ComplaintType_MN').val(this.ComplaintType_MN);
                                        $('#Complainant_Name').val(this.Complainant_Name);
                                        $('#AuthorizedRepresentativeCounsel_Name').val(this.AuthorizedRepresentativeCounsel_Name);
                                        $('#OfficeResComplainant_AddressLine1').val(this.OfficeResComplainant_AddressLine1);
                                        $('#OfficeResComplainant_AddressLine2').val(this.OfficeResComplainant_AddressLine2);
                                        $('#OfficeResComplainant_AddressStateCode').val(this.OfficeResComplainant_AddressStateCode);
                                        $('#OfficeResComplainant_AddressDistrictCode').val(this.OfficeResComplainant_AddressDistrictCode);
                                        $('#OfficeResComplainant_AddressPIN').val(this.OfficeResComplainant_AddressPIN);
                                        $('#RelatesComplaint_ComplaintAgainstType').val(this.RelatesComplaint_ComplaintAgainstType);
                                        $('#RelatesComplaint_ProjectAgent_RERA_RegNumber').val(this.RelatesComplaint_ProjectAgent_RERA_RegNumber);
                                        $('#RelatesComplaint_ProjectAgent_Name').val(this.RelatesComplaint_ProjectAgent_Name);
                                        $('#Respondent_Name').val(this.Respondent_Name);
                                        $('#IsComplaintTransferFromTo').val(this.IsComplaintTransferFromTo);
                                        $("input[name='IsComplaintTransferFromTo'][value=" + this.IsComplaintTransferFromTo + "]").attr('checked', 'checked');
                                        if (this.IsComplaintTransferFromTo != "NA") {
                                            $('#Complaint_TransferDiaryNumber_Name').val(this.Complaint_TransferDiaryNumber_Name);
                                            $("#rowTrCaseColH").addClass('show').removeClass('hide');
                                            $("#rowTrCaseCol01").addClass('show').removeClass('hide');
                                            $("#rowTrCaseCol02").addClass('show').removeClass('hide');
                                        }
                                        else {
                                            $("#rowTrCaseColH").addClass('hide').removeClass('show');
                                            $("#rowTrCaseCol01").addClass('hide').removeClass('show');
                                            $("#rowTrCaseCol02").addClass('hide').removeClass('show');
                                        }
                                    });
                                });
                            }
                            else {
                                alert('Invalid! Diary Number!');
                            }
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            };
        });

        $("#RERAnumberRegistration_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPCC").addClass('hide').removeClass('show');
        });

        var vcheckvalueregdextndate = $("input[name='IsComplaintTransferFromTo']:checked").val();
        if (vcheckvalueregdextndate != 'NA') {
            $("#rowTrCaseColH").addClass('show').removeClass('hide');
            $("#rowTrCaseCol01").addClass('show').removeClass('hide');
            $("#rowTrCaseCol02").addClass('show').removeClass('hide');
        }
        else {
            $("#rowTrCaseColH").addClass('hide').removeClass('show');
            $("#rowTrCaseCol01").addClass('hide').removeClass('show');
            $("#rowTrCaseCol02").addClass('hide').removeClass('show');
        }

        $(document).on('click', '.radio-casetrvalue', function (e) {
            if (this.value != 'NA') {
                $("#rowTrCaseColH").addClass('show').removeClass('hide');
                $("#rowTrCaseCol01").addClass('show').removeClass('hide');
                $("#rowTrCaseCol02").addClass('show').removeClass('hide');
            }
            else {
                $("#rowTrCaseColH").addClass('hide').removeClass('show');
                $("#rowTrCaseCol01").addClass('hide').removeClass('show');
                $("#rowTrCaseCol02").addClass('hide').removeClass('show');
            }
        });
    });
</script>
<script type="text/javascript">
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({

            type: "GET",
            url: baseUrl + "/HelpdeskControlPanel/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#OfficeResComplainant_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                    $("#OfficeResComplainant_AddressStateCode option:contains(undefined)").remove();
                });
            }
        });

        $('#OfficeResComplainant_AddressStateCode').change(function () {
            $('#OfficeResComplainant_AddressDistrictCode').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "/HelpdeskControlPanel/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#OfficeResComplainant_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#OfficeResComplainant_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
