@model CRUD.Models.HelpdeskControlPanel.ClsPrp_ControlPanel_View_FileRearrangementProjectDocumentDetails

@{
    Layout = null;
}

<script>
    jQuery.validator.addMethod("alphanumericcc", function (value, element) {
        return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
    }, "Special characters are not allowed.");

    $("#myform_CPprojectdocmodify").validate({
        rules: {
            ProjectDoc_InfoCode_Input: {
                required: true
            },
            ProjectDoc_InfoCode_ConfirmInput: {
                required: true
            },
            ProjectDoc_ReferenceNumber_Input: {
                required: true,
                maxlength: 90
            },
            Remarks_IfAny_Input: {
                required: true,
                maxlength: 300
            }
        },
        messages: {
            ProjectDoc_InfoCode_Input: {
                required: "this field is required"
            },
            ProjectDoc_InfoCode_ConfirmInput: {
                required: "this field is required"
            },
            ProjectDoc_ReferenceNumber_Input: {
                required: "this field is required",
                maxlength: "this field contains max {0} characters"
            },
            Remarks_IfAny_Input: {
                required: "this field is required",
                maxlength: "this field contains max {0} characters"
            }
        }
    });
</script>
<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        function saveOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "HelpdeskControlPanel/UpdateOptionsSetRearrangementProjectDocsDetail",
                data: data,
                success: function (d) {
                    if (d.status == true) {
                        alert(d.statusMessage);
                        var managerprojectdocsModal = $(document).find('#myModal');
                        $(managerprojectdocsModal).fadeOut(1000, function () {
                            $(managerprojectdocsModal).modal('hide');
                        });
                    }
                    else {
                        if (d.remarks == 'Error') {
                            alert(d.statusMessage);
                        }
                        else {
                            alert('Failed! Something went wrong');
                        }
                    }
                },
                error: function () {
                    alert("Oops! Something went wrong")
                }
            });
        }

        $("#saveOrder").click(function (e) {
            e.preventDefault();
            var orderArr = [];
            orderArr.length = 0;
            var isAllValid = false;

            if ($("input[name='IsUpdateModifyFlag_ProjectDocument']:checked").val() == '1') {
                if ($('#ProjectDoc_InfoCode_Input').val() != '' && $('#ProjectDoc_InfoCode_ConfirmInput').val() != '') {
                    var xpRegistrationNumber = $("#RERAnumberRegistration_Input").val(),
                        xpDiaryNumber = $("#ProjectDiaryNumber_Input").val(),
                        xpPreviousDocInfoCode = $("#ProjectDoc_InfoCode").val(),
                        xpDocInfoCode = $("#ProjectDoc_InfoCode_Input").val(),
                        xpConfirmDocInfoCode = $("#ProjectDoc_InfoCode_ConfirmInput").val(),
                        xpReferenceNumber = $("#ProjectDoc_ReferenceNumber_Input").val(),
                        xpRemarksIfAny = $("#Remarks_IfAny_Input").val();

                    if (xpDocInfoCode >= 0) {
                        if (xpConfirmDocInfoCode >= 0) {
                            if (xpDocInfoCode == xpConfirmDocInfoCode) {
                                if (xpDocInfoCode != xpPreviousDocInfoCode) {
                                    isAllValid = true;
                                }
                                else {
                                    alert('Invalid! The document name (for update/modify) (*) fields are required.');
                                    isAllValid = false;
                                }
                            }
                            else {
                                alert('Mismatched! The document name (for update/modify) (*) fields are mismatched.');
                                isAllValid = false;
                            }
                        }
                        else {
                            alert('Invalid! The confirm document name (for update/modify) (*) fields are invalid.');
                            isAllValid = false;
                        }
                    }
                    else {
                        alert('Invalid! The document name (for update/modify) (*) fields are invalid.');
                        isAllValid = false;
                    }
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                }
            }
            else {
                isAllValid = false;
            }

            if (isAllValid) {
                var r = confirm("Are you sure you want to save these document details?");
                if (r == true) {
                    var pProjectDocIndexID = $("#ProjectDoc_IndexID").val(),
                        pProjectDocID = $("#ProjectDoc_ID").val(),
                        pPromoterID = $("#Promoter_ID").val(),
                        pProjectID = $("#Project_ID").val(),
                        pProject_DiaryNumber = $("#Project_DiaryNumber").val(),
                        pProjectDocInfoCode = $("#ProjectDoc_InfoCode").val(),
                        pApplicationSearchFlag = $("#Application_SearchTypeFlag").val(),
                        pUpdateModifyFlag = $("input[name='IsUpdateModifyFlag_ProjectDocument']:checked").val(),
                        pRegistrationNumber = $("#RERAnumberRegistration_Input").val(),
                        pDiaryNumber = $("#ProjectDiaryNumber_Input").val(),
                        pDocInfoCode = $("#ProjectDoc_InfoCode_Input").val(),
                        pConfirmDocInfoCode = $("#ProjectDoc_InfoCode_ConfirmInput").val(),
                        pReferenceNumber = $("#ProjectDoc_ReferenceNumber_Input").val(),
                        pRemarksIfAny = $("#Remarks_IfAny_Input").val()
                        pExtra01_column = $("#Extra01_column").val(),
                        pExtra02_column = $("#Extra02_column").val(),
                        pRoleAccessFlag = $("#RoleAccessFlag").val();

                    orderArr.push({
                        ProjectDoc_IndexID: pProjectDocIndexID,
                        ProjectDoc_ID: pProjectDocID,
                        Promoter_ID: pPromoterID,
                        Project_ID: pProjectID,
                        Project_DiaryNumber: pProject_DiaryNumber,
                        ProjectDoc_InfoCode: pProjectDocInfoCode,
                        Application_SearchTypeFlag: pApplicationSearchFlag,
                        IsUpdateModifyFlag_ProjectDocument: pUpdateModifyFlag,
                        RERAnumberRegistration_Input: pRegistrationNumber,
                        ProjectDiaryNumber_Input: pDiaryNumber,
                        ProjectDoc_InfoCode_Input: pDocInfoCode,
                        ProjectDoc_InfoCode_ConfirmInput: pConfirmDocInfoCode,
                        ProjectDoc_ReferenceNumber_Input: pReferenceNumber,
                        Remarks_IfAny_Input: pRemarksIfAny,
                        Extra01_column: pExtra01_column,
                        Extra02_column: pExtra02_column,
                        RoleAccessFlag: pRoleAccessFlag,
                    });

                    var data = JSON.stringify({
                        requestobj: orderArr
                    });

                    $.when(saveOrder(data)).then(function (response) {
                        console.log(response);
                    }).fail(function (err) {
                        console.log(err);
                    });
                }
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var projectdocmodifymanagerModal = $(document).find('#myModal');
            $(projectdocmodifymanagerModal).fadeOut(1000, function () {
                $(projectdocmodifymanagerModal).modal('hide');
            });
        });
    });
</script>
<style>
    *.bgdisabled-color {
        background-color: #F0F0F0;
    }

    *.bgdisplay-color {
        background-color: #8fcedd;
    }

    .disclaimer-text {
        text-align: justify;
        text-justify: inter-word;
    }
</style>
<script>
    $(document).ready(function () {
        var vcheckoptionvalue = $("input[name='IsUpdateModifyFlag_ProjectDocument']:checked").val();
        if (vcheckoptionvalue == '1') {            
            $("#saveOrder").prop('disabled', false);
        }
        else {            
            $("#saveOrder").prop('disabled', true);
        };

        $(document).on('click', '.radio-modifyflagoptions', function (e) {
            if (this.value == '1') {
                $("#saveOrder").prop('disabled', false);
            }
            else {
                $("#saveOrder").prop('disabled', true);
            };
        });
    });
</script>

