                                                            @Html.EditorFor(model => model.ExtensionRegdDiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.ExtensionRegdDiaryNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Type of Project</label>
                                                        </div>
                                                        <div class="col-md-9">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.ProjectType, "PR", new { @class = "radio-typeprojectvalue" }) Residential
                                                                @Html.RadioButtonFor(model => model.ProjectType, "PC", new { @class = "radio-typeprojectvalue" }) Commercial
                                                                @Html.RadioButtonFor(model => model.ProjectType, "PI", new { @class = "radio-typeprojectvalue" }) Industrial
