                                                            @Html.ValidationMessageFor(model => model.AE_ReferenceDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.AE_EmailAddress, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Specify additional Email Address.">
                                                            @Html.EditorFor(model => model.AE_EmailAddress, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.AE_EmailAddress, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.AE_EmailType, htmlAttributes: new { @class = "control-label mand" })
                                                            @{
                                                                var listItemsEmailType = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                                    new SelectListItem {  Text = "Company Email" , Value="Company Email"  },
                                                                    new SelectListItem {  Text = "Employee Email" , Value="Employee Email"  },
                                                                    new SelectListItem {  Text = "Authorized Person" , Value="Authorized Person"  },
                                                                    new SelectListItem {  Text = "Other" , Value="Other"  },
                                                                };
                                                            }
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(model => model.AE_EmailType, new SelectList(listItemsEmailType, "Value", "Text"), new { @class = "form-control", @autocomplete = "off" })
                                                            @Html.ValidationMessageFor(model => model.AE_EmailType, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RemarksIfAny, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RemarksIfAny, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RemarksIfAny, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row hide" id="othersPCC">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Others</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">a.) Is valid for public view?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "1", new { id = "chkIsPublicViewY", @class = "radio-publicviewvalue", @checked = "checked" }) Yes
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "0", new { id = "chkIsPublicViewN", @class = "radio-publicviewvalue" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsPublicView, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">b.) Is Verified?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsVerified, "1", new { id = "chkIsVerifiedY", @class = "radio-IsVerifiedvalue", @checked = "checked" }) Yes
                                                                @Html.RadioButtonFor(model => model.IsVerified, "0", new { id = "chkIsVerifiedN", @class = "radio-IsVerifiedvalue" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsVerified, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>

                                <div class="row hide" id="submitPCC">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.RoleAccessFlag == "SA")
                                            {
                                                <input type="submit" value="@TempData["EmailAddressSubmitValue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else
                                            {
                                                if (Model.IsDraft == 1)
                                                {
                                                    <input type="submit" value="@TempData["EmailAddressSubmitValue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@TempData["EmailAddressSubmitValue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                }
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Email_ProjectEmailAddressDetail", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div id="viewProjectEmailsList">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

