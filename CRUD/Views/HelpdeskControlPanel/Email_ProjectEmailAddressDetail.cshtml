                                                            @Html.EditorFor(model => model.ProjectDiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.ProjectDiaryNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 hide" id="rowExtnDNoCol01">
