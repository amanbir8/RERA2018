                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="btnRequestOptionsEmailAddress" value="Proceed" class="btn btn-outline btn-primary" />
                                                <input type="Submit" id="btnListEmailAddress" value="View All Number(s)" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }

                            @using (Html.BeginForm("Email_ProjectEmailAddressDetail", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmRegisterEmailAddress" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Promoter_ID)
                                @Html.HiddenFor(m => m.Project_ID)

