@model CRUD.Models.HelpdeskControlPanel.ClsPrp_ControlPanel_View_Master_Project_RegistrationAreaZone

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<!-- DataTables JavaScript -->
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
<script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
<!-- Custom Theme JavaScript -->
<script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script> 

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskControlPanel/ExportMasterProjectZoneToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Authority Users</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Master with reference to Punjab State Real Estate (Regulation and Development) (First Amendment) Rules, 2020.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can apply updations.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }

    .bg-border-show {
        position: relative !important;
    }

    .border-left-danger {
        border-left: .15rem solid #FF4961 !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .bg-exclamation-triangle-warning {
        color: #FF4961 !important;
        display: inline-block !important;
    }

    .bg-exclamation-triangle-none {
        display: none !important;
    }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 2 Master Details: List of Project Registration Area Zone Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>                        
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.Mode)</th>
                                            <th>@Html.DisplayNameFor(model => model.Zone_TitleName)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.ResidentialPlotted_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.GroupHousing_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.Commercial_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.Industrial_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.CommonArea_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.ClubSchoolBuliding_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.EWS_ChargesPerSquareYard)</th>
                                            <th>@Html.DisplayNameFor(model => model.ActRegulationReference)</th>                                                                                       
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;                                            
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;                                                
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td>@Html.DisplayFor(modelItem => item.Mode)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Zone_TitleName)</td>                                                
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.ResidentialPlotted_ChargesPerSquareYard)</td>                                                
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.GroupHousing_ChargesPerSquareYard)</td>
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.Commercial_ChargesPerSquareYard)</td>
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.Industrial_ChargesPerSquareYard)</td>
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.CommonArea_ChargesPerSquareYard)</td>
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.ClubSchoolBuliding_ChargesPerSquareYard)</td>
                                                <td class="text-center">@Html.DisplayFor(modelItem => item.EWS_ChargesPerSquareYard)</td> 
                                                <td>@Html.DisplayFor(modelItem => item.ActRegulationReference)</td>                                               
                                            </tr>
                                        }                                     
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    
    <script>
        $(document).ready(function () {
            $('table#dataTables-example').DataTable({
                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],                
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
            });
        });
    </script>
}
