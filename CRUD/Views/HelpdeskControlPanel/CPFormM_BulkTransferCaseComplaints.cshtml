<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 30.1 List of Transfer Case(s) of Form-M Complaints
                    <span class="pull-right">
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm(new { enctype = "multipart/form-data", id = "myfrmMCaseBulkTransferSearchOptions" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Select Options</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Complaint Diary Number</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Diary Number(s) of Complaint(s), if any. e.g. GCNo0000YYYY, AdCNo0000YYYY">
                                                            @Html.EditorFor(model => model.ComplaintRegistrationNumber_Input, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.ComplaintRegistrationNumber_Input, "", new { @class = "text-danger" })
                                                        </div>                                                        
                                                        <div class="col-md-6">
                                                            <input type="Submit" id="btnRequestOptionsBTrCases" value="Proceed" class="btn btn-outline btn-primary" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            }

                            @using (Html.BeginForm("FormM_CaseTransferDetails", "HelpdeskComplaint", FormMethod.Post, new { enctype = "multipart/form-data", id = "myfrmMCaseBulkTransfer" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                @Html.HiddenFor(model => model.CaseTransfer_IndexID)
                                @Html.HiddenFor(model => model.CaseTransfer_ID)
                                @Html.HiddenFor(model => model.CaseTransfer_RegDiaryNumber_IndexName)
                                @Html.HiddenFor(model => model.CaseTransfer_RegDiaryNumber_NameYear)
                                @Html.HiddenFor(model => model.CaseTransfer_RegDiaryNumber_Name)
                                @Html.HiddenFor(model => model.ComplainantApplicant_RelatedComplaint_ID)
                                @Html.HiddenFor(model => model.ComplainantApplicant_RelatedComplaint_Code)
                                @Html.HiddenFor(model => model.ComplaintType_MN)
                                @Html.HiddenFor(model => model.Transfer_FromBenchName)
                                @Html.HiddenFor(model => model.Transfer_ToBenchName)

                                <div class="row hide" id="dnoTrBCase">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Transfer of Case Details</legend>
                                                <div class="row" id="dnocasetransfer" style="display:none;">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.CaseTransfer_RegDiaryNumber_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Reference Diary Number of Case Transfer between Bench/ Courts/ Form-M and Form-N">
                                                            @Html.DisplayFor(model => model.CaseTransfer_RegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.CaseTransfer_RegDiaryNumber_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.TransferTypeOption, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-9">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.TransferTypeOption, "TransferToAO", new { id = "chkTransferToAO", @class = "radio-casetrvalue", @checked = "checked" }) Transfer To AO
                                                                @Html.RadioButtonFor(model => model.TransferTypeOption, "TransferToAUTH", new { id = "chkTransferToAUTH", @class = "radio-casetrvalue" }) Transfer To Authority
                                                                @Html.RadioButtonFor(model => model.TransferTypeOption, "TransferToREGD", new { id = "chkTransferToREGD", @class = "radio-casetrvalue" }) Transfer To Registered Project
                                                                @Html.RadioButtonFor(model => model.TransferTypeOption, "TransferToOTH", new { id = "chkTransferToOTH", @class = "radio-casetrvalue" }) Any Other Case
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.TransferTypeOption, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.TransferDate, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Date of Case Transfer between Bench/ Courts as sent/provided by PS of the respective bench.">
                                                            @Html.EditorFor(model => model.TransferDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.TransferDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Transfer_FromBench, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Respective Bench of existing Preliminary-Hearing/ Hearing.">
                                                            @Html.DropDownListFor(m => m.Transfer_FromBench, new SelectList(Model.PreHearingBenchMaster, "PreHearingBenchCode", "PreHearingBenchName"), "Select", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Transfer_FromBench, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Transfer_ToBench, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(m => m.Transfer_ToBench, new SelectList(Model.PreHearingBenchMaster, "PreHearingBenchCode", "PreHearingBenchName"), "Select", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Transfer_ToBench, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" id="rowreranumberFilter" style="display:none;">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">RERA Registration Number</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="In case of case transfer to registered project, please specify the RERA registration number of the real-estate project/ real-estate agent.">
                                                            @Html.EditorFor(model => model.TransferOrderStatusRemark, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.TransferOrderStatusRemark, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Remarks_IfAny, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Remarks and status of complaint, if any.">
                                                            @Html.EditorFor(model => model.Remarks_IfAny, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Remarks_IfAny, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row hide" id="dnoTrBCaseOther">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Other Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label">Please check (Yes/No), If any?</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="control-label">a.) Is any transfer order issued?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsTransferOrder, "1", new { id = "chkTransferOrderY", @class = "radio-trordervalue" }) Yes
                                                                @Html.RadioButtonFor(model => model.IsTransferOrder, "0", new { id = "chkTransferOrderN", @class = "radio-trordervalue", @checked = "checked" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsTransferOrder, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row" id="rowTrOrderRefFilter" style="display:none;">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-3" data-toggle="tooltip" data-placement="right" title="Specify transfer order reference number and date of order as remarks, if any.">
                                                            @Html.EditorFor(model => model.TransferOrderStatusRemark, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ref Number and Date of Order", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.TransferOrderStatusRemark, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-3">
                                                            <label class="control-label">b.) Is continue with the same reference number/ diary number?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.C_column, "1", new { id = "chkIsSameDiaryNumberY", @class = "radio-samediarynumbervalue", @checked = "checked" }) Yes
                                                                @Html.RadioButtonFor(model => model.C_column, "0", new { id = "chkIsSameDiaryNumberN", @class = "radio-samediarynumbervalue" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.C_column, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-3">
                                                            <label class="control-label">c.) Has anything been entrusted or forwarded for action for follow-up before?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsFollowUpBefore, "1", new { id = "chkIsFollowUpBeforeY", @class = "radio-followupbeforevalue", @checked = "checked" }) Yes
                                                                @Html.RadioButtonFor(model => model.IsFollowUpBefore, "0", new { id = "chkIsFollowUpBeforeN", @class = "radio-followupbeforevalue" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsFollowUpBefore, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-offset-3 col-md-3">
                                                            <label class="control-label">d.) Is valid for public view?</label>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-group">
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "1", new { id = "chkIsPublicViewY", @class = "radio-publicviewvalue", @checked = "checked" }) Yes
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "0", new { id = "chkIsPublicViewN", @class = "radio-publicviewvalue" }) No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsPublicView, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                                <div class="row" id="rowPVFilter" style="display:none;">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.Label("Status (Public View), If Any", htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Public view remarks as complaint status of case transfer, if any.">
                                                            @Html.EditorFor(model => model.PublicViewStatus, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.PublicViewStatus, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row hide" id="dnoTrBCaseSubmit">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            @if (Model.IsCaseTransferlockUnlockFlag == 1)
                                            {
                                                <input type="submit" value="@TempData["CaseTransferMsubmitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                            }
                                            else
                                            {
                                                if (Model.IsDraft == 1)
                                                {
                                                    <input type="submit" value="@TempData["CaseTransferMsubmitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    <input type="submit" value="@TempData["CaseTransferMsubmitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                }
                                            }
                                            &nbsp;
                                            @Html.ActionLink("Reset", "CPFormM_BulkTransferCaseComplaints", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="row hide" id="dnoTrBCaseDisplay">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("SNo")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.CaseTransfer_RegDiaryNumber_Name)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Type of Case Transfer")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.TransferDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.ComplainantApplicant_RelatedComplaint_Code)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Transfer_FromBenchName)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Transfer_ToBenchName)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                        </th>
                                                        @*<th>
                                            @Html.DisplayNameFor(model => model.IsPublicView)
                                        </th>*@
                                                        <th>@Html.DisplayName("Edit| Delete")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int srnumber = 0;
                                                    }
                                                    @foreach (var item in Model.prpongoing)
                                                    {
                                                        {
                                                            srnumber = srnumber + 1;
                                                        }
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayName(srnumber.ToString())
                                                            </td>
                                                            <td class="complaint-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.CaseTransfer_RegDiaryNumber_Name)">
                                                                @Html.DisplayFor(modelItem => item.CaseTransfer_RegDiaryNumber_Name)
                                                                @Html.HiddenFor(modelItem => item.ComplainantApplicant_RelatedComplaint_ID, new { @class = "hdnComplaintID" })
                                                                @Html.HiddenFor(modelItem => item.CaseTransfer_ID, new { @class = "hdnHearingID" })
                                                            </td>
                                                            <td class="bench-name" data-bench-name="@Html.DisplayFor(modelItem => item.TransferTypeOption)">
                                                                @if (item.TransferTypeOption == "TransferToAO")
                                                                {
                                                                    @Html.DisplayName("Transfer To AO")
                                                                }
                                                                else if (item.TransferTypeOption == "TransferToAUTH")
                                                                {
                                                                    @Html.DisplayName("Transfer To Authority")
                                                                }
                                                                else if (item.TransferTypeOption == "TransferToREGD")
                                                                {
                                                                    @Html.DisplayName("Transfer To Registered Project")
                                                                    @Html.DisplayName(" (")
                                                                    @Html.DisplayFor(modelItem => item.TransferOrderStatusRemark)
                                                                    @Html.DisplayName(")")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("Transfer Case (Others)")
                                                                }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.TransferDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ComplainantApplicant_RelatedComplaint_Code)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Transfer_FromBenchName)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Transfer_ToBenchName)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                            </td>
                                                            @*<td>
                                                @if (item.IsPublicView == 1)
                                                {
                                                    @Html.DisplayName("Yes")
                                                }
                                                else
                                                {
                                                    @Html.DisplayName("No")
                                                }
                                            </td>*@
                                                            <td>
                                                                @if (Model.IsCaseTransferlockUnlockFlag == 1)
                                                                {
                                                                    @Html.ActionLink("View", "Edit_FormM_CaseTransferDetails", new { FormMCaseTrIndexID = item.CaseTransfer_IndexID, FormMCaseTrID = item.CaseTransfer_ID, ComplaintFmMID = item.ComplainantApplicant_RelatedComplaint_ID })
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsDraft != 1)
                                                                    {
                                                                        @Html.ActionLink("Edit", "Edit_FormM_CaseTransferDetails", new { FormMCaseTrIndexID = item.CaseTransfer_IndexID, FormMCaseTrID = item.CaseTransfer_ID, ComplaintFmMID = item.ComplainantApplicant_RelatedComplaint_ID }) @("| ")
                                                                        @Html.ActionLink("Delete", "Delete_FormM_CaseTransferDetails", new { FormMCaseTrIndexID = item.CaseTransfer_IndexID, FormMCaseTrID = item.CaseTransfer_ID, ComplaintFmMID = item.ComplainantApplicant_RelatedComplaint_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.ActionLink("View", "Edit_FormM_CaseTransferDetails", new { FormMCaseTrIndexID = item.CaseTransfer_IndexID, FormMCaseTrID = item.CaseTransfer_ID, ComplaintFmMID = item.ComplainantApplicant_RelatedComplaint_ID })
                                                                    }
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.col-lg-12 (nested) -->
                        </div>
                <!-- /.row (nested) -->
            </div>
            <!-- /.panel-body -->
        </div>
                <!-- /.panel -->
                    </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

