<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerTransferdetails);
    });

    function infohelpHandlerTransferdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Bulk Transfer of Case(s)</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Add diary numbers or reference numbers details e.g. GCNo0000YYYY or AdCNo0000YYYY.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can intialize the bulk transfer of complaint case(s) details.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');      

        $('[data-toggle="tooltip"]').tooltip();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [8]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers",

            responsive: true
        });

        if ($('#CaseTransfer_RegDiaryNumber_Name').val() === "0" || $('#CaseTransfer_RegDiaryNumber_Name').val() === "" || $('#CaseTransfer_RegDiaryNumber_Name').val() === " " || $('#CaseTransfer_RegDiaryNumber_Name').val() === "NA") {
            $('#dnocasetransfer').css("display", "none");
            $("input[name='TransferTypeOption']").attr('readonly', false);
        }
        else {
            $('#dnocasetransfer').css("display", "block");
            $("input[name='TransferTypeOption']").attr('readonly', true);
        }

        $(document).on('click', 'a#modalOpenerViewInterimOrderButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var FormM_Id = $.trim($(parentRow).find('input.hdnComplaintID').val());
            var HearingFormM_Id = $.trim($(parentRow).find('input.hdnHearingID').val());
            FormM_Id = parseInt(FormM_Id);
            HearingFormM_Id = parseInt(HearingFormM_Id);
            $.ajax({
                url: baseUrl + 'HelpdeskComplaint/FormMInfoInterimOrderDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'FormM_Id': FormM_Id, 'HearingFormM_Id': HearingFormM_Id },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.complaint-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.bench-name').attr('data-bench-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Details of Interim Order(s) - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (Bench: ' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();
        });

    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
    $(function () {
        $('#TransferDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
    });
</script>
<style>
    #customTopBtn {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 20px; /* Place the button at the bottom of the page */
        right: 30px; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #064576; /* Set a background color */
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #customTopBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
        }
</style>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        var vchecktrorder = $("input[name='IsTransferOrder']:checked").val();
        if (vchecktrorder == '1') {
            $("#rowTrOrderRefFilter").attr("style", "display:block");
        }
        else {
            $("#rowTrOrderRefFilter").attr("style", "display:none");
        }

        var vcheckpublicview = $("input[name='IsPublicView']:checked").val();
        if (vcheckpublicview == '1') {
            $("#rowPVFilter").attr("style", "display:block");
        }
        else {
            $("#rowPVFilter").attr("style", "display:none");
        }

        var vcheckcasetransfer = $("input[name='TransferTypeOption']:checked").val();
        if (vcheckcasetransfer == 'TransferToREGD') {
            $("#rowreranumberFilter").attr("style", "display:block");
        }
        else {
            $("#rowreranumberFilter").attr("style", "display:none");
        }

        $(document).on('click', '.radio-publicviewvalue', function (e) {
            if (this.value == '1') {
                $("#rowPVFilter").attr("style", "display:block");                
            }
            else {
                $("#rowPVFilter").attr("style", "display:none");
            }
        });

        $(document).on('click', '.radio-trordervalue', function (e) {
            if (this.value == '1') {
                $("#rowTrOrderRefFilter").attr("style", "display:block");
            }
            else {
                $("#rowTrOrderRefFilter").attr("style", "display:none");
            }
        });        

        $(document).on('click', '.radio-casetrvalue', function (e) {            
            if (this.value == 'TransferToREGD') {
                $("#rowreranumberFilter").attr("style", "display:block");                
            }
            else {
                $("#rowreranumberFilter").attr("style", "display:none");
            }

            var vcheckTrNumber = $('#CaseTransfer_RegDiaryNumber_Name').val();
            if (vcheckTrNumber === "0" || vcheckTrNumber === "" || vcheckTrNumber === " " || vcheckTrNumber === "NA") {
                return true;
            }
            else {
                alert('Oops! Invalid Transfer Type/ Option.');
                return false;
            }
        });   
    });
</script>

<script type="text/javascript">
		$(function() {
		    $("#TransferOrderStatusRemark").inputmask({ mask: function () { return ["AAAAAA-AAA99-AAA9999", "AAAAAA-AAA99-AA9999"]; } });

		    $('#Transfer_FromBench').change(function () {
		        $('#Transfer_FromBenchName').empty();
