                $(document).find(valprmconfirmShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(valprmconfirmShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionprmconfirmTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varprmconfirmFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varprmconfirmFlag = 1;
        };
        var srtitle = '#';
        var valprmconfirmShowId = srtitle.concat(srID);
        var len = valprmconfirmShowId.toString().trim().length;
        var res = valprmconfirmShowId.substring(17, len);
        var strpvstatus = '#prmconfirmtogglestatus';
        var valprmconfirmstatusShowId = strpvstatus.concat(res);
        switch (varprmconfirmFlag) {
            case 0:
                $(document).find(valprmconfirmShowId.trim()).removeClass('active');
                $(document).find(valprmconfirmstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(valprmconfirmShowId.trim()).addClass('active');
                $(document).find(valprmconfirmstatusShowId.trim()).removeClass('border-left-danger warning');
                break;
        }
    }
    function disableprmconfirmTogglebtnYN(srID) {
        var srtitle = '#';
        var valprmconfirmShowId = srtitle.concat(srID);
        $(document).find(valprmconfirmShowId.trim()).prop('disabled', true);
        $(document).find(valprmconfirmShowId.trim()).addClass("disabledlockunlock");
    }

    function setdefaultprjconfirmTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varprjconfirmFlag = 0;
        if (dataAction != '0') {
            //YPV(1) NPV(0)
            varprjconfirmFlag = 1;
        };
        var srtitle = '#';
        var valprjconfirmShowId = srtitle.concat(srID);
        switch (varprjconfirmFlag) {
            case 0:
                $(document).find(valprjconfirmShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(valprjconfirmShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionprjconfirmTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varprjconfirmFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varprjconfirmFlag = 1;
        };
        var srtitle = '#';
        var valprjconfirmShowId = srtitle.concat(srID);
        var len = valprjconfirmShowId.toString().trim().length;
        var res = valprjconfirmShowId.substring(17, len);
        var strpvstatus = '#prjconfirmtogglestatus';
        var valprjconfirmstatusShowId = strpvstatus.concat(res);
        switch (varprjconfirmFlag) {
            case 0:
                $(document).find(valprjconfirmShowId.trim()).removeClass('active');
                $(document).find(valprjconfirmstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(valprjconfirmShowId.trim()).addClass('active');
                $(document).find(valprjconfirmstatusShowId.trim()).removeClass('border-left-danger warning');
                break;
        }
    }
    function disableprjconfirmTogglebtnYN(srID) {
        var srtitle = '#';
        var valprjconfirmShowId = srtitle.concat(srID);
        $(document).find(valprjconfirmShowId.trim()).prop('disabled', true);
        $(document).find(valprjconfirmShowId.trim()).addClass("disabledlockunlock");
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 6.1 Project Edit Management: Lock-Unlock (Web-Portal Update Options) Details
                    <span class="pull-right">                        
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("ProjectEditManagementSuperLockUnlockListInfoDesk", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "PrjSpLockUnlockListInfoDesk" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Select Options</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Search For</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.IsApplicationModeFlag, "21", new { id = "chkUnlockRegdProject", @class = "radio-lockregdproject", @checked = "checked" }) Registered Project
                                                    @Html.RadioButtonFor(model => model.IsApplicationModeFlag, "22", new { id = "chkUnlockApplication", @class = "radio-lockapplication" }) Application for Registration of Project                                                    
                                                </label>
                                                @Html.ValidationMessageFor(model => model.IsApplicationModeFlag, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Type of Files</label>
                                                @{
                                                    var listItemsOptionName = new List<SelectListItem>
                                                    {
                                                        new SelectListItem {  Text = "Working File(s)" , Value="WorkFile"  },
                                                        new SelectListItem {  Text = "Unlocked File(s)" , Value="UnlockedFile"  },                                                        
                                                    };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.InputEntry_Option, new SelectList(listItemsOptionName, "Value", "Text"), "--Select--", new { @class = "form-control", @autocomplete = "off" })
                                                @Html.ValidationMessageFor(model => model.InputEntry_Option, "", new { @class = "text-danger" })                                                
                                            </div>                                            
                                            <div class="col-md-7">
                                                <input type="submit" id="ViewDetail" value="View Details" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectEditManagementSuperLockUnlockListInfoDesk", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>                                    
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="table-responsive">
                                        <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-controlpanel">
                                            <thead>
                                                <tr>
                                                    <th>@Html.DisplayName("SNo")</th>                                                    
                                                    <th>@Html.DisplayNameFor(model => model.ProjectRegDiaryNumber_Name)</th>
                                                    <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                                    <th>@Html.DisplayNameFor(model => model.RERAnumberRegistration)</th>
                                                    <th>@Html.DisplayNameFor(model => model.RERAnumberIssueDate)</th>
                                                    <th>@Html.DisplayNameFor(model => model.RERAnumberRegUptoDate)</th>
                                                    <th>@Html.DisplayNameFor(model => model.EventAction_Aggregate)</th>
                                                    <th>@Html.DisplayName("Status Date")</th> 
                                                    <th>@Html.DisplayName("Locked Enabled (Yes/No)?")</th>
                                                    <th>@Html.DisplayName("Promoter Master-Locked (Yes/No)?")</th>
                                                    <th>@Html.DisplayName("Project Master-Locked (Yes/No)?")</th>                                             
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int sno = 0;
                                                    string lockendtogglebtnID = string.Empty;
                                                    string lockendtogglestatusID = string.Empty;
                                                    string prmconfirmtogglebtnID = string.Empty;
                                                    string prmconfirmtogglestatusID = string.Empty;
                                                    string prjconfirmtogglebtnID = string.Empty;
                                                    string prjconfirmtogglestatusID = string.Empty;
                                                }
                                                @foreach (var item in Model.prpongoing)
                                                {
                                                    {
                                                        sno = sno + 1;
                                                        lockendtogglebtnID = "lockendtogglebtn" + @sno.ToString();
                                                        lockendtogglestatusID = "lockendtogglestatus" + @sno.ToString();
                                                        prmconfirmtogglebtnID = "prmconfirmtogglebtn" + @sno.ToString();
                                                        prmconfirmtogglestatusID = "prmconfirmtogglestatus" + @sno.ToString();
                                                        prjconfirmtogglebtnID = "prjconfirmtogglebtn" + @sno.ToString();
                                                        prjconfirmtogglestatusID = "prjconfirmtogglestatus" + @sno.ToString();
                                                    }
                                                    <tr class="odd gradeX">
                                                        <td>@Html.DisplayName(sno.ToString())</td>                                                        
                                                        <td class="text-center">@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                        <td class="text-center">
                                                            @Html.DisplayFor(modelItem => item.RERAnumberRegistration)
                                                            @Html.HiddenFor(modelItem => item.PrjSuperLockUnlock_RegDNProvider_IndexID, new { @class = "hdnIndexID" })
                                                            @Html.HiddenFor(modelItem => item.PrjSuperLockUnlock_RegDNProvider_ID, new { @class = "hdnID" })
                                                            @Html.HiddenFor(modelItem => item.Related_Promoter_ID, new { @class = "hdnPrmID" })
                                                            @Html.HiddenFor(modelItem => item.Related_Project_ID, new { @class = "hdnPrjID" })
                                                            @Html.HiddenFor(modelItem => item.Related_Reference_ID, new { @class = "hdnRefID" })
                                                        </td>
                                                        <td class="text-center">
                                                            @if (item.RERAnumberIssueDate != DateTime.MinValue)
                                                            {
                                                                @Html.DisplayFor(modelItem => item.RERAnumberIssueDate)
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("--")
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (item.RERAnumberRegUptoDate != DateTime.MinValue)
                                                            {
                                                                @Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("--")
                                                            }
                                                        </td>
                                                        <td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                        <td class="text-center">@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                        <td class="text-center">
                                                            @if (item.IsLockedConfirmed == 0)
                                                            {
                                                                if (Model.RoleAccessFlag == "PR")
                                                                {
                                                                    <script type="text/javascript">
                                                                        $(document).ready(function () {
                                                                            showlockendTogglebtnYN("@item.IsLockedEnable.ToString()", "@sno.ToString()");
                                                                        });
                                                                    </script>
                                                                    <button type="button" id=@lockendtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary btn-toggle-lockend" data-toggle="button" aria-pressed="false" autocomplete="off" title="Enable lock/unlock project details?">
                                                                        <div class="handle"></div>
                                                                    </button>                                                                
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsLockedEnable == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }
                                                                }
                                                            }
                                                            else
                                                            {                                                                
                                                                if (item.IsLockedEnable == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }                                                                
                                                            }
                                                        </td>                                                                                                                
                                                        <td class="text-center">
                                                            @if (item.IsLockedEnable == 1 && item.IsLockedConfirmed == 0)
                                                            {
                                                                if (Model.RoleAccessFlag == "SA" || Model.RoleAccessFlag == "PR")
                                                                {
                                                                    <script type="text/javascript">
                                                                        $(document).ready(function () {
                                                                            showprmconfirmTogglebtnYN("@item.IsLockPromoterDN.ToString()", "@sno.ToString()");
                                                                        });
                                                                    </script>
                                                                    <button type="button" id=@prmconfirmtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary btn-toggle-prmconfirm" data-toggle="button" aria-pressed="false" autocomplete="off" title="Is confirmed lock/unlock promoter details?">
                                                                        <div class="handle"></div>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsLockPromoterDN == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (item.IsLockPromoterDN == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (item.IsLockedEnable == 1 && item.IsLockedConfirmed == 0)
                                                            {
                                                                if (Model.RoleAccessFlag == "SA" || Model.RoleAccessFlag == "PR")
                                                                {
                                                                    <script type="text/javascript">
                                                                        $(document).ready(function () {
                                                                            showprjconfirmTogglebtnYN("@item.IsLockProjectDN.ToString()", "@item.IsLockQtrDN.ToString()", "@sno.ToString()");
                                                                        });
                                                                    </script>
                                                                    <button type="button" id=@prjconfirmtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary btn-toggle-prjconfirm" data-toggle="button" aria-pressed="false" autocomplete="off" title="Is confirmed lock/unlock project and quarterly details?">
                                                                        <div class="handle"></div>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsLockProjectDN == 1 && item.IsLockQtrDN == 1)
                                                                    {
                                                                        @Html.DisplayName("Yes")
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DisplayName("No")
                                                                    }
                                                                }
                                                            }
                                                            else
                                                            {
                                                                if (item.IsLockProjectDN == 1 && item.IsLockQtrDN == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            }
                                                        </td>                                                                                                                                                            
                                                    </tr>
                                                }
                                            </tbody>
