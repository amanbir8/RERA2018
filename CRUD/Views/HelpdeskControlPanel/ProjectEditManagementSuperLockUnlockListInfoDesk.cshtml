        $(document).ready(function () {
            $('table#dataTables-controlpanel').DataTable({
                responsive: true,
                "pageLength": 100,
                "lengthMenu": [[100, 100, 150, 200, 250], [100, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [8, 9, 10]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
