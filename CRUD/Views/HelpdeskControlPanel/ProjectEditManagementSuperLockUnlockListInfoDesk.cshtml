<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskControlPanel/ExportProjectEditManagementSuperLockUnlockToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Lock-Unlock Management</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can lock/unlock details of registered project.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }

    .bg-border-show {
        position: relative !important;
    }

    .border-left-danger {
        border-left: .15rem solid #FF4961 !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .bg-exclamation-triangle-warning {
        color: #FF4961 !important;
        display: inline-block !important;
    }

    .bg-exclamation-triangle-none {
        display: none !important;
    }
</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('.btn-toggle-lockend').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');

            var indexId = $.trim($(parentRow).find('input.hdnIndexID').val());
            var enableId = $.trim($(parentRow).find('input.hdnID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPrmID').val());
            var projectId = $.trim($(parentRow).find('input.hdnPrjID').val());
            var refId = $.trim($(parentRow).find('input.hdnRefID').val());

            var pmLockoutEnabled = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the lock/unlock options of real-estate project?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'HelpdeskControlPanel/LockedEnabledHandler_ProjectEditManagementListById',
                        data: { 'pmindexId': indexId, 'pmnameId': enableId, 'pmpromoterId': promoterId, 'pmprojectId': projectId, 'pmrefId': refId, 'pmLockoutEnabled': pmLockoutEnabled },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionlockendTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultlockendTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultlockendTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultlockendTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disablelockendTogglebtnYN(elemid);
            }
        });

        $('.btn-toggle-prmconfirm').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');

            var indexId = $.trim($(parentRow).find('input.hdnIndexID').val());
            var enableId = $.trim($(parentRow).find('input.hdnID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPrmID').val());
            var projectId = $.trim($(parentRow).find('input.hdnPrjID').val());
            var refId = $.trim($(parentRow).find('input.hdnRefID').val());

            var pmPromoterconfirm = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the promoter details (lock/unlock options) of real-estate project?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'HelpdeskControlPanel/LockedPrmConfirmEnabledHandler_ProjectEditManagementListById',
                        data: { 'pmindexId': indexId, 'pmnameId': enableId, 'pmpromoterId': promoterId, 'pmprojectId': projectId, 'pmrefId': refId, 'pmPromoterconfirm': pmPromoterconfirm },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionprmconfirmTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultprmconfirmTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultprmconfirmTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultprmconfirmTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disableprmconfirmTogglebtnYN(elemid);
            }
        });

        $('.btn-toggle-prjconfirm').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');

            var indexId = $.trim($(parentRow).find('input.hdnIndexID').val());
            var enableId = $.trim($(parentRow).find('input.hdnID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPrmID').val());
            var projectId = $.trim($(parentRow).find('input.hdnPrjID').val());
            var refId = $.trim($(parentRow).find('input.hdnRefID').val());

            var pmProjectconfirm = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the project and quarterly details (lock/unlock options) of real-estate project?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'HelpdeskControlPanel/LockedPrjConfirmEnabledHandler_ProjectEditManagementListById',
                        data: { 'pmindexId': indexId, 'pmnameId': enableId, 'pmpromoterId': promoterId, 'pmprojectId': projectId, 'pmrefId': refId, 'pmProjectconfirm': pmProjectconfirm },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionprjconfirmTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultprjconfirmTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultprjconfirmTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultprjconfirmTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disableprjconfirmTogglebtnYN(elemid);
            }
        });
    });

    function setdefaultlockendTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varlockendFlag = 0;
        if (dataAction != '0') {
            //YPV(1) NPV(0)
            varlockendFlag = 1;
        };
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        switch (varlockendFlag) {
            case 0:
                $(document).find(vallockendShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(vallockendShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionlockendTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varlockendFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varlockendFlag = 1;
        };
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        var len = vallockendShowId.toString().trim().length;
        var res = vallockendShowId.substring(17, len);
        var strpvstatus = '#lockendtogglestatus';
        var vallockendstatusShowId = strpvstatus.concat(res);
        switch (varlockendFlag) {
            case 0:
                $(document).find(vallockendShowId.trim()).removeClass('active');
                $(document).find(vallockendstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(vallockendShowId.trim()).addClass('active');
                $(document).find(vallockendstatusShowId.trim()).removeClass('border-left-danger warning');
                break;
        }
    }
    function disablelockendTogglebtnYN(srID) {
        var srtitle = '#';
        var vallockendShowId = srtitle.concat(srID);
        $(document).find(vallockendShowId.trim()).prop('disabled', true);
        $(document).find(vallockendShowId.trim()).addClass("disabledlockunlock");
    }

    function setdefaultprmconfirmTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varprmconfirmFlag = 0;
        if (dataAction != '0') {
            //YPV(1) NPV(0)
