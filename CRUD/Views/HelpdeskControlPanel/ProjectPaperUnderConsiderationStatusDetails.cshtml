                $("#rowPucDNo").addClass('show').removeClass('hide');
                $("#rowPucRefNo").addClass('hide').removeClass('show');
            }
            else if (this.value == '18') {
                $("#rowReraID").addClass('hide').removeClass('show');
                $("#rowPrjDNo").addClass('hide').removeClass('show');
                $("#rowPucDNo").addClass('hide').removeClass('show');
                $("#rowPucRefNo").addClass('show').removeClass('hide');
