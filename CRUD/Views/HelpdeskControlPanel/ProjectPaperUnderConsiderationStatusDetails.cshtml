<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerFileStatusButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            var promoterId = $.trim($(parentRow).find('input.hdnPromoterID').val());
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var pucId = $.trim($(parentRow).find('input.hdnPucID').val());
            var categoryId = $.trim($(parentRow).find('input.hdnCategoryID').val());
            promoterId = parseInt(promoterId);
            projectId = parseInt(projectId);
            pucId = parseInt(pucId);
            categoryId = parseInt(categoryId);
            $.ajax({
                url: BASE_URL + 'HelpdeskControlPanel/ProjectPUCdetailInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'promoterId': promoterId, 'projectId': projectId, 'pucId': pucId, 'categoryId': categoryId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 11.2 Status Details of Paper Under Considerations [PUC] of Registered Project
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>                        
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>                        
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            
                            @using (Html.BeginForm("ProjectPaperUnderConsiderationStatusDetails", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", id="frmPUCstatussearchOptions" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Search Options</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Search For</label>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.ReferenceNumberFlag_Input, "15", new { id = "chkReraRegistrationNumber", @class = "radio-pucregistration", @checked = "checked" }) RERA Number
                                                    @Html.RadioButtonFor(model => model.ReferenceNumberFlag_Input, "16", new { id = "chkProjectDNumber", @class = "radio-pucregistration" }) Project Diary Number
                                                    @Html.RadioButtonFor(model => model.ReferenceNumberFlag_Input, "17", new { id = "chkPucDNumber", @class = "radio-pucregistration" }) PUC Diary Number
                                                    @Html.RadioButtonFor(model => model.ReferenceNumberFlag_Input, "18", new { id = "chkReferencePUCNumber", @class = "radio-pucregistration" }) Reference PUC Number
                                                </label>
                                                @Html.ValidationMessageFor(model => model.ReferenceNumberFlag_Input, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowReraID">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Registration Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.RERAnumberRegistration_Input, new { htmlAttributes = new { @class = "form-control", @placeholder = "RERA Number", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.RERAnumberRegistration_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" value="Proceed" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectPaperUnderConsiderationStatusDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row hide" id="rowPrjDNo">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Project Diary Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ReferenceRegistrationProject_Input, new { htmlAttributes = new { @class = "form-control", @placeholder = "Project Diary Number", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.ReferenceRegistrationProject_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" value="Proceed" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectPaperUnderConsiderationStatusDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row hide" id="rowPucDNo">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">PUC Diary Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.ReferenceRegistrationPUC_Input, new { htmlAttributes = new { @class = "form-control", @placeholder = "Diary Number", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.ReferenceRegistrationPUC_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" value="Proceed" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectPaperUnderConsiderationStatusDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row hide" id="rowPucRefNo">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Reference PUC Number</label>
                                            </div>
                                            <div class="col-md-1">
                                                @Html.EditorFor(model => model.ReferenceNumber_Input, new { htmlAttributes = new { @class = "form-control", @placeholder = "PUC", @autocomplete = "off" } })                                                
                                                @Html.ValidationMessageFor(model => model.ReferenceNumber_Input, "", new { @class = "text-danger" })
                                            </div>                                            
                                            <div class="col-md-3">                                                
                                                @Html.EditorFor(model => model.ReferenceNumberDate_Input, new { htmlAttributes = new { @class = "form-control", @placeholder = "Reference Date", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.ReferenceNumberDate_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                <input type="Submit" value="Proceed" class="btn btn-outline btn-primary" />
                                                &nbsp;
                                                @Html.ActionLink("Cancel", "ProjectPaperUnderConsiderationStatusDetails", "HelpdeskControlPanel", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            @if (Model.prpongoing != null)
                                            {
                                                <table class="table table-striped table-bordered" id="puc-status-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@Html.DisplayName("Sr No")</th>                                                            
                                                            <th>
                                                                @Html.DisplayName("Diary Number")
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.dPUC_RequestCategoryName)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.RERA_RegistrationNumber)
                                                            </th>                                                                                                                                                                                   
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.ProjectName)
                                                            </th>                                                            
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.PUC_ReferencePUC_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.PUC_ReferencePUC_Date)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.EventAction_Aggregate)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.EventAction_IdentifiedOn)
                                                            </th>
                                                            <th>@Html.DisplayName("View Status")</th>                                                            
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            int snopccstatus = 0;
                                                        }
                                                        @foreach (var item in Model.prpongoing)
                                                        {
                                                            {
                                                                snopccstatus = snopccstatus + 1;
                                                            }
                                                            <tr>
                                                                <td>
                                                                    @Html.DisplayName(snopccstatus.ToString())
                                                                </td>                                                                
                                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.PUC_DiaryNumber)">
                                                                    @Html.DisplayFor(modelItem => item.PUC_DiaryNumber)
                                                                    @Html.DisplayName(" of ")
                                                                    @Html.DisplayFor(modelItem => item.Project_DiaryNumber)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.dPUC_RequestCategoryName)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.RERA_RegistrationNumber)
                                                                    @Html.HiddenFor(modelItem => item.dRelatedPromoter_ID, new { @class = "hdnPromoterID" })
                                                                    @Html.HiddenFor(modelItem => item.dRelatedProject_ID, new { @class = "hdnProjectID" })
                                                                    @Html.HiddenFor(modelItem => item.dRelatedApplicationPUC_ID, new { @class = "hdnPucID" })                                                                    
                                                                    @Html.HiddenFor(modelItem => item.dPUC_RequestCategoryID, new { @class = "hdnCategoryID" })
                                                                </td>
                                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.ProjectName)">
                                                                    @Html.DisplayFor(modelItem => item.ProjectName)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.PUC_ReferencePUC_Name)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.PUC_ReferencePUC_Date)
                                                                </td>
                                                                @if (item.EventAction_Type.ToString() == "910011")
                                                                {
                                                                    <td class="warning" title="Pending for updation under PUC Case(s)">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                                    <td class="info" title="Pending for updation under PUC Case(s)">@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                                }
                                                                else if (item.EventAction_Type.ToString() == "910002")
                                                                {
                                                                    <td class="success" title="Closed PUC Case(s)">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                                    <td class="info" title="Closed PUC Case(s)">@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>                                                                    
                                                                }
                                                                else
                                                                {
                                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                                }                                                                
                                                                <td class="center">
                                                                    <a id="modalOpenerFileStatusButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                                </td>                                                                
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
