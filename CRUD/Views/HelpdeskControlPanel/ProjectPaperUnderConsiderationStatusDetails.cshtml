<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;        

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskControlPanel/ExportProjectPaperUnderConsiderationToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Completion Certificate</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Search Project PUC details with reference to Registration Number/ RERA Number/ PUC Reference Number.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager/ Frontdesk can intialize the paper under considerations of registered project details.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
