@model CRUD.Models.HelpdeskControlPanel.ClsPrp_ControlPanel_View_UserManagerPassword

@{
    Layout = null;
}

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<link rel="stylesheet" href="@Url.Content("~/css-validator/style.css")" />

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        jQuery.validator.addMethod("stralphanumeric", function (value, element) {
            return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
        }, "Special characters are not allowed.");

        $("#myformResetUserManager").validate({
            rules: {
                usersEmailConfirmed: {
                    required: true
                },
                usersPhoneNumberConfirmed: {
                    required: true
                },
                usersTwoFactorEnabled: {
                    required: true
                },
                usersEmail: {
                    required: true,
                    email: true,
                    stralphanumeric: true
                },
                usersPhoneNumber: {
                    required: true,
                    number: true,
                    maxlength: 10,
                    minlength: 10
                }
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');
        
        function saveOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "HelpdeskControlPanel/UpdateOptionsUserManagementSetPasswordDetail",
                data: data,
                success: function (d) {
                    if (d.status == true) {
                        //console.log(d);
                        alert(d.statusMessage);

                        var usermanagerModal = $(document).find('#myModal');
                        $(usermanagerModal).fadeOut(1000, function () {
                            $(usermanagerModal).modal('hide');
                        });
                    }
                    else {
                        if (d.remarks == 'Error') {
                            alert(d.statusMessage);
                        }
                        else
                        {
                            alert('Failed! Something went wrong');
                        }                        
                    }
                },
                error: function () {
                    alert("oops! Something went wrong")
                }
            });
        }

        $("#saveOrder").click(function (e) {
            e.preventDefault();
            var orderArr = [];
            orderArr.length = 0;
            var isAllValid = false;

            if ($("input[name='users_IsDefaultPassword']:checked").val() == '0') {
                if ($('#users_New_Password').val() != '' && $('#users_Confirm_Password').val() != '') {
                    var xpUserPassword = $("#users_New_Password").val(),
                        xpUserConfirmPassword = $("#users_Confirm_Password").val(),
                        xpUserDefaultPassword = $("input[name='users_IsDefaultPassword']:checked").val(),
                        xpUserId = $("#usersId").val(),
                        xpUserRId = $("#rolesId").val(),
                        xpUserName = $("#usersUserName").val(),
                        xpUserRole = $("#pmRolesName").val(),
                        xpUserEmail = $("#pmEmailID").val(),
                        xpUserEmailConfirmed = $("#usersEmailConfirmed").val(),
                        xpUserPhoneConfirmed = $("#usersPhoneNumberConfirmed").val();

                    if (xpUserEmailConfirmed >= 0) {
                        if (xpUserDefaultPassword >= 0) {
                            isAllValid = true;
                        }
                        else {
                            alert('Invalid! The default password (*) fields are invalid.');
                            isAllValid = false;
                        }
                    }
                    else {
                        alert('Invalid! The user e-mail confirmation (*) fields are invalid.');
                        isAllValid = false;
                    }
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                }
            }
            else {
                isAllValid = true;
            }

            if (isAllValid) {
                var r = confirm("Are you sure you want to save these user details?");
                if (r == true) {
                    var pUserPassword = $("#users_New_Password").val(),
                    pUserConfirmPassword = $("#users_Confirm_Password").val(),
                    pUserDefaultPassword = $("input[name='users_IsDefaultPassword']:checked").val(),
                    pUserId = $("#usersId").val(),
                    pUserRId = $("#rolesId").val(),
                    pUserName = $("#usersUserName").val(),
                    pUserRole = $("#pmRolesName").val(),
                    pUserEmail = $("#pmEmailID").val(),
                    pUserEmailConfirmed = $("#usersEmailConfirmed").val(),
                    pUserPhoneConfirmed = $("#usersPhoneNumberConfirmed").val();

                    orderArr.push({
                        rolesId: pUserRId,
                        usersId: pUserId,
                        usersUserName: pUserName,
                        usersEmail: pUserEmail,
                        users_IsDefaultPassword: pUserDefaultPassword,
                        users_New_Password: pUserPassword,
                        users_Confirm_Password: pUserConfirmPassword,
                        rolesName: pUserRole,
                        usersEmailConfirmed: pUserEmailConfirmed,
                        usersPhoneNumberConfirmed: pUserPhoneConfirmed,
                    });

                    var data = JSON.stringify({
                        requestobj: orderArr
                    });

                    $.when(saveOrder(data)).then(function (response) {
                        console.log(response);
                    }).fail(function (err) {
                        console.log(err);
                    });
                }               
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var usermanagerModal = $(document).find('#myModal');
            $(usermanagerModal).fadeOut(1000, function () {
                $(usermanagerModal).modal('hide');
            });
        });
    });
</script>
<style>
    *.bgdisabled-color {  
        background-color: #F0F0F0;
    }
    *.bgdisplay-color {
        background-color: #8fcedd;
    }
    .disclaimer-text {
        text-align: justify;
        text-justify: inter-word;
    }
    *.displayfontbold-color {
        background-color: #F0F0F0;
        font-weight: bold;
    }

    #password-strength-status {
        padding: 5px 10px;
        color: #FFFFFF;
        border-radius: 4px;
        margin-top: 5px;
    }

    #password-match-status {
        padding: 5px 10px;
        color: #FFFFFF;
        border-radius: 4px;
        margin-top: 5px;
    }

    .medium-password {
        background-color: #b7d60a;
        border: #BBB418 1px solid;
    }

    .weak-password {
        background-color: #ce1d14;
        border: #AA4502 1px solid;
    }

    .strong-password {
        background-color: #12CC1A;
        border: #0FA015 1px solid;
    }
</style>
<script>
    function checkPasswordStrength() {
        var number = /([0-9])/;
        var alphabets = /([a-zA-Z])/;
        var special_characters = /([~,!,#,$,%,^,&,*,-,_,+,=,?,>,<])/;
        if ($('#users_New_Password').val().length < 6) {
            $('#password-strength-status').removeClass();
            $('#password-strength-status').addClass('weak-password');
            $('#password-strength-status').html("Weak (should be atleast 6 characters.)");
        } else {
            if ($('#users_New_Password').val().match(number) && $('#users_New_Password').val().match(alphabets) && $('#users_New_Password').val().match(special_characters)) {
                $('#password-strength-status').removeClass();
                $('#password-strength-status').addClass('strong-password');
                $('#password-strength-status').html("Strong");
            } else {
                $('#password-strength-status').removeClass();
                $('#password-strength-status').addClass('medium-password');
                $('#password-strength-status').html("Medium (should include alphabets, numbers and special characters.)");
            }
        }
    };

    function checkPasswordMatch() {
        var password = $("#users_New_Password").val();
        var confirmPassword = $("#users_Confirm_Password").val();
        if (password != confirmPassword){
            $('#password-match-status').removeClass();
            $('#password-match-status').addClass('weak-password');
            $('#password-match-status').html("Passwords does not match!");
        }            
        else {
            $('#password-match-status').removeClass();
            $('#password-match-status').addClass('strong-password');
            $('#password-match-status').html("Passwords match");
        }        
    };
</script>
<script>
    $(document).ready(function () {
        var vcheckoptionvalue = $("input[name='users_IsDefaultPassword']:checked").val();
        if (vcheckoptionvalue == '0') {
            $("#rowNewPwd").addClass('show').removeClass('hide');
            $("#rowComPwd").addClass('show').removeClass('hide');
            $("#rowDefPwd").addClass('hide').removeClass('show');            
        }
        else {
            $("#rowNewPwd").addClass('hide').removeClass('show');
            $("#rowComPwd").addClass('hide').removeClass('show');
            $("#rowDefPwd").addClass('show').removeClass('hide');
        };

        $(document).on('click', '.radio-defaultpasswordoptions', function (e) {
            if (this.value == '0') {
                $("#rowNewPwd").addClass('show').removeClass('hide');
                $("#rowComPwd").addClass('show').removeClass('hide');
                $("#rowDefPwd").addClass('hide').removeClass('show');
            }
            else {
                $("#rowNewPwd").addClass('hide').removeClass('show');
                $("#rowComPwd").addClass('hide').removeClass('show');
                $("#rowDefPwd").addClass('show').removeClass('hide');
            };
        });
    });
</script>

