</style>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
    function checkPasswordStrength() {
        var number = /([0-9])/;
        var alphabets = /([a-zA-Z])/;
        var special_characters = /([~,!,#,$,%,^,&,*,-,_,+,=,?,>,<])/;
        if ($('#Input_Password').val().length < 6) {
            $('#password-strength-status').removeClass();
            $('#password-strength-status').addClass('weak-password');
            $('#password-strength-status').html("Weak (should be atleast 6 characters.)");
        } else {
            if ($('#Input_Password').val().match(number) && $('#Input_Password').val().match(alphabets) && $('#Input_Password').val().match(special_characters)) {
                $('#password-strength-status').removeClass();
                $('#password-strength-status').addClass('strong-password');
                $('#password-strength-status').html("Strong");
            } else {
                $('#password-strength-status').removeClass();
                $('#password-strength-status').addClass('medium-password');
                $('#password-strength-status').html("Medium (should include alphabets, numbers and special characters.)");
            }
        }
    };
    function checkPasswordMatch() {
        var password = $("#Input_Password").val();
        var confirmPassword = $("#Input_ConfirmPassword").val();
        if (password != confirmPassword){
            $('#password-match-status').removeClass();
            $('#password-match-status').addClass('weak-password');
            $('#password-match-status').html("Passwords does not match!");
        }
        else {
            $('#password-match-status').removeClass();
            $('#password-match-status').addClass('strong-password');
            $('#password-match-status').html("Passwords match");
        }
    };
</script>
<script>
    $(document).ready(function () {
        var vcheckoptionvalue = $("input[name='IsApplicationModeFlag']:checked").val();
        if (vcheckoptionvalue == '31') {            
            $("#rowEmpNumber").addClass('hide').removeClass('show');
            $("#rowEmpName").addClass('hide').removeClass('show');            
            $("#rowEmpRole").addClass('hide').removeClass('show');
            $("#rowEmpOther").addClass('show').removeClass('hide');
        }
        else {
            $("#rowEmpNumber").addClass('show').removeClass('hide');
            $("#rowEmpName").addClass('show').removeClass('hide');
            $("#rowEmpRole").addClass('show').removeClass('hide');
            $("#rowEmpOther").addClass('hide').removeClass('show');
        };

        $(document).on('click', '.radio-typeuservalue', function (e) {
            if (this.value == '31') {
                $("#rowEmpNumber").addClass('hide').removeClass('show');
                $("#rowEmpName").addClass('hide').removeClass('show');
                $("#rowEmpRole").addClass('hide').removeClass('show');
                $("#rowEmpOther").addClass('show').removeClass('hide');
            }
            else {
                $("#rowEmpNumber").addClass('show').removeClass('hide');
                $("#rowEmpName").addClass('show').removeClass('hide');
                $("#rowEmpRole").addClass('show').removeClass('hide');
                $("#rowEmpOther").addClass('hide').removeClass('show');
            };
        });

        $(document).on('click', '#btnEraserText', function (e) {
            $("#Input_UserName").val('');
            $("#usersEmail").val('');
            $("#Input_Password").val('');
            $("#Input_ConfirmPassword").val('');
            $('#password-strength-status').removeClass();
            $('#password-strength-status').html("");
            $('#password-match-status').removeClass();
            $('#password-match-status').html("");
        });
    });
</script>
<script type="text/javascript">
    @if (TempData["returnSubmitMessage"].ToString() != "NA")
    {
        if (TempData["returnSubmitMessageFlag"].ToString() != "FlagNO")
        {
            <text>
                $(document).ready(function () {
                    var baseURL = $('body').attr('data-base-url');
                    var baseUrlCPvalue;

                    @if (TempData["returnUrlCPvalue"].ToString() != "")
                    {
                        <text>
                            baseUrlCPvalue = '@TempData["returnUrlCPvalue"]';
                        </text>
                    }

                    swal({
                        title: "Message",
                        text: "@TempData["returnSubmitMessage"]",
                        type: "success"
                    }, function () {
                        window.location = baseURL + baseUrlCPvalue;            
                    });
                });
            </text>
        }
        else
        {
            <text>
                $(document).ready(function () {
                    swal({
                        title: "Message",
                        text: "@TempData["returnSubmitMessage"]",
                        type: "warning",
                    }, function () {
                        return true;
                    });
                });
            </text>
        }
    }
</script>

