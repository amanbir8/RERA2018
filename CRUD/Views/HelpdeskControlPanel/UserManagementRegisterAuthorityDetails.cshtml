<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();

        var BASE_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Authority Users</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Only User can add /confirm /refuse Phone Number/Two-Factor Authentification.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> IT Manager can add authority user or confirm/disconfirm email.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .disabledlockunlock {
