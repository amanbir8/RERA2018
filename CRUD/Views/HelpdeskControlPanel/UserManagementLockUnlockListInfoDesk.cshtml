                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    
    <script>
        function showlockendTogglebtnYN(dataString, srNo) {
            var dataAction = dataString;
            var varlockendFlag = 0;
            if (dataAction != '0') {
                //YPV(1) NPV(0)
                varlockendFlag = 1;
            };

            var vallockendShowId = '#lockendtogglebtn' + srNo;
            var strpvstatus = '#lockendtogglestatus';
            var vallockendstatusShowId = strpvstatus.concat(srNo);
            switch (varlockendFlag) {
                case 0:
                    $(document).find(vallockendShowId.trim()).removeClass('active');
                    $(document).find(vallockendstatusShowId.trim()).addClass('border-left-danger warning');
                    break;
                case 1:
                    $(document).find(vallockendShowId.trim()).addClass('active');
                    $(document).find(vallockendstatusShowId.trim()).removeClass('border-left-danger warning');
                    break;
            }
        }
        function showemailconfirmTogglebtnYN(dataString, srNo) {
            var dataAction = dataString;
            var varemailconfirmFlag = 0;
            if (dataAction != '0') {
                //YPV(1) NPV(0)
                varemailconfirmFlag = 1;
            };

            var valemailconfirmShowId = '#emailontogglebtn' + srNo;
            var strpvstatus = '#emailontogglestatus';
            var valemailconfirmstatusShowId = strpvstatus.concat(srNo);
            switch (varemailconfirmFlag) {
                case 0:
                    $(document).find(valemailconfirmShowId.trim()).removeClass('active');
                    $(document).find(valemailconfirmstatusShowId.trim()).addClass('border-left-danger warning');
                    break;
                case 1:
                    $(document).find(valemailconfirmShowId.trim()).addClass('active');
                    $(document).find(valemailconfirmstatusShowId.trim()).removeClass('border-left-danger warning');
                    break;
            }
        }

        $(document).ready(function () {
            $('table#dataTables-example').DataTable({
                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [8, 9]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
            });
        });
    </script>
}
