<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script type="text/javascript">
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();
        $("#RERAnumberRegistration_Input").inputmask({ mask: function () { return ["AAAAAA-AAA99-AAA9999"]; } });
        $("#RERAnumberRegistration").inputmask({ mask: function () { return ["AAAAAA-AAA99-AAA9999"]; } });

        $('#RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#RERAnumberRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#LatestRenewalRegistrationIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#LatestRenewalRegistrationUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#AMN_ReferenceDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
	});
</script>
<script>
    $(document).ready(function () {
        $("#btnListMobileNumber").click(function (e) {
            e.preventDefault();
            var isAllvalueValid = false;
            if ($('#RERAnumberRegistration_Input').val() != '') {
                var input_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                var n = input_RegistrationNumber.length;

                if (parseInt(n) >= parseInt(19)) {
                    isAllvalueValid = true;
                }
                else {
                    alert('Invalid! Registration Number!');
                    isAllvalueValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllvalueValid = false;
            }

            if (isAllvalueValid) {
                var var_RegistrationNumber = $("#RERAnumberRegistration_Input").val();
                var realestateagentnumber = { 'strRERAnumber': var_RegistrationNumber };
                var baseURLn = $('body').attr('data-base-url');

                $.ajax({
                    type: "POST",
                    cache: false,
                    url: baseURLn + 'HelpdeskControlPanel/GetExistingMobileAgentNumberByID',
                    data: realestateagentnumber,
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data, xhr, settings) {
                        stopPreloader();
                        $("#dnoPCC").addClass('hide').removeClass('show');
                        $("#detailsPCC").addClass('hide').removeClass('show');
                        $("#othersPCC").addClass('hide').removeClass('show');
                        $("#submitPCC").addClass('hide').removeClass('show');
                        $('#viewAgentNumbersList').html(data);
                    },
                    error: function (xhr, textStatus, error) {
                        stopPreloader();
                        $('#viewAgentNumbersList').html(textStatus);
                    }
                });
            };
        });

        $("#btnRequestOptionsMobileNumber").click(function (e) {
            e.preventDefault();            
            var isAllValid = false;
            if ($('#RERAnumberRegistration_Input').val() != '') {
                var xpRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();                
                var n = xpRelated_RegistrationNumber.length;

                if (parseInt(n) >= parseInt(20)) {                    
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Registration Number!');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pRelated_RegistrationNumber = $("#RERAnumberRegistration_Input").val();

                Date.prototype.toShortFormat = function () {
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let day = this.getDate();
                    let day1 = (day < 10 ? '0' : '') + day;
                    let monthIndex = this.getMonth();
                    let monthName = monthNames[monthIndex];
                    let year = this.getFullYear();
                    return `${day1}-${monthName}-${year}`;
                };

                var BASE_URLn = $('body').attr('data-base-url');
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskControlPanel/GetExistingRegisteredAgentForMobileNumberByID',
                    datatype: "Json",
                    data: { "mRegNumber": pRelated_RegistrationNumber },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        if (data) {
                            if (data.status == true) {
                                $("#dnoPCC").addClass('show').removeClass('hide');
                                $("#detailsPCC").addClass('show').removeClass('hide');
                                $("#othersPCC").addClass('show').removeClass('hide');
                                $("#submitPCC").addClass('show').removeClass('hide');

                                $.each(data, function () {
                                    $(this).each(function () {
                                        $('#Agent_ID').val(this.Agent_ID);                                        
                                        $('#AgentRegDiaryNumber_Name').val(this.AgentRegDiaryNumber_Name);
                                        $('#LatestAgentRenewalRegDiaryNumber_Name').val(this.LatestAgentRenewalRegDiaryNumber_Name);
                                        $('#RERAnumberRegistration').val(this.RERAnumberRegistration);
                                        var getIssueDate = String(this.RERAnumberIssueDate);
                                        var getUptoDate = String(this.RERAnumberRegUptoDate);
                                        var dateIssueDate = new Date(parseInt(getIssueDate.substr(6)));
                                        var dateUptoDate = new Date(parseInt(getUptoDate.substr(6)));
                                        $('#RERAnumberIssueDate').val(dateIssueDate.toShortFormat());
                                        $('#RERAnumberRegUptoDate').val(dateUptoDate.toShortFormat());
                                        $('#RenewalAgent_ID').val(this.RenewalAgent_ID);
                                        $('#RenewalAgent_Year').val(this.RenewalAgent_Year);
                                        $('#AuthorizedPersonName').val(this.AuthorizedPersonName);
                                        $('#AgentRegisteredDistrict').val(this.AgentRegisteredDistrict);
                                        $('#AgentBussinessPlaceDistrict').val(this.AgentBussinessPlaceDistrict);
                                        $("input[name='Agent_Type'][value=" + this.Agent_Type + "]").attr('checked', 'checked');
                                        if (this.Agent_Type == 1) {
                                            $("#rowAgentNameColn").addClass('show').removeClass('hide');
                                            $("#rowOrgNameColn").addClass('hide').removeClass('show');
                                            $('#AgentName').val(this.AgentName);
                                        }
                                        else if (this.Agent_Type == 2) {
                                            $("#rowAgentNameColn").addClass('hide').removeClass('show');
                                            $("#rowOrgNameColn").addClass('show').removeClass('hide');
                                            $('#OrganizationName').val(this.OrganizationName);
                                        }
                                        $("input[name='IsRenewalRegistration'][value=" + this.IsRenewalRegistration + "]").attr('checked', 'checked');
                                        if (this.IsRenewalRegistration == 1) {
                                            $("#rowRenewalRegNoCol01").addClass('show').removeClass('hide');
                                            $("#rowRenewalRegNoCol02").addClass('show').removeClass('hide');
                                            $("#rowRenewalRegDateColn").addClass('show').removeClass('hide');
                                            $("#rowRenewalDNoCol01").addClass('show').removeClass('hide');
                                            $("#rowRenewalDNoCol02").addClass('show').removeClass('hide');
                                            var getRenewalIssueDate = String(this.LatestRenewalRegistrationIssueDate);
                                            var getRenewalUptoDate = String(this.LatestRenewalRegistrationUptoDate);
                                            var dateRenewalIssueDate = new Date(parseInt(getRenewalIssueDate.substr(6)));
                                            var dateRenewalUptoDate = new Date(parseInt(getRenewalUptoDate.substr(6)));
                                            $('#LatestRenewalRegistrationIssueDate').val(dateRenewalIssueDate.toShortFormat());
                                            $('#LatestRenewalRegistrationUptoDate').val(dateRenewalUptoDate.toShortFormat());
                                            $('#LatestRenewalRegistrationNumber').val(this.LatestRenewalRegistrationNumber);
                                        }
                                        else
                                        {
                                            $("#rowRenewalRegNoCol01").addClass('hide').removeClass('show');
                                            $("#rowRenewalRegNoCol02").addClass('hide').removeClass('show');
                                            $("#rowRenewalRegDateColn").addClass('hide').removeClass('show');
                                            $("#rowRenewalDNoCol01").addClass('hide').removeClass('show');
                                            $("#rowRenewalDNoCol02").addClass('hide').removeClass('show');
                                        }
                                    });
                                });
                            }
                            else {
                                alert('Invalid! Registration Number!');
                            }
                        }
                    },
                    error: function () {
                        alert("oops! Something went wrong")
                    }
                });
            };
        });

        $("#RERAnumberRegistration_Input").change(function (e) {
            e.preventDefault();
            $("#dnoPCC").addClass('hide').removeClass('show');
        });

        var vcheckvalueregdextndate = $("input[name='IsRenewalRegistration']:checked").val();
        if (vcheckvalueregdextndate == '1') {
            $("#rowRenewalRegNoCol01").addClass('show').removeClass('hide');
            $("#rowRenewalRegNoCol02").addClass('show').removeClass('hide');
            $("#rowRenewalRegDateColn").addClass('show').removeClass('hide');
            $("#rowRenewalDNoCol01").addClass('show').removeClass('hide');
            $("#rowRenewalDNoCol02").addClass('show').removeClass('hide');
        }
        else if (vcheckvalueregdextndate == '0') {
            $("#rowRenewalRegNoCol01").addClass('hide').removeClass('show');
            $("#rowRenewalRegNoCol02").addClass('hide').removeClass('show');
            $("#rowRenewalRegDateColn").addClass('hide').removeClass('show');
            $("#rowRenewalDNoCol01").addClass('hide').removeClass('show');
            $("#rowRenewalDNoCol02").addClass('hide').removeClass('show');
        };

        $(document).on('click', '.radio-typeagentregdextnvalue', function (e) {
            if (this.value == '1') {
                $("#rowRenewalRegNoCol01").addClass('show').removeClass('hide');
                $("#rowRenewalRegNoCol02").addClass('show').removeClass('hide');
                $("#rowRenewalRegDateColn").addClass('show').removeClass('hide');
                $("#rowRenewalDNoCol01").addClass('show').removeClass('hide');
                $("#rowRenewalDNoCol02").addClass('show').removeClass('hide');
            }
            else if (this.value == '0') {
                $("#rowRenewalRegNoCol01").addClass('hide').removeClass('show');
                $("#rowRenewalRegNoCol02").addClass('hide').removeClass('show');
                $("#rowRenewalRegDateColn").addClass('hide').removeClass('show');
                $("#rowRenewalDNoCol01").addClass('hide').removeClass('show');
                $("#rowRenewalDNoCol02").addClass('hide').removeClass('show');
            }
        });

        var vchecktypeagent = $("input[name='Agent_Type']:checked").val();
        if (vchecktypeagent == '1') {
            $("#rowAgentNameColn").addClass('show').removeClass('hide');
            $("#rowOrgNameColn").addClass('hide').removeClass('show');
        }
        else if (vchecktypeagent == '2') {
            $("#rowAgentNameColn").addClass('hide').removeClass('show');
            $("#rowOrgNameColn").addClass('show').removeClass('hide');
        };

        $(document).on('click', '.radio-typeagentvalue', function (e) {
            if (this.value == '1') {
                $("#rowAgentNameColn").addClass('show').removeClass('hide');
                $("#rowOrgNameColn").addClass('hide').removeClass('show');
            }
            else if (this.value == '2') {
                $("#rowAgentNameColn").addClass('hide').removeClass('show');
                $("#rowOrgNameColn").addClass('show').removeClass('hide');
            }
        });
    });
</script>
<script type="text/javascript">
    @if (TempData["MessageMobileNumber"].ToString() != "")
    {
        <text >
            $(document).ready(function () {
                swal({
                    title: "Message",
                    text: "@TempData["MessageMobileNumber"]",
                    type: "success"
                });
            });
        </text>
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 27.3 Additional Phone/ Fax/ Mobile/ Other Number(s) for Realestate Agent Details
                    <span class="pull-right">                        
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>                        
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            
                            @using (Html.BeginForm(new { enctype = "multipart/form-data", id= "frmMobileNumberSearchOptions" }))
                            {
                                @Html.AntiForgeryToken()
                                <fieldset class="col-md-12">
                                    <legend class="my">Select Options</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label">Registration Number</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.RERAnumberRegistration_Input, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.RERAnumberRegistration_Input, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="btnRequestOptionsMobileNumber" value="Proceed" class="btn btn-outline btn-primary" />
                                                <input type="Submit" id="btnListMobileNumber" value="View All Number(s)" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }

                            @using (Html.BeginForm("Mobile_AgentPhoneNumberDetail", "HelpdeskControlPanel", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmRegisterMobileNumber" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.Agent_ID)
                                @Html.HiddenFor(m => m.RenewalAgent_ID)
                                @Html.HiddenFor(m => m.RenewalAgent_Year)

                                <div class="row hide" id="dnoPCC">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Registration Number Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RERAnumberRegistration, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Reference RERA Registration Number of Real Estate Agent with the authority.">
                                                            @Html.EditorFor(model => model.RERAnumberRegistration, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.RERAnumberRegistration, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RERAnumberIssueDate, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RERAnumberIssueDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RERAnumberIssueDate, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RERAnumberRegUptoDate, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RERAnumberRegUptoDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.RERAnumberRegUptoDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.AgentRegDiaryNumber_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Reference Diary Number of Real Estate Agent Application with the authority.">
                                                            @Html.EditorFor(model => model.AgentRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.AgentRegDiaryNumber_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 hide" id="rowRenewalDNoCol01">
                                                            @Html.LabelFor(model => model.LatestAgentRenewalRegDiaryNumber_Name, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3 hide" id="rowRenewalDNoCol02" data-toggle="tooltip" data-placement="top" title="Reference Diary Number of Renewal of Real Estate Agent Registreation Application with the authority.">
                                                            @Html.EditorFor(model => model.LatestAgentRenewalRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.LatestAgentRenewalRegDiaryNumber_Name, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Type of Agent</label>
                                                        </div>
