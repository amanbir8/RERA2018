@model CRUD.Models.HelpdeskControlPanel.ClsPrp_ControlPanel_View_FileRearrangementAgentDocumentDetails

@{
    Layout = null;
}

<script>
    jQuery.validator.addMethod("cusalphanumeric", function (value, element) {
        return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
    }, "Special characters are not allowed.");

    $("#myform_CPagentdoctrash").validate({
        rules: {
            IsUpdateModifyFlag_AgentDocument: {
                required: true
            }
        },
        messages: {
            IsUpdateModifyFlag_AgentDocument: {
                required: "this field is required"
            }
        }
    });
</script>
<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        function deleteOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "HelpdeskControlPanel/DeleteFileRearrangementAgentDocsDetail",
                data: data,
                success: function (d) {
                    if (d.status == true) {
                        alert(d.statusMessage);
                        var manageragentdocsModal = $(document).find('#myModal');
                        $(manageragentdocsModal).fadeOut(1000, function () {
                            $(manageragentdocsModal).modal('hide');
                        });
                    }
                    else {
                        if (d.remarks == 'Error') {
                            alert(d.statusMessage);
                        }
                        else {
                            alert('Failed! Something went wrong');
                        }
                    }
                },
                error: function () {
                    alert("Oops! Something went wrong")
                }
            });
        }

        $("#deleteOrder").click(function (e) {
            e.preventDefault();
            var orderArr = [];
            orderArr.length = 0;
            var isAllValid = false;

            if ($("input[name='IsUpdateModifyFlag_AgentDocument']:checked").val() != '') {
                if ($("input[name='IsUpdateModifyFlag_AgentDocument']:checked").val() >= 0) {
                    var xpRegistrationNumber = $("#RERAnumberRegistration_Input").val(),
                        xpDiaryNumber = $("#AgentDiaryNumber_Input").val(),
                        xpPreviousDocInfoCode = $("#AgentDoc_InfoCode").val(),                        
                        xpFlagProjectDocument = $("input[name='IsUpdateModifyFlag_AgentDocument']:checked").val();

                    if (xpFlagProjectDocument >= 0) {
                        isAllValid = true;                        
                    }
                    else {
                        alert('Invalid! The options (trash/delete/modify) (*) fields are invalid.');
                        isAllValid = false;
                    }
                }
                else {
                    alert('The mandatory (*) fields are required.');
                    isAllValid = false;
                }
            }
            else {
                isAllValid = false;
            }

            if (isAllValid) {
                var r = confirm("Are you sure you want to trash/delete these document details?");
                if (r == true) {
                    var pAgentDocIndexID = $("#AgentDoc_IndexID").val(),
                        pAgentDocID = $("#AgentDoc_ID").val(),
                        pAgentID = $("#Agent_ID").val(),                        
                        pAgent_DiaryNumber = $("#Agent_DiaryNumber").val(),
                        pAgentDocInfoCode = $("#AgentDoc_InfoCode").val(),
                        pApplicationSearchFlag = $("#Application_SearchTypeFlag").val(),
                        pUpdateModifyFlag = $("input[name='IsUpdateModifyFlag_AgentDocument']:checked").val(),
                        pRegistrationNumber = $("#RERAnumberRegistration_Input").val(),
                        pDiaryNumber = $("#AgentDiaryNumber_Input").val(),
                        pExtra01_column = $("#Extra01_column").val(),
                        pExtra02_column = $("#Extra02_column").val(),
                        pRoleAccessFlag = $("#RoleAccessFlag").val();

                    orderArr.push({
                        AgentDoc_IndexID: pAgentDocIndexID,
                        AgentDoc_ID: pAgentDocID,
                        Agent_ID: pAgentID,
                        AgentRenewal_ID: 0,
                        Agent_DiaryNumber: pAgent_DiaryNumber,
                        AgentDoc_InfoCode: pAgentDocInfoCode,
                        Application_SearchTypeFlag: pApplicationSearchFlag,
                        IsUpdateModifyFlag_AgentDocument: pUpdateModifyFlag,
                        RERAnumberRegistration_Input: pRegistrationNumber,
                        AgentDiaryNumber_Input: pDiaryNumber,                        
                        Extra01_column: pExtra01_column,
                        Extra02_column: pExtra02_column,
                        RoleAccessFlag: pRoleAccessFlag,
                    });

                    var data = JSON.stringify({
                        requestobj: orderArr
                    });

                    $.when(deleteOrder(data)).then(function (response) {
                        console.log(response);
                    }).fail(function (err) {
                        console.log(err);
                    });
                }
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var agentdocmodifymanagerModal = $(document).find('#myModal');
            $(agentdocmodifymanagerModal).fadeOut(1000, function () {
                $(agentdocmodifymanagerModal).modal('hide');
            });
        });
    });
</script>
<style>
    *.bgdisabled-color {
        background-color: #F0F0F0;
    }

    *.bgdisplay-color {
        background-color: #8fcedd;
    }

    .disclaimer-text {
        text-align: justify;
        text-justify: inter-word;
    }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm(new { enctype = "multipart/form-data", id = "myform_CPagentdoctrash" }))
                            {
                                @Html.HiddenFor(model => model.AgentDoc_IndexID)
                                @Html.HiddenFor(model => model.AgentDoc_ID)
                                @Html.HiddenFor(model => model.Agent_ID)
                                @Html.HiddenFor(model => model.AgentRenewal_ID)
                                @Html.HiddenFor(model => model.Application_SearchTypeFlag)
                                @Html.HiddenFor(model => model.Agent_DiaryNumber)
                                @Html.HiddenFor(model => model.Agent_Name)
                                @Html.HiddenFor(model => model.AgentAddressDistrict, htmlAttributes: new { @id = "pmAgentAddDist" })
                                @Html.HiddenFor(model => model.AgentDoc_InfoCode)
                                @Html.HiddenFor(model => model.AgentDoc_ReferenceNumber)
                                @Html.HiddenFor(model => model.Remarks_IfAny)
                                @Html.HiddenFor(model => model.Extra01_column)
                                @Html.HiddenFor(model => model.Extra02_column)
                                @Html.HiddenFor(model => model.RoleAccessFlag)

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-12">
                                                        <label class="control-label">(A.) Selected Document Details</label>
                                                    </div>                                                    
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(i.) Diary Number (Agent)</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.EditorFor(model => model.Agent_DiaryNumber, new { htmlAttributes = new { @class = "form-control bgdisabled-color", @disabled = "disabled", @autocomplete = "off" } })
                                                        @Html.ValidationMessageFor(model => model.Agent_DiaryNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(ii.) Agent Name</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.EditorFor(model => model.Agent_Name, new { htmlAttributes = new { @class = "form-control bgdisabled-color", @disabled = "disabled", @autocomplete = "off" } })
                                                        @Html.ValidationMessageFor(model => model.Agent_Name, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(iii.) Agent Address District Name</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.EditorFor(model => model.AgentAddressDistrict, new { htmlAttributes = new { @class = "form-control bgdisabled-color", @disabled = "disabled", @autocomplete = "off" } })
                                                        @Html.ValidationMessageFor(model => model.AgentAddressDistrict, "", new { @class = "text-danger" })                                                       
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(iv.) Document Name (Selected)</label>                                                        
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.DropDownListFor(model => model.AgentDoc_InfoCode, new SelectList(Model.prpMasterDocs, "AgentDocMaster_InfoCode", "AgentDocMaster_InfoName"), "Select", new { @class = "form-control bgdisabled-color", @disabled = "disabled" })
                                                        @Html.ValidationMessageFor(model => model.AgentDoc_InfoCode, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(v.) Reference Number (Selected)</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.EditorFor(model => model.AgentDoc_ReferenceNumber, new { htmlAttributes = new { @class = "form-control bgdisabled-color", @disabled = "disabled", @autocomplete = "off" } })
                                                        @Html.ValidationMessageFor(model => model.AgentDoc_ReferenceNumber, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>                                            
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(vi.) Remarks, If Any (Selected)</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.EditorFor(model => model.Remarks_IfAny, new { htmlAttributes = new { @class = "form-control bgdisabled-color", @disabled = "disabled", @autocomplete = "off" } })
                                                        @Html.ValidationMessageFor(model => model.Remarks_IfAny, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>                                            
                                            <hr/>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-12">
                                                        <label class="control-label">(B.) Trash/ Delete or Modify Document Details?</label>                                                    
                                                    </div>                                                    
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="control-label">(i.) Select Options?</label>                                                        
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-group">
                                                            @Html.RadioButtonFor(model => model.IsUpdateModifyFlag_AgentDocument, "2", new { @id = "chkmodifyflagoptionsTRH", @class = "radio-trahflagoptions", @checked = "checked" }) Trash
                                                            @Html.RadioButtonFor(model => model.IsUpdateModifyFlag_AgentDocument, "3", new { @id = "chkmodifyflagoptionsDEL", @class = "radio-trahflagoptions" }) Delete
                                                            @Html.RadioButtonFor(model => model.IsUpdateModifyFlag_AgentDocument, "4", new { @id = "chkmodifyflagoptionsNPV", @class = "radio-trahflagoptions" }) Other (Not Applicable for Public View)
                                                        </label>
                                                        @Html.ValidationMessageFor(model => model.IsUpdateModifyFlag_AgentDocument, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-lg-12 text-right">
                                            <button type="button" id="deleteOrder" class="btn btn-primary"><i class="fa fa-refresh"></i> Submit</button>
                                            <button type="button" id="cancelOrder" class="btn btn-primary"><i class="fa fa-times"></i> Cancel</button>
                                        </div>
                                    </div>
                                </div>
                           }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}