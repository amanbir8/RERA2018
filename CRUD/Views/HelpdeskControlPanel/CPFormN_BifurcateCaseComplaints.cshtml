@model CRUD.Models.HelpdeskComplaint.ClsPrp_AuthDesk_FormN_DiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [7]
            }]
        });

        $(document).ready(function () {
            $('[data-toggle="popover"]').popover({
                title: false,
                content: setData,
                html: true,
                placement: 'right'
            });

            function setData(id) {
                var set_data = '';
                var element = $(this);
                var parentRow = $(element).parents('tr');

                var popRelatedType = $.trim($(parentRow).find('input.hdnRelatedType').val());
                var popRelatedName = $.trim($(parentRow).find('input.hdnRelatedName').val());
                var popRelatedRERA = $.trim($(parentRow).find('input.hdnRelatedRERA').val());

                set_data = '<div class="row" style="line-height:23px; margin-top:10px;">' +
                                '<div class="col-lg-12">' +
                                    '<div><span style="font-weight:bold;">RERA No:</span>  ' + popRelatedRERA + '</div>' +
                                    '<div><span style="font-weight:bold;">Complaint Against:</span>  ' + popRelatedType + '</div>' +
                                    '<div><span style="font-weight:bold;">Project/Agent:</span>  ' + popRelatedName + '</div>' +
                                '</div>' +
                            '</div>';
                return set_data;
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASExn_URL = $('body').attr('data-base-url');
        var getUrlCPvalue;

        @if (TempData["returnUrlCPvalue"].ToString() != "")
        {
            <text>
                getUrlCPvalue = '@TempData["returnUrlCPvalue"]';
            </text>
        }

        $(document).on('click', 'a.controlpanelHomeButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + getUrlCPvalue;
        });

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASExn_URL + 'HelpdeskControlPanel/CP_BifurcateCaseComplaintsFormN_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerComplaintFormNdetails);
    });
    function infohelpHandlerComplaintFormNdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Complaint Form-N (Bifurcation of Case) regarding real-estate project/ agent/ allottee(s).<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Control Panel</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Control Panel : CP 29.2 List of Bifurcate Case(s) of Form-N Complaints
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="controlpanelHomeButton" href="javascript:void(0);" title="Home"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-home" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.ComplaintRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayNameFor(model => model.RelatesComplaint_ComplaintAgainstType)</th>
                                            <th>@Html.DisplayNameFor(model => model.Complainant_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Respondent_Name)</th>                                            
                                            <th>@Html.DisplayName("Request Date")</th>
                                            <th>@Html.DisplayName("Action")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="agent-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ComplaintRegDiaryNumber_Name)</td>
                                                <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                <td>
                                                    <a href="javascript:void(0);" data-toggle="popover" data-trigger="hover" id="@Html.DisplayFor(modelItem => item.A_column)">@Html.DisplayFor(modelItem => item.A_column)</a>
                                                    @Html.HiddenFor(modelItem => item.RelatesComplaint_ComplaintAgainstType, new { @class = "hdnRelatedType" })
                                                    @Html.HiddenFor(modelItem => item.B_column, new { @class = "hdnRelatedName" })
                                                    @Html.HiddenFor(modelItem => item.A_column, new { @class = "hdnRelatedRERA" })
                                                </td>
                                                <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.Complainant_Name)">@Html.DisplayFor(modelItem => item.Complainant_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Respondent_Name)
                                                    @Html.HiddenFor(modelItem => item.FormN_RelatedComplaint_ID, new { @class = "hdnAgentID" })
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a href="javascript:void(0);" class="btn btn-outline btn-xs btn-primary">Confirm</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" /> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
