<script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpText = $(document).find("select#ProjectApprovalRelated_ProjectRegistration_ID").val();
            //alert(drpText)
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                // $("#idMainForm").hide();
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#ProjectApprovalRelated_ProjectRegistration_ID").val();
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                //$("#idMainForm").hide();
                drpText = "";
                return false;
            }
            else {

                //"photo address" have value on submit button
                //and "user_photo" have value on update button
                //so check length of control on save (files.length) and update (path.length)

                var files = $("#Photo_Address").get(0).files;
                var path = $('#user_Photo').attr('src').replace('/', '');


                if (files.length > 0 || path.length > 0) {
                    $(submitButton).parents('form').submit();
                    // $("#idMainForm").show();
                }
                else {
                    alert("Please Add Document file to Upload!")
                    return false;
                }
                //var files = ($("#Photo_Address"))[0].files[0];
                //if (files) {
                //    $(submitButton).parents('form').submit();
                //    // $("#idMainForm").show();
                //}
                //else {
                //    alert("Please Add Document file to Upload!")
                //    return false;
                //}                
            }
        });

        $('[data-toggle="tooltip"]').tooltip();

    });

    var baseUrl = $('body').attr('data-base-url');

    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                //$('#user_Photo').attr('src', e.target.result);
                var selectedFile = input.files[0];
                var imageType = 'image/jpeg';
                if (selectedFile.type.match(imageType)) {
                    $('#user_Photo').attr('src', e.target.result);
                }
                if (selectedFile.type.match('application/pdf')) {
                    var dataURL = baseUrl + 'images/pdf-icon.gif';
                    $('#user_Photo').attr('src', dataURL);
                    $('#user_Photo').attr('width', '78');
                    $('#user_Photo').attr('height', '78');
                }
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }
</script>
<script>
$(function() {
    $('[data-spzoom]').spzoom();

    $('table#promoter-documents-list-table').dataTable({
        'aoColumnDefs': [{
            'bSortable': false,
            'aTargets': [4, 5]
        }],
        "language": {
            "info": "Showing _START_ to _END_ of _TOTAL_ records",
            "lengthMenu": "Show _MENU_ records"
        },
        "pagingType": "full_numbers"
    });
});
</script>
<script>
          $(
        function ()
        {

            $('#Date_ApplicationPlannedorExpectedReceipt').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });



            if ($('#A_column').val() != "") {
                $('#div_otherspecifydoc').show();
            }
            else {
                $('#div_otherspecifydoc').hide();
                $('#A_column').val("");
            }


            $('#DocumentType_Name').change(function () {

                if ($("#DocumentType_Name").val() != "Other Document") {
                    $('#div_otherspecifydoc').hide();
                    $('#A_column').val("");
                }
                else
                {
                    $('#div_otherspecifydoc').show();
                }
            });

        });

</script> 
<style>
    .th-align-text {
        text-align: center;
    }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Project Approval(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
