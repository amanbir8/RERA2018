                        <div class="col-lg-12">

                            @using (Html.BeginForm("DropdownlistProjectApproval", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Project</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label">Select Project</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(m => m.ProjectApprovalRelated_ProjectRegistration_ID, new SelectList((System.Collections.IEnumerable)TempData["list"], "ProjectRegistration_ID", "Project_Name"), "Select Project", new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="BtnDrp" value="Proceed" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div @if (Session["Project_id"] != null) { @Html.Raw("style=''")        } else { @Html.Raw("style='display: none;'")        }>
                                @using (Html.BeginForm("Create_ApprovalDetails", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    @Html.HiddenFor(model => model.ProjectApproval_IndexID, htmlAttributes: new { @class = "control-label" })
                                    @Html.HiddenFor(model => model.ProjectApproval_ID, htmlAttributes: new { @class = "control-label" })
                                    @Html.HiddenFor(model => model.ProjectApprovalRelated_ProjectRegistration_ID, htmlAttributes: new { @class = "control-label" })

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Project Approval Details</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @{var listItemsDocTypeName = new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem {  Text = "..." , Value=""  },
                                                                        new SelectListItem {  Text = "AAI Height NOC from Civil Aviation Department/ Airport Authority" , Value="AAI Height NOC from Civil Aviation Department/ Airport Authority"  },
                                                                        new SelectListItem {  Text = "Amendments or revisions in sanctioned Layout/ Sanction / Building Plan" , Value="Amendments or revisions in sanctioned Layout/ Sanction / Building Plan"  },
                                                                        new SelectListItem {  Text = "Application for Occupancy/ Completion/ Phase Completion Certificate" , Value="Application for Occupancy/ Completion/ Phase Completion Certificate"  },
                                                                        new SelectListItem {  Text = "Application for renewal of any of the NOCs/ Licenses" , Value="Application for renewal of any of the NOCs/ Licenses"  },
                                                                        new SelectListItem {  Text = "Borewell Registration certificate from Central Ground Water Authority" , Value="Borewell Registration certificate from Central Ground Water Authority"  },
                                                                        new SelectListItem {  Text = "Building Permit Issue from Municipal Authority" , Value="Building Permit Issue from Municipal Authority"  },
                                                                        new SelectListItem {  Text = "Completion/ Phase Completion certificate from Municipal/ Competent Authority" , Value="Completion/ Phase Completion certificate from Municipal/ Competent Authority"  },
                                                                        new SelectListItem {  Text = "Defense Clearance" , Value="Defense Clearance"  },

                                                                        new SelectListItem {  Text = "Electric Substation NOC" , Value="Electric Substation NOC"  },
                                                                        new SelectListItem {  Text = "Environment Clearance certificate/ NOC" , Value="Environment Clearance certificate/ NOC"  },
                                                                        new SelectListItem {  Text = "License as Promoter from competent Authority" , Value="License as Promoter from competent Authority"  },
                                                                        new SelectListItem {  Text = "NOC from Fire Department/ Chief Fire Officer" , Value="NOC from Fire Department/ Chief Fire Officer"  },
                                                                        new SelectListItem {  Text = "NOC from Mining Department" , Value="NOC from Mining Department"  },
                                                                        new SelectListItem {  Text = "NOC from NHAI/ PWD" , Value="NOC from NHAI/ PWD"  },

                                                                        new SelectListItem {  Text = "Occupancy Certificate from Municipal/ Competent Authority" , Value="Occupancy Certificate from Municipal/ Competent Authority"  },
                                                                        new SelectListItem {  Text = "Pollution Clearance from Punjab Pollution Control Board" , Value="Pollution Clearance from Punjab Pollution Control Board"  },
                                                                        new SelectListItem {  Text = "Other Document" , Value="Other Document"  },
                                                                    };
                                                                }
                                                                @Html.LabelFor(model => model.DocumentType_Name, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">                                                                
                                                                @Html.DropDownListFor(model => model.DocumentType_Name, new SelectList(listItemsDocTypeName, "Value", "Text"), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.DocumentType_Name, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @{var listItems3 = new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem {  Text = "..." , Value=""  },
                                                                        new SelectListItem {  Text = "Approvals" , Value="Approvals"  },
                                                                        new SelectListItem {  Text = "Permissions" , Value="Permissions"  },
                                                                        new SelectListItem {  Text = "Clearances" , Value="Clearances"  },
                                                                        new SelectListItem {  Text = "Modifications" , Value="Modifications"  },
                                                                        new SelectListItem {  Text = "Amendments" , Value="Amendments"  },
                                                                        new SelectListItem {  Text = "Revisions" , Value="Revisions"  },
                                                                        new SelectListItem {  Text = "Approvals" , Value="Approvals"  },
                                                                        new SelectListItem {  Text = "Legal Documents" , Value="Legal Documents"  },
                                                                    };
                                                                }
                                                                @Html.LabelFor(model => model.DocumentType_CategoryName, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.DocumentType_CategoryName, new SelectList(listItems3, "Value", "Text"), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.DocumentType_CategoryName, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group" id="div_otherspecifydoc" style="display:none;">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.A_column, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.EditorFor(model => model.A_column, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.A_column, "", new { @class = "text-danger" })
                                                            </div>                                                            
                                                        </div>
                                                    </div>

                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @{
                                                                    var listItems1 = new List<SelectListItem>
                                                                    {
                                                                        new SelectListItem {  Text = "..." , Value=""  },
                                                                        new SelectListItem {  Text = "Applied" , Value="Applied"  },
                                                                        new SelectListItem {  Text = "To Be Applied" , Value="To Be Applied"  },
                                                                        new SelectListItem {  Text = "Received" , Value="Received"  },
                                                                        new SelectListItem {  Text = "Revised" , Value="Revised"  },
                                                                    };
                                                                }
                                                                @Html.LabelFor(model => model.DocumentType_Status, htmlAttributes: new { @class = "control-label mand" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.DocumentType_Status, new SelectList(listItems1, "Value", "Text"), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.DocumentType_Status, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(model => model.Date_ApplicationPlannedorExpectedReceipt, htmlAttributes: new { @class = "control-label mand" })
                                                                @Html.HiddenFor(model => model.DocumentType_Code, new { Value = "0" })                                                                
                                                                @Html.ValidationMessageFor(model => model.DocumentType_Code, "", new { @class = "text-danger" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.EditorFor(model => model.Date_ApplicationPlannedorExpectedReceipt, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.ValidationMessageFor(model => model.Date_ApplicationPlannedorExpectedReceipt, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Upload Document</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">@Html.LabelFor(model => model.DocumentType_FilePath, htmlAttributes: new { @class = "control-label mand" })</div>
                                                            <div class="col-md-3">
                                                                <div class="input-group">
                                                                    <label class="input-group-btn">
                                                                        <span class="btn btn-primary">
                                                                            Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                        </span>
                                                                    </label>
                                                                    <input type="text" id="Photo_AddressShow" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="control-label col-md-3">
                                                                @Html.HiddenFor(model => model.DocumentType_FilePath)
                                                                @Html.HiddenFor(model => model.DocumentType_FileName, htmlAttributes: new { @class = "control-label" })
                                                            </div>                                                            
                                                            <div class="col-md-3">
                                                                <a href="~/@Html.DisplayFor(model => model.DocumentType_FileName)@Html.DisplayFor(model => model.DocumentType_FilePath)" data-spzoom>
                                                                    <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.DocumentType_FileName)@Html.DisplayFor(model => model.DocumentType_FilePath)" alt="No Image" />
                                                                </a>
                                                            </div> 
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-12">
                                                                @TempData["notice"]<br />Certificate/Document Should be in .JPG/.JPEG/.PDF format and less than 1 MB
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                @if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled = "disabled" />
                                                }
                                                else
                                                {
                                                    if (Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 1 || Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 5 || Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 6)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                    }                                                    
                                                }                                                
                                                &nbsp;
                                                @Html.ActionLink("Reset", "Create_ApprovalDetails", "Project", null, new { @class = "btn btn-outline btn-primary" })
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="row">
                                    <div class="form-group">                                        
                                        <div class="col-md-12">
                                            <div class="table-responsive">
                                                <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.DocumentType_Name)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.DocumentType_CategoryName)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.DocumentType_Status)
                                                            </th>
                                                            <th>
                                                                @Html.DisplayNameFor(model => model.Date_ApplicationPlannedorExpectedReceipt)
                                                            </th>
                                                            <th class="th-align-text">
                                                                @Html.DisplayName("View")
                                                            </th>
                                                            <th class="th-align-text">
                                                                @Html.DisplayName("Edit| Delete")
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.prpongoing)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.DocumentType_Name)
                                                                    @if (item.DocumentType_Name == "Other Document")
                                                                    {
                                                                        @Html.DisplayName("(")
                                                                        @Html.DisplayFor(modelItem => item.A_column)
                                                                        @Html.DisplayName(")")
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.DocumentType_CategoryName)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.DocumentType_Status)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => item.Date_ApplicationPlannedorExpectedReceipt)
                                                                </td>
                                                                <td align="center">
                                                                    @{
                                                                        string strfilepath = item.DocumentType_FileName.ToString();
                                                                        string strfilename = item.DocumentType_FilePath.ToString();
                                                                        string resultfile = string.Concat(strfilepath, strfilename);
                                                                    }
                                                                    <a href="~/@resultfile" target="_blank" title="View Document"><i class="fa fa-external-link-square"></i></a>
                                                                    @*@{
                                                                        string documentExtension = System.IO.Path.GetExtension(item.DocumentType_FilePath);
                                                                    }
                                                                    @if (documentExtension == ".pdf" || documentExtension == ".PDF" || documentExtension == "pdf" || documentExtension == "PDF")
                                                                    {
                                                                        <a href="~/@resultfile" title="View PDF" target="_blank">
                                                                            <img height="21" width="21" src="~/images/pdf.png" alt="Document" />
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a href="~/@resultfile" title="View JPEG" target="_blank">
                                                                            <img height="21" width="21" src="~/images/jpeg-icon.png" alt="Document" />
                                                                        </a>
                                                                    }*@
                                                                </td>
                                                                <td align="center">
                                                                    @if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                                    {
                                                                        @Html.ActionLink("View", "Edit_ApprovalDetails", new { ProjectApprovalRelated_ProjectRegistration_ID = item.ProjectApprovalRelated_ProjectRegistration_ID, ProjectApproval_IndexID = item.ProjectApproval_IndexID })                                                                        
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.ActionLink("Edit", "Edit_ApprovalDetails", new { ProjectApprovalRelated_ProjectRegistration_ID = item.ProjectApprovalRelated_ProjectRegistration_ID, ProjectApproval_IndexID = item.ProjectApproval_IndexID }) @("| ")
                                                                        @Html.ActionLink("Delete", "Delete_ApprovalDetails", new { ProjectApprovalRelated_ProjectRegistration_ID = item.ProjectApprovalRelated_ProjectRegistration_ID, ProjectApproval_IndexID = item.ProjectApproval_IndexID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                 </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
