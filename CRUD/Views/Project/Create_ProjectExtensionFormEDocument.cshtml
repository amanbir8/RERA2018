<script>
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $('#FormE_DocIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#Project_RERANumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#Project_RERANumberValiduptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        udfvalidateExtensionAppliedForDate();
        
        $('#FormE_DocIssueDate').change(function () {            
            var dateuptovalid = new Date($('#Project_RERANumberValiduptoDate').val());
            var dateuptovalidstr = new Date($('#Project_RERANumberValiduptoDate').val());
            var dateentryapplied = new Date($(this).val());
            dateuptovalid.setDate(dateuptovalid.getDate() + 365);
            var diffuppervalue = new Date(dateuptovalid - dateentryapplied);
            var difflowervalue = new Date(dateentryapplied - dateuptovalidstr);
            if (diffuppervalue < 0 || difflowervalue < 0)
            {
                alert("Invalid Date! Valid extension applied upto date field is required.");
                $("#FormE_DocIssueDate").val('');
            }
        });

        $("#Project_RERAnumber").inputmask({ mask: function () { return ["AAAAAA-AAA99-AA9999"]; } });
    });

    function udfvalidateExtensionAppliedForDate(){
        var dateEntryCheck = new Date($('#Project_RERANumberValiduptoDate').val());
        var dateValidUpto = new Date($('#Project_RERANumberValiduptoDate').val());
        dateEntryCheck.setDate(dateEntryCheck.getDate() + 365);
        $("#FormE_DocIssueDate").datepicker("option", "minDate", dateValidUpto);
        $("#FormE_DocIssueDate").datepicker("option", "maxDate", dateEntryCheck);
    }
</script>

