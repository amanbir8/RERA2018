<script>
    function highlightPendingDocs() {

        var uploadedDocs = [];
        var upload = '';
        //var uploadedDocs = ['1010', '1025', '1018', '1020', '1006'];        

        var baseUrl = $('body').attr('data-base-url');        
        $.ajax({
            type: "POST",
            url: baseUrl + "Project/GetProjectExtensionFormDocumentUploadedList_ByProjectId",
            datatype: "Json",
            data: { parmProjectId: $('#Project_ID').val() },
            success: function (data) {
                var jsonData = JSON.parse(data);
                $.each(jsonData, function (index, value) {
                    uploadedDocs.push(value.Id.toString());
                });

                // get all documents list
                var listHtml = '';
                $('select#FormE_DocInfoCode').find('option').each(function () {
                    var itemText = $.trim($(this).text());
                    var itemId = $(this).val();
                    var color = '#3c763d';
                    var iconClass = 'check';
                    if (itemId) {
                        if ($.inArray(itemId, uploadedDocs) == -1) {
                            var color = '#a94442';
                            var iconClass = 'times';
                        }
                        var itemHtml = '<a style="color: ' + color + '" data-doc-id="' + itemId + '" href="javascript:void(0);" class="list-group-item"><i class="fa fa-' + iconClass + ' fa-fw"></i><span class=""> ' + itemText + '</span></a>';
                        listHtml = listHtml + itemHtml;
                    }
                });
                $('div.pending-list-documents').html(listHtml);

            }
        });

        
    }

    function singleFileSelected() {
        //var selectedFile = evt.target.files can use this  or select input file element
        //and access it's files object
        //debugger;
        var baseUrl = $('body').attr('data-base-url');
        $(".InfoContainer").fadeIn();
        var selectedFile = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];
        if (selectedFile) {
            var FileSize = 0;
            var imageType = /image.*/;
            if (selectedFile.size > 1048576) {
                FileSize = Math.round(selectedFile.size * 100 / 1048576) / 100 + " MB";
            }
            else if (selectedFile.size > 1024) {
                FileSize = Math.round(selectedFile.size * 100 / 1024) / 100 + " KB";
            }
            else {
                FileSize = selectedFile.size + " Bytes";
            }
            // here we will add the code of thumbnail preview of upload images

            $("#showFileInfoGrid").show();
            $("#FileName").text("Name : " + selectedFile.name);
            $("#FileType").text("Type : " + selectedFile.type);
            $("#FileSize").text("Size : " + FileSize);

            $("#showSaveFileUploadMessage").hide();


            if (selectedFile.type.match(imageType)) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = reader.result;
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "100";
                    img.width = "100";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(100);
                    $("#Imagecontainer").width(100);
                };
                reader.readAsDataURL(selectedFile);
            }
            if (selectedFile.type.match('application/pdf')) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = baseUrl + 'images/pdf.png';
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "35";
                    img.width = "35";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(35);
                    $("#Imagecontainer").width(35);
                };
                reader.readAsDataURL(selectedFile);
            }
        }
    }
</script>
<script type="text/javascript">

    $(function () {
        $("#FormUpload").submit(function (event) {
            //debugger;
            var form = $('#FormUpload')[0];

                //var dataString = new FormData(form);
                var baseUrl = $('body').attr('data-base-url');
                var files = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];

                if (typeof files === 'undefined') {
                    $("#showSaveFileUploadMessage").show();
                    $("#saveFileUploadMessageName").text("Note : Please Add files... to Upload!");
                    //alert('Please Add file(s) to Upload!');
                    return false;
                }
                //var files = $("#FileUpload1")[0].files;
                if (files.size > 0) {
                    var formData = new FormData(form);
                    for (var i = 0; i < files.length; i++) {
                        formData.append(files[i].name, files[i]);
                    }

                    var progressbarLabel = $('#progressBar-label');
                    var progressbarDiv = $('#progressbar');

                    $.ajax({
                        url: baseUrl + 'Project/ProjectExtensionFormDocumentFormUpload',
                        method: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            //alert(data.status);
                            if (data.statusCode == 101)
                            {
                                progressbarLabel.text('COMPLETE');
                                progressbarDiv.fadeOut(2000);
                                $(".InfoContainer").fadeOut(2000);
                                $("#showFileInfo").fadeOut(2500);

                                // Load Uploaded List - Highlight Pending Docs
                                highlightPendingDocs(); 
                            }
                            else
                            {
                                progressbarLabel.text('Bad Request! Upload Failed');
                                progressbarDiv.fadeOut(2000);

                                $("#showSaveFileUploadMessage").show();
                                $("#saveFileUploadMessageName").text("Note : " + data.status);
                            }

                        },
                        failure: function(data) {
                            alert('Bad Request! Upload Failed');
                        },
                        error: function (err) {
                            //alert(err.message);
                            alert('Bad Request! Upload Failed');
                            //alert(err.statusText);
                        }
                    });

                    progressbarLabel.text('UPLOADING ...');
                    progressbarDiv.progressbar({
                        value: false
                    }).fadeIn(500);


                    $("#showSaveFileUploadMessage").hide();
                }

                return false;
        });

        $("#FormE_DocInfoCode").change(function () {
            $("#showFileInfo").show();
            //if ($('#FormE_DocInfoCode').val() == 1109)
