@model CRUD.Models.PromoterProject.ClsPrp_Project_ParkingDetails

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>


    <script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {

        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $('#drpQYear').attr('disabled', true);
        $('#drpQName').attr('disabled', true);
        //$('#A_column').attr('readonly', false);
        //$('#B_column').attr('readonly', true);

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpText = $(document).find("select#ProjectParkingRelated_ProjectRegistration_ID").val();
            //alert(drpText)
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                // $("#idMainForm").hide();
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#ProjectParkingRelated_ProjectRegistration_ID").val();
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                //$("#idMainForm").hide();
                drpText = "";
                return false;
            }
            else {
                $(submitButton).parents('form').submit();
                // $("#idMainForm").show();
            }
        });

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [2, 3, 4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });
</script>
<script>
   //    $(function () {
   //        var startYear = 2001;
   //        var endYear = 2050;
