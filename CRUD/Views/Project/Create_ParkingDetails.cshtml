   //            $('#B_column').append('<option value="' + i + '">' + i + '</option>');


   //});
</script>
<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Project Update (Quarterly): Parking Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Parking Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm("DropdownlistProjectParkingDetails", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Project</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label">Select Project</label>
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(m => m.ProjectParkingRelated_ProjectRegistration_ID, new SelectList((System.Collections.IEnumerable)TempData["list"], "ProjectRegistration_ID", "Project_Name"), "Select Project", new { @class = "form-control" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="BtnDrp" value="Proceed" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                            }
                            <div @if (Session["Project_id"] != null) { @Html.Raw("style=''")     } else { @Html.Raw("style='display: none;'")     }>
                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    @Html.HiddenFor(model => model.ProjectParking_IndexID, htmlAttributes: new { @class = "control-label col-md-2" })
                                    @Html.HiddenFor(model => model.ProjectParking_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                                    @Html.HiddenFor(model => model.ProjectParkingRelated_ProjectRegistration_ID, htmlAttributes: new { @class = "control-label col-md-2" })


                                    @*<label class="control-label col-md-2">Select Project</label>
                @Html.DropDownListFor(m => m.ProjectParkingRelated_ProjectRegistration_ID, new SelectList(ViewBag.list, "ProjectRegistration_ID", "Project_Name"), "Select Project", new { @class = "form-control" })*@

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Select Quarterly Update Option</legend>

                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                <label class="control-label mand">Select Year</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (@TempData["CurrentYears"] != null)
                                                                {
                                                                    @Html.DropDownListFor(model => model.B_column, new SelectList(ViewBag.Years, "Text", "Value", TempData["CurrentYears"]), new { @id = "drpQYear", @class = "form-control" })
                                                                }
                                                                else
                                                                {
                                                                    @Html.DropDownListFor(model => model.B_column, new SelectList(ViewBag.Years, "Text", "Value"), new { @id = "drpQYear", @class = "form-control" })
                                                                }
                                                                @Html.HiddenFor(model => model.B_column, new { id = "hdnQYear" })
                                                                @Html.ValidationMessageFor(model => model.B_column, "", new { @class = "text-danger" })
                                                            </div>
                                                            @*<div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.B_column, new SelectList(""), new { @class = "form-control" })
                                                                @Html.ValidationMessageFor(model => model.B_column, "", new { @class = "text-danger" })
                                                            </div>*@
                                                            <div class="col-md-3">
                                                                <label class="control-label mand">Select Quarter</label>

                                                                @{var listItems2 = new List<SelectListItem>
                                                {

                                                   // new SelectListItem {  Text = "..." , Value=""  },
                                                    new SelectListItem {  Text = "Registration Process" , Value="Registration Process"  },
                                                    new SelectListItem {  Text = "First Quarter" , Value="First Quarter"  },
                                                     new SelectListItem {  Text = "Second Quarter" , Value="Second Quarter"  },
                                                     new SelectListItem {  Text = "Third Quarter" , Value="Third Quarter"  },
                                                     new SelectListItem {  Text = "Fourth Quarter" , Value="Fourth Quarter"  },
                                                };
                                                                }

                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DropDownListFor(model => model.A_column, new SelectList(listItems2, "Value", "Text"), new { @id = "drpQName", @class = "form-control" })
                                                                @Html.HiddenFor(model => model.A_column, new { id = "hdnQName" })
                                                                @Html.ValidationMessageFor(model => model.A_column, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">Parking Details</legend>

                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    @{var listItems1 = new List<SelectListItem>
                                                {

                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                    new SelectListItem {  Text = "Garages" , Value="Garages"  },
                                                    new SelectListItem {  Text = "Covered" , Value="Covered"  },
                                                     new SelectListItem {  Text = "Open" , Value="Open"  },
                                                    new SelectListItem {  Text = "Stilt" , Value="Stilt"  },
                                                    new SelectListItem {  Text = "Basement" , Value="Basement"  },
                                                };
    }
    @Html.LabelFor(model => model.ParkingType, htmlAttributes: new { @class = "control-label mand" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.DropDownListFor(model => model.ParkingType, new SelectList(listItems1, "Value", "Text"), new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.ParkingType, "", new { @class = "text-danger" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.LabelFor(model => model.ParkingSpace_Area_Total, htmlAttributes: new { @class = "control-label mand" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.EditorFor(model => model.ParkingSpace_Area_Total, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => model.ParkingSpace_Area_Total, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    @Html.LabelFor(model => model.ParkingSpace_AvailableforSale_Number, htmlAttributes: new { @class = "control-label" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.EditorFor(model => model.ParkingSpace_AvailableforSale_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => model.ParkingSpace_AvailableforSale_Number, "", new { @class = "text-danger" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.LabelFor(model => model.ParkingSpace_BookedSold_Number, htmlAttributes: new { @class = "control-label" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.EditorFor(model => model.ParkingSpace_BookedSold_Number, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.ValidationMessageFor(model => model.ParkingSpace_BookedSold_Number, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>

                                    <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    @if(Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                    {
                                                        <input type = "submit" value = "@TempData["submitvalue"]" id = "BtnMainform" class="btn btn-outline btn-primary" disabled = "disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type = "submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                    }
                                                    &nbsp;
                                                    @Html.ActionLink("Reset", "Create_ParkingDetails", "Project", null, new { @class = "btn btn-outline btn-primary" })
                                                </div>
                                            </div>
                                        </div>
                                    }
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                        <thead>
                                            <tr>

                                                <th>
                                                    @Html.DisplayNameFor(model => model.ParkingType)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ParkingSpace_Area_Total)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ParkingSpace_AvailableforSale_Number)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ParkingSpace_BookedSold_Number)
                                                </th>
                                                <th>@Html.DisplayName("Edit| Delete")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.prpongoing)
                                            {
                                            <tr>

                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ParkingType)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ParkingSpace_Area_Total)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ParkingSpace_AvailableforSale_Number)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ParkingSpace_BookedSold_Number)
                                                </td>

                                                <td>
                                                    @if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                    {
                                                        @Html.ActionLink("View", "Edit_ParkingDetails", new { ProjectRegistration_ID = item.ProjectParkingRelated_ProjectRegistration_ID, ProjectParking_IndexID = item.ProjectParking_IndexID })                                                    
                                                    }
                                                    else
                                                    {
                                                        @Html.ActionLink("Edit", "Edit_ParkingDetails", new { ProjectRegistration_ID = item.ProjectParkingRelated_ProjectRegistration_ID, ProjectParking_IndexID = item.ProjectParking_IndexID }) @("| ")
                                                        @Html.ActionLink("Delete", "Delete_ParkingDetails", new { ProjectParking_IndexID = item.ProjectParking_IndexID, ProjectRegistration_ID = item.ProjectParkingRelated_ProjectRegistration_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                    }
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                </div>

                                        </div>
                                        <!-- /.row (nested) -->
                                    </div>
                <!-- /.panel-body -->
            </div>
            <!-- /.panel -->
        </div>
                <!-- /.col-lg-12 -->
                        </div>
            <!-- /.row -->
        </div>
    </div>
    <!-- /.wrapper -->

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")

        <!-- Metis Menu Plugin JavaScript -->
        <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    }