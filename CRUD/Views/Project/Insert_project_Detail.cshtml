<script type="text/javascript">
    $(function () {

        var vcheckextravalue = $("input[name='IsYes_RegularizationCertificate']:checked").val();
        if (vcheckextravalue == 'NREGC') {
            $("#rowspecifyRegularizationCertificate").attr("style", "display:none");
        }
        else if (vcheckextravalue == 'YREGC') {
            $("#rowspecifyRegularizationCertificate").attr("style", "display:block");
        }

        $(document).on('click', '.radio-regularizationcertificate', function (e) {
            if (this.value == 'NREGC') {
                $("#rowspecifyRegularizationCertificate").attr("style", "display:none");
            }
            else if (this.value == 'YREGC') {
                $("#rowspecifyRegularizationCertificate").attr("style", "display:block");
            }
        });

    });
</script>
