          function CalculateDiff() {
              // debugger;
              if ($("#ProjectCompletion_ProposedDate").val() != "") {

                  var From_date = new Date($("#ProjectCompletion_ProposedDate").val());
                  var To_date = new Date($("#ProjectCompletion_OriginalDate").val());
                  // var Start_date = new Date();//GetTodayDate();//new Date($("#ProjectStart_Date").val()); // commneted on jun. 27
                  var Start_date = new Date($("#ProjectCompletion_OriginalDate").val());
                  // Start_date.setDate(Start_date.getDate() - 2); // commneted on jun. 27
                  Start_date.setDate(Start_date.getDate() - 1);
                  var diff_date = To_date - From_date;
                  var diff_Sdate_PDate = From_date - (Start_date);



                  var years = Math.floor(diff_date / 31536000000);
                  var months = Math.floor((diff_date % 31536000000) / 2628000000);
                  var days = Math.floor(((diff_date % 31536000000) % 2628000000) / 86400000);


                  var YearSPDate = Math.floor(diff_Sdate_PDate / 31536000000);
                  var MonthSPDate = Math.floor((diff_Sdate_PDate % 31536000000) / 2628000000);
                  var DaySPDate = Math.floor(((diff_Sdate_PDate % 31536000000) % 2628000000) / 86400000);

                  if (DaySPDate > 0 || YearSPDate > 0 || MonthSPDate > 0) {
                      $("#ProjectRegistrationProvided_Duration").val(YearSPDate + " year(s) " + MonthSPDate + " month(s) " + DaySPDate + " day(s)");
                      //$('#ProjectRegistrationProvided_Duration').attr('readonly', true);
                  }
                  else {
                      alert("Please Enter Valid Proposed Date of Project Completion");
                      $("#ProjectCompletion_ProposedDate").val('');
                      $("#ProjectRegistrationProvided_Duration").val('');
                      //$('#ProjectRegistrationProvided_Duration').attr('readonly', false);
                      return false;
                      //$("#ProjectRegistrationProvided_Duration").val(0 + " year(s) " + 0 + " month(s) " + 0 + "day(s)");
                  }
                  //$("#Result").html(years + " year(s) " + months + " month(s) " + days + " and day(s)");

                  if (days > 0 || years > 0 || months > 0) {
                      // alert(years + " year(s) " + months + " month(s) " + days + " and day(s)");
                      //$('#div_reasonfordelay').show();
                      $('#div_reasonfordelay').hide();
                      $('#ProjectDelayReason_IfAny').val("");
                      $('#div_reasonfordelayaddreasons').hide();
                  }
                  else {
                      //$('#div_reasonfordelay').hide();
                      //$('#ProjectDelayReason_IfAny').val("");
                      if (From_date > To_date) {
                          $('#div_reasonfordelay').show();
                          $('#div_reasonfordelayaddreasons').show();
                      }
                  }

              }
              else {
                  //alert("Please select dates");
                  return false;
              }
          }

</script>
