                                                                                                            @Html.ActionLink(" ", "QUpdateDelete_QUApprovalDetails", new { PRID = item.Related_ApprovalProjectRegistration_ID, quPAIndexID = item.QUpdateProjectApproval_IndexID, quPAID = item.QUpdateProjectApproval_ID, rPAIndexID = item.Related_ProjectApproval_IndexID, rPAID = item.Related_ProjectApproval_ID }, new { @class = "qulinkaction-trash", title = "Delete Quarterly Updates", onclick = "return confirm('Are sure wants to delete?');" })
