<script>
    $(function () {
        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $('#Date_ApplicationPlannedorExpectedReceipt').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        if ($('#DocumentType_IfOtherSpecifyName').val() != "") {
            $('#div_otherspecifydoc').show();
        }
        else {
            $('#div_otherspecifydoc').hide();
            $('#DocumentType_IfOtherSpecifyName').val("");
        }

        $('#DocumentType_Name').change(function () {
            if ($("#DocumentType_Name").val() != "Other Document") {
                $('#div_otherspecifydoc').hide();
                $('#DocumentType_IfOtherSpecifyName').val("");
            }
            else {
                $('#div_otherspecifydoc').show();
            }
        });
    });
</script> 

