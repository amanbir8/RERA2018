<script type="text/javascript">
    jQuery(document).ready(function ($) {
        var name = $('#InternalInfrastructureFacilities_Name').val();
                if(name=="Fire Fighting" ||name=="Drinking Water" ||name=="Emergency Evacuation"||name=="Use for Renewable Energy"||name=="Rain Water Harvesting"||name=="Street Lighting"||name=="External Roads and Road System Landscaping"||name=="Water Supply System"||name=="Sewerage and Drainage System"||name=="Electricity Supply Transformer and Sub Station"||name=="Solid Waste Management and Disposal" )
                {
                }
                else {
                    $("#InternalInfrastructureFacilities_Name").attr("disabled", false);
                    
                    $('input:radio[name=InternalInfrastructureFacilities_Name]')[5].checked=true;
                  
                }
                typeChange();
    });
    function FacilityName() {
        var selValue = $('input[name=InternalInfrastructureFacilities_Name]:checked').val();
        if (selValue!="Other") {
            $('#InternalInfrastructureFacilities_Name').val(selValue);
            $("#InternalInfrastructureFacilities_Name").attr("disabled", true);
        }
        else {
            $('#InternalInfrastructureFacilities_Name').val('');
            $("#InternalInfrastructureFacilities_Name").attr("disabled", false);
        }
    }
    function typeChange() {
        var type = $('#InternalInfrastructureFacilities_Type').val();
        if (type == "External Development Work") {
            $('#ExternalAgency').show();
        }
        else {
            $('#ExternalAgency').hide();
            $('#ExternalAgency_LocalAuthority_Name').val('NA');            
        }
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {

        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $('#drpQYear').attr('disabled', true);
        $('#drpQName').attr('disabled', true);
        //$('#A_column').attr('readonly', false);
        //$('#B_column').attr('readonly', true);

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpText = $(document).find("select#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").val();
            //alert(drpText)
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                // $("#idMainForm").hide();
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").val();
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                //$("#idMainForm").hide();
                drpText = "";
                return false;
            }
            else {
                $(submitButton).parents('form').submit();
                // $("#idMainForm").show();
            }
        });

        $('[data-toggle="tooltip"]').tooltip();


        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [3, 4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });
</script>
