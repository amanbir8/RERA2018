<script type="text/javascript">

    $(function () {
        $('#A_column').on("click", function () {
            if ($(this).is(':checked')) {
                $("input[name='WorkProgress_PercentageInQuarter']").val('0.00');
                $('#ExternalInfrastructureFacilitiesInQuarter_Details').val("Not Applicable");
            };
        });
