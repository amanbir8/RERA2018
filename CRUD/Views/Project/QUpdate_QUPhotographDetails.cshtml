                                                <th>
                                                    @Html.DisplayName("Date of Upload")
                                                </th>
                                                <th>@Html.DisplayName("View")</th>                                               
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.prpongoing)
                                            {
                                                <tr>                                                
                                                    <td align="center">
                                                        @if (item.IsRegisteredDiaryNumberLock == 1 || item.IsRegisteredDiaryNumberLock == 9)
                                                        {
                                                            <span class="disabledlockunlock" title="Geo-location Points"><i class="fa fa-map-pin" aria-hidden="true"></i></span>
                                                            <span>&nbsp;</span>
                                                            <span class="disabledlockunlock" title="Delete Quarterly Updates"><i class="fa fa-trash" aria-hidden="true"></i></span>
                                                        }
                                                        else
                                                        {
                                                            if (Model.IsLock == 1 || Model.IsLock == 2)
                                                            {
                                                                <span class="disabledlockunlock" title="Geo-location Points"><i class="fa fa-map-pin" aria-hidden="true"></i></span>
                                                                <span>&nbsp;</span>
                                                                <span class="disabledlockunlock" title="Delete Quarterly Updates"><i class="fa fa-trash" aria-hidden="true"></i></span>
                                                            }
                                                            else
                                                            {
                                                                if (item.IsQuarterlyData == 1 || item.IsQuarterlyData == 3 || item.IsQuarterlyData == 0)
                                                                {
                                                                    <span class="disabledlockunlock" title="Geo-location Points"><i class="fa fa-map-pin" aria-hidden="true"></i></span>
                                                                    <span>&nbsp;</span>
                                                                    <span class="disabledlockunlock" title="Delete Quarterly Updates"><i class="fa fa-trash" aria-hidden="true"></i></span>
                                                                }
                                                                else
                                                                {
                                                                    if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                                    {
                                                                        <span class="disabledlockunlock" title="Geo-location Points"><i class="fa fa-map-pin" aria-hidden="true"></i></span>
                                                                        <span>&nbsp;</span>
                                                                        <span class="disabledlockunlock" title="Delete Quarterly Updates"><i class="fa fa-trash" aria-hidden="true"></i></span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="disabledlockunlock" title="Geo-location Points"><i class="fa fa-map-pin" aria-hidden="true"></i></span>
                                                                        <span>&nbsp;</span>                                                            
                                                                        @Html.ActionLink(" ", "Delete_QUPhotographDetails", new { inPQUPhotographsIndexID = item.QUpdateProjectPhotographs_IndexID, inPQUPhotographsID = item.QUpdateProjectPhotographs_ID, inProjectID = item.ProjectPhotographsRelated_Project_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-trash", @title = "Delete Quarterly Updates" })
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.BuildingTowerBlock_ComArea_ConStatusName)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Photographs_Title)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Photographs_Status)
