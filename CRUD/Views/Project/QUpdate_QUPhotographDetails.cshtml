<script type="text/javascript">
    $(document).ready(
        function () {

            if ($('input[name=BuildingTowerBlock_ComArea_ConStatusCode]:checked').val() === "2") {
                $('#getBTBconstructionInfo').show();
            }
            else {               
                $('#getBTBconstructionInfo').hide();
            }
            
            $('input[name=BuildingTowerBlock_ComArea_ConStatusCode]').click(function () {

                if ($('input[name=BuildingTowerBlock_ComArea_ConStatusCode]:checked').val() == "2") {                    
                    $('#getFileTypeSizeBInfo').show();
                    $('#getFileTypeSizeCInfo').hide();
                }
                if ($('input[name=BuildingTowerBlock_ComArea_ConStatusCode]:checked').val() == "3") {                   
                    $('#getFileTypeSizeBInfo').hide();
                    $('#getFileTypeSizeCInfo').show();
                }

                if ($('input[name=BuildingTowerBlock_ComArea_ConStatusCode]:checked').val() == "2") {
                    $('#getBTBconstructionInfo').show();
                    $("#getIFconstructionNAInfo").hide();
                    $('#BuildingTowerBlock_InfoCode').attr('disabled', false);
                    $('#BuildingTowerBlock_FloorsNumber').attr('disabled', false);
                    $('#BuildingTowerBlock_PhotographType').attr('disabled', false);
                    $('#drpInventoryList').attr('disabled', false);

                    $('#BuildingTowerBlock_InfoCode').empty();

                    var baseUrl = $('body').attr('data-base-url');
                    $.ajax({
                        type: "POST",
                        url: baseUrl + "Project/GetBuildingTowerBlockByProjectId",
                        datatype: "Json",
                        data: { projectid: $('#ProjectPhotographsRelated_Project_ID').val() },
                        success: function (data) {
                            if (data.length > 0) {
                                $('#getBTBconstructionNAInfo').hide();
                                $('#BuildingTowerBlock_InfoCode').append('<option value="0">--Select--</option>');
                                $.each(data, function (index, value) {
                                    $('#BuildingTowerBlock_InfoCode').append('<option value="' + value.ProjectConstruction_ID + '">' + value.BuildingTowerBlock_Name + '</option>');
                                });
                            } else {
                                $('#getBTBconstructionInfo').show();
                                $("#showFileInfo").hide();
                                $('#BuildingTowerBlock_InfoCode').attr('disabled', true);
                                $('#BuildingTowerBlock_FloorsNumber').attr('disabled', true);
                                $('#BuildingTowerBlock_PhotographType').attr('disabled', true);
                                $('#drpInventoryList').attr('disabled', true);

                                $('#getBTBconstructionNAInfo').show();
                            };                            
                        }
                    });
                }
                else {
                    $('#getBTBconstructionInfo').hide();
                    $('#getBTBconstructionNAInfo').hide();
                }
            });

            $('input[name=BuildingTowerBlock_ComArea_ConStatusCode]').change(function () {
                $("#showFileInfo").show();
                $('#BuildingTowerBlock_ComArea_ConStatusName').empty();                
                if ($("#chktwo").is(":checked")) {
                    $("input[name='BuildingTowerBlock_ComArea_ConStatusName']").val('Building/ Tower/ Block (Status of Construction)');
                    $("#getIFconstructionNAInfo").hide();
                }
                if ($("#chkthree").is(":checked")) {
                    $("input[name='BuildingTowerBlock_ComArea_ConStatusName']").val('Internal Infrastructure and Common Areas');
                    $("#getIFconstructionNAInfo").show();
                }
            });

            var valFNselected = $('#BuildingTowerBlock_FloorsNumber').val();            
            if (valFNselected == 0 || valFNselected == '') {
                $("#getBTBfloorNumberInfo").hide();
            }
            else {
                $("#getBTBfloorNumberInfo").show();
            };

            $('#drpInventoryList').change(function () {
                var valselected = $("#drpInventoryList option:selected").val();
                if (valselected == 1010 || valselected == 1001) {                    
                    $("#getBTBfloorNumberInfo").show();
                }
                else {
                    $("#getBTBfloorNumberInfo").hide();
                };                
                $("#hdnBuildingTowerBlockType").val(valselected);                                
            });

            $('#drpInventoryICommList').change(function () {
                var valicselected = $("#drpInventoryICommList option:selected").val();
                $("#hdnBuildingTowerBlockType").val(valicselected);                
            });
        });
</script>
<script>
    $(function () {
        $('#PhotoGeoPoint_Latitude').on("change", function () {
            var vlat = $(this).val();

            var convertLat = Math.abs(vlat);
            var LatDeg = Math.floor(convertLat);
            var LatMin = (Math.floor((convertLat - LatDeg) * 60));
            var convertLatMin = (Math.abs((convertLat - LatDeg) * 60));
            var LatSec = (Math.floor((convertLatMin - LatMin) * 60));
            var LatCardinal = ((vlat > 0) ? "N" : "S");

            if (parseInt(LatDeg) < 29 || parseInt(LatDeg) > 32) {
                alert("Invalid! The Latitude of location should be between 29.30N to 32.32N (in degree).");
                $("#PhotoGeoPoint_Latitude").val('');
                $("#PhotoGeoPoint_LatitudeX").val('');
            }
            else {
                $("#PhotoGeoPoint_LatitudeX").val(LatDeg + 'degree ' + LatMin + 'min ' + LatSec + 'sec ' + LatCardinal);
            };
        });

        $('#PhotoGeoPoint_Longitude').on("change", function () {
            var vlng = $(this).val();

            var convertLng = Math.abs(vlng);
            var LngDeg = Math.floor(convertLng);
            var LngMin = (Math.floor((convertLng - LngDeg) * 60));
            var convertLngMin = (Math.abs((convertLng - LngDeg) * 60));
            var LngSec = (Math.floor((convertLngMin - LngMin) * 60));
            var LngCardinal = ((vlng > 0) ? "E" : "W");

            if (parseInt(LngDeg) < 73 || parseInt(LngDeg) > 76) {
                alert("Invalid! The Longitude of location should be between 73.55E to 76.50E (in degree).");
                $("#PhotoGeoPoint_Longitude").val('');
                $("#PhotoGeoPoint_LongitudeX").val('');
            }
            else {
                $("#PhotoGeoPoint_LongitudeX").val(LngDeg + 'degree ' + LngMin + 'min ' + LngSec + 'sec ' + LngCardinal);
            };            
        });
    });
</script>
