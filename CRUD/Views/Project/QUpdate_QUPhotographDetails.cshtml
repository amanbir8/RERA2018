                                                                }
                                                                @Html.DisplayFor(modelItem => item.BuildingTowerBlock_Type)
                                                                @Html.DisplayName(", ")
                                                                @Html.DisplayName("Floor: ")
                                                                @Html.DisplayFor(modelItem => item.BuildingTowerBlock_FloorsNumber)
                                                                @Html.DisplayName(", ")
                                                                @Html.DisplayFor(modelItem => item.BuildingTowerBlock_PhotographType)
                                                                @Html.DisplayName(" (lat:")
                                                                @Html.DisplayFor(modelItem => item.PhotoGeoPoint_Latitude)
                                                                @Html.DisplayName(", long:")
                                                                @Html.DisplayFor(modelItem => item.PhotoGeoPoint_Longitude)
                                                                @Html.DisplayName(")")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayFor(modelItem => item.BuildingTowerBlock_Type)
                                                                @Html.DisplayName(" (lat:")
                                                                @Html.DisplayFor(modelItem => item.PhotoGeoPoint_Latitude)
                                                                @Html.DisplayName(", long:")
                                                                @Html.DisplayFor(modelItem => item.PhotoGeoPoint_Longitude)
                                                                @Html.DisplayName(")")
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("NA")
                                                        }
                                                    </td>                                                
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.Photographs_ClickDate)
                                                    </td>
                                                    <td align="center">
                                                        <a href="~/@Html.DisplayFor(modelItem => item.Photographs_FilePath)" target="_blank" title="View"><i class="fa fa-external-link-square"></i></a>
                                                    </td>
