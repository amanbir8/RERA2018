                                                            @Html.DisplayName(")")
                                                        }                                                    
                                                    </td>                                                
                                                    <td>
                                                        @if (item.BuildingTowerBlock_PhotographType != String.Empty)
                                                        {
                                                            if (item.BuildingTowerBlock_ComArea_ConStatusCode == 2)
                                                            {
                                                                if (item.BuildingTowerBlock_InfoName != String.Empty)
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.BuildingTowerBlock_InfoName)
