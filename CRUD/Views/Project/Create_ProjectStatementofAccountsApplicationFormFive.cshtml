<script type="text/javascript">
    $(document).ready(function () {

        $('#promoter-documents-list-table').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [3, 4, 5]
            }]
        });

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpText = $(document).find("select#ProjectStatementofAccountsRelated_ProjectID").val();
            if ($.trim(drpText) == "") {                    
                alert("Please select the Project")                    
            }
            else {                    
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#ProjectStatementofAccountsRelated_ProjectID").val();
            if ($.trim(drpText) == "") {                    
                alert("Please select the Project")                    
                drpText = "";
                return false;
            }
            else {

                var files = $("#Photo_Address").get(0).files;
                var path = $('#user_Photo').attr('src').replace('/', '');

                if (files.length > 0 || path.length > 0) {
                    $(submitButton).parents('form').submit();
                }
                else {
                    alert("Bad request! Add document file to Upload!")
                    return false;
                }                 
            }
        });

        $('[data-toggle="tooltip"]').tooltip();
    });

    var baseUrl = $('body').attr('data-base-url');

    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                //$('#user_Photo').attr('src', e.target.result);
                var selectedFile = input.files[0];
                var imageType = 'image/jpeg';
                if (selectedFile.type.match(imageType)) {
                    $('#user_Photo').attr('src', e.target.result);
                }
                if (selectedFile.type.match('application/pdf')) {
                    var dataURL = baseUrl + 'images/pdf-icon.gif';
                    $('#user_Photo').attr('src', dataURL);
                    $('#user_Photo').attr('width', '78');
                    $('#user_Photo').attr('height', '78');
                }
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }
</script>

