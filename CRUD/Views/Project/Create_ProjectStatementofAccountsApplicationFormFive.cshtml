                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.FormB_CompletionDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                @Html.ValidationMessageFor(model => model.FormB_CompletionDate, "", new { @class = "text-danger" })
                                            </div>                                                 
                                        </div>
