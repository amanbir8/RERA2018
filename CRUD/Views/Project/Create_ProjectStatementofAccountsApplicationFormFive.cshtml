                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Explanatory note regarding the reason for not completing the development works in the project within the period declared in Form-B at the time of making application for the registration of the project.">
                                                @Html.EditorFor(model => model.ExplanatoryNote, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.ExplanatoryNote, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>                                        
                                </fieldset>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <fieldset class="col-md-12">
                                    <legend class="my">Amount collected and withdrawn for project Details</legend>

                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                @Html.Label("(a) Collected during the financial year (INR)", htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.CollectedDuring_FinancialYear_Amount_INR, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.CollectedDuring_FinancialYear_Amount_INR, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.Label("(b) Collected till date (INR)", htmlAttributes: new { @class = "control-label mand" })
