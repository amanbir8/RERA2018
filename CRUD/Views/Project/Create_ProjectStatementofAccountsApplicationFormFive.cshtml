        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    @TempData["FormFivePreviewMessage"].ToString() Annual Audited Statement of Accounts Form as per Section 4(2)(l)(D) of the RERA Act, 2016
                </div>
            

                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

            @using (Html.BeginForm("DropdownlistProjectStatementofAccountsApplication", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
