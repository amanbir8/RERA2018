                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.CollectedTillDate_Amount_INR, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.CollectedTillDate_Amount_INR, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                @Html.Label("(c) Withdraw during the financial year (INR)", htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.WithdrawDuring_FinancialYear_Amount_INR, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.WithdrawDuring_FinancialYear_Amount_INR, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.Label("(d) Withdrawn till date (INR)", htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.WithdrawnTillDate_Amount_INR, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.WithdrawnTillDate_Amount_INR, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>                                                   
                            
