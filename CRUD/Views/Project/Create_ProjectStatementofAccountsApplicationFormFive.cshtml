                                </fieldset>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-12">
                                @if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                {
                                    <input type="submit" value="@TempData["submitvalueFormFive"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                }
                                else
                                {
                                    if (Model.IsEvaluationDraft == 1)
                                    {
                                        <input type="submit" value="@TempData["submitvalueFormFive"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                    }
                                    else
                                    {
                                        if (TempData["submitvalueFormFive"].ToString() == "Confirm")
                                        {
                                            <input type="submit" value="@TempData["submitvalueFormFive"]" id="BtnMainform" class="btn btn-danger" />
                                        }
                                        else
                                        {
                                            <input type="submit" value="@TempData["submitvalueFormFive"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                        }
                                    }
                                }
                                &nbsp;
                                @Html.ActionLink("Reset", "Create_ProjectStatementofAccountsApplicationFormFive", "Project", null, new { @class = "btn btn-outline btn-primary" })
                            </div>
                        </div>
                    </div>
                   
                }
                    <div class="row">
