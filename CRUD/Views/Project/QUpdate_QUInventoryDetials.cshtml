<script type="text/javascript">
    $(document).ready(function () {
        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpProjectText = $(document).find("select#Related_ProjectRegistration_ID").val();
            var drpYearPrjText = $(document).find("select#drpQYear").val();
            var drpQuarterPrjText = $(document).find("select#drpQName").val();

            if ($.trim(drpProjectText) == "" || $.trim(drpYearPrjText) == "" || $.trim(drpQuarterPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#Related_ProjectRegistration_ID").val();
            var drpYearPrjText = $(document).find("select#drpQYear").val();
            var drpQuarterPrjText = $(document).find("select#drpQName").val();
            if ($.trim(drpText) == "" || $.trim(drpYearPrjText) == "" || $.trim(drpQuarterPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
                drpText = "";
                drpYearPrjText = "";
                drpQuarterPrjText = "NA";
                return false;
            }
            else {
                $(submitButton).parents('form').submit();
            }
        });

        $('[data-toggle="tooltip"]').tooltip();
    });

    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
        }
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerInventoryButton', function (e) {
            e.preventDefault();
            var projectDetailsModal = $(document).find('#myFormQUpdateModal');
            $(projectDetailsModal).find('.modal-body').html('');
            $.ajax({
                url: baseUrl + 'Project/QUpdate_DisplayInventoryDetail',
                dataType: 'HTML',
                type: 'GET',
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Quarterly Updates: List of Number and Types of Apartments/ Plots Detail(s)');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
    function CalculateInventoryNumbers() {        
        if ($("#ApartmentShopPlot_TotalNumberBooked").val() != "" && $("#ApartmentShopPlot_TotalNumberSold").val() != "" && $("#ApartmentShopPlot_NumberAvailableforSale").val() != "" && $("#ApartmentShopPlot_NumberSoldUptoRegistration").val() != "") {
            
            var aspTotalNumberBooked = parseInt($("#ApartmentShopPlot_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ApartmentShopPlot_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ApartmentShopPlot_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ApartmentShopPlot_NumberSoldUptoRegistration").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold; // + aspNumberSoldUptoRegistration;

            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Number of Apartment/ Shop/ Plot.");
                parseInt($("#ApartmentShopPlot_TotalNumberBooked").val(0));
                parseInt($("#ApartmentShopPlot_TotalNumberSold").val(0));
                return false;
            }
            else {
                return true;                
            }            
        }
        else {
            return false;
        }
    }

    function CalculateInventoryInQrSold() {
        if ($("#ApartmentShopPlot_TotalNumberBooked").val() != "" && $("#ApartmentShopPlot_TotalNumberSold").val() != "" && $("#ApartmentShopPlot_NumberAvailableforSale").val() != "" && $("#ApartmentShopPlot_NumberSoldUptoRegistration").val() != "" && $("#ApartmentShopPlot_NumberSoldInQuarter").val() != "") {

            var aspTotalNumberBooked = parseInt($("#ApartmentShopPlot_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ApartmentShopPlot_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ApartmentShopPlot_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ApartmentShopPlot_NumberSoldUptoRegistration").val());
            var aspNumberNumberSoldInQuarter = parseInt($("#ApartmentShopPlot_NumberSoldInQuarter").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold + aspNumberSoldUptoRegistration + aspNumberNumberSoldInQuarter;
            
            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Number of Apartment/ Shop/ Plot.");
                parseInt($("#ApartmentShopPlot_NumberSoldInQuarter").val(0));
                parseInt($("#ApartmentShopPlot_TotalNumberSold").val(0));
                return false;
            }
            else {
                var calcQUPtotalSold = aspTotalNumberSold + aspNumberNumberSoldInQuarter;
                if (calcQUPtotalSold > 0)
                    $("#ApartmentShopPlot_TotalNumberSold").val(calcQUPtotalSold);
                else
                    $("#ApartmentShopPlot_TotalNumberSold").val(0);

                return true;
            }
        }
        else {
            return false;
        }
    }

    function CalculateInventoryInQrBooked() {
        if ($("#ApartmentShopPlot_TotalNumberBooked").val() != "" && $("#ApartmentShopPlot_TotalNumberSold").val() != "" && $("#ApartmentShopPlot_NumberAvailableforSale").val() != "" && $("#ApartmentShopPlot_NumberSoldUptoRegistration").val() != "" && $("#ApartmentShopPlot_NumberBookedInQuarter").val() != "") {

            var aspTotalNumberBooked = parseInt($("#ApartmentShopPlot_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ApartmentShopPlot_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ApartmentShopPlot_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ApartmentShopPlot_NumberSoldUptoRegistration").val());
            var aspNumberNumberBookedInQuarter = parseInt($("#ApartmentShopPlot_NumberBookedInQuarter").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold + aspNumberSoldUptoRegistration + aspNumberNumberBookedInQuarter;

            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Number of Apartment/ Shop/ Plot.");
                parseInt($("#ApartmentShopPlot_NumberBookedInQuarter").val(0));
                parseInt($("#ApartmentShopPlot_TotalNumberBooked").val(0));
                return false;
            }
            else {
                var calcQUPtotalBooked = aspTotalNumberBooked + aspNumberNumberBookedInQuarter;
                if (calcQUPtotalBooked > 0)
                    $("#ApartmentShopPlot_TotalNumberBooked").val(calcQUPtotalBooked);
                else
                    $("#ApartmentShopPlot_TotalNumberBooked").val(0);

                return true;
            }
        }
        else {
            return false;
        }
    }    

    function CalculateInventoryInQrCancelBooked() {
        if ($("#ApartmentShopPlot_NumberBookedInQuarter").val() != "" && $("#ApartmentShopPlot_NumberSoldInQuarter").val() != "" && $("#ApartmentShopPlot_NumberAvailableforSale").val() != "" && $("#ApartmentShopPlot_NumberSoldUptoRegistration").val() != "" && $("#ApartmentShopPlot_NumberCanceledBookedInQuarter").val() != "") {

            var aspNumberBookedInQuarter = parseInt($("#ApartmentShopPlot_NumberBookedInQuarter").val());
            var aspNumberSoldInQuarter = parseInt($("#ApartmentShopPlot_NumberSoldInQuarter").val());
            var aspNumberCanceledBookedInQuarter = parseInt($("#ApartmentShopPlot_NumberCanceledBookedInQuarter").val());
            var aspNumberAvailableforSale = parseInt($("#ApartmentShopPlot_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ApartmentShopPlot_NumberSoldUptoRegistration").val());
            var aspQUtotalBookedSoldInQU = ((aspNumberBookedInQuarter + aspNumberSoldInQuarter + aspNumberSoldUptoRegistration) - (aspNumberCanceledBookedInQuarter));

            if ((parseInt(aspQUtotalBookedSoldInQU)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Number of Apartment/ Shop/ Plot.");
                parseInt($("#ApartmentShopPlot_NumberCanceledBookedInQuarter").val(0));                
                return false;
            }
            else {
                return true;
            }
        }
        else {
            return false;
        }
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Quarterly Updates: List of Number and Types of Apartments/ Plots Details of Registered Project</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Quarterly Updates of Inventory Details :- [Fill in the quarterly update details of the type of apartments/ shops/ plots being developed or sold w.r.t. the project registration section (Add option shown in "select" column). Multiple types of apartments/ shops/ plots can be added under each of the building/ towers/ blocks.]
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("DropdownlistProjectQUpdate_QUInventoryDetails", "Project", FormMethod.Post, new { enctype = "multipart/form-data", id = "myfrmQUpdateInventory" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Project and Quarterly Update Option(s)</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Project</label>
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Registered project of quarterly updates are required.">
                                                @Html.DropDownListFor(m => m.Related_ProjectRegistration_ID, new SelectList((System.Collections.IEnumerable)TempData["list"], "ProjectRegistration_ID", "Project_Name"), "--Select--", new { @class = "form-control" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Year</label>
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Year of quarterly updates are required.">
                                                @if (@TempData["QUpdatesSelectedYears"] != null)
                                                {
                                                    @Html.DropDownListFor(model => model.QUpdateInventory_Year, new SelectList(ViewBag.Years, "Text", "Value", TempData["QUpdatesSelectedYears"]), "--Select--", new { @id = "drpQYear", @class = "form-control" })
                                                }
                                                else
                                                {
                                                    @Html.DropDownListFor(model => model.QUpdateInventory_Year, new SelectList(ViewBag.Years, "Text", "Value"), "--Select--", new { @id = "drpQYear", @class = "form-control" })
                                                }
                                                @Html.ValidationMessageFor(model => model.QUpdateInventory_Year, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Quarter</label>
                                                @{
                                                    var listItems1 = new List<SelectListItem>
                                                        {
                                                            new SelectListItem {  Text = "--Select--" , Value="NA"  },
                                                            new SelectListItem {  Text = "First Quarter (January-March)" , Value="FirstQTR"  },
                                                            new SelectListItem {  Text = "Second Quarter (April-June)" , Value="SecondQTR"  },
                                                            new SelectListItem {  Text = "Third Quarter (July-September)" , Value="ThirdQTR"  },
                                                            new SelectListItem {  Text = "Fourth Quarter (October-December)" , Value="FourthQTR"  },
                                                        };
                                                }
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Quarter Name of quarterly updates are required.">
                                                @Html.DropDownListFor(model => model.QUpdateInventory_QuarterName, new SelectList(listItems1, "Value", "Text"), new { @id = "drpQName", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.QUpdateInventory_QuarterName, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="BtnDrp" value="Proceed" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div @if (Session["Project_id"] != null) { @Html.Raw("style=''") } else { @Html.Raw("style='display: none;'") }>
                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    @Html.HiddenFor(model => model.QUpdateProjectInventory_IndexID)
                                    @Html.HiddenFor(model => model.QUpdateProjectInventory_ID)
                                    @Html.HiddenFor(model => model.Related_ProjectInventoryIndexID)
                                    @Html.HiddenFor(model => model.Related_ProjectInventory_ID)
                                    @Html.HiddenFor(model => model.Related_ProjectRegistration_ID)
                                    @Html.HiddenFor(model => model.QUpdateInventory_Year)
                                    @Html.HiddenFor(model => model.QUpdateInventory_QuarterName)

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <br/>
                                        </div>
                                    </div>
                                    if (Model.prpongoing != null)
                                    {
                                        if (Model.IsQuarterlyData != 5)
                                        {
                                            if (Model.IsRegisteredDiaryNumberLock != 9)
                                            {
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <div class="table-responsive">
                                                            <table class="table table-striped table-bordered" id="dataTables-QUpdatesProjectInventory">
                                                                <thead>
                                                                    <tr>
                                                                        <th><i class="fa fa-list-ol" aria-hidden="true"></i></th>
                                                                        <th>@Html.DisplayName("Select")</th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.BuildingTowerBlock_Name)
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_Type)
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_InventoryType)
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_CarpetArea)
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_NumberAvailableforSale)
                                                                        </th>
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_NumberSoldUptoRegistration)
                                                                        </th>                                                                        
                                                                        <th>
                                                                            @Html.DisplayNameFor(model => model.ApartmentShopPlot_TotalNumberBooked)
