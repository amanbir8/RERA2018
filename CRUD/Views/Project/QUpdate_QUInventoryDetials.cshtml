                                                                            @Html.ValidationMessageFor(model => model.ApartmentShopPlot_NumberFoundationsBasementsConstructedInQuarter, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </fieldset>

                                                            <fieldset class="col-md-12">
                                                                <legend class="my">Details of Total Inventory of Building/ Tower/ Block</legend>

                                                                <div class="row">
                                                                    <div class="form-group">
                                                                        <div class="col-md-3">
                                                                            <label class="control-label mand">Total Number of Floors Constructed/ Plots/ Others</label>
                                                                        </div>
                                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="In case of Group Housing or Building/ Tower Development, total number of floors constructed in each of the building/ tower is required. In case of plotted development, total number of plots in each of block/ others is required.">
                                                                            @Html.EditorFor(model => model.ApartmentShopPlot_TotalNumberFloorsConstructed, new { htmlAttributes = new { @class = "form-control" } })
                                                                            @Html.ValidationMessageFor(model => model.ApartmentShopPlot_TotalNumberFloorsConstructed, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="form-group">
                                                                        <div class="col-md-3">
                                                                            <label class="control-label mand">Total Booked</label>
                                                                        </div>
                                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Total booked in each of the building/ tower/ plotted development is required. Total numbers (sum of booked and sold) should not exceed the limits of inventory provided at the time of registration.">
                                                                            @Html.EditorFor(model => model.ApartmentShopPlot_TotalNumberBooked, new { htmlAttributes = new { @class = "form-control", onChange = "CalculateInventoryNumbers(this);" } })
                                                                            @Html.ValidationMessageFor(model => model.ApartmentShopPlot_TotalNumberBooked, "", new { @class = "text-danger" })
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="control-label mand">Total Sold</label>
                                                                        </div>
                                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Total sold in each of the building/ tower/ plotted development is required. Total numbers (sum of booked and sold) should not exceed the limits of inventory provided at the time of registration.">
                                                                            @Html.EditorFor(model => model.ApartmentShopPlot_TotalNumberSold, new { htmlAttributes = new { @class = "form-control", onChange = "CalculateInventoryNumbers(this);" } })
                                                                            @Html.ValidationMessageFor(model => model.ApartmentShopPlot_TotalNumberSold, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </fieldset>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            @if (Model.IsRegisteredDiaryNumberLock == 1 || Model.IsRegisteredDiaryNumberLock == 9)
                                                            {
                                                                <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                            }
                                                            else
                                                            {
                                                                if (Model.IsLock == 1 || Model.IsLock == 2)
                                                                {
                                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                                }
                                                                else
                                                                {
                                                                    if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                                    {
                                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                                    }
                                                                }
                                                            }                                                            
                                                            &nbsp;
                                                            @Html.ActionLink("Reset", "QUpdate_QUInventoryDetials", "Project", null, new { @class = "btn btn-outline btn-primary" })
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            <fieldset class="col-md-12">
                                                                <legend class="my">Not Applicable</legend>
                                                                <div class="row">
                                                                    <div class="form-group">
                                                                        <div class="col-md-2">
                                                                            @Html.Label("Quarterly Updates Status", htmlAttributes: new { @class = "control-label" })
                                                                        </div>
                                                                        <div class="col-md-9 alert alert-warning">
                                                                            Invalid! The registration of selected quarterly update details has been closed. Try Again.
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </fieldset>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            @Html.ActionLink("Cancel", "IndexPromoter", "Home", null, new { @class = "btn btn-outline btn-primary" })
                                                            &nbsp;
                                                            @Html.ActionLink("Reset", "QUpdate_QUInventoryDetials", "Project", null, new { @class = "btn btn-outline btn-primary" })
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                }
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
        <!-- /.col-lg-12 -->
        </div>
    <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

