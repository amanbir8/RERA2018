                                                        <a href="~/@Html.DisplayFor(modelItem => item.ProjectDoc_FilePath)" target="_blank" title="View Document"><i class="fa fa-external-link-square"></i></a>
                                                    </td>
                                                    <td align="center">
                                                        @if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            @("--")
                                                        }
                                                        else
                                                        {
                                                            @Html.ActionLink(" ", "Delete_ProjectDocument", new { inProjectDoc_IndexID = item.ProjectDoc_IndexID, inProjectDoc_ID = item.ProjectDoc_ID, inProject_ID = item.Project_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-remove fa-lg", @title = "Delete Document" })                                                           
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

}

