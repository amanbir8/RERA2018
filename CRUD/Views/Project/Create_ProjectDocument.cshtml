<script>
    function highlightPendingDocs() {

        var uploadedDocs = [];
        var upload = '';
        //var uploadedDocs = ['1010', '1025', '1018', '1020', '1006'];        

        var baseUrl = $('body').attr('data-base-url');        
        $.ajax({
            type: "POST",
            url: baseUrl + "Project/GetProjectDocumentUploadedList_ByProjectId",
            datatype: "Json",
            data: { parmProjectId: $('#Project_ID').val() },
            success: function (data) {
                var jsonData = JSON.parse(data);
                $.each(jsonData, function (index, value) {
                    uploadedDocs.push(value.Id.toString());
                });

                // get all documents list
                var listHtml = '';
                $('select#ProjectDoc_InfoCode').find('option').each(function () {
                    var itemText = $.trim($(this).text());
                    var itemId = $(this).val();
                    var color = '#3c763d';
                    var iconClass = 'check';
                    if (itemId) {
                        if ($.inArray(itemId, uploadedDocs) == -1) {
                            var color = '#a94442';
                            var iconClass = 'times';
                        }
                        var itemHtml = '<a style="color: ' + color + '" data-doc-id="' + itemId + '" href="javascript:void(0);" class="list-group-item"><i class="fa fa-' + iconClass + ' fa-fw"></i><span class=""> ' + itemText + '</span></a>';
                        listHtml = listHtml + itemHtml;
                    }
                });
                $('div.pending-list-documents').html(listHtml);

            }
        });

        
    }

    function singleFileSelected() {
        //var selectedFile = evt.target.files can use this  or select input file element
        //and access it's files object
        //debugger;
        var baseUrl = $('body').attr('data-base-url');
        $(".InfoContainer").fadeIn();
        var selectedFile = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];
        if (selectedFile) {
            var FileSize = 0;
            var imageType = /image.*/;
            if (selectedFile.size > 1048576) {
                FileSize = Math.round(selectedFile.size * 100 / 1048576) / 100 + " MB";
            }
            else if (selectedFile.size > 1024) {
                FileSize = Math.round(selectedFile.size * 100 / 1024) / 100 + " KB";
            }
            else {
                FileSize = selectedFile.size + " Bytes";
            }
            // here we will add the code of thumbnail preview of upload images

            $("#showFileInfoGrid").show();
            $("#FileName").text("Name : " + selectedFile.name);
            $("#FileType").text("Type : " + selectedFile.type);
            $("#FileSize").text("Size : " + FileSize);

            $("#showSaveFileUploadMessage").hide();


            if (selectedFile.type.match(imageType)) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = reader.result;
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "100";
                    img.width = "100";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(100);
                    $("#Imagecontainer").width(100);
                };
                reader.readAsDataURL(selectedFile);
            }
            if (selectedFile.type.match('application/pdf')) {
                var reader = new FileReader();
                reader.onload = function (e) {

                    $("#Imagecontainer").empty();
                    var dataURL = baseUrl + 'images/pdf.png';
                    var img = new Image()
                    img.src = dataURL;
                    img.height = "35";
                    img.width = "35";
                    img.className = "thumb";
                    $("#Imagecontainer").append(img);
                    $("#Imagecontainer").height(35);
                    $("#Imagecontainer").width(35);
                };
                reader.readAsDataURL(selectedFile);
            }
        }
    }
</script>
<script type="text/javascript">

    $(function () {
        $("#FormUpload").submit(function (event) {
            //debugger;
            var form = $('#FormUpload')[0];

                //var dataString = new FormData(form);
                var baseUrl = $('body').attr('data-base-url');
                var files = ($("#UploadedFile"))[0].files[0];//FileControl.files[0];

                if (typeof files === 'undefined') {
                    $("#showSaveFileUploadMessage").show();
                    $("#saveFileUploadMessageName").text("Note : Please Add files... to Upload!");
                    //alert('Please Add file(s) to Upload!');
                    return false;
                }
                //var files = $("#FileUpload1")[0].files;
                if (files.size > 0) {
                    var formData = new FormData(form);
                    for (var i = 0; i < files.length; i++) {
                        formData.append(files[i].name, files[i]);
                    }

                    var progressbarLabel = $('#progressBar-label');
                    var progressbarDiv = $('#progressbar');

                    $.ajax({
                        url: baseUrl + 'Project/ProjectDocumentFormUpload',
                        method: 'POST',
                        data: formData,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            //alert(data.status);
                            if (data.statusCode == 101)
                            {
                                progressbarLabel.text('COMPLETE');
                                progressbarDiv.fadeOut(2000);
                                $(".InfoContainer").fadeOut(2000);
                                $("#showFileInfo").fadeOut(2500);

                                // Load Uploaded List - Highlight Pending Docs
                                highlightPendingDocs(); 
                            }
                            else
                            {
                                progressbarLabel.text('Bad Request! Upload Failed');
                                progressbarDiv.fadeOut(2000);

                                $("#showSaveFileUploadMessage").show();
                                $("#saveFileUploadMessageName").text("Note : " + data.status);
                            }

                        },
                        failure: function(data) {
                            alert('Bad Request! Upload Failed');
                        },
                        error: function (err) {
                            //alert(err.message);
                            alert('Bad Request! Upload Failed');
                            //alert(err.statusText);
                        }
                    });

                    progressbarLabel.text('UPLOADING ...');
                    progressbarDiv.progressbar({
                        value: false
                    }).fadeIn(500);


                    $("#showSaveFileUploadMessage").hide();
                }

                return false;
        });

        $("#ProjectDoc_InfoCode").change(function () {
            $("#showFileInfo").show();
        });

        $('#ProjectDoc_InfoCode').change(function () {

            //$('#OfficialComm_AddressDistrictCode').empty();
            //$('#getDocFileInfo').fadeIn();
            var baseUrl = $('body').attr('data-base-url');
            //debugger;
            $.ajax({
                type: "POST",
                url: baseUrl + "Project/GetProjectDocumentMasterByDocId",
                datatype: "Json",
                data: { DocId: $('#ProjectDoc_InfoCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#getDocFileInfo').show();

                        //$('#DocName').text("File Name : " + value.PromoterDocMaster_InfoName);
                        $('#DocFileFormat').text("File Format : " + value.ProjectDoc_SetFileFormat);

                        var ofilesize = 0;
                        if (value.ProjectDoc_SetFileSize > 1048576) {
                            ofilesize = Math.round(value.ProjectDoc_SetFileSize * 100 / 1048576) / 100 + " MB";
                        }
                        else if (value.ProjectDoc_SetFileSize > 1024) {
                            ofilesize = Math.round(value.ProjectDoc_SetFileSize * 100 / 1024) / 100 + " KB";
                        }
                        else {
                            ofilesize = value.ProjectDoc_SetFileSize + " Bytes";
                        }

                        $('#DocFileSize').text("File Size : " + ofilesize);
                        if (value.IsMandatory == 1)
                        {
                            $('#DocFileMandatoryStatus').text("File Status : This document is mandatory file for project registration/upload.");
                        }
                        else
                        {
                            $('#DocFileMandatoryStatus').text("File Status : This document is optional file to upload.");
                        }
                        $('#DocFileDiscription').text("Description : " + value.A_column);

                        $('#ProjectDoc_RelatedSectionName').val(value.ProjectDocMaster_RelatedSectionName);
                        $("#hdnProjectRelatedSection").val(value.ProjectDocMaster_RelatedSectionName);
                        $('#ProjectDoc_RelatedSectionName').attr('disabled', true);                         
                        
                        //value.PromoterDoc_IsGroup == 1
                        //var num = typeof value.PromoterDoc_IsGroup;
                        //var ofilegroupsize = num.toString();
                        //$('#DocFileGroupSize').text("File Limits : Max. Number of Files limited to " + ofilegroupsize + " file(s) only.");


                        //$('#OfficialComm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });

        $('#ProjectDoc_InfoCode').change(function () {
            $('#ProjectDoc_InfoName').empty();
            $("input[name='ProjectDoc_InfoName']").val($("#ProjectDoc_InfoCode option:selected").text());
        });

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4, 5]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    });
</script>
