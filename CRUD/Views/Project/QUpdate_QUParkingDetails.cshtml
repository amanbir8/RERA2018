@model CRUD.Models.PromoterProject.ClsPrp_QUpdateProject_ParkingDetails

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<script>
    function rowContentwithformat(d, Index, Counter) {
        // `d` is the original data object for the row
        //console.log(d);
        //console.log(Index);
        if (Counter > 0) {
            var i;
            var fLen = parseInt(Counter);
            fLen = fLen + 1;

            var parmVarPrkName = [];
            var parmVarPrkBQ = [];
            var parmVarPrkCBQ = [];
            var parmVarPrkSQ = [];
            var parmVarPrkBtotal = [];
            var parmVarPrkStotal = [];            
            var parmTableRows = '';

            for (i = 1; i < fLen; i++) {
                parmVarPrkName[i] = $.trim($(d).find('#hdnVarPrkName' + Index + 'arr' + i).val());
                parmVarPrkBQ[i] = $.trim($(d).find('#hdnVarPrkBQ' + Index + 'arr' + i).val());
                parmVarPrkCBQ[i] = $.trim($(d).find('#hdnVarPrkCBQ' + Index + 'arr' + i).val());
                parmVarPrkSQ[i] = $.trim($(d).find('#hdnVarPrkSQ' + Index + 'arr' + i).val());
                parmVarPrkBtotal[i] = $.trim($(d).find('#hdnVarPrkBtotal' + Index + 'arr' + i).val());
                parmVarPrkStotal[i] = $.trim($(d).find('#hdnVarPrkStotal' + Index + 'arr' + i).val());
                
                parmTableRows = parmTableRows +
                    '<tr>' +
                        '<td><b>(' + i + ')</b> Parking Information <b>(in the Quarter)</b>: </td>' +
                        '<td><b>' + parmVarPrkName[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(a.) Number of Parking Units booked: </td>' +
                        '<td><b>' + parmVarPrkBQ[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(b.) Number of Parking Units under canceled booking: </td>' +
                        '<td><b>' + parmVarPrkCBQ[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(c.) Number of Parking Units sold: </td>' +
                        '<td><b>' + parmVarPrkSQ[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(d.) Total Booked: </td>' +
                        '<td><b>' + parmVarPrkBtotal[i] + '</b> (Total)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(e.) Total Sold: </td>' +
                        '<td><b>' + parmVarPrkStotal[i] + '</b> (Total)</td>' +
                    '</tr>' +                    
                    '<tr>' +
                        '<td colspan="2"><br/></td>' +
                    '</tr>';
            }
        }

        return '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">' + parmTableRows + '</table>';
    }

    $(document).ready(function () {
        $('#dataTables-QUpdatesProjectParking tbody').on('click', 'td.details-control', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var qdataArrayIndex = $.trim($(parentRow).find('td.hdn-prk-array-number').attr('data-prk-array-number'));
            var qdataSubArrayCounter = $.trim($(parentRow).find('td.hdn-array-counter').attr('data-array-counter'));
            var mtable = $('#dataTables-QUpdatesProjectParking').DataTable();

            var tr = $(this).closest('tr');
            var row = mtable.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                row.child(rowContentwithformat(row.data(), qdataArrayIndex, qdataSubArrayCounter)).show();
                tr.addClass('shown');
            }
        });
    });
</script>
