<script type="text/javascript">
    $(document).ready(function () {

        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpProjectText = $(document).find("select#Related_ParkingProjectRegistration_ID").val();
            var drpYearPrjText = $(document).find("select#drpQYear").val();
            var drpQuarterPrjText = $(document).find("select#drpQName").val();

            if ($.trim(drpProjectText) == "" || $.trim(drpYearPrjText) == "" || $.trim(drpQuarterPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#Related_ParkingProjectRegistration_ID").val();
            var drpYrPrjText = $(document).find("select#drpQYear").val();
            var drpQtrPrjText = $(document).find("select#drpQName").val();
            if ($.trim(drpText) == "" || $.trim(drpYrPrjText) == "" || $.trim(drpQtrPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
                drpText = "";
                drpYrPrjText = "";
                drpQtrPrjText = "NA";
                return false;
            }
            else {
                $(submitButton).parents('form').submit();
                // $("#idMainForm").show();
            }
        });

        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<script>
    function CalculateParkingNumbers() {
        if ($("#ParkingSpaceUnits_TotalNumberBooked").val() != "" && $("#ParkingSpaceUnits_TotalNumberSold").val() != "" && $("#ParkingSpaceUnits_NumberAvailableforSale").val() != "" && $("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val() != "") {

            var aspTotalNumberBooked = parseInt($("#ParkingSpaceUnits_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ParkingSpaceUnits_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ParkingSpaceUnits_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold; // + aspNumberSoldUptoRegistration;

            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Parking Space Units.");
                parseInt($("#ParkingSpaceUnits_TotalNumberBooked").val(0));
                parseInt($("#ParkingSpaceUnits_TotalNumberSold").val(0));
                return false;
            }
            else {
                return true;
            }
        }
        else {
            return false;
        }
    }

    function CalculateParkingInQrSold() {
        if ($("#ParkingSpaceUnits_TotalNumberBooked").val() != "" && $("#ParkingSpaceUnits_TotalNumberSold").val() != "" && $("#ParkingSpaceUnits_NumberAvailableforSale").val() != "" && $("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val() != "" && $("#ParkingSpaceUnits_NumberSoldInQuarter").val() != "") {

            var aspTotalNumberBooked = parseInt($("#ParkingSpaceUnits_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ParkingSpaceUnits_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ParkingSpaceUnits_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val());
            var aspNumberNumberSoldInQuarter = parseInt($("#ParkingSpaceUnits_NumberSoldInQuarter").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold + aspNumberSoldUptoRegistration + aspNumberNumberSoldInQuarter;

            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Parking Space Units.");
                parseInt($("#ParkingSpaceUnits_NumberSoldInQuarter").val(0));
                parseInt($("#ParkingSpaceUnits_TotalNumberSold").val(0));
                return false;
            }
            else {
                var calcQUPtotalSold = aspTotalNumberSold + aspNumberNumberSoldInQuarter;
                if (calcQUPtotalSold > 0)
                    $("#ParkingSpaceUnits_TotalNumberSold").val(calcQUPtotalSold);
                else
                    $("#ParkingSpaceUnits_TotalNumberSold").val(0);

                return true;
            }
        }
        else {
            return false;
        }
    }

    function CalculateParkingInQrBooked() {
        if ($("#ParkingSpaceUnits_TotalNumberBooked").val() != "" && $("#ParkingSpaceUnits_TotalNumberSold").val() != "" && $("#ParkingSpaceUnits_NumberAvailableforSale").val() != "" && $("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val() != "" && $("#ParkingSpaceUnits_NumberBookedInQuarter").val() != "") {

            var aspTotalNumberBooked = parseInt($("#ParkingSpaceUnits_TotalNumberBooked").val());
            var aspTotalNumberSold = parseInt($("#ParkingSpaceUnits_TotalNumberSold").val());
            var aspNumberAvailableforSale = parseInt($("#ParkingSpaceUnits_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val());
            var aspNumberNumberBookedInQuarter = parseInt($("#ParkingSpaceUnits_NumberBookedInQuarter").val());
            var aspQUtotalBookedSold = aspTotalNumberBooked + aspTotalNumberSold + aspNumberSoldUptoRegistration + aspNumberNumberBookedInQuarter;

            if ((parseInt(aspQUtotalBookedSold)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Parking Space Units.");
                parseInt($("#ParkingSpaceUnits_NumberBookedInQuarter").val(0));
                parseInt($("#ParkingSpaceUnits_TotalNumberBooked").val(0));
                return false;
            }
            else {
                var calcQUPtotalBooked = aspTotalNumberBooked + aspNumberNumberBookedInQuarter;
                if (calcQUPtotalBooked > 0)
                    $("#ParkingSpaceUnits_TotalNumberBooked").val(calcQUPtotalBooked);
                else
                    $("#ParkingSpaceUnits_TotalNumberBooked").val(0);

                return true;
            }
        }
        else {
            return false;
        }
    }

    function CalculateParkingInQrCancelBooked() {
        if ($("#ParkingSpaceUnits_NumberBookedInQuarter").val() != "" && $("#ParkingSpaceUnits_NumberSoldInQuarter").val() != "" && $("#ParkingSpaceUnits_NumberAvailableforSale").val() != "" && $("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val() != "" && $("#ParkingSpaceUnits_NumberCanceledBookedInQuarter").val() != "") {

            var aspNumberBookedInQuarter = parseInt($("#ParkingSpaceUnits_NumberBookedInQuarter").val());
            var aspNumberSoldInQuarter = parseInt($("#ParkingSpaceUnits_NumberSoldInQuarter").val());
            var aspNumberCanceledBookedInQuarter = parseInt($("#ParkingSpaceUnits_NumberCanceledBookedInQuarter").val());
            var aspNumberAvailableforSale = parseInt($("#ParkingSpaceUnits_NumberAvailableforSale").val());
            var aspNumberSoldUptoRegistration = parseInt($("#ParkingSpaceUnits_NumberBookedSoldUptoRegistration").val());
            var aspQUtotalBookedSoldInQU = ((aspNumberBookedInQuarter + aspNumberSoldInQuarter + aspNumberSoldUptoRegistration) - (aspNumberCanceledBookedInQuarter));

            if ((parseInt(aspQUtotalBookedSoldInQU)) > (parseInt(aspNumberAvailableforSale))) {
                alert("Invalid! Value cannot be more than Total Parking Space Units.");
                parseInt($("#ParkingSpaceUnits_NumberCanceledBookedInQuarter").val(0));
                return false;
            }
            else {
                return true;
            }
        }
        else {
            return false;
        }
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Quarterly Updates: List of Number and Garages/ Covered Car Parking Details of Registered Project</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Quarterly Updates of Parking Details :- [Fill in the quarterly update details (Add option shown in "select" column) of garages/ covered car parking in the stilt and basement for sale and booked.]
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            @using (Html.BeginForm("DropdownlistProjectQUpdate_QUParkingDetails", "Project", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Project and Quarterly Update Option(s)</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Project</label>
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Registered project of quarterly updates are required.">
                                                @Html.DropDownListFor(m => m.Related_ParkingProjectRegistration_ID, new SelectList((System.Collections.IEnumerable)TempData["list"], "ProjectRegistration_ID", "Project_Name"), "--Select--", new { @class = "form-control" })
                                            </div>                                            
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Year</label>
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Year of quarterly updates are required.">
                                                @if (@TempData["QUpdatesSelectedYears"] != null)
                                                {
                                                    @Html.DropDownListFor(model => model.QUpdateParking_Year, new SelectList(ViewBag.Years, "Text", "Value", TempData["QUpdatesSelectedYears"]), "--Select--", new { @id = "drpQYear", @class = "form-control" })
                                                }
                                                else
                                                {
                                                    @Html.DropDownListFor(model => model.QUpdateParking_Year, new SelectList(ViewBag.Years, "Text", "Value"), "--Select--", new { @id = "drpQYear", @class = "form-control" })
                                                }
                                                @Html.ValidationMessageFor(model => model.QUpdateParking_Year, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">Select Quarter</label>
                                                @{
                                                    var listItems1 = new List<SelectListItem>
                                                        {
                                                            new SelectListItem {  Text = "--Select--" , Value="NA"  },
                                                            new SelectListItem {  Text = "First Quarter (January-March)" , Value="FirstQTR"  },
                                                            new SelectListItem {  Text = "Second Quarter (April-June)" , Value="SecondQTR"  },
                                                            new SelectListItem {  Text = "Third Quarter (July-September)" , Value="ThirdQTR"  },
                                                            new SelectListItem {  Text = "Fourth Quarter (October-December)" , Value="FourthQTR"  },
                                                        };
                                                }
                                            </div>
                                            <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="For quarterly updates details of registered project, Quarter Name of quarterly updates are required.">
                                                @Html.DropDownListFor(model => model.QUpdateParking_QuarterName, new SelectList(listItems1, "Value", "Text"), new { @id = "drpQName", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.QUpdateParking_QuarterName, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-6">
                                                <input type="Submit" id="BtnDrp" value="Proceed" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                            }
                            <div @if (Session["Project_id"] != null) { @Html.Raw("style=''") } else { @Html.Raw("style='display: none;'") }>
                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    
                                    @Html.HiddenFor(model => model.QUpdateProjectParking_IndexID)
                                    @Html.HiddenFor(model => model.QUpdateProjectParking_ID)
                                    @Html.HiddenFor(model => model.Related_ProjectParking_IndexID)
                                    @Html.HiddenFor(model => model.Related_ProjectParking_ID)
                                    @Html.HiddenFor(model => model.Related_ParkingProjectRegistration_ID)
                                    @Html.HiddenFor(model => model.QUpdateParking_Year)
                                    @Html.HiddenFor(model => model.QUpdateParking_QuarterName)

                                    <div class="row">
                                        <div class="col-lg-12">
                                            <br />
                                        </div>
                                    </div>
                                    if (Model.prpongoing != null)
                                    {
                                        if (Model.IsQuarterlyData != 5)
                                        {
                                            if (Model.IsRegisteredDiaryNumberLock != 9)
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered" id="dataTables-QUpdatesProjectParking">
                                                        <thead>
                                                            <tr>
                                                                <th><i class="fa fa-list-ol" aria-hidden="true"></i></th>
                                                                <th>@Html.DisplayName("Select")</th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingType)
                                                                </th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingSpaceUnits_TotalArea)
                                                                </th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingSpaceUnits_NumberAvailableforSale)
                                                                </th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingSpaceUnits_NumberBookedSoldUptoRegistration)
                                                                </th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingSpaceUnits_TotalNumberBooked)
                                                                </th>
                                                                <th>
                                                                    @Html.DisplayNameFor(model => model.ParkingSpaceUnits_TotalNumberSold)
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @{
                                                                int snoParkings = 0;
                                                                int counterParkings = 0;
                                                                string snoAddQUpdateID = "";
                                                                string snoDeleteQUpdateID = "";
                                                            }
                                                            @foreach (var item in Model.prpongoing)
                                                            {
                                                                {
                                                                    counterParkings = 1;
                                                                    snoParkings = snoParkings + 1;
                                                                }
                                                                <tr>
                                                                    <td class="details-control"></td>
                                                                    <td>
                                                                        <script type="text/javascript">
                                                                            $(document).ready(function () {
                                                                                showSelectButtonColorEvent("@item.IsLock.ToString()", "@item.IsDraft.ToString()", "@item.IsRegisteredDiaryNumberLock.ToString()", "@item.IsQuarterlyData.ToString()", "@snoParkings.ToString()");
                                                                            });
                                                                        </script>
                                                                        @{
                                                                            snoAddQUpdateID = "btnAddQUpdateID" + @snoParkings.ToString();
                                                                            snoDeleteQUpdateID = "btnDeleteQUpdateID" + @snoParkings.ToString();
                                                                        }
                                                                        @if (item.IsRegisteredDiaryNumberLock == 1) //RL
                                                                        {
                                                                            <span class="justify-content-center">
                                                                                <a href="javascript:void(0);"><span id=@snoAddQUpdateID.ToString() title="Quarterly Updates Locked" class="qulinkaction-lock"></span></a>
                                                                                <span>&nbsp;</span>
                                                                                <a href="javascript:void(0);"><span id=@snoDeleteQUpdateID.ToString() title="Delete Quarterly Updates" class="qulinkaction-trash"></span></a>
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            if (item.IsLock == 1 || item.IsLock == 2) //RL
                                                                            {
                                                                                <span class="justify-content-center">
                                                                                    <a href="javascript:void(0);"><span id=@snoAddQUpdateID.ToString() title="Quarterly Updates Locked" class="qulinkaction-lock"></span></a>
                                                                                    <span>&nbsp;</span>
                                                                                    <a href="javascript:void(0);"><span id=@snoDeleteQUpdateID.ToString() title="Delete Quarterly Updates" class="qulinkaction-trash"></span></a>
                                                                                </span>
                                                                            }
                                                                            else //QU
                                                                            {
                                                                                if (item.IsQuarterlyData == 1 || item.IsQuarterlyData == 3) //CL
                                                                                {
                                                                                    <span class="justify-content-center">
                                                                                        <span>
                                                                                            @Html.ActionLink(" ", "QUpdateEdit_QUParkingDetails", new { PRID = item.Related_ParkingProjectRegistration_ID, quPPIndexID = item.QUpdateProjectParking_IndexID, quPPID = item.QUpdateProjectParking_ID, rPPIndexID = item.Related_ProjectParking_IndexID, rPPID = item.Related_ProjectParking_ID }, new { @class = "qulinkaction-icon", title = "Add Quarterly Updates" })
                                                                                        </span>
                                                                                        <span>&nbsp;</span>
                                                                                        <a href="javascript:void(0);"><span title="Quarterly Updates Locked" class="qulinkaction-trash disabledlockunlock"></span></a>
                                                                                    </span>
                                                                                }
