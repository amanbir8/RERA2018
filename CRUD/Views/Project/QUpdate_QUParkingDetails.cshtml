@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <script>
        function showSelectButtonColorEvent(srCntlFlag, srQuarterFlag, srDNoFlag, srRDFlag, srNo) {
            var parmLockUnlock = srQuarterFlag;
            var parmCntl = srCntlFlag;
            var parmDNo = srDNoFlag;
            var parmRD = srRDFlag;
            var vargetAddQUpdateID = '#btnAddQUpdateID' + srNo;
            var vargetDeleteQUpdateID = '#btnDeleteQUpdateID' + srNo;

            if (parmDNo == 1) { //RL
                $(document).find(vargetAddQUpdateID.trim()).prop('disabled', true);
                $(document).find(vargetAddQUpdateID.trim()).addClass("disabledlockunlock");
                $(document).find(vargetDeleteQUpdateID.trim()).prop('disabled', true);
                $(document).find(vargetDeleteQUpdateID.trim()).addClass("disabledlockunlock");
            }
            else {
                if (parmCntl == 1 || parmCntl == 2) { //RL
                    $(document).find(vargetAddQUpdateID.trim()).prop('disabled', true);
                    $(document).find(vargetAddQUpdateID.trim()).addClass("disabledlockunlock");
                    $(document).find(vargetDeleteQUpdateID.trim()).prop('disabled', true);
                    $(document).find(vargetDeleteQUpdateID.trim()).addClass("disabledlockunlock");
                }
                else {
                    if (parmRD == 1 || parmRD == 3) { //RL
                        $(document).find(vargetAddQUpdateID.trim()).prop('disabled', false);
                        $(document).find(vargetAddQUpdateID.trim()).removeClass("disabledlockunlock");
                        $(document).find(vargetDeleteQUpdateID.trim()).prop('disabled', true);
                        $(document).find(vargetDeleteQUpdateID.trim()).addClass("disabledlockunlock");
                    }
                    else {
                        if (parmLockUnlock == 1 || parmLockUnlock == 5 || parmLockUnlock == 6) { //RL
                            $(document).find(vargetAddQUpdateID.trim()).prop('disabled', false);
                            $(document).find(vargetAddQUpdateID.trim()).removeClass("disabledlockunlock");
                            $(document).find(vargetDeleteQUpdateID.trim()).prop('disabled', true);
                            $(document).find(vargetDeleteQUpdateID.trim()).addClass("disabledlockunlock");
                        }
                        else {
                            $(document).find(vargetAddQUpdateID.trim()).prop('disabled', false);
                            $(document).find(vargetAddQUpdateID.trim()).removeClass("disabledlockunlock");
                            $(document).find(vargetDeleteQUpdateID.trim()).prop('disabled', false);
                            $(document).find(vargetDeleteQUpdateID.trim()).removeClass("disabledlockunlock");
                        }
                    }
                }
            }
        }

        $('table#dataTables-QUpdatesProjectParking').dataTable({
            responsive: true,
            "pageLength": 15,
            "lengthMenu": [[15, 30, 45, 60, 100], [15, 30, 45, 60, 100]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [1]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    </script> 

