</script>
<script type="text/javascript">

    @if (TempData["selectCntlParking"].ToString() != "")
    {
        <text>
            $(document).ready(function()
            {
                var drpCntlText = "@TempData["selectCntlParking"]";
                if (drpCntlText == "CntlLock") {
                    $("#Related_ParkingProjectRegistration_ID").prop("disabled", true);
                    $("#drpQYear").prop("disabled", true);
