</script>
<script type="text/javascript">

    @if (TempData["selectCntlInternalFacilities"].ToString() != "")
    {
        <text>
            $(document).ready(function()
            {
                var drpCntlText = "@TempData["selectCntlInternalFacilities"]";
                if (drpCntlText == "CntlLock") {
                    $("#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").prop("disabled", true);
                    $("#drpQYear").prop("disabled", true);
                    $("#drpQName").prop("disabled", true);
                    $("#BtnDrp").addClass("display-btnlock").removeClass("display-btnunlock");
                    $("#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").addClass("quborder-disabled");
                    $("#drpQYear").addClass("quborder-disabled");
                    $("#drpQName").addClass("quborder-disabled");
                }
                else {
                    $("#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").prop("disabled", false);
                    $("#drpQYear").prop("disabled", false);
                    $("#drpQName").prop("disabled", false);
                    $("#BtnDrp").addClass("display-btnunlock").removeClass("display-btnlock");
                    $("#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").removeClass("quborder-disabled");
                    $("#drpQYear").removeClass("quborder-disabled");
                    $("#drpQName").removeClass("quborder-disabled");
                }
            });
        </text>
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {

        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpProjectText = $(document).find("select#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").val();
            var drpYearPrjText = $(document).find("select#drpQYear").val();
            var drpQuarterPrjText = $(document).find("select#drpQName").val();

            if ($.trim(drpProjectText) == "" || $.trim(drpYearPrjText) == "" || $.trim(drpQuarterPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpProjectText = $(document).find("select#ProjectInfrastructureFacilitiesRelated_ProjectRegistration_ID").val();
            var drpYearPrjText = $(document).find("select#drpQYear").val();
            var drpQuarterPrjText = $(document).find("select#drpQName").val();

            if ($.trim(drpProjectText) == "" || $.trim(drpYearPrjText) == "" || $.trim(drpQuarterPrjText) == "NA") {
                alert("Invalid Project/ Year/ Quarter! Please select the Project or Year or Quarter Name.")
                drpProjectText = "";
                drpYearPrjText = "";
                drpQuarterPrjText = "NA";
                return false;
            }
            else {
                $(submitButton).parents('form').submit();
            }
        });

        $('[data-toggle="tooltip"]').tooltip();        
    });
</script>
<script>
    function CalculateWorkPercentageNumbers() {
        if ($("#WorkProgress_PercentageUptoRegistration").val() != "" && $("#WorkProgress_PercentageInQuarter").val() != "" && $("#WorkProgress_PercentageTotal").val() != "") {

            var aspNumberWPercentageTotal = parseFloat($("#WorkProgress_PercentageTotal").val());
            var aspNumberWPercentageInQuarter = parseFloat($("#WorkProgress_PercentageInQuarter").val());
            var aspNumberWPercentageUptoRegistration = parseFloat($("#WorkProgress_PercentageUptoRegistration").val());

            if ((parseFloat(aspNumberWPercentageTotal)) > (parseFloat(aspNumberWPercentageUptoRegistration))) {
                var aspQUtotalWPercentageInQuarter = aspNumberWPercentageTotal - aspNumberWPercentageUptoRegistration;
                $("#WorkProgress_PercentageInQuarter").val(aspQUtotalWPercentageInQuarter)
                return true;
            }
            else {
                alert("Invalid! Value cannot be less than work progress % percentage value upto registration.");
                parseFloat($("#WorkProgress_PercentageTotal").val(0));
                parseFloat($("#WorkProgress_PercentageInQuarter").val(0));
                return false;
            }
        }
        else {
            return false;
        }
    }

    function CalculateWorkPercentageInQtr() {
        if ($("#WorkProgress_PercentageUptoRegistration").val() != "" && $("#WorkProgress_PercentageInQuarter").val() != "" && $("#WorkProgress_PercentageTotal").val() != "") {

            var aspNumberWPercentageTotal = parseFloat($("#WorkProgress_PercentageTotal").val());
            var aspNumberWPercentageInQuarter = parseFloat($("#WorkProgress_PercentageInQuarter").val());
            var aspNumberWPercentageUptoRegistration = parseFloat($("#WorkProgress_PercentageUptoRegistration").val());
            var aspQUtotalWPercentage = aspNumberWPercentageInQuarter + aspNumberWPercentageUptoRegistration;

            if ((parseFloat(aspQUtotalWPercentage)) > (parseFloat(100))) {
                alert("Invalid! Value of total work progress % percentage.");
                parseFloat($("#WorkProgress_PercentageTotal").val(0));
                parseFloat($("#WorkProgress_PercentageInQuarter").val(0));
                return false;
            }
            else {                
                if (aspQUtotalWPercentage > 0)
                    $("#WorkProgress_PercentageTotal").val(aspQUtotalWPercentage);
                else {
                    parseFloat($("#WorkProgress_PercentageTotal").val(0));
                    parseFloat($("#WorkProgress_PercentageInQuarter").val(0));
                }
                return true;
            }
        }
        else {
            return false;
        }
    }
</script>

