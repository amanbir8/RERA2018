<script type="text/javascript">
    $(function () {

        var drpYearText = $(document).find("select#drpQYear").val();
        var drpQuarterText = $(document).find("select#drpQName").val();

        $("#hdnQYear").val(drpYearText);
        $("#hdnQName").val(drpQuarterText);

        //$('#drpQYear').attr('disabled', true);
        //$('#drpQName').attr('disabled', true);
        //$('#A_column').attr('readonly', false);
        //$('#B_column').attr('readonly', true);


        $('#OfficialComm_AddressStateCode').change(function () {

            $('#OfficialComm_AddressDistrictCode').empty();
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "Project/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#OfficialComm_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#OfficialComm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });


        $('table#promoter-documents-list-table').dataTable({
            
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });

    });
</script>
    <script type="text/javascript">
        $(document).ready(function () {

            $(document).on('click', '#BtnDrp', function (e) {
                e.preventDefault();
                var proceedButton = $(this);
                var drpText = $(document).find("select#ProjectProfessionalRelated_ProjectRegistration_ID").val();
                //alert(drpText)
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    // $("#idMainForm").hide();
                }
                else {
                    $("#idMainForm").show();
                    $(proceedButton).parents('form').submit();
                }
            });

            $(document).on('click', '#BtnMainform', function (e) {
                var submitButton = $(this);
                e.preventDefault();
                var drpText = $(document).find("select#ProjectProfessionalRelated_ProjectRegistration_ID").val();
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    //$("#idMainForm").hide();
                    drpText = "";
                    return false;
                }
                else {
                    $(submitButton).parents('form').submit();
                    // $("#idMainForm").show();
                }


            });

            $('[data-toggle="tooltip"]').tooltip();

        });
    </script>
