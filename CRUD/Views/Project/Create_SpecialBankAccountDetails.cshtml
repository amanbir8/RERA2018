<script type="text/javascript">
    $(function () {

        $('#Bank_AddressStateCode').change(function () {

            $('#Bank_AddressDistrictCode').empty();
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "Project/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#Bank_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#Bank_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });

        $('#Bank_AccountNumber').change(function () {
            //debugger;
            var AcNo = $("#Bank_AccountNumber").val();
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "Project/CheckBankAccountNumber",
                data: '{AccountNumber: "' + AcNo + '" }',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // var message = $("#message");
                    if (response) {
                        //Email available.
                        alert("Bank Account Number Already exist! Try another.")
                        $("#Bank_AccountNumber").val(0);
                        // message.css("color", "green");
                        // message.html("Email is available");
                    }

                }
            });
        });
    });
</script>
<script type="text/javascript">
      function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }
</script>
<script>
$(function() {
    $('[data-spzoom]').spzoom();
});
</script> 
<script type="text/javascript">
        $(document).ready(function () {

            $(document).on('click', '#BtnDrp', function (e) {
                e.preventDefault();
                var proceedButton = $(this);
                var drpText = $(document).find("select#SpecialBankAccountRelated_ProjectRegistration_ID").val();
                //alert(drpText)
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    // $("#idMainForm").hide();
                }
                else {
                    $("#idMainForm").show();
                    $(proceedButton).parents('form').submit();
                }
            });

            $(document).on('click', '#BtnMainform', function (e) {
                var submitButton = $(this);
                e.preventDefault();
                var drpText = $(document).find("select#SpecialBankAccountRelated_ProjectRegistration_ID").val();
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    //$("#idMainForm").hide();
                    drpText = "";
                    return false;
                }
                else {
                    //debugger;
                     
                    //"photo address" have value on submit button
                    //and "user_photo" have value on update button
                    //so check length of control on save (files.length) and update (path.length)

                    var files = $("#Photo_Address").get(0).files;
                    var path = $('#user_Photo').attr('src').replace('/', '');

                    
                    if (files.length > 0 || path.length > 0) {
                        $(submitButton).parents('form').submit();
                        // $("#idMainForm").show();
                    }
                    else
                    {
                        alert("Please Add Scan copy of Cancel Cheque file to Upload!")
                        return false;
                    }
                   
                                        
                }
            });
        });
    </script>

