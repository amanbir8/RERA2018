    <script type="text/javascript">
    
        function CountFloorPlots() {

            if ($("#Proposed_FloorPlotsNumber").val() != "" && $("#CurrentlySanctioned_FloorPlotsNumber").val() != "" && $("#Constructed_FloorsNumber").val() != "") {

                var ProposedFloorPlotsNumber = parseInt($("#Proposed_FloorPlotsNumber").val());
                var CurrentlySanctionedFloorPlotsNumber = parseInt($("#CurrentlySanctioned_FloorPlotsNumber").val());
                var ConstructedFloorsNumber = parseInt($("#Constructed_FloorsNumber").val());

                if (CurrentlySanctionedFloorPlotsNumber > ProposedFloorPlotsNumber) {
                    alert("Floors Sanctioned can't be more than Floors Proposed");
                    parseInt($("#CurrentlySanctioned_FloorPlotsNumber").val("0"));
                }
                else if (ConstructedFloorsNumber > CurrentlySanctionedFloorPlotsNumber) {
                    alert("Floors Constructed can't be more than Floors Sanctioned");
                    parseInt($("#Constructed_FloorsNumber").val("0"));
                }

                else {

                    return true;
                }
            }
            else {
                //alert("Please select dates");
                return false;
            }
        }
        
          
    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                $('#user_Photo').attr('src', e.target.result);
            }
            filerdr.readAsDataURL(input.files[0]);
            //$(':input[type="submit"]').prop('disabled', false);
            //$('#Create').prop('disabled', false);
        }
    }

    </script>
    <script type="text/javascript">
        $(document).ready(function () {

            var drpYearText = $(document).find("select#drpQYear").val();
            var drpQuarterText = $(document).find("select#drpQName").val();            

            $("#hdnQYear").val(drpYearText);
            $("#hdnQName").val(drpQuarterText);       

            //$('#drpQYear').attr('disabled', true);
            //$('#drpQName').attr('disabled', true);

            $('#BuildingTowerBlock_Name').attr('disabled', true);
            

            //$('#A_column').attr('readonly', false);
            //$('#B_column').attr('readonly', true);


            $(document).on('click', '#BtnDrp', function (e) {
                e.preventDefault();
                var proceedButton = $(this);
                var drpText = $(document).find("select#ProjectConstructionRelated_ProjectRegistration_ID").val();
                //alert(drpText)
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    // $("#idMainForm").hide();
                }
                else {
                    $("#idMainForm").show();
                    $(proceedButton).parents('form').submit();
                }
            });

            $(document).on('click', '#BtnMainform', function (e) {
                var submitButton = $(this);
                e.preventDefault();
                var drpText = $(document).find("select#ProjectConstructionRelated_ProjectRegistration_ID").val();
                if ($.trim(drpText) == "") {
                    alert("Please select the Project")
                    //$("#idMainForm").hide();
                    drpText = "";
                    return false;
                }
                else {
                    $(submitButton).parents('form').submit();
                    // $("#idMainForm").show();
                }


            });

            $('[data-toggle="tooltip"]').tooltip();

            $('table#promoter-documents-list-table').dataTable({
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [4]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
            });

        });
    </script>
