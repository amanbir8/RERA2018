    function CalculateCommonArea() {

        if ($("#ProposedLand_TobeDeveloped_Area_Total").val() != "" && $("#ProposedLand_Area_ResidentialGroupHousing").val() != "" && $("#ProposedLand_Area_ResidentialPlotted").val() != "" && $("#ProposedLand_Area_Commercial").val() != "" && $("#ProposedLand_Area_Industrial").val() != "" && $("#ProposedLand_Area_B_column").val() != "" && $("#ProposedLand_Area_C_column").val() != "") {

            if ((parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_ResidentialGroupHousing").val())) || (parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_ResidentialPlotted").val())) || (parseFloat(($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_Commercial").val()))) || (parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_Industrial").val())) || (parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_B_column").val())) || (parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val())) < (parseFloat($("#ProposedLand_Area_C_column").val()))) {
                
                alert("Value Cannot be more than Total Area of Land Proposed to be developed");
                // parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val(0));

                parseFloat($("#ProposedLand_Area_ResidentialGroupHousing").val(0));
                parseFloat($("#ProposedLand_Area_ResidentialPlotted").val(0));
                parseFloat($("#ProposedLand_Area_Commercial").val(0));
                parseFloat($("#ProposedLand_Area_Industrial").val(0));
                parseFloat($("#ProposedLand_Area_A_column").val(0));
                parseFloat($("#ProposedLand_Area_B_column").val(0));
                parseFloat($("#ProposedLand_Area_C_column").val(0));
                return false;
            }
            else {
                // alert("This Cannot be more than Total Area of Land Proposed to be developed");
                var Developed_Area_Total = parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val());
                var ResidentialGroupHousing = parseFloat($("#ProposedLand_Area_ResidentialGroupHousing").val());
                var ResidentialPlotted = parseFloat($("#ProposedLand_Area_ResidentialPlotted").val());
                var Area_Commercial = parseFloat($("#ProposedLand_Area_Commercial").val());
                var Area_Industrial = parseFloat($("#ProposedLand_Area_Industrial").val());
                var Area_ReservedInstitution = parseFloat($("#ProposedLand_Area_B_column").val());
                var Area_EWS = parseFloat($("#ProposedLand_Area_C_column").val());
                var CArea = parseFloat(Developed_Area_Total - (ResidentialGroupHousing + ResidentialPlotted + Area_Commercial + Area_Industrial + Area_ReservedInstitution + Area_EWS));

                if (CArea > 0)
                    $("#ProposedLand_Area_A_column").val(CArea.toFixed(4));
                else
                    $("#ProposedLand_Area_A_column").val(0);
            }
        }
        else {
            //alert("Please select dates");
            return false;
        }

        if ($("#ProposedLand_TobeDeveloped_Area_Total").val() != "" && $("#ProposedLand_TobeDeveloped_TotalOpenArea").val() != "") {
            var Developed_Area_Total = parseFloat($("#ProposedLand_TobeDeveloped_Area_Total").val());

            //Total Open Area under Land Proposed to be Developed
            var Total_Open_Area = parseFloat($("#ProposedLand_TobeDeveloped_TotalOpenArea").val());

            //Total Covered Area under Land Proposed to be Developed
            var Total_Covered_Area = parseFloat($("#ProposedLand_TobeDeveloped_TotalCoveredArea").val());
            if (Total_Open_Area > Developed_Area_Total) {

                alert("Value Cannot be more than the Area of Land Not Owned by Promoter (in sqr mtrs)");
                parseFloat($("#ProposedLand_TobeDeveloped_TotalOpenArea").val(0));
            }
            else {
                $("#ProposedLand_TobeDeveloped_TotalCoveredArea").val((Developed_Area_Total - Total_Open_Area).toFixed(4));
                return true;
            }
        }
        else {
            //alert("Please select dates");
            return false;
        }
    }

</script>

