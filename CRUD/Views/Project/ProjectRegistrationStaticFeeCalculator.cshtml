                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="control-label mand">(ii.) Area under group housing development excluding common areas and ameneties (in sqr mtrs)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.EditorFor(model => model.calcProposedLand_Area_ResidentialGroupHousing, new { htmlAttributes = new { @class = "form-control txtdisabled bgdisabled-color", @readonly = "readonly" } })
                                                        @Html.ValidationMessageFor(model => model.calcProposedLand_Area_ResidentialGroupHousing, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="control-label mand">(iii.) Area under commercial development excluding common areas and ameneties (in sqr mtrs)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.EditorFor(model => model.calcProposedLand_Area_Commercial, new { htmlAttributes = new { @class = "form-control txtdisabled bgdisabled-color", @readonly = "readonly" } })
                                                        @Html.ValidationMessageFor(model => model.calcProposedLand_Area_Commercial, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="control-label mand">(iv.) Area under industrial development excluding common areas and ameneties (in sqr mtrs)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.EditorFor(model => model.calcProposedLand_Area_Industrial, new { htmlAttributes = new { @class = "form-control txtdisabled bgdisabled-color", @readonly = "readonly" } })
                                                        @Html.ValidationMessageFor(model => model.calcProposedLand_Area_Industrial, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-6">
