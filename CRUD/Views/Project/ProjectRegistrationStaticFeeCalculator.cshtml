                                    <div class="col-lg-12">
                                        <div class="form-group">

                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label">(A.)</label>
                                                    </div>
                                                    <div class="col-md-6">
