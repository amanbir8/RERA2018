                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label">(C.)</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="control-label mand">Total Area of Land Proposed to be developed (in sqr mtrs)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        @Html.EditorFor(model => model.calcProposedLand_TobeDeveloped_Area_Total, new { htmlAttributes = new { @class = "form-control txtdisabled bgdisabled-color", @readonly = "readonly" } })
                                                        @Html.ValidationMessageFor(model => model.calcProposedLand_TobeDeveloped_Area_Total, "", new { @class = "text-danger" })
                                                    </div>                                                    
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group"> 
