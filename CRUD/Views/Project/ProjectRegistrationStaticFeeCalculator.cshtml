@model CRUD.Models.PromoterProject.ClsPrp_Project_PaymentFeeCalculator

@{
    Layout = null;
}

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<link rel="stylesheet" href="@Url.Content("~/css-validator/style.css")" />

<script>
    jQuery.validator.addMethod("alphanumericcc", function (value, element) {
        return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
    }, "Special characters are not allowed.");

    $("#myform_FeeCalculator").validate({
        rules: {
            calcProjectPayment_TitleCode: {
                required: true
            },
            calcFeeCalculator_ZoneType: {
                required: true
            },
            calcProposedLand_TobeDeveloped_Area_Total: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_ResidentialGroupHousing: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_ResidentialPlotted: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_Commercial: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_Industrial: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_CommonAmenties: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_OtherCommonAmenties: {
                number: true,
                maxlength: 18,
                minlength: 3
            },
            calcProposedLand_Area_EWSdevelopment: {
                number: true,
                maxlength: 18,
                minlength: 3
            }
        }
    });
</script>
<script>
    $(document).ready(function () {

        var baseUrl = $('body').attr('data-base-url');
        
        function saveOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "Project/SearchApplicationFeeCalculatorDetail",
                data: data,
                success: function (d) {
                    if (d.status == true) {
                        //console.log(d);
                        //alert(d.statusPaymentFee);

                        var numPaymentFee = d.statusPaymentFee;
                        var numConvenienceFee = d.statusConvenienceFee;
                        var numOtherFee = d.statusOtherFee;
                        var numFeeAmount = d.statusFeeAmount;

                        $('#setRegistration_Fee').val(numPaymentFee.toFixed(2));
                        $('#setOther_Fee').val(numConvenienceFee.toFixed(2));
                        $('#setBank_Charges').val(numOtherFee.toFixed(2));
                        $('#setDD_BankersCheque_Amount').val(numFeeAmount.toFixed(2));
                    }
                    else {
                        alert('Fee Calculator Failed! Something went wrong');
                    }
                },
                error: function () {
                    alert("oops! Something went wrong")
                }
            });
        }

        $("#saveOrder").click(function (e) {
            e.preventDefault();           

            var orderArr = [];
            orderArr.length = 0;            
            var isAllValid = false;

            if ($('#calcProposedLand_TobeDeveloped_Area_Total').val() != '' && $('#calcProposedLand_Area_ResidentialGroupHousing').val() != '' && $('#calcProposedLand_Area_ResidentialPlotted').val() != '' && $('#calcProposedLand_Area_Commercial').val() != '' && $('#calcProposedLand_Area_Industrial').val() != '' && $('#calcProposedLand_Area_CommonAmenties').val() != '' && $('#calcProposedLand_Area_OtherCommonAmenties').val() != '' && $('#calcProposedLand_Area_EWSdevelopment').val() != '') {

                var xpProposedLand_TobeDeveloped_Area_Total = $("#calcProposedLand_TobeDeveloped_Area_Total").val(),
                    xpProposedLand_Area_ResidentialGroupHousing = $("#calcProposedLand_Area_ResidentialGroupHousing").val(),

                    xpProposedLand_Area_ResidentialPlotted = $("#calcProposedLand_Area_ResidentialPlotted").val(),
                    xpProposedLand_Area_Commercial = $("#calcProposedLand_Area_Commercial").val(),
                    xpProposedLand_Area_Industrial = $("#calcProposedLand_Area_Industrial").val(),
                    xpProposedLand_Area_CommonAmenties = $("#calcProposedLand_Area_CommonAmenties").val(),
                    xpProposedLand_Area_OtherCommonAmenties = $("#calcProposedLand_Area_OtherCommonAmenties").val(),
                    xpProposedLand_Area_EWSdevelopment = $("#calcProposedLand_Area_EWSdevelopment").val();

                var sumTOTAL = parseInt(xpProposedLand_Area_ResidentialGroupHousing) + parseInt(xpProposedLand_Area_ResidentialPlotted) + parseInt(xpProposedLand_Area_Commercial) + parseInt(xpProposedLand_Area_Industrial) + parseInt(xpProposedLand_Area_CommonAmenties) + parseInt(xpProposedLand_Area_OtherCommonAmenties) + parseInt(xpProposedLand_Area_EWSdevelopment);
                if (sumTOTAL <= xpProposedLand_TobeDeveloped_Area_Total)
                {
                    isAllValid = true;
                }
                else
                {
                    alert('Invalid! Total Area under Proposed Land To be Developed (*) fields are invalid.');
                    isAllValid = false;
                }                
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {

                $("#rowCalA").attr("style", "display:block");
                $("#rowCalB").attr("style", "display:block");
                $("#rowCalC").attr("style", "display:block");
                $("#rowCalD").attr("style", "display:block");
                $("#rowCalE").attr("style", "display:none");

                var pFeeCalculator_ZoneType = $("#calcFeeCalculator_ZoneType").val(),
                    pProjectPayment_TitleCode = $("#calcProjectPayment_TitleCode").val(),
                    pProposedLand_TobeDeveloped_Area_Total = $("#calcProposedLand_TobeDeveloped_Area_Total").val(),
                    pProposedLand_Area_ResidentialGroupHousing = $("#calcProposedLand_Area_ResidentialGroupHousing").val(),

                    pProposedLand_Area_ResidentialPlotted = $("#calcProposedLand_Area_ResidentialPlotted").val(),
                    pProposedLand_Area_Commercial = $("#calcProposedLand_Area_Commercial").val(),
                    pProposedLand_Area_Industrial = $("#calcProposedLand_Area_Industrial").val(),
                    pProposedLand_Area_CommonAmenties = $("#calcProposedLand_Area_CommonAmenties").val(),
                    pProposedLand_Area_OtherCommonAmenties = $("#calcProposedLand_Area_OtherCommonAmenties").val(),
                    pProposedLand_Area_EWSdevelopment = $("#calcProposedLand_Area_EWSdevelopment").val();


                orderArr.push({
                    calcFeeCalculator_ZoneType: pFeeCalculator_ZoneType,
                    calcProjectPayment_TitleCode: pProjectPayment_TitleCode,
                    calcProposedLand_TobeDeveloped_Area_Total: pProposedLand_TobeDeveloped_Area_Total,
                    calcProposedLand_Area_ResidentialGroupHousing: pProposedLand_Area_ResidentialGroupHousing,

                    calcProposedLand_Area_ResidentialPlotted: pProposedLand_Area_ResidentialPlotted,
                    calcProposedLand_Area_Commercial: pProposedLand_Area_Commercial,
                    calcProposedLand_Area_Industrial: pProposedLand_Area_Industrial,
                    calcProposedLand_Area_CommonAmenties: pProposedLand_Area_CommonAmenties,
                    calcProposedLand_Area_OtherCommonAmenties: pProposedLand_Area_OtherCommonAmenties,
                    calcProposedLand_Area_EWSdevelopment: pProposedLand_Area_EWSdevelopment
                });

                var data = JSON.stringify({
                    order: orderArr
                });

                $.when(saveOrder(data)).then(function (response) {
                    console.log(response);
                }).fail(function (err) {
                    console.log(err);
                });

            }

        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).fadeOut(1000, function () {
                $(projectDetailsModal).modal('hide');
            });
        });

        $(document).on('click', 'a#notifyOpenerFeeCalculatorZoneInfo', function (e) {
            e.preventDefault();

            new PNotify({
                title: 'Information',
                text: '(Zone 1) - Master Plan Area of S.A.S. Nagar, New Chandigarh and Zirakpur. \<br>(Zone 2) - Master Plan Area of Kharar, Dera Bassi and Banur. \<br>(Zone 3) - Ludhiana (within and outside municipal limits upto 10 Kms.) \<br>(Zone 4) - Jalandhar (within and outside municipal limits upto 10 Kms.) \<br>(Zone 5) - Amritsar, Patiala, Khanna, Rajpura, Mandi Gobindgarh, Sirhind and Phagwara within and outside municipal limits upto 7 Kms and NH-1 upto 2 Kms on both sides, outside the potential zone. \<br>(Zone 6) – Bathinda, Moga, Batala, Pathankot, Barnala, Malerkotla, Morinda, Hoshiarpur, within and outside municipal limits upto 5 Kms. \<br>(Zone 7) – Sangrur, Sunam Udham Singh Wala, Nabha, Faridkot, Kotkapura, Ferozepur, Malout, Abohar, Sri Muktsar Sahib, Kapurthala, Nawanshahr, Rupnagar, Taran Taran, Gurdaspur, Samana, Jagraon, Mansa, Lalru, Kurali within and outside municipal limits upto 3 Kms and all other NH (except NH 1)/SH/Scheduled Roads upto 1 Kms both sides, outside the potential zone. \<br>(Zone 8) – Rest of Punjab.',
                type: 'info',
                hide: false
            });

        });
    });
</script>
<style>
    *.txtdisabled:hover {
        cursor: not-allowed;
    }
    *.bgdisabled-color {
        background-color: #F0F0F0;
    }
    *.bgdisplay-color {
        background-color: #8fcedd;
    }
    .disclaimer-text {
        text-align: justify;
        text-justify: inter-word;
    }   
</style>

<div id="wrapper">
