                                                            new SelectListItem {  Text = "Select" , Value="0"  },
                                                            new SelectListItem {Text = "Zone 1"  , Value="1"},
                                                            new SelectListItem {Text = "Zone 2" , Value="2"},
                                                            new SelectListItem {Text = "Zone 3" , Value="3"},
                                                            new SelectListItem {Text = "Zone 4" , Value="4"},
                                                            new SelectListItem {Text = "Zone 5" , Value="5"},
                                                            new SelectListItem {Text = "Zone 6" , Value="6"},
                                                            new SelectListItem {Text = "Zone 7" , Value="7"},
                                                            new SelectListItem {Text = "Zone 8" , Value="8"},
                                                        };
                                                    }
                                                    <div class="col-md-1">
                                                        <label class="control-label">(B.)</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.LabelFor(model => model.calcFeeCalculator_ZoneType, htmlAttributes: new { @class = "control-label mand" })
