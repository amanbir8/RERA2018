<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerFeeCalculatorButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            var projectId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            var promoterId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            var projectzoneId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            projectId = parseInt(projectId);
            promoterId = parseInt(promoterId);
            projectzoneId = parseInt(projectzoneId);
            $.ajax({
                url: BASE_URL + 'Project/ProjectRegistrationStaticFeeCalculator',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'promoterId': promoterId, 'projectzoneId': projectzoneId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            var projectName = $.trim($(document).find('#ProjectPaymentRelated_ProjectRegistration_ID :selected').text());
            $(projectDetailsModal).find('h4.modal-title a').html(' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a#notifyOpenerFeeCalculatorButton', function (e) {
            e.preventDefault();

            new PNotify({
                title: 'Disclaimer',
                text: 'Punjab RERA  has provided this calculator for your convenience only. The calculation of the registration fee provided herein is based on the information supplied by you. Punjab RERA reserves the right to demand a different fee, should the information provided prove to be incorrect or the amount calculated differ from the fees calculated in accordance with the Schedule - 1 of the Punjab State Real Estate (Regulation and Development) Rules, 2017 & Punjab State Real Estate (Regulation and Development) ( First Amendment) Rules, 2020 & Amendments in Punjab RERA (Regulation and Development), Rules 2017 dated 29.06.2022 and circular no. RERA/ENF/09 dated 09/05/2018 available under the Circulars/Public Notices link on the Authority website.',
                type: 'info',
                hide: false
            });

        });
    });
</script>
<script type="text/javascript">
    $(function () {

        if ($('#Payment_Mode').val() != 'Online Payment') {
            $("#onlinepaymentrow1").css("display", "block");
            $("#onlinepaymentrow2").css("display", "block");
            $("#onlinepaymentrow3").css("display", "block");
            $("#onlinepaymentrow4").css("display", "block");            
            $("label[for='DD_BankersCheque_Amount']").text("DD/Bankers Cheque Amount (in rupees)");
        }
        else {
            $("#onlinepaymentrow1").css("display", "none");
            $("#onlinepaymentrow2").css("display", "none");
            $("#onlinepaymentrow3").css("display", "none");
            $("#onlinepaymentrow4").css("display", "none");            
            $("label[for='DD_BankersCheque_Amount']").text("Total Amount (in rupees)");
        }


        $('#Payment_Mode').on('change', function () {
            var paymentmode = $('#Payment_Mode').val();
            if (paymentmode != 'Online Payment') {
                $("#onlinepaymentrow1").css("display", "block");
                $("#onlinepaymentrow2").css("display", "block");
                $("#onlinepaymentrow3").css("display", "block");
                $("#onlinepaymentrow4").css("display", "block");                
                $("label[for='DD_BankersCheque_Amount']").text("DD/Bankers Cheque Amount (in rupees)");
            }
            else {
                $("#onlinepaymentrow1").css("display", "none");
                $("#onlinepaymentrow2").css("display", "none");
                $("#onlinepaymentrow3").css("display", "none");
                $("#onlinepaymentrow4").css("display", "none");                
                $("label[for='DD_BankersCheque_Amount']").text("Total Amount (in rupees)");
            }
        });
    });
</script>

