<script type="text/javascript">
    $(document).ready(function () {

        $(document).on('click', '#BtnDrp', function (e) {
            e.preventDefault();
            var proceedButton = $(this);
            var drpText = $(document).find("select#ProjectPaymentRelated_ProjectRegistration_ID").val();
            //alert(drpText)
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                // $("#idMainForm").hide();
            }
            else {
                $("#idMainForm").show();
                $(proceedButton).parents('form').submit();
            }
        });

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            var drpText = $(document).find("select#ProjectPaymentRelated_ProjectRegistration_ID").val();
            if ($.trim(drpText) == "") {
                alert("Please select the Project")
                //$("#idMainForm").hide();
                drpText = "";
                return false;
            }
            else {


                //"photo address" have value on submit button
                //and "user_photo" have value on update button
                //so check length of control on save (files.length) and update (path.length)

                var files = $("#Photo_Address").get(0).files;
                var path = $('#user_Photo').attr('src').replace('/', '');


                if (files.length > 0 || path.length > 0) {
                    $(submitButton).parents('form').submit();
                    // $("#idMainForm").show();
                }
                else {
                    if ($('#Payment_Mode').val() == 'Online Payment') {
                        $(submitButton).parents('form').submit();
                    }
                    else {
                        alert("Please Add Scan copy of DD/Banker Cheque file to Upload!")
                        return false;
                    }
                }

                //var files = ($("#Photo_Address"))[0].files[0];
                //if (files) {
                //    $(submitButton).parents('form').submit();
                //    // $("#idMainForm").show();
                //}
                //else {
                //    //$(this).preventDefault();
                //    alert("Please Add Scan copy of DD/Banker Cheque file to Upload!")
                //    return false;
                //}
            }
        });


        new PNotify({
            title: 'Notification',
            text: 'In addition to the project registration fee, the composite web-portal fee (Reference to circular notice RERA-PB-FIN-2020-1641-1666 dated 02-Mar-2020) needs to be submitted.',
            hide: false
        });

        new PNotify({
            title: 'Notification',
            text: 'All payments need to be Online Payment OR in the form of a Demand Draft in favor of Real Estate Regulatory Authority, Punjab.',
            type: 'info',
            hide: false
        });



    });
</script>
<script type="text/javascript">
    $(
        function () {
            $('#ProjectPayment_TitleCode').change(function () {

                var PaymentId = $('#ProjectPayment_TitleCode').val();                
                var PaymentAmount = $('#Registration_Fee').val();
                PaymentAmount = parseInt(PaymentAmount);
                PaymentId = parseInt(PaymentId);
                var baseUrl = $('body').attr('data-base-url');
                if (PaymentId == 1) {
                    if (PaymentAmount <= 0)
                    {
                        $.ajax({
                            type: "POST",
                            url: baseUrl + "Project/GetApplicationFeeCalculatorDetail",
                            datatype: "Json",
                            data: { projectpaymentId: PaymentId },
                            success: function (data) {
                                if (data.status == true) {

                                    var numPaymentFee = data.statusPaymentFee;
                                    var numConvenienceFee = data.statusConvenienceFee;
                                    var numOtherFee = data.statusOtherFee;
                                    var numFeeAmount = data.statusFeeAmount;

                                    $('#Registration_Fee').val(numPaymentFee.toFixed(2));
                                    $('#Other_Fee').val(numConvenienceFee.toFixed(2));
                                    $('#Bank_Charges').val(numOtherFee.toFixed(2));
                                    $('#DD_BankersCheque_Amount').val(numFeeAmount.toFixed(2));
                                }
                                else {
                                    alert('Fee Calculator Failed! Something went wrong');
                                }
                            },
                            error: function () {
                                alert("oops! Something went wrong")
                            }
                        });
                    }                    
                }
                else {
                    $('#Registration_Fee').val('0');
                    $('#Other_Fee').val('0');
                    $('#Bank_Charges').val('0');
                    $('#DD_BankersCheque_Amount').val('0');
                }
            });
        });
</script>
