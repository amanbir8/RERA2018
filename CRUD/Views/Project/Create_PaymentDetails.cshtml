                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">                                                
                                                @if (Model.IsDraft == 1 || Model.IsDraft == 5 || Model.IsDraft == 6)
                                                {
                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                }
                                                else
                                                {
                                                    if (Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 1 || Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 5 || Convert.ToInt32(TempData["ProjectIsdraftValue"]) == 6)
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" disabled="disabled" />
                                                    }
                                                    else
                                                    {
                                                        <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                    }
                                                    //  <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                }                                                
                                                &nbsp;
                                                @Html.ActionLink("Reset", "Create_PaymentDetails", "Project", null, new { @class = "btn btn-outline btn-primary" })
                                                &nbsp;
                                                <span style="color:tomato;">@TempData["OnlinePayMessageShow"]</span>
                                            </div>
                                        </div>
                                    </div>

                                   }

                                        @*<div>
                                            @Html.ActionLink("Back to List", "Create_PaymentDetails")
                                        </div>*@
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                        <thead>
                                            <tr>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.ProjectPayment_TitleName)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.Bank_Name)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.Registration_Fee)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.Other_Fee)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.DD_BankersCheque_Number)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.DD_BankersCheque_Amount)
                                                </th>
                                                <th>
                                                    @Html.DisplayNameFor(model => model.Date_of_Payment_RegistrationFee)
                                                </th>                                               

                                                <th>@Html.DisplayName("Edit| Delete")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.prpongoing)
                                            {
                                                <tr> 
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.ProjectPayment_TitleName)
                                                    </td>
                                                    <td>
                                                       @if (item.Payment_Mode != "Online Payment")
                                                       {
                                                            @Html.DisplayFor(modelItem => item.Bank_Name)
                                                       }
                                                       else
                                                       {
                                                            @Html.DisplayName("Online Payment")
                                                       }
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Registration_Fee)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Other_Fee)
                                                    </td>
                                                    <td>
                                                        @if (item.Payment_Mode != "Online Payment")
                                                        {
                                                            @Html.DisplayFor(modelItem => item.DD_BankersCheque_Number)
                                                        }
                                                        else
                                                        {
                                                            if (item.IsActive != 1)
                                                            {
                                                                @Html.DisplayName("Online Payment [PENDING]")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("Online Payment [COMPLETE]")
                                                            }
                                                        }                                                        
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.DD_BankersCheque_Amount)
                                                    </td>
                                                    <td>
                                                        @if (item.Payment_Mode != "Online Payment")
                                                        {
                                                            @Html.DisplayFor(modelItem => item.Date_of_Payment_RegistrationFee)
                                                        }
                                                        else
                                                        {
                                                            if (item.IsActive != 1)
                                                            {
                                                                @Html.DisplayName("Online Payment [PENDING]")
                                                            }
                                                            else
                                                            {
                                                                @Html.DisplayName("Online Payment [COMPLETE]")
                                                            }
                                                        }
                                                    </td>                                                    
                                                    <td>
                                                        @if (item.IsDraft == 1 || item.IsDraft == 5 || item.IsDraft == 6)
                                                        {
                                                            if (item.Payment_Mode != "Online Payment")
                                                            {
                                                                @Html.ActionLink("View", "Edit_PaymentDetails", new { ProjectRegistration_ID = item.ProjectPaymentRelated_ProjectRegistration_ID, ProjectPayment_IndexID = item.ProjectPayment_IndexID })
                                                            }
                                                            else
                                                            {
                                                                @Html.ActionLink("View", "Detail_RequestProjectPmApplicationPayment", "ProjectPmPayment", new { RelatedPaymentCode = item.ProjectPayment_ID, RelatedPaymentICode = item.ProjectPayment_IndexID }, null)
                                                            }                                                            
                                                        }
                                                        else
                                                        {
                                                            if (item.Payment_Mode != "Online Payment")
                                                            {
                                                                @Html.ActionLink("Edit", "Edit_PaymentDetails", new { ProjectRegistration_ID = item.ProjectPaymentRelated_ProjectRegistration_ID, ProjectPayment_IndexID = item.ProjectPayment_IndexID }) @("| ")
                                                                @Html.ActionLink("Delete", "Delete_PaymentDetails", new { ProjectPaymentRelated_ProjectRegistration_ID = item.ProjectPaymentRelated_ProjectRegistration_ID, ProjectPayment_IndexID = item.ProjectPayment_IndexID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                            }
                                                            else
                                                            {
                                                                if (item.IsActive != 1)
                                                                {
                                                                    @Html.ActionLink("Make Payment", "Detail_RequestProjectPmApplicationPayment", "ProjectPmPayment", new { RelatedPaymentCode = item.ProjectPayment_ID, RelatedPaymentICode = item.ProjectPayment_IndexID }, new { @class = "btn btn-danger" })                                                                    
                                                                }
                                                                else
                                                                {
                                                                    @Html.ActionLink("View", "Detail_RequestProjectPmApplicationPayment", "ProjectPmPayment", new { RelatedPaymentCode = item.ProjectPayment_ID, RelatedPaymentICode = item.ProjectPayment_IndexID }, new { @class = "btn btn-outline btn-primary" })
                                                                }
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                </div>


                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

