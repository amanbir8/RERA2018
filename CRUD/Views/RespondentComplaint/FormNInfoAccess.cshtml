@model CRUD.Models.RespondentComplaint.ClsPrp_RespondentComplaint_FormN_DiaryNumber

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>
    $(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $('table#enclosuresListTable').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            responsive: true
        });
    });
</script>

<div class="contianer-fluid" style="padding-right: 15px;    padding-left: 15px;    margin-right: auto;    margin-left: auto;">
    <div class="row">
        <div class="col-md-12">&nbsp;</div>
        <div class="col-md-2"></div>

        <div class="col-md-8 text-center main-login main-center" style="background-color: #fff; ">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive each-table-space">
                        <div class="col-md-12 view-detail-heading">
                            Application Form-N (Claim for compensation under section 31 read with section 71 of the Act)
                        </div>
                        <table class="table table-bordered table-properties" id="dataTable">
                            <tbody>
                                <tr>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.ComplaintRegDiaryNumber_Name, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.ComplaintRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                                    <td class="single-detail">
                                        <label class="control-label">Date of Filing</label>
                                    </td>
                                    <td>@Html.DisplayFor(model => model.CreatedOn, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.Complainant_Name, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.Complainant_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.Respondent_Name, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.Respondent_Name, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.PreHearingDate, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>
                                        @Html.DisplayFor(model => model.PreHearingDate, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.DisplayName(" (")
                                        @Html.DisplayFor(model => model.PreHearingTime, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.DisplayName(")")
                                    </td>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.HearingBench_Bcolumn, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.HearingBench_Bcolumn, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.HearingType_Acolumn, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.HearingType_Acolumn, new { htmlAttributes = new { @class = "form-control" } })</td>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.PreHearingFixedForName, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.PreHearingFixedForName, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td class="single-detail">
                                        @Html.LabelFor(model => model.EventAction_Aggregate, htmlAttributes: new { @class = "control-label" })
                                    </td>
                                    <td>@Html.DisplayFor(model => model.EventAction_Aggregate, new { htmlAttributes = new { @class = "form-control" } })</td>
                                    <td class="single-detail">
                                        View Form-'N'
                                    </td>
                                    <td>
                                        <a href="@Url.Action("FilePDF_ComplaintFormNcodeDetails", "RespondentComplaint")" target="_blank">
                                            <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                        </a> (File .PDF)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 view-detail-headingCol" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">List of Enclosures/ Document(s) in support of the Application Form-'N'</div>
            <div class="col-md-12">&nbsp;</div>
            <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordionExample">
                <div class="card-body">

                    <div class="table-responsive each-table-space">
                        <div id="" class="container-fluid dt-bootstrap4 no-footer">
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table  table-bordered table-properties" id="enclosuresListTable" style="width:100%;">
                                        <thead>
                                            <tr>
                                                <th>@Html.DisplayName("Sr No")</th>
                                                <th align="left">@Html.DisplayName("Document Title")</th>
                                                <th>@Html.DisplayName("Reference Number")</th>
                                                <th>@Html.DisplayName("Page Index")</th>
                                                <th>@Html.DisplayName("View")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int pagelastnumber = 0;
                                            }
                                            @foreach (var item in Model.prpFormN_Docs)
                                            {
                                                {
                                                    pagelastnumber = item.Doc_PageStartNumber + item.Doc_PageEndNumber - 1;
                                                }
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_SerialNumber)
                                                </td>
                                                <td align="left">
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_InfoName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.ComplaintDoc_ReferenceNumber)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Doc_PageStartNumber)
                                                    @Html.DisplayName(" (Pages ")
                                                    @Html.DisplayFor(modelItem => item.Doc_PageEndNumber)
                                                    @Html.DisplayName(" to ")
                                                    @Html.DisplayName(pagelastnumber.ToString())
                                                    @Html.DisplayName(" )")
                                                </td>
                                                <td>
                                                    <a href="~/@Html.DisplayFor(modelItem => item.ComplaintDoc_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>          
        </div>
        <div class="col-md-2"></div>
    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}