                    <!--   Registration-fee-info   -->
                    <div class="tab-pane fade" id="Registration-fee-info">
                        <div id="main-content">
                            @{
                                int snopayment = 0;
                            }
                            @if (Model.ProjectRegistrationFee != null)
                            {                                
                                foreach (var item in Model.ProjectRegistrationFee)
                                {
                                    {
                                        snopayment = snopayment + 1;
                                    }
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">@Html.DisplayName("(" + snopayment.ToString() + ")") @Html.DisplayFor(modelItem => item.ProjectPayment_TitleName, new { htmlAttributes = new { @class = "form-control" } })</legend>                                                    
