                                                            </div>
                                                            <div class="col-md-8">
                                                                @Html.DisplayFor(modelItem => item.DD_BankersCheque_Amount, new { htmlAttributes = new { @class = "form-control" } })
                                                                <label class="control-label">(INR)</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-4">
                                                                <label class="control-label">Date of Payment</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                @Html.DisplayFor(modelItem => item.Date_of_Payment_RegistrationFee, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>                                                    
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>                                                                      
                                }
                            }
                        </div>
                    </div>
                    <!--   Registration-info   -->
                    <div class="tab-pane fade" id="Registration-info">
                        <div id="main-content">
                            <div class="row" style="margin-top: 20px;">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-registrationactiondeatils">
                                            <thead>
                                                <tr>
                                                    <th>@Html.DisplayName("Sr No")</th>                                                    
                                                    <th width="25%">@Html.DisplayName("Action Title")</th>
                                                    <th>@Html.DisplayName("Action Date")</th>                                                    
                                                    <th>@Html.DisplayName("Diary Number/ RERA Number/ PUC Number")</th>
                                                    <th>@Html.DisplayName("Application Date/ Issue Date")</th>
                                                    <th>@Html.DisplayName("Registration Valid Upto")</th>
                                                    <th>@Html.DisplayName("Prepared By")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int sno = 0;
                                                }
                                                @foreach (var item in Model.ProjectRegistrationActionDetails)
                                                {
                                                    {
                                                        sno = sno + 1;
                                                    }
                                                    <tr class="odd gradeX">
                                                        <td>@Html.DisplayName(sno.ToString())</td>                                                        
                                                        <td width="25%" class="success">@Html.DisplayFor(modelItem => item.RegistrationActionTitle)</td>
                                                        <td class="success">@Html.DisplayFor(modelItem => item.RegistrationActionDate)</td>                                                        
                                                        <td>@Html.DisplayFor(modelItem => item.Project_DiaryNumber_RERANumber_PUCNumber)</td>
                                                        <td>@Html.DisplayFor(modelItem => item.Project_Diarydated_RERAdated_PUCdated)</td>
                                                        <td>
                                                            @if (item.Project_RegistrationValidUptoDate == Convert.ToDateTime("01-Jan-0001"))
                                                            {
                                                                @Html.DisplayName("--")
                                                            }                                                            
                                                            else
                                                            {
                                                                @Html.DisplayFor(modelItem => item.Project_RegistrationValidUptoDate)
                                                            }                                                        
                                                        </td>
                                                        <td>@Html.DisplayFor(modelItem => item.IdentifiedBy)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>