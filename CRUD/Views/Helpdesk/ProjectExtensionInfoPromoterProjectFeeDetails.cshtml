                                                            @Html.LabelFor(model => model.Project_DiaryNumber, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.Project_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Project_ApplicationDate, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.Project_ApplicationDate, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />                                                
