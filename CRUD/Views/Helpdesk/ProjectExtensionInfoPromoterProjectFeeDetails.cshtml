                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Form-E and Project Application Details</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ProjectExtension_DiaryNumber, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.ProjectExtension_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
