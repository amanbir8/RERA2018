                                                                    @Html.DisplayFor(modelItem => item.ProjectDelayReason_IfAny, new { htmlAttributes = new { @class = "form-control" } })
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("NA")
                                                                }

                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">
                                                    <legend class="my">Authorized Person for Communication with regards to Project</legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                <label class="control-label">Authorized Person Name</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(mmodelItem => item.AuthorizedPerson_FirstName, new { htmlAttributes = new { @class = "form-control" } }) 
                                                                @Html.DisplayName(" ")
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_MiddleName, new { htmlAttributes = new { @class = "form-control" } })
                                                                @Html.DisplayName(" ")
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_LastName, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>                                                            
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_AddressLine1, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressLine1, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>

                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_AddressLine2, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                <label class="control-label">District</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressDistrictCode, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="control-label">State</label>
                                                            </div>
                                                            <div class="col-md-3">
