                                                            @Html.LabelFor(model => model.PromoterName, htmlAttributes: new { @class = "control-label" })
                                                            @*@Html.Label("Other Reasons, If Any", htmlAttributes: new { @class = "control-label" })*@
                                                        </div>
                                                        <div class="col-md-9">
                                                            @Html.DisplayFor(model => model.PromoterName, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Project_ApprovalDate, htmlAttributes: new { @class = "control-label" })
                                                        </div>
