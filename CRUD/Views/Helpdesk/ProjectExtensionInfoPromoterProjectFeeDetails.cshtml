<script type="text/javascript">
    $(document).ready(function () {       

        $.extend($.fn.dataTable.defaults, {
            "bDestroy": true,
            "responsive": true,
            "pageLength": 25,
            "lengthMenu": [[25, 50, 75, 100], [25, 50, 75, 100]],
