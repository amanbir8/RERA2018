                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.Project_Status, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (item.Project_Status != "Complete")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.Project_Status, new { htmlAttributes = new { @class = "form-control" } })
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("New Project")
                                                                }
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.A_column, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (item.A_column.ToString() == "0" || item.A_column.ToString() == "" || item.A_column.ToString() == "0.00")
                                                                {
                                                                    @Html.DisplayName("NA")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.A_column, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.DisplayName(" (INR)")
                                                                }
                                                            </div>                                                            
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.ProjectStart_Date, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.ProjectStart_Date, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.ProjectCompletion_OriginalDate, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.ProjectCompletion_OriginalDate, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
