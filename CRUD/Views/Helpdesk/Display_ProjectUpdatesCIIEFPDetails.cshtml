<script>

    function rowContentwithformat(d, Index, Counter) {
        // `d` is the original data object for the row
        //console.log(d);
        //console.log(Index);
        if (Counter > 0) {
            var i;
            var fLen = parseInt(Counter);
            fLen = fLen + 1;
            var parmInvBtbName = [];
            var parmInvAspType = [];
            var parmInvAspAvailableforSaleNumber = [];
            var parmInvAspAlreadySoldNumber = [];
            var parmInvAspCarpetArea = [];
            var parmInvAspExclusiveOpenTerraceArea = [];
            var parmInvAspExclusiveBalconyVerandahArea = [];
            var parmTableRows = '';

            for (i = 1; i < fLen; i++) {
                parmInvBtbName[i] = $.trim($(d).find('#hdnVarBtbName' + Index + 'arr' + i).val());
                parmInvAspType[i] = $.trim($(d).find('#hdnVarAspType' + Index + 'arr' + i).val());
                parmInvAspAvailableforSaleNumber[i] = $.trim($(d).find('#hdnVarAspAvailableforSaleNumber' + Index + 'arr' + i).val());
                parmInvAspAlreadySoldNumber[i] = $.trim($(d).find('#hdnVarAspAlreadySoldNumber' + Index + 'arr' + i).val());
                parmInvAspCarpetArea[i] = $.trim($(d).find('#hdnVarAspCarpetArea' + Index + 'arr' + i).val());
                parmInvAspExclusiveOpenTerraceArea[i] = $.trim($(d).find('#hdnVarAspExclusiveOpenTerraceArea' + Index + 'arr' + i).val());
                parmInvAspExclusiveBalconyVerandahArea[i] = $.trim($(d).find('#hdnVarAspExclusiveBalconyVerandahArea' + Index + 'arr' + i).val());

                parmTableRows = parmTableRows +
                    '<tr>' +
                        '<td><b>(' + i + ')</b> Building/ Tower/ Block Name: </td>' +
                        '<td><b>' + parmInvBtbName[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(a.) Type of Apartment/Shop/Plot: </td>' +
                        '<td><b>' + parmInvAspType[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(b.) Total Number of Apartment/ Shop/ Plot: </td>' +
                        '<td><b>' + parmInvAspAvailableforSaleNumber[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(c.) Number of Apartment/Shop/Plot already sold: </td>' +
                        '<td><b>' + parmInvAspAlreadySoldNumber[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(d.) Carpet Area of Apartment/ Shop/ Plot: </td>' +
                        '<td><b>' + parmInvAspCarpetArea[i] + '</b> (in sqr mtrs)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(e.) Exclusive Open Terrace Area: </td>' +
                        '<td><b>' + parmInvAspExclusiveOpenTerraceArea[i] + '</b> (in sqr mtrs)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(f.) Area of the Exclusive Balcony or Verandah: </td>' +
                        '<td><b>' + parmInvAspExclusiveBalconyVerandahArea[i] + '</b> (in sqr mtrs)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td colspan="2"><br/></td>' +
                    '</tr>';
            }
        }

        return '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">' + parmTableRows + '</table>';
    }

    function rowInventoryContentwithformat(d, Index) {
        // `d` is the original data object for the row
        //console.log(d);
        //console.log(Index);

        var parmAShopPlotType = $.trim($(d).find('#hdnVarASPtype' + Index).val());
        var parmAShopPlotCarpetArea = $.trim($(d).find('#hdnVarASPcarpetArea' + Index).val());
        var parmAShopPlotExOpenTerraceArea = $.trim($(d).find('#hdnVarASPexclusiveOpenTerraceArea' + Index).val());
        var parmAShopPlotExBalconyVerandahArea = $.trim($(d).find('#hdnVarASPexclusiveBalconyVerandahArea' + Index).val());
        var parmTableRows = '<tr>' +
                                '<td>Carpet Area of Apartment/ Shop/ Plot:</td>' +
                                '<td><b>' + parmAShopPlotCarpetArea + '</b> (in sqr mtrs)</td>' +
                            '</tr>' +
                            '<tr>' +
                                '<td>Exclusive Open Terrace Area: </td>' +
                                '<td><b>' + parmAShopPlotExOpenTerraceArea + '</b> (in sqr mtrs)</td>' +
                            '</tr>' +
                            '<tr>' +
                                '<td>Area of the Exclusive Balcony or Verandah: </td>' +
                                '<td><b>' + parmAShopPlotExBalconyVerandahArea + '</b> (in sqr mtrs)</td>' +
                            '</tr>';

        return '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">' + parmTableRows + '</table>';
    }

    $(document).ready(function () {
        $('#dataTables-ProjectConstructions tbody').on('click', 'td.details-control', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var qdataArrayIndex = $.trim($(parentRow).find('td.hdn-array-number').attr('data-array-number'));
            var qdataSubArrayCounter = $.trim($(parentRow).find('td.hdn-array-counter').attr('data-array-counter'));
            var mtable = $('#dataTables-ProjectConstructions').DataTable();

            var tr = $(this).closest('tr');
            var row = mtable.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                row.child(rowContentwithformat(row.data(), qdataArrayIndex, qdataSubArrayCounter)).show();
                tr.addClass('shown');
            }
        });

        $('#dataTables-ProjectInventory tbody').on('click', 'td.details-control', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var qdataArrayIndex = $.trim($(parentRow).find('td.hdn-inv-array-number').attr('data-inv-array-number'));
            var mtable = $('#dataTables-ProjectInventory').DataTable();

            var tr = $(this).closest('tr');
            var row = mtable.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                row.child(rowInventoryContentwithformat(row.data(), qdataArrayIndex)).show();
                tr.addClass('shown');
            }
        });
    });
</script>
