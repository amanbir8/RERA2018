<script>
    $(document).ready(function () {

        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            projectId = parseInt(projectId);
            var criteriaCode = $(this).attr('data-criteria-code');
            criteriaCode = parseInt(criteriaCode);
            $.ajax({
                url: BASE_URLm + 'Helpdesk/ProjectInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    //alert(1);
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            //var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');

            switch (criteriaCode) {
                case '#accordionConstructions':
                    $("#btnAccordionConstructions").find("span").toggleClass("btn-outline");
                    $("#btnAccordionConstructions").find("i").toggleClass("fa-expand fa-compress");
                    break;
                case '#accordionInventory':
                    $("#btnAccordionInventory").find("span").toggleClass("btn-outline");
                    $("#btnAccordionInventory").find("i").toggleClass("fa-expand fa-compress");
                    break;                
                case '#accordionParking':
                    $("#btnAccordionParking").find("span").toggleClass("btn-outline");
                    $("#btnAccordionParking").find("i").toggleClass("fa-expand fa-compress");
                    break;
                case '#accordionExternalFacilities':
                    $("#btnAccordionExternalFacilities").find("span").toggleClass("btn-outline");
                    $("#btnAccordionExternalFacilities").find("i").toggleClass("fa-expand fa-compress");
                    break;
                case '#accordionInternalFacilities':
                    $("#btnAccordionInternalFacilities").find("span").toggleClass("btn-outline");
                    $("#btnAccordionInternalFacilities").find("i").toggleClass("fa-expand fa-compress");
                    break;
            }
        });
    });
</script>
