                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Photographs_Title)
                                                        </th>
                                                        @*<th>
                                @Html.DisplayNameFor(model => model.Photographs_ClickDate)
                            </th>*@
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("View")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                @{
                                                    int sno = 0;
                                                }
                                                @foreach (var item in Model.prpongoing)
                                                {
                                                    {
                                                        sno = sno + 1;
                                                    }
                                                        <tr class="odd gradeX">
                                                            <td>@Html.DisplayName(sno.ToString())</td>
                                                            @if (item.IsDraft == 1)
                                                            { //L
                                                                <td>
                                                                    <span class="disabledlockunlock" title="Locked">
                                                                        @*<i class="fa fa-unlock" aria-hidden="true"></i>*@
                                                                        @Html.DisplayFor(modelItem => item.TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Name)
                                                                    </span>
                                                                </td>                                                                
                                                            }
                                                            else if (item.IsDraft == 5)
                                                            { //UL
                                                                <td class="text-primary">
                                                                    <span title="Unlocked">
                                                                        <i class="fa fa-unlock" aria-hidden="true"></i>
                                                                        @Html.DisplayFor(modelItem => item.TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Name)
                                                                    </span>
                                                                </td>                                                                
                                                            }
                                                            else if (item.IsDraft == 6)
                                                            { //PL
                                                                <td>
                                                                    <span class="disabledlockunlock" title="Locked">
                                                                        <i class="fa fa-key" aria-hidden="true"></i>
                                                                        @Html.DisplayFor(modelItem => item.TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Name)
                                                                    </span>
                                                                </td>                                                                
                                                            }
                                                            else
                                                            {
                                                                <td class="text-primary">
                                                                    <span class="disabledlockunlock" title="Unlocked">
                                                                        <i class="fa fa-unlock" aria-hidden="true"></i>
                                                                        @Html.DisplayFor(modelItem => item.TypeRelated_BuildingTowerBlock_ComArea_AdvtProspectus_Name)
                                                                    </span>
                                                                </td>                                                                
                                                            }                                                            
                                                            <td>
                                                            @if (item.BuildingTowerBlock_PhotographType != String.Empty)
                                                            {
                                                                if (item.BuildingTowerBlock_InfoName != String.Empty)
                                                                {
                                                                        @Html.DisplayFor(modelItem => item.BuildingTowerBlock_InfoName)
                                                                        @Html.DisplayName(", ")
                                                                }
                                                                    @Html.DisplayName("Floor: ")
                                                                    @Html.DisplayFor(modelItem => item.BuildingTowerBlock_FloorsNumber)
                                                                    @Html.DisplayName(", ")
                                                                    @Html.DisplayFor(modelItem => item.BuildingTowerBlock_PhotographType)
                                                            }
                                                            else
                                                            {
                                                                    @Html.DisplayName("NA")
                                                            }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Photographs_Title)
                                                            </td>
                                                            @*<td>
                                    @Html.DisplayFor(modelItem => item.Photographs_ClickDate)
                                    @Html.Label("(", htmlAttributes: new { @class = "control-label" })
                                    @Html.DisplayFor(modelItem => item.B_column)
                                    @Html.Label(")", htmlAttributes: new { @class = "control-label" })
                                </td>*@
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                            </td>
                                                            <td align="center">
                                                                <a href="~/@Html.DisplayFor(modelItem => item.Photographs_FilePath)" target="_blank" title="View"><i class="fa fa-external-link-square"></i></a>
                                                            </td>
                                                        </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
