                                                                                                @Html.DisplayFor(model => item.OCDateProject, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.LabelFor(model => item.ACDProject, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.DisplayFor(model => item.ACDProject, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
