                                                            int snoTrackDetails = 0;
                                                        }
                                                        @if (Model.prpongoing != null)
                                                        {
                                                            if (Model.prpongoing.Count > 0)
                                                            {
                                                                foreach (var item in Model.prpongoing)
                                                                {
                                                                    {
                                                                        snoTrackDetails = snoTrackDetails + 1;
                                                                    }
