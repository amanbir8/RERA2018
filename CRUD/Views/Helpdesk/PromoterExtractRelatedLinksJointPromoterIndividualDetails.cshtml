                                                                                                @Html.LabelFor(model => item.ProjectStartDate, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.DisplayFor(model => item.ProjectStartDate, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="row">
                                                                                        <div class="form-group">
