                                                                        <div class="col-lg-12">
                                                                            <div class="form-group">
                                                                                <fieldset class="col-md-12">
                                                                                    <legend class="my">@Html.DisplayName("(" + snoTrackDetails.ToString() + ")") Project Profile</legend>
                                                                                    <div class="row">
                                                                                        <div class="form-group">
                                                                                            <div class="col-md-3">
                                                                                                @Html.LabelFor(model => item.Projectname, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.DisplayFor(model => item.Projectname, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.LabelFor(model => item.ProjectStatus, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.DisplayFor(model => item.ProjectStatus, new { htmlAttributes = new { @class = "form-control" } })
