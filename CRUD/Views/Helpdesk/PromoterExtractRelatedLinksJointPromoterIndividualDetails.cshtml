                                                                                                @if (item.ProjectType == "1")
                                                                                                {
                                                                                                    @Html.DisplayName("Residential")
                                                                                                }
                                                                                                @if (item.ProjectType == "2")
                                                                                                {
                                                                                                    @Html.DisplayName("Commercial")
                                                                                                }
                                                                                                @if (item.ProjectType == "3")
                                                                                                {
                                                                                                    @Html.DisplayName("Industrial")
                                                                                                }
                                                                                                @if (item.ProjectType == "4")
                                                                                                {
                                                                                                    @Html.DisplayName("Mixed Development")
                                                                                                }
                                                                                                @*@Html.DisplayFor(model => item.ProjectType) *@
                                                                                            </div>
