                                                                                                @Html.LabelFor(model => item.RExtentofDelayProject, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @Html.DisplayFor(model => item.RExtentofDelayProject, new { htmlAttributes = new { @class = "form-control" } })
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
