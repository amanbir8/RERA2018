                                                                                                @Html.LabelFor(model => item.TypeLandofProject, htmlAttributes: new { @class = "control-label" })
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                @if (item.TypeLandofProject == "1")
                                                                                                {
                                                                                                    @Html.DisplayName("Leased")
                                                                                                }
                                                                                                @if (item.TypeLandofProject == "2")
                                                                                                {
                                                                                                    @Html.DisplayName("Joint Development")
                                                                                                }
                                                                                                @if (item.TypeLandofProject == "0")
                                                                                                {
                                                                                                    @Html.DisplayName("Promoter Owned")
                                                                                                }
                                                                                                @*@Html.DisplayFor(model => item.TypeLandofProject)*@
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
