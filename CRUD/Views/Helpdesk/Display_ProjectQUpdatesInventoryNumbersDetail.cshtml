<script>
    function rowContentwithformat(d, Index, Counter) {
        // `d` is the original data object for the row
        //console.log(d);
        //console.log(Index);
        if (Counter > 0) {
            var i;
            var fLen = parseInt(Counter);
            fLen = fLen + 1;
            var parmInvVarBTBName = [];
            var parmInvVarASPInventoryType = [];
            var parmInvVarASPQFC = [];
            var parmInvVarASPQFBC = [];
            var parmInvVarASPQB = [];
            var parmInvVarASPQCB = [];
            var parmInvVarASPQS = [];
            var parmInvVarASPCA = [];
            var parmInvVarASPEOTA = [];
            var parmInvVarASPEBVA = [];
            var parmInvVarASPFCtotal = [];
            var parmInvVarASPBtotal = [];
            var parmInvVarASPStotal = [];
            var parmTableRows = '';

            for (i = 1; i < fLen; i++) {
                parmInvVarBTBName[i] = $.trim($(d).find('#hdnVarBTBName' + Index + 'arr' + i).val());
                parmInvVarASPInventoryType[i] = $.trim($(d).find('#hdnVarASPInventoryType' + Index + 'arr' + i).val());
                parmInvVarASPQFC[i] = $.trim($(d).find('#hdnVarASPQFC' + Index + 'arr' + i).val());
                parmInvVarASPQFBC[i] = $.trim($(d).find('#hdnVarASPQFBC' + Index + 'arr' + i).val());
                parmInvVarASPQB[i] = $.trim($(d).find('#hdnVarASPQB' + Index + 'arr' + i).val());
                parmInvVarASPQCB[i] = $.trim($(d).find('#hdnVarASPQCB' + Index + 'arr' + i).val());
                parmInvVarASPQS[i] = $.trim($(d).find('#hdnVarASPQS' + Index + 'arr' + i).val());
                parmInvVarASPCA[i] = $.trim($(d).find('#hdnVarASPCA' + Index + 'arr' + i).val());
                parmInvVarASPEOTA[i] = $.trim($(d).find('#hdnVarASPEOTA' + Index + 'arr' + i).val());
                parmInvVarASPEBVA[i] = $.trim($(d).find('#hdnVarASPEBVA' + Index + 'arr' + i).val());
                parmInvVarASPFCtotal[i] = $.trim($(d).find('#hdnVarASPFCtotal' + Index + 'arr' + i).val());
                parmInvVarASPBtotal[i] = $.trim($(d).find('#hdnVarASPBtotal' + Index + 'arr' + i).val());
                parmInvVarASPStotal[i] = $.trim($(d).find('#hdnVarASPStotal' + Index + 'arr' + i).val());

                parmTableRows = parmTableRows +
                    '<tr>' +
                        '<td><b>(' + i + ')</b> Inventory Information of Building/ Tower/ Block <b>(in the Quarter)</b>: </td>' +
                        '<td><b>' + parmInvVarBTBName[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(a.) Type (Apartment/ Commercial/ Individual House/ Plots/ Others): </td>' +
                        '<td><b>' + parmInvVarASPInventoryType[i] + '</b></td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(b.) Carpet Area of Apartment/ Shop/ Plot (in sqr mtrs): </td>' +
                        '<td><b>' + parmInvVarASPCA[i] + '</b> sqr mtrs</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(c.) Exclusive Open Terrace Area (in sqr mtrs): </td>' +
                        '<td><b>' + parmInvVarASPEOTA[i] + '</b> sqr mtrs</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(d.) Area of the Exclusive Balcony or Verandah (in sqr mtrs): </td>' +
                        '<td><b>' + parmInvVarASPEBVA[i] + '</b> sqr mtrs</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(e.) Number of Floors Constructed/Plots/Others: </td>' +
                        '<td><b>' + parmInvVarASPQFC[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(f.) Number of Foundations/Basements Constructed: </td>' +
                        '<td><b>' + parmInvVarASPQFBC[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(g.) Number of Apartment/Shop/Plot booked: </td>' +
                        '<td><b>' + parmInvVarASPQB[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(h.) Number of Apartment/Shop/Plot canceled booking: </td>' +
                        '<td><b>' + parmInvVarASPQCB[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(i.) Number of Apartment/Shop/Plot sold: </td>' +
                        '<td><b>' + parmInvVarASPQS[i] + '</b> (in the Quarter)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(j.) Total Number of Floors Constructed/Plots/Others: </td>' +
                        '<td><b>' + parmInvVarASPFCtotal[i] + '</b> (Total)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(k.) Total Booked: </td>' +
                        '<td><b>' + parmInvVarASPBtotal[i] + '</b> (Total)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td>&nbsp;(l.) Total Sold: </td>' +
                        '<td><b>' + parmInvVarASPStotal[i] + '</b> (Total)</td>' +
                    '</tr>' +
                    '<tr>' +
                        '<td colspan="2"><br/></td>' +
                    '</tr>';
            }
        }

        return '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;">' + parmTableRows + '</table>';
    }

    $(document).ready(function () {
        $('#dataTables-QUpdatesProjectInventoryNumbers tbody').on('click', 'td.details-control', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var qdataArrayIndex = $.trim($(parentRow).find('td.hdn-inv-array-number').attr('data-inv-array-number'));
            var qdataSubArrayCounter = $.trim($(parentRow).find('td.hdn-array-counter').attr('data-array-counter'));
            var mtable = $('#dataTables-QUpdatesProjectInventoryNumbers').DataTable();

            var tr = $(this).closest('tr');
            var row = mtable.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                row.child(rowContentwithformat(row.data(), qdataArrayIndex, qdataSubArrayCounter)).show();
                tr.addClass('shown');
            }
        });
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();

        $('[data-spzoom]').spzoom();

        var popoverBaseUrl = $('body').attr('data-base-url');
        var showPopover = $.fn.popover.Constructor.prototype.show;
        $.fn.popover.Constructor.prototype.show = function () {
            showPopover.call(this);
            if (this.options.showCallback) {
                this.options.showCallback.call(this);
            }
        }

        $("[data-toggle=popover]").popover({
            trigger: 'click',
            placement: "right",
            title: '<i class="fa fa-cog"></i> Search Options <a href="javascript:void(0);" class="close" title="Close">&times;</a>',
            html: true,
            content: function () {                
                return $('#popover-content').html(); 
            },
            showCallback: function () {
                $("#InputEntry_FromDate").datepicker({
                    dateFormat: 'dd-M-yy',
                    changeMonth: true,
                    changeYear: true,

                    onSelect: function (selected) {
                        var dt = new Date(selected);
                        dt.setDate(dt.getDate() + 1);
                        $("#InputEntry_ToDate").datepicker("option", "minDate", dt);
                    }
                });
                $("#InputEntry_ToDate").datepicker({
                    dateFormat: 'dd-M-yy',
                    changeMonth: true,
                    changeYear: true,
                    onSelect: function (selected) {
                        var projStartDate = $("#InputEntry_FromDate").val();
                        if (projStartDate == '') {
                            alert('Please select From Date first!');
                            $("#InputEntry_ToDate").val('');
                            return false;
                        }
                        var dt = new Date(selected);
                        dt.setDate(dt.getDate());

                        var start = $("#InputEntry_FromDate").datepicker("getDate");
                        var end = $("#InputEntry_ToDate").datepicker("getDate");
                        var days = (end - start) / (1000 * 60 * 60 * 24);
                        if (days > 180) {
                            alert('Please select upto 180 days Only!');
                            $("#InputEntry_ToDate").val('');
                            return false;
                        }
                        $("#InputEntry_FromDate").datepicker("option", "maxDate", dt);
                    }
                });
            }
        }).on('click', function () {

            $(document).on('click', '#ViewDetailYY', function (e) {
                var submitButton = $(this);
                e.preventDefault();
                var inputvalRange = $(".radio-rangevaluedate:checked").val();
                var inputvalQuarter = $("#drpEventQuarter").val();
                var inputvalYear = $("#drpEventYear").val();

                //$(submitButton).parents('form').submit();
                $.post(popoverBaseUrl + '/Helpdesk/Display_ProjectQUpdatesInventoryNumbersDetail/', {
                    IsRangeValueDateInputFlag: inputvalRange,
                    EventQuarter: inputvalQuarter,
                    EventYear: inputvalYear
                }, function (r) {                    
                    $('#popoverResult').html('the unknown records found as resonse from server')
                });

                $('#QUPInventorySearchOptions').submit();
            });

            $(document).on('click', '#ViewDetailDD', function (e) {
                var submitButton = $(this);
                e.preventDefault();                
                var inputvalRange = $(".radio-rangevaluedate:checked").val();
                var inputvalFromDate = $("#InputEntry_FromDate").val();
                var inputvalToDate = $("#InputEntry_ToDate").val();
                
                $.post(popoverBaseUrl + '/Helpdesk/Display_ProjectQUpdatesInventoryNumbersDetail/', {
                    IsRangeValueDateInputFlag: inputvalRange,
                    InputEntry_FromDate: inputvalFromDate,
                    InputEntry_ToDate: inputvalToDate
                }, function (r) {                    
                    $('#popoverResult').attr("style", "display:block");                    
                    var i = 0;
                    if (i == 0) {
                        i = 1;
                        var width = 1;
                        var id = setInterval(frame, 1);
                        function frame() {
                            if (width >= 100) {
                                clearInterval(id);
                                i = 0;
                            } else {
                                width++;                                
                                $('.progress-bar').css('width', width + '%').attr('aria-valuenow', width);
                            }
                        }
                    };                                       
                });

                $('#QUPInventorySearchOptions').submit();
            });

        });
        $(document).on("click", ".popover .close", function () {            
            $('.popover').css('display', 'none');            
        });

    });
</script>
<script>
    $(document).ready(function () {

        var vcheckrangevaluedatemode = $("input[name='IsRangeValueDateInputFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").attr("style", "display:none");
            $("#rowDateFilterYY").attr("style", "display:block");
        }
        else if (vcheckrangevaluedatemode == '2') {
            $("#rowDateFilterDD").attr("style", "display:block");
            $("#rowDateFilterYY").attr("style", "display:none");
        }

        $(document).on('click', '.radio-rangevaluedate', function (e) {
            if (this.value == '1') {
                $("#rowDateFilterDD").attr("style", "display:none");
                $("#rowDateFilterYY").attr("style", "display:block");
            }
            else if (this.value == '2') {
                $("#rowDateFilterDD").attr("style", "display:block");
                $("#rowDateFilterYY").attr("style", "display:none");
            }
        });

    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
