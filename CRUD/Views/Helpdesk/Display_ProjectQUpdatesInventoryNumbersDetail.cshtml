<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('.btn-toggle').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);

            var parentRow = $(elem).parents('tr');

            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var projectqupapprovalindexId = $.trim($(parentRow).find('input.hdnProjectQUPApprovalIndexID').val());
            var projectqupapprovalId = $.trim($(parentRow).find('input.hdnProjectQUPApprovalID').val());
            var prmFlag = $.trim($(parentRow).find('input.hdnPublicViewFlag').val());

            var prmPublicUnpublic = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            projectId = parseInt(projectId);
            projectqupapprovalindexId = parseInt(projectqupapprovalindexId);
            projectqupapprovalId = parseInt(projectqupapprovalId);

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the public view (webpage) options?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'Helpdesk/PublicUnpublicHandler_ProjectQUpdatesStatusOfApprovalsByIndex',
                        data: { 'prmprojectId': projectId, 'prmprojectapprovalsindexId': projectqupapprovalindexId, 'prmprojectapprovalsId': projectqupapprovalId, 'prmPublicUnpublic': prmPublicUnpublic },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionPublicViewTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                            }                                
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            }
            if (varcnfrm != 1) {
                disablePublicViewTogglebtnYN(elemid);
            }
        });        
    });

    function setdefaultPublicViewTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varPublicViewFlag = 0;
        if (dataAction != 'NPV') {
            //YPV(1) NPV(0)
            varPublicViewFlag = 1;
        };
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        switch (varPublicViewFlag) {
            case 0:
                $(document).find(valpublicviewShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(valpublicviewShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionPublicViewTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varPublicViewFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varPublicViewFlag = 1;
        };
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        var len = valpublicviewShowId.toString().trim().length;
        var res = valpublicviewShowId.substring(20, len);
        var strpvstatus = '#publicviewtogglestatus';
        var valpublicviewstatusShowId = strpvstatus.concat(res);
        switch (varPublicViewFlag) {
            case 0:
                $(document).find(valpublicviewShowId.trim()).removeClass('active');
                $(document).find(valpublicviewstatusShowId.trim()).addClass('border-left-danger warning');
                break;
            case 1:
                $(document).find(valpublicviewShowId.trim()).addClass('active');
                $(document).find(valpublicviewstatusShowId.trim()).removeClass('border-left-danger warning');                
                break;
        }
    }
    function disablePublicViewTogglebtnYN(srID) {
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        $(document).find(valpublicviewShowId.trim()).prop('disabled', true);
        $(document).find(valpublicviewShowId.trim()).addClass("disabledlockunlock");
    }
</script>

