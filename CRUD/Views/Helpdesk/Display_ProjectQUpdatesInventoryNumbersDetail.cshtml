    function lockUnlockHandlerApprovalnoclist() {
        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftAllapprovals').val());
            var parmIndexID = 0;
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectApprovalsList',
                data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockapprovalnoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockapprovalnoclistDetails").attr("title", "Unlock Details");
                        $("#btnLockapprovalnoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockapprovalnoclistDetails").prop('disabled', true);
                        $("#btnLockapprovalnoclistDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockapprovalnoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockapprovalnoclistDetails").attr("title", "Lock Details");
                        $("#btnLockapprovalnoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockapprovalnoclistDetails").prop('disabled', true);
                        $("#btnLockapprovalnoclistDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
    function lockUnlockHandlerApprovalnoc() {
        var elem = $(this);
        var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
        var parmLockUnlock = $(this).attr('data-locknnlockdoc-code');
        var parmIndexID = $(this).attr('data-docindex-code');

        if (parmLockUnlock == 1 || parmLockUnlock == 5) {

            var btnLabel = $(this).attr("title");
            var cnfrmTxt = "Do you want to lock details?";
            if (btnLabel == "Unlock Details") {
                var cnfrmTxt = "Do you want to unlock details?";
            }

            if (confirm(cnfrmTxt)) {              
                var baseUrllockunlock = $('body').attr('data-base-url');

                $.ajax({
                    type: 'GET',
                    url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectApprovalsByIndex',
                    data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        alert(data.status);                        
                        if (data.statusCode == 101) {
                            elem.find("span").removeClass("btn-warning").addClass("btn-primary");
                            elem.attr("title", "Unlock Details");
                            elem.find("i").removeClass("fa-unlock").addClass("fa-key");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        } else if (data.statusCode == 105) {
                            elem.find("span").removeClass("btn-primary").addClass("btn-warning");
                            elem.attr("title", "Lock Details");
                            elem.find("i").removeClass("fa-key").addClass("fa-unlock");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        }
                    },
                    failure: function (data) {
                        alert('Bad Request! Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Error');
                    }
                });
            }
        }
        else {
            $(this).preventDefault();
        }
    }
</script>
