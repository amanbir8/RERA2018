@model CRUD.Models.HelpDesk.ClsPrp_ExtensionAuthorityDesk_ProjectSubCheckListLog

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">

            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                @if (Model.prpongoing != null)
                {
                    var varDate = System.DateTime.Now.Date;
                    <tr>
                        <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>
                        <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                    </tr>
                        <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Check List (Extension of Registration) Criteria Requirement Report (with Not Acceptable Status)")</b></td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr>
                            <td width="25%">@Html.DisplayName("Diary Number")</td>
                            <td width="35%">@Html.DisplayFor(model => model.zipExtensionFormProject_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>@Html.LabelFor(model => model.zipExtensionFormProjectName, htmlAttributes: new { @class = "control-label" })</td>
                            <td>@Html.DisplayFor(model => model.zipExtensionFormProjectName, new { htmlAttributes = new { @class = "form-control" } })</td>
                        </tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4"><h4>@Html.DisplayName("Check List (Extension of Registration) Criteria Requirement Details")</h4></td></tr>
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
            </table>

            @if (Model.prpongoing != null)
            {
                <table class="table table-striped table-bordered table-hover checklist-details-table" style="width:100%;">
                    <thead>
                        <tr style="border:solid;">
                            <th>@Html.DisplayName("SN")</th>
                            <th>@Html.DisplayName("Criteria Name and Requirements")</th>
                            <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                            @*<th>@Html.DisplayName("Acceptable? (Yes/No)")</th>*@
                            <th>@Html.DisplayName("Prepared Date")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sno = 0;
                        }
                        @foreach (var item in Model.prpongoing)
                        {
                            {
                                sno = sno + 1;
                            }
                            <tr class="odd gradeX">
                                <td width="4%" valign="top">@Html.DisplayName(sno.ToString())</td>
                                <td width="40%" valign="top">
                                    @Html.DisplayName("(")
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.HiddenFor(modelItem => item.C_column)
                                    @Html.DisplayName(") ")
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode)
                                </td>
                                <td valign="top">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                @*<td>
                                            @if (item.IsChecklistValueOk == "Y")
                                    {
                                                @Html.DisplayName("Yes")
                                    }
                                    else
                                    {
                                                @Html.DisplayName("No")
                                    }
                                        </td>*@
                                <td width="15%" valign="top">
                                    @*@Html.DisplayFor(modelItem => item.CheckList_IdentifiedBy)
                                        @Html.DisplayName(",")*@
                                    @Html.DisplayFor(modelItem => item.CheckList_IdentifiedOn)
                                </td>
                            </tr>
                            <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        }
                        <tr><td colspan="4" style="font-style: italic;"><hr /></td></tr>
                    </tbody>
                </table>
                            }
                            else
                            {
                                <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;">
                                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                                </table>
                            }
        </div>
    </div>
</div>
