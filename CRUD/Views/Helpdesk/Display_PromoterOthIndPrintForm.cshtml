                        $("#btnLockpromotermemberDetails").attr("title", "Lock Details");
                        $("#btnLockpromotermemberDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockpromotermemberDetails").prop('disabled', true);
                        $("#btnLockpromotermemberDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

