    function lockUnlockHandlerPromoterProfile() {
        
        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {
            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftpromoterprofile').val());
            var parmIndexID = 0;
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_PromoterOthenThanIndProfile',
                data: { 'parmProjectId': parmProjectId, 'parmPromoterId': parmPromoterId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockpromoterprofileDetails").attr("title", "Unlock Details");
                        $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockpromoterprofileDetails").prop('disabled', true);
                        $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockpromoterprofileDetails").attr("title", "Lock Details");
                        $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockpromoterprofileDetails").prop('disabled', true);
                        $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
