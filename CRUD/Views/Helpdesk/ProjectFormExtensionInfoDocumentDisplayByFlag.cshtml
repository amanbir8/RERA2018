<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-exampleDocument">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("Sr No")</th>
                        <th>@Html.DisplayNameFor(model => model.ProjectDoc_InfoCode)</th>
                        <th>@Html.DisplayNameFor(model => model.ProjectDoc_ReferenceNumber)</th>
                        @*<th>@Html.DisplayNameFor(model => model.ProjectDoc_IssueDate)</th>*@
                        <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                        <th>
                            @Html.DisplayName("View")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 0;
                    }
                    @foreach (var item in Model.prpongoing)
                    {
                        {
                            sno = sno + 1;
                        }
                        <tr class="odd gradeX">
                            <td>@Html.DisplayName(sno.ToString())</td>
                            <td>@Html.DisplayFor(modelItem => item.ProjectDoc_InfoName)</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProjectDoc_ReferenceNumber)
                                @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                @Html.HiddenFor(modelItem => item.Promoter_ID)
                            </td>
                            @*<td>@Html.DisplayFor(modelItem => item.ProjectDoc_IssueDate)</td>*@
                            <td>@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                            <td align="center">
                                <a href="~/@Html.DisplayFor(modelItem => item.ProjectDoc_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
