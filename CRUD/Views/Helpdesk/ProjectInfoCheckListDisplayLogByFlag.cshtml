@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_ProjectSubCheckListLog

@{
    Layout = null;
}

<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandLogDetailsByFlag', function (e) {
            e.preventDefault();
            //debugger;
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var parmProjectId = $.trim($(parentRow).find('input.hdnRelatedProjectID').val());
            var parmCriteriaID = $.trim($(parentRow).find('input.hdnVarCriteriaID').val());
            var parmCriteriaSubID = $.trim($(parentRow).find('input.hdnVarCriteriaSubID').val());
            //var projectId = $('#Related_Project_ID').val();
            parmProjectId = parseInt(parmProjectId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            //var varProjectName = $.trim($(document).find("div.project-name").text());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoCheckListDisplayLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                <thead>
