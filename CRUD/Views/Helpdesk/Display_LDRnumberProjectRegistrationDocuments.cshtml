@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_ProjectRERA_Certificate

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }

    .icon-cert-lock {        
        color: #428bca;
    }

    .icon-disabled {
        cursor: not-allowed;
    }

    .disabledlockunlock {
        cursor: not-allowed;
    }

    .border-left-danger {
        border-left: .15rem solid #FF4961 !important;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();
    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Projects (Project Completion Certificate) Application Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Registered Project (RERA Registration Certificates) Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Project - ( @Html.DisplayFor(model => model.zipProjectRegistrationNumberName, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zipProjectName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-4 project-name">
                                                        @Html.DisplayFor(model => model.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zipCompletion_DiaryNumber, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-4">
                                                        @Html.DisplayFor(model => model.zipCompletion_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.DisplayName(" of ")
                                                        @Html.DisplayFor(model => model.zipProject_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityCompletionProjectDeskNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;">
                                        <a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>
                                        Registered Project (RERA Registration Certificates) Details
                                    </h4>
                                </div>
                            </div>
                            @using (Html.BeginForm(new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                @Html.HiddenFor(model => model.ProjectRERAcertificate_IndexID)
                                @Html.HiddenFor(model => model.ProjectRERAcertificate_ID)
                                @Html.HiddenFor(model => model.Promoter_ID)
                                @Html.HiddenFor(model => model.Project_ID)
   
                            }
                            <div class="row">
                                <div class="form-group">                                        
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("SNo")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.ProjectRERAcert_InfoName)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.ProjectRERAcert_ReferenceNumber)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.ProjectRERAcert_IssueDate)
                                                        </th>                                                        
                                                        <th>
                                                            @Html.DisplayName("Annexure? (Yes/No)")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Public View? (Yes/No)")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Remarks_IfAny)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("View")
                                                        </th>                                                        
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int snoRLRC = 0;                                                        
                                                    }
                                                    @foreach (var item in Model.prpongoing)
                                                    {
                                                        {
                                                            snoRLRC = snoRLRC + 1;
                                                        }
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayName(snoRLRC.ToString())
                                                            </td>
                                                            <td>
                                                                @if (item.ProjectRERAcert_InfoName != "Others")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.ProjectRERAcert_InfoName)
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.ProjectRERAcert_InfoName)
                                                                    @Html.DisplayName(" (")
                                                                    @Html.DisplayFor(modelItem => item.A_column)
                                                                    @Html.DisplayName(")")
                                                                }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectRERAcert_ReferenceNumber)
                                                                @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                                @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterID" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRERAcertificate_IndexID, new { @class = "hdnRCprojectIndexID" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRERAcertificate_ID, new { @class = "hdnRCprojectID" })
                                                                @Html.HiddenFor(modelItem => item.IsPublicView, new { @class = "hdnPublicViewFlag" })
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectRERAcert_IssueDate)
                                                            </td>                                                            
                                                            <td class="text-center">
                                                                @if (item.IsWithdrawn == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.IsPublicView == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                            </td>
                                                            <td class="text-center">                                                                
                                                                <a href="~/@Html.DisplayFor(modelItem => item.ProjectRERAcert_FilePath)@Html.DisplayFor(modelItem => item.ProjectRERAcert_FileName)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                            </td>                                                            
                                                        </tr>
                                                    }
                                                </tbody>
                                                </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
<button onclick="topFunction()" id="customTopBtn" title="Go to top">Top</button>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>                
                <h4 class="modal-title" id="myModalLabel">Checklist Criteria Details</h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>

    <script>
        $(document).ready(function () {
            $('table#promoter-documents-list-table').dataTable({
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [7]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
            });
        });
    </script>
}

