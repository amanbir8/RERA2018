@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_ProjectRERAnumberDiaryNumberRefHist

<script>
    $(document).ready(function () {

        $('#dataTables-example').DataTable({
            responsive: true
        });

    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalPrevRegistrationsDetail', function (e) {
            e.preventDefault();
            var elem = $(this);            
            var rnaDetailsModal = $(document).find('#myModal');
            $(rnaDetailsModal).find('.modal-body').html('');
            //debugger;
            //var parentRow = $(this).closest("tr");
            var parentRow = $(elem).parents('tr');
            var ProjectId = $.trim($(parentRow).find('input.hdnProjectId').val());
            var PromoterId = $.trim($(parentRow).find('input.hdnPromoterId').val());
            var DiaryNumber = $.trim($(parentRow).find('input.hdnDiaryNumber').val());
            var ProjectName = $.trim($(parentRow).find('input.hdnProjectName').val());
            var DiaryNumberId = $.trim($(parentRow).find('input.hdnProjectRegDiaryNumber_ID').val());
            ProjectId = parseInt(ProjectId);
            PromoterId = parseInt(PromoterId);
            DiaryNumberId = parseInt(DiaryNumberId);
            
            var varcode = $.trim($(parentRow).find('td.renewalflag-code').attr('data-renewalflag-code'));
            var flagCode = parseInt(varcode);
            $.ajax({
                url: BASE_URLm + 'Helpdesk/ProjectInfo_PrevRegistrationsDetail',
                dataType: 'HTML',
                type: 'GET',
                data: { 'ProjectId': ProjectId, 'PromoterId': PromoterId, 'DiaryNumber': DiaryNumber, 'ProjectName': ProjectName, 'flagCode': flagCode, 'DiaryNumberId': DiaryNumberId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(rnaDetailsModal).find('.modal-body').html(response);
                }
            });

            var rndiaryNo = $.trim($(parentRow).find('td.renewal-diarynumber').attr('data-renewal-diarynumber'));
            var rnreraNo = $.trim($(parentRow).find('td.renewal-reranumber').attr('data-renewal-reranumber'));
            $(rnaDetailsModal).find('h4.modal-title').html('Registration History - <a href="javascript:void(0);"></a>');
            $(rnaDetailsModal).find('.modal-title a').html(rnreraNo + ' (' + rndiaryNo + ')');
            $(rnaDetailsModal).modal('show');
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Project Registration : Real Estate Project Application Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Registration History Details with RERA Punjab
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Project /Application - ( @Html.DisplayFor(model => model.zipProject_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zipProjectName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5 project-name">
                                                        @Html.DisplayFor(model => model.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zipProjectLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zipProjectLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;"><i class="fa fa-list-ul fa-fw"></i> </a>Registration History Details with RERA Punjab</h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                                <thead>
                                                    <tr>
                                                        <th>@Html.DisplayName("Sr No")</th>
                                                        <th>
                                                            @Html.DisplayName("Diary Number")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Project Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model=>model.RERAnumberRegistration)
                                                        </th>                                                        
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAnumberIssueDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAnumberRegUptoDate)
                                                        </th>
                                                        <th>@Html.DisplayName("View Detail")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int sno = 0;
                                                    }
                                                    @foreach (var item in Model.prpongoing)
                                                    {
                                                        {
                                                            sno = sno + 1;
                                                        }
                                                        <tr class="odd gradeX">
                                                            <td>@Html.DisplayName(sno.ToString())</td>
                                                            <td class="renewal-diarynumber" data-renewal-diarynumber="@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)">
                                                                @Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectName)                                                                
                                                            </td>
                                                            <td class="renewal-reranumber" data-renewal-reranumber="@Html.DisplayFor(modelItem => item.RERAnumberRegistration)">
                                                                @Html.DisplayFor(modelItem => item.RERAnumberRegistration)
                                                            </td>                                                            
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAnumberIssueDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)
                                                            </td>
                                                            <td class="renewalflag-code" data-renewalflag-code="@Html.DisplayFor(modelItem => item.RERAregistrationcode)">
                                                                @*@Html.DisplayName("View")*@
                                                                <a class="modalPrevRegistrationsDetail" href="javascript:void(0);">View</a>
                                                                @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectId" })
                                                                @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterId" })
                                                                @Html.HiddenFor(modelItem => item.ProjectName, new { @class = "hdnProjectName" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRegDiaryNumber_Name, new { @class = "hdnDiaryNumber" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRegDiaryNumber_ID, new { @class = "hdnProjectRegDiaryNumber_ID" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>                          
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Checklist Criteria Details</h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet"></link>
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
