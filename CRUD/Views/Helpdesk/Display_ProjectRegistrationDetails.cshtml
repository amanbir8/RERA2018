                url: BASE_URL + 'Helpdesk/ProjectRegistrationOnlinePaymentFeeDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'projectpaymentId': projectpaymentId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            var projectName = $.trim($(document).find('#zipProjectName').val());
            $(projectDetailsModal).find('h4.modal-title').html('Online Payment Details - (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

