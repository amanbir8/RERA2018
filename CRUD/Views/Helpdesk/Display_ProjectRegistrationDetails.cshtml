                                                            </div>

                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_AddressLine2, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressLine2, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                <label class="control-label">District</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressDistrictCode, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="control-label">State</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressStateCode, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_AddressPIN, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_AddressPIN, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_EmailAddress, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_EmailAddress, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.LabelFor(modelItem => item.AuthorizedPerson_MobileNumber, htmlAttributes: new { @class = "control-label" })
                                                            </div>
                                                            <div class="col-md-3">
                                                                @Html.DisplayFor(modelItem => item.AuthorizedPerson_MobileNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <fieldset class="col-md-12">                                                    
                                                    <legend class="my"><a data-criteria-code="154" class="modalOpenerButton" href="javascript:void(0);">Other Details</a></legend>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-9">
                                                                <label class="control-label">1. Is the proforma for Agreement of Sale as per prescribed format of the RERA Act, 2016 “Form-Q”?</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (item.IsProForma_AOS_RERAformat_AnnexureA == "Y")
                                                                {
                                                                    @Html.DisplayName("[YES]")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("[NO]")
                                                                }                                                                
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row" style="display:none">                                                        
                                                        <div class="form-group">
                                                            <div class="col-md-6">
                                                                <label class="control-label">If No, then Are the changes approved by RERA Punjab?</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if(item.IsProForma_AOS_RERAformat_No_IsApproved == "Y")
                                                                {
                                                                    @Html.DisplayName("[YES]")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("[NO]")
                                                                }                                                                    
                                                            </div>
                                                        </div>                                                        
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-6">
                                                                <label class="control-label">2. Is Project falls under Mega Project category?</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (item.IsProject_MegaProjectCategory == "Y")
                                                                {
                                                                    @Html.DisplayName("[YES]")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("[NO]")
                                                                }                                                               
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-6">
                                                                <label class="control-label">3. Is any pending litigation(s) related to the Project?</label>
                                                            </div>
                                                            <div class="col-md-3">
                                                                @if (item.IsLitigation_RelatedProject == "Y")
                                                                {
                                                                    @Html.DisplayName("[YES]")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("[NO]")
                                                                }                                                                
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="form-group">
                                                            <div class="col-md-6">
                                                                <label class="control-label">4. Is any regularization certificate issued related to the Project?</label>
                                                            </div>
                                                            <div class="col-md-3">                                                                
                                                                @if (Model.IsYes_RegularizationCertificate == "YREGC")
                                                                {
                                                                    @Html.DisplayName("[YES]")
                                                                    @Html.DisplayName(", (")
                                                                    @Html.DisplayFor(model => model.RegularizationCertificateInformation, new { htmlAttributes = new { @class = "form-control" } })
                                                                    @Html.DisplayName(")")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("[NO]")
                                                                }                                                                                                                        
                                                            </div>                                                            
                                                        </div>
                                                    </div>                                                    
                                                </fieldset>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }                            

                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;">
                                        <a data-criteria-code="163" class="modalOpenerButton" href="javascript:void(0);" title="Add Remarks (If Any)"><i class="fa fa-list-ul fa-fw"></i> </a>Registration Fee Details
                                        <span class="pull-right">
                                            <a class="modalOpenerFeeCalculatorButton" href="javascript:void(0);" title="Fee Calculator"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-calculator" aria-hidden="true"></i></span></a>
                                            <a class="modalOpenerButtonExpandChecklist" data-criteria-code="163" data-subcriteria-code="0" data-criteria-flag="1" href="javascript:void(0);" title="View Checklist"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-check-square-o" aria-hidden="true"></i></span></a>
                                            <a class="modalOpenerButtonExpandDocument" data-document-code="163" data-subdocument-code="0" data-document-flag="1" href="javascript:void(0);" title="View Documents"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-text" aria-hidden="true"></i></span></a>
                                            <a class="a lock-fee-details" id="btnLockFeeDetails" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                        </span>
                                    </h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                                <thead>
                                                    <tr>                                                        
                                                        <th>@Html.DisplayName("Sr No")</th>
                                                        <th>
                                                            @Html.DisplayName("Payment Title")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Registration Fee")
                                                        </th>
                                                        @*<th>
                                                            @Html.DisplayName("Other Fee")
                                                        </th>*@
                                                        <th>
                                                            @Html.DisplayName("Bank Name")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("DD/Bankers Cheque Number")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("DD/Bankers Cheque Amount (in rupees)")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Payment Date")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                    int snofee = 0;
                                                    }
                                                    @foreach (var item in Model.Project_Payment)
                                                {
                                                    {
                                                        snofee = snofee + 1;
                                                    }
                                                        <tr class="odd gradeX">
                                                            <td>
                                                                @Html.DisplayName(snofee.ToString())
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectPayment_TitleName)
                                                                @Html.HiddenFor(modelItem => item.ProjectPaymentRelated_ProjectRegistration_ID, new { @class = "hdnProjectID" })
                                                                @Html.HiddenFor(modelItem => item.ProjectPayment_ID, new { @class = "hdnRelatedPaymentID" })
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Registration_Fee)
                                                            </td>
                                                            @*<td>
                                                                @Html.DisplayFor(modelItem => item.Other_Fee)
                                                            </td>*@
                                                            <td>
                                                                @if (item.Payment_Mode != "Online Payment")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.Bank_Name)
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.Payment_Mode)
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (item.Payment_Mode != "Online Payment")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.DD_BankersCheque_Number)
                                                                    <a href="~/@Html.DisplayFor(modelItem => item.ImageDDorBankersCheque_FileName)@Html.DisplayFor(modelItem => item.ImageDDorBankersCheque_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.Payment_Mode)
                                                                }                                                                
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.DD_BankersCheque_Amount)
                                                            </td>
                                                            <td>
                                                                @if (item.Payment_Mode != "Online Payment")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.Date_of_Payment_RegistrationFee)
                                                                }
                                                                else
                                                                {
                                                                    <a class="modalOpenerOnlinePaymentDetail" href="javascript:void(0);" title="Online Payment Details">View <i class="fa fa-external-link-square"></i></a>
                                                                }                                                               
                                                            </td>
                                                        </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

