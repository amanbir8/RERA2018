    function lockUnlockHandlerProjectDetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftRegistrationFee').val());
            var parmIndexID = $.trim($(document).find('#ProjectRegistration_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectRegistration',
                data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockProjectDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockProjectDetails").attr("title", "Unlock Details");
                        $("#btnLockProjectDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockProjectDetails").prop('disabled', true);
                        $("#btnLockProjectDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockProjectDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockProjectDetails").attr("title", "Lock Details");
                        $("#btnLockProjectDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockProjectDetails").prop('disabled', true);
                        $("#btnLockProjectDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
