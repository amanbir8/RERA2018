@model CRUD.Models.HelpDesk.ClsPrp_AuthDesk_View_ProjectApprovalDetails

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-exampleDocument">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("Sr No")</th>
                        <th>@Html.DisplayName("Approvals/NOCs Title")</th>
                        <th>@Html.DisplayName("Document Type")</th>
                        <th>@Html.DisplayName("Document Status")</th>
                        <th>@Html.DisplayName("Date Planned for Application OR Expected Date of Receipt")</th>
                        <th>@Html.DisplayName("Reference/ Upload Date")</th>
                        <th>@Html.DisplayName("View")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 0;
                    }
                    @foreach (var item in Model.prpongoing)
                    {
                        {
                            sno = sno + 1;
                        }
                        <tr class="odd gradeX">
                            <td>@Html.DisplayName(sno.ToString())</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DocumentType_Name)
                                @if (item.DocumentType_Name.ToString() == "Other Document")
                                {
                                    @Html.DisplayName(" (")
                                    @Html.DisplayFor(modelItem => item.A_column)
                                    @Html.DisplayName(")")
                                }                                  
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.DocumentType_CategoryName)</td>
                            <td>@Html.DisplayFor(modelItem => item.DocumentType_Status)</td>
                            <td>@Html.DisplayFor(modelItem => item.Date_ApplicationPlannedorExpectedReceipt)</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                            <td align="center">
                                <a href="~/@Html.DisplayFor(modelItem => item.DocumentType_FileName)@Html.DisplayFor(modelItem => item.DocumentType_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
