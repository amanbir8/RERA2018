            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:#C8F2FE"></i> Pending registration number (Offline RERA registered project) and registration upto date.<br/> <i class="fa fa-check-square" style="color:yellow"></i> Pending registration number (web-portal) and registration upto date.<br/> <i class="fa fa-check-square" style="color:#F5F8F9"></i> Offline RERA registered project.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> RERA registered project (web-portal).',
            hide: false,
