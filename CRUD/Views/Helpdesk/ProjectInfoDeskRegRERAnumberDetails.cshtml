<script>
    var searchTable = null;

    function destroySearchTable() {
        if (searchTable) {
            searchTable.clear().destroy();
            searchTable = null;
        } else if ($.fn.DataTable.isDataTable('#searchResultsTable')) {
            $('#searchResultsTable').DataTable().clear().destroy();
        }
    }

    function initSearchTable() {
        destroySearchTable();

        searchTable = $('#searchResultsTable').DataTable({
            pageLength: 10,
            searching: true,
            paging: true,
            info: true,
            ordering: true,
            autoWidth: false,
            scrollX: true,
            scrollCollapse: true,
            language: {
                emptyTable: "No data available"
            },
            columnDefs: [
                { orderable: false, targets: [9, 10, 11] }
            ]
        });

        searchTable.columns.adjust().draw(false);
    }

    function performSearch() {
        var searchType = $('#searchType').val();
        var searchNumber = $.trim($('#searchNumber').val());

        if (searchNumber === '') {
            alert('Please enter a value.');
            return;
        }

        var BASE_URL = $('body').attr('data-base-url');

        $.ajax({
            url: BASE_URL + "Helpdesk/ProjectInfoDeskRegRERAnumberDetailsss",
            type: 'POST',
            data: {
                searchType: searchType,
                searchNumber: searchNumber
            },
            beforeSend: function () {
                startPreloader();
            },
            success: function (res) {
                stopPreloader();

                destroySearchTable();

                // Replace old rows completely
                $('#searchResultsTable tbody').empty().html(res);

                // Rebuild DataTable with fresh data
                initSearchTable();
            },
            error: function () {
                stopPreloader();
                alert('Search failed.');
            }
        });
    }

    $(document).ready(function () {

        $(document).on('click', '#btnSearchNumber', function () {
            initSearchTable();

            $('#searchNumberModal').modal('show');

            setTimeout(function () {
                $('#searchNumber').focus();
            }, 200);
        });

        $(document).on('shown.bs.modal', '#searchNumberModal', function () {
            if ($.fn.DataTable.isDataTable('#searchResultsTable')) {
                $('#searchResultsTable').DataTable().columns.adjust().draw(false);
            }
        });

        $(document).on('click', '#btnDoSearch', function () {
            performSearch();
        });

        $(document).on('keydown', '#searchNumber', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                performSearch();
            }
        });

        $(document).on('change', '#searchType', function () {
            var type = $(this).val();
            var placeholder = 'Enter value';

            if (type === 'diary') placeholder = 'Enter Diary Number';
            else if (type === 'promoter') placeholder = 'Enter Promoter Name';
            else if (type === 'project') placeholder = 'Enter Project Name';
            else if (type === 'rera') placeholder = 'Enter RERA Number';
            else if (type === 'district') placeholder = 'Enter District';

            $('#searchNumber').attr('placeholder', placeholder);
        });

        $(document).on('hidden.bs.modal', '#searchNumberModal', function () {
            $('#searchNumber').val('');
            $('#searchResultsTable tbody').empty();
            destroySearchTable();
        });
    });
</script>
