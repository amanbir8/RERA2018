            //var label = $('#selectedRangeLabel').val();
            ////if (!label) {
            ////    label = getLabel(start, end) || 'Custom Range';
            ////}

            //////$('#filterSummaryText').text('Showing details from ' + start.format('DD MMM YYYY') + ' to ' + end.format('DD MMM YYYY') + ' [ ' + label + ' ] ');
            ////$('#filterSummaryText').text(start.format('DD MMM YYYY') + ' - ' + end.format('DD MMM YYYY') + ' [ ' + label + ' ] ');
            //if (!label) {
            //    label = getLabel(start, end) || 'Custom Range';
            //}

            ////$('#filterSummaryText').text('Showing details from ' + start.format('DD MMM YYYY') + ' to ' + end.format('DD MMM YYYY') + ' [ ' + label + ' ] ');
            //$('#filterSummaryText').text(start.format('DD MMM YYYY') + ' - ' + end.format('DD MMM YYYY') + ' [ ' + label + ' ] ');
            var label = getLabel(start, end);
            if (label === 'Today' || label === 'Yesterday') {
                $('#filterSummaryText').text(label);
            } else {
                $('#filterSummaryText').text(start.format('DD MMM YYYY') + ' - ' + end.format('DD MMM YYYY'));
            }
        }

