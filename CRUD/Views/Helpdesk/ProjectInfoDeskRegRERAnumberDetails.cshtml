        // CHANGED: keep the correct range highlighted when the picker opens
        $('#customDateRangePicker').on('show.daterangepicker', function (ev, picker) {

            var label = isAllSelected()? 'All': (picker.chosenLabel || $('#selectedRangeLabel').val() || 'Custom Range');

            picker.container.find('.ranges li').removeClass('active');

            var $active = picker.container.find('.ranges li[data-range-key="' + label + '"]');
            if ($active.length) {
                $active.addClass('active');
            }
        });
        $('#customDateRangePicker').on('hide.daterangepicker', function () {
            $('#filterSummaryTrigger').removeClass('open');
        });

        function positionPickerNearFilterButton(picker) {
            var $btn = $('#filterSummaryTrigger');
            var btnOffset = $btn.offset();
            if (!btnOffset) return;

            var top = btnOffset.top + $btn.outerHeight() + 6;
            var containerWidth = picker.container.outerWidth() || 700;
            var viewportWidth = $(window).width();
            var left = btnOffset.left - (containerWidth - $btn.outerWidth());
            var minLeft = 8;
            var maxLeft = viewportWidth - containerWidth - 8;
            if (maxLeft < minLeft) {
                left = minLeft;
            } else {
                if (left < minLeft) left = minLeft;
                if (left > maxLeft) left = maxLeft;
            }
            picker.container.css({
                top: top + 'px',
                left: left + 'px',
                right: 'auto'
            });
        }

        $('#customDateRangePicker').on('apply.daterangepicker', function (ev, picker) {
            if (picker.chosenLabel === 'All') {
                $('#filterType').val('all');
                $('#fromDate').val('');
                $('#toDate').val('');
