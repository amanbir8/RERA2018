        // CHANGED: getLabel
        function getLabel(start, end) {

            // ADDED: All should always win over date comparison
            if (isAllSelected()) {
                return 'All';
            }

            if (start.isSame(moment().startOf('year'), 'day') &&
                end.isSame(moment().endOf('year'), 'day')) {
                return 'This Year';
            }

            if (start.isSame(moment(), 'day') && end.isSame(moment(), 'day')) {
                return 'Today';
            }

            if (start.isSame(moment().subtract(1, 'days'), 'day') &&
                end.isSame(moment().subtract(1, 'days'), 'day')) {
                return 'Yesterday';
            }

            return null;
        }

        function isAllSelected() {
            return $('#filterType').val() === 'all' || $('#selectedRangeLabel').val() === 'All';
        }

        function setText(start, end) {
            var label = getLabel(start, end);

            if (label) {
                $('#customDateRangePicker').val(label);
            } else {
                $('#customDateRangePicker').val(
                    start.format('DD MMM YYYY') + ' - ' + end.format('DD MMM YYYY')
                );
            }
        }

