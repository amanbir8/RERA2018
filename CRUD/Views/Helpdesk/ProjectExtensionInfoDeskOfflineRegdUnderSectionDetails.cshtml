@model CRUD.Models.HelpDesk.ClsPrp_ExtensionAuthorityDesk_ProjectExtnFormRegistrationNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [9]
            }]
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'Helpdesk/ExtensionProjectsInPublicView_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerExtensionFormdetails);
    });

    function infohelpHandlerExtensionFormdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:yellow"></i> Pending registration number (project) and extension of registration upto date.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> RERA registered project (extension of registration).',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Extensions of Registration (Projects) : Offline Registration(s) Under Section-8 Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Extensions for Registration/ Form-E : Offline Registration(s) Under Section-8 Details
                    <span class="pull-right">
                        <a href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        @*class="modalDownloadExcelButton" <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>*@
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("RERA Number")</th>
                                            <th>@Html.DisplayName("Registration Issue Date")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Extension of Registration Upto Date (Section-6)")</th>
                                            <th>@Html.DisplayName("Extension of Registration Upto Date (Section-8)")</th>
                                            <th>@Html.DisplayName("Remarks, If Any")</th>                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                                <tr class="odd gradeX">
                                                    <td>@Html.DisplayName(sno.ToString())</td>                                                   
                                                    <td>@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Promoter_Name)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>                                                                                                         
                                                    <td class="success">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                    <td class="success">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                    <td class="success">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                    <td class="success">@Html.DisplayFor(modelItem => item.ExtnRegistrationRegUptoDate)</td>                                                    
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                    <td>>@Html.DisplayFor(modelItem => item.Promoter_Name)</td>                                                    
                                                </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
