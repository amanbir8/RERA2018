<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Project Report : List of Projects Due/Pending for Extension(s) or Completion Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects Due/Pending for Extension of Registration or Completion of Project Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("ProjectInfoDeskDueExtensionApplication", "Helpdesk", FormMethod.Post, new { enctype = "multipart/form-data", @id = "PaymentMIS" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Options</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Search For</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.Application_SearchTypeFlag, "1", new { id = "chkApplicationDate", @class = "radio-applicationdatevalue", @checked = "checked" }) Due/Pending for Extension/Completion
                                                    @Html.RadioButtonFor(model => model.Application_SearchTypeFlag, "2", new { id = "chkApprovalDate", @class = "radio-applicationdatevalue" }) Upcoming Due/Pending for Extension/Completion
                                                </label>
