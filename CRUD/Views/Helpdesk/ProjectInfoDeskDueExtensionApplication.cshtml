<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        var vchecksearchtypevaluedatemode = $("input[name='Application_SearchTypeFlag']:checked").val();
        if (vchecksearchtypevaluedatemode == '1') {
            $("input[name='Application_SearchRangeFlag']").attr('disabled', false);
            $("input[name='Application_ToDate']").attr('disabled', false);
            $("input[name='Application_FromDate']").attr('disabled', false);
            $("#rowDateFilter").show();
            $("#rowMonthFilter").hide();
            $("#rowDateFilterDD").show();
            $("#rowDateFilterYY").hide();
           // $("#chkDatefromto").prop("checked", true);
        }
        else if (vchecksearchtypevaluedatemode == '2') {
            $("input[name='Application_SearchRangeFlag']").attr('disabled', true);
            $("input[name='Application_ToDate']").attr('disabled', true);
            $("input[name='Application_FromDate']").attr('disabled', true);
            $("#rowDateFilter").hide();
            $("#rowMonthFilter").show();
        }

        var vcheckrangevaluedatemode = $("input[name='Application_SearchRangeFlag']:checked").val();
        if (vcheckrangevaluedatemode == '1') {
            $("#rowDateFilterDD").show();
            $("#rowDateFilterYY").hide();
        } else {
            $("#rowDateFilterDD").hide();
            $("#rowDateFilterYY").show();
        }

        $(document).on('click', '.radio-applicationdatevalue', function () {

            if (this.value == '1') {

                $("#rowDateFilter").show();
                $("#rowMonthFilter").hide();
                $("#chkDatefromto").prop("checked", true);
                $("#rowDateFilterDD").show();
                $("#rowDateFilterYY").hide();

                $("input[name='Application_SearchRangeFlag']").attr('disabled', false);

                $("#Application_ToDate").val('');
                $("#Application_FromDate").val('');

                $("input[name='Application_ToDate']").attr('disabled', false);
                $("input[name='Application_FromDate']").attr('disabled', false);
            }
            else if (this.value == '2') {

                $("#rowDateFilter").hide();
                $("#rowMonthFilter").show();
                $("#rowDateFilterDD").show();
                $("#rowDateFilterYY").hide();

                var selectedMonth = $("input[name='Application_SearchMonthFlag']:checked").val();

                var monthsToAdd = 3;
                if (selectedMonth == "1") monthsToAdd = 3;
                else if (selectedMonth == "2") monthsToAdd = 6;
                else if (selectedMonth == "3") monthsToAdd = 9;
                else if (selectedMonth == "4") monthsToAdd = 12;

                var date1m = new Date();
                var dateXm = new Date();
                dateXm.setMonth(date1m.getMonth() + monthsToAdd);

                var dayString1m = moment(date1m).format("DD-MMM-YYYY");
                var dayStringXm = moment(dateXm).format("DD-MMM-YYYY");

                $("input[name='Application_SearchRangeFlag']").attr('disabled', true);
                $("#Application_ToDate").val(dayStringXm);
                $("#Application_FromDate").val(dayString1m);

                $("input[name='Application_ToDate']").attr('disabled', true);
                $("input[name='Application_FromDate']").attr('disabled', true);
            }
        });

        $(document).on('click', '.radio-applicationrangevalueMonth', function () {
            if ($("input[name='Application_SearchTypeFlag']:checked").val() == "2") {
                $(".radio-applicationdatevalue[value='2']").trigger('click');
            }
        });

        if ($("input[name='Application_SearchTypeFlag']:checked").val() == "2") {
            $(".radio-applicationdatevalue[value='2']").trigger('click');
        }

        $(document).on('click', '.radio-applicationrangevaluedate', function () {
            if (this.value == '1') {
                $("#rowDateFilterDD").show();
                $("#rowDateFilterYY").hide();
            } else {
                $("#rowDateFilterDD").hide();
                $("#rowDateFilterYY").show();
            }
        });

    });
</script>
<script>
    $(function () {

        $("#Application_FromDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#Application_ToDate").datepicker("option", "minDate", dt);
            }
        });

        $("#Application_ToDate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#Application_FromDate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#Application_ToDate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#Application_FromDate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>
