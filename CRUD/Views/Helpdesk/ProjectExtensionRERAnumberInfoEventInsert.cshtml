                                            @Html.ActionLink("Reset", "ProjectExtensionRERAnumberInfoEventInsert", "Helpdesk", null, new { @class = "btn btn-outline btn-primary" })                                                                                                                        
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
                </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
