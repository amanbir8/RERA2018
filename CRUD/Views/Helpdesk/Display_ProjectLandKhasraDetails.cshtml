    function lockUnclockHandlerLanddetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraft').val());
            var parmIndexID = $.trim($(document).find('#ProjectLand_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectLandDetails',
                data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockLandDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockLandDetails").attr("title", "Unlock Details");
                        $("#btnLockLandDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockLandDetails").prop('disabled', true);
                        $("#btnLockLandDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockLandDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockLandDetails").attr("title", "Lock Details");
                        $("#btnLockLandDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockLandDetails").prop('disabled', true);
                        $("#btnLockLandDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }

