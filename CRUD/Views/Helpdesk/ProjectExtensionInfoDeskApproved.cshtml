@* ============================================================
    SIMPLIFIED VERSION of the themed "ranges" dropdown
    - No hidden native <select> to keep in sync
    - List items are rendered server-side from ViewBag.ApplicationTypeList
    - One click handler does select + submit, no separate change handler
    ============================================================ *@

<style>
    .dd-wrap {
        position: relative;
        display: inline-flex;
    }

    .dd-trigger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 5px 10px;
        border: 1px solid #2e6da4;
        border-radius: 5px;
        background: #d9edf7;
        color: #2e6da4;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
        height: 24px;
        width: 160px;
        white-space: nowrap;
        cursor: pointer;
        box-sizing: border-box;
    }

        .dd-trigger:hover {
            background: #cbe4f1;
        }

    .dd-label {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dd-trigger .dd-caret {
        flex-shrink: 0;
        color: #2e6da4;
        font-size: 11px;
        transition: transform .15s ease;
    }

    .dd-trigger.open .dd-caret {
        transform: rotate(180deg);
    }

    /* Reuses .daterangepicker's own card / shadow / notch styling - just position + size it */
    .dd-panel {
        position: absolute;
        top: 33px;
        left: 0;
        width: 162px;
        max-width: none;
        display: none;
    }

        .dd-panel:before,
        .dd-panel:after {
            left: auto !important;
            right: 10px !important;
        }

    .dd-trigger.open + .dd-panel {
        display: block;
    }

    .dd-panel .ranges {
        float: none;
    }

        .dd-panel .ranges ul {
            width: 100%;
            font-weight: normal;
            color: #000;
        }

        .dd-panel .ranges li.active {
            background-color: #08c;
        }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: nowrap;
        position: relative;
    }

    @@media (max-width: 767px) {
        .panel-heading {
            position: relative;
            overflow: visible;
            min-height: 70px;
        }

            .panel-heading .header-actions {
                float: none !important;
                display: flex;
                width: 100%;
                margin-top: 8px;
                gap: 8px;
                flex-wrap: nowrap;
            }

        .dd-wrap {
            flex: 1 1 auto;
            min-width: 0;
        }

        .dd-trigger {
            width: 100% !important;
            max-width: 185px;
        }

        .dd-panel {
            left: 0 !important;
            right: auto !important;
            width: 130px !important;
            z-index: 9999;
        }
    }
</style>

<script>
    $(document).ready(function () {

        // ===== Themed dropdown for applicationType ($('.ranges') look, no real <select>) =====
        var $wrap = $('#ExtnApplicationTypeWrap');
        var $trigger = $wrap.find('.dd-trigger');
        var $hidden = $wrap.find('#ExtnApplicationType');

        $trigger.on('click', function (e) {
            e.stopPropagation();
            $(this).toggleClass('open');
        });

        $wrap.on('click', '.ranges li', function () {
            $hidden.val($(this).data('value'));
            $('#publicViewAppExtFilterForm').submit();
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#ExtnApplicationTypeWrap').length) {
                $trigger.removeClass('open');
            }
        });
    });
</script>

