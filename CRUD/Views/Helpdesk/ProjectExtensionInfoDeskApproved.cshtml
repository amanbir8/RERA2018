                <div class="panel-heading">
                    List of Extensions for Registration/ Form-E : Approved Application(s) Details
                    <div class="pull-right header-actions">
                        @*@using (Html.BeginForm("ProjectExtensionInfoDeskApproved", "Helpdesk", FormMethod.Post, new { id = "publicViewAppExtFilterForm" }))
                            {
                                @Html.AntiForgeryToken()

