@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_RevocationCancellationDiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [9, 10]
            }]
        });

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var promoterId = $.trim($(parentRow).find('input.hdnPromoterID').val());
            projectId = parseInt(projectId);
            promoterId = parseInt(promoterId);
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectRevokeInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'promoterId': promoterId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var swBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            //window.location = swBASE_URL + 'Helpdesk/ProjectsInPublicView_ExportToExcel';
            //$('input[type=text]').each(function () {
            //    $(this).val('');
            //});
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerRevocationProjectdetails);
    });
    function infohelpHandlerRevocationProjectdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Registration(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Rejected applications for revocation/ cancellation/ withdrawn of registered real-estate project(s) by authority.<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Projects (Registration Revocation/Cancellation) : Rejected Application(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects (Registration Revocation/Cancellation) : Rejected Application(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("RERA Number")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Extension of Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                                <tr class="odd gradeX">
                                                    <td>@Html.DisplayName(sno.ToString())</td>
                                                    <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)">
                                                        @Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)
                                                    </td>
                                                    <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                        @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                        @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterID" })
                                                    </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Project_RERAregistrationNumber)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Project_RERAregistrationValidUptoDate)</td>
                                                    <td>
                                                        @if (item.Project_RERAextnregistrationValidUptoDate.Value.ToString("MM/dd/yyyy") != "01/01/0001")
                                                        {
                                                            @Html.DisplayFor(modelItem => item.Project_RERAextnregistrationValidUptoDate)                                                                
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("--")
                                                        }                                                   
                                                    </td>                                                    
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                    <td class="center">
                                                        <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                    </td>                                                
                                                    <td class="center">
                                                        @Html.ActionLink("View", "ProjectRevokeInfoEventInsertAction", new { PDNumber = item.Project_DiaryNumber, RevDNumber = item.Revoke_RegDiaryNumber_Name, RevPName = item.Project_Name, RevPID = item.Project_ID, RevLMO = item.EventAction_IdentifiedOn, RevPrmID = item.Promoter_ID, RevPRefNumber = item.Project_RERAregistrationNumber })
                                                    </td>                                                    
                                                </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" /> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
