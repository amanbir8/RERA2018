                                            @Html.LabelFor(model => model.PG_Product_Info, htmlAttributes: new { @class = "control-label" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.DisplayFor(model => model.PG_Product_Info, new { htmlAttributes = new { @class = "form-control" } })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.PG_Amount, htmlAttributes: new { @class = "control-label" })
