                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.PG_Bank_Reference_No, htmlAttributes: new { @class = "control-label" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.DisplayFor(model => model.PG_Bank_Reference_No, new { htmlAttributes = new { @class = "form-control" } })
