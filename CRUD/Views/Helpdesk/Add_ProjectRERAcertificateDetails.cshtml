@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>

    <script>
        function showPublicViewTogglebtnYN(dataString, srNo) {
            var dataAction = dataString;
            var varPublicViewFlag = 0;
            if (dataAction != '0') {
                //YPV(1) NPV(0)
                varPublicViewFlag = 1;
            };

            var valpublicviewShowId = '#publicviewtogglebtn' + srNo;
            var strpvstatus = '#publicviewtogglestatus';
            var valpublicviewstatusShowId = strpvstatus.concat(srNo);
            switch (varPublicViewFlag) {
                case 0:
                    $(document).find(valpublicviewShowId.trim()).removeClass('active');
                    $(document).find(valpublicviewstatusShowId.trim()).addClass('border-left-danger warning');
                    break;
                case 1:
                    $(document).find(valpublicviewShowId.trim()).addClass('active');
                    $(document).find(valpublicviewstatusShowId.trim()).removeClass('border-left-danger warning');
                    break;
            }
        }

        $(document).ready(function () {
            $('table#promoter-documents-list-table').dataTable({
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [5, 6, 7]
                }],
                "language": {
                    "info": "Showing _START_ to _END_ of _TOTAL_ records",
                    "lengthMenu": "Show _MENU_ records"
                },
                "pagingType": "full_numbers"
            });
        });
    </script>
}

