                                                </thead>
                                                <tbody>
                                                    @{
                                                        int snoApprovals = 0;
                                                        string publicviewtogglebtnID = string.Empty;
                                                        string publicviewtogglestatusID = string.Empty;
                                                    }
                                                    @foreach (var item in Model.prpongoing)
                                                    {
                                                        {
                                                            snoApprovals = snoApprovals + 1;
                                                            publicviewtogglebtnID = "publicviewtogglebtn" + @snoApprovals.ToString();
                                                            publicviewtogglestatusID = "publicviewtogglestatus" + @snoApprovals.ToString();
                                                        }
                                                        <tr>
                                                            <td>
                                                                @if (item.ProjectRERAcert_InfoName != "Others")
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.ProjectRERAcert_InfoName)
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayFor(modelItem => item.ProjectRERAcert_InfoName)
                                                                    @Html.DisplayName(" (")
                                                                    @Html.DisplayFor(modelItem => item.A_column)
                                                                    @Html.DisplayName(")")
                                                                }
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectRERAcert_ReferenceNumber)
                                                                @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                                @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterID" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRERAcertificate_IndexID, new { @class = "hdnRCprojectIndexID" })
                                                                @Html.HiddenFor(modelItem => item.ProjectRERAcertificate_ID, new { @class = "hdnRCprojectID" })
                                                                @Html.HiddenFor(modelItem => item.IsPublicView, new { @class = "hdnPublicViewFlag" })
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ProjectRERAcert_IssueDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.IsWithdrawn == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            </td>
                                                            <td class="row-publicview text-center">
                                                                <script type="text/javascript">
                                                                    $(document).ready(function () {
                                                                        showPublicViewTogglebtnYN("@item.IsPublicView.ToString()", "@snoApprovals.ToString()");
                                                                    });
                                                                </script>
                                                                <button type="button" id=@publicviewtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary" data-toggle="button" aria-pressed="false" autocomplete="off" title="Is acceptable for web-page?">
                                                                    <div class="handle"></div>
                                                                </button>
                                                            </td>
                                                            <td class="text-center">                                                                
                                                                <a href="~/@Html.DisplayFor(modelItem => item.ProjectRERAcert_FilePath)@Html.DisplayFor(modelItem => item.ProjectRERAcert_FileName)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.IsDraft != 1)
                                                                {
                                                                    if (item.IsActive == 1)
                                                                    {
                                                                        @Html.ActionLink(" ", "Delete_ProjectRERAcertificateDetails", new { inProjectRERAcertificate_IndexID = item.ProjectRERAcertificate_IndexID, inProjectRERAcertificate_ID = item.ProjectRERAcertificate_ID, inProject_ID = item.Project_ID }, new { onclick = "return confirm('Do you want to delete?');", @class = "fa fa-remove" })
                                                                    }
                                                                    else
                                                                    {
                                                                        <i class="fa fa-lock fa-lg icon-cert-lock icon-disabled" aria-hidden="true"></i>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <i class="fa fa-lock fa-lg icon-cert-lock icon-disabled" aria-hidden="true"></i>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Split Screen -->
