<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        $("#submitOrder").click(function (e) {
            e.preventDefault();           
            var isAllValid = false;

            if ($('#RegistrationIssueDate_Output').val() != '' && $('#RegistrationValidUptoDate_Output').val() != '') {
                var xpRelated_Project_ID = $("#Related_Project_ID").val(),
                    xpRelated_Promoter_ID = $("#Related_Promoter_ID").val(),
                    xpRegistrationNumber_Output = $("#RegistrationNumber_Output").val(),
                    xpRegistrationIssueDate_Output = $("#RegistrationIssueDate_Output").val(),
                    xpRegistrationValidUptoDate_Output = $("#RegistrationValidUptoDate_Output").val(),                    
                    xpExtensionRegdFlag = $("#IsGeneratedRegistrationNumber").val(),
                    xpIsDraft = $("#IsDraft").val();

                if (Date.parse(xpRegistrationIssueDate_Output) <= Date.parse(xpRegistrationValidUptoDate_Output)) {
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Registration issue date should be less than registration valid upto date.');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pExtensionRegdFlag = $("#IsGeneratedRegistrationNumber").val(),
                    pIsDraft = $("#IsDraft").val();

                $("#rowCalA").attr("style", "display:block");
                $("#rowCalB").attr("style", "display:block");
                $("#rowCalC").attr("style", "display:block");                

                if (pExtensionRegdFlag > 0) {
                    $("#lblAlertNumber").text($("#ExtensionRegistrationNumber_Calc").val());
                    $("#rowCalCI").attr("style", "display:block");
                    $("#rowCalCII").attr("style", "display:none");
                    $("#rowCalE").attr("style", "display:none");
                }
                else {
                    $("#rowCalCI").attr("style", "display:none");
                    if (pIsDraft == 1) {
                        $("#rowCalCII").attr("style", "display:block");
                    }
                    else {
                        $("#rowCalCII").attr("style", "display:none");
                    }
                }                                

                $("#submitOrder").addClass('sorder-disable');
                $("#submitOrder").prop('disabled', true);
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).fadeOut(1000, function () {
                $(projectDetailsModal).modal('hide');
            });
        });

        $("#proceedOrder").click(function (e) {
            e.preventDefault();
            $("#RERAnumberRegistration").addClass('bgextractdisplay-color');
            $("#ExtnRegistrationIssueDate").addClass('bgextractdisplay-color');
            $("#ExtnRegistrationRegUptoDate").addClass('bgextractdisplay-color');

            $("#RERAnumberRegistration").val($("#txtextensionregdnumber").val());
            $("#ExtnRegistrationIssueDate").val($("#txtextensionregdissuedate").val());
            $("#ExtnRegistrationRegUptoDate").val($("#txtextensionregduptodate").val());

            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).modal('hide');
        });
    });
</script>
<script>
    $(function () {
        $('#RegistrationIssueDate_Output').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#RegistrationValidUptoDate_Output').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        $("#txtextensionregdnumber").inputmask({ mask: function () { return ["AAAAAA-AAA99-AA9999"]; } });
        $('#txtextensionregdissuedate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#txtextensionregduptodate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
    });
</script>
<script>
    $("#myform_FormFiveNumberCalculator").validate({
        rules: {
            RegistrationIssueDate_Output: {
                required: true,                
                maxlength: 15,
                minlength: 10
            },
            RegistrationValidUptoDate_Output: {
                required: true,                
                maxlength: 15,
                minlength: 10
            },
            txtextensionregdissuedate: {
                required: true,                
                maxlength: 15,
                minlength: 10
            },
            txtextensionregduptodate: {
                required: true,                
                maxlength: 15,
                minlength: 10
            }            
        }
    });
</script>

