    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="home-tab" href="@Url.Action("ProjectInfoDesk", "Helpdesk")" role="tab" aria-controls="home" aria-selected="true">In Process Applications</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("ProjectInfoDeskNewReSubmitted", "Helpdesk")" role="tab" aria-controls="profile" aria-selected="false">Re submitted Applications</a>
                </li>
                @*<li class="nav-item">
                        <a class="nav-link" id="existingreraprofile-tab" href="@Url.Action("ProjectInfoDeskExistingRERA", "Helpdesk")" role="tab" aria-controls="existingreraprofile" aria-selected="false">In Process [Offline Registered] Applications</a>
                    </li>*@
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects : In-Process (New Project) Application(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.PromoterRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("Last Application Status")</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                            string alertreminderDisplayId = "";
                                            string warningreminderDisplayId = "";
                                            string warningreminderDisplayTitle = "";
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)">
                                                    @Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)
                                                    @if (item.EventAction_Type.ToString() == "110007" || item.EventAction_Type.ToString() == "110010" || item.EventAction_Type.ToString() == "110011" || item.EventAction_Type.ToString() == "110012")
                                                    {
                                                        <script type="text/javascript">
                                                            $(document).ready(function () {
                                                                showSmsReminderColor("@item.EventAction_IdentifiedOn.ToString()", "@sno.ToString()");
                                                                showInCompleteDaysReminderColor("@item.EventAction_IdentifiedOn.ToString()", "@sno.ToString()");
                                                            });
                                                        </script>
                                                        {
                                                            alertreminderDisplayId = "alertreminderShow" + @sno.ToString();
                                                            warningreminderDisplayId = "warningreminderShow" + @sno.ToString();
                                                            warningreminderDisplayTitle = "warningreminderTitle" + @sno.ToString();
                                                        }
                                                        <span class="pull-left bg-border-show">
                                                            <span class="badge-show">
                                                                <a id="modalOpenerReminderAlertsButton" href="javascript:void(0);" title="View Reminder (Email/ SMS) Alerts"><i class="fa fa-envelope-o" aria-hidden="true"></i></a>
                                                                <span id=@alertreminderDisplayId.ToString() class="badge badge-counter badge-danger badge-glow"></span>
                                                            </span>
                                                            <span id=@warningreminderDisplayId.ToString() class="bg-exclamation-triangle-none">
                                                                <i class="fa fa-exclamation-triangle fa-fw warning-button" aria-hidden="true" title="Warning: Period of 90 days expired!"></i>
                                                            </span>
                                                        </span>
                                                    }
                                                </td>
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID, new { @class = "hdnPromoterID" })
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                @if (item.EventAction_Type.ToString() == "110018")
                                                {
                                                    <td class="success">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="info">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }
                                                else if (item.EventAction_Type.ToString() == "110007" || item.EventAction_Type.ToString() == "110010" || item.EventAction_Type.ToString() == "110011" || item.EventAction_Type.ToString() == "110012")
                                                {
                                                    <td class="danger" id=@warningreminderDisplayTitle.ToString()>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="info">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }
                                                else
                                                {
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }
                                                @*<td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.CreatedOn)</td>*@
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">
                                                    @Html.ActionLink("View", "ProjectInfoEventInsertAction", new { ProjectDiaryNumber = item.PromoterRegDiaryNumber_Name, ProjectName = item.Project_Name, ProjectID = item.Project_ID, LastModifiedOn = item.EventAction_IdentifiedOn, PromoterID = item.Promoter_ID })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
