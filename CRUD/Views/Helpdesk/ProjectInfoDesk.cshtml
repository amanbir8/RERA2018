    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
    <script>
        function showSmsReminderColor(dateString, srNo) {
            var dateInCompleteAction = new Date(dateString);

            var date0 = new Date();
            var date1 = new Date();
            var date2 = new Date();
            var date3 = new Date();
            var date4 = new Date();

            date1 = dateInCompleteAction;
            //date1.setDate(dateInCompleteAction.getDate());
            //date1.setMonth(dateInCompleteAction.getMonth());
            //date1.setFullYear(dateInCompleteAction.getFullYear());

            date2.setDate(date1.getDate());
            date2.setMonth(date1.getMonth());
            date2.setFullYear(date1.getFullYear());

            date3.setDate(date1.getDate());
            date3.setMonth(date1.getMonth());
            date3.setFullYear(date1.getFullYear());

            date4.setDate(date1.getDate());
            date4.setMonth(date1.getMonth());
            date4.setFullYear(date1.getFullYear());

            date2.setDate(date1.getDate() + 28);
            date3.setDate(date1.getDate() + 49);
            date4.setDate(date1.getDate() + 63);

            var diffTime1 = (date1.getTime() - date0.getTime());
            var diffDays1 = Math.ceil(diffTime1 / (1000 * 60 * 60 * 24));

            var diffTime2 = (date2.getTime() - date0.getTime());
            var diffDays2 = Math.ceil(diffTime2 / (1000 * 60 * 60 * 24));

            var diffTime3 = (date3.getTime() - date0.getTime());
            var diffDays3 = Math.ceil(diffTime3 / (1000 * 60 * 60 * 24));

            var diffTime4 = (date4.getTime() - date0.getTime());
            var diffDays4 = Math.ceil(diffTime4 / (1000 * 60 * 60 * 24));

            var varSetR1 = false;
            var varSetR2 = false;
            var varSetR3 = false;
            var varSetR4 = false;
            if (diffDays1 < 0 || diffDays1 == 0) {
                varSetR1 = true;
            };
            if (diffDays2 < 0 || diffDays2 == 0) {
                varSetR2 = true;
            };
            if (diffDays3 < 0 || diffDays3 == 0) {
                varSetR3 = true;
            };
            if (diffDays4 < 0 || diffDays4 == 0) {
                varSetR4 = true;
            };

            var varReminderFlag = 0;
            if (varSetR1 != false) {
                varReminderFlag = 0;
                if (varSetR2 != false) {
                    varReminderFlag = 1;
                    if (varSetR3 != false) {
                        varReminderFlag = 2;
                        if (varSetR4 != false) {
                            varReminderFlag = 3;
                        };
                    };
                };
            };

            var alertreminderShowId = '#alertreminderShow' + srNo;
            if (varReminderFlag < 1) {
                $(document).find(alertreminderShowId.trim()).text('N');
            }
            else {
                $(document).find(alertreminderShowId.trim()).text(varReminderFlag);
            };

            switch (varReminderFlag) {
                case 0:
                    $(document).find(alertreminderShowId.trim()).addClass('badge-primary').removeClass('badge-danger');
                    break;
                case 1:
                case 2:
                    $(document).find(alertreminderShowId.trim()).addClass('badge-warning').removeClass('badge-danger');
                    break;
            }
        }
        function showInCompleteDaysReminderColor(dateString, srNo) {
            var dateInCompleteAction = new Date(dateString);
            var date0 = new Date();
            var date1 = new Date();
            var date2 = new Date();

            date1 = dateInCompleteAction;
            //date1.setDate(dateInCompleteAction.getDate());
            //date1.setMonth(dateInCompleteAction.getMonth());
            //date1.setFullYear(dateInCompleteAction.getFullYear());

            date2.setDate(date1.getDate());
            date2.setMonth(date1.getMonth());
            date2.setFullYear(date1.getFullYear());

            date2.setDate(date1.getDate() + 90);

            var diffTime1 = (date0.getTime() - date1.getTime());
            var diffDays1 = Math.ceil(diffTime1 / (1000 * 60 * 60 * 24));

            var diffTime2 = (date2.getTime() - date0.getTime());
            var diffDays2 = Math.ceil(diffTime2 / (1000 * 60 * 60 * 24));

            var varSetR1 = false;
            var varSetR2 = false;

            if (diffDays1 > 90 || diffDays1 == 90) {
                varSetR1 = true;
            };
            if (diffDays2 < 0 || diffDays2 == 0) {
                varSetR2 = true;
            };

            var varReminderFlag = 0;
            if (varSetR1 != false && varSetR2 != false) {
                varReminderFlag = 1;
            };

            var alertInCompleteDaysShow = '#warningreminderShow' + srNo;
            var alertInCompleteDaysTitle = '#warningreminderTitle' + srNo;

            switch (varReminderFlag) {
                case 1:
                    $(document).find(alertInCompleteDaysShow.trim()).removeClass('bg-exclamation-triangle-none').addClass('bg-exclamation-triangle-warning');
                    $(document).find(alertInCompleteDaysTitle.trim()).addClass('border-left-danger');
                    break;
            }
        }

        $(document).ready(function () {
            $('#dataTables-example').DataTable({
                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [8, 9]
                }]
            });
        });
    </script>
}