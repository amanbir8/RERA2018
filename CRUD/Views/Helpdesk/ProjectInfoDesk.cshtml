        }

        .border-left-warning {
            /*text-shadow: 2px 2px 5px #fd7e14;*/
            border-left: .25rem solid #f6c23e !important;
        }

        .bg-exclamation-triangle-warning {
            color: #FF4961 !important;
            display: inline-block !important;
        }

        .bg-exclamation-triangle-none {
            display: none !important;
        }

        table#dataTables-example tr td i.warning-button {
            display: none;
        }

        table#dataTables-example tr:hover td i.warning-button {
            display: inline-block;
        }
