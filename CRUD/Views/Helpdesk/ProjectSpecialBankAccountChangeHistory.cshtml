@model CRUD.Models.HelpDesk.ClsPrp_AuthDesk_View_ProjectSpecialBankAccountDetails

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("Sr No")</th>
                        <th>@Html.DisplayNameFor(model => model.Bank_Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Bank_IFSC_Code)</th>
                        <th>@Html.DisplayNameFor(model => model.Bank_AccountNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.A_column)</th>
                        <th>@Html.DisplayNameFor(model => model.Account_FormDate)</th>
                        <th>@Html.DisplayNameFor(model => model.Account_ToDate)</th>
                        <th>@Html.DisplayName("View Document")</th>                        
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 0;
                    }
                    @foreach (var item in Model.prpongoing)
                    {
                        {
                            sno = sno + 1;
                        }                        
                        <tr class="odd gradeX">
                            <td>@Html.DisplayName(sno.ToString())</td>                            
                            <td>@Html.DisplayFor(modelItem => item.Bank_Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Bank_IFSC_Code)</td>
                            <td>@Html.DisplayFor(modelItem => item.Bank_AccountNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.A_column)</td>
                            <td>@Html.DisplayFor(modelItem => item.Account_FormDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.Account_ToDate)</td>
                            <td align="center">
                                <a href="~/@Html.DisplayFor(modelItem => item.ImageCancelledCheque_FileName)/@Html.DisplayFor(modelItem => item.ImageCancelledCheque_FilePath)" target="_blank"><i class="fa fa-external-link-square"></i></a>
                            </td>
                        </tr>                        
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
