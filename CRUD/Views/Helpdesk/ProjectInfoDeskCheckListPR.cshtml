<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Projects : Checklist Prepared - Application(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link" id="all-tab" href="@Url.Action("ProjectInfoDeskCheckList", "Helpdesk")" role="tab" aria-controls="all" aria-selected="true">All</a>
                </li>
                <li class="nav-item active">
                    <a class="nav-link active" id="projectandregulation-tab" href="@Url.Action("ProjectInfoDeskCheckListPR", "Helpdesk")" role="tab" aria-controls="projectandregulation" aria-selected="false">Project & Regulations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="townplanning-tab" href="@Url.Action("ProjectInfoDeskCheckListTP", "Helpdesk")" role="tab" aria-controls="townplanning" aria-selected="false">Town Planning</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="legal-tab" href="@Url.Action("ProjectInfoDeskCheckListLG", "Helpdesk")" role="tab" aria-controls="legal" aria-selected="false">Legal</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="financeandaccount-tab" href="@Url.Action("ProjectInfoDeskCheckListFA", "Helpdesk")" role="tab" aria-controls="financeandaccount" aria-selected="false">Finance & Accounts</a>
                </li>
            </ul>
        </div>
    </div>
    <!-- /.row tabs -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects : Checklist Prepared - Application(s) Details
                    <span class="pull-right"> 
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>                       
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.PromoterRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("Last Application Status")</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                            string alertchecklistDisplayId = "";
                                            string alertchecklistDisplayText = "";
                                            string alertchecklistDisplayAfterText = "";
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)">
                                                    @if (item.EventAction_Type.ToString() == "110006" || item.EventAction_Type.ToString() == "110038" || item.EventAction_Type.ToString() == "110024")
                                                    {
                                                        {
                                                            alertchecklistDisplayId = "alertchecklistShow" + @sno.ToString();
                                                            alertchecklistDisplayText = "alertchecklistText" + @sno.ToString();
                                                            alertchecklistDisplayAfterText = "alertchecklistAfterText" + @sno.ToString();
                                                        }
                                                        <span id=@alertchecklistDisplayText.ToString() class="bg-bookmark-text-no-color warning-text-notification">
                                                            @Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)
                                                        </span>
                                                        <span id=@alertchecklistDisplayAfterText.ToString() class="primary-text-notification">
                                                            @Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)
                                                        </span>
                                                        <script type="text/javascript">
                                                            $(document).ready(function () {
                                                                showChecklistNotificationColor("@item.CLflag1.ToString()", "@item.EventAction_Type.ToString()", "@sno.ToString()");
                                                            });
                                                        </script>
                                                        <span class="pull-left bg-border-show">
                                                            <span id=@alertchecklistDisplayId.ToString() class="bg-bookmark-icon-none">
                                                                <i class="fa fa-bookmark fa-fw warning-icon-notification" aria-hidden="true" title="Checklist prepared Notification!"></i>
                                                            </span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayFor(modelItem => item.PromoterRegDiaryNumber_Name)
                                                    }                                                    
                                                </td>                                                
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID)
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                @if (item.EventAction_Type.ToString() == "110024")
                                                {
                                                    <td class="warning" title="Check-list Prepared by Evaluation Officer.">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="warning" title="Check-list Prepared by Evaluation Officer.">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }
                                                else if (item.EventAction_Type.ToString() == "110034")
                                                {
                                                    <td class="success" title="Check-list Prepared, Verified and Reviewed by Evaluation Officer.">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td class="info" title="Check-list Prepared, Verified and Reviewed by Evaluation Officer.">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }
                                                else
                                                {
                                                    <td title="Check-list Pending for Verification by Evaluation Officer.">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                                                    <td title="Check-list Pending for Verification by Evaluation Officer.">@Html.DisplayFor(modelItem => item.CreatedOn)</td>
                                                }                                                
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>                                                
                                                <td class="center">
                                                    @Html.ActionLink("View", "ProjectInfoEventInsertAction", new { ProjectDiaryNumber = item.PromoterRegDiaryNumber_Name, ProjectName = item.Project_Name, ProjectID = item.Project_ID, LastModifiedOn = item.EventAction_IdentifiedOn , PromoterID = item.Promoter_ID })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
    
    <script>
        function showChecklistNotificationColor(colorString, eventString, srNo) {
            var varStr = false;
            if (colorString != '0') {
                varStr = true;
            };
            var varReminderFlag = 0;
            if (varStr != false) {
                varReminderFlag = colorString;
                varReminderFlag = parseInt(varReminderFlag);
                if (eventString == '110006' || eventString == '110038' || eventString == '110024') {
                    var alertchecklistShowId = '#alertchecklistShow' + srNo;
                    var alertchecklistTextId = '#alertchecklistText' + srNo;

                    switch (varReminderFlag) {
                        case 20:
                            $(document).find(alertchecklistShowId.trim()).removeClass('bg-bookmark-icon-none').addClass('bg-bookmark-icon-none');
                            $(document).find(alertchecklistTextId.trim()).removeClass('bg-bookmark-text-no-color').addClass('bg-bookmark-text-no-color');
                            break;
                        case 21:
                            $(document).find(alertchecklistShowId.trim()).removeClass('bg-bookmark-icon-none').addClass('bg-bookmark-icon-danger');
                            $(document).find(alertchecklistTextId.trim()).removeClass('bg-bookmark-text-no-color').addClass('bg-bookmark-text-danger');
                            break;
                        case 22:
                            $(document).find(alertchecklistShowId.trim()).removeClass('bg-bookmark-icon-none').addClass('bg-bookmark-icon-warning');
                            $(document).find(alertchecklistTextId.trim()).removeClass('bg-bookmark-text-no-color').addClass('bg-bookmark-text-warning');
                            break;
                        case 23:
                            $(document).find(alertchecklistShowId.trim()).removeClass('bg-bookmark-icon-none').addClass('bg-bookmark-icon-success');
                            $(document).find(alertchecklistTextId.trim()).removeClass('bg-bookmark-text-no-color').addClass('bg-bookmark-text-success');
                            break;
                        default:
                            $(document).find(alertchecklistShowId.trim()).removeClass('bg-bookmark-icon-none').addClass('bg-bookmark-icon-none');
                            $(document).find(alertchecklistTextId.trim()).removeClass('bg-bookmark-text-no-color').addClass('bg-bookmark-text-no-color');
                            break;
                    };
                };
            };
        }

        $(document).ready(function () {
            $('#dataTables-example').DataTable({
                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [7, 8]
                }]
            });
        });
    </script>  
}
