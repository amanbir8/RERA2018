                @{
                    var segments = Request.Url.AbsolutePath.Trim('/').Split('/');

                    // Segments to make inactive (non-clickable)
                    var inactiveSegments = new List<string> { "Helpdesk" };

                    // Custom titles for segments (keys must match actual URL segments!)
                    var titles = new Dictionary<string, string>
            {
                { "Helpdesk", "Helpdesk Section" },
                { "ProjectExtensionInfoDeskRejected", "Rejected Project Extension Desk" },
                { "ProjectExtensionInfoEventInsertAction", "Project Extension Event" },
                { "Rejected", "Rejected" }
            };

                    // Helper to split PascalCase words
                    Func<string, string> SplitPascalCase = input =>
                        System.Text.RegularExpressions.Regex.Replace(input,"(?<!^)([A-Z])"," $1").Trim();
                    string path = "";
                }

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("IndexDefault", "Home")">Home</a>
                        </li>
                        @foreach (var seg in segments)
                        {
                            path += "/" + seg;

                            var title = titles.ContainsKey(seg)? titles[seg]: SplitPascalCase(seg.Replace("-", " ").Replace("_", " "));

                            if (seg == segments.Last())
                            {
                                <li class="breadcrumb-item active" aria-current="page">@title</li>
                            }
                            else if (inactiveSegments.Contains(seg))
                            {
                                <li class="breadcrumb-item text-muted">@title</li>
                            }
                            else
                            {
                                <li class="breadcrumb-item">
                                    <a href="@path">@title</a>
                                </li>
                            }
                        }
                    </ol>
                </nav>

                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectExtForm_RegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                         {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ProjectExtForm_RegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ProjectExtForm_RegDiaryNumber_Name)</td>
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID)
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                <td>@Html.DisplayFor(modelItem => item.ProjectExtensionApplicationDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">
                                                    @Html.ActionLink("View", "ProjectExtensionInfoEventInsertAction", new { ExtensionProjectDiaryNumber = item.ProjectExtForm_RegDiaryNumber_Name, ExtensionProjectName = item.Project_Name, ExtensionProjectID = item.Project_ID, ExtensionLastModifiedOn = item.EventAction_IdentifiedOn, ExtensionPromoterID = item.Promoter_ID })
                                                </td>
                                            </tr>
                                         }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

