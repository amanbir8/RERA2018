@model CRUD.Models.HelpDesk.Clsprp_AuthorityDesk_PromoterCoPromoterDetails

<link href="@Url.Content("~/css/jquery.spzoom.css")" rel="stylesheet" type="text/css" />

<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var projectId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            projectId = parseInt(projectId);
            var criteriaCode = $(this).attr('data-criteria-code');
            criteriaCode = parseInt(criteriaCode);

            $.ajax({
                url: BASE_URLm + 'Helpdesk/ProjectInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Checklist Criteria Details');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');
            var criteriaValue = $(this).attr('data-copromoter');

            var criteriaCmd = "#btnAccordionAdditionalCoPromoters" + criteriaValue;
            var criteriaSelector = "#accordionAdditionalCoPromoters" + criteriaValue;

            var profileSelector = "#btnViewjointpromoterdetails" + criteriaValue;            
            if ($(profileSelector).find("span").hasClass('btn-warning')) {
                $(profileSelector).find("span").toggleClass("btn-warning btn-primary");
            };

            switch (criteriaCode) {
                case criteriaSelector:
                    $(criteriaCmd).find("span").toggleClass("btn-outline");
                    $(criteriaCmd).find("i").toggleClass("fa-minus-circle fa-plus-circle");                    
                    break;
            }
        });

        $(document).on('click', 'a.lock-copromoterprofile-box', function (e) {
            e.preventDefault();
            var elem = $(this);

            var btnLabel = $(this).attr("title");
            var cnfrmTxt = "Do you want to lock details?";
            if (btnLabel == "Unlock Details") {
                var cnfrmTxt = "Do you want to unlock details?";
            }

            if (confirm(cnfrmTxt)) {
                var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
                var parmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
                var parmLockUnlockFlag = $(this).attr('data-copromoter-flag');
                var parmLockUnlockIndex = $(this).attr('data-cprmindex-code');
                var parmApplicationId = $(this).attr('data-cprmid-code');

                var criteriaValue = $(this).attr('data-copromoter-box');
                var criteriaSelector = "#btnLockcopromoterprofilebox" + criteriaValue;
                //$(criteriaSelector).find("span").toggleClass("btn-primary btn-warning");
                //$(criteriaSelector).find("i").toggleClass("fa-key fa-unlock");
                var baseUrlcrpmlockunlock = $('body').attr('data-base-url');

                $.ajax({
                    type: 'GET',
                    url: baseUrlcrpmlockunlock + 'Helpdesk/LockUnlockHandler_CoPromoterProfileByIndex',
                    data: { 'parmProjectId': parmProjectId, 'parmPromoterId': parmPromoterId, 'parmLockUnlock': parmLockUnlockFlag, 'parmIndexID': parmLockUnlockIndex, 'parmAppId': parmApplicationId },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        alert(data.status);
                        if (data.statusCode == 101) {
                            $(criteriaSelector).find("span").removeClass("btn-warning").addClass("btn-primary");
                            $(criteriaSelector).attr("title", "Unlock Details");
                            $(criteriaSelector).find("i").removeClass("fa-unlock").addClass("fa-key");
                            $(criteriaSelector).prop('disabled', true);
                            $(criteriaSelector).find("span").addClass("disabledlockunlock");
                        } else if (data.statusCode == 105) {
                            $(criteriaSelector).find("span").removeClass("btn-primary").addClass("btn-warning");
                            $(criteriaSelector).attr("title", "Lock Details");
                            $(criteriaSelector).find("i").removeClass("fa-key").addClass("fa-unlock");
                            $(criteriaSelector).prop('disabled', true);
                            $(criteriaSelector).find("span").addClass("disabledlockunlock");
                        }
                    },
                    failure: function (data) {
                        alert('Bad Request! Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Error');
                    }
                });
            }
        });

        $(document).on('click', 'a.lock-copromoterprofile-info', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmApplicationId = $(this).attr('data-cprmapp-code');
            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var criteriaCode = 0;
            parmApplicationId = parseInt(parmApplicationId);
            parmProjectId = parseInt(parmProjectId);
            parmPromoterId = parseInt(parmPromoterId);
            criteriaCode = parseInt(criteriaCode);
            var baseUrlExtRef = $('body').attr('data-base-url');

            $.ajax({
                url: baseUrlExtRef + 'Helpdesk/PromoterExtractReferenceDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': parmProjectId, 'promoterId': parmPromoterId, 'appplicationId': parmApplicationId, 'varflag': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Promoter Details');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.show-jointpromoterdetails-box', function (e) {
            e.preventDefault();
            var elem = $(this);
            var jointpromoterModal = $(document).find('#myModal');
            $(jointpromoterModal).find('.modal-body').html('');

            var prmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var prmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var prmLinkPromoterId = $(this).attr('data-jointpromoter-link-promoterid');
            var prmJPromoterApplicationId = $(this).attr('data-jointpromoter-application-code');
            var prmJPromoterApplicationType = $(this).attr('data-jointpromoter-application-type');
            prmProjectId = parseInt(prmProjectId);
            prmPromoterId = parseInt(prmPromoterId);
            prmLinkPromoterId = parseInt(prmLinkPromoterId);
            prmJPromoterApplicationId = parseInt(prmJPromoterApplicationId);
            prmJPromoterApplicationType = parseInt(prmJPromoterApplicationType);

            var criteriaValue = $(this).attr('data-jointpromoter-box');
            var criteriaSelector = "#btnViewjointpromoterdetails" + criteriaValue;
            $(criteriaSelector).find("span").toggleClass("btn-primary btn-warning");

            var baseUrljointpromoter = $('body').attr('data-base-url');
            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            
            $.ajax({
                url: baseUrljointpromoter + 'Helpdesk/PromoterExtractRelatedLinksJointPromoterDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': prmProjectId, 'promoterId': prmPromoterId, 'linkpromoterId': prmLinkPromoterId, 'jpromoterapplicationId': prmJPromoterApplicationId, 'jpromoterapplicationType': prmJPromoterApplicationType, 'varflag': '0' },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(jointpromoterModal).find('.modal-body').html(response);
                    $(jointpromoterModal).find('table').DataTable({
                        responsive: true
                    });
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
            $(jointpromoterModal).find('h4.modal-title').html('Diary Number - <a href="javascript:void(0);"></a>');
            $(jointpromoterModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(jointpromoterModal).modal('show');
        });
    });
</script>
