</div>


<div id="myopensideshutter" class="opensideshutter" style="display:none;" data-toggle="tooltip" data-placement="right" title="Expand side panel">
    <a href="javascript:void(0)" onclick="openSideShutter()">
        <i class="fa fa-angle-double-right" style="font-size: 18px;
        background: #7bb73f;
        color: #22247b;
        padding: 10px 8px 10px 8px; border:none;">
        </i>
    </a>
</div>

<div id="mySidenav" class="sidenav">
    <div class="titlebar-name">Promoter's Document(s):</div>
    <a href="javascript:void(0)" class="closebtn" onclick="closeSidebarNav()">&times;</a>
    @foreach (var item in Model.promoterDoc)
    {
        <ul style="color:#FFF;">
            <li><a href="javascript:void(0)" data-record-id="" onclick="openSideScreen(@item.Promoter_ID, @item.PromoterDoc_IndexID)">@Html.DisplayFor(modelItem => item.PromoterDoc_InfoName)@Html.DisplayName(" (")@Html.DisplayFor(modelItem => item.PromoterDoc_ReferenceNumber)@Html.DisplayName(")")</a></li>
        </ul>
    }
</div>

<!-- Use any element to open the sidenav , item.PromoterDoc_InfoName, item.PromoterDoc_ReferenceNumber -->
<div id="mySidescreen" class="sidescreen">
    <div class="titlebar-name" id="documentDiscription">Promoter's Document(s):</div>
    <a href="javascript:void(0)" class="closebtn" onclick="closeSideScreen()" data-toggle="tooltip" data-placement="bottom" title="Minimize"><b><i style="font-size:16px; background-color:white;" class="fa">&#xf2d1;</i></b></a>
    <div class="titlebarsubscript-name" id="documentTypeDiscription"></div>
    <div id="mySidescreenDocumentImage" style="display:none;">
        <img id="mySidescreenDocImg" src="" class="sidescreenContainer" />
    </div>
    <div id="mySidescreenDocumentEmbed" style="display:none;">
        <embed id="mySidescreenDocEmbedd" src="" class="sidescreenContainer" style="min-height:800px;" type="application/pdf" />
    </div>
    @*<iframe class="iframepopup" id="myiframe"></iframe>*@
    <button id="mySidescreenbtnZoomOut" class="btnZoomInOut" onclick="zoomoutSideScreen()" style="display:none;"><i class="fa fa-search-plus" aria-hidden="true"></i></button>
    <button id="mySidescreenbtnZoomIn" class="btnZoomInOut" onclick="zoominSideScreen()" style="display:none;"><i class="fa fa-search-minus" aria-hidden="true"></i></button>
    <button id="mySidescreenbtnZoomOff" class="btnZoomInOut" onclick="closeSideScreen()" style="display:none; left:80px;"><i class="fa fa-times-circle" aria-hidden="true"></i></button>
</div>

<div id="myclosesideshutter" class="closesideshutter" style="display:none;" data-toggle="tooltip" data-placement="right" title="Collapse side panel">
