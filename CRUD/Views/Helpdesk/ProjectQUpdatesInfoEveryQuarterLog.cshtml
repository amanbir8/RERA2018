@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_QUpdatesProjectRecordsDetails

@{
    Layout = null;
}

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a#modalOpenerEventLogButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var projectquarterYear = $.trim($(parentRow).find('input.hdnQUpdateProjectYear').val());
            var projectquarterName = $.trim($(parentRow).find('input.hdnQUpdateProjectQName').val());
            projectId = parseInt(projectId);
            projectquarterYear = parseInt(projectquarterYear);
            projectquarterName = String(projectquarterName);
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectQUpdatesInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'quarterYear': projectquarterYear, 'quarterName': projectquarterName },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var registrationNo = $.trim($(parentRow).find('td.project-registration-number').attr('data-registration-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(registrationNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="width: 100%;">
                <thead>
                    <tr>                        
                        <th>@Html.DisplayName("Last Updated On")</th>
                        <th>@Html.DisplayNameFor(model => model.QUpdateProject_RegDiaryNumber_Name)</th>
                        <th>@Html.DisplayName("Quarter/Year")</th>
                        @*<th>@Html.DisplayNameFor(model => model.setQuarterValue_Name)</th>
                        <th>@Html.DisplayNameFor(model => model.setQuarterValue_Year)</th>*@
                        @*<th>@Html.DisplayNameFor(model => model.QUpdatesApplication_Date)</th>*@
                        <th>@Html.DisplayName("Status of Quarterly Updates")</th>                                                                        
                        <th>@Html.DisplayName("Prepared By")</th>
                        <th>@Html.DisplayName("Remarks, If Any")</th>                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.prpongoing)
                    {
                        <tr> 
                            <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>                           
                            <td class="project-registration-number" data-registration-no="@Html.DisplayFor(modelItem => item.RERAregistrationnumber)">
                                <a id="modalOpenerEventLogButton" href="javascript:void(0);" title="View Status Details">
                                    @Html.DisplayFor(modelItem => item.QUpdateProject_RegDiaryNumber_Name)
                                </a>                                
                            </td>
                            <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">
                                @Html.DisplayFor(modelItem => item.setQuarterValue_Name)
                                @Html.DisplayFor(modelItem => item.setQuarterValue_Year)
                                @Html.HiddenFor(modelItem => item.ProjectID, new { @class = "hdnProjectID" })
                                @Html.HiddenFor(modelItem => item.PromoterID)
                                @Html.HiddenFor(modelItem => item.QUpdateProject_Year, new { @class = "hdnQUpdateProjectYear" })
                                @Html.HiddenFor(modelItem => item.QUpdateProject_QuarterName, new { @class = "hdnQUpdateProjectQName" })
                            </td>                            
                            @*<td>@Html.DisplayFor(modelItem => item.QUpdatesApplication_Date)</td>*@
                            @if (item.EventAction_Type.ToString() == "160012" || item.EventAction_Type.ToString() == "160015")
                            {
                                <td class="danger" title="Not eligible for Public View (Quarterly Updates of registered project)">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                            }
                            else if (item.EventAction_Type.ToString() == "160007")
                            {
                                <td class="warning" title="In-Complete Quarterly Updates (Activated for Re-Apply Options)">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                            }
                            else if (item.EventAction_Type.ToString() == "160020")
                            {
                                <td class="info" title="No Reply Recieved from Promoter">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                            }
                            else
                            {
                                <td class="success" title="Quarterly Updates of registered project (web-portal)">@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>                                 
                            }                                                                                   
                            @if (item.EventAction_IdentifiedBy != "999")
                            {
                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedBy)</td>
                            }
                            else
                            {
                                <td>@Html.DisplayName(" ")</td>
                            }
                            <td align="justify">@Html.DisplayFor(modelItem => item.EventRemarks_IfAny)</td>                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet"></link>
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
