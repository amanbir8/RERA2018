<script type="text/javascript">
    $(document).ready(function () {
               
        $("input[name='IsAlreadyRegistration']").click(function () {
            if ($("#chkYes").is(":checked")) {                
                $("#idReraNo").show();                
                $('#ExistingRegistration').attr('readonly', false);
            }
            else {
                $("#idReraNo").hide();
            }
        });


        if ($("#chkYes").is(":checked")) {
            $("#idReraNo").show();            
            $('#ExistingRegistration').attr('readonly', false);
        }
        else {
            $("#idReraNo").hide();            
            $('#ExistingRegistration').attr('readonly', false);
            $('#ExistingRegistration').val("");
        }
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {

        $("input[name='IsExtensionIssued']").click(function () {
            if ($("#chkExtensionValueY").is(":checked")) {
                $("#idReraExtnNo").show();
                $('#ExtnRegistrationNumber').attr('readonly', false);
            }
            else {
                $("#idReraExtnNo").hide();
            }
        });


        if ($("#chkExtensionValueY").is(":checked")) {
            $("#idReraExtnNo").show();
            $('#ExtnRegistrationNumber').attr('readonly', false);
        }
        else {
            $("#idReraExtnNo").hide();
            $('#ExtnRegistrationNumber').attr('readonly', false);
        }
    });
</script>
<script>
    $(function () {
        $('#RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#RERAnumberRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        $('#ExtnRegistrationIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        var dateValidUptoExtnFrm = new Date();
        var month = dateValidUptoExtnFrm.getMonth();
        var year = (dateValidUptoExtnFrm.getFullYear() + 1);
        var day = dateValidUptoExtnFrm.getDate();
        var startDate = new Date(year, month, day);
        $("#ExtnRegistrationRegUptoDate").datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        @if (TempData["submitvalue"].ToString() != "")
        {
            if (TempData["submitvalue"].ToString() == "Save") {
                <text>
                    $('#ExtnRegistrationRegUptoDate').datepicker("setDate", startDate);
                </text>
            }
        }

        $('[data-toggle="tooltip"]').tooltip();
        });
</script>
