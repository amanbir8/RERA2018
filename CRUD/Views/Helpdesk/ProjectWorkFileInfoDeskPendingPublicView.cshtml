@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_ProjectWorkFileDiaryNumber

@*<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
    <script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>*@

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<link rel="stylesheet" href="@Url.Content("~/dist/css/daterangepicker.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>
<script src="@Url.Content("~/dist/js/moment.js")"></script>
<script src="@Url.Content("~/dist/js/daterangepicker.js")"></script>

<style>
    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }

    #filterToggleBtn.active {
        background: #337ab7;
        color: #fff;
    }

    .filter-panel {
        position: absolute;
        top: 36px;
        right: 0;
        width: 260px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 14px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        display: none;
        z-index: 999;
        overflow: visible;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .filter-section {
        margin-bottom: 14px;
    }

        .filter-section:last-child {
            margin-bottom: 0;
        }

        .filter-section label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
            cursor: pointer;
        }

    .filter-panel input[type="radio"] {
        margin-right: 6px;
    }

    .filter-panel .form-control {
        height: 30px;
        font-size: 12px;
        border-radius: 4px;
    }

    /*.btn-xs {
        padding: 4px 8px;
        font-size: 12px;
    }*/
    .header-actions .btn-xs {
        padding: 1px 5px;
        font-size: 12px;
        line-height: 1.5;
        border-radius: 3px;
    }

    .filter-summary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 5px 10px;
        border: 1px solid #b8e2c8;
        border-radius: 5px;
        background: linear-gradient(180deg, #f5fcf8 0%, #ebf8f0 100%);
        color: #216b43;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
    }

        .filter-summary i {
            color: #2f8f5b;
            font-size: 12px;
        }

    #dateRangeWrapper,
    #yearWrapper {
        margin-top: 6px;
    }

    #customDateRangePicker {
        cursor: pointer;
        background-color: #fff;
    }

    .daterangepicker {
        z-index: 99999 !important;
    }

        .daterangepicker .drp-calendar {
            max-width: none;
        }
</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');
        stopPreloader();

        $('#dataTables-workingfiles').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [10, 11]
            }]
        });


        $(document).on('click', '.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            window.location = BASE_URL + 'Helpdesk/PendingPublicViewsforWorkFileProject_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', '.info-help-details', infohelpHandlerRegistrationdetails);

        $('#filterToggleBtn').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $('#filterPanel').toggle();
            $(this).toggleClass('active');

            var picker = $('#customDateRangePicker').data('daterangepicker');
            if (picker && $('#dateRangeWrapper').is(':visible')) {
                picker.move();
            }
        });

        $(document).on('mousedown', function (e) {
            if ($(e.target).closest('#filterPanel, #filterToggleBtn, .daterangepicker').length) {
                return;
            }

            $('#filterPanel').hide();
            $('#filterToggleBtn').removeClass('active');
        });

        $('#filterPanel').on('click', function (e) {
            e.stopPropagation();
        });

        function showYear() {
            $('#filterType').val('year');
            $('#yearWrapper').show();
            $('#dateRangeWrapper').hide();
            $('#fromDate').val('');
            $('#toDate').val('');
            updateFilterSummary();
        }

        function showDate() {
            $('#filterType').val('daterange');
            $('#yearWrapper').hide();
            $('#dateRangeWrapper').show();

            var selectedYear = $('#approvalYear').val();
            var start = moment(selectedYear, "YYYY").startOf('year');
            var end = moment(selectedYear, "YYYY").endOf('year');

            if (!$('#fromDate').val() || !$('#toDate').val()) {
                $('#fromDate').val(start.format('YYYY-MM-DD'));
                $('#toDate').val(end.format('YYYY-MM-DD'));
            }

            setText(
                moment($('#fromDate').val(), 'YYYY-MM-DD'),
                moment($('#toDate').val(), 'YYYY-MM-DD')
            );
            updateFilterSummary();

            var picker = $('#customDateRangePicker').data('daterangepicker');
            if (picker) {
                picker.setStartDate(moment($('#fromDate').val(), 'YYYY-MM-DD'));
                picker.setEndDate(moment($('#toDate').val(), 'YYYY-MM-DD'));
                picker.move();
            }
        }

        $('input[name="filterMode"]').change(function () {
            if ($(this).val() === 'year') {
                showYear();
                //startPreloader();
                //$('#PVExtAppFilterForm').submit();
            } else {
                showDate();
            }
        });

        if ($('#fromDate').val() && $('#toDate').val()) {
            $('input[name="filterMode"][value="date"]').prop('checked', true);
            showDate();
        }
        //else {
        //    $('input[name="filterMode"][value="year"]').prop('checked', true);
        //    showYear();
        //}
        else {
            $('input[name="filterMode"][value="year"]').prop('checked', false); // changing to false
            $('#filterType').val('year');
            $('#yearWrapper').hide();
            $('#dateRangeWrapper').hide();
            updateFilterSummary();
        }

        $('#approvalYear').change(function () {
            if ($('#filterType').val() === 'year') {
                startPreloader();
                $('#PVExtAppFilterForm').submit();
            } else {
                var selectedYear = $('#approvalYear').val();
                var start = moment(selectedYear, "YYYY").startOf('year');
                var end = moment(selectedYear, "YYYY").endOf('year');

                $('#fromDate').val(start.format('YYYY-MM-DD'));
                $('#toDate').val(end.format('YYYY-MM-DD'));
                setText(start, end);
                updateFilterSummary();

                var picker = $('#customDateRangePicker').data('daterangepicker');
                if (picker) {
                    picker.setStartDate(start);
                    picker.setEndDate(end);
                    picker.move();
                }
            }
        });

        var selectedYear = $('#approvalYear').val();

        var from = $('#fromDate').val()
            ? moment($('#fromDate').val(), 'YYYY-MM-DD')
            : moment(selectedYear, "YYYY").startOf('year');

        var to = $('#toDate').val()
            ? moment($('#toDate').val(), 'YYYY-MM-DD')
            : moment(selectedYear, "YYYY").endOf('year');

        $('#customDateRangePicker').daterangepicker({
            autoUpdateInput: false,
            showDropdowns: true,
            startDate: from,
            endDate: to,
            maxSpan: { days: 90 },
            parentEl: 'body',
            opens: 'left',
            drops: 'down',
            locale: {
                format: 'DD MMM YYYY',
                customRangeLabel: 'Custom Range'
            },
            ranges: {
                'Today': [moment(), moment()],
                'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
        });

        function getLabel(start, end) {
            var selectedYear = $('#approvalYear').val();

            if (start.isSame(moment(selectedYear, "YYYY").startOf('year'), 'day') &&
                end.isSame(moment(selectedYear, "YYYY").endOf('year'), 'day')) {
                return '-- Select --';
            }

            if (start.isSame(moment(), 'day') && end.isSame(moment(), 'day')) return 'Today';

            if (start.isSame(moment().subtract(1, 'days'), 'day') &&
                end.isSame(moment().subtract(1, 'days'), 'day')) return 'Yesterday';

            if (start.isSame(moment().subtract(6, 'days'), 'day') &&
                end.isSame(moment(), 'day')) return 'Last 7 Days';

            if (start.isSame(moment().subtract(29, 'days'), 'day') &&
                end.isSame(moment(), 'day')) return 'Last 30 Days';

            if (start.isSame(moment().startOf('month'), 'day') &&
                end.isSame(moment().endOf('month'), 'day')) return 'This Month';

            if (start.isSame(moment().subtract(1, 'month').startOf('month'), 'day') &&
                end.isSame(moment().subtract(1, 'month').endOf('month'), 'day')) return 'Last Month';

            return null;
        }

        function setText(start, end) {
            var label = getLabel(start, end);

            if (label) {
                $('#customDateRangePicker').val(label);
            } else {
                $('#customDateRangePicker').val(
                    start.format('DD MMM YYYY') + ' - ' + end.format('DD MMM YYYY')
                );
            }
        }

        function updateFilterSummary() {
            var selectedYear = $('#approvalYear').val();
            var isDateMode = $('#filterType').val() === 'daterange' && $('#fromDate').val() && $('#toDate').val();
            var start = isDateMode ? moment($('#fromDate').val(), 'YYYY-MM-DD') : moment(selectedYear, "YYYY").startOf('year');
            var end = isDateMode ? moment($('#toDate').val(), 'YYYY-MM-DD') : moment(selectedYear, "YYYY").endOf('year');

            $('#filterSummaryText').text('Showing data from ' + start.format('DD MMM YYYY') + ' to ' + end.format('DD MMM YYYY'));
        }

        setText(from, to);
        updateFilterSummary();

        $('#customDateRangePicker').on('show.daterangepicker', function (ev, picker) {
            picker.move();
        });

        $('#customDateRangePicker').on('apply.daterangepicker', function (ev, picker) {
            $('#filterType').val('daterange');
            $('#fromDate').val(picker.startDate.format('YYYY-MM-DD'));
            $('#toDate').val(picker.endDate.format('YYYY-MM-DD'));
            $('#selectedRangeLabel').val(picker.chosenLabel || 'Custom Range');

            setText(picker.startDate, picker.endDate);
            updateFilterSummary();

            startPreloader();
            $('#PVExtAppFilterForm').submit();
        });

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            projectId = parseInt(projectId);
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Manage Registered Project(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Online Approved working files regarding real-estate project(s) by authority for registrations/updations/PUCs etc.<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>


