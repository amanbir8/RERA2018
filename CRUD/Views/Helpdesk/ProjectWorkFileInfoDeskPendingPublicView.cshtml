<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Projects : Approved Working File(s) Details of Registered Projects</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link" id="home-tab" href="@Url.Action("ProjectWorkFileInfoDeskApproved", "Helpdesk")" role="tab" aria-controls="home" aria-selected="true">Approved Projects</a>
                </li>
                <li class="nav-item active">
                    <a class="nav-link active" id="profile-tab" href="@Url.Action("ProjectWorkFileInfoDeskPendingPublicView", "Helpdesk")" role="tab" aria-controls="profile" aria-selected="false">Approved Projects (Pending for Public View)</a>
                </li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects : Approved Working File(s) Details (Pending for Public View) of Registered Projects
                    @*<span class="pull-right">
                            <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                            <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                        </span>*@
                    <div class="pull-right header-actions">
                        <div class="filter-summary">
                            <i class="fa fa-calendar" aria-hidden="true"></i>
                            <span id="filterSummaryText"></span>
                        </div>
                        <button id="filterToggleBtn" class="btn btn-outline btn-primary btn-xs" title="Filter">
                            <i class="fa fa-filter"></i>
                        </button>

                        <div id="filterPanel" class="filter-panel">
                            @using (Html.BeginForm("ProjectWorkFileInfoDeskPendingPublicView", "Helpdesk", FormMethod.Post, new { id = "PVExtAppFilterForm" }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden" id="filterType" name="filterType" value="year" />
                                <input type="hidden" id="selectedRangeLabel" name="rangelabel" value="@ViewBag.SelectedRangeLabel" />
                                <input type="hidden" id="fromDate" name="fromDate" value="@ViewBag.FromDate" />
                                <input type="hidden" id="toDate" name="toDate" value="@ViewBag.ToDate" />

                                <div class="filter-section">
                                    <label>Select Option:</label>
                                    <label>
                                        <input type="radio" name="filterMode" value="year" checked> Year
                                    </label>
                                    <div id="yearWrapper">
                                        @Html.DropDownList("approvalYear", new SelectList(ViewBag.Years, "Value", "Text", ViewBag.SelectedApprovalYear), new { @class = "form-control input-sm" })
                                    </div>
                                </div>

                                <div class="filter-section">
                                    <label>
                                        <input type="radio" name="filterMode" value="date"> Date Range
                                    </label>
                                    <div id="dateRangeWrapper" style="display:none;">
                                        <input type="text" id="customDateRangePicker" class="form-control input-sm" placeholder="Select Date Range" readonly />
                                    </div>
                                </div>
                            }
                        </div>

                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i> </span></a>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-workingfiles">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("RERA Number")</th>
                                            <th>@Html.DisplayName("Issue Date")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)</td>
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID)
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                @if (item.RERAnumberRegistration.ToString() == "NA")
                                                {
                                                    <td class="warning" title="Registration Number pending or not available.">@Html.DisplayName("--")</td>
                                                    <td class="warning" title="Registration Number pending or not available.">@Html.DisplayName("--")</td>
                                                    <td class="warning" title="Registration Number pending or not available.">@Html.DisplayName("--")</td>
                                                }
                                                else
                                                {
                                                    <td class="success" title="RERA registered project (web-portal)">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                    <td class="success" title="RERA registered project (web-portal)">@Html.DisplayFor(modelItem => item.RERAnumberIssueDate)</td>
                                                    if (item.RERAnumberRegUptoDate != DateTime.MinValue)
                                                    {
                                                        <td class="success" title="RERA registered project (web-portal)">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                    }
                                                    else
                                                    {
                                                        <td class="success" title="RERA registered project (web-portal)">@Html.DisplayName("--")</td>
                                                    }
                                                }
                                                <td>@Html.DisplayFor(modelItem => item.ApplicationDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">
                                                    @Html.ActionLink("View", "ProjectInfoEventInsertAction", new { ProjectDiaryNumber = item.PromoterRegDiaryNumber_Name, ProjectName = item.Project_Name, ProjectID = item.Project_ID, LastModifiedOn = item.EventAction_IdentifiedOn, PromoterID = item.Promoter_ID })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
