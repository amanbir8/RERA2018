<script>
    function openSideScreen(promotorId, documentIndexId) {
        var baseUrl = $('body').attr('data-base-url');
        var apiUrl = '@System.Configuration.ConfigurationManager.AppSettings["docpagesBaseURL"]';
        $.ajax({
            type: "GET",
            url: baseUrl + "Helpdesk/GetPromoterDoc",
            datatype: "Json",
            data: { 'Pid': promotorId, 'docIndexID': documentIndexId },
            beforeSend: function () {
                startPreloader();
            },
            success: function (data) {
                stopPreloader();
                var fileUrl = '';
                $.each(data.prpPromoterDocList, function (index, value) {
                    if (value.PromoterDoc_IndexID == documentIndexId) {
                        fileUrl = value.PromoterDoc_FilePath;
                    }
                });

                var filename = fileUrl;
                var extension = filename.replace(/^.*\./, '');
                if (extension == filename) {
                    extension = '';
                } else {
                    extension = extension.toLowerCase();
                }
                switch (extension) {
                    case 'jpg':
                    case 'jpeg':
                    case 'png':
                        $("#mySidescreenDocumentEmbed").hide();
                        $("#mySidescreenDocumentImage").show();
                        $("#mySidescreenDocImg").attr('src', apiUrl + fileUrl);
                        $("#documentTypeDiscription").text('(File Type: JPEG/JPG)');
                        break;
                    case 'pdf':
                        $("#mySidescreenDocumentEmbed").show();
                        $("#mySidescreenDocumentImage").hide();
                        $("#mySidescreenDocEmbedd").attr('src', apiUrl + fileUrl + '#view=FitH&scrollbar=0&toolbar=0&navpanes=1');
                        $("#documentTypeDiscription").text('(File Type: PDF)');
                        break;
                    default:
                        $("#mySidescreenDocumentEmbed").show();
                        $("#mySidescreenDocumentImage").hide();
                        $("#mySidescreenDocEmbedd").attr('src', apiUrl + fileUrl + '#view=FitH&scrollbar=0&toolbar=0&navpanes=1');
                        $("#documentTypeDiscription").text('(File Type: Other File)');
                        break;
                }
                //$("#myiframe").attr('src', apiUrl + fileUrl);
            }
        });

        document.getElementById("mySidescreen").style.width = "40%";
        document.getElementById("mySidescreen").style.height = "100%";
        document.getElementById("wrapper").style.marginLeft = "40%";
        document.getElementById("wrapper").style.transition = "0.3s";
        document.getElementById("page-wrapper").style.marginLeft = "0px";
        document.getElementById("side-menu").style.display = "none";

        document.getElementById("myopensideshutter").style.display = "none";
        document.getElementById("myclosesideshutter").style.display = "block";
        //document.getElementById("myclosesideshutter").style.marginLeft = "40%";
        document.getElementById("myclosesideshutter").style.transition = "0.3s";
        //document.getElementById("mybtnsidenav").style.display = "none";

        document.getElementById("mySidescreenbtnZoomOut").style.display = "block";
        document.getElementById("mySidescreenbtnZoomIn").style.display = "none";
        document.getElementById("mySidescreenbtnZoomOff").style.display = "block";
    }

    function closeSideScreen() {
        document.getElementById("mySidescreen").style.width = "0";
        document.getElementById("wrapper").style.marginLeft = "0";
        document.getElementById("page-wrapper").style.marginLeft = "250px";
        document.getElementById("side-menu").style.display = "block";

        document.getElementById("myopensideshutter").style.display = "none";
        document.getElementById("myclosesideshutter").style.display = "none";
        //document.getElementById("mybtnsidenav").style.display = "none";
        document.getElementById("mySidescreenbtnZoomOut").style.display = "none";
        document.getElementById("mySidescreenbtnZoomIn").style.display = "none";
        document.getElementById("mySidescreenbtnZoomOff").style.display = "none";
    }

