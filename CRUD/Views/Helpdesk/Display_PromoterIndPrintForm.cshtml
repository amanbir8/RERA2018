<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }
</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');
            parmProjectId = parseInt(parmProjectId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
        $(document).on('click', 'a.modalOpenerButtonExpandDocument', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmdocID = $(this).attr('data-document-code');
            var parmdocSubID = $(this).attr('data-subdocument-code');
            var parmdocFlag = $(this).attr('data-document-flag');
            parmProjectId = parseInt(parmProjectId);
            parmdocID = parseInt(parmdocID);
            parmdocSubID = parseInt(parmdocSubID);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoDocumentDisplayByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmdocID': parmdocID, 'parmdocSubID': parmdocSubID, 'parmdocFlag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Document Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-promoterprofile-details", lockUnclockHandlerProfile);

        //Lock-Unlock-Loader-Handler (Promoter Members)
        var parmLockUnlockprofile = $.trim($(document).find('#IsDraftpromoterindividualprofile').val());
        if (parmLockUnlockprofile == 1) { //L        
            $("#btnLockpromoterprofileDetails").prop('disabled', false);
            $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockpromoterprofileDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockpromoterprofileDetails").attr("title", "Unlock Details");
            $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockprofile == 5) { //UL         
            $("#btnLockpromoterprofileDetails").prop('disabled', false);
            $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockpromoterprofileDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockpromoterprofileDetails").attr("title", "Lock Details");
            $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockprofile == 6) { //PL         
            $("#btnLockpromoterprofileDetails").prop('disabled', true);
            $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockpromoterprofileDetails").attr("title", "Unlock Details");
            $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockpromoterprofileDetails").prop('disabled', true);
            $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockpromoterprofileDetails").attr("title", "Lock Details");
            $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnclockHandlerProfile() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {
            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftpromoterindividualprofile').val());
            var parmIndexID = 0;
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_PromoterIndividualProfile',
                data: { 'parmProjectId': parmProjectId, 'parmPromoterId': parmPromoterId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockpromoterprofileDetails").attr("title", "Unlock Details");
                        $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockpromoterprofileDetails").prop('disabled', true);
                        $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockpromoterprofileDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockpromoterprofileDetails").attr("title", "Lock Details");
                        $("#btnLockpromoterprofileDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockpromoterprofileDetails").prop('disabled', true);
                        $("#btnLockpromoterprofileDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

