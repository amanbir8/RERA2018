@model CRUD.Models.HelpDesk.ClsPrp_AuthorityDesk_ProjectRERAnumberExtnSummaryDetails
@{
    Layout = null;
}

<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="width: 100%;">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.ProjectRegDiaryNumber_Name)</th>
                        <th>@Html.DisplayNameFor(model => model.ProjectName)</th>
                        <th>@Html.DisplayNameFor(model => model.Project_RegistrationNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.Project_IssueDate)</th>
                        <th>@Html.DisplayNameFor(model => model.Project_ValidUptoDate)</th>  
                        <th>@Html.DisplayNameFor(model => model.ProjectFormFive_ValidUptoDate)</th>                                                                    
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.prpongoing)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.ProjectRegDiaryNumber_Name)</td>
                            <td align="justify">@Html.DisplayFor(modelItem => item.ProjectName)</td>                          
                            <td align="justify">@Html.DisplayFor(modelItem => item.Project_RegistrationNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.Project_IssueDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.Project_ValidUptoDate)</td> 
                            <td>@Html.DisplayFor(modelItem => item.ProjectFormFive_ValidUptoDate)</td>                                                      
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
