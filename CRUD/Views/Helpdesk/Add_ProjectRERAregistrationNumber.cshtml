<script type="text/javascript">
    $(document).ready(function () {
               
        $("input[name='IsAlreadyRegistration']").click(function () {
            if ($("#chkYes").is(":checked")) {                
                $("#idReraNo").show();                
                $('#ExistingRegistration').attr('readonly', false);
            }
            else {
                $("#idReraNo").hide();
            }
        });


        if ($("#chkYes").is(":checked")) {
            $("#idReraNo").show();            
            $('#ExistingRegistration').attr('readonly', false);
        }
        else {
            $("#idReraNo").hide();            
            $('#ExistingRegistration').attr('readonly', false);
            $('#ExistingRegistration').val("");
        }
    });
</script>
