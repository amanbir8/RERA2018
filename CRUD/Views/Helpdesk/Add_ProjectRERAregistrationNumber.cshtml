<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonRegNumberCalc', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            
            var parmProjectId = $.trim($(document).find('#Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#Promoter_ID').val());
            var parmdocFlag = $(this).attr('data-document-flag');
            parmProjectId = parseInt(parmProjectId);
            parmPromoterId = parseInt(parmPromoterId);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $("#ProjectRegDiaryNumber_Name").val();
            var varProjectName = $("#ProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'Helpdesk/ProjectRegistrationNumberRecordsCalculator',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': parmProjectId, 'promoterId': parmPromoterId, 'varflag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('File Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonRegNumHistory', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#Promoter_ID').val());
            var parmdocFlag = $(this).attr('data-document-flag');
            parmProjectId = parseInt(parmProjectId);
            parmPromoterId = parseInt(parmPromoterId);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $("#ProjectRegDiaryNumber_Name").val();
            var varProjectName = $("#ProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'Helpdesk/ProjectRegistrationNumberRecordsHistory',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': parmProjectId, 'promoterId': parmPromoterId, 'varflag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('File Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script type="text/javascript">
    $(function () {
        $('#RERAnumberRegistration').change(function () {
            var RegdNo = $("#RERAnumberRegistration").val();
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "Helpdesk/CheckRERAregistrationNumber",
                data: '{mRegNumber: "' + RegdNo + '" }',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response) {
                        alert("Registration Number Already exist! Try another.")
                        $("#RERAnumberRegistration").val('');
                    }
                }
            });
        });
    });
</script>

