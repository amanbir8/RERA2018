<script type="text/javascript">
    @if (TempData["EventSubmitMessage"].ToString() != "")
     {
        if (TempData["EventSubmitMessageMappingUrlFlag"].ToString() != "ResetFlag")
        {
            <text>
                $(document).ready(function () {
                    swal({
                        title: "Message",
