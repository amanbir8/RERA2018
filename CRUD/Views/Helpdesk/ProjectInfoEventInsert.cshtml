                    }, function () {
                        window.location = "../@TempData["EventSubmitMessageMappingUrlFlag"]";
                    });
                });
            </text>
        }
        else
        {
            <text>
                $(document).ready(function()
                    {
                    swal({
                    title: "Message",
                        text: "@TempData["EventSubmitMessage"]",
                        type: "success"
                    }, function () {
                        return true;
                    });
                });
            </text>
        }
     }
</script>
<script type="text/javascript">
    $(document).ready(function () {

        $('#EventAction_Type').change(function () {

            var BASE_URLn = $('body').attr('data-base-url');

            $.ajax({
                type: "POST",
                url: BASE_URLn + 'Helpdesk/GetEventDescriptionMasterByCode',
                datatype: "Json",
                data: { EventCode: $('#EventAction_Type').val() },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    $.each(data, function (index, value) {

                        $('#getEventDescFileInfo').show();
                        $('#EventDescDiscription').text("Description : " + value.EventAction_Description);
                    });
                }
            });
        });
    });
</script>
