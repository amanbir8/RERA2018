<script type="text/javascript">
    $(document).ready(function () {

        $('#chkYesSameChecklist').on("click", function () {
            if ($(this).is(':checked')) {

                var BASE_URLn = $('body').attr('data-base-url');

                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'Helpdesk/GetCriteriaDescription_NotAccepted_ByProjectID',
                    datatype: "Json",
                    data: { projectId: $('#Related_Project_ID').val() },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        $('#getChecklistDescFileInfo').show();
                        $('#ChecklistDescDiscription').text("Checklist Criteria Description : " + data);
                        $('#Remarks_IfAny').text("Remarks as " + data);
                    }
                });

            } else {
                $('#getChecklistDescFileInfo').hide();
                $('#Remarks_IfAny').text('');
            }
        });

    });
</script>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonCode', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $('#Related_Project_ID').val();
            projectId = parseInt(projectId);
            var varDNumber = $("#Project_DiaryNumber").val();
            var varProjectName = $.trim($(document).find("div.project-name").text());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
    // get remaining words count for textarea
    var maxMessageLength = 2400;
    var messageField = $('#myform_EventListInsert').find('textarea#Remarks_IfAny');
    $('body').on('input', 'textarea#Remarks_IfAny', function (e) {
        var msgVal = $(this).val();
        var msgValLen = msgVal.length;
        if (msgValLen <= maxMessageLength) {
            var remaining = parseInt(maxMessageLength - msgValLen);
            $(this).parents('.form-group').find('.words-remain').html(remaining + ' characters remaining');
        }
    });
</script>
@{
    var segments = Request.Url.AbsolutePath.Trim('/').Split('/');

    var inactiveSegments = new List<string> { "Helpdesk" };

    var titles = new Dictionary<string, string>
            {
                { "Helpdesk", "Helpdesk Section" },
                { "ProjectExtensionInfoDeskRejected", "Rejected Project Extension Desk" },
                { "ProjectExtensionInfoEventInsertAction", "Project Extension Event" },
                { "Rejected", "Rejected" }
            };

    // 👉 Inject "ProjectExtensionInfoDesk" breadcrumb manually
    // when current path contains "ProjectExtensionInfoEventInsertAction"
    if (segments.Contains("ProjectExtensionInfoEventInsertAction") && !segments.Contains("ProjectExtensionInfoDeskRejected"))
    {
        var newList = new List<string>();
        foreach (var seg in segments)
        {
            newList.Add(seg);
            if (seg == "Helpdesk")
            {
                // insert the desk before event insert action
                newList.Add("ProjectExtensionInfoDeskRejected");
            }
        }
        segments = newList.ToArray();
    }

    string path = "";
}


<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("IndexDefault", "Home")">Home</a>
        </li>

        @foreach (var seg in segments)
        {
            path += "/" + seg;
            var title = titles.ContainsKey(seg)
                ? titles[seg]
                : System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(seg.Replace("-", " ").Replace("_", " "));

            if (seg == segments.Last())
            {
                // Last segment = active
                <li class="breadcrumb-item active" aria-current="page">@title</li>
            }
            else if (inactiveSegments.Contains(seg))
            {
                // Inactive breadcrumb (no link)
                <li class="breadcrumb-item text-muted">@title</li>
            }
            else
            {
                // Normal clickable breadcrumb
                <li class="breadcrumb-item">
                    <a href="@path">@title</a>
                </li>
            }
        }
    </ol>
</nav>
