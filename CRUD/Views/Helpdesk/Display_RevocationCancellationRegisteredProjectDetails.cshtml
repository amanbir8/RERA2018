                                                             @if (Model.ProjectType.ToString() == "PR")
                                                             {
                                                                @Html.DisplayName("Residential")
                                                             }
                                                             else if (Model.ProjectType.ToString() == "PC")
                                                             {
                                                                @Html.DisplayName("Commercial")
                                                             }
                                                             else if (Model.ProjectType.ToString() == "PM")
                                                             {
                                                                @Html.DisplayName("Mixed")
                                                             }
                                                             else if (Model.ProjectType.ToString() == "PI")
                                                             {
                                                                @Html.DisplayName("Industrial")
                                                             }
                                                             else if (Model.ProjectType.ToString() == "OT")
                                                             {
                                                                @Html.DisplayName("Other")
                                                             }
