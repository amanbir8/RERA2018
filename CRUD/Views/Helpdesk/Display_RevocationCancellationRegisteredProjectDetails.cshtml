                                                            @Html.DisplayFor(model => model.ProjectAddressDistrict, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ProjectType, htmlAttributes: new { @class = "control-label" })
                                                        </div>
