                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Project Details</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ProjectName, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.ProjectName, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.PromoterName, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.PromoterName, new { htmlAttributes = new { @class = "form-control" } })
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ProjectRegDiaryNumber_Name, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.ProjectRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ExtnRegDiaryNumber_Name, htmlAttributes: new { @class = "control-label" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.DisplayFor(model => model.ExtnRegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                        </div>
                                                    </div>
                                                </div>
