    function lockUnclockHandlerPromoterTrack() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {
            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmPromoterId = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftpromotertrack').val());
            var parmIndexID = 0;
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_PromoterTrackRecord',
                data: { 'parmProjectId': parmProjectId, 'parmPromoterId': parmPromoterId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockpromotertrackDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockpromotertrackDetails").attr("title", "Unlock Details");
                        $("#btnLockpromotertrackDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockpromotertrackDetails").prop('disabled', true);
                        $("#btnLockpromotertrackDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockpromotertrackDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockpromotertrackDetails").attr("title", "Lock Details");
                        $("#btnLockpromotertrackDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockpromotertrackDetails").prop('disabled', true);
                        $("#btnLockpromotertrackDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
