@model CRUD.Models.HelpDesk.ClsPrp_AuthDesk_View_ProjectSpecialBankAccountDetails
@{
    Layout = null;
}
<link href="@Url.Content("~/dist/css/rera-toggleshow.css")" rel="stylesheet" />
<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<style>
    *.bgdisabled-color {
        background-color: #F0F0F0;
    }

    *.bgdisplay-color {
        background-color: #8fcedd;
    }

    *.bgspecialdisplay-color {
        background-color: #7bb73f;
    }

    .disclaimer-text {
        text-align: justify;
        text-justify: inter-word;
    }

    .dataTables_filter {
        display: none;
    }

    .dataTables_info {
        display: none;
    }

    .sorder-disable {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
<script>
    $(function () {
        $('table#registrationdetailsTable').dataTable({
            "bSort": false,
            "bPaginate": false,
            "bFilter": false,
            "bInfo": false,
            responsive: true
        });
    });
</script>
<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        function submitOrder(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "Helpdesk/SearchProjectSpecialBankAccountDetail",
                data: data,
                beforeSend: function () {
                    startPreloader();
                },
                success: function (obj) {
                    stopPreloader();
                    if (obj.status == true) {
                        var detailsTableBody = $("#registrationdetailsTable tbody");
                        var RowDetail;
                        $("#rowChkA").attr("style", "display:none");
                        $("#rowChkB").attr("style", "display:block");
                        $("#rowChkC").attr("style", "display:none");
                        var getrowSpecialBankAccountNumber = $("#prmSpecialBankAccountNumber_Input").val();
                        $.each(obj.numberObject, function () {
                            $(this).each(function () {
                                if (this.Bank_AccountNumber == getrowSpecialBankAccountNumber) {
                                    $("#rowChkA").attr("style", "display:block");
                                    $("#rowChkB").attr("style", "display:block");
                                    $("#rowChkC").attr("style", "display:none");
                                };
                                RowDetail = '<tr><td class="text-center">' + this.prmRERA_RegistrationNumber + '</td><td class="text-center">' + this.prmProject_DiaryNumber + '</td><td class="text-center">' + this.Bank_AccountNumber + '</td><td class="text-center">' + this.A_column + '</td><td class="text-center">' + this.Bank_Name + '</td><td class="text-center">' + this.Bank_IFSC_Code + '</td></tr>';
                                var rowCountTable = 0;
                                $.each($("#registrationdetailsTable tbody tr"), function () {
                                    rowCountTable = rowCountTable + 1;
                                    if ($(this).find('td:eq(0)').html() === 'No data available in table') {
                                        $(this).remove();
                                    };
                                    if ($(this).find('td:eq(0)').html() === 'No matching records found') {
                                        $(this).remove();
                                    };
                                    if ($(this).find('td:eq(0)').html() === 'undefined') {
                                        $(this).remove();
                                    };
                                });
                                detailsTableBody.append(RowDetail);
                            });
                        });
                    }
                    else {
                        alert('Special Bank Account Number Failed! Something went wrong');
                    }
                },
                error: function () {
                    stopPreloader();
                    alert("oops! Something went wrong")
                }
            });
        }

        $("#submitOrder").click(function (e) {
            e.preventDefault();
            var numberArr = [];
            numberArr.length = 0;
            var isAllValid = false;

            if ($('#prmSpecialBankAccountNumber_Input').val() != '' && $('#prmBankIFSCcode_Input').val() != '' && $('#prmSearchOption_Input').val() != '' && $('#prmPatternMatchBankAccountNumber_Input').val() != '') {
                var xpSpecialBankAccountNumber = $("#prmSpecialBankAccountNumber_Input").val(),
                    xpBankIFSCcode = $("#prmBankIFSCcode_Input").val(),
                    xpSearchOptionFlag = $("input[name='prmSearchOption_Input']:checked").val(),
                    xpPatternMatchBankAccountNumber = $("#prmPatternMatchBankAccountNumber_Input").val();

                if (xpPatternMatchBankAccountNumber != '') {
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Special Bank Account Number.');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pSpecialBankAccountNumber = $("#prmSpecialBankAccountNumber_Input").val(),
                    pBankIFSCcode = $("#prmBankIFSCcode_Input").val(),
                    pSearchOptionFlag = $("input[name='prmSearchOption_Input']:checked").val(),
                    pPatternMatchBankAccountNumber = $("#prmPatternMatchBankAccountNumber_Input").val();

                $("#rowChkA").attr("style", "display:block");
                $("#rowChkB").attr("style", "display:block");                
                $("#rowChkC").attr("style", "display:none");

                numberArr.push({
                    prmSpecialBankAccountNumber_Input: pSpecialBankAccountNumber,
                    prmBankIFSCcode_Input: pBankIFSCcode,
                    prmSearchOption_Input: pSearchOptionFlag,
                    prmPatternMatchBankAccountNumber_Input: pPatternMatchBankAccountNumber
                });

                var data = JSON.stringify({
                    numberobject: numberArr
                });

                $.when(submitOrder(data)).then(function (response) {
                    console.log(response);
                }).fail(function (err) {
                    console.log(err);
                });

                $("#submitOrder").addClass('sorder-disable');
                $("#submitOrder").prop('disabled', true);
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).fadeOut(1000, function () {
                $(projectDetailsModal).modal('hide');
            });
        });

        $("#resetOrder").click(function (e) {
            e.preventDefault();
            $("#registrationdetailsTable").find("tr:gt(0)").remove();
            $("#submitOrder").removeClass('sorder-disable');
            $("#submitOrder").prop('disabled', false);
        });

        $(document).on('click', '.radio-searchoptions', function (e) {
            if (this.value == '11') {
                var spanvalue = $.trim($(document).find("#prmSpecialBankAccountNumber_Input").val());
                $("#prmPatternMatchBankAccountNumber_Input").val(spanvalue);
            }
            else if (this.value == '99') {
                var spanvalue = $.trim($(document).find("#prmSpecialBankAccountNumber_Input").val());
                $("#prmPatternMatchBankAccountNumber_Input").val(spanvalue);
            }
            else if (this.value == '15') {
                var spanvalue = $.trim($(document).find("#prmSpecialBankAccountNumber_Input").val());
                if (spanvalue.length > 5) {
                    var firstFive = spanvalue.substr(0, 5);
                }
                $("#prmPatternMatchBankAccountNumber_Input").val(firstFive);
            }
            else if (this.value == '59') {
                var spanvalue = $.trim($(document).find("#prmSpecialBankAccountNumber_Input").val());
                if (spanvalue.length > 5) {
                    var lastFive = spanvalue.substr(spanvalue.length - 5);
                }
                $("#prmPatternMatchBankAccountNumber_Input").val(lastFive);
            }
            else if (this.value == '55') {
                var spanvalue = $.trim($(document).find("#prmSpecialBankAccountNumber_Input").val());
                $("#prmPatternMatchBankAccountNumber_Input").val(spanvalue);
            }
        });
    });
</script>
<script>
    $("#myform_NumberSPAN").validate({
        rules: {
            prmSpecialBankAccountNumber_Input: {
                required: true,                
                maxlength: 25,
                minlength: 5
            },
            prmBankIFSCcode_Input: {
                required: true,                
                maxlength: 25,
                minlength: 5
            },
            prmPatternMatchBankAccountNumber_Input: {
                required: true,
                maxlength: 25,
                minlength: 5
            }
        }
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">

            <div class="panel panel-info">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm(new { enctype = "multipart/form-data", id = "myform_NumberSPAN" }))
                            {
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label">(A.)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label mand">Bank Account Number</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        @Html.EditorFor(model => model.prmSpecialBankAccountNumber_Input, new { htmlAttributes = new { @class = "form-control bgdisabled-color" } })
                                                        @Html.ValidationMessageFor(model => model.prmSpecialBankAccountNumber_Input, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label">(B.)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label mand">Bank IFSC Code</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        @Html.EditorFor(model => model.prmBankIFSCcode_Input, new { htmlAttributes = new { @class = "form-control bgdisabled-color" } })
                                                        @Html.ValidationMessageFor(model => model.prmBankIFSCcode_Input, "", new { @class = "text-danger" })
                                                    </div>                                                    
                                                </div>
                                            </div>                                            
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label">(C.)</label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label mand">Search Option</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <label class="form-group">
                                                            @Html.RadioButtonFor(model => model.prmSearchOption_Input, "99", new { @id = "chkNumberCustom", @class = "radio-searchoptions", @checked = "checked" }) Custom Pattern<br />
                                                            @Html.RadioButtonFor(model => model.prmSearchOption_Input, "11", new { @id = "chkNumberBoth", @class = "radio-searchoptions" }) Match Both Account Number and IFSC Code<br />
                                                            @Html.RadioButtonFor(model => model.prmSearchOption_Input, "15", new { @id = "chkNumberF5Char", @class = "radio-searchoptions" }) Match First Five Number/Character(s)<br />
                                                            @Html.RadioButtonFor(model => model.prmSearchOption_Input, "59", new { @id = "chkNumberL5Char", @class = "radio-searchoptions" }) Match Last Five Number/Character(s)<br />
                                                            @Html.RadioButtonFor(model => model.prmSearchOption_Input, "55", new { @id = "chkNumberCustomNA", @class = "radio-searchoptions" }) Match with Application(s) for Registration                                                                                                                   
                                                        </label>
                                                        @Html.ValidationMessageFor(model => model.prmSearchOption_Input, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-1">
                                                        <label class="control-label"></label>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="control-label mand">Selected Pattern Number</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        @Html.EditorFor(model => model.prmPatternMatchBankAccountNumber_Input, new { htmlAttributes = new { @class = "form-control bgdisplay-color" } })
                                                        @Html.ValidationMessageFor(model => model.prmPatternMatchBankAccountNumber_Input, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-lg-12 text-right">                                            
                                            <button type="button" id="submitOrder" class="btn btn-primary"><i class="fa fa-cog"></i> Verify Number</button>
                                            <button type="button" id="resetOrder" class="btn btn-primary"><i class="fa fa-cog"></i> Reset</button>
                                            <button type="button" id="cancelOrder" class="btn btn-primary"><i class="fa fa-refresh"></i> Cancel</button>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row" id="rowChkA" style="display:none;">                                    
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <div class="alert alert-success alert-dismissable">
                                                <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                                                <strong>Special Bank Account Alert:</strong> Invalid! Already Registered Special Bank Account Number!
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" id="rowChkB" style="display:none;">
                                    <div class="col-lg-12"> 
                                        <a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>                                       
                                        Details of Similar Special Bank Account Number(s) <i class="fa fa-angle-double-right"></i>
                                        <table id="registrationdetailsTable" class="table table-striped table-bordered" style="width:100%;">
                                            <thead>
                                                <tr>
                                                    <th class="text-center">@Html.DisplayName("RERA Number")</th>
                                                    <th class="text-center">@Html.DisplayName("Diary Number")</th>
                                                    <th class="text-center">@Html.DisplayName("Bank Account Number")</th>                                                    
                                                    <th class="text-center">@Html.DisplayName("Account Holder Name")</th>
                                                    <th class="text-center">@Html.DisplayName("Bank Name")</th>
                                                    <th class="text-center">@Html.DisplayName("Bank IFSC Code")</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="row" id="rowChkC">
                                    <div class="form-group">
                                        <div class="col-md-12 disclaimer-text">
                                            Disclaimer: The verification of the special bank account number provided herein is based on the information supplied by promoter and verified by authority on the Authority's web-portal.
                                        </div>
                                    </div>
                                </div>
                           }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                </div>
            </div>
            <!-- /.row (panel) -->
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}