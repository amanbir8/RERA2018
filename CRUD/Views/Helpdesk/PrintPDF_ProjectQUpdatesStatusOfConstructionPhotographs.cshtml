@model CRUD.Models.HelpDesk.ClsPrp_PrintPDF_QUpdatesProjectStatusConstructionPhotographs

@{
    Layout = null;
}
<!-- /.wrapper -->

<style>
    img.statusphotographs {
        height: auto;
        max-width: 100%;
        /*display: flex;
        align-items: center;
        justify-content: center;*/        
    }

    .rpt-pdf-display-font-bold {
        font-weight: bold;
    }

    .rpt-pdf-display-font-italic-bold {
        font-weight: bold;
        font-style: italic;
    }

    .rpt-pdf-display-border-box {
        padding: 9px;
        border: 1px solid #4CAF50;
        text-align: justify;
        font-size: 15px;
    }

    .rpt-pdf-display-border-inner-box-shadow {
        padding: 6px;
        font-size: 14px;
        background-color: lightgrey;
        font-style: italic;
    }

    .rpt-pdf-display-border-top-box {
        padding: 9px 9px 9px 9px;
        font-size: 15px;
        background-color: lightgrey;
    }

    .rpt-pdf-display-border-title-box {
        padding: 9px 9px 9px 9px;
        border: 1px solid #ccc;
        font-weight: bold;
        font-size: 15px;
        /*border-bottom: 1px solid #ddd;*/
    }

    .rpt-pdf-display-norecordsfound {
        font-style: italic;
        font-size: medium;
        border: 1px solid #ccc;
    }
</style>


<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <table cellpadding="5" cellspacing="0" style="font-size: 11pt;width:100%;border-spacing: 1.5em;">
                @if (Model.prpQUProjectDiaryNumberDetails != null)
                {
                    if (Model.prpQUProjectDiaryNumberDetails.Count > 0)
                    {
                        foreach (var item in Model.prpQUProjectDiaryNumberDetails)
                        {
                            var varDate = System.DateTime.Now.Date;
                            <tr>
                                <td colspan="2" style="text-align:left;">@Html.DisplayName("Real Estate Regulatory Authority, Punjab")</td>
                                <td colspan="2" style="text-align:right;">@Html.DisplayName(String.Format("{0:D}", varDate))</td>
                            </tr>
                            <tr><td colspan="4" style="border: 1px solid #ccc"><b>@Html.DisplayName("Quarterly Update Details of Registered Real Estate Project (Status of Construction/Photographs)")</b></td></tr>
                            <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                            <tr>
                                <td width="25%">@Html.DisplayName("Diary Number")</td>
                                <td colspan="3">
                                    @Html.DisplayFor(modelitem => item.QUpdateProject_RegDiaryNumber_Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.DisplayName(" of ")
                                    @Html.DisplayFor(modelitem => item.zipProject_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } })
                                </td>                                                                
                            </tr>
                            <tr>
                                <td width="25%">@Html.DisplayName("Quarterly Updates/Year")</td>
                                <td colspan="3">
                                    @Html.DisplayFor(modelitem => item.QUpdateProject_QuarterName, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.DisplayName(" of ")
                                    @Html.DisplayFor(modelitem => item.QUpdateProject_Year, new { htmlAttributes = new { @class = "form-control" } })
                                </td>                                
                            </tr>
                            <tr>
                                <td>@Html.LabelFor(modelitem => item.zipProjectName, htmlAttributes: new { @class = "control-label" })</td>
                                <td>@Html.DisplayFor(modelitem => item.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })</td>
                                <td colspan="2">
                                    @Html.DisplayName("District :")
                                    @Html.DisplayFor(modelitem => item.zipProjectDistrictName, new { htmlAttributes = new { @class = "form-control" } })
                                </td>
                            </tr>
                            <tr>
                                <td>@Html.LabelFor(modelitem => item.zipPromoterName, htmlAttributes: new { @class = "control-label" })</td>
                                <td colspan="3">@Html.DisplayFor(modelitem => item.zipPromoterName, new { htmlAttributes = new { @class = "form-control" } })</td>                            
                            </tr>
                            <tr>
                                <td>@Html.DisplayName("Registration Number")</td>
                                <td colspan="3">@Html.DisplayFor(modelitem => item.RERAnumber, new { htmlAttributes = new { @class = "form-control" } })</td>                                
                            </tr>
                            <tr>
                                <td></td>
                                <td colspan="3">
                                    @Html.DisplayName("(Issue Date :")
                                    @Html.DisplayFor(modelitem => item.RERAnumberIssueDate, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.DisplayName("and Valid Upto Date :")
                                    @Html.DisplayFor(modelitem => item.RERAnumberValidUptoDate, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.DisplayName(")")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">Error! Try Again.</td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }                
                <tr><td colspan="4"><h4>@Html.DisplayName("Quarterly Updates: Status of Construction with Photograph(s) Details")</h4></td></tr>
                @{
                    int snoFF = 0;
                    int snoSF = 0;
                }
                @if (Model.prpongoing != null)
                {
                    if (Model.prpongoing.Count > 0)
                    {
                        <tr><td colspan="4" class="rpt-pdf-display-font-bold rpt-pdf-display-border-top-box">@Html.DisplayName("(A) Building/ Tower/ Block (Status of Construction)")</td></tr>
                        foreach (var item in Model.prpongoing)
                        {
                            if (item.BuildingTowerBlock_ComArea_ConStatusCode.ToString() == "2")
                            {
                                {
                                    snoFF = snoFF + 1;
                                }
                                <tr><td colspan="4" class="rpt-pdf-display-font-italic-bold">@Html.DisplayName("(" + snoFF.ToString() + ") ")@Html.DisplayFor(modelitem => item.Photographs_Title, new { htmlAttributes = new { @class = "form - control" } })</td></tr>
                                <tr>
                                    <td colspan="2" class="rpt-pdf-display-border-box">@Html.LabelFor(modelitem => item.BuildingTowerBlock_InfoCode, htmlAttributes: new { @class = "control-label" })</td>
                                    <td class="rpt-pdf-display-font-bold rpt-pdf-display-border-box">@Html.DisplayFor(modelitem => item.BuildingTowerBlock_InfoName, new { htmlAttributes = new { @class = "form-control" } })</td>
                                    <td class="rpt-pdf-display-border-box">@Html.DisplayFor(modelitem => item.BuildingTowerBlock_Type, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="rpt-pdf-display-border-box">
                                        <span class="rpt-pdf-display-border-inner-box-shadow">
                                            @Html.LabelFor(modelitem => item.Photographs_Status, htmlAttributes: new { @class = "control-label" })
                                        </span>:
                                        &nbsp;
                                        @Html.DisplayFor(modelitem => item.Photographs_Status, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>                             
                                <tr>
                                    <td colspan="4">
                                        @{
                                            var StrPathImg1 = item.Photographs_FilePath;
                                            var StrPathImg2 = item.Photographs_FileName;
                                            var StrPathImg = StrPathImg1;
                                        }
                                        <itext creationdate="@DateTime.Now.ToString()" producer="RazorPDF">
                                            <img class="statusphotographs rpt-pdf-display-border-box" style="border:1px solid;" src="@Context.Server.MapPath("~/" + StrPathImg)" />
                                        </itext>
                                    </td>
                                </tr>
                                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                            }

                        }
                        <tr><td colspan="4" class="rpt-pdf-display-font-bold rpt-pdf-display-border-top-box">@Html.DisplayName("(B) Internal Infrastructure and Common Areas")</td></tr>
                        foreach (var item in Model.prpongoing)
                        {
                            if (item.BuildingTowerBlock_ComArea_ConStatusCode.ToString() == "3")
                            {
                                {
                                    snoSF = snoSF + 1;
                                }
                                <tr><td colspan="4" class="rpt-pdf-display-font-italic-bold">@Html.DisplayName("(" + snoSF.ToString() + ") ")@Html.DisplayFor(modelitem => item.Photographs_Title, new { htmlAttributes = new { @class = "form - control" } })</td></tr>
                                <tr>
                                    <td colspan="2" class="rpt-pdf-display-border-box">@Html.DisplayName("Type of Internal Infrastructure and Common Areas")</td>
                                    <td colspan="2" class="rpt-pdf-display-font-bold rpt-pdf-display-border-box">@Html.DisplayFor(modelitem => item.BuildingTowerBlock_Type, new { htmlAttributes = new { @class = "form-control" } })</td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="rpt-pdf-display-border-box">
                                        <span class="rpt-pdf-display-border-inner-box-shadow">
                                            @Html.LabelFor(modelitem => item.Photographs_Status, htmlAttributes: new { @class = "control-label" })
                                        </span>:
                                        &nbsp;                                    
                                        @Html.DisplayFor(modelitem => item.Photographs_Status, new { htmlAttributes = new { @class = "form-control" } })
                                    </td>
                                </tr>                                
                                <tr>
                                    <td colspan="4">
                                        @{
                                            var StrPathImg1 = item.Photographs_FilePath;
                                            var StrPathImg2 = item.Photographs_FileName;
                                            var StrPathImg = StrPathImg1;
                                        }
                                        <itext creationdate="@DateTime.Now.ToString()" producer="RazorPDF">
                                            <img class="statusphotographs rpt-pdf-display-border-box" style="border:1px solid;" src="@Context.Server.MapPath("~/" + StrPathImg)" />
                                        </itext>
                                    </td>
                                </tr>                                
                                <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                            }

                        }
                        <tr><td colspan="4" style="text-align:center; font-style: italic; font-size:medium;">This is a computer-generated document. No signature is required.</td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4" style="font-style: italic; font-size:small; border: 1px solid #ccc">Note: The aforementioned data constitutes the quarterly update details for the registered real estate project which was uploaded or published on the webpage by the promoter, and also promoter declared that the particulars given herein are correct and nothing material has been concealed. No liability of the authority can be derived therefrom.</td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        
                    }
                    else
                    {
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                        <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">Error! Try Again.</td></tr>
                        <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                    <tr><td colspan="4" style="font-style: italic; font-size:medium; border: 1px solid #ccc">No Record(s) Found.</td></tr>
                    <tr><td colspan="4" style="font-style: italic;"><br /><br /></td></tr>
                }
            </table>
        </div>

        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
</div>
<!-- /.wrapper -->