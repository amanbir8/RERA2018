<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');
            parmProjectId = parseInt(parmProjectId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonExpandDocument', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmdocID = $(this).attr('data-document-code');
            var parmdocSubID = $(this).attr('data-subdocument-code');
            var parmdocFlag = $(this).attr('data-document-flag');
            parmProjectId = parseInt(parmProjectId);
            parmdocID = parseInt(parmdocID);
            parmdocSubID = parseInt(parmdocSubID);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $("#zipProject_DiaryNumber").val();
            var varProjectName = $("#zipProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoDocumentDisplayByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmdocID': parmdocID, 'parmdocSubID': parmdocSubID, 'parmdocFlag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Document Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-doclist-details", lockUnlockHandlerDoclist);

        $(document).on("click", "a.lock-doc-details", lockUnlockHandlerDocument);

        //Lock-Unlock-Loader-Handler (Documents list Details)
        var parmLockUnlockdoclist = $.trim($(document).find('#IsDraftAllDocuments').val());
        if (parmLockUnlockdoclist == 1) { //L        
            $("#btnLockdoclistDetails").prop('disabled', false);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockdoclistDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Unlock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockdoclist == 5) { //UL         
            $("#btnLockdoclistDetails").prop('disabled', false);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockdoclistDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Lock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockdoclist == 6) { //PL         
            $("#btnLockdoclistDetails").prop('disabled', true);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Unlock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockdoclistDetails").prop('disabled', true);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Lock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }       
    });

    function lockUnlockHandlerDoclist() {
        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftAllDocuments').val());
            var parmPromoterID = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectDocumentList',
                data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmPromoterID': parmPromoterID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockdoclistDetails").attr("title", "Unlock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockdoclistDetails").attr("title", "Lock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
    function lockUnlockHandlerDocument() {
        var elem = $(this);
        var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());        
        var parmPromoterID = $.trim($(document).find('#zipRelated_Promoter_ID').val());
        var parmLockUnlockdoc = $(this).attr('data-locknnlockdoc-code');
        var parmDocindex = $(this).attr('data-docindex-code');

        if (parmLockUnlockdoc == 1 || parmLockUnlockdoc == 5) {

            var btnLabel = $(this).attr("title");
            var cnfrmTxt = "Do you want to lock details?";
            if (btnLabel == "Unlock Details") {
                var cnfrmTxt = "Do you want to unlock details?";
            }

            if (confirm(cnfrmTxt)) {              
                var baseUrllockunlock = $('body').attr('data-base-url');

                $.ajax({
                    type: 'GET',
                    url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectDocumentByIndex',
                    data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlockdoc, 'parmPromoterID': parmPromoterID, 'parmDocIndex': parmDocindex },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        alert(data.status);                        
                        if (data.statusCode == 101) {
                            elem.find("span").removeClass("btn-warning").addClass("btn-primary");
                            elem.attr("title", "Unlock Details");
                            elem.find("i").removeClass("fa-unlock").addClass("fa-key");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        } else if (data.statusCode == 105) {
                            elem.find("span").removeClass("btn-primary").addClass("btn-warning");
                            elem.attr("title", "Lock Details");
                            elem.find("i").removeClass("fa-key").addClass("fa-unlock");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        }
                    },
                    failure: function (data) {
                        alert('Bad Request! Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Error');
                    }
                });
            }
        }
        else {
            $(this).preventDefault();
        }
    }
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('.btn-toggle').on('click', function (e) {
            e.preventDefault();
            var elem = $(this);

            var parentRow = $(elem).parents('tr');
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            var projectdocindexId = $.trim($(parentRow).find('input.hdnProjectDocIndexID').val());
            var projectdocId = $.trim($(parentRow).find('input.hdnProjectDocumentID').val());
            var prmFlag = $.trim($(parentRow).find('input.hdnPrmFlag').val());
            var prmPublicUnpublic = $(elem).hasClass('active');
            var elemid = $(elem).attr('id');

            projectId = parseInt(projectId);
            projectdocindexId = parseInt(projectdocindexId);
            projectdocId = parseInt(projectdocId);

            var varcnfrm = 0;
            var cnfrmTxt = "Do you want to modify the public view (webpage) options?";
            if (confirm(cnfrmTxt)) {
                // Save it!
                varcnfrm = 1;
                if ($(this).attr('data-toggle') == 'button') {
                    $.ajax({
                        type: 'GET',
                        url: BASE_URL + 'Helpdesk/PublicUnpublicHandler_ProjectDocumentByIndex',
                        data: { 'prmprojectId': projectId, 'prmprojectdocindexId': projectdocindexId, 'prmprojectdocId': projectdocId, 'prmPublicUnpublic': prmPublicUnpublic },
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            alert(data.status);
                            if (data.statusCode == 101 || data.statusCode == 105) {
                                setactionPublicViewTogglebtnYN(data.statusCode, elemid);
                            } else {
                                setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                            }
                        },
                        failure: function (data) {
                            alert('Bad Request! Failed');
                            setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                        },
                        error: function (err) {
                            alert('Bad Request! Error');
                            setdefaultPublicViewTogglebtnYN(prmFlag, elemid);
                        }
                    });
                }
            } 
            if (varcnfrm != 1) {
                disablePublicViewTogglebtnYN(elemid);
            }
        });

        $(document).on('click', 'a.modalOpenerButtonTrashDetails', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmPromoterID = $.trim($(document).find('#zipRelated_Promoter_ID').val());
            var parmdocFlag = 0;
            parmProjectId = parseInt(parmProjectId);
            parmPromoterID = parseInt(parmPromoterID);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $.trim($(document).find('#zipProject_DiaryNumber').val());
            var varProjectName = $.trim($(document).find('#zipProjectName').val());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');

            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectInfoTrashDocumentDisplayByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmPromoterID': parmPromoterID, 'parmdocFlag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });

            $(projectDetailsModal).find('h4.modal-title').html('Trash Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });

    function setdefaultPublicViewTogglebtnYN(dataString, srID) {
        var dataAction = dataString;
        var varPublicViewFlag = 0;
        if (dataAction != 'NPV') {
            //YPV(1) NPV(0)
            varPublicViewFlag = 1;
        };
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        switch (varPublicViewFlag) {
            case 0:
                $(document).find(valpublicviewShowId.trim()).removeClass('active');
                break;
            case 1:
                $(document).find(valpublicviewShowId.trim()).addClass('active');
                break;
        }
    }
    function setactionPublicViewTogglebtnYN(dataID, srID) {
        var dataAction = dataID;
        var varPublicViewFlag = 0;
        if (dataAction == 101) {
            //YPV(1) NPV(0)
            varPublicViewFlag = 1;
        };
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        var len = valpublicviewShowId.toString().trim().length;
        var res = valpublicviewShowId.substring(20, len);
        var strpvstatus = '#publicviewtogglestatus';
        var valpublicviewstatusShowId = strpvstatus.concat(res);
        switch (varPublicViewFlag) {
            case 0:
                $(document).find(valpublicviewShowId.trim()).removeClass('active');
                $(document).find(valpublicviewstatusShowId.trim()).text('Not Applicable');
                break;
            case 1:
                $(document).find(valpublicviewShowId.trim()).addClass('active');
                $(document).find(valpublicviewstatusShowId.trim()).text('Yes');
                break;
        }
    }
    function disablePublicViewTogglebtnYN(srID) {
        var srtitle = '#';
        var valpublicviewShowId = srtitle.concat(srID);
        $(document).find(valpublicviewShowId.trim()).prop('disabled', true);
        $(document).find(valpublicviewShowId.trim()).addClass("disabledlockunlock");        
    }
</script>

