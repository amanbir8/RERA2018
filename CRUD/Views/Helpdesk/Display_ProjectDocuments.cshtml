    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Project Detail / Project Land / Project Approvals Document(s) Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">

                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Project /Application - ( @Html.DisplayFor(model => model.zipProject_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zipProjectName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5">
                                                        @Html.DisplayFor(model => model.zipProjectName, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.HiddenFor(model => model.zipProjectName)
                                                        @Html.HiddenFor(model => model.zipProject_DiaryNumber)
                                                        @Html.HiddenFor(model => model.zipRelated_Project_ID)
                                                        @Html.HiddenFor(model => model.IsDraftAllDocuments)
                                                        @Html.HiddenFor(model => model.zipRelated_Promoter_ID)
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zipProjectLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zipProjectLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskNavMenuPartial")  

                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;">
                                        <a data-criteria-code="158" class="modalOpenerButton" href="javascript:void(0);" title="Add Remarks (If Any)"><i class="fa fa-list-ul fa-fw"></i> </a>Project/ Land/ Approvals Documents Details
                                        <span class="pull-right">
                                            <a class="modalOpenerButtonTrashDetails" href="javascript:void(0);" title="View Trash"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-shopping-basket" aria-hidden="true"></i></span></a>
                                            <a class="modalOpenerButtonExpandChecklist" data-criteria-code="158" data-subcriteria-code="0" data-criteria-flag="1" href="javascript:void(0);" title="View Checklist"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-check-square-o" aria-hidden="true"></i></span></a>
                                            <a class="modalOpenerButtonExpandDocument" data-document-code="158" data-subdocument-code="0" data-document-flag="1" href="javascript:void(0);" title="View Documents"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-text" aria-hidden="true"></i></span></a>
                                            <a class="a lock-doclist-details" id="btnLockdoclistDetails" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                        </span>
                                    </h4>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("Sr No")</th>
                                            <th style="width:10%" align="justify">@Html.DisplayName("Activity")</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectDoc_InfoCode)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.ProjectDoc_ReferenceNumber)</th>
                                            <th style="width:20%" align="justify">
                                                @*@Html.DisplayNameFor(model => model.ProjectDoc_IssueDate)*@
                                                @Html.DisplayName("Reference/ Issue/ Upload Date")
                                            </th>
                                            <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                                            <th>@Html.DisplayName("Is acceptable for web-page?")</th>
                                            <th>@Html.DisplayName("Public View")</th>                                                                                        
                                            <th>@Html.DisplayName("View")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                            string publicviewtogglebtnID = string.Empty;
                                            string publicviewtogglestatusID = string.Empty;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                                publicviewtogglebtnID = "publicviewtogglebtn" + @sno.ToString();
                                                publicviewtogglestatusID = "publicviewtogglestatus" + @sno.ToString();
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td style="width:8%" align="center">
                                                    <span>
                                                        <a class="modalOpenerButtonExpandChecklist" data-criteria-code="@Html.DisplayFor(modelItem => item.A_column)" data-subcriteria-code="0" data-criteria-flag="1" href="javascript:void(0);" title="View Checklist"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-check-square-o" aria-hidden="true"></i></span></a>
                                                        @if (item.IsDraft == 1)
                                                        { //L
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ProjectDoc_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                        }
                                                        else if (item.IsDraft == 5)
                                                        { //UL
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ProjectDoc_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                        }
                                                        else if (item.IsDraft == 6)
                                                        { //PL
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ProjectDoc_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs disabledlockunlock"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.ProjectDoc_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs disabledlockunlock"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                        }                                                        
                                                    </span>
                                                </td>
                                                <td style="width:32%;">@Html.DisplayFor(modelItem => item.ProjectDoc_InfoName)</td>                                                
                                                <td style="width:20%;">@Html.DisplayFor(modelItem => item.ProjectDoc_ReferenceNumber)</td>
                                                <td style="width:16%" align="center">
                                                    @Html.DisplayFor(modelItem => item.ProjectDoc_IssueDate)                                                    
                                                    @Html.HiddenFor(modelItem => item.Project_ID, new { @class = "hdnProjectID" })
                                                    @Html.HiddenFor(modelItem => item.ProjectDoc_IndexID, new { @class = "hdnProjectDocIndexID" })
                                                    @Html.HiddenFor(modelItem => item.ProjectDoc_ID, new { @class = "hdnProjectDocumentID" })
                                                    @Html.HiddenFor(modelItem => item.B_column, new { @class = "hdnPrmFlag" })
                                                    @Html.HiddenFor(modelItem => item.Promoter_ID)
                                                </td>
                                                <td style="width:20%;">                                                    
                                                    @Html.DisplayFor(modelItem => item.Remarks_IfAny)
                                                </td>
                                                <td>
                                                    <spsn id=@publicviewtogglestatusID.ToString()>
                                                        @if (item.B_column == "NPV")
                                                        {
                                                            @Html.DisplayName("Not Applicable")
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("Yes")
                                                        }
                                                    </spsn>                                                    
                                                </td>
                                                <td class="row-publicview">
                                                    <script type="text/javascript">
                                                        $(document).ready(function () {
                                                            showPublicViewTogglebtnYN("@item.B_column.ToString()", "@sno.ToString()");
                                                        });
                                                    </script>                                                    
                                                    <button type="button" id=@publicviewtogglebtnID.ToString() class="btn btn-sm btn-toggle btn-secondary" data-toggle="button" aria-pressed="false" autocomplete="off">
                                                        <div class="handle"></div>
                                                    </button>
                                                </td>                                                
                                                <td align="center">
                                                    <a href="~/@Html.DisplayFor(modelItem => item.ProjectDoc_FilePath)" target="_blank" title="View Document"><i class="fa fa-external-link-square"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

