<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandPromoterProjectContent', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipExtensionFormRelated_Project_ID').val());
            var parmExtnFormID = $.trim($(document).find('#FormE_IndexID').val());
            var parmPromoterID = 0;

            parmProjectId = parseInt(parmProjectId);
            parmExtnFormID = parseInt(parmExtnFormID);
            parmPromoterID = parseInt(parmPromoterID);

            var varDNumber = $("#zipExtensionFormProject_DiaryNumber").val();
            var varProjectName = $("#zipExtensionFormProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectExtensionInfoPromoterProjectFeeDetails',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmPromoterID': parmPromoterID, 'parmExtnFormID': parmExtnFormID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Project Details: <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varProjectName + ' (Ref: ' + varDNumber + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();            
            var elem = $(this);            
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            
            var parmProjectId = $.trim($(document).find('#zipExtensionFormRelated_Project_ID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');
            parmProjectId = parseInt(parmProjectId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);
            
            var varDNumber = $("#zipExtensionFormProject_DiaryNumber").val();
            var varProjectName = $("#zipExtensionFormProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectFormExtensionInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonExpandDocument', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');

            var parmProjectId = $.trim($(document).find('#zipExtensionFormRelated_Project_ID').val());
            var parmdocID = $(this).attr('data-document-code');
            var parmdocSubID = $(this).attr('data-subdocument-code');
            var parmdocFlag = $(this).attr('data-document-flag');
            parmProjectId = parseInt(parmProjectId);
            parmdocID = parseInt(parmdocID);
            parmdocSubID = parseInt(parmdocSubID);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = $("#zipExtensionFormProject_DiaryNumber").val();
            var varProjectName = $("#zipExtensionFormProjectName").val();
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectFormExtensionInfoDocumentDisplayByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmProjectId': parmProjectId, 'parmdocID': parmdocID, 'parmdocSubID': parmdocSubID, 'parmdocFlag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('Document Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-acc-details", lockUnclockHandler);

        //Lock-Unlock-Loader-Handler
        var parmLockUnlock = $.trim($(document).find('#IsDraft').val());
        if (parmLockUnlock == 1) { //L        
            $("#btnLockAccDetails").prop('disabled', false);
            $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAccDetails").find("span").removeClass("disabledlockunlock");            
            $("#btnLockAccDetails").attr("title", "Unlock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlock == 5) { //UL         
            $("#btnLockAccDetails").prop('disabled', false);
            $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAccDetails").find("span").removeClass("disabledlockunlock");            
            $("#btnLockAccDetails").attr("title", "Lock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlock == 6) { //PL         
            $("#btnLockAccDetails").prop('disabled', true);
            $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Unlock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockAccDetails").prop('disabled', true);
            $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAccDetails").attr("title", "Lock Details");
            $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }        
    });

    function lockUnclockHandler() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }
       
        if (confirm(cnfrmTxt)) {

            //if (btnLabel == "Lock Details") {
            //    $(this).attr("title", "Unlock Details");
            //} else {
            //    $(this).attr("title", "Lock Details");
            //}
            //$(this).find("i").toggleClass("fa-unlock fa-key");

            var parmProjectId = $.trim($(document).find('#zipRelated_Project_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraft').val());
            var parmIndexID = $.trim($(document).find('#SpecialBankAccount_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');            
            
            $.ajax({
                type: 'GET',                
                url: baseUrllockunlock + 'Helpdesk/LockUnlockHandler_ProjectSpecialBankAccount',
                data: { 'parmProjectId': parmProjectId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockAccDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockAccDetails").attr("title", "Unlock Details");
                        $("#btnLockAccDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockAccDetails").prop('disabled', true);
                        $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockAccDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockAccDetails").attr("title", "Lock Details");
                        $("#btnLockAccDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockAccDetails").prop('disabled', true);
                        $("#btnLockAccDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

