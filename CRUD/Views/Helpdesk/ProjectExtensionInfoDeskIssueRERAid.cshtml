@model CRUD.Models.HelpDesk.ClsPrp_ExtensionAuthorityDesk_ProjectExtnFormRegistrationNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [9, 10]
            }]
        });

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = $.trim($(parentRow).find('input.hdnProjectID').val());
            projectId = parseInt(projectId);
            $.ajax({
                url: BASE_URL + 'Helpdesk/ProjectExtensionInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.project-diary-number').attr('data-diary-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'Helpdesk/ExtensionProjectsIssueRegistrationNumber_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerExtensionFormdetails);
    });

    function infohelpHandlerExtensionFormdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:yellow"></i> Pending registration number (project) and extension of registration upto date.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> RERA registered project (extension of registration).',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Projects : Extension of Registration of Project(s) [RERA Number] Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Projects: Extension of Registration of Project(s) [RERA Number] Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.RelatedExtnRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Promoter_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Project_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("RERA Number")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Extension of Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("Select Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                                <tr class="odd gradeX">
                                                    <td>@Html.DisplayName(sno.ToString())</td>
                                                    <td class="project-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.RelatedExtnRegDiaryNumber_Name)">
                                                        @Html.DisplayFor(modelItem => item.RelatedExtnRegDiaryNumber_Name)
                                                        @Html.DisplayName(" of ")
                                                        @Html.DisplayFor(modelItem => item.RelatedProjectRegDiaryNumber_Name)
                                                    </td>
                                                    <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.Project_Name)">@Html.DisplayFor(modelItem => item.Project_Name)</td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Promoter_Name)
                                                        @Html.HiddenFor(modelItem => item.RelatedProject_ID, new { @class = "hdnProjectID" })
                                                        @Html.HiddenFor(modelItem => item.RelatedPromoter_ID)
                                                    </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Project_AddressDistrictName)</td>
                                                    @if (item.EventAction_Type.ToString() == "150017")
                                                    {                                                        
                                                        <td class="warning" title="Pending extension of registration (project) valid upto date.">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                        <td class="warning" title="Pending extension of registration (project) valid upto date.">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                        <td class="warning" title="Pending extension of registration (project) valid upto date.">@Html.DisplayName("--")</td>
                                                    }
                                                    else
                                                    {                                                       
                                                        <td class="success" title="RERA registered project (extension of registration)">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                        <td class="success" title="RERA registered project (extension of registration)">@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                        <td class="success" title="RERA registered project (extension of registration)">@Html.DisplayFor(modelItem => item.ExtnRegistrationRegUptoDate)</td>
                                                    }
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                    <td class="center">
                                                        <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                    </td>                                                
                                                    <td class="center">
                                                        @Html.ActionLink("Select", "ProjectExtensionRERAnumberInfoEventInsertAction", new { EnPDNumber = item.RelatedProjectRegDiaryNumber_Name, EnFrmDNumber=item.RelatedExtnRegDiaryNumber_Name, EnPName = item.Project_Name, EnPID = item.RelatedProject_ID, EnLMO = item.EventAction_IdentifiedOn, EnPrmID = item.RelatedPromoter_ID, EnPRefNumber = item.RERAnumberRegistration })
                                                    </td>                                                    
                                                </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
