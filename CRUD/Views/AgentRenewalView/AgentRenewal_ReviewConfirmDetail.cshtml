                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-1">
                                                            @Html.DisplayName(sno_RnAgent.ToString())
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.ActionLink("Registration Fee/Payment Detail", "AgentRenewal_IO_ApplicationPayment", "AgentRenewal")
                                                        </div>
                                                        @if (TempData["statusFlag_FeePayment"].ToString() == "Complete")
                                                        {
                                                            if (Convert.ToString(TempData["submitvalueFlag_FeePayment"]) != "Confirmed")
                                                            {
                                                                <div class="col-md-3 alert-warning">
                                                                    @TempData["status_FeePayment"]<br />
                                                                    @TempData["message_FeePayment"]
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="col-md-3 alert-success">
                                                                    @TempData["status_FeePayment"]
                                                                    @if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                                    {
                                                                        <a href="@Url.Action("Print_AgentRenewal_FeePaymentDetail","AgentPrintForm")" target="_blank">
                                                                            <img src="~/images/pdf.png" alt="Print" height="25" width="25" />
                                                                        </a>
                                                                    }
                                                                    <br />
                                                                    @TempData["message_FeePayment"]
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="col-md-3 alert-danger">
                                                                @TempData["status_FeePayment"]<br />
                                                                @TempData["message_FeePayment"]
                                                            </div>
                                                        }
                                                        <div class="col-md-3">
                                                            @if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                            {
                                                                <input type="submit" value="@TempData["submitvalue_FeePayment"]" formaction="ReviewConfirmRnAgent_FeePayment" class="btn btn-default" disabled="disabled" />
                                                            }
                                                            else
                                                            {
                                                                <input type="submit" value="@TempData["submitvalue_FeePayment"]" formaction="ReviewConfirmRnAgent_FeePayment" class="btn btn-default" />
                                                            }

                                                        </div>

                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Disclaimer</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12 text-justify">
                                                            <label class="control-label">                                                                                                                               
                                                                Disclaimer: @Html.CheckBox("Is_YesNoAgree_RenewalPermission_Flag", true) [I / We] solemnly affirm and declare that the particulars given herein are correct to [my/our] knowledge and belief and nothing material has been concealed by [me/us] therefrom.
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12 text-left">
                                                            @if (Convert.ToInt32(TempData["RnAgent_IsdraftValue"]) == 1)
                                                            {
                                                                <input type="submit" value="I Agree" id="BtnApplicationMainform" class="btn btn-primary" formaction="BtnRnAgent_SubmitAgree" disabled="disabled" />

                                                            }
                                                            else
                                                            {
                                                                if (TempData["RnAgentAgree"].ToString() == "Done")
                                                                {
                                                                    <input type="submit" value="I Agree" id="BtnApplicationMainform" class="btn btn-primary" formaction="BtnRnAgent_SubmitAgree" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="submit" value="I Agree" id="BtnApplicationMainform" class="btn btn-primary" formaction="BtnRnAgent_SubmitAgree" disabled="disabled" />
                                                                }
                                                            }
                                                            <div>
                                                                @if (TempData["RenewalAgent_RegDiaryNumber_Name"] != null)
                                                                {
                                                                    <b>  @TempData["RenewalAgent_RegDiaryNumber_Name"].ToString()</b>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
