</script> 
<script>
    $(document).ready(function () {
        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');
            switch (criteriaCode) {
                case '#accordionCircularNoticesdetails':
                    $("#btnAccordionCircularNotices").find("span").toggleClass("btn-outline");
                    $("#btnAccordionCircularNotices").find("i").toggleClass("fa-upload fa-times");
                    $("#btnAccordionCircularNotices").attr("title", function (index, attr) {
                        return attr == 'Cancel Uploads' ? 'Upload Circular & Public Notices' : 'Cancel Uploads';
                    });
                    break;
            }
        });

        var vareditmode = $('#CircularPublicNotice_IndexID').val();
        if (vareditmode != 0) {
            $("#collapseCircularNotices").removeClass("collapse");
        };

        var webbase_url = $('body').attr('data-base-url');
        $(document).on('click', 'a.panelOpenerList', function (e) {
            e.preventDefault();
            window.location = webbase_url + 'HelpdeskAdmin/WebindexInfoCircularPublicNoticesDetails';
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerCircularNotices);
    });

    function infohelpHandlerCircularNotices() {

        new PNotify({
            title: 'Help',
            text: '<b>Circular & Public Notices</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Add or upload Circular & Public Notices with reference to reference number and issue date details.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> During upload, please select category/ type of notices carefully with reference to circular/notice details.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

