@model CRUD.Models.HelpdeskAdmin.ClsPrp_AdminDesk_NoticeSectionFiveNineByLA_FileLogDetails
@{
    Layout = null;
}

<link rel="stylesheet" href="@Url.Content("~/css-validator/style.css")" />
<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script type="text/javascript">

    @if (TempData["EventSubmitMessage"].ToString() != "")
    {        
        <text>
            $(document).ready(function()
                {
                swal({
                title: "Message",
                    text: "@TempData["EventSubmitMessage"]",
                    type: "success"
                }, function () {
                    return true;
                });
            });
        </text>        
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#EventAction_Type').change(function () {

            var BASE_URLn = $('body').attr('data-base-url');

            $.ajax({
                type: "POST",
                url: BASE_URLn + 'HelpdeskAdmin/GetDeskEventDescriptionMasterByCode',
                datatype: "Json",
                data: { EventCode: $('#EventAction_Type').val() },
                success: function (data) {
                    $.each(data, function (index, value) {

                        $('#getCriteriaSubCodeFileInfo').show();
                        $('#CriteriaSubCodeFileDiscription').text("Description : " + value.DeskAction_Description);
                    });
                }
            });

            $('#EventAction_Aggregate').empty();
            $('#EventAction_Description').empty();
            $("input[name='EventAction_Aggregate']").val($("#EventAction_Type option:selected").text());
            $("input[name='EventAction_Description']").val($("#EventAction_Type option:selected").text());
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var managerModal = $(document).find('#myModal');
            $(managerModal).fadeOut(1000, function () {
                $(managerModal).modal('hide');
            });
        });
    });
</script>

<script>
    jQuery.validator.addMethod("alphanumericcc", function (value, element) {
        // return this.optional(element) || /^\w+(\s+\w+)*$/.test($.trim(value));
        return this.optional(element) || /^[a-zA-Z0-9 ,-.()/]*$/.test($.trim(value));
    }, "Special characters are not allowed. Maximum length is 1000");

    $("#myform_NoticeSecFiveNineInfoEventInsert").validate({
        rules: {
            Remarks_IfAny: {
                required: true,
                alphanumericcc: true
            },

            name: {
                required: true,
                alphanumericcc: true
            },

            email: {
                required: true,
                email: true
            },
            phone: {
                required: true,
                number: true
            },
        }
    });
</script>

<script>
   // get remaining words count for textarea
   var maxMessageLength = 1000;
   var messageField = $('#myform_NoticeSecFiveNineInfoEventInsert').find('textarea#Remarks_IfAny');
   $('body').on('input', 'textarea#Remarks_IfAny', function (e) {
       var msgVal = $(this).val();
       var msgValLen = msgVal.length;
       if (msgValLen <= maxMessageLength) {
           var remaining = parseInt(maxMessageLength - msgValLen);
           $(this).parents('.form-group').find('.words-remain').html(remaining + ' characters remaining');
       }
   });
</script>

<div id="wrapper">
