                                                            @Html.DisplayName("View")
                                                        </th>
                                                        <th align="center" width="9%">
                                                            @Html.DisplayName("Edit| Delete")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.prpOrderJudgementByAO)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.ApplicationNumber)
                                                            </td>
                                                            <td>
