                                                            @Html.HiddenFor(model => model.ViewJugdementAO_BaseUrl)
                                                            @Html.HiddenFor(model => model.ViewJugdementAO_FileType)
                                                        </div>
                                                        @*<div class="control-label col-md-3">
                                                            <img id="user_Photo" height="100" width="90" style="border:solid" src="~/readwritedata/@Html.DisplayFor(model => model.DocumentType_FilePath,   new { htmlAttributes = new { @class = "form-control" } })" />
                                                        </div>*@
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.ViewJugdementAO_FilePath)@Html.DisplayFor(model => model.ViewJugdementAO_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.ViewJugdementAO_FilePath)@Html.DisplayFor(model => model.ViewJugdementAO_FileName)" alt="No Image" />
                                                            </a>
                                                        </div> 
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
