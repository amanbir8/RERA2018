                                                                @Html.DisplayFor(modelItem => item.ApplicantName)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RespondentName)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Date_of_Decision)
                                                            </td>
