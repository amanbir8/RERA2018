                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Application or complaint number related to uplaoding order or judgement document.">
                                                            @Html.EditorFor(model => model.ApplicationNumber, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                            @Html.ValidationMessageFor(model => model.ApplicationNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Date_of_Decision, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.Date_of_Decision, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Date_of_Decision, "", new { @class = "text-danger" })
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ApplicantName, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Applicant or complainant name related to uplaoding order or judgement document.">
                                                            @Html.EditorFor(model => model.ApplicantName, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.ApplicantName, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">                                                            
                                                            @Html.LabelFor(model => model.RespondentName, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.RespondentName, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.RespondentName, "", new { @class = "text-danger" })
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Other Option(s)</legend>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <label class="control-label mand">Is Valid for Public View (Yes/No)?</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label>
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "1") Yes
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "0") No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsPublicView, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Upload Document</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">@Html.LabelFor(model => model.ViewJugdementAO_FileName, htmlAttributes: new { @class = "control-label mand" })</div>
                                                        @*<div class="col-md-3"><input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" /></div>*@
                                                        <div class="col-md-3">
                                                            <div class="input-group">
