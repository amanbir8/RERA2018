@model CRUD.Models.HelpdeskAdmin.ClsPrp_AdminDesk_SpotLight

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();           
        });

        $('[data-toggle="tooltip"]').tooltip();
    });
</script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        $('#SpotLight_IssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
    });
</script> 

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Spot-Light News Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Spot-Light News Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm())
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.SpotLight_IndexID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.SpotLight_ID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.SpotLight_LanguageFlag, htmlAttributes: new { @class = "control-label" })
                                    
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Spot-Light News Details</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">                                                            
                                                            @Html.LabelFor(model => model.SpotLight_ReferenceNumber, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Reference Number for ticker/spot light message, If any.">
                                                            @Html.EditorFor(model => model.SpotLight_ReferenceNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.SpotLight_ReferenceNumber, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.SpotLight_IssueDate, htmlAttributes: new { @class = "control-label mand" })                                                            
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.EditorFor(model => model.SpotLight_IssueDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.SpotLight_IssueDate, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @{var listItems3 = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                                    new SelectListItem {  Text = "Tender Notice" , Value="Tender Notice"  },
                                                                    new SelectListItem {  Text = "Recruitment Notice" , Value="Recruitment Notice"  },
                                                                    new SelectListItem {  Text = "Circular Notice" , Value="Circular Notice"  },
                                                                    new SelectListItem {  Text = "Public Notice" , Value="Public Notice"  },
                                                                };
                                                            }                                                            
                                                            @Html.LabelFor(model => model.SpotLight_Category, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Ticker or spot light message category.">
                                                            @Html.DropDownListFor(model => model.SpotLight_Category, new SelectList(listItems3, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.SpotLight_Category, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.SpotLight_Title, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Ticker or spot light message. (maximum content 150 words).">
                                                            @Html.EditorFor(model => model.SpotLight_Title, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.SpotLight_Title, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @{var listItems3punjabi = new List<SelectListItem>
                                                                {
                                                                    new SelectListItem {  Text = "..." , Value=""  },
                                                                    new SelectListItem {  Text = "ਟੈਂਡਰ ਨੋਟਿਸ" , Value="ਟੈਂਡਰ ਨੋਟਿਸ"  },
                                                                    new SelectListItem {  Text = "ਭਰਤੀ ਨੋਟਿਸ" , Value="ਭਰਤੀ ਨੋਟਿਸ"  },
                                                                    new SelectListItem {  Text = "ਸਰਕੂਲਰ ਨੋਟਿਸ" , Value="ਸਰਕੂਲਰ ਨੋਟਿਸ"  },
                                                                    new SelectListItem {  Text = "ਜਨਤਕ ਨੋਟਿਸ" , Value="ਜਨਤਕ ਨੋਟਿਸ"  },
                                                                };
                                                            }
                                                            @Html.LabelFor(model => model.CulturePunjabi_SpotLight_Category, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Ticker or spot light message category (in punjabi language).">
                                                            @Html.DropDownListFor(model => model.CulturePunjabi_SpotLight_Category, new SelectList(listItems3punjabi, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.CulturePunjabi_SpotLight_Category, "", new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.CulturePunjabi_SpotLight_Title, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="top" title="Ticker or spot light message. (maximum content 150 words, in punjabi language).">
                                                            @Html.EditorFor(model => model.CulturePunjabi_SpotLight_Title, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.CulturePunjabi_SpotLight_Title, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Other Option(s)</legend>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <label class="control-label mand">Is higher priority news? (Yes/No)</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label>
                                                                @Html.RadioButtonFor(model => model.SpotLight_PriorityFlag, "1") Yes
                                                                @Html.RadioButtonFor(model => model.SpotLight_PriorityFlag, "0") No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.SpotLight_PriorityFlag, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <label class="control-label mand">Is valid for public view? (Yes/No)</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label>
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "1") Yes
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "0") No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsPublicView, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                            &nbsp;
                                            @Html.ActionLink("Reset", "WebindexInfoSpotLightDetails", "HelpdeskAdmin", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="form-group">                                        
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.SpotLight_IssueDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.SpotLight_Category)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.SpotLight_Title)
                                                        </th>
                                                        <th width="10%">
                                                            @Html.DisplayName("Public View")
                                                        </th>
                                                        <th width="10%">@Html.DisplayName("Edit| Delete")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.prpSpotLight)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.SpotLight_IssueDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.SpotLight_Category)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.SpotLight_Title)
                                                            </td>
                                                            <td>
                                                                @if (item.IsPublicView == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }
                                                            </td>
                                                            <td>                                                                
                                                                @Html.ActionLink("Edit", "Edit_windexInfoSpotLightDetails", new { pIndexID = item.SpotLight_IndexID, pKeyID = item.SpotLight_ID }) @("| ")
                                                                @Html.ActionLink("Delete", "Delete_windexInfoSpotLightDetails", new { pIndexID = item.SpotLight_IndexID, pKeyID = item.SpotLight_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}

