                                                                    <label class="control-label mand">Under Section</label>
                                                                </div>
                                                                <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Under section of notice/ complaint with reference to RERA Act.">
                                                                    @Html.DropDownListFor(m => m.FixedFor, new SelectList(Model.eCourtUnderSectionMaster, "UnderSectionCode", "UnderSectionName"), "Select", new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.FixedFor, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    <label class="control-label mand">Fixed For/ Status</label>
                                                                </div>
