<script type="text/javascript">
		$(function() {
		    $("#OrderTime").inputmask({ mask: function () { return ["9:99 AA", "99:99 AA"]; } });

		    $('#HearingBenchCode').change(function () {
		        $('#HearingBenchName').empty();
		        $("input[name='HearingBenchName']").val($("#HearingBenchCode option:selected").text());
		    });

		    $('#DistrictTown_InfoCode').change(function () {
		        $('#DistrictTown_InfoName').empty();
		        $("input[name='DistrictTown_InfoName']").val($("#DistrictTown_InfoCode option:selected").text());
		    });

		    $(document).on('click', 'a.panel-accordion-toggle', function (e) {
		        e.preventDefault();
		        var elem = $(this);
		        var criteriaCode = $(this).attr('data-parent');

		        var criteriaCmdA = "#btnAccordionNoticeSectionFiveNine";
		        var criteriaSelectorA = "#accordionNoticeSectionFiveNine";
		        var criteriaCmdD = "#btnAccordionNoticeSectionDescription";
		        var criteriaSelectorD = "#accordionNoticeSectionDescription";

		        switch (criteriaCode) {
		            case criteriaSelectorA:
		                $(criteriaCmdA).find("span").toggleClass("btn-outline");
		                $(criteriaCmdA).find("i").toggleClass("fa-minus-circle fa-plus-circle");
		                break;
		            case criteriaSelectorD:
		                $(criteriaCmdD).find("span").toggleClass("btn-outline");
		                $(criteriaCmdD).find("i").toggleClass("fa-minus-circle fa-plus-circle");
		                break;
		        }
		    });

		    $("input[name='IsPersonalHearing']").click(function () {
		        if ($("#chkBenchHearingDate").is(":checked")) {
		            $("#showOrderHearingDate").removeClass("hide");
		            $("#showOrderTime1").removeClass("hide");
		            $("#showOrderTime2").removeClass("hide");
		            $("#showHearingtitle").removeClass("hide");
		            $("#showOrdertitle").addClass("hide");
		            $("#rowHearingBench").removeClass("hide");
		            $("#rowUnderSection").removeClass("hide");
		            $("input[name='OrderDateStatusTitle']").val("Hearing Date").text();
		        }
		        if ($("#chkBenchOrderDate").is(":checked")) {
		            $("#showOrderHearingDate").removeClass("hide");
		            $("#showOrderTime1").addClass("hide");
		            $("#showOrderTime2").addClass("hide");
		            $("#showHearingtitle").addClass("hide");
		            $("#showOrdertitle").removeClass("hide");
		            $("#rowHearingBench").removeClass("hide");
		            $("#rowUnderSection").removeClass("hide");
		            $("input[name='OrderDateStatusTitle']").val("Order Date").text();
		        }
		        if ($("#chkBenchOther").is(":checked")) {
		            $("#showOrderHearingDate").addClass("hide");
		            $("#showOrderTime1").addClass("hide");
		            $("#showOrderTime2").addClass("hide");
		            $("#showHearingtitle").addClass("hide");
		            $("#showOrdertitle").addClass("hide");
		            $("#rowHearingBench").addClass("hide");
		            $("#rowUnderSection").addClass("hide");
		            $("input[name='OrderDateStatusTitle']").val("None of them").text();
		        }		        
		    });
            
		    //var varhearingcode = $(".radio-IsPersonalHearing").val();
		    //$(".radio-IsPersonalHearing[value='" + varhearingcode + "']").attr("checked", true);
		    var varhearingcode = $("#OrderDateStatusTitle").val();
		    if (varhearingcode == "Hearing Date") {
		        $("#showOrderHearingDate").removeClass("hide");
		        $("#showOrderTime1").removeClass("hide");
		        $("#showOrderTime2").removeClass("hide");
		        $("#showHearingtitle").removeClass("hide");
		        $("#showOrdertitle").addClass("hide");
		        $("#rowHearingBench").removeClass("hide");
		        $("#rowUnderSection").removeClass("hide");
		        $("input[name='OrderDateStatusTitle']").val("Hearing Date").text();
		    }
		    else {
		        if (varhearingcode == "Order Date") {
		            $("#showOrderHearingDate").removeClass("hide");
		            $("#showOrderTime1").addClass("hide");
		            $("#showOrderTime2").addClass("hide");
		            $("#showHearingtitle").addClass("hide");
		            $("#showOrdertitle").removeClass("hide");
		            $("#rowHearingBench").removeClass("hide");
		            $("#rowUnderSection").removeClass("hide");
		            $("input[name='OrderDateStatusTitle']").val("Order Date").text();
		        }
		        else {
		            $("#showOrderHearingDate").addClass("hide");
		            $("#showOrderTime1").addClass("hide");
		            $("#showOrderTime2").addClass("hide");
		            $("#showHearingtitle").addClass("hide");
		            $("#showOrdertitle").addClass("hide");
		            $("#rowHearingBench").addClass("hide");
		            $("#rowUnderSection").addClass("hide");
		            $("input[name='OrderDateStatusTitle']").val("None of them").text();
		        }
		    };

		    $('#CurrentEvent_IdentifiedCode').change(function () {
		        var baseUrl = $('body').attr('data-base-url');
		        $.ajax({
		            type: "POST",
		            url: baseUrl + "HelpdeskAdmin/GetNoticeSectionFiveNineMasterByEventId",
		            datatype: "Json",
		            data: { EventId: $('#CurrentEvent_IdentifiedCode').val() },
		            success: function (data) {
		                $.each(data, function (index, value) {
		                    $('#getStatusFileInfo').show();		                    
		                    $('#DocFileDiscription').text("Description : " + value.EventAction_Description);
		                });
		            }
		        });
		    });

		    $('#CurrentEvent_IdentifiedCode').change(function () {
		        $('#CurrentEvent_IdentifiedAggregateName').empty();
		        $('#CurrentStatusTitle').empty();
		        $("input[name='CurrentEvent_IdentifiedAggregateName']").val($("#CurrentEvent_IdentifiedCode option:selected").text());
		        $("input[name='CurrentStatusTitle']").val($("#CurrentEvent_IdentifiedCode option:selected").text());
		    });
		});
</script>
<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#complaint-sections-list-table').dataTable({
            responsive: true,
            "pageLength": 25,
            "lengthMenu": [[25, 50, 100, 200, 250], [25, 50, 100, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [7]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        $('#NoticeDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#OrderDate').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#CurrentStatusDate").datepicker("option", "maxDate", dt);
            }
        });
        $('#CurrentStatusDate').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var HearingDate = $("#OrderDate").val();
                var HearingFlag = $(".radio-IsPersonalHearing:checked").val();
                if (HearingFlag != 0) {
                    if (HearingDate == '') {
                        alert('Please select Next Hearing Date Fixed first!');
                        $("#CurrentStatusDate").val('');
                        return false;
                    }
                }
                else {
                    return true;
                }
            }
        });
    });
</script>
<script>
    $(function () {
        var getUrlCourtvalue;
        @if (TempData["returnUrlFNByPSvalue"].ToString() != "")
        {
            <text>
                getUrlCourtvalue = '@TempData["returnUrlFNByPSvalue"]';
            </text>
        };

        switch (getUrlCourtvalue){
            case "ComplaintsNoticeSection":
                break;
            case "ExtractComplaintsNoticeSection":
                $("#btnAccordionComplaintNoticeForm").find("span").toggleClass("btn-outline");
                $("#btnAccordionComplaintNoticeForm").find("i").toggleClass("fa-plus-square fa-minus-square");

                $('#collapseComplaintNoticeForm_Detail').toggle();
                $('#collapseComplaintNoticeForm_List').toggle();
                break;
            default:
                break;
        };

        $(document).on('click', 'a.custom-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);

            if (getUrlCourtvalue != "ExtractComplaintsNoticeSection") {
                var criteriaCode = $(this).attr('data-parent');

                var criteriaCmd = "#btnAccordionComplaintNoticeForm";
                var criteriaSelector = "#accordionComplaintNoticeForm";

                switch (criteriaCode) {
                    case criteriaSelector:
                        $(criteriaCmd).find("span").toggleClass("btn-outline");
                        $(criteriaCmd).find("i").toggleClass("fa-minus-square fa-plus-square");
                        break;
                }
            }
        });

        $(".frmshow-complaintnotices").click(function () {
            if (confirm('Are You Sure You want to Edit Complaint Form!!')) {
                $("#btnAccordionComplaintNoticeForm").find("span").toggleClass("btn-outline");
                $("#btnAccordionComplaintNoticeForm").find("i").toggleClass("fa-plus-square fa-minus-square");

                $('#collapseComplaintNoticeForm_Detail').toggle();
                $('#collapseComplaintNoticeForm_List').toggle();
                return true;
            }
            else
                return false;
        });
    });
</script>
<script>
    $(document).ready(function () {
        var BASEsfn_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASEsfn_URL + 'HelpdeskAdmin/ComplaintNoticeSectionForm_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });
    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Complaint/Notices Under Section(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Registration or submission wrt Complaint /Notices applications under different Sections of RERA Act.<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

