<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();
        });

        $('[data-toggle="tooltip"]').tooltip();

        if ($('#OrderDate').val() == "01-Jan-0001") {
            $('#OrderDate').val("");
        }

        if ($('#CurrentStatusDate').val() == "01-Jan-0001") {
            $('#CurrentStatusDate').val("");
        }

        if ($('#NoticeDate').val() == "01-Jan-0001") {
            $('#NoticeDate').val("");
        }

        if ($("#Notice_ModeOfComplaint option:selected").text() == "Other") {
            $("#showModeOfComplaint1").show();
            $("#showModeOfComplaint2").show();
        }
        else {
            $("#showModeOfComplaint1").hide();
            $("#showModeOfComplaint2").hide();
        }

        $('#Notice_ModeOfComplaint').change(function () {
            if ($("#Notice_ModeOfComplaint option:selected").text() == "Other")
            {
                $("#showModeOfComplaint1").show();
                $("#showModeOfComplaint2").show();
            }
            else
            {
                $("#showModeOfComplaint1").hide();
                $("#showModeOfComplaint2").hide();
            }
        });

        if ($('#NoticesSectionFiveNine_IDName').val() == "0" || $('#NoticesSectionFiveNine_IDName').val() == "" || $('#NoticesSectionFiveNine_IDName').val() == "0.00") {
            $("#NoticesSectionFiveNineR1").hide();
            $("#NoticesSectionFiveNineR2").hide();
        }
        else
        {
            $("#NoticesSectionFiveNineR1").show();
            $("#NoticesSectionFiveNineR2").show();
        }

        if ($('#Complainant_AadhaarNumber').val() == "0" || $('#Complainant_AadhaarNumber').val() == "" || $('#Complainant_AadhaarNumber').val() == "0.00") {
            $('#Complainant_AadhaarNumber').val("");
        }
        if ($('#Complainant_LandlineFaxNumber').val() == "0" || $('#Complainant_LandlineFaxNumber').val() == "" || $('#Complainant_LandlineFaxNumber').val() == "0.00") {
            $('#Complainant_LandlineFaxNumber').val("");
        }
        if ($('#Complainant_MobileNumber').val() == "0" || $('#Complainant_MobileNumber').val() == "" || $('#Complainant_MobileNumber').val() == "0.00") {
            $('#Complainant_MobileNumber').val("");
        }        

        if ($('#AuthorizedCounsel_MobileNumber').val() == "0" || $('#AuthorizedCounsel_MobileNumber').val() == "" || $('#AuthorizedCounsel_MobileNumber').val() == "0.00") {
            $('#AuthorizedCounsel_MobileNumber').val("");
        }
        if ($('#AuthorizedCounsel_LandlineFaxNumber').val() == "0" || $('#AuthorizedCounsel_LandlineFaxNumber').val() == "" || $('#AuthorizedCounsel_LandlineFaxNumber').val() == "0.00") {
            $('#AuthorizedCounsel_LandlineFaxNumber').val("");
        }

    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };

    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }

    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>
<script>
        $(function () {
            var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "/HelpdeskAdmin/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    if (value != null) {
                        $('#OfficeResComplainant_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                        $("#OfficeResComplainant_AddressStateCode option:contains(undefined)").remove();
                    }
                });
            }
        });

        $('#OfficeResComplainant_AddressStateCode').change(function () {
            $('#OfficeResComplainant_AddressDistrictCode').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "/HelpdeskAdmin/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#OfficeResComplainant_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#OfficeResComplainant_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
