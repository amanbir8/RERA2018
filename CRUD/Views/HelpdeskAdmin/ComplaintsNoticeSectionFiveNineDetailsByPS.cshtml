                                                                    @Html.DropDownListFor(m => m.CurrentEvent_IdentifiedCode, new SelectList(Model.EventMaster, "EventAction_Code", "EventAction_Aggregate"), "Select", new { @class = "form-control" })
                                                                    @Html.ValidationMessageFor(model => model.CurrentEvent_IdentifiedCode, "", new { @class = "text-danger" })
                                                                </div>
