                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    <label class="control-label">Remarks, If Any</label>
                                                                </div>
                                                                <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Hearing or Order related Remarks (If Any) with reference to Notice/ File Number.">
                                                                    @Html.EditorFor(model => model.OrderDateWithRemarksIfAny, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                                    @Html.ValidationMessageFor(model => model.OrderDateWithRemarksIfAny, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="form-group">
                                                    <fieldset class="col-md-12">
                                                        <legend class="my">(4.) Notice/ Complaint Status Details</legend>
                                                        <div class="row">
                                                            <div class="form-group">
                                                                <div class="col-md-3">
                                                                    @Html.LabelFor(model => model.CurrentStatusWithRemarks, htmlAttributes: new { @class = "control-label" })
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.EditorFor(model => model.CurrentStatusWithRemarks, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                                    @Html.ValidationMessageFor(model => model.CurrentStatusWithRemarks, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-12">
                                                    <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                                    &nbsp;
                                                    @Html.ActionLink("Reset", "ComplaintsNoticeSectionFiveNineDetailsByPS", "HelpdeskAdmin", null, new { @class = "btn btn-outline btn-primary" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div id="collapseComplaintNoticeForm_List" class="panel-collapse in collapseComplaintNoticeForm" aria-expanded="false" style="">
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="table-responsive">
                                                    <table class="table table-striped table-bordered" id="complaint-sections-list-table">
                                                        <thead>
                                                            <tr>
                                                                <th>@Html.DisplayName("SNo")</th>
                                                                <th>@Html.DisplayNameFor(model => model.NoticesSectionFiveNine_IDName)</th>
                                                                <th>@Html.DisplayNameFor(model => model.DistrictTown_InfoName)</th>
                                                                <th>@Html.DisplayNameFor(model => model.ProjectName)</th>                                                                
                                                                <th>@Html.DisplayName("Fixed For")</th>
                                                                <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                                                                <th>@Html.DisplayName("Date of Institution")</th>
                                                                <th width="10%">@Html.DisplayName("Edit Details")</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @{
                                                                int snoNoticeSectionFiveNine = 0;
                                                            }
                                                            @foreach (var item in Model.prpNoticeSectionFiveNineByLA)
                                                            {
                                                                {
                                                                    snoNoticeSectionFiveNine = snoNoticeSectionFiveNine + 1;
                                                                }
                                                                <tr>
                                                                    <td>@Html.DisplayName(snoNoticeSectionFiveNine.ToString())</td>
                                                                    <td>@Html.DisplayFor(modelItem => item.NoticesSectionFiveNine_IDName)</td>
                                                                    <td>@Html.DisplayFor(modelItem => item.DistrictTown_InfoName)</td>
                                                                    <td>@Html.DisplayFor(modelItem => item.ProjectName)</td>                                                                    
                                                                    <td>@Html.DisplayFor(modelItem => item.CurrentStatusTitle)</td>
                                                                    <td>
                                                                        @if (item.OrderDateStatusTitle == string.Empty)
                                                                        {
                                                                            @Html.DisplayName("--")
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.DisplayFor(modelItem => item.OrderDateStatusTitle)
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @if (item.NoticeDate == DateTime.MinValue)
                                                                        {
                                                                            @Html.DisplayName("")
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.DisplayFor(modelItem => item.NoticeDate)
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @Html.ActionLink("Edit", "Edit_ComplaintsNoticeSectionFiveNineDetailsByPS", new { pIndexID = item.NoticesSectionFiveNine_IndexID, pKeyID = item.NoticesSectionFiveNine_ID }, new { @class = "frmshow-complaintnotices" })
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- /.row (nested) -->
                            </div>
                            <!-- /.panel-body -->
                        </div>
                        <!-- /.panel -->
                    </div>
                    <!-- /.col-lg-12 -->
                </div>
            </div>
            <!-- /.row -->
        </div>
    </div>
</div>
<!-- /.wrapper -->
