                                                                    <label class="control-label mand">Business On Date/ Date Fixed for Proceeding</label>
                                                                </div>
                                                                <div class="col-md-3">
                                                                    @Html.EditorFor(model => model.CurrentStatusDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                                    @Html.ValidationMessageFor(model => model.CurrentStatusDate, "", new { @class = "text-danger" })
                                                                </div>
                                                            </div>
