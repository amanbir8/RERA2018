        //    // ajax to fetch data corresponding to projectId
        //    var noticeFiveNineID = $.trim($(parentRow).find('input.hdnNoticeFiveNineID').val());
        //    noticeFiveNineID = parseInt(noticeFiveNineID);
        //    $.ajax({
        //        url: BASE_URL + 'HelpdeskAdmin/ComplaintsNoticeSecFiveNine',
        //        dataType: 'HTML',
        //        type: 'GET',
        //        data: { 'pIndexID': noticeFiveNineID, 'pKeyID': noticeFiveNineID },
        //        beforeSend: function () {
        //            startPreloader();
        //        },
        //        success: function (response) {
        //            stopPreloader();
        //            $(noticeFiveNineDetailsModal).find('.modal-body').html(response);
        //            $(noticeFiveNineDetailsModal).find('table').DataTable({
        //                responsive: true
        //            });
        //        }
        //    });
        //    var diaryNo = $.trim($(parentRow).find('td.notice-file-number').attr('data-noticefile-no'));
        //    var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
