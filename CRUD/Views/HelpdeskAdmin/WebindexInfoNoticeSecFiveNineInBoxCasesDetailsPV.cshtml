                dataType: 'HTML',
                type: 'GET',
                data: { 'noticeFiveNineID': noticeFiveNineID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(noticeFiveNineDetailsModal).find('.modal-body').html(response);
                    $(noticeFiveNineDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.notice-file-number').attr('data-noticefile-no'));
            var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            //$(noticeFiveNineDetailsModal).find('h4.modal-title').html('File Action Details - ');
            $(noticeFiveNineDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(noticeFiveNineDetailsModal).modal('show');
        });

        //$(document).on('click', 'a#modalEditNoticeOpenerButton', function (e) {
