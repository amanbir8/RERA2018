        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var noticeFiveNineDetailsModal = $(document).find('#myModal');
            $(noticeFiveNineDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var noticeFiveNineID = $.trim($(parentRow).find('input.hdnNoticeFiveNineID').val());
            noticeFiveNineID = parseInt(noticeFiveNineID);
            $.ajax({
                url: BASE_URL + 'HelpdeskAdmin/NoticeSecFiveNineInfoEventDeskLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'noticeFiveNineID': noticeFiveNineID },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(noticeFiveNineDetailsModal).find('.modal-body').html(response);
                    $(noticeFiveNineDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.notice-file-number').attr('data-noticefile-no'));
