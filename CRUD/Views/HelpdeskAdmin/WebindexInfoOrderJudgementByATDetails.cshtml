<script type="text/javascript">
    $(document).ready(function () {
        var dropdown = $('#AppealOrderDoc_InfoCode');

        $.ajax({
            url: '@Url.Action("GetTypeofOrders", "HelpdeskAdmin")',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                dropdown.empty();
                //dropdown.append($('<option>').val('').text('-- Select --'));

                $.each(data, function (i, item) {
                    dropdown.append($('<option>').val(item.typeofOrder_ID).text(item.typeofOrderName));
                });

                dropdown.val('@Model.AppealOrderDoc_InfoCode').trigger("change");
            },
            error: function () {
                alert("Failed to load TypeOfOrders. Please try again.");
            }
        });

        dropdown.change(function () {
            var selectedText = dropdown.find("option:selected").text();
            $("#AppealOrderDoc_InfoName").val(selectedText);
        });
    });
</script>

