<script>
    $(document).ready(function () {
        $(document).on('click', 'a.panel-accordion-toggle', function (e) {
            e.preventDefault();
            var elem = $(this);
            var criteriaCode = $(this).attr('data-parent');
            switch (criteriaCode) {
                case '#accordionAppellateTribunaldetails':
                    $("#btnAccordionAppellateTribunalJudgements").find("span").toggleClass("btn-outline");
                    $("#btnAccordionAppellateTribunalJudgements").find("i").toggleClass("fa-upload fa-times");
                    $("#btnAccordionAppellateTribunalJudgements").attr("title", function (index, attr) {
                        return attr == 'Cancel Uploads' ? 'Upload Order & Judgements' : 'Cancel Uploads';
                    });
                    break;
            }
        });

        var vareditmode = $('#AppellateTribunalOrder_IndexID').val();
        if (vareditmode != 0) {
            $("#collapseAppellateTribunalJudgements").removeClass("collapse");
        };

        var webbase_url = $('body').attr('data-base-url');
        $(document).on('click', 'a.panelOpenerList', function (e) {
            e.preventDefault();
            window.location = webbase_url + 'HelpdeskAdmin/WebindexInfoOrderJudgementByATDetails';
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerOrderJudgements);
    });

    function infohelpHandlerOrderJudgements() {

        new PNotify({
            title: 'Help',
            text: '<b>Order & Judgements</b><br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Add or upload order & judgements document with reference to complaint diary number and hearing details.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Use order & judgements with reference to offline registered complaints details (direct offline only).',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
