<script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();
        });

        $('[data-toggle="tooltip"]').tooltip();

        if ($('#OrderDate').val() == "01-Jan-0001") {
            $('#OrderDate').val("");
        }

        if ($('#CurrentStatusDate').val() == "01-Jan-0001") {
            $('#CurrentStatusDate').val("");
        }

        if ($('#NoticeDate').val() == "01-Jan-0001") {
            $('#NoticeDate').val("");
        }

    });
</script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [7]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        $('#NoticeDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        $('#CurrentStatusDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        $('#OrderDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
    });
</script> 

