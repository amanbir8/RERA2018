<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = BASE_URL + 'HelpdeskAdmin/FiveNineNonMaintainableCases_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });

    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:#7bb73f"></i> Decided complaint(s) under concerned Hearing Bench.<br/> <i class="fa fa-check-square" style="color:#ff4961"></i> Pending for reply from complainant or repondant (Additional information sought by authority wrt notice or complaint).',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>
<style>
    .bg-border-show {
        position: relative !important;
    }

    .border-show-content {
        padding-right: 5px;
    }

    .border-left-danger {
        /*text-shadow: 2px 2px 5px red;*/
        border-left: .25rem solid #FF4961 !important;
    }

    .border-left-warning {
        /*text-shadow: 2px 2px 5px #fd7e14;*/
        border-left: .25rem solid #f6c23e !important;
    }

    .bg-exclamation-triangle-warning {
        color: #f6c23e !important;
        display: inline-block !important;
    }

    .bg-exclamation-triangle-none {
        display: none !important;
    }

    .bg-flag-notification-info {
        color: #7bb73f !important;
        display: inline-block !important;
    }

    .bg-flag-notification-none {
        display: none !important;
    }

    table#dataTables-example tr td a.button {
        display: none;
    }

    table#dataTables-example tr:hover td a.button {
        display: inline-block;
    }

    .bg-plus-square-glow-show {
        /*-webkit-box-shadow: 0 0 10px #7bb73f;*/
        /*box-shadow: 0 0 10px #FF4961;*/
        color: green;
    }

    .bg-pdf-glow-show {
        /*-webkit-box-shadow: 0 0 10px #7bb73f;*/
        /*box-shadow: 0 0 10px #FF4961;*/
        color: #7bb73f;
    }
</style>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Notices (Section 59 /Other Sections)</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Notices (Under Section 59 /Other Sections) : Non-Maintainable Case(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>                                            
                                            <th style="width:10%;">@Html.DisplayNameFor(model => model.NoticesSectionFiveNine_IDName)</th>
                                            <th>@Html.DisplayNameFor(model => model.DistrictTown_InfoName)</th>
                                            <th>@Html.DisplayNameFor(model => model.ProjectName)</th>
                                            <th>@Html.DisplayNameFor(model => model.PromoterName)</th>
                                            <th>@Html.DisplayName("Entrusted To")</th>                                            
                                            <th>@Html.DisplayName("Fixed For")</th>
                                            <th>@Html.DisplayName("Last Status")</th>
                                            <th>@Html.DisplayName("Date of Institution")</th>                                                                                       
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                            string notificationpublicviewId = "";
                                            string notificationpublicviewTitle = "";
                                        }
                                        @foreach (var item in Model.prpNoticeSectionFiveNineByLA)
                                        {
                                            {
                                                sno = sno + 1;
                                                notificationpublicviewId = "noticepublicviewreminderShow" + @sno.ToString();
                                                notificationpublicviewTitle = "noticepublicviewreminderVertical" + @sno.ToString();
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="notice-file-number" data-noticefile-no="@Html.DisplayFor(modelItem => item.NoticesSectionFiveNine_IDName)" style="width:10%;">
                                                    <a id="modalAddOpenerButton" href="javascript:void(0);">
                                                        @Html.DisplayFor(modelItem => item.NoticesSectionFiveNine_IDName)
                                                    </a>
                                                    <script type="text/javascript">
                                                        $(document).ready(function () {
                                                            showNoticePublicViewReminderColor("@item.IsPublicView.ToString()", "@sno.ToString()");
                                                        });
                                                    </script>
                                                    <span class="pull-left bg-border-show">
                                                        <span id=@notificationpublicviewId.ToString() class="bg-exclamation-triangle-none">
                                                            <i class="fa fa-exclamation-triangle fa-fw warning-button" aria-hidden="true" title="Warning: No notification avilable in Public View regarding Notice(s)!"></i>
                                                        </span>
                                                    </span>
                                                </td>                                                
                                                <td>@Html.DisplayFor(modelItem => item.DistrictTown_InfoName)</td>
                                                <td class="project-name" data-project-name="@Html.DisplayFor(modelItem => item.ProjectName)">
                                                    @Html.DisplayFor(modelItem => item.ProjectName)
                                                    @Html.HiddenFor(modelItem => item.NoticesSectionFiveNine_ID, new { @class = "hdnNoticeFiveNineID" })                                                    
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.PromoterName)</td>
                                                <td>@Html.DisplayFor(modelItem => item.HearingBenchName)</td>
                                                @if (item.CurrentEvent_IdentifiedCode.ToString() == "770011")
                                                {
                                                    <td class="warning" id=@notificationpublicviewTitle.ToString()>
                                                        @Html.DisplayFor(modelItem => item.CurrentEvent_IdentifiedAggregateName)
                                                        @Html.DisplayName(", dated")
                                                        @Html.DisplayFor(modelItem => item.OrderDate)
                                                    </td>
                                                }
                                                else if (item.CurrentEvent_IdentifiedCode.ToString() == "770025" || item.CurrentEvent_IdentifiedCode.ToString() == "770027")
                                                {
                                                    <td class="danger" id=@notificationpublicviewTitle.ToString()>@Html.DisplayFor(modelItem => item.CurrentEvent_IdentifiedAggregateName)</td>
                                                }
                                                else
                                                {
                                                    <td class="success" id=@notificationpublicviewTitle.ToString()>@Html.DisplayFor(modelItem => item.CurrentEvent_IdentifiedAggregateName)</td>
                                                }                                              
                                                @if (item.DeskAction_IdentifiedOn.Value.Year.ToString() == "1")
                                                {
                                                    <td>
                                                        @Html.DisplayName("--")
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.DeskAction_IdentifiedAggregateName)
                                                    </td>
                                                } 
                                                <td>@Html.DisplayFor(modelItem => item.NoticeDate)</td>                                                  
                                                @if (item.DeskAction_IdentifiedOn.Value.Year.ToString() == "1")
                                                {
                                                    <td>
                                                        @Html.DisplayName("--")
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.DeskAction_IdentifiedOn)
                                                    </td>
                                                }
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">                                                    
                                                    @Html.ActionLink("View", "ComplaintsNoticeSecFiveNine", new { pIndexID = item.NoticesSectionFiveNine_IndexID, pKeyID = item.NoticesSectionFiveNine_ID })
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>                    
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" />
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script> 
    
    <script>
        function showNoticePublicViewReminderColor(pvString, srNo) {
            var varReminderFlag = 0;
            if (pvString > 1 || pvString == 1) {
                varReminderFlag = 1;
            };
            var notificationpublicviewVerShow = '#noticepublicviewreminderShow' + srNo;
            var notificationpublicviewVerTitle = '#noticepublicviewreminderVertical' + srNo;
            switch (varReminderFlag) {
                case 0:
                    $(document).find(notificationpublicviewVerShow.trim()).removeClass('bg-exclamation-triangle-none').addClass('bg-exclamation-triangle-warning');
                    $(document).find(notificationpublicviewVerTitle.trim()).addClass('border-left-warning');
                    break;
                case 1:
                    $(document).find(notificationpublicviewVerShow.trim()).removeClass('bg-exclamation-triangle-warning').addClass('bg-exclamation-triangle-none');
                    $(document).find(notificationpublicviewVerTitle.trim()).removeClass('border-left-warning');
                    break;
            }
        }

        $(document).ready(function () {
            $('#dataTables-example').DataTable({
                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [10, 11]
                }]
            });
        });
    </script>   
}
