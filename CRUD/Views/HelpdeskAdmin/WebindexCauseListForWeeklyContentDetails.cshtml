<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [4]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        //$('#CauseListOneDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        //$('#CauseListTwoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        //$('#CauseListThreeDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        //$('#CauseListFourDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
        //$('#CauseListFiveDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })

        $('#CauseListTwoDate').datepicker({ dateFormat: 'dd-M-yy', onSelect: function (selectedDate) { changeDayByDate(selectedDate, this); } })
        $('#CauseListThreeDate').datepicker({ dateFormat: 'dd-M-yy', onSelect: function (selectedDate) { changeDayByDate(selectedDate, this); } })
        $('#CauseListFourDate').datepicker({ dateFormat: 'dd-M-yy', onSelect: function (selectedDate) { changeDayByDate(selectedDate, this); } })
        $('#CauseListFiveDate').datepicker({ dateFormat: 'dd-M-yy', onSelect: function (selectedDate) { changeDayByDate(selectedDate, this); } })

        $('#CauseListOneDate').datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            numberOfMonths: 1,
            onSelect: function (selected) {
                changeDayByDate(selected, this);

                var dt1 = new Date(selected);
                dt1.setDate(dt1.getDate() + 1);
                day1 = getDayName(dt1.getDay());

                var dt2 = new Date(selected);
                dt2.setDate(dt2.getDate() + 2);
                day2 = getDayName(dt2.getDay());

                var dt3 = new Date(selected);
                dt3.setDate(dt3.getDate() + 3);
                day3 = getDayName(dt3.getDay());

                var dt4 = new Date(selected);
                dt4.setDate(dt4.getDate() + 4);
                day4 = getDayName(dt4.getDay());

                $('#CauseListTwoDate').datepicker("setDate", dt1);
                $('#CauseListThreeDate').datepicker("setDate", dt2);
                $('#CauseListFourDate').datepicker("setDate", dt3);
                $('#CauseListFiveDate').datepicker("setDate", dt4);

                $('#CauseListTwoDay').find('option[value="' + day1 + '"]').prop('selected', 'selected');
                $('#CauseListThreeDay').find('option[value="' + day2 + '"]').prop('selected', 'selected');
                $('#CauseListFourDay').find('option[value="' + day3 + '"]').prop('selected', 'selected');
                $('#CauseListFiveDay').find('option[value="' + day4 + '"]').prop('selected', 'selected');
            }
        });

    });

    /*  function to get full name of the day from javascript dayNumber */
    function getDayName(dayNo) {        
        var daysArray = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
        var dayName = "Sunday";
        if (dayNo > 0)
        {
            dayName = daysArray[dayNo - 1];
        }
        return dayName;
    }

    /* select day corresponding to date selected */
    function changeDayByDate(selectedDate, dateElem) {
        var selectedDate = new Date(selectedDate);
        var dayName = getDayName(selectedDate.getDay());
        $(dateElem).closest('.row').next('.row').find('select').find('option[value="' + dayName + '"]').prop('selected', 'selected');
    }
</script> 

