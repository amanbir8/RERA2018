@model CRUD.Models.HelpdeskAdmin.ClsPrp_AdminDesk_UploadFilePDF

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();

            var files = $("#Photo_Address").get(0).files;
            var path = $('#user_Photo').attr('src').replace('/', '');

            if (files.length > 0 || path.length > 0) {
                $(submitButton).parents('form').submit();
            }
            else {
                alert("Bad request! Add document file to Upload!")
                return false;
            }
        });

        $('[data-toggle="tooltip"]').tooltip();

    });

    var baseUrl = $('body').attr('data-base-url');

    function showPhoto(input) {
        if (input.files && input.files[0]) {
            var filerdr = new FileReader();
            filerdr.onload = function (e) {
                var selectedFile = input.files[0];
                var imageType = 'image/jpeg';
                if (selectedFile.type.match(imageType)) {
                    $('#user_Photo').attr('src', e.target.result);
                }
                if (selectedFile.type.match('application/pdf')) {
                    var dataURL = baseUrl + 'images/pdf-icon.gif';
                    $('#user_Photo').attr('src', dataURL);
                    $('#user_Photo').attr('width', '78');
                    $('#user_Photo').attr('height', '78');
                }
            }
            filerdr.readAsDataURL(input.files[0]);
            $('#Photo_AddressShow').empty();
            $("#Photo_AddressShow").val(input.files[0].name);
        }
    }
</script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [3]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        $('#Date_of_UploadorIssue').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
    });
</script> 

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Real Estate Projects (Upload Pending Projects List) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Upload List of Pending Real Estate Project(s)
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("WebindexListPendingProjectsDetails", "HelpdeskAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.UploadFilePDF_IndexID)
                                @Html.HiddenFor(model => model.UploadFilePDF_ID)
                                @Html.HiddenFor(model => model.IsDraft)
                                @Html.HiddenFor(model => model.IsDraftMember)

                                @Html.HiddenFor(model => model.FileReferenceType)
                                @Html.HiddenFor(model => model.FileReferenceName)

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Upload Document</legend>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Document/File Name</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="input-group">
                                                                <label class="input-group-btn">
                                                                    <span class="btn btn-primary">
                                                                        Browse… <input type="file" id="Photo_Address" name="Photo_Address" onchange="showPhoto(this)" style="display: none;" multiple="" />
                                                                    </span>
                                                                </label>
                                                                <input type="text" id="Photo_AddressShow" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="control-label col-md-3">
                                                            @Html.HiddenFor(model => model.UploadFilePDF_FilePath)
                                                            @Html.HiddenFor(model => model.UploadFilePDF_FileName)
                                                            @Html.HiddenFor(model => model.UploadFilePDF_BaseUrl)
                                                            @Html.HiddenFor(model => model.UploadFilePDF_FileType)
                                                        </div>
                                                        <div class="col-md-3">
                                                            <a href="~/@Html.DisplayFor(model => model.UploadFilePDF_FilePath)@Html.DisplayFor(model => model.UploadFilePDF_FileName)" data-spzoom>
                                                                <img id="user_Photo" height="100" width="90" style="border:1px solid;" src="~/@Html.DisplayFor(model => model.UploadFilePDF_FilePath)@Html.DisplayFor(model => model.UploadFilePDF_FileName)" alt="No Image" />
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            @TempData["notice"]<br />Document should be in .PDF format and less than 5 MB (Five MB).
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr />
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            <label class="control-label mand">Date of Prepared/Issue/Upload (date as on)</label>
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Date as on applications pending with RERA, Punjab related to uplaoding list of pending project registration document.">
                                                            @Html.EditorFor(model => model.Date_of_UploadorIssue, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                                                            @Html.ValidationMessageFor(model => model.Date_of_UploadorIssue, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div> 
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <input type="submit" value="@TempData["submitvaluePendingProjectUploadList"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                            &nbsp;
                                            @Html.ActionLink("Reset", "WebindexListPendingProjectsDetails", "HelpdeskAdmin", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            } 
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                <thead>
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayName("Date of Upload")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Date of Prepared/Issue (Date as on)")
                                                        </th>
                                                        <th>
                                                            @Html.DisplayName("Reference File Details")
                                                        </th>
                                                        <th align="center" width="9%">
                                                            @Html.DisplayName("View")
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.prpUploadFilePDF)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.CreatedOn)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Date_of_UploadorIssue)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.FileReferenceType)
                                                            </td>
                                                            <td align="center">
                                                                <a href="~/@Html.DisplayFor(modelItem => item.UploadFilePDF_FilePath)/@Html.DisplayFor(modelItem => item.UploadFilePDF_FileName)" target="_blank" title="View Document"><i class="fa fa-external-link-square"></i></a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>                           
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}

