@model CRUD.Models.HelpdeskAdmin.ClsPrp_AdminDesk_FactsFigure

<style>
    .table-bordered > thead > tr > td, .table-bordered > thead > tr > th {
        border-bottom-width: 0px;
    }
</style>

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>
<!--data table grid display Content-->
<link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap4.css")" rel="stylesheet" />
<script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.js")"></script>
<script src="@Url.Content("~/vendor/datatables/js/dataTables.bootstrap4.min.js")"></script>

<script>$.uiBackCompat = false;</script>

<script type="text/javascript">
    $(document).ready(function () {

        $(document).on('click', '#BtnMainform', function (e) {
            var submitButton = $(this);
            e.preventDefault();
            $(submitButton).parents('form').submit();
        });

        $('[data-toggle="tooltip"]').tooltip();

    });
</script>

<script>
    $(function () {
        $('[data-spzoom]').spzoom();

        $('table#promoter-documents-list-table').dataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [6]
            }],
            "language": {
                "info": "Showing _START_ to _END_ of _TOTAL_ records",
                "lengthMenu": "Show _MENU_ records"
            },
            "pagingType": "full_numbers"
        });
    
        $('#Circular_IssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, })
    });
</script> 

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Facts and Figure(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Facts and Figure(s) Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm()) // "WebindexInfoFactsFigureDetails", "HelpdeskAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.FactsFigure_IndexID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.FactsFigure_ID, htmlAttributes: new { @class = "control-label" })
                                @Html.HiddenFor(model => model.FactsFigure_LanguageFlag, htmlAttributes: new { @class = "control-label" })

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Facts and Figure(s) Details</legend>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">                                                            
                                                            @Html.LabelFor(model => model.Number_RegisteredProjects, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Number of RERA Registered Real-Estate Projects.">
                                                            @Html.EditorFor(model => model.Number_RegisteredProjects, new { htmlAttributes = new { @class = "form-control" } })                                                            
                                                            @Html.ValidationMessageFor(model => model.Number_RegisteredProjects, "", new { @class = "text-danger" })
                                                        </div>                                                        
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">                                                        
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Number_RegisteredAgents, htmlAttributes: new { @class = "control-label mand" })                                                            
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Number of RERA Registered Real-Estate Agents.">
                                                            @Html.EditorFor(model => model.Number_RegisteredAgents, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Number_RegisteredAgents, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">                                                        
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Number_DisposedComplaints, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Number of Disposed Complaints by RERA authority.">
                                                            @Html.EditorFor(model => model.Number_DisposedComplaints, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Number_DisposedComplaints, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Number_PendingProjects, htmlAttributes: new { @class = "control-label mand" })
                                                        </div>
                                                        <div class="col-md-3" data-toggle="tooltip" data-placement="right" title="Number of Pending Projects with RERA authority.">
                                                            @Html.EditorFor(model => model.Number_PendingProjects, new { htmlAttributes = new { @class = "form-control" } })
                                                            @Html.ValidationMessageFor(model => model.Number_PendingProjects, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <fieldset class="col-md-12">
                                                <legend class="my">Other Option(s)</legend>                                                
                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-6">
                                                            <label class="control-label mand">Is Valid for Public View (Yes/No)?</label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label>
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "1") Yes
                                                                @Html.RadioButtonFor(model => model.IsPublicView, "0") No
                                                            </label>
                                                            @Html.ValidationMessageFor(model => model.IsPublicView, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>                                                
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>                                
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <input type="submit" value="@TempData["submitvalue"]" id="BtnMainform" class="btn btn-outline btn-primary" />
                                            &nbsp;
                                            @Html.ActionLink("Reset", "WebindexInfoFactsFigureDetails", "HelpdeskAdmin", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="form-group">                                        
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="promoter-documents-list-table">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">
                                                            @Html.DisplayNameFor(model => model.CreatedOn)
                                                        </th>
                                                        <th>@Html.DisplayName("Public View")</th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Number_RegisteredProjects)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Number_RegisteredAgents)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Number_DisposedComplaints)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Number_PendingProjects)
                                                        </th>
                                                        <th width="10%">@Html.DisplayName("Edit| Delete")</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.prpFactsFigure)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.CreatedOn)
                                                            </td>
                                                            <td>
                                                                @if (item.IsPublicView == 1)
                                                                {
                                                                    @Html.DisplayName("Yes")
                                                                }
                                                                else
                                                                {
                                                                    @Html.DisplayName("No")
                                                                }                                                               
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Number_RegisteredProjects)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Number_RegisteredAgents)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Number_DisposedComplaints)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Number_PendingProjects)
                                                            </td>
                                                            <td>
                                                                @Html.ActionLink("Edit", "Edit_windexInfoFactsFigureDetails", new { pIndexID = item.FactsFigure_IndexID, pKeyID = item.FactsFigure_ID }) @("| ")
                                                                @Html.ActionLink("Delete", "Delete_windexInfoFactsFigureDetails", new { pIndexID = item.FactsFigure_IndexID, pKeyID = item.FactsFigure_ID }, new { onclick = "return confirm('Are sure wants to delete?');" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    <script src="@Url.Content("~/js/jquery.spzoom.js")"></script>
}

