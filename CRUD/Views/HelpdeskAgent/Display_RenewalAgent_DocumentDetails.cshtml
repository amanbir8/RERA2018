                                                                    { //L
                                                                        <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.RenewalAgent_Document_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                                    }
                                                                    else if (item.IsDraft == 5)
                                                                    { //UL
                                                                        <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.RenewalAgent_Document_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                                                    }
                                                                    else if (item.IsDraft == 6)
                                                                    { //PL
                                                                        <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.RenewalAgent_Document_IndexID)" href="javascript:void(0);" title="Unlock Details"><span class="btn btn-outline btn-primary btn-xs disabledlockunlock"><i class="fa fa-key" aria-hidden="true"></i></span></a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a class="a lock-doc-details" data-locknnlockdoc-code="@Html.DisplayFor(modelItem => item.IsDraft)" data-docindex-code="@Html.DisplayFor(modelItem => item.RenewalAgent_Document_IndexID)" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-warning btn-xs disabledlockunlock"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
