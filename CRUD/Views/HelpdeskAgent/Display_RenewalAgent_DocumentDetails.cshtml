                                                    <div class="col-md-5">
                                                        @Html.DisplayFor(model => model.zapRenewalAgentName, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.DisplayName("(")
                                                        @Html.DisplayFor(model => model.zapRenewalAgent_RegistrationNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.DisplayName(")")
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapRenewalAgentLastModifiedOn, htmlAttributes: new { @class = "control-label" })
