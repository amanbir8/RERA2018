<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }
</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmAgentTypeId = $.trim($(document).find('#zapRelated_AgentType_ID').val());
            var parmRnAgentId = $.trim($(document).find('#zapRelated_RenewalAgent_ID').val());
            var parmRnAgentSeqId = $.trim($(document).find('#zapRelated_RenewalAgent_SequenceID').val());
            var parmRnAgentYrId = $.trim($(document).find('#zapRelated_RenewalAgent_YearID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');

            parmAgentId = parseInt(parmAgentId);
            parmAgentTypeId = parseInt(parmAgentTypeId);
            parmRnAgentId = parseInt(parmRnAgentId);
            parmRnAgentSeqId = parseInt(parmRnAgentSeqId);
            parmRnAgentYrId = parseInt(parmRnAgentYrId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zapRenewalAgent_DiaryNumber").val();
            var varAgentName = $("#zapRenewalAgentName").val();

            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/RenewalAgentInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRnAgentId': parmRnAgentId, 'parmRnAgentSeqId': parmRnAgentSeqId, 'parmRnAgentYrId': parmRnAgentYrId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-doclist-details", lockUnlockHandlerDoclist);

        $(document).on("click", "a.lock-doc-details", lockUnlockHandlerDocument);

        //Lock-Unlock-Loader-Handler (Documents list Details)
        var parmLockUnlockdoclist = $.trim($(document).find('#IsDraftRenewalAgentListDocuments').val());
        if (parmLockUnlockdoclist == 1) { //L
            $("#btnLockdoclistDetails").prop('disabled', false);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockdoclistDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Unlock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockdoclist == 5) { //UL
            $("#btnLockdoclistDetails").prop('disabled', false);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockdoclistDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Lock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockdoclist == 6) { //PL
            $("#btnLockdoclistDetails").prop('disabled', true);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Unlock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockdoclistDetails").prop('disabled', true);
            $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockdoclistDetails").attr("title", "Lock Details");
            $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnlockHandlerDoclist() {
        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmAgentTypeId = $.trim($(document).find('#zapRelated_AgentType_ID').val());
            var parmRnAgentId = $.trim($(document).find('#zapRelated_RenewalAgent_ID').val());
            var parmRnAgentSeqId = $.trim($(document).find('#zapRelated_RenewalAgent_SequenceID').val());
            var parmRnAgentYrId = $.trim($(document).find('#zapRelated_RenewalAgent_YearID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftRenewalAgentListDocuments').val());
            var parmRnAgentFlag = 0;
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_RenewalAgent_DocumentList',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRenewalAgentId': parmRnAgentId, 'parmSequenceId': parmRnAgentSeqId, 'parmYearId': parmRnAgentYrId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmRnAgentFlag },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockdoclistDetails").attr("title", "Unlock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockdoclistDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockdoclistDetails").attr("title", "Lock Details");
                        $("#btnLockdoclistDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockdoclistDetails").prop('disabled', true);
                        $("#btnLockdoclistDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
    function lockUnlockHandlerDocument() {
        var elem = $(this);
        var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
        var parmAgentTypeId = $.trim($(document).find('#zapRelated_AgentType_ID').val());
        var parmRnAgentId = $.trim($(document).find('#zapRelated_RenewalAgent_ID').val());
        var parmRnAgentSeqId = $.trim($(document).find('#zapRelated_RenewalAgent_SequenceID').val());
        var parmRnAgentYrId = $.trim($(document).find('#zapRelated_RenewalAgent_YearID').val());
        var parmRnAgentFlag = 0;
        var parmLockUnlockdoc = $(this).attr('data-locknnlockdoc-code');
        var parmDocindex = $(this).attr('data-docindex-code');

        if (parmLockUnlockdoc == 1 || parmLockUnlockdoc == 5) {

            var btnLabel = $(this).attr("title");
            var cnfrmTxt = "Do you want to lock details?";
            if (btnLabel == "Unlock Details") {
                var cnfrmTxt = "Do you want to unlock details?";
            }

            if (confirm(cnfrmTxt)) {
                var baseUrllockunlock = $('body').attr('data-base-url');

                $.ajax({
                    type: 'GET',
                    url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_RenewalAgent_DocumentByIndex',
                    data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRenewalAgentId': parmRnAgentId, 'parmSequenceId': parmRnAgentSeqId, 'parmYearId': parmRnAgentYrId, 'parmLockUnlock': parmLockUnlockdoc, 'parmIndexID': parmRnAgentFlag, 'parmDocByIndex': parmDocindex },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        alert(data.status);
                        if (data.statusCode == 101) {
                            elem.find("span").removeClass("btn-warning").addClass("btn-primary");
                            elem.attr("title", "Unlock Details");
                            elem.find("i").removeClass("fa-unlock").addClass("fa-key");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        } else if (data.statusCode == 105) {
                            elem.find("span").removeClass("btn-primary").addClass("btn-warning");
                            elem.attr("title", "Lock Details");
                            elem.find("i").removeClass("fa-key").addClass("fa-unlock");
                            elem.prop('disabled', true);
                            elem.find("span").addClass("disabledlockunlock");
                        }
                    },
                    failure: function (data) {
                        alert('Bad Request! Failed');
                    },
                    error: function (err) {
                        alert('Bad Request! Error');
                    }
                });
            }
        }
        else {
            $(this).preventDefault();
        }
    }
</script>

<div id="wrapper">
