@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RenewalAgent_DiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [7, 8]
            }]
        });

        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var renewalagentDetailsModal = $(document).find('#myModal');
            $(renewalagentDetailsModal).find('.modal-body').html('');
            var AgentID = $.trim($(parentRow).find('input.hdnAgentID').val());
            var AgentTypeID = $.trim($(parentRow).find('input.hdnAgentTypeID').val());
            var RnAgentID = $.trim($(parentRow).find('input.hdnRnAgentID').val());
            var RnAgentSeqID = $.trim($(parentRow).find('input.hdnRnAgentSeqID').val());
            var RnAgentYrID = $.trim($(parentRow).find('input.hdnRnAgentYrID').val());
            AgentID = parseInt(AgentID);
            AgentTypeID = parseInt(AgentTypeID);
            RnAgentID = parseInt(RnAgentID);
            RnAgentSeqID = parseInt(RnAgentSeqID);
            RnAgentYrID = parseInt(RnAgentYrID);
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/RenewalAgentInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentid': AgentID, 'agenttypeid': AgentTypeID, 'rnagentid': RnAgentID, 'rnagentseqid': RnAgentSeqID, 'rnagentyrid': RnAgentYrID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(renewalagentDetailsModal).find('.modal-body').html(response);
                    $(renewalagentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var renewalagentDiaryNo = $.trim($(parentRow).find('td.renewalagent-diary-number').attr('data-renewaldiary-number'));
            var renewalagentName = $.trim($(parentRow).find('td.renewalagent-name').attr('data-renewalagent-name'));
            $(renewalagentDetailsModal).find('h4.modal-title a').html(renewalagentDiaryNo + ' (' + renewalagentName + ')');
            $(renewalagentDetailsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var myBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = myBASE_URL + 'HelpdeskAgent/WithdrawnApplicationsforRenewalAgent_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerREAgentRegistrationdetails);
    });
    function infohelpHandlerREAgentRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Registration(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Withdrawn applications for renewal of registrations/ RERA number regarding real-estate agent(s) by authority.<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Real Estate Agents : Renewal of Registration</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Real Estate Agents (Form-J) : Withdrawn Application(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.RenewalAgentDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.Related_RERAnumberRegistration)</th>
                                            <th>@Html.DisplayNameFor(model => model.RenewalAgent_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.RenewalAgent_AddressDistrictName)</th>
                                            <th>@Html.DisplayName("Application Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="renewalagent-diary-number" data-renewaldiary-number="@Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)">@Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Related_RERAnumberRegistration)</td>
                                                <td class="renewalagent-name" data-renewalagent-name="@Html.DisplayFor(modelItem => item.RenewalAgent_Name)">@Html.DisplayFor(modelItem => item.RenewalAgent_Name)</td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.RenewalAgent_AddressDistrictName)
                                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnAgentID" })
                                                    @Html.HiddenFor(modelItem => item.Related_AgentType_ID, new { @class = "hdnAgentTypeID" })
                                                    @Html.HiddenFor(modelItem => item.Related_RenewalAgent_SequenceID, new { @class = "hdnRnAgentSeqID" })
                                                    @Html.HiddenFor(modelItem => item.Related_RenewalAgent_Year, new { @class = "hdnRnAgentYrID" })
                                                    @Html.HiddenFor(modelItem => item.Related_RenewalAgent_ID, new { @class = "hdnRnAgentID" })
                                                </td>
                                                <td>@Html.DisplayFor(modelItem => item.Application_Date)</td>
                                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                <td class="center">
                                                    <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                </td>
                                                <td class="center">
                                                    @Html.ActionLink("View", "RenewalAgentInfoEventInsertAction", new { AgentID = item.Related_Agent_ID, AgentTypeID = item.Related_AgentType_ID, RnAgentID = item.Related_RenewalAgent_ID, RnAgentSeqID = item.Related_RenewalAgent_SequenceID, RnAgentYrID = item.Related_RenewalAgent_Year, RnAgentDN = item.RenewalAgentDiaryNumber_Name, RnAgentNM = item.RenewalAgent_Name, RnAgentRN = item.Related_RERAnumberRegistration, RnAgentLMOn = item.EventAction_IdentifiedOn })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
