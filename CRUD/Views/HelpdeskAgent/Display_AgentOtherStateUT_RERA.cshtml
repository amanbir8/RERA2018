@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthDesk_View_AgentOtherStateUT_RERA

<link href="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.css")" rel="stylesheet" />
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            var AgentId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            AgentId = parseInt(AgentId);
            var checklistcriteriacode = $(this).attr('data-criteria-code');
            var criteriaCode = parseInt(checklistcriteriacode);
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/AgentInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    //alert(1);
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });

            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(projectDetailsModal).find('h4.modal-title').html('Checklist Criteria Details <a href="javascript:void(0);"></a>');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

<script>
    $(document).ready(function () {

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 25,
            "lengthMenu": [[25, 50, 75, 100], [25, 50, 75, 100]]
        });

    });
</script>
<style>
    .disabledlockunlock {
        cursor: not-allowed;
    }
</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');

            parmAgentId = parseInt(parmAgentId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zapAgent_DiaryNumber").val();
            var varAgentName = $("#zapAgentName").val();

            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-agent-otherstateRERA-details", lockUnlockHandlerAgentOtherStateRERADetails);

        //Lock-Unlock-Loader-Handler (Agent other state RERA Details)
        var parmLockUnlockagentotherRERA = $.trim($(document).find('#IsDraftAgentOtherStateRERA').val());
        if (parmLockUnlockagentotherRERA == 1) { //L
            $("#btnLockAgentOtherRERA").prop('disabled', false);
            $("#btnLockAgentOtherRERA").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentOtherRERA").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentOtherRERA").attr("title", "Unlock Details");
            $("#btnLockAgentOtherRERA").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockagentotherRERA == 5) { //UL
            $("#btnLockAgentOtherRERA").prop('disabled', false);
            $("#btnLockAgentOtherRERA").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentOtherRERA").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentOtherRERA").attr("title", "Lock Details");
            $("#btnLockAgentOtherRERA").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockagentotherRERA == 6) { //PL
            $("#btnLockAgentOtherRERA").prop('disabled', true);
            $("#btnLockAgentOtherRERA").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentOtherRERA").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentOtherRERA").attr("title", "Unlock Details");
            $("#btnLockAgentOtherRERA").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockAgentOtherRERA").prop('disabled', true);
            $("#btnLockAgentOtherRERA").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentOtherRERA").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentOtherRERA").attr("title", "Lock Details");
            $("#btnLockAgentOtherRERA").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnlockHandlerAgentOtherStateRERADetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftAgentOtherStateRERA').val());
            var parmIndexID = $.trim($(document).find('#Agent_OtherStateUT_regRERA_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_Agent_OtherStateUT_RERA',
                data: { 'parmAgentId': parmAgentId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockAgentOtherRERA").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockAgentOtherRERA").attr("title", "Unlock Details");
                        $("#btnLockAgentOtherRERA").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockAgentOtherRERA").prop('disabled', true);
                        $("#btnLockAgentOtherRERA").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockAgentOtherRERA").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockAgentOtherRERA").attr("title", "Lock Details");
                        $("#btnLockAgentOtherRERA").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockAgentOtherRERA").prop('disabled', true);
                        $("#btnLockAgentOtherRERA").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Real Estate Agent Application Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    RERA Registration Details with Other State/UT Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Real Estate Agent Application - ( @Html.DisplayFor(model => model.zapAgent_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zapAgentName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5">
                                                        @Html.DisplayFor(model => model.zapAgentName, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapAgentLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zapAgentLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.HiddenFor(model => model.Agent_OtherStateUT_regRERA_IndexID)
                                                        @Html.HiddenFor(model => model.zapAgent_DiaryNumber)
                                                        @Html.HiddenFor(model => model.zapAgentName)
                                                        @Html.HiddenFor(model => model.zapRelated_Agent_ID)
                                                        @Html.HiddenFor(model => model.IsDraftAgentOtherStateRERA)
                                                        @Html.HiddenFor(model => model.IsDraft)
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskAgentNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;">
                                        <a data-criteria-code="514" class="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>RERA Registration Details with Other State/UT Details
                                        <span class="pull-right">
                                            <a class="modalOpenerButtonExpandChecklist" data-criteria-code="514" data-subcriteria-code="0" data-criteria-flag="1" href="javascript:void(0);" title="View Checklist"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-check-square-o" aria-hidden="true"></i></span></a>
                                            <a class="a lock-agent-otherstateRERA-details" id="btnLockAgentOtherRERA" href="javascript:void(0);" title="Lock Details"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-unlock" aria-hidden="true"></i></span></a>
                                        </span>
                                    </h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                                <thead>
                                                    <tr>
                                                        <th>@Html.DisplayName("Sr No")</th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_Number)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.StateCode)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_IssueDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_ExpiryDate)
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int sno = 0;
                                                    }
                                                    @foreach (var item in Model.Agent_OtherStateUTMember)
                                                    {
                                                        {
                                                            sno = sno + 1;
                                                        }
                                                        <tr class="odd gradeX">
                                                            <td>@Html.DisplayName(sno.ToString())</td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_Number)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.StateCode)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_IssueDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_ExpiryDate)
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>                          
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

