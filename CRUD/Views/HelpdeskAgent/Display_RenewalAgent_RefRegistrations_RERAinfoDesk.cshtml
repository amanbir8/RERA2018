@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthDesk_View_RenewalAgent_RefRegistration_RERA

<script>
    $(document).ready(function () {

        $('#dataTables-example').DataTable({
            responsive: true
        });

    });
</script>
<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalPrevRegistrationsDetail', function (e) {
            e.preventDefault();
            var elem = $(this);            
            var rnaDetailsModal = $(document).find('#myModal');
            $(rnaDetailsModal).find('.modal-body').html('');
            //debugger;
            //var parentRow = $(this).closest("tr");
            var parentRow = $(elem).parents('tr');
            var AgentId = $.trim($(parentRow).find('input.hdnAgentId').val());
            var AgentType = $.trim($(parentRow).find('input.hdnAgentTypeId').val());
            var RnAgentId = $.trim($(parentRow).find('input.hdnRenewalAgentId').val());
            var RnAgentSeqId = $.trim($(parentRow).find('input.hdnRenewalSeqId').val());
            var RnAgentYrId = $.trim($(parentRow).find('input.hdnRenewalYrId').val());
            AgentId = parseInt(AgentId);
            AgentType = parseInt(AgentType);
            RnAgentId = parseInt(RnAgentId);
            RnAgentSeqId = parseInt(RnAgentSeqId);
            RnAgentYrId = parseInt(RnAgentYrId);
            
            var varcode = $.trim($(parentRow).find('td.renewalflag-code').attr('data-renewalflag-code'));
            var flagCode = parseInt(varcode);
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RenewalAgentInfo_PrevRegistrationsDetail',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId, 'AgentType': AgentType, 'RnAgentId': RnAgentId, 'RnAgentSeqId': RnAgentSeqId, 'RnAgentYrId': RnAgentYrId, 'flagCode': flagCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(rnaDetailsModal).find('.modal-body').html(response);
                }
            });

            var rndiaryNo = $.trim($(parentRow).find('td.renewal-diarynumber').attr('data-renewal-diarynumber'));
            var rnreraNo = $.trim($(parentRow).find('td.renewal-reranumber').attr('data-renewal-reranumber'));
            $(rnaDetailsModal).find('h4.modal-title').html('Registration History - <a href="javascript:void(0);"></a>');
            $(rnaDetailsModal).find('.modal-title a').html(rnreraNo + ' (' + rndiaryNo + ')');
            $(rnaDetailsModal).modal('show');
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Real-Estate Agents : Renewal RERA Number Registration(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Registration History Details with RERA Punjab
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <fieldset class="col-md-12">
                                            <legend class="my">Real Estate Agent Application - ( @Html.DisplayFor(model => model.zapRenewalAgent_DiaryNumber, new { htmlAttributes = new { @class = "form-control" } }) ) Details</legend>
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-3">
                                                        @Html.LabelFor(model => model.zapRenewalAgentName, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-5">
                                                        @Html.DisplayFor(model => model.zapRenewalAgentName, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.DisplayName("(")
                                                        @Html.DisplayFor(model => model.zapRenewalAgent_RegistrationNumber, new { htmlAttributes = new { @class = "form-control" } })
                                                        @Html.DisplayName(")")
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.LabelFor(model => model.zapRenewalAgentLastModifiedOn, htmlAttributes: new { @class = "control-label" })
                                                    </div>
                                                    <div class="col-md-2">
                                                        @Html.DisplayFor(model => model.zapRenewalAgentLastModifiedOn, new { htmlAttributes = new { @class = "form-control" } })
                                                    </div>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AuthorityDeskRenewalAgentRERAnumberNavMenuPartial")
                            <div class="row">
                                <div class="col-lg-12">
                                    <h4 class="page-header" style="margin-top: 15px;"><a href="javascript:void(0);"><i class="fa fa-list-ul fa-fw"></i> </a>Registration History Details with RERA Punjab</h4>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="table-responsive">
                                            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                                <thead>
                                                    <tr>
                                                        <th>@Html.DisplayName("Sr No")</th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Agent_Reference_DiaryNumber)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.Agent_Name)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_Number)
                                                        </th>                                                        
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_IssueDate)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => model.RERAregistration_ExpiryDate)
                                                        </th>
                                                        <th>@Html.DisplayName("View Detail")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        int sno = 0;
                                                    }
                                                    @foreach (var item in Model.Agent_RefRegistrationsRERA)
                                                    {
                                                        {
                                                            sno = sno + 1;
                                                        }
                                                        <tr class="odd gradeX">
                                                            <td>@Html.DisplayName(sno.ToString())</td>
                                                            <td class="renewal-diarynumber" data-renewal-diarynumber="@Html.DisplayFor(modelItem => item.Agent_Reference_DiaryNumber)">
                                                                @Html.DisplayFor(modelItem => item.Agent_Reference_DiaryNumber)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Agent_Name)                                                                
                                                            </td>
                                                            <td class="renewal-reranumber" data-renewal-reranumber="@Html.DisplayFor(modelItem => item.RERAregistration_Number)">
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_Number)
                                                            </td>                                                            
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_IssueDate)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.RERAregistration_ExpiryDate)
                                                            </td>
                                                            <td class="renewalflag-code" data-renewalflag-code="@Html.DisplayFor(modelItem => item.Related_Agent_RefRegistrations_RERA_ID)">
                                                                @*@Html.DisplayName("View")*@
                                                                <a class="modalPrevRegistrationsDetail" href="javascript:void(0);">View</a>
                                                                @Html.HiddenFor(modelItem => item.RenewalAgent_ID, new { @class = "hdnRenewalAgentId" })
                                                                @Html.HiddenFor(modelItem => item.RenewalOrderSequence, new { @class = "hdnRenewalSeqId" })
                                                                @Html.HiddenFor(modelItem => item.RelatedRenewalAgent_Year, new { @class = "hdnRenewalYrId" })
                                                                @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnAgentId" })
                                                                @Html.HiddenFor(modelItem => item.Related_Agent_Type, new { @class = "hdnAgentTypeId" })
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>                          
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Checklist Criteria Details</h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>
    
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet"></link>
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
