@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_AgentEventLog


<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script type="text/javascript">

    @if (TempData["EventSubmitMessage"].ToString() != "")
    { <text >
            $(document).ready(function()
                {
                swal({
                title: "Message",
                    text: "@TempData["EventSubmitMessage"]",
                    type: "success"
                }, function () {
                    window.location = "../HelpdeskAgent/AgentInfoDeskIssueRERAid";
                });
            }); </text>
    }


</script>

<script type="text/javascript">
    $(document).ready(function () {

        $('#EventAction_Type').change(function () {

            var BASE_URLn = $('body').attr('data-base-url');

            $.ajax({
                type: "POST",
                url: BASE_URLn + 'HelpdeskAgent/GetEventDescriptionMasterForRERAnumberByCode',
                datatype: "Json",
                data: { EventCode: $('#EventAction_Type').val() },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    $.each(data, function (index, value) {

                        $('#getEventDescFileInfo').show();
                        $('#EventDescDiscription').text("Description : " + value.EventAction_Description);
                    });
                }
            });
        });
    });
</script>

<script>
    $(document).ready(function () {

        var BASE_URLm = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true
        });

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var projectId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            //debugger;
            projectId = parseInt(projectId);
            //var rowIndex = $(this).parent().index();
            var checklistcriteriacode = $(this).closest('tr').find('.checklist-criteria-code').attr('data-criteria-code');
            //var checklistcriteriacode = $(this).parent('td.checklist-criteria-code').attr('data-criteria-code');
            //var checklistcriteriacode = $.trim($(parentRow).find('td.checklist-criteria-code').attr('data-criteria-code'));
            var criteriaCode = parseInt(checklistcriteriacode);
            var varDNumber = $("#Agent_DiaryNumber").val();
            var varProjectName = $.trim($(document).find("div.agent-name").text());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/AgentInfoCheckListNoAcceptDisplay',
                dataType: 'HTML',
                type: 'GET',
                data: { 'projectId': projectId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    //alert(1);
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('h4.modal-title').html('Checklist Criteria Details - <a href="javascript:void(0);"></a>');
                    $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varProjectName + ')');
                    $(projectDetailsModal).find('table.checklist-details-table').DataTable({
                        responsive: true,
                        /* columns: [
                            { width: '20%' },
                            { width: '20%' },
                            { width: '25%' },
                            { width: '5%' },
                            { width: '10%' },
                            { width: '10%' },
                            { width: '5%' }
                        ] */
                    });
                }
            });

            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

<script type="text/javascript">
    $(document).ready(function () {

        $('#chkYesSameChecklist').on("click", function () {
            if ($(this).is(':checked')) {

                var BASE_URLn = $('body').attr('data-base-url');

                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskAgent/GetCriteriaDescription_NotAccepted_ByAgentID',
                    datatype: "Json",
                    data: { AgentId: $('#Related_Agent_ID').val() },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        $('#getChecklistDescFileInfo').show();
                        $('#ChecklistDescDiscription').text("Checklist Criteria Description : " + data);
                        $('#Remarks_IfAny').text("Remarks as " + data);
                    }
                });

            } else {
                $('#getChecklistDescFileInfo').hide();
                $('#Remarks_IfAny').text('');
            }
        });

    });
</script>

<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonCode', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var AgentId = $('#Related_Agent_ID').val();
            AgentId = parseInt(AgentId);
            var varDNumber = $("#Agent_DiaryNumber").val();
            var varAgentName = $.trim($(document).find("div.agent-name").text());
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(projectDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>


