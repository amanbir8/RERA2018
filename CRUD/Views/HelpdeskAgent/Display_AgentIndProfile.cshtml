</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');

            parmAgentId = parseInt(parmAgentId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zapAgent_DiaryNumber").val();
            var varAgentName = $("#zapAgentName").val();

            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-agent-details", lockUnlockHandlerAgentProfileDetails);

        //Lock-Unlock-Loader-Handler (Agent Details)
        var parmLockUnlockagentprofile = $.trim($(document).find('#IsDraftAgentProfile').val());
        if (parmLockUnlockagentprofile == 1) { //L
            $("#btnLockAgentDetails").prop('disabled', false);
            $("#btnLockAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentDetails").attr("title", "Unlock Details");
            $("#btnLockAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockagentprofile == 5) { //UL
            $("#btnLockAgentDetails").prop('disabled', false);
            $("#btnLockAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentDetails").attr("title", "Lock Details");
            $("#btnLockAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockagentprofile == 6) { //PL
            $("#btnLockAgentDetails").prop('disabled', true);
            $("#btnLockAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentDetails").attr("title", "Unlock Details");
            $("#btnLockAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockAgentDetails").prop('disabled', true);
            $("#btnLockAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentDetails").attr("title", "Lock Details");
            $("#btnLockAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnlockHandlerAgentProfileDetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmAgentTypeId = $.trim($(document).find('#Agent_Type').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftAgentProfile').val());
            var parmIndexID = $.trim($(document).find('#Agent_ID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_Agent_IndProfileRegistration',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockAgentDetails").attr("title", "Unlock Details");
                        $("#btnLockAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockAgentDetails").prop('disabled', true);
                        $("#btnLockAgentDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockAgentDetails").attr("title", "Lock Details");
                        $("#btnLockAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockAgentDetails").prop('disabled', true);
                        $("#btnLockAgentDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

