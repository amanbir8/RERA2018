@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RenewalAgent_EventLog

<link href="@Url.Content("~/dist/css/sweetalert.css")" rel="stylesheet" />
<script src="@Url.Content("~/dist/js/sweetalert.js")"></script>

<script type="text/javascript">

    @if (TempData["EventSubmitMessage"].ToString() != "")
    {
        if (TempData["EventSubmitMessageRenewalAgentMappingUrlFlag"].ToString() != "ResetFlag")
        {
            <text>
                $(document).ready(function () {
                    swal({
                        title: "Message",
                        text: "@TempData["EventSubmitMessage"]",
                        type: "success"
                    }, function () {
                        window.location = "../@TempData["EventSubmitMessageRenewalAgentMappingUrlFlag"]";
                    });
                });
            </text>
        }
        else
        {
            <text>
                $(document).ready(function()
                    {
                    swal({
                    title: "Message",
                        text: "@TempData["EventSubmitMessage"]",
                        type: "success"
                    }, function () {
                        return true;
                    });
                });
            </text>
        }
    }
</script>
<script type="text/javascript">
    $(document).ready(function () {

        $('#EventAction_Type').change(function () {

            var BASE_URLn = $('body').attr('data-base-url');

            $.ajax({
                type: "POST",
                url: BASE_URLn + 'HelpdeskAgent/GetEventDescriptionMasterByCode',
                datatype: "Json",
                data: { EventCode: $('#EventAction_Type').val() },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (data) {
                    stopPreloader();
                    $.each(data, function (index, value) {

                        $('#getEventDescFileInfo').show();
                        $('#EventDescDiscription').text("Description : " + value.EventAction_Description);
                    });
                }
            });
        });
    });
</script>

<script>
    $(document).ready(function () {

        var BASE_URLm = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true
        });

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var renewalagentDetailsModal = $(document).find('#myModal');
            $(renewalagentDetailsModal).find('.modal-body').html('');            
            var AgentID = $('#Related_Agent_ID').val();
            var AgentTypeID = $('#Related_AgentType_ID').val();
            var RnAgentID = $('#Related_RenewalAgent_ID').val();
            var RnAgentSeqID = $('#Related_RenewalAgent_SequenceID').val();
            var RnAgentYrID = $('#Related_RenewalAgent_Year').val();
            AgentID = parseInt(AgentID);
            AgentTypeID = parseInt(AgentTypeID);
            RnAgentID = parseInt(RnAgentID);
            RnAgentSeqID = parseInt(RnAgentSeqID);
            RnAgentYrID = parseInt(RnAgentYrID);
            var checklistcriteriacode = 0;
            var criteriaCode = parseInt(checklistcriteriacode);
            var varDNumber = $("#RelatedAgent_RenewalDiaryNumber").val();
            var varAgentName = $("#RenewalAgentName").val();
            $(renewalagentDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RenewalAgentInfoCheckListNoAcceptDisplay',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentid': AgentID, 'agenttypeid': AgentTypeID, 'rnagentid': RnAgentID, 'rnagentseqid': RnAgentSeqID, 'rnagentyrid': RnAgentYrID, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(renewalagentDetailsModal).find('.modal-body').html(response);
                    $(renewalagentDetailsModal).find('h4.modal-title').html('Checklist Criteria Details - <a href="javascript:void(0);"></a>');
                    $(renewalagentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
                    $(renewalagentDetailsModal).find('table.checklist-details-table').DataTable({
                        responsive: true,
                    });
                }
            });
            $(renewalagentDetailsModal).modal('show');
        });
    });
</script>
<script type="text/javascript">
    $(document).ready(function () {

        $('#chkYesSameChecklist').on("click", function () {
            if ($(this).is(':checked')) {
                var BASE_URLn = $('body').attr('data-base-url');

                var AgentID = $('#Related_Agent_ID').val();
                var AgentTypeID = $('#Related_AgentType_ID').val();
                var RnAgentID = $('#Related_RenewalAgent_ID').val();
                var RnAgentSeqID = $('#Related_RenewalAgent_SequenceID').val();
                var RnAgentYrID = $('#Related_RenewalAgent_Year').val();
                AgentID = parseInt(AgentID);
                AgentTypeID = parseInt(AgentTypeID);
                RnAgentID = parseInt(RnAgentID);
                RnAgentSeqID = parseInt(RnAgentSeqID);
                RnAgentYrID = parseInt(RnAgentYrID);
                $.ajax({
                    type: "POST",
                    url: BASE_URLn + 'HelpdeskAgent/GetCriteriaDescription_NotAccepted_ByRenewalAgentID',
                    datatype: "Json",
                    data: { 'agentid': AgentID, 'agenttypeid': AgentTypeID, 'rnagentid': RnAgentID, 'rnagentseqid': RnAgentSeqID, 'rnagentyrid': RnAgentYrID },
                    beforeSend: function () {
                        startPreloader();
                    },
                    success: function (data) {
                        stopPreloader();
                        $('#getChecklistDescFileInfo').show();
                        $('#ChecklistDescDiscription').text("Checklist Criteria Description : " + data);
                        $('#Remarks_IfAny').text("Remarks as " + data);
                    }
                });

            } else {
                $('#getChecklistDescFileInfo').hide();
                $('#Remarks_IfAny').text('');
            }
        });

    });
</script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonCode', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var renewalagentDetailsModal = $(document).find('#myModal');
            $(renewalagentDetailsModal).find('.modal-body').html('');
            var AgentID = $('#Related_Agent_ID').val();
            var AgentTypeID = $('#Related_AgentType_ID').val();
            var RnAgentID = $('#Related_RenewalAgent_ID').val();
            var RnAgentSeqID = $('#Related_RenewalAgent_SequenceID').val();
            var RnAgentYrID = $('#Related_RenewalAgent_Year').val();
            AgentID = parseInt(AgentID);
            AgentTypeID = parseInt(AgentTypeID);
            RnAgentID = parseInt(RnAgentID);
            RnAgentSeqID = parseInt(RnAgentSeqID);
            RnAgentYrID = parseInt(RnAgentYrID);
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/RenewalAgentInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentid': AgentID, 'agenttypeid': AgentTypeID, 'rnagentid': RnAgentID, 'rnagentseqid': RnAgentSeqID, 'rnagentyrid': RnAgentYrID },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(renewalagentDetailsModal).find('.modal-body').html(response);
                    $(renewalagentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var varDNumber = $("#RelatedAgent_RenewalDiaryNumber").val();
            //var varAgentName = $.trim($(document).find("div.agent-name").text());
            var varAgentName = $("#RenewalAgentName").val();
            //$(renewalagentDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $(renewalagentDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(renewalagentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(renewalagentDetailsModal).modal('show');
        });
    });
</script>
<script>
   // get remaining words count for textarea
   var maxMessageLength = 2400;
   var messageField = $('#myform_RenewalAgentEventListInsert').find('textarea#Remarks_IfAny');
   $('body').on('input', 'textarea#Remarks_IfAny', function (e) {
       var msgVal = $(this).val();
       var msgValLen = msgVal.length;
       if (msgValLen <= maxMessageLength) {
           var remaining = parseInt(maxMessageLength - msgValLen);
           $(this).parents('.form-group').find('.words-remain').html(remaining + ' characters remaining');
       }
   });
</script>

