@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_AgentSubCheckListLog

@{
    Layout = null;
}

<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandLogDetailsByFlag', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmRelatedAgentID = $.trim($(parentRow).find('input.hdnRelatedAgentID').val());            
            var parmCriteriaID = $.trim($(parentRow).find('input.hdnVarCriteriaCode').val());
            var parmCriteriaSubID = $.trim($(parentRow).find('input.hdnVarCriteriaSubCode').val());

            parmRelatedAgentID = parseInt(parmRelatedAgentID);            
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);

            var varDNumber = $("#zapAgent_DiaryNumber").val();
            var varAgentName = $("#zapAgentName").val();
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoCheckListDisplayLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmRelatedAgentID, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });
    });
</script>

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            @Html.HiddenFor(model => model.zapAgent_DiaryNumber)
            @Html.HiddenFor(model => model.zapAgentName)            
            <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("Sr No")</th>                        
                        <th width="25%">@Html.DisplayName("Criteria Name")</th>
                        <th>@Html.DisplayName("Criteria Requirements")</th>
                        <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                        <th>@Html.DisplayName("Is acceptable? (Yes/No)")</th>
                        <th>@Html.DisplayName("Last Modified Date")</th>
                        <th>@Html.DisplayName("Prepared By")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 0;
                    }
                    @foreach (var item in Model.prpongoing)
                    {
                        {
                            sno = sno + 1;
                        }
                        if (item.IsChecklistValueOk == "ValueZero")
                        {
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>                                
                                <td class="checklist-criteria-code" data-criteria-code="@Html.DisplayFor(modelItem => item.C_column)" width="25%">
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.HiddenFor(modelItem => item.C_column)                                    
                                </td>
                                <td class="warning">
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode)
                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnRelatedAgentID" })                                    
                                    @Html.HiddenFor(modelItem => item.VarCriteriaCode, new { @class = "hdnVarCriteriaCode" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaSubCode, new { @class = "hdnVarCriteriaSubCode" })
                                    @Html.HiddenFor(modelItem => item.zapAgent_DiaryNumber, new { @class = "hdnzapAgent_DiaryNumber" })
                                    @Html.HiddenFor(modelItem => item.zapAgentName, new { @class = "hdnzapAgentName" })
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                <td>@Html.DisplayName("")</td>
                                <td>@Html.DisplayName("")</td>
                                <td>@Html.DisplayName("")</td>
                            </tr>
                        }
                        else if (item.IsChecklistValueOk == "Y")
                        {
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>                                
                                <td class="checklist-criteria-code" data-criteria-code="@Html.DisplayFor(modelItem => item.C_column)" width="25%">
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCodeTitle)
                                    @Html.HiddenFor(modelItem => item.C_column)<br /> 
                                    @Html.DisplayName(" [")
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.DisplayName("]")<br />  
                                    <a class="modalOpenerButtonExpandLogDetailsByFlag" href="javascript:void(0);"><div class="btn btn-info btn-circle">@Html.DisplayFor(modelItem => item.VarChecklistGroupID)</div></a>                                
                                </td>
                                <td class="success">                                    
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode)  
                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnRelatedAgentID" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaCode, new { @class = "hdnVarCriteriaCode" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaSubCode, new { @class = "hdnVarCriteriaSubCode" })
                                    @Html.HiddenFor(modelItem => item.zapAgent_DiaryNumber, new { @class = "hdnzapAgent_DiaryNumber" })
                                    @Html.HiddenFor(modelItem => item.zapAgentName, new { @class = "hdnzapAgentName" })                                  
                                </td>
                                <td class="success">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                <td>
                                    @if (item.IsChecklistValueOk == "Y")
                                    {
                                        @Html.DisplayName("Yes")
                                    }
                                    else if (item.IsChecklistValueOk == "N")
                                    {
                                        @Html.DisplayName("No")
                                    }
                                    else if (item.IsChecklistValueOk == "O")
                                    {
                                        @Html.DisplayName("Exempted")
                                    }
                                    else if (item.IsChecklistValueOk == "P")
                                    {
                                        @Html.DisplayName("To be Provided Later")
                                    }
                                    else
                                    {
                                        @Html.DisplayName("Not Applicable")
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedOn)</td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedBy)</td>
                            </tr>
                        }
                        else if (item.IsChecklistValueOk == "N")
                        {
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>                                
                                <td class="checklist-criteria-code" data-criteria-code="@Html.DisplayFor(modelItem => item.C_column)" width="25%">
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.HiddenFor(modelItem => item.C_column)<br />
                                    @Html.DisplayName(" [")
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.DisplayName("]")<br />
                                    <a class="modalOpenerButtonExpandLogDetailsByFlag" href="javascript:void(0);"><div class="btn btn-info btn-circle">@Html.DisplayFor(modelItem => item.VarChecklistGroupID)</div></a>
                                </td>
                                <td style="background-color:palevioletred;">
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode) 
                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnRelatedAgentID" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaCode, new { @class = "hdnVarCriteriaCode" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaSubCode, new { @class = "hdnVarCriteriaSubCode" })
                                    @Html.HiddenFor(modelItem => item.zapAgent_DiaryNumber, new { @class = "hdnzapAgent_DiaryNumber" })
                                    @Html.HiddenFor(modelItem => item.zapAgentName, new { @class = "hdnzapAgentName" })                                   
                                </td>
                                <td style="background-color:palevioletred;">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                <td>
                                    @if (item.IsChecklistValueOk == "Y")
                                    {
                                        @Html.DisplayName("Yes")
                                    }
                                    else if (item.IsChecklistValueOk == "N")
                                    {
                                        @Html.DisplayName("No")
                                    }
                                    else if (item.IsChecklistValueOk == "O")
                                    {
                                        @Html.DisplayName("Exempted")
                                    }
                                    else if (item.IsChecklistValueOk == "P")
                                    {
                                        @Html.DisplayName("To be Provided Later")
                                    }
                                    else
                                    {
                                        @Html.DisplayName("Not Applicable")
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedOn)</td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedBy)</td>
                            </tr>
                        }
                        else if (item.IsChecklistValueOk == "P")
                        {
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>
                                <td class="checklist-criteria-code" data-criteria-code="@Html.DisplayFor(modelItem => item.C_column)" width="25%">
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.HiddenFor(modelItem => item.C_column)<br />
                                    @Html.DisplayName(" [")
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.DisplayName("]")<br />
                                    <a class="modalOpenerButtonExpandLogDetailsByFlag" href="javascript:void(0);"><div class="btn btn-info btn-circle">@Html.DisplayFor(modelItem => item.VarChecklistGroupID)</div></a>
                                </td>
                                <td class="warning">
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode)
                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnRelatedAgentID" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaCode, new { @class = "hdnVarCriteriaCode" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaSubCode, new { @class = "hdnVarCriteriaSubCode" })
                                    @Html.HiddenFor(modelItem => item.zapAgent_DiaryNumber, new { @class = "hdnzapAgent_DiaryNumber" })
                                    @Html.HiddenFor(modelItem => item.zapAgentName, new { @class = "hdnzapAgentName" })
                                </td>
                                <td style="background-color:plum;">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                <td>
                                    @if (item.IsChecklistValueOk == "Y")
                                    {
                                        @Html.DisplayName("Yes")
                                    }
                                    else if (item.IsChecklistValueOk == "N")
                                    {
                                        @Html.DisplayName("No")
                                    }
                                    else if (item.IsChecklistValueOk == "O")
                                    {
                                        @Html.DisplayName("Exempted")
                                    }
                                    else if (item.IsChecklistValueOk == "P")
                                    {
                                        @Html.DisplayName("To be Provided Later")
                                    }
                                    else
                                    {
                                        @Html.DisplayName("Not Applicable")
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedOn)</td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedBy)</td>
                            </tr>
                        }
                        else
                        {
                            <tr class="odd gradeX">
                                <td>@Html.DisplayName(sno.ToString())</td>
                                <td class="checklist-criteria-code" data-criteria-code="@Html.DisplayFor(modelItem => item.C_column)" width="25%">
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.HiddenFor(modelItem => item.C_column)<br />
                                    @Html.DisplayName(" [")
                                    @Html.DisplayFor(modelItem => item.CriteriaCode)
                                    @Html.DisplayName("]")<br />
                                    <a class="modalOpenerButtonExpandLogDetailsByFlag" href="javascript:void(0);"><div class="btn btn-info btn-circle">@Html.DisplayFor(modelItem => item.VarChecklistGroupID)</div></a>
                                </td>
                                <td class="warning">
                                    @Html.DisplayFor(modelItem => item.CriteriaSubCode)
                                    @Html.HiddenFor(modelItem => item.Related_Agent_ID, new { @class = "hdnRelatedAgentID" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaCode, new { @class = "hdnVarCriteriaCode" })
                                    @Html.HiddenFor(modelItem => item.VarCriteriaSubCode, new { @class = "hdnVarCriteriaSubCode" })
                                    @Html.HiddenFor(modelItem => item.zapAgent_DiaryNumber, new { @class = "hdnzapAgent_DiaryNumber" })
                                    @Html.HiddenFor(modelItem => item.zapAgentName, new { @class = "hdnzapAgentName" })
                                </td>
                                <td class="info">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                                <td>
                                    @if (item.IsChecklistValueOk == "Y")
                                    {
                                        @Html.DisplayName("Yes")
                                    }
                                    else if (item.IsChecklistValueOk == "N")
                                    {
                                        @Html.DisplayName("No")
                                    }
                                    else if (item.IsChecklistValueOk == "O")
                                    {
                                        @Html.DisplayName("Exempted")
                                    }
                                    else if (item.IsChecklistValueOk == "P")
                                    {
                                        @Html.DisplayName("To be Provided Later")
                                    }
                                    else
                                    {
                                        @Html.DisplayName("Not Applicable")
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedOn)</td>
                                <td>@Html.DisplayFor(modelItem => item.CheckList_IdentifiedBy)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
