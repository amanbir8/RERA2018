<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmAgentTypeId = $.trim($(document).find('#zapRelated_AgentType_ID').val());
            var parmRnAgentId = $.trim($(document).find('#zapRelated_RenewalAgent_ID').val());
            var parmRnAgentSeqId = $.trim($(document).find('#zapRelated_RenewalAgent_SequenceID').val());
            var parmRnAgentYrId = $.trim($(document).find('#zapRelated_RenewalAgent_YearID').val());
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');

            parmAgentId = parseInt(parmAgentId);
            parmAgentTypeId = parseInt(parmAgentTypeId);
            parmRnAgentId = parseInt(parmRnAgentId);
            parmRnAgentSeqId = parseInt(parmRnAgentSeqId);
            parmRnAgentYrId = parseInt(parmRnAgentYrId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zapRenewalAgent_DiaryNumber").val();
            var varAgentName = $("#zapRenewalAgentName").val();

            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/RenewalAgentInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRnAgentId': parmRnAgentId, 'parmRnAgentSeqId': parmRnAgentSeqId, 'parmRnAgentYrId': parmRnAgentYrId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-renewalagent-details", lockUnlockHandlerRenewalAgentDetails);

        $(document).on("click", "a.lock-othermembers-details", lockUnlockHandlerOtherMemberDetails);

        //Lock-Unlock-Loader-Handler (Renewal-Agent Details)
        var parmLockUnlockrenewalagent = $.trim($(document).find('#IsDraftRenewalAgent').val());
        if (parmLockUnlockrenewalagent == 1) { //L
            $("#btnLockRenewalAgentDetails").prop('disabled', false);
            $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockRenewalAgentDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockRenewalAgentDetails").attr("title", "Unlock Details");
            $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockrenewalagent == 5) { //UL
            $("#btnLockRenewalAgentDetails").prop('disabled', false);
            $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockRenewalAgentDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockRenewalAgentDetails").attr("title", "Lock Details");
            $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockrenewalagent == 6) { //PL
            $("#btnLockRenewalAgentDetails").prop('disabled', true);
            $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockRenewalAgentDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockRenewalAgentDetails").attr("title", "Unlock Details");
            $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockRenewalAgentDetails").prop('disabled', true);
            $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockRenewalAgentDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockRenewalAgentDetails").attr("title", "Lock Details");
            $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }

        //Lock-Unlock-Loader-Handler (Other-Member Details)
        var parmLockUnlockmember = $.trim($(document).find('#IsDraftOtherMember').val());
        if (parmLockUnlockmember == 1) { //L
            $("#btnLockOtherMemberDetails").prop('disabled', false);
            $("#btnLockOtherMemberDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockOtherMemberDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockOtherMemberDetails").attr("title", "Unlock Details");
            $("#btnLockOtherMemberDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockmember == 5) { //UL
            $("#btnLockOtherMemberDetails").prop('disabled', false);
            $("#btnLockOtherMemberDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockOtherMemberDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockOtherMemberDetails").attr("title", "Lock Details");
            $("#btnLockOtherMemberDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockmember == 6) { //PL
            $("#btnLockOtherMemberDetails").prop('disabled', true);
            $("#btnLockOtherMemberDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockOtherMemberDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockOtherMemberDetails").attr("title", "Unlock Details");
            $("#btnLockOtherMemberDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockOtherMemberDetails").prop('disabled', true);
            $("#btnLockOtherMemberDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockOtherMemberDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockOtherMemberDetails").attr("title", "Lock Details");
            $("#btnLockOtherMemberDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnlockHandlerRenewalAgentDetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());
            var parmAgentTypeId = $.trim($(document).find('#zapRelated_AgentType_ID').val());
            var parmRenewalAgentId = $.trim($(document).find('#zapRelated_RenewalAgent_ID').val());
            var parmSequenceId = $.trim($(document).find('#zapRelated_RenewalAgent_SequenceID').val());
            var parmYearId = $.trim($(document).find('#zapRelated_RenewalAgent_YearID').val());
            var parmLockUnlock = $.trim($(document).find('#IsDraftRenewalAgent').val());
            var parmIndexID = $.trim($(document).find('#RenewalAgent_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_RenewalAgentRegistration',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRenewalAgentId': parmRenewalAgentId, 'parmSequenceId': parmSequenceId, 'parmYearId': parmYearId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockRenewalAgentDetails").attr("title", "Unlock Details");
                        $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockRenewalAgentDetails").prop('disabled', true);
                        $("#btnLockRenewalAgentDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockRenewalAgentDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockRenewalAgentDetails").attr("title", "Lock Details");
                        $("#btnLockRenewalAgentDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockRenewalAgentDetails").prop('disabled', true);
                        $("#btnLockRenewalAgentDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
    function lockUnlockHandlerOtherMemberDetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
