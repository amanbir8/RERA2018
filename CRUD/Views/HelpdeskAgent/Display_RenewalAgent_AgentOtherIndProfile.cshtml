<link href="@Url.Content("~/css/jquery.spzoom.css")" rel="stylesheet" type="text/css" />

<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var rnaDetailsModal = $(document).find('#myModal');
            $(rnaDetailsModal).find('.modal-body').html('');
            var AgentId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            var RnAgentId = 0;
            var RnAgentSeqId = 0;
            var RnAgentYrId = 0;
            AgentId = parseInt(AgentId);
            RnAgentId = parseInt(RnAgentId);
            RnAgentSeqId = parseInt(RnAgentSeqId);
            RnAgentYrId = parseInt(RnAgentYrId);
            var checklistcriteriacode = $(this).attr('data-criteria-code');
            var criteriaCode = parseInt(checklistcriteriacode);
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RenewalAgentInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId, 'RnAgentId': RnAgentId, 'RnAgentSeqId': RnAgentSeqId, 'RnAgentYrId': RnAgentYrId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(rnaDetailsModal).find('.modal-body').html(response);
                }
            });

            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            $(rnaDetailsModal).find('h4.modal-title').html('Checklist Criteria Details <a href="javascript:void(0);"></a>');
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(rnaDetailsModal).modal('show');
        });
    });
</script>

