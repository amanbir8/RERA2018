@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_AgentSubCheckListLog

<script>
    $(document).ready(function () {        

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 25,
            "lengthMenu": [[25, 50, 75, 100], [25, 50, 75, 100]]
        });

    });
</script>

<script>
    $(document).ready(function () {

        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var AgentId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            //debugger;
            AgentId = parseInt(AgentId);
            //var rowIndex = $(this).parent().index();
            var checklistcriteriacode = $(this).closest('tr').find('.checklist-criteria-code').attr('data-criteria-code');
            //var checklistcriteriacode = $(this).parent('td.checklist-criteria-code').attr('data-criteria-code');
            //var checklistcriteriacode = $.trim($(parentRow).find('td.checklist-criteria-code').attr('data-criteria-code'));
            var criteriaCode = parseInt(checklistcriteriacode);             
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/AgentInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    //alert(1);
                    $(projectDetailsModal).find('.modal-body').html(response);
                }
            });            
            
            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(projectDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonExpand', function (e) {
            e.preventDefault();            
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            //debugger;
            var parmAgentId = $.trim($(parentRow).find('input.hdnRelatedAgentID').val());
            var parmCriteriaID = $.trim($(parentRow).find('input.hdnVarCriteriaID').val());
            var parmCriteriaSubID = $.trim($(parentRow).find('input.hdnVarCriteriaSubID').val());            
            parmAgentId = parseInt(parmAgentId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);

            var varDNumber = $("#zapAgent_DiaryNumber").val();
            var varAgentName = $("#zapAgentName").val();
            
            $(projectDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/AgentInfoCheckListDisplayLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
           
            $(projectDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(projectDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>

