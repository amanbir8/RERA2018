</style>
<script>
    $(document).ready(function () {

        var BASE_URL = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonExpandChecklist', function (e) {
            e.preventDefault();
            var elem = $(this);
            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());           
            var parmCriteriaID = $(this).attr('data-criteria-code');
            var parmCriteriaSubID = $(this).attr('data-subcriteria-code');
            var parmCriteriaFlag = $(this).attr('data-criteria-flag');

            parmAgentId = parseInt(parmAgentId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);
            parmCriteriaFlag = parseInt(parmCriteriaFlag);

            var varDNumber = $("#zapAgent_DiaryNumber").val();
            var varAgentName = $("#zapAgentName").val();

            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoCheckListDisplayLogByFlag',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID, 'parmCriteriaFlag': parmCriteriaFlag },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(AgentDetailsModal).find('.modal-body').html(response);
                    $(AgentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(AgentDetailsModal).find('h4.modal-title').html('Checklist History Details - <a href="javascript:void(0);"></a>');
            $(AgentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(AgentDetailsModal).modal('show');
        });

        $(document).on("click", "a.lock-agent-payment-details", lockUnlockHandlerAgentFeeDetails);

        //Lock-Unlock-Loader-Handler (Agent Fee Details)
        var parmLockUnlockagentfee = $.trim($(document).find('#IsDraftAgentPayment').val());
        if (parmLockUnlockagentfee == 1) { //L
            $("#btnLockAgentFeeDetails").prop('disabled', false);
            $("#btnLockAgentFeeDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentFeeDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentFeeDetails").attr("title", "Unlock Details");
            $("#btnLockAgentFeeDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else if (parmLockUnlockagentfee == 5) { //UL
            $("#btnLockAgentFeeDetails").prop('disabled', false);
            $("#btnLockAgentFeeDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentFeeDetails").find("span").removeClass("disabledlockunlock");
            $("#btnLockAgentFeeDetails").attr("title", "Lock Details");
            $("#btnLockAgentFeeDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
        else if (parmLockUnlockagentfee == 6) { //PL
            $("#btnLockAgentFeeDetails").prop('disabled', true);
            $("#btnLockAgentFeeDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
            $("#btnLockAgentFeeDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentFeeDetails").attr("title", "Unlock Details");
            $("#btnLockAgentFeeDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
        }
        else {
            $("#btnLockAgentFeeDetails").prop('disabled', true);
            $("#btnLockAgentFeeDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
            $("#btnLockAgentFeeDetails").find("span").addClass("disabledlockunlock");
            $("#btnLockAgentFeeDetails").attr("title", "Lock Details");
            $("#btnLockAgentFeeDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
        }
    });

    function lockUnlockHandlerAgentFeeDetails() {

        var btnLabel = $(this).attr("title");
        var cnfrmTxt = "Do you want to lock details?";
        if (btnLabel == "Unlock Details") {
            var cnfrmTxt = "Do you want to unlock details?";
        }

        if (confirm(cnfrmTxt)) {

            var parmAgentId = $.trim($(document).find('#zapRelated_Agent_ID').val());            
            var parmLockUnlock = $.trim($(document).find('#IsDraftAgentPayment').val());
            var parmIndexID = $.trim($(document).find('#AgentPayment_IndexID').val());
            var baseUrllockunlock = $('body').attr('data-base-url');

            $.ajax({
                type: 'GET',
                url: baseUrllockunlock + 'HelpdeskAgent/LockUnlockHandler_Agent_RegistrationPayment',
                data: { 'parmAgentId': parmAgentId, 'parmLockUnlock': parmLockUnlock, 'parmIndexID': parmIndexID },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data.status);
                    if (data.statusCode == 101) {
                        $("#btnLockAgentFeeDetails").find("span").removeClass("btn-warning").addClass("btn-primary");
                        $("#btnLockAgentFeeDetails").attr("title", "Unlock Details");
                        $("#btnLockAgentFeeDetails").find("i").removeClass("fa-unlock").addClass("fa-key");
                        $("#btnLockAgentFeeDetails").prop('disabled', true);
                        $("#btnLockAgentFeeDetails").find("span").addClass("disabledlockunlock");
                    } else if (data.statusCode == 105) {
                        $("#btnLockAgentFeeDetails").find("span").removeClass("btn-primary").addClass("btn-warning");
                        $("#btnLockAgentFeeDetails").attr("title", "Lock Details");
                        $("#btnLockAgentFeeDetails").find("i").removeClass("fa-key").addClass("fa-unlock");
                        $("#btnLockAgentFeeDetails").prop('disabled', true);
                        $("#btnLockAgentFeeDetails").find("span").addClass("disabledlockunlock");
                    }
                },
                failure: function (data) {
                    alert('Bad Request! Failed');
                },
                error: function (err) {
                    alert('Bad Request! Error');
                }
            });
        }
    }
</script>

