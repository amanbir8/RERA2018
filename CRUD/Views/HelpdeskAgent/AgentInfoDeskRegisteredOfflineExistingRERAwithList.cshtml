@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_AgentRERAnumberOfflineRegisteredDetails

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
        });        
    });
</script>
<script>
    $(document).ready(function () {
        var myBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = myBASE_URL + 'HelpdeskAgent/RegistrationsforRealEstateAgent_Offline_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerREAgentRegistrationdetails);
    });
    function infohelpHandlerREAgentRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Registration(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Offline Approved applications for registrations/ RERA number regarding real-estate agent(s) by authority (list of ‘OFF-LINE’ registered agent(s) before 13 April, 2018).<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">List of Real Estate Agents : Offline Registered Real Estate Agent(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Real Estate Agents : Offline Registered Real Estate Agent(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_RERAregistrationNumber)</th>
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_AgentName_OrganizationName)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_BusinessPlaceDistrict)</th>
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_ContactDetails)</th>
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_RERAregistrationIssueDate)</th>
                                            <th>@Html.DisplayNameFor(model => model.OfflineAgents_RERAregistrationValidUptoDate)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_RERAregistrationNumber)</td>
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_AgentName_OrganizationName)</td>                                                    
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_BusinessPlaceDistrict)</td>
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_ContactDetails)</td>
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_RERAregistrationIssueDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.OfflineAgents_RERAregistrationValidUptoDate)</td>                                                    
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet"></link> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
