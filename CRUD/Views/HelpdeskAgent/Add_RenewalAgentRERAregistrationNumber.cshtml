<script type="text/javascript">
    $(document).ready(function () {
               
        $("input[name='IsAlreadyRegistration']").click(function () {
            if ($("#chkYes").is(":checked")) {                
                $("#idReraNo").show();                
                $('#ExistingRegistration').attr('readonly', false);
                $('#Organization_Name').attr('readonly', false);
                $('#Agent_FirstName').attr('readonly', false);                
                $('#Agent_LastName').attr('readonly', false);
            }
            else {
                $("#idReraNo").hide();
                $('#Organization_Name').attr('readonly', false);
                $('#Agent_FirstName').attr('readonly', false);                
                $('#Agent_LastName').attr('readonly', false);
            }
        });


        if ($("#chkYes").is(":checked")) {
            $("#idReraNo").show();            
            $('#ExistingRegistration').attr('readonly', false);
            $('#Organization_Name').attr('readonly', false);
            $('#Agent_FirstName').attr('readonly', false);            
            $('#Agent_LastName').attr('readonly', false);
        }
        else {
            $("#idReraNo").hide();            
            $('#Organization_Name').attr('readonly', false);
            $('#Agent_FirstName').attr('readonly', false);            
            $('#Agent_LastName').attr('readonly', false);
            $('#ExistingRegistration').attr('readonly', false);
            $('#ExistingRegistration').val("");
        }

        if ($('#Agent_Type').val() == "1") {
            $("#idReraAgentNameL1").show();            
            $("#idReraOrgnizationName").hide();            
        }
        else {
            $("#idReraAgentNameL1").hide();            
            $("#idReraOrgnizationName").show();                    
        }
    });
</script>
<script>
    $(function () {
        $('#Agent_RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#Agent_RERAnumberRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        $('#LatestRenewalAgent_RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#LatestRenewalAgent_RERAnumberRegUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        $('#LatestRenewalAgent_RERAnumberIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, }).on("change", function () {
            var d = new Date($(this).val());
            var year = d.getFullYear();
            var month = d.getMonth() + 1;
            var day = d.getDate();
            var c = new Date(year + 5, month, day - 1)
            var expiryDate1 = (c.getMonth()) + '-' + c.getDate() + '-' + c.getFullYear();
            expiryDate1 = new Date(expiryDate1);
            $('#LatestRenewalAgent_RERAnumberRegUptoDate').datepicker('setDate', expiryDate1);
        });

        $('[data-toggle="tooltip"]').tooltip();
    });
</script>
<script>
    $(function () {
        var baseUrl = $('body').attr('data-base-url');
        $.ajax({
            type: "GET",
            url: baseUrl + "Agent/GetState",
            datatype: "Json",
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#BComm_AddressStateCode').append('<option value="' + value.StateId + '">' + value.StateName + '</option>');
                    $("#BComm_AddressStateCode option:contains(undefined)").remove();
                });
            }
        });

        $('#BComm_AddressStateCode').change(function () {
            $('#BComm_AddressDistrictCode').empty();
            $.ajax({
                type: "POST",
                url: baseUrl + "Agent/GetDistrictByStateId",
                datatype: "Json",
                data: { StateId: $('#BComm_AddressStateCode').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        $('#BComm_AddressDistrictCode').append('<option value="' + value.DistrictId + '">' + value.DistrictName + '</option>');
                    });
                }
            });
        });
    });
</script>
