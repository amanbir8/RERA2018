<script>
    $(document).ready(function () {
        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButtonRegNumberCalc', function (e) {
            e.preventDefault();
            var elem = $(this);
            var agentDetailsModal = $(document).find('#myModal');
            $(agentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#Related_Agent_ID').val());
            var parmdocFlag = $(this).attr('data-document-flag');
            parmAgentId = parseInt(parmAgentId);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = elem.attr('data-rndairy-number');
            var varAgentName = elem.attr('data-rnagent-name');
            $(agentDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RealestateRnAgentRegistrationNumberRecordsCalculator',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentId': parmAgentId, 'varflag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(agentDetailsModal).find('.modal-body').html(response);
                }
            });
            $(agentDetailsModal).find('h4.modal-title').html('Registration Number Detail - <a href="javascript:void(0);"></a>');
            $(agentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(agentDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonRegNumHistory', function (e) {
            e.preventDefault();
            var elem = $(this);
            var agentDetailsModal = $(document).find('#myModal');
            $(agentDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(document).find('#Related_Agent_ID').val());
            var parmRnAgentId = $.trim($(document).find('#Related_RenewalAgent_ID').val());
            var parmRnAgentSeqId = $.trim($(document).find('#Related_RenewalOrderSequence').val());
            var parmRnAgentYrId = $.trim($(document).find('#Related_RelatedRenewalAgent_Year').val());
            var parmdocFlag = $(this).attr('data-document-flag');
            parmAgentId = parseInt(parmAgentId);
            parmRnAgentId = parseInt(parmRnAgentId);
            parmRnAgentSeqId = parseInt(parmRnAgentSeqId);
            parmRnAgentYrId = parseInt(parmRnAgentYrId);
            parmdocFlag = parseInt(parmdocFlag);

            var varDNumber = elem.attr('data-rndairy-number');
            var varAgentName = elem.attr('data-rnagent-name');
            $(agentDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RealestateRnAgentRegistrationNumberRecordsHistory',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentId': parmAgentId, 'rnagentId': parmRnAgentId, 'rnagentseqId': parmRnAgentSeqId, 'rnagentyrId': parmRnAgentYrId, 'varflag': parmdocFlag },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(agentDetailsModal).find('.modal-body').html(response);
                    $(agentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            $(agentDetailsModal).find('h4.modal-title').html('Registration Number History - <a href="javascript:void(0);"></a>');
            $(agentDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(agentDetailsModal).modal('show');
        });
    });
</script>
<script type="text/javascript">
    $(function () {
        $('#LatestRenewalAgent_RERAnumberRegistration').change(function () {
            var RegdNo = $("#LatestRenewalAgent_RERAnumberRegistration").val();
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "HelpdeskAgent/Check_RealestateAgentRenewal_RERAregistrationNumber",
                data: '{mRegNumber: "' + RegdNo + '" }',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response) {
                        alert("Registration Number Already exist! Try another.")
                        $("#LatestRenewalAgent_RERAnumberRegistration").val('');
                    }
                }
            });
        });
    });
</script>
<script>
    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            document.getElementById("customTopBtn").style.display = "block";
        } else {
            document.getElementById("customTopBtn").style.display = "none";
        }
    }
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
    }
</script>

