<script type="text/javascript">
         
        function Get_Rear_Number() {
            
            var baseUrl = $('body').attr('data-base-url');
            $.ajax({
                type: "POST",
                url: baseUrl + "HelpdeskAgent/GetReraExistingNumber",
                datatype: "Json",
                data: { RERA_RegNumber: $('#ExistingRegistration').val() },
                success: function (data) {
                    $.each(data, function (index, value) {
                        if (value.Organization_Name != null || value.Organization_Name != "") {
                            $('#Organization_Name').val(value.Organization_Name);
                            $('#ExistingRegistration').attr('readonly', true);
                            $('#Organization_Name').attr('readonly', true);
                        }
                        else {
                            alert("Invalid Existing Punjab RERA registration Number. Try Again!");
                        }
                    });
                }
            });
        }
</script>
