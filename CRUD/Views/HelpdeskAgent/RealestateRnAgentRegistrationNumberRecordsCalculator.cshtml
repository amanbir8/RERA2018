<script>
    $(document).ready(function () {
        var baseUrl = $('body').attr('data-base-url');

        function submitOrder(data) {

            Date.prototype.toShortFormat = function () {
                let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                let day = this.getDate();
                let day1 = (day < 10 ? '0' : '') + day;
                let monthIndex = this.getMonth();
                let monthName = monthNames[monthIndex];
                let year = this.getFullYear();
                return `${day1}-${monthName}-${year}`;
            }

            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: baseUrl + "HelpdeskAgent/SearchRealestateAgentRegistrationNumberRecords",
                data: data,
                success: function (obj) {
                    if (obj.status == true) {

                        var detailsTableBody = $("#registrationdetailsTable tbody");
                        var RowDetail;

                        $.each(obj, function () {
                            $(this).each(function () {
                                
                                if (this.Prepared_NumberTypeFlag === 'NRL') {
                                    $('#prmRegistrationNumber').val(this.Prepared_RegistrationNumber.toString());
                                    var dateIssueDate = new Date(parseInt(this.Prepared_IssueDate.substr(6)));
                                    var dateUptoDate = new Date(parseInt(this.Prepared_ValidUptoDate.substr(6)));
                                    $('#prmRegistrationIssueDate').val(dateIssueDate.toShortFormat());
                                    $('#prmRegistrationValidUptoDate').val(dateUptoDate.toShortFormat());

                                    $('#setPrepared_SequenceNumber').val(this.Prepared_SequenceNumber.toString());
                                    $('#setPrepared_AgentStateType').val(this.Prepared_AgentStateType.toString());
                                    $('#setPrepared_NumberTypeFlag').val(this.Prepared_NumberTypeFlag.toString());
                                    $('#setNumberAlreadyExisted_Flag').val(this.NumberAlreadyExisted_Flag.toString());

                                    if (this.NumberAlreadyExisted_Flag.toString() === 'YS') {
                                        $("#rowCalCI").attr("style", "display:block");
                                        $("#rowCalCII").attr("style", "display:none");
                                        $("#rowCalD").attr("style", "display:none");
                                        $("#lblAlertNumber").text(this.Prepared_RegistrationNumber.toString());
                                    }
                                    else {
                                        $("#rowCalCI").attr("style", "display:none");
                                        if ($("#IsDraft").val() == 1) {
                                            $("#rowCalCII").attr("style", "display:block");
                                        }
                                        else {
                                            $("#rowCalCII").attr("style", "display:none");
                                        }
                                    }
                                };
                                if (this.Prepared_NumberTypeFlag === 'SPL') {
                                    $("#rowCalCII").attr("style", "display:none");
                                    RowDetail = '<tr><td class="text-center"><a data-itemId="' + this.Prepared_SequenceNumber + '" href="javascript:void(0);" class="selectrowItem" title="Select Special Number"><i class="fa fa-check"></i> select</a></td><td class="hidden">' + this.Prepared_SequenceNumber + '</td><td class="hidden">' + this.Prepared_AgentStateType + '</td><td class="hidden">' + this.Prepared_NumberTypeFlag + '</td><td class="hidden">' + this.NumberAlreadyExisted_Flag + '</td><td class="text-center">' + this.Prepared_RegistrationNumber.toString() + '</td><td class="text-center">' + this.Amount_PriceValue.toFixed(2) + '</td></tr>';

                                    var rowCountTable = 0;
                                    $.each($("#registrationdetailsTable tbody tr"), function () {
                                        rowCountTable = rowCountTable + 1;
                                        if ($(this).find('td:eq(0)').html() === 'No data available in table') {
                                            $(this).remove();
                                        };
                                        if ($(this).find('td:eq(0)').html() === 'No matching records found') {
                                            $(this).remove();
                                        };
                                    });
                                };                                
                                detailsTableBody.append(RowDetail);
                            });
                        });
                    }
                    else {
                        alert('Registration Number Failed! Something went wrong');
                    }
                },
                error: function () {
                    alert("oops! Something went wrong")
                }
            });
        }

        $("#submitOrder").click(function (e) {
            e.preventDefault();
            var numberArr = [];
            numberArr.length = 0;
            var isAllValid = false;

            if ($('#RegistrationNumberOptions_Input').val() != '' && $('#AgentStateType_Input').val() != '' && $('#RegistrationIssueDate_Input').val() != '' && $('#RegistrationValidUptoDate_Input').val() != '') {
                var xpRelated_Agent_ID = $("#Related_Agent_ID").val(),
                    xpRegistrationNumberOptions_Input = $("input[name='RegistrationNumberOptions_Input']:checked").val(),
                    xpAgentStateType_Input = $("input[name='AgentStateType_Input']:checked").val(),
                    xpRegistrationIssueDate_Input = $("#RegistrationIssueDate_Input").val(),
                    xpRegistrationValidUptoDate_Input = $("#RegistrationValidUptoDate_Input").val(),
                    xpIsDraft = $("#IsDraft").val();

                if (Date.parse(xpRegistrationIssueDate_Input) <= Date.parse(xpRegistrationValidUptoDate_Input)) {
                    isAllValid = true;
                }
                else {
                    alert('Invalid! Registration issue date should be less than registration valid upto date.');
                    isAllValid = false;
                }
            }
            else {
                alert('The mandatory (*) fields are required.');
                isAllValid = false;
            }

            if (isAllValid) {
                var pRelated_Agent_ID = $("#Related_Agent_ID").val(),                    
                    pRegistrationNumberOptions_Input = $("input[name='RegistrationNumberOptions_Input']:checked").val(),
                    pAgentStateType_Input = $("input[name='AgentStateType_Input']:checked").val(),
                    pRegistrationIssueDate_Input = $("#RegistrationIssueDate_Input").val(),
                    pRegistrationValidUptoDate_Input = $("#RegistrationValidUptoDate_Input").val(),
                    pIsDraft = $("#IsDraft").val();

                $("#rowCalA").attr("style", "display:block");
                $("#rowCalB").attr("style", "display:block");
                $("#rowCalC").attr("style", "display:block");
                $("#rowCalD").attr("style", "display:block");
                if (pIsDraft == 1) {
                    $("#rowCalCII").attr("style", "display:block");
                }
                else {
                    $("#rowCalCII").attr("style", "display:none");
                }
                $("#rowCalE").attr("style", "display:none");

                numberArr.push({
                    Related_Agent_ID: pRelated_Agent_ID,
                    RegistrationNumberOptions_Input: pRegistrationNumberOptions_Input,
                    AgentStateType_Input: pAgentStateType_Input,
                    RegistrationIssueDate_Input: pRegistrationIssueDate_Input,
                    RegistrationValidUptoDate_Input: pRegistrationValidUptoDate_Input,
                    IsDraft: pIsDraft
                });

                var data = JSON.stringify({
                    numberobject: numberArr
                });

                $.when(submitOrder(data)).then(function (response) {
                    console.log(response);
                }).fail(function (err) {
                    console.log(err);
                });

                $("#submitOrder").addClass('sorder-disable');
                $("#submitOrder").prop('disabled', true);
            }
        });

        $("#cancelOrder").click(function (e) {
            e.preventDefault();
            var agentDetailsModal = $(document).find('#myModal');
            $(agentDetailsModal).fadeOut(1000, function () {
                $(agentDetailsModal).modal('hide');
            });
        });

        // Add Special Number to List
        $(document).on('click', 'a.selectrowItem', function (e) {
            e.preventDefault();
            //var flagmove = confirm('Are you sure want to allot special registration number?');
            //if (flagmove) {

                var elem = $(this);
                var parentRow = $(elem).parents('tr');
                var inRegistrationNumber = $.trim($(parentRow).find('td:eq(5)').text());
                var inSequenceNumber = $.trim($(parentRow).find('td:eq(1)').text());
                var inAgentStateType = $.trim($(parentRow).find('td:eq(2)').text());
                var inNumberTypeFlag = $.trim($(parentRow).find('td:eq(3)').text());
                var inAlreadyExistedFlag = $.trim($(parentRow).find('td:eq(4)').text());

                if ($(this).attr('data-itemId') == inSequenceNumber) {
                    $('#prmRegistrationNumber').val(inRegistrationNumber.toString());
                    $('#setPrepared_SequenceNumber').val(inSequenceNumber.toString());
                    $('#setPrepared_AgentStateType').val(inAgentStateType.toString());
                    $('#setPrepared_NumberTypeFlag').val(inNumberTypeFlag.toString());
                    $('#setNumberAlreadyExisted_Flag').val(inAlreadyExistedFlag.toString());

                    $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                        $(this).remove();
                    });
                    if ($("#IsDraft").val() == 1) {
                        $("#rowCalCII").attr("style", "display:block");
                    }
                    else {
                        $("#rowCalCII").attr("style", "display:none");
                    }
                    $("#prmRegistrationNumber").addClass('bgspecialdisplay-color').removeClass('bgdisplay-color');

                }
            //}
        });

        $("#proceedOrder").click(function (e) {
            e.preventDefault();
            $("#LatestRenewalAgent_RERAnumberRegistration").addClass('bgextractdisplay-color');
            $("#LatestRenewalAgent_RERAnumberIssueDate").addClass('bgextractdisplay-color');
            $("#LatestRenewalAgent_RERAnumberRegUptoDate").addClass('bgextractdisplay-color');

            $("#LatestRenewalAgent_RERAnumberRegistration").val($("#prmRegistrationNumber").val());
            $("#LatestRenewalAgent_RERAnumberIssueDate").val($("#prmRegistrationIssueDate").val());
            $("#LatestRenewalAgent_RERAnumberRegUptoDate").val($("#prmRegistrationValidUptoDate").val());
            $("#Extra2").val($("#setPrepared_SequenceNumber").val());
            $("#Extra3").val($("#setPrepared_AgentStateType").val());
            $("#Extra4").val($("#setPrepared_NumberTypeFlag").val());

            var AgentDetailsModal = $(document).find('#myModal');
            $(AgentDetailsModal).modal('hide');
        });
    });
</script>
<script>
    $(function () {
        $('#RegistrationIssueDate_Input').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#RegistrationValidUptoDate_Input').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });

        $("#prmRegistrationNumber").inputmask({ mask: function () { return ["AAAAAA-AAA99-AAA9999"]; } });
        $('#prmRegistrationIssueDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
        $('#prmRegistrationValidUptoDate').datepicker({ dateFormat: 'dd-M-yy', changeMonth: true, changeYear: true, });
    });
</script>

<script>
    $("#myform_NumberCalculator").validate({
        rules: {
            RegistrationIssueDate_Input: {
                required: true,                
                maxlength: 15,
                minlength: 10
            },
            RegistrationValidUptoDate_Input: {
                required: true,                
                maxlength: 15,
                minlength: 10
            }            
        }
    });
</script>

