@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RevocationCancellationAgentDiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');        
        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [9, 10]
            }]
        });
        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var realestateagentDetailsModal = $(document).find('#myModal');
            $(realestateagentDetailsModal).find('.modal-body').html('');
            var agentId = $.trim($(parentRow).find('input.hdnAgentID').val());
            var renewalagentId = $.trim($(parentRow).find('input.hdnRenewalAgentID').val());
            var agentdiaryno = $.trim($(parentRow).find('input.hdnAgentDiaryNumber').val());
            agentId = parseInt(agentId);
            renewalagentId = parseInt(renewalagentId);
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentRevokeInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentId': agentId, 'renewalagentId': renewalagentId, 'agentdno': agentdiaryno },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(realestateagentDetailsModal).find('.modal-body').html(response);
                    $(realestateagentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-reradiary-number').attr('data-reradiary-no'));
            var realestateagentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(realestateagentDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + realestateagentName + ')');
            $(realestateagentDetailsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var myBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            //window.location = myBASE_URL + 'Helpdesk/ProjectsInPublicView_ExportToExcel';
            //$('input[type=text]').each(function () {
            //    $(this).val('');
            //});
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerAgentFormdetails);
    });
    function infohelpHandlerAgentFormdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Revoke/Cancellation(s)</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Rejected applications for revocation/ cancellation/ withdrawn of registrations/ RERA number regarding real-estate agent(s) by authority.<br/> <i class="fa fa-check-square" style="color:#fff"></i> For any additional questions or the feedback regarding web-portal, please contact IT team.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Real-Estate Agents (Registration Revocation/Cancellation) : Rejected Application(s) Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of Real-Estate Agents (Registration Revocation/Cancellation) : Rejected Application(s) Details
                    <span class="pull-right">
                        <a class="modalDownloadExcelButton" href="javascript:void(0);" title="Download Excel"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span></a>
                        <a class="a info-help-details" id="btnInfoHelpDetails" href="javascript:void(0);" title="Help"><span class="btn btn-outline btn-primary btn-xs"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span></a>
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.AgentRegDiaryNumber_Name)</th>
                                            <th>@Html.DisplayNameFor(model => model.AgentName)</th>
                                            <th>@Html.DisplayNameFor(model => model.AgentBussinessPlaceDistrict)</th>
                                            <th>@Html.DisplayName("RERA Number")</th>
                                            <th>@Html.DisplayName("Registration Issue Date")</th>
                                            <th>@Html.DisplayName("Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Renewal of Registration Upto Date")</th>
                                            <th>@Html.DisplayName("Last Modified Date")</th>
                                            <th>@Html.DisplayName("View Status")</th>
                                            <th>@Html.DisplayName("View Details")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                        int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                                <tr class="odd gradeX">
                                                    <td>@Html.DisplayName(sno.ToString())</td>
                                                    <td class="agent-reradiary-number" data-reradiary-no="@Html.DisplayFor(modelItem => item.Agent_RERAregistrationNumber)">
                                                        @Html.DisplayFor(modelItem => item.AgentRegDiaryNumber_Name)
                                                    </td>
                                                    <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.getAgentName)">
                                                        @Html.DisplayFor(modelItem => item.getAgentName)
                                                        @Html.HiddenFor(modelItem => item.Agent_ID, new { @class = "hdnAgentID" })
                                                        @Html.HiddenFor(modelItem => item.RenewalAgent_ID, new { @class = "hdnRenewalAgentID" })
                                                        @Html.HiddenFor(modelItem => item.AgentRegDiaryNumber_Name, new { @class = "hdnAgentDiaryNumber" })
                                                    </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Agent_BussinessPlaceAddressDistrictName)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Agent_RERAregistrationNumber)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Agent_RERAregistrationIssueDate)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Agent_RERAregistrationValidUptoDate)</td>
                                                    <td>
                                                        @if (item.Agent_RERArenewalregistrationValidUptoDate.Value.ToString("MM/dd/yyyy") != "01/01/0001")
                                                        {
                                                            @Html.DisplayFor(modelItem => item.Agent_RERArenewalregistrationValidUptoDate)                                                                
                                                        }
                                                        else
                                                        {
                                                            @Html.DisplayName("--")
                                                        }                                                   
                                                    </td>                                                    
                                                    <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                                                    <td class="center">
                                                        <a id="modalOpenerButton" href="javascript:void(0);"><i class="fa fa-eye"></i></a>
                                                    </td>                                                
                                                    <td class="center">
                                                        @Html.ActionLink("View", "AgentRevokeInfoEventInsertAction", new { ADNumber = item.AgentRegDiaryNumber_Name, RevDNumber = item.RevokeAgent_RegDiaryNumber_Name, RevAName = item.getAgentName, RevAID = item.Agent_ID, RevLMO = item.EventAction_IdentifiedOn, RevRenAID = item.RenewalAgent_ID, RevARefNumber = item.Agent_RERAregistrationNumber })
                                                    </td>                                                   
                                                </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">File History Details - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel = "stylesheet" /> 
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script> 
    
    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>  
}
