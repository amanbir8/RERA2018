                                        @{
                                            int sno = 0;
                                            string alertreminderDisplayId = "";
                                            string warningreminderDisplayId = "";
                                            string warningreminderDisplayTitle = "";
                                            string alertchecklistDisplayId = "";
                                            string alertchecklistDisplayText = "";
                                            string alertchecklistDisplayAfterText = "";
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="renewalagent-diary-number" data-renewaldiary-number="@Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)">
