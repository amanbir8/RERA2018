                                                        {
                                                            alertchecklistDisplayId = "alertchecklistShow" + @sno.ToString();
                                                            alertchecklistDisplayText = "alertchecklistText" + @sno.ToString();
                                                            alertchecklistDisplayAfterText = "alertchecklistAfterText" + @sno.ToString();
                                                        }
                                                        <span id=@alertchecklistDisplayText.ToString() class="bg-bookmark-text-no-color warning-text-notification">
                                                            @Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)
                                                        </span>
                                                        <span id=@alertchecklistDisplayAfterText.ToString() class="primary-text-notification">
                                                            @Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)
                                                        </span>
                                                        <script type="text/javascript">
                                                            $(document).ready(function () {
                                                                showChecklistNotificationColor("@item.Extra3.ToString()","@item.EventAction_Type.ToString()","@sno.ToString()");
                                                            });
                                                        </script>
                                                        <span class="pull-left bg-border-show">
                                                            <span id=@alertchecklistDisplayId.ToString() class="bg-bookmark-icon-none">
                                                                <i class="fa fa-bookmark fa-fw warning-icon-notification" aria-hidden="true" title="Checklist prepared Notification!"></i>
                                                            </span>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayFor(modelItem => item.RenewalAgentDiaryNumber_Name)
                                                    }
                                                    @if (item.EventAction_Type.ToString() == "290007")
                                                    {
                                                        <script type="text/javascript">
                                                            $(document).ready(function () {
                                                                showSmsReminderColor("@item.EventAction_IdentifiedOn.ToString()", "@sno.ToString()");
                                                                showInCompleteDaysReminderColor("@item.EventAction_IdentifiedOn.ToString()", "@sno.ToString()");
