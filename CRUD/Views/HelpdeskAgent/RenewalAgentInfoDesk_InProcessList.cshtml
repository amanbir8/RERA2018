@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RenewalAgent_DiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');
        
        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var renewalagentDetailsModal = $(document).find('#myModal');
            $(renewalagentDetailsModal).find('.modal-body').html('');
            var AgentID = $.trim($(parentRow).find('input.hdnAgentID').val());
            var AgentTypeID = $.trim($(parentRow).find('input.hdnAgentTypeID').val());
            var RnAgentID = $.trim($(parentRow).find('input.hdnRnAgentID').val());
            var RnAgentSeqID = $.trim($(parentRow).find('input.hdnRnAgentSeqID').val());
            var RnAgentYrID = $.trim($(parentRow).find('input.hdnRnAgentYrID').val());
            AgentID = parseInt(AgentID);
            AgentTypeID = parseInt(AgentTypeID);
            RnAgentID = parseInt(RnAgentID);
            RnAgentSeqID = parseInt(RnAgentSeqID);
            RnAgentYrID = parseInt(RnAgentYrID);
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/RenewalAgentInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'agentid': AgentID, 'agenttypeid': AgentTypeID, 'rnagentid': RnAgentID, 'rnagentseqid': RnAgentSeqID, 'rnagentyrid': RnAgentYrID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(renewalagentDetailsModal).find('.modal-body').html(response);
                    $(renewalagentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var renewalagentDiaryNo = $.trim($(parentRow).find('td.renewalagent-diary-number').attr('data-renewaldiary-number'));
            var renewalagentName = $.trim($(parentRow).find('td.renewalagent-name').attr('data-renewalagent-name'));
            $(renewalagentDetailsModal).find('h4.modal-title a').html(renewalagentDiaryNo + ' (' + renewalagentName + ')');
            $(renewalagentDetailsModal).modal('show');
        });

        $(document).on('click', 'a#modalOpenerReminderAlertsButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var RealEstateAgentsModal = $(document).find('#myModal');
            $(RealEstateAgentsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var agentId = $.trim($(parentRow).find('input.hdnAgentID').val());
            var agenttypeId = $.trim($(parentRow).find('input.hdnAgentTypeID').val());
            var renewalagentId = $.trim($(parentRow).find('input.hdnRnAgentID').val());
            var renewalagentSeqId = $.trim($(parentRow).find('input.hdnRnAgentSeqID').val());
            var renewalagentYrId = $.trim($(parentRow).find('input.hdnRnAgentYrID').val());
            var codeId = 0;
            var agentDNumber = $.trim($(parentRow).find('td.renewalagent-diary-number').attr('data-renewaldiary-number'));
            agentId = parseInt(agentId);
            agenttypeId = parseInt(agenttypeId);
            renewalagentId = parseInt(renewalagentId);
            renewalagentSeqId = parseInt(renewalagentSeqId);
            renewalagentYrId = parseInt(renewalagentYrId);
            $.ajax({
                url: BASE_URL + 'MISrealestateagentToExcel/RenewalAgentReminderEmailSchedulerContentDetailsForMIS',
                dataType: 'HTML',
                type: 'GET', 
                data: { 'AgentId': agentId, 'AgentTypeId': agenttypeId, 'RnAgentId': renewalagentId, 'RnAgentSeqId': renewalagentSeqId, 'RnAgentYrId': renewalagentYrId, 'CodeId': codeId, 'DNumber': agentDNumber },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(RealEstateAgentsModal).find('.modal-body').html(response);
                    $(RealEstateAgentsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.renewalagent-diary-number').attr('data-renewaldiary-number'));
            var agentName = $.trim($(parentRow).find('td.renewalagent-name').attr('data-renewalagent-name'));
            $(RealEstateAgentsModal).find('h4.modal-title').html('Reminder Alerts Details - <a href="javascript:void(0);"></a>');
            $(RealEstateAgentsModal).find('.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(RealEstateAgentsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var myBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = myBASE_URL + 'HelpdeskAgent/InProcessApplicationsforRenewalAgent_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerRegistrationdetails);
    });
    function infohelpHandlerRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:pink"></i> Pending for re-submit and In-complete application (Additional information sought by authority from real estate agent).<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Check-list prepared and reviewed.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

