                responsive: true,
                "pageLength": 50,
                "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [8, 9]
                }]
            });
        });
    </script>  
