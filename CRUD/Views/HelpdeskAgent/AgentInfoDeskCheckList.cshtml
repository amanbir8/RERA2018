@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_AgentDiaryNumber

<link rel="stylesheet" href="@Url.Content("~/dist/css/pnotify.custom.min.css")" />
<script src="@Url.Content("~/dist/js/pnotify.custom.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');        
        //$('#dataTables-example').DataTable({
        //    responsive: true,
        //    "pageLength": 50,
        //    "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]],
        //    'aoColumnDefs': [{
        //        'bSortable': false,
        //        'aTargets': [6, 7]
        //    }]
        //});
        $(document).on('click', 'a#modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var projectDetailsModal = $(document).find('#myModal');
            $(projectDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var AgentId = $.trim($(parentRow).find('input.hdnAgentID').val());
            AgentId = parseInt(AgentId);
            $.ajax({
                url: BASE_URL + 'HelpdeskAgent/AgentInfoEventLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId },
                beforeSend: function(){
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(projectDetailsModal).find('.modal-body').html(response);
                    $(projectDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(projectDetailsModal).modal('show');
        });
    });
</script>
<script>
    $(document).ready(function () {
        var myBASE_URL = $('body').attr('data-base-url');
        $(document).on('click', 'a.modalDownloadExcelButton', function (e) {
            e.preventDefault();
            var elem = $(this);

            window.location = myBASE_URL + 'HelpdeskAgent/CheckListApplicationsforRealEstateAgent_ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });
        $(document).on("click", "a.info-help-details", infohelpHandlerREAgentRegistrationdetails);
    });
    function infohelpHandlerREAgentRegistrationdetails() {

        new PNotify({
            title: 'Help',
            text: '<b>Color Code</b><br/> <i class="fa fa-check-square" style="color:#fff"></i> Check-list Pending for verification of Real Estate Agent Application.<br/> <i class="fa fa-check-square" style="color:#BCECAC"></i> Check-list Prepared, Verified and Reviewed by Evaluation Officer.',
            hide: false,
            icon: 'fa fa-question-circle-o fa-lg',
            type: 'info',
        });
    }
</script>

<style>
    /* reminder badge class - start */
    .badge-show {
        position: relative !important;
    }

    .badge {
        display: inline-block;
        padding: 0.25em 0.4em;
        font-size: 75%;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: 0.35rem;
        -webkit-transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, -webkit-box-shadow 0.15s ease-in-out;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, -webkit-box-shadow 0.15s ease-in-out;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out, -webkit-box-shadow 0.15s ease-in-out;
    }

    .badge-counter {
        position: absolute;
        -webkit-transform: scale(0.7);
        transform: scale(0.7);
        -webkit-transform-origin: top right;
        transform-origin: top right;
        left: 9px;
    }

    .badge-primary {
        background-color: #428bca;
    }

        .badge-primary.badge-glow {
            -webkit-box-shadow: 0 0 10px #428bca;
            box-shadow: 0 0 10px #428bca;
        }

    .badge-danger {
        background-color: #FF4961;
    }

        .badge-danger.badge-glow {
            -webkit-box-shadow: 0 0 10px #FF4961;
            box-shadow: 0 0 10px #FF4961;
        }

    .badge-warning {
        background-color: #f0ad4e;
    }

        .badge-warning.badge-glow {
            -webkit-box-shadow: 0 0 10px #f0ad4e;
            box-shadow: 0 0 10px #f0ad4e;
        }
    /* reminder badge class - end */
</style>
