@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RenewalAgent_EventLog

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="width: 100%;">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.EventAction_IdentifiedOn)</th>
                        <th>@Html.DisplayNameFor(model => model.RelatedAgent_RenewalDiaryNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.EventAction_Aggregate)</th>
                        @*<th>@Html.DisplayNameFor(model => model.AssignedTo)</th>*@
                        <th>@Html.DisplayName("Prepared By")</th>
                        <th>@Html.DisplayNameFor(model => model.Remarks_IfAny)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.prpongoing)
                   {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedOn)</td>
                            <td>@Html.DisplayFor(modelItem => item.RelatedAgent_RenewalDiaryNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.EventAction_Aggregate)</td>
                            @*<td>@Html.DisplayFor(modelItem => item.AssignedTo)</td>*@
                            @if (item.EventAction_IdentifiedBy != "999")
                            {
                                <td>@Html.DisplayFor(modelItem => item.EventAction_IdentifiedBy)</td>
                            }
                            else
                            {
                                <td>@Html.DisplayName(" ")</td>
                            }
                            <td align="justify">@Html.DisplayFor(modelItem => item.Remarks_IfAny)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
