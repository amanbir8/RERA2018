@model CRUD.Models.HelpDeskAgent.ClsPrp_AuthorityDesk_RenewalAgentSubCheckListLog

<script>
    $(document).ready(function () {        

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 25,
            "lengthMenu": [[25, 50, 75, 100], [25, 50, 75, 100]]
        });

    });
</script>
<script>
    $(document).ready(function () {

        var BASE_URLm = $('body').attr('data-base-url');

        $(document).on('click', 'a.modalOpenerButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var rnaDetailsModal = $(document).find('#myModal');
            $(rnaDetailsModal).find('.modal-body').html('');
            var AgentId = 0;//$.trim($(parentRow).find('input.hdnProjectID').val());
            var RnAgentId = 0;
            var RnAgentSeqId = 0;
            var RnAgentYrId = 0;
            AgentId = parseInt(AgentId);
            RnAgentId = parseInt(RnAgentId);
            RnAgentSeqId = parseInt(RnAgentSeqId);
            RnAgentYrId = parseInt(RnAgentYrId);
            var checklistcriteriacode = $(this).closest('tr').find('.checklist-criteria-code').attr('data-criteria-code');
            var criteriaCode = parseInt(checklistcriteriacode);
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RenewalAgentInfoCheckListInsert',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': AgentId, 'RnAgentId': RnAgentId, 'RnAgentSeqId': RnAgentSeqId, 'RnAgentYrId': RnAgentYrId, 'criteriaCode': criteriaCode },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(rnaDetailsModal).find('.modal-body').html(response);
                }
            });

            //var projectName = $.trim($(parentRow).find('td.project-name').attr('data-project-name'));
            //$(projectDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + projectName + ')');
            $(rnaDetailsModal).modal('show');
        });

        $(document).on('click', 'a.modalOpenerButtonExpand', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var rnaDetailsModal = $(document).find('#myModal');
            $(rnaDetailsModal).find('.modal-body').html('');

            var parmAgentId = $.trim($(parentRow).find('input.hdnRelatedAgentID').val());
            var parmAgentTypeId = $.trim($(parentRow).find('input.hdnRelatedAgentTypeID').val());
            var parmRnAgentId = $.trim($(parentRow).find('input.hdnRelatedRenewalAgentID').val());
            var parmRnAgentSeqId = $.trim($(parentRow).find('input.hdnRelatedRenewalAgentSeqID').val());
            var parmRnAgentYrId = $.trim($(parentRow).find('input.hdnRelatedRenewalAgentYrID').val());
            var parmCriteriaID = $.trim($(parentRow).find('input.hdnVarCriteriaID').val());
            var parmCriteriaSubID = $.trim($(parentRow).find('input.hdnVarCriteriaSubID').val());
            parmAgentId = parseInt(parmAgentId);
            parmAgentTypeId = parseInt(parmAgentTypeId);
            parmRnAgentId = parseInt(parmRnAgentId);
            parmRnAgentSeqId = parseInt(parmRnAgentSeqId);
            parmRnAgentYrId = parseInt(parmRnAgentYrId);
            parmCriteriaID = parseInt(parmCriteriaID);
            parmCriteriaSubID = parseInt(parmCriteriaSubID);

            var varDNumber = $("#zapRenewalAgent_DiaryNumber").val();
            var varAgentName = $("#zapRenewalAgentName").val();

            $(rnaDetailsModal).find('.modal-title').find('.title-project-details').html('');
            $.ajax({
                url: BASE_URLm + 'HelpdeskAgent/RenewalAgentInfoCheckListDisplayLog',
                dataType: 'HTML',
                type: 'GET',
                data: { 'parmAgentId': parmAgentId, 'parmAgentTypeId': parmAgentTypeId, 'parmRnAgentId': parmRnAgentId, 'parmRnAgentSeqId': parmRnAgentSeqId, 'parmRnAgentYrId': parmRnAgentYrId, 'parmCriteriaID': parmCriteriaID, 'parmCriteriaSubID': parmCriteriaSubID },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(rnaDetailsModal).find('.modal-body').html(response);
                    $(rnaDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });

            $(rnaDetailsModal).find('h4.modal-title').html('File History Details - <a href="javascript:void(0);"></a>');
            $(rnaDetailsModal).find('.modal-title a').html(varDNumber + ' (' + varAgentName + ')');
            $(rnaDetailsModal).modal('show');
        });
    });
</script>

