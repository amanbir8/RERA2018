@model CRUD.Models.MISrealestateagentToExcel.Clsprp_MIS_AgentQRcodeOfflineCertificateDetails

@{
    Layout = null;
}

<div class="row">
    <div class="col-md-12">

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">Agent Details</legend>                        
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineAgents_AgentName_OrganizationName, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.OfflineAgents_AgentName_OrganizationName, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                                
                            </div>
                        </div>                        
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineAgents_PlaceOfBussinessAddress, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-9">
                                    @Html.DisplayFor(model => model.OfflineAgents_PlaceOfBussinessAddress, new { htmlAttributes = new { @class = "form-control" } })
                                </div>                                
                            </div>
                        </div>  
                        <div class="row">
                            <div class="form-group">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineAgents_RERAregistrationNumber, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineAgents_RERAregistrationNumber, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.OfflineAgents_RERAregistrationValidUptoDate, htmlAttributes: new { @class = "control-label" })
                                </div>
                                <div class="col-md-3">
                                    @Html.DisplayFor(model => model.OfflineAgents_RERAregistrationValidUptoDate, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                            </div>
                        </div>                                          
                    </fieldset>
                </div>
            </div>
        </div>     

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <fieldset class="col-md-12">
                        <legend class="my">QR Code Image</legend> 
                        <div class="row" style="align-content:center;">
                            <div class="form-group">                                
                                <div class="col-md-12">
                                    <img width="350" height="350" src="@Url.Action("GenerateQrCodeByOfflineAgentID", "MISrealestateagentToExcel", new { qrRERAnumber = Model.OfflineAgents_RERAregistrationNumber, qrValidUptoDate = Model.OfflineAgents_RERAregistrationValidUptoDate, qrAgentName = Model.OfflineAgents_AgentName_OrganizationName, qrAgentType = Model.OfflineAgents_AgentType, qrAddressPlaceOfBussiness = Model.OfflineAgents_PlaceOfBussinessAddress })" />
                                </div>                               
                            </div>
                        </div>                        
                    </fieldset>
                </div>
            </div>
        </div>       

    </div>
</div>
