        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Real-estate Agent Report : Real-estate Agent's QR Code Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->
    
    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #ff0000;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("Display_AgentQRcodeCertificateDetailsForRegisteredAgentsMIS", "MISrealestateagentToExcel")" role="tab" aria-controls="profile" aria-selected="false">Agents In Public View</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="home-tab" href="@Url.Action("Display_AgentQRcodeCertificateDetailsForOfflineAgentsMIS", "MISrealestateagentToExcel")" role="tab" aria-controls="home" aria-selected="false">Offline Registered Agents</a>
                </li> 
                <li class="nav-item active">
                    <a class="nav-link active" id="renewal-tab" href="@Url.Action("Display_RenewalAgentQRcodeCertificateDetailsMIS", "MISrealestateagentToExcel")" role="tab" aria-controls="renewal" aria-selected="true">Renewal of Agent's Registrations</a>
                </li>               
            </ul>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    List of QR Code(s) of Real-estate Agent for Renewal of registration certificate [Renewal of Registration] Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("Display_RenewalAgentQRcodeCertificateDetailsMIS", "MISrealestateagentToExcel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "RenewalAgentCertificateQRcodeMIS" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Registration Issue Date</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Entry Date Type</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.IsRangeValueDateInputFlag, "1", new { id = "chkApplicationDate", @class = "radio-applicationrangevaluedate", @checked = "checked" }) From-Date/To-Date
                                                    @Html.RadioButtonFor(model => model.IsRangeValueDateInputFlag, "2", new { id = "chkApprovalDate", @class = "radio-applicationrangevaluedate" }) Month/Year
                                                </label>
                                                @Html.ValidationMessageFor(model => model.IsRangeValueDateInputFlag, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="rowDateFilterDD">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.InputEntry_FromDate, htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.InputEntry_FromDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @onfocus = "this.value=''" } })
                                                @Html.ValidationMessageFor(model => model.InputEntry_FromDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.InputEntry_ToDate, htmlAttributes: new { @class = "control-label mand" })
                                            </div>
                                            <div class="col-md-3">
                                                @Html.EditorFor(model => model.InputEntry_ToDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off", @onfocus = "this.value=''" } })
                                                @Html.ValidationMessageFor(model => model.InputEntry_ToDate, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                <input type="submit" id="ViewDetailDD" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row" id="rowDateFilterYY">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.EventMonth, htmlAttributes: new { @class = "control-label mand" })
                                                @{var listItemsEventMonth = new List<SelectListItem>
                                                    {
                                                        new SelectListItem {  Text = "--Select--" , Value="0"  },
                                                        new SelectListItem {  Text = "January" , Value="1"  },
                                                        new SelectListItem {  Text = "February" , Value="2"  },
                                                        new SelectListItem {  Text = "March" , Value="3"  },
                                                        new SelectListItem {  Text = "April" , Value="4"  },
                                                        new SelectListItem {  Text = "May" , Value="5"  },
                                                        new SelectListItem {  Text = "June" , Value="6"  },
                                                        new SelectListItem {  Text = "July" , Value="7"  },
                                                        new SelectListItem {  Text = "August" , Value="8"  },
                                                        new SelectListItem {  Text = "September" , Value="9"  },
                                                        new SelectListItem {  Text = "October" , Value="10"  },
                                                        new SelectListItem {  Text = "November" , Value="11"  },
                                                        new SelectListItem {  Text = "December" , Value="12"  },
                                                    };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.EventMonth, new SelectList(listItemsEventMonth, "Value", "Text"), new { @id = "drpEventMonth", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.EventMonth, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                @Html.LabelFor(model => model.EventYear, htmlAttributes: new { @class = "control-label mand" })
                                                @{var listItemsEventYear = new List<SelectListItem>
                                                    {
                                                        new SelectListItem {  Text = "--Select--" , Value="0"  },
                                                        new SelectListItem {  Text = "2016" , Value="2016"  },
                                                        new SelectListItem {  Text = "2017" , Value="2017"  },
                                                        new SelectListItem {  Text = "2018" , Value="2018"  },
                                                        new SelectListItem {  Text = "2019" , Value="2019"  },
                                                        new SelectListItem {  Text = "2020" , Value="2020"  },
                                                        new SelectListItem {  Text = "2021" , Value="2021"  },
                                                        new SelectListItem {  Text = "2022" , Value="2022"  },
                                                        new SelectListItem {  Text = "2023" , Value="2023"  },
                                                        new SelectListItem {  Text = "2024" , Value="2024"  },
                                                        new SelectListItem {  Text = "2025" , Value="2025"  },
                                                        new SelectListItem {  Text = "2026" , Value="2026"  },
                                                        new SelectListItem {  Text = "2027" , Value="2027"  },
                                                        new SelectListItem {  Text = "2028" , Value="2028"  },
                                                        new SelectListItem {  Text = "2029" , Value="2029"  },
                                                        new SelectListItem {  Text = "2030" , Value="2030"  },
                                                    };
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                @Html.DropDownListFor(model => model.EventYear, new SelectList(listItemsEventYear, "Value", "Text"), new { @id = "drpEventYear", @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.EventYear, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-2">
                                                <input type="submit" id="ViewDetailYY" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>                            
                            @using (Html.BeginForm("ExportRenewalRegistrationwithQRcodeToExcel", "MISrealestateagentToExcel"))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <span class="btn btn-outline btn-primary" id="btnExportToExcel">
                                                <i class="fa fa-download"></i>
                                                <span>Export To Excel</span>                                                
                                            </span>
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Display_RenewalAgentQRcodeCertificateDetailsMIS", "MISrealestateagentToExcel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }


                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            <th>@Html.DisplayNameFor(model => model.Agent_DiaryNumber)</th>
                                            <th>@Html.DisplayNameFor(model => model.QRcodeImage_A)</th>
                                            <th>@Html.DisplayNameFor(model => model.Agent_Organization_Name)</th>                                            
                                            <th>@Html.DisplayNameFor(model => model.Agent_TypeSTR)</th>                                            
                                            <th style="width:15%;">@Html.DisplayNameFor(model => model.RERAnumberRegistration)</th>
                                            <th>@Html.DisplayNameFor(model => model.RERAnumberIssueDate)</th>
                                            <th>@Html.DisplayNameFor(model => model.RERAnumberRegUptoDate)</th> 
                                            <th>@Html.DisplayNameFor(model => model.RERA_RenewalRegistrationNumber_ValidUptoDate)</th>                                           
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                <td class="agent-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.Agent_DiaryNumber)">
                                                    @Html.DisplayFor(modelItem => item.Agent_DiaryNumber)
                                                    @Html.HiddenFor(modelItem => item.Agent_ID, new { @class = "hdnAgentID" })
                                                    @Html.HiddenFor(modelItem => item.Agent_Type, new { @class = "hdnAgentTypeID" })
                                                    @Html.HiddenFor(modelItem => item.RenewalAgent_ID, new { @class = "hdnRnAgentID" })
                                                    @Html.HiddenFor(modelItem => item.RenewalAgent_SequenceID, new { @class = "hdnRnAgentSeqID" })
                                                    @Html.HiddenFor(modelItem => item.RenewalAgent_YearID, new { @class = "hdnRnAgentYrID" })
                                                </td>
                                                <td style="align-content:center;">
                                                    <a id="modalOpenerAddressButton" href="javascript:void(0);" title="View or scan QR Code">
                                                        <i class="fa fa-qrcode" aria-hidden="true"></i>
                                                    </a>
                                                </td>
                                                <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.Agent_Organization_Name)">
                                                    @Html.DisplayFor(modelItem => item.Agent_Organization_Name)                                                    
                                                </td>                                                
                                                <td>@Html.DisplayFor(modelItem => item.Agent_TypeSTR)</td>                                                
                                                <td style="width:15%;">@Html.DisplayFor(modelItem => item.RERAnumberRegistration)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RERAnumberIssueDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RERAnumberRegUptoDate)</td>
                                                <td>@Html.DisplayFor(modelItem => item.RERA_RenewalRegistrationNumber_ValidUptoDate)</td>                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->

