@model CRUD.Models.MISrealestateagentToExcel.Clsprp_MIS_AgentAddressDirectoryDetails

@{
    Layout = null;
}

<script type="text/javascript">
    $(function () {
        if ($('#Agent_Type').val() == "1") {
            $('#idAgent_PermanentAddress').show();
            $('#idAgent_RegisteredOfficeAddress').hide();
            
            $('#idAgent_AuthorizedSignatoryInd').show();
            $('#idAgent_AuthorizedSignatoryOTInd').hide();
        }
        else {
            $('#idAgent_PermanentAddress').hide();
            $('#idAgent_RegisteredOfficeAddress').show();
            
            $('#idAgent_AuthorizedSignatoryInd').hide();
            $('#idAgent_AuthorizedSignatoryOTInd').show();
        }
    });
</script>

