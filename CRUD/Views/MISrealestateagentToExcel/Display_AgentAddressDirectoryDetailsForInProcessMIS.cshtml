@model CRUD.Models.MISrealestateagentToExcel.Clsprp_MIS_AgentAddressDirectoryDetails
<script src="@Url.Content("~/jquery-ui-1.12.1.custom/jquery-ui-1.12.1.custom/jquery-ui.min.js")"></script>

<script>
    $(document).ready(function () {
        var BASE_URL = $('body').attr('data-base-url');

        $('#dataTables-example').DataTable({
            responsive: true,
            "pageLength": 50,
            "lengthMenu": [[50, 100, 150, 200, 250], [50, 100, 150, 200, 250]] //,
            //'aoColumnDefs': [{
            //    'bSortable': false,
            //    'aTargets': [9, 10]
            //}]
        });

        $('#btnExportToExcel').click(function () {
            window.location = BASE_URL + 'MISrealestateagentToExcel/ExportToExcel';
            $('input[type=text]').each(function () {
                $(this).val('');
            });
        });

        $(document).on('click', 'a#modalOpenerAddressButton', function (e) {
            e.preventDefault();
            var elem = $(this);
            var parentRow = $(elem).parents('tr');
            var agentDetailsModal = $(document).find('#myModal');
            $(agentDetailsModal).find('.modal-body').html('');
            // ajax to fetch data corresponding to projectId
            var agentId = $.trim($(parentRow).find('input.hdnAgentID').val());
            var choiceType = '@ViewBag.choicetype';
            agentId = parseInt(agentId);
            $.ajax({
                url: BASE_URL + 'MISrealestateagentToExcel/AgentAddressDirectoryDetailsForMIS',
                dataType: 'HTML',
                type: 'GET',
                data: { 'AgentId': agentId, 'AgentRegType': choiceType },
                beforeSend: function () {
                    startPreloader();
                },
                success: function (response) {
                    stopPreloader();
                    $(agentDetailsModal).find('.modal-body').html(response);
                    $(agentDetailsModal).find('table').DataTable({
                        responsive: true
                    });
                }
            });
            var diaryNo = $.trim($(parentRow).find('td.agent-diary-number').attr('data-diary-no'));
            var agentName = $.trim($(parentRow).find('td.agent-name').attr('data-agent-name'));
            $(agentDetailsModal).find('h4.modal-title a').html(diaryNo + ' (' + agentName + ')');
            $(agentDetailsModal).modal('show');
        });

    });
</script>
<script>
    $(function () {

        $("#frmfromdate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,

            onSelect: function (selected) {
                var dt = new Date(selected);
                dt.setDate(dt.getDate() + 1);
                $("#frmtodate").datepicker("option", "minDate", dt);
            }
        });

        $("#frmtodate").datepicker({
            dateFormat: 'dd-M-yy',
            changeMonth: true,
            changeYear: true,
            onSelect: function (selected) {
                var projStartDate = $("#frmfromdate").val();
                if (projStartDate == '') {
                    alert('Please select From Date first!');
                    $("#frmtodate").val('');
                    return false;
                }
                var dt = new Date(selected);
                dt.setDate(dt.getDate());
                $("#frmfromdate").datepicker("option", "maxDate", dt);
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        if (!$("input[name='Agent_RegTypeFlag']:checked").length) {
            $("input[name='Agent_RegTypeFlag'][value='1']").prop("checked", true);
        }
        $("#AgentAddressMIS").on("submit", function () {
            var selectedVal = $("input[name='Agent_RegTypeFlag']:checked").val();
            if (!selectedVal) {
                alert("Please select option");
                return false;
            }
            return true;
        });
    });
</script>

<div id="wrapper">
    <div class="row">
        <div class="col-lg-12">
            <h3 class="page-header" style="margin-top: 15px;">Realestate Agent Report : Realestate Agent Address Directory Details</h3>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <!-- /.row -->

    <style>
        .nav-tabs > li.active > a {
            border-top: 2px solid #7bb73f;
        }

        .nav-tabs > li > a {
            background-color: #eee;
            color: #333;
        }
    </style>

    <div class="row" style="margin-bottom:5px;">
        <div class="col-lg-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="home-tab" href="@Url.Action("Display_AgentAddressDirectoryDetailsForInProcessMIS", "MISrealestateagentToExcel")" role="tab" aria-controls="home" aria-selected="true">In Process Applications</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" href="@Url.Action("Display_AgentAddressDirectoryDetailsForRegisteredAgentsMIS", "MISrealestateagentToExcel")" role="tab" aria-controls="profile" aria-selected="false">Realestate Agents In Public View</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Realestate Agent Address Directory [List of In-Process Realestate Agent Applications] Details
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-12">
                            @using (Html.BeginForm("Display_AgentAddressDirectoryDetailsForInProcessMIS", "MISrealestateagentToExcel", FormMethod.Post, new { enctype = "multipart/form-data", @id = "AgentAddressMIS" }))
                            {
                                @Html.AntiForgeryToken()

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Option</legend>
                                    <div class="row" id="rowMonthFilter">
                                        <div class="form-group">
                                            <div class="col-md-2">
                                                <label class="control-label mand">Select Option</label>
                                            </div>
                                            <div class="col-md-10">
                                                <label class="form-group">
                                                    @Html.RadioButtonFor(model => model.Agent_RegTypeFlag, "1", new { @class = "radio-agent_RegTypeFlag", id = "agent", @checked = "checked" }) Realestate Agent(New Applications)
                                                    @Html.RadioButtonFor(model => model.Agent_RegTypeFlag, "2", new { @class = "radio-agent_RegTypeFlag", id = "renewalagent" }) Renewal of Realestate Agent(Renewal of Applications)
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>

                                <fieldset class="col-md-12">
                                    <legend class="my">Select Application Date</legend>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">From Date</label>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" id="frmfromdate" onfocus="this.value=''" name="FromDate" class="form-control" autocomplete="off" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3">
                                                <label class="control-label mand">To Date</label>
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" id="frmtodate" name="ToDate" class="form-control" autocomplete="off" />
                                            </div>
                                            <div class="col-md-3">
                                                <input type="submit" id="ViewDetail" value="View Details" class="btn btn-outline btn-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            <div class="row">
                                <br />
                            </div>
                            @using (Html.BeginForm("ExportToExcel", "MISrealestateagentToExcel"))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-12">
                                            <span class="btn btn-outline btn-primary" id="btnExportToExcel">
                                                <i class="fa fa-download"></i>
                                                <span>Export To Excel</span>
                                            </span>
                                            &nbsp;
                                            @Html.ActionLink("Reset", "Display_AgentAddressDirectoryDetailsForInProcessMIS", "MISrealestateagentToExcel", null, new { @class = "btn btn-outline btn-primary" })
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="table-responsive">
                                <table style="width:100%;" class="table table-striped table-bordered table-hover" id="dataTables-example">
                                    <thead>
                                        <tr>
                                            <th>@Html.DisplayName("SNo")</th>
                                            @* <th>@Html.DisplayNameFor(model => model.Agent_DiaryNumber)</th>*@
                                            <th>
                                                @(ViewBag.choicetype == "1"? "Agent Diary Number": "Renewal Agent Diary Number")
                                            </th>
                                            <th>@Html.DisplayNameFor(model => model.Agent_Organization_Name)</th>
                                            @*<th style="width:15%;">@Html.DisplayNameFor(model => model.AuthorizedPerson_EmailAddress)</th>*@
                                            @*<th>@Html.DisplayNameFor(model => model.AuthorizedPerson_MobileNumber)</th>*@
                                            <th>@Html.DisplayNameFor(model => model.Agent_TypeSTR)</th>
                                            @*<th>@Html.DisplayNameFor(model => model.Promoter_AuthorisedSignatory_Name)</th>*@
                                            <th style="width:15%;">@Html.DisplayNameFor(model => model.EmailAddress)</th>
                                            <th>@Html.DisplayNameFor(model => model.MobileNumber)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int sno = 0;
                                        }
                                        @foreach (var item in Model.prpongoing)
                                        {
                                            {
                                                sno = sno + 1;
                                            }
                                            <tr class="odd gradeX">
                                                <td>@Html.DisplayName(sno.ToString())</td>
                                                @*<td class="agent-diary-number" data-diary-no="@Html.DisplayFor(modelItem => item.Agent_DiaryNumber)">
                                                        @Html.DisplayFor(modelItem => item.Agent_DiaryNumber)
                                                        @Html.HiddenFor(modelItem => item.Agent_ID, new { @class = "hdnAgentID" })
                                                    </td>*@
                                                <td class="agent-diary-number" data-diary-no="@(ViewBag.choicetype == "1" ? item.Agent_DiaryNumber : item.RenewalAgent_DiaryNumber)">
                                                    @if (ViewBag.choicetype == "1")
                                                    {
                                                        @Html.DisplayFor(modelItem => item.Agent_DiaryNumber)
                                                        @Html.HiddenFor(modelItem => item.Agent_ID, new { @class = "hdnAgentID" })
                                                    }
                                                    else
                                                    {
                                                        @Html.DisplayFor(modelItem => item.RenewalAgent_DiaryNumber)
                                                        @Html.HiddenFor(modelItem => item.RenewalAgent_ID, new { @class = "hdnAgentID" })
                                                    }

                                                </td>
                                                <td class="agent-name" data-agent-name="@Html.DisplayFor(modelItem => item.Agent_Organization_Name)">
                                                    <a id="modalOpenerAddressButton" href="javascript:void(0);" title="View Address Details">
                                                        @Html.DisplayFor(modelItem => item.Agent_Organization_Name)
                                                    </a>
                                                </td>
                                                @*<td style="width:15%;">@Html.DisplayFor(modelItem => item.AuthorizedPerson_EmailAddress)</td>*@
                                                @*<td style="align-content:center;">@Html.DisplayFor(modelItem => item.AuthorizedPerson_MobileNumber)</td>*@
                                                <td>@Html.DisplayFor(modelItem => item.Agent_TypeSTR)</td>
                                                @*td>@Html.DisplayFor(modelItem => item.Promoter_AuthorisedSignatory_Name)</td>*@
                                                <td style="width:15%;">@Html.DisplayFor(modelItem => item.EmailAddress)</td>
                                                <td style="align-content:center;">@Html.DisplayFor(modelItem => item.MobileNumber)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.row (nested) -->
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-12 -->
        </div>
        <!-- /.row -->
    </div>
</div>
<!-- /.wrapper -->
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Realestate Agent Address Directory - <a href="javascript:void(0);">Modal Title - File History</a></h4>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <link href="@Url.Content("~/vendor/datatables/css/dataTables.bootstrap.min.css")" rel="stylesheet"></link>
    <!-- Metis Menu Plugin JavaScript -->
    <script src="@Url.Content("~/vendor/metisMenu/metisMenu.min.js")"></script>

    <!-- DataTables JavaScript -->
    <script src="@Url.Content("~/vendor/datatables/js/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-plugins/dataTables.bootstrap.min.js")"></script>
    <script src="@Url.Content("~/vendor/datatables-responsive/dataTables.responsive.js")"></script>
    <!-- Custom Theme JavaScript -->
    <script src="@Url.Content("~/dist/js/sb-admin-2.js")"></script>
}
